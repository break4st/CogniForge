{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/deploy-config-schema.json",
  "title": "Deploy Config Schema",
  "description": "DevOps Agent 部署配置的结构化输出",
  "type": "object",
  "required": ["meta", "config"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "文档唯一标识，格式: deploy-{module}-{environment}-{seq}"
        },
        "type": {
          "type": "string",
          "const": "deploy",
          "description": "文档类型"
        },
        "title": {
          "type": "string",
          "description": "配置标题"
        },
        "author": {
          "type": "string",
          "const": "devops_agent",
          "description": "作者标识"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["module", "environment"],
      "additionalProperties": true,
      "properties": {
        "module": {
          "type": "string",
          "description": "部署模块名"
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "staging", "prod"],
          "description": "部署环境"
        },
        "docker": {
          "type": "object",
          "description": "Docker 配置",
          "additionalProperties": true
        },
        "env_vars": {
          "type": "object",
          "description": "环境变量",
          "additionalProperties": true
        },
        "network": {
          "type": "object",
          "description": "网络配置",
          "additionalProperties": true
        },
        "health_check": {
          "type": "object",
          "description": "健康检查配置",
          "additionalProperties": true
        }
      }
    }
  }
}
