{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/test-report-schema.json",
  "title": "Test Report Schema",
  "description": "QA Agent 测试报告的结构化输出",
  "type": "object",
  "required": ["meta", "content"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "文档唯一标识，格式: test-report-{module}-{seq}"
        },
        "type": {
          "type": "string",
          "const": "report",
          "description": "文档类型"
        },
        "title": {
          "type": "string",
          "description": "报告标题"
        },
        "author": {
          "type": "string",
          "const": "qa_agent",
          "description": "作者标识"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        }
      }
    },
    "content": {
      "type": "string",
      "description": "测试报告内容，包含测试覆盖率、通过/失败统计、风险评估"
    }
  }
}
