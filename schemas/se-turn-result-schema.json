{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/se-turn-result-schema.json",
  "title": "SE Turn Result Schema",
  "description": "SE (Architect) Agent 每轮架构变更的结构化输出",
  "type": "object",
  "required": [
    "status", "operation", "doc_changed", "changed_file", "source",
    "affected_requirements", "affected_components", "affected_contracts",
    "coverage_changes", "architecture_decisions", "risks",
    "conflicts", "open_questions", "patches", "downstream_handoff", "message"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["updated", "need_clarification", "rejected", "no_change"],
      "description": "本轮处理状态"
    },
    "operation": {
      "type": "string",
      "enum": [
        "initial_generate", "add_component", "modify_component",
        "deprecate_component", "remove_component", "split_component",
        "merge_component", "add_contract", "modify_contract",
        "deprecate_contract", "remove_contract", "modify_tech_stack",
        "update_traceability", "clarify", "no_change"
      ],
      "description": "本轮执行的架构操作类型"
    },
    "doc_changed": {
      "type": "boolean",
      "description": "本轮是否修改了 SAD 文档"
    },
    "changed_file": {
      "type": "string",
      "description": "被修改的文件路径"
    },
    "source": {
      "type": "object",
      "required": ["prd_doc_id", "prd_version", "pm_turn_id", "sad_doc_id", "sad_before_version", "sad_after_version"],
      "additionalProperties": false,
      "properties": {
        "prd_doc_id": { "type": "string" },
        "prd_version": { "type": "integer" },
        "pm_turn_id": { "type": "string" },
        "sad_doc_id": { "type": "string" },
        "sad_before_version": { "type": "integer" },
        "sad_after_version": { "type": "integer" }
      }
    },
    "affected_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "impact"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "impact": {
            "type": "string",
            "enum": ["covered", "partially_covered", "uncovered", "changed", "deprecated", "blocked"]
          },
          "reason": { "type": "string" }
        }
      }
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "change_type", "before", "after", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "change_type": {
            "type": "string",
            "enum": ["created", "modified", "deprecated", "removed", "merged", "split", "unchanged"]
          },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "affected_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "change_type", "before", "after", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "change_type": {
            "type": "string",
            "enum": ["created", "modified", "deprecated", "removed", "merged", "split", "unchanged"]
          },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "coverage_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "before", "after", "reason"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string" },
          "before": { "type": "string", "enum": ["full", "partial", "none", "blocked"] },
          "after": { "type": "string", "enum": ["full", "partial", "none", "blocked"] },
          "reason": { "type": "string" }
        }
      }
    },
    "architecture_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "decision", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "decision": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "level", "mitigation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "level": { "type": "string", "enum": ["高", "中", "低"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_with", "description", "resolution"],
        "additionalProperties": false,
        "properties": {
          "conflict_with": { "type": "string" },
          "description": { "type": "string" },
          "resolution": {
            "type": "string",
            "enum": [
              "resolved_by_update", "resolved_by_deprecation",
              "resolved_by_new_contract", "left_open", "rejected"
            ]
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "patches": {
      "type": "array",
      "description": "RFC 6902 JSON Patch 操作列表，直接作用于 sad.json",
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "additionalProperties": false,
        "properties": {
          "op": { "type": "string", "enum": ["add", "replace", "remove"] },
          "path": { "type": "string" },
          "value": {}
        }
      }
    },
    "downstream_handoff": {
      "type": "object",
      "required": ["backend", "frontend", "qa", "devops"],
      "additionalProperties": false,
      "properties": {
        "backend": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frontend": {
          "type": "array",
          "items": { "type": "string" }
        },
        "qa": {
          "type": "array",
          "items": { "type": "string" }
        },
        "devops": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "message": {
      "type": "string",
      "description": "本轮操作的人类可读摘要"
    }
  }
}
