{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/tl-turn-result-schema.json",
  "title": "TL Turn Result Schema",
  "description": "Tech Lead Agent per-turn structured output.",
  "type": "object",
  "required": ["status", "operation", "wbs_id", "message"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "blocked", "failed", "no_change"],
      "description": "success=WBS generated, blocked=upstream issues, failed=error, no_change=idempotent"
    },
    "operation": {
      "type": "string",
      "enum": ["create_wbs", "retro", "evaluate_quality", "schedule"],
      "description": "Which TL action was performed"
    },
    "wbs_id": {
      "type": "string",
      "description": "WBS index document ID, e.g. wbs-iter-001"
    },
    "created_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Task IDs created in this turn"
    },
    "updated_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Task IDs updated in this turn"
    },
    "blocked_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Task IDs that could not be created due to upstream issues"
    },
    "coverage_summary": {
      "type": "object",
      "properties": {
        "total_artifacts": { "type": "integer" },
        "covered": { "type": "integer" },
        "uncovered": { "type": "integer" },
        "coverage_pct": { "type": "number" },
        "passed": { "type": "boolean" }
      }
    },
    "upstream_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "issue_type", "description"],
        "properties": {
          "target": {
            "type": "string",
            "enum": ["prd", "sad", "lld", "mde", "se"],
            "description": "Which upstream document has the issue"
          },
          "issue_type": {
            "type": "string",
            "description": "e.g. incomplete_contract, missing_section, ambiguous_spec"
          },
          "artifact_id": {
            "type": "string",
            "description": "Affected artifact ID (REQ-xxx, CTR-xxx, etc.)"
          },
          "description": {
            "type": "string",
            "description": "Human-readable issue description"
          },
          "suggested_action": {
            "type": "string",
            "description": "Recommended remediation"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "message": {
      "type": "string",
      "description": "Human-readable status message"
    }
  }
}
