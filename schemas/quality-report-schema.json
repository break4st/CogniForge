{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/quality-report-schema.json",
  "title": "Quality Report Schema",
  "description": "TechLead Agent 质量评估报告的结构化输出",
  "type": "object",
  "required": ["meta", "content"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "文档唯一标识，格式: quality-{module}-{seq}"
        },
        "type": {
          "type": "string",
          "const": "report",
          "description": "文档类型"
        },
        "title": {
          "type": "string",
          "description": "报告标题"
        },
        "author": {
          "type": "string",
          "const": "techlead_agent",
          "description": "作者标识"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        }
      }
    },
    "content": {
      "type": "string",
      "description": "质量评估内容，包含 PASS/FAIL 结论及各检查项结果（CR 是否通过、测试是否通过、代码是否符合设计）"
    }
  }
}
