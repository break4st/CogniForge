{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/lld-schema.json",
  "title": "LLD Schema",
  "description": "CogniForge 模块详细设计文档 JSON Schema。所有 module_type 专属字段均为 optional，type-specific 规则由 lld_validator.py 程序化检查。",
  "type": "object",
  "required": ["meta", "overview"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "module_type", "module", "title", "author", "created"],
      "additionalProperties": false,
      "properties": {
        "doc_id": { "type": "string" },
        "type": { "type": "string", "const": "lld" },
        "module_type": { "type": "string", "enum": ["service", "frontend", "gateway", "database", "infrastructure"] },
        "module": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "created": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["draft", "active", "changed", "deprecated", "removed"] },
        "last_modified": { "type": "string" }
      }
    },

    "source": {
      "type": "object",
      "description": "LLD 基于哪个 PRD/SAD 版本及哪轮 SE 变更生成",
      "required": ["prd", "sad"],
      "additionalProperties": false,
      "properties": {
        "prd": {
          "type": "object",
          "required": ["doc_id", "version"],
          "additionalProperties": false,
          "properties": {
            "doc_id": { "type": "string" },
            "version": { "type": "integer", "minimum": 1 },
            "requirements": { "type": "array", "items": { "type": "string" } }
          }
        },
        "sad": {
          "type": "object",
          "required": ["doc_id", "version"],
          "additionalProperties": false,
          "properties": {
            "doc_id": { "type": "string" },
            "version": { "type": "integer", "minimum": 1 },
            "components": { "type": "array", "items": { "type": "string" } },
            "contracts": { "type": "array", "items": { "type": "string" } },
            "data_models": { "type": "array", "items": { "type": "string" } }
          }
        },
        "pm_turn_id": { "type": "string" },
        "se_turn_id": { "type": "string" }
      }
    },

    "module_boundary": {
      "type": "object",
      "description": "MDE 模块边界：此模块负责和消费的内容",
      "additionalProperties": false,
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } },
        "owned_components": { "type": "array", "items": { "type": "string", "pattern": "^CMP-\\d{3,}$" } },
        "owned_contracts": { "type": "array", "items": { "type": "string", "pattern": "^CTR-\\d{3,}$" } },
        "consumed_contracts": { "type": "array", "items": { "type": "string", "pattern": "^CTR-\\d{3,}$" } },
        "owned_data_models": { "type": "array", "items": { "type": "string", "pattern": "^DM-\\d{3,}$" } },
        "consumed_data_models": { "type": "array", "items": { "type": "string", "pattern": "^DM-\\d{3,}$" } }
      }
    },

    "overview": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "tech_stack": { "type": "array", "items": { "type": "string" } }
      }
    },

    "traceability": {
      "type": "array",
      "description": "REQ → SAD → LLD 追溯链",
      "items": {
        "type": "object",
        "required": ["requirement_id", "sad_component_ids", "sad_contract_ids", "lld_objects", "coverage"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3,}$" },
          "sad_component_ids": { "type": "array", "items": { "type": "string", "pattern": "^CMP-\\d{3,}$" } },
          "sad_contract_ids": { "type": "array", "items": { "type": "string", "pattern": "^CTR-\\d{3,}$" } },
          "lld_objects": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "data_models": { "type": "array", "items": { "type": "string", "pattern": "^DM-\\d{3,}$" } },
              "interfaces": { "type": "array", "items": { "type": "string", "pattern": "^IF-\\d{3,}$" } },
              "domain_objects": { "type": "array", "items": { "type": "string", "pattern": "^DO-\\d{3,}$" } },
              "service_contracts": { "type": "array", "items": { "type": "string", "pattern": "^SC-\\d{3,}$" } }
            }
          },
          "coverage": { "type": "string", "enum": ["full", "partial", "none", "blocked"] },
          "notes": { "type": "string" }
        }
      }
    },

    "data_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "ownership", "description", "fields"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^DM-\\d{3,}$" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["table", "reference", "struct", "store", "config", "interface"] },
          "status": { "type": "string", "enum": ["draft", "active", "changed", "deprecated", "removed"] },
          "version": { "type": "integer", "minimum": 1 },
          "ownership": { "type": "string", "enum": ["canonical", "derived", "owned"] },
          "source": { "type": "object", "additionalProperties": true },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "indexes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "columns"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "unique": { "type": "boolean" },
                "columns": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "source_requirements": { "type": "array", "items": { "type": "string", "pattern": "^REQ-\\d{3,}$" } },
          "source_components": { "type": "array", "items": { "type": "string", "pattern": "^CMP-\\d{3,}$" } },
          "source_contracts": { "type": "array", "items": { "type": "string", "pattern": "^CTR-\\d{3,}$" } },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "create": { "type": "string" },
              "update": { "type": "string" },
              "delete": { "type": "string" },
              "retention": { "type": "string" }
            }
          },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer" },
                "change_type": { "type": "string", "enum": ["created", "modified", "deprecated", "removed", "merged", "split", "superseded"] },
                "summary": { "type": "string" },
                "reason": { "type": "string" },
                "source_pm_turn_id": { "type": "string" },
                "source_se_turn_id": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "method", "endpoint", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^IF-\\d{3,}$" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "active", "changed", "deprecated", "removed"] },
          "version": { "type": "integer", "minimum": 1 },
          "source_contract_id": { "type": "string", "pattern": "^CTR-\\d{3,}$" },
          "provider_component_id": { "type": "string", "pattern": "^CMP-\\d{3,}$" },
          "method": { "type": "string" },
          "endpoint": { "type": "string" },
          "description": { "type": "string" },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "in": { "type": "string", "enum": ["path", "query", "body", "header"] },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "request_body": { "type": "object", "additionalProperties": true },
          "response": { "type": "object", "additionalProperties": true },
          "error_codes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message"],
              "additionalProperties": false,
              "properties": {
                "status": { "type": "integer" },
                "code": { "type": ["string", "integer"] },
                "message": { "type": "string" }
              }
            }
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": { "type": "boolean" },
              "policy": { "type": "string" }
            }
          },
          "validation_rules": { "type": "array", "items": { "type": "string" } },
          "idempotency": { "type": "string" },
          "pagination": { "type": "string" },
          "source_requirements": { "type": "array", "items": { "type": "string", "pattern": "^REQ-\\d{3,}$" } },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer" },
                "change_type": { "type": "string", "enum": ["created", "modified", "deprecated", "removed", "superseded"] },
                "summary": { "type": "string" },
                "reason": { "type": "string" },
                "source_se_turn_id": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "error_handling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string" },
        "response_format": { "type": "object", "additionalProperties": true },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "name", "description"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "domain_objects": {
      "type": "array",
      "description": "service 模块专属：领域对象",
      "items": {
        "type": "object",
        "required": ["name", "object_type", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^DO-\\d{3,}$" },
          "name": { "type": "string" },
          "object_type": { "type": "string", "enum": ["entity", "value_object", "dto", "enum"] },
          "status": { "type": "string", "enum": ["draft", "active", "changed", "deprecated", "removed"] },
          "version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "source": { "type": "string", "enum": ["db", "computed", "input", "derived"] },
                "description": { "type": "string" }
              }
            }
          },
          "values": { "type": "array", "items": { "type": "string" } },
          "maps_to_entity": { "type": "string" },
          "source_requirements": { "type": "array", "items": { "type": "string" } },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer" },
                "change_type": { "type": "string", "enum": ["created", "modified", "deprecated", "removed"] },
                "summary": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "service_contracts": {
      "type": "array",
      "description": "service 模块专属：服务契约",
      "items": {
        "type": "object",
        "required": ["name", "methods"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^SC-\\d{3,}$" },
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "active", "changed", "deprecated", "removed"] },
          "version": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "signature": { "type": "string" },
                "precondition": { "type": "string" },
                "postcondition": { "type": "string" },
                "description": { "type": "string" },
                "exceptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "trigger"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string" },
                      "trigger": { "type": "string" },
                      "http_status": { "type": "integer" }
                    }
                  }
                }
              }
            }
          },
          "repository_dependencies": { "type": "array", "items": { "type": "string" } },
          "source_interfaces": { "type": "array", "items": { "type": "string" } },
          "source_requirements": { "type": "array", "items": { "type": "string" } },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer" },
                "change_type": { "type": "string", "enum": ["created", "modified", "deprecated", "removed"] },
                "summary": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "business_rules": {
      "type": "object",
      "description": "service 模块专属：业务规则",
      "additionalProperties": false,
      "properties": {
        "invariants": { "type": "array", "items": { "type": "string" } },
        "state_machines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "states"],
            "additionalProperties": false,
            "properties": {
              "entity": { "type": "string" },
              "states": { "type": "array", "items": { "type": "string" } },
              "transitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to", "trigger"],
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "string" },
                    "to": { "type": "string" },
                    "trigger": { "type": "string" },
                    "actor": { "type": "string" }
                  }
                }
              },
              "irreversible_rules": { "type": "array", "items": { "type": "string" } },
              "concurrency": { "type": "string" }
            }
          }
        },
        "cross_service_rules": { "type": "array", "items": { "type": "string" } }
      }
    },

    "component_tree": {
      "type": "array",
      "description": "frontend 模块专属：组件树",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^FC-\\d{3,}$" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["page", "component", "layout"] },
          "status": { "type": "string", "enum": ["draft", "active", "changed", "deprecated", "removed"] },
          "version": { "type": "integer", "minimum": 1 },
          "path": { "type": "string" },
          "description": { "type": "string" },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "payload_type": { "type": "string" }
              }
            }
          },
          "state": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "behavior": { "type": "array", "items": { "type": "string" } },
          "edge_cases": { "type": "array", "items": { "type": "string" } },
          "state_dependencies": { "type": "array", "items": { "type": "string" } },
          "children": { "type": "array" },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer" },
                "change_type": { "type": "string", "enum": ["created", "modified", "deprecated", "removed"] },
                "summary": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "state_design": {
      "type": "object",
      "description": "frontend 模块专属：状态设计",
      "additionalProperties": false,
      "properties": {
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "state": { "type": "array" },
              "actions": { "type": "array" },
              "source_requirements": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "global": { "type": "array" },
        "caching_strategy": { "type": "string" }
      }
    },

    "route_design": {
      "type": "array",
      "description": "frontend 模块专属：路由设计",
      "items": {
        "type": "object",
        "required": ["path", "page"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "page": { "type": "string" },
          "page_component": { "type": "string" },
          "title": { "type": "string" },
          "auth": { "type": "string" },
          "layout": { "type": "string" },
          "guards": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "interaction_flows": {
      "type": "array",
      "description": "frontend 模块专属：交互流程",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "source_requirements": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "api_integration": {
      "type": "array",
      "description": "frontend 模块专属：API 映射",
      "items": {
        "type": "object",
        "required": ["page", "endpoint"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "page": { "type": "string" },
          "endpoint": { "type": "string" },
          "maps_to": { "type": "string" },
          "source_contract_id": { "type": "string", "pattern": "^CTR-\\d{3,}$" },
          "client_method": { "type": "string" },
          "error_handling": { "type": "array", "items": { "type": "string" } },
          "loading_state": { "type": "string" },
          "empty_state": { "type": "string" }
        }
      }
    },

    "route_table": {
      "type": "array",
      "description": "gateway 模块专属：路由表",
      "items": {
        "type": "object",
        "required": ["path_pattern", "upstream"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "method": { "type": "string" },
          "path": { "type": "string" },
          "path_pattern": { "type": "string" },
          "upstream": { "type": "string" },
          "target_contract_id": { "type": "string" },
          "target_component_id": { "type": "string" },
          "description": { "type": "string" },
          "middlewares": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "middleware_chain": {
      "type": "array",
      "description": "gateway 模块专属：中间件链",
      "items": { "type": "string" }
    },

    "auth_policy": {
      "type": "object",
      "description": "gateway 模块专属：认证授权",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string" },
        "public_endpoints": { "type": "array", "items": { "type": "string" } },
        "auth_method": { "type": "string" },
        "role_path_map": { "type": "array" },
        "token_expiry": { "type": "string" },
        "rules": { "type": "array" }
      }
    },

    "rate_limiting": {
      "type": "object",
      "description": "gateway 模块专属：限流",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "global": { "type": "string" },
        "per_user": { "type": "string" },
        "special_endpoints": { "type": "array" },
        "rules": { "type": "array" }
      }
    },

    "index_strategy": {
      "type": "array",
      "description": "database 模块专属：索引策略",
      "items": {
        "type": "object",
        "required": ["table", "indexes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "table": { "type": "string" },
