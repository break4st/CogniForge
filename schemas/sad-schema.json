{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/sad-schema.json",
  "title": "SAD Schema",
  "description": "CogniForge 系统架构文档 JSON Schema",
  "type": "object",
  "required": ["meta", "title", "system_overview", "architecture", "tech_stack", "components", "contracts", "data_flow"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created", "version"],
      "additionalProperties": false,
      "properties": {
        "doc_id": { "type": "string" },
        "type": { "type": "string", "const": "sad" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "created": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "title": { "type": "string", "description": "架构文档标题" },
    "source_prd": {
      "type": "object",
      "description": "源 PRD 引用",
      "required": ["doc_id", "version"],
      "additionalProperties": false,
      "properties": {
        "doc_id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "last_pm_turn_id": { "type": "string" }
      }
    },
    "system_overview": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "description": "系统概述" },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "permissions"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "permissions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["style", "description"],
      "additionalProperties": false,
      "properties": {
        "style": { "type": "string", "description": "架构风格" },
        "description": { "type": "string" },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "components"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "components": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["protocol"],
            "additionalProperties": false,
            "properties": {
              "protocol": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tech_stack": {
      "type": "object",
      "description": "技术选型，字段按需增删",
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "description": "组件列表",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "description", "responsibilities"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CMP-\\d{3,}$" },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["frontend", "backend", "gateway", "service", "database", "cache", "mq", "infrastructure", "integration", "security"]
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "changed", "deprecated", "removed"],
            "description": "组件状态"
          },
          "version": { "type": "integer", "minimum": 1, "description": "组件版本号" },
          "description": { "type": "string" },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "source_requirements": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-\\d{3,}$" }
          },
          "contracts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^CTR-\\d{3,}$" }
          },
          "depends_on_components": {
            "type": "array",
            "items": { "type": "string", "pattern": "^CMP-\\d{3,}$" }
          },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer" },
                "change_type": {
                  "type": "string",
                  "enum": ["created", "modified", "deprecated", "removed", "merged", "split", "superseded"]
                },
                "summary": { "type": "string" },
                "reason": { "type": "string" },
                "source_pm_turn_id": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "description": "接口契约",
      "items": {
        "type": "object",
        "required": ["id", "interface", "provider", "consumers", "type", "endpoint", "request", "response", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CTR-\\d{3,}$" },
          "interface": { "type": "string", "description": "接口名称" },
          "provider_component_id": {
            "type": "string", "pattern": "^CMP-\\d{3,}$",
            "description": "提供方组件 ID"
          },
          "provider": { "type": "string", "description": "提供方组件名称" },
          "consumers": { "type": "array", "items": { "type": "string" } },
          "type": {
            "type": "string",
            "enum": ["REST", "WebSocket", "SSE", "CLI", "InternalFunction", "Event", "gRPC", "MQ"]
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "changed", "deprecated", "removed"]
          },
          "version": { "type": "integer", "minimum": 1 },
          "endpoint": { "type": "string" },
          "request": { "type": "object", "additionalProperties": true },
          "response": { "type": "object", "additionalProperties": true },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["status", "code", "message"],
              "additionalProperties": false,
              "properties": {
                "status": { "type": "integer" },
                "code": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "description": { "type": "string" },
          "source_requirements": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-\\d{3,}$" }
          },
          "change_history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": { "type": "integer" },
                "change_type": {
                  "type": "string",
                  "enum": ["created", "modified", "deprecated", "removed", "merged", "split", "superseded"]
                },
                "summary": { "type": "string" },
                "reason": { "type": "string" },
                "source_pm_turn_id": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "data_flow": {
      "type": "array",
      "description": "数据流",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "data_models": {
      "type": "array",
      "description": "数据模型定义",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "fields", "source_requirements"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^DM-\\d{3,}$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "description": { "type": "string" }
              }
            }
          },
          "source_requirements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "requirement_traceability": {
      "type": "array",
      "description": "需求 → 组件/接口/数据模型 追溯矩阵",
      "items": {
        "type": "object",
        "required": ["requirement_id", "coverage", "components", "contracts"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^REQ-\\d{3,}$" },
          "coverage": { "type": "string", "enum": ["full", "partial", "none", "blocked"] },
          "components": {
            "type": "array",
            "items": { "type": "string", "pattern": "^CMP-\\d{3,}$" }
          },
          "contracts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^CTR-\\d{3,}$" }
          },
          "data_models": {
            "type": "array",
            "items": { "type": "string", "pattern": "^DM-\\d{3,}$" }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "architecture_decisions": {
      "type": "array",
      "description": "架构决策记录",
      "items": {
        "type": "object",
        "required": ["id", "title", "decision", "reason", "impacts"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-\\d{3,}$" },
          "title": { "type": "string" },
          "decision": { "type": "string" },
          "reason": { "type": "string" },
          "impacts": { "type": "array", "items": { "type": "string" } },
          "source_requirements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "description": "技术风险",
      "items": {
        "type": "object",
        "required": ["id", "description", "level", "mitigation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RSK-\\d{3,}$" },
          "description": { "type": "string" },
          "level": { "type": "string", "enum": ["高", "中", "低"] },
          "mitigation": { "type": "string" },
          "related_requirements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "description": "待澄清架构问题",
      "items": {
        "type": "object",
        "required": ["id", "question", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AQ-\\d{3,}$" },
          "question": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "related_requirements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
