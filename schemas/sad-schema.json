{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/sad-schema.json",
  "title": "SAD Schema",
  "description": "CogniForge 系统架构文档 JSON Schema",
  "type": "object",
  "required": ["meta", "title", "system_overview", "architecture", "components", "contracts", "data_flow"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created", "version"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "sad"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "title": {
      "type": "string",
      "description": "架构文档标题"
    },
    "system_overview": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "description": "系统概述"
        },
        "roles": {
          "type": "array",
          "description": "角色与权限",
          "items": {
            "type": "object",
            "required": ["name", "permissions"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["style", "description"],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "description": "架构风格，如微服务、单体"
        },
        "description": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "components"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["protocol"],
            "additionalProperties": false,
            "properties": {
              "protocol": {
                "type": "string"
              }
            }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "description": "组件列表",
      "items": {
        "type": "object",
        "required": ["name", "type", "description", "responsibilities"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["frontend", "gateway", "service", "database", "cache", "mq", "infrastructure"]
          },
          "description": {
            "type": "string"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "description": "接口契约",
      "items": {
        "type": "object",
        "required": ["interface", "provider", "consumers", "type", "endpoint", "request", "response", "description"],
        "additionalProperties": false,
        "properties": {
          "interface": {
            "type": "string",
            "description": "接口名称"
          },
          "provider": {
            "type": "string",
            "description": "提供方组件"
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "消费方组件列表"
          },
          "type": {
            "type": "string",
            "enum": ["REST", "gRPC", "MQ"],
            "description": "接口类型"
          },
          "endpoint": {
            "type": "string",
            "description": "端点路径"
          },
          "request": {
            "type": "string",
            "description": "请求格式"
          },
          "response": {
            "type": "string",
            "description": "响应格式"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "data_flow": {
      "type": "array",
      "description": "数据流",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "数据流名称"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "步骤列表"
          }
        }
      }
    }
  }
}
