{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/dev-run-result-schema.json",
  "title": "DEV Run Result Schema",
  "description": "Structured output from a DEV Agent after executing a single task.",
  "type": "object",
  "required": ["task_id", "status", "summary", "changed_files"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "description": "The task ID that was executed"
    },
    "status": {
      "type": "string",
      "enum": ["implemented", "blocked", "failed", "partial", "no_change"],
      "description": "implemented=all ACs passed, blocked=need upstream fix, failed=error, partial=some ACs failed, no_change=nothing to do"
    },
    "summary": {
      "type": "string",
      "description": "One-sentence summary of what was done"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_type"],
        "properties": {
          "path": { "type": "string" },
          "change_type": {
            "type": "string",
            "enum": ["created", "modified", "deleted"]
          }
        }
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" },
          "summary": { "type": "string" }
        }
      }
    },
    "acceptance_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["acceptance_id", "status"],
        "properties": {
          "acceptance_id": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "skipped"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "blocked_reason": {
      "type": "string",
      "description": "If status=blocked, why the task cannot be completed"
    },
    "upstream_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "follow_up_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Suggested follow-up task names (for large tasks that need splitting)"
    },
    "notes_for_reviewer": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Notes for the human reviewer during CR"
    }
  }
}
