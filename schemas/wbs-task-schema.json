{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/wbs-task-schema.json",
  "title": "WBS Task Schema",
  "description": "Tech Lead Agent 产出的 DEV-ready 任务结构 — Tech Lead 与 DEV Agent 之间的合同。",
  "type": "object",
  "required": ["task_id", "name", "module"],
  "additionalProperties": false,
  "properties": {

    "task_id": {
      "type": "string",
      "description": "唯一任务标识，格式: {module}-{seq:03d}"
    },
    "name": {
      "type": "string",
      "description": "任务名称（中文）"
    },
    "description": {
      "type": "string",
      "description": "详细描述（中文，2-8小时粒度，明确产出物）"
    },
    "module": {
      "type": "string",
      "description": "所属模块名"
    },
    "module_type": {
      "type": "string",
      "enum": ["service", "database", "gateway", "frontend", "infrastructure"],
      "description": "模块类型"
    },
    "deps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "依赖的任务 ID 列表"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending", "queued", "running", "in_progress",
        "implemented", "blocked", "reviewing", "review_failed",
        "testing", "test_failed", "done", "failed", "cancelled"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "integer",
      "enum": [0, 1, 2, 3],
      "description": "0=阻塞, 1=高, 2=中, 3=低",
      "default": 2
    },
    "assignee": {
      "type": "string",
      "description": "执行人/角色，如 'dev'"
    },
    "estimated_hours": {
      "type": "number",
      "description": "预估工时（小时）"
    },
    "actual_hours": {
      "type": "number",
      "description": "实际工时（小时）"
    },
    "category": {
      "type": "string",
      "enum": ["model", "service", "endpoint", "test", "config", "migration", "doc", "fix"],
      "description": "任务分类"
    },
    "layer": {
      "type": "integer",
      "description": "分解层级: 0=model, 1=service, 2=endpoint, 3=test",
      "default": 0
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本任务修改的文件列表"
    },
    "expected_output_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "预期产出的文件路径列表"
    },
    "file_locks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "并行执行时本任务独占锁定的文件列表"
    },
    "definition_of_done": {
      "type": "array",
      "items": { "type": "string" },
      "description": "人读的验收完成条件"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "object",
      "description": "执行结果（任意结构）"
    },
    "error": {
      "type": "string",
      "description": "错误信息"
    },

    "source": {
      "type": "object",
      "description": "溯源链 — 指回 PRD/SAD/LLD 设计文档",
      "required": [],
      "properties": {
        "wbs_id": {
          "type": "string",
          "description": "所属 WBS 迭代 ID"
        },
        "prd_doc_id": {
          "type": "string",
          "description": "来源 PRD 文档 ID"
        },
        "sad_doc_id": {
          "type": "string",
          "description": "来源 SAD 文档 ID"
        },
        "lld_doc_id": {
          "type": "string",
          "description": "来源 LLD 文档 ID"
        },
        "lld_path": {
          "type": "string",
          "description": "LLD 文件路径"
        },
        "requirements": {
          "type": "array",
          "items": { "type": "string" },
          "description": "满足的需求 ID 列表（如 REQ-001）"
        },
        "components": {
          "type": "array",
          "items": { "type": "string" },
          "description": "关联的 SAD 组件 ID 列表"
        },
        "contracts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "消费的接口契约 ID 列表"
        },
        "mde_turn_id": {
          "type": "string",
          "description": "来源 MDE turn ID"
        }
      }
    },

    "lld_refs": {
      "type": "array",
      "description": "本任务实现的 LLD artifact 引用列表",
      "items": {
        "type": "object",
        "required": ["section", "item_name", "artifact_type"],
        "properties": {
          "module":       { "type": "string" },
          "doc_id":       { "type": "string" },
          "section":      { "type": "string", "description": "LLD section: data_models, interfaces, service_contracts..." },
          "item_name":    { "type": "string", "description": "Artifact 名称" },
          "artifact_type":{ "type": "string", "description": "data_model_table, interface_get, service_contract..." },
          "sub_item":     { "type": "string", "description": "子项名称（如方法名）" }
        }
      }
    },

    "acceptance_criteria": {
      "type": "array",
      "description": "可验证的验收条件列表（从 LLD 契约推导）",
      "items": {
        "type": "object",
        "required": ["id", "description", "verification_type", "expected"],
        "properties": {
          "id": {
            "type": "string",
            "description": "验收条件 ID，如 AC-001"
          },
          "source_section": {
            "type": "string",
            "description": "来源 LLD section"
          },
          "source_item": {
            "type": "string",
            "description": "来源 LLD artifact 名称"
          },
          "description": {
            "type": "string",
            "description": "验收条件描述（中文）"
          },
          "verification_type": {
            "type": "string",
            "enum": [
              "unit_test", "integration_test", "http_status",
              "response_schema", "database_state", "file_created",
              "event_emitted", "frontend_render", "error_code",
              "security_check"
            ],
            "description": "验证方式"
          },
          "expected": {
            "type": "string",
            "description": "期望结果"
          },
          "verification_command": {
            "type": "string",
            "description": "验证命令（如 pytest ...）"
          },
          "evidence_required": {
            "type": "boolean",
            "description": "是否需要提供证据",
            "default": true
          }
        }
      }
    },

    "context": {
      "type": "object",
      "description": "DEV Agent 的结构化上下文 — 无需重读 LLD",
      "properties": {
        "module_type":       { "type": "string" },
        "lld_path":          { "type": "string" },
        "module_overview":   { "type": "string" },
        "scope": {
          "type": "object",
          "description": "本任务负责的 LLD 数据子集",
          "properties": {
            "data_models":       { "type": "array", "items": { "type": "object" } },
            "domain_objects":    { "type": "array", "items": { "type": "object" } },
            "interfaces":        { "type": "array", "items": { "type": "object" } },
            "service_contracts": { "type": "array", "items": { "type": "object" } },
            "business_rules":    { "type": "object" },
            "error_handling":    { "type": "object" },
            "extra_sections":    { "type": "object" }
          }
        },
        "external_contracts": {
          "type": "array",
          "items": { "type": "object" },
          "description": "跨模块依赖接口摘要"
        },
        "cross_module_deps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "依赖的外部模块名"
        },
        "tech_stack": {
          "type": "array",
          "items": { "type": "string" },
          "description": "技术栈"
        },
        "repo_conventions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "文件布局 / 命名 / 测试惯例"
        },
        "existing_files_hint": {
          "type": "array",
          "items": { "type": "string" },
          "description": "建议 DEV 优先阅读的已有文件"
        },
        "do_not_touch": {
          "type": "array",
          "items": { "type": "string" },
          "description": "明确禁止修改的目录或文件"
        },
        "upstream_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id":  { "type": "string" },
              "name":     { "type": "string" },
              "files":    { "type": "array", "items": { "type": "string" } },
              "category": { "type": "string" }
            }
          },
          "description": "已完成上游任务的产出物"
        }
      }
    },

    "implementation_boundary": {
      "type": "object",
      "description": "文件级权限 — DEV Agent 只能在此范围内修改文件",
      "required": ["allowed_paths", "forbidden_paths"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "允许修改的文件路径前缀列表"
        },
        "allowed_path_globs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "允许修改的 glob 模式列表"
        },
        "forbidden_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "绝对禁止修改的路径列表（必须包含 .cogniforge/wiki/ 和 schemas/）"
        },
        "expected_output_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "期望产出的文件路径列表"
        },
        "max_files_changed": {
          "type": "integer",
          "description": "允许修改的最大文件数",
          "default": 6
        },
        "may_create_files": {
          "type": "boolean",
          "description": "是否允许创建新文件",
          "default": true
        }
      }
    },

    "validation": {
      "type": "object",
      "description": "DEV 完成后由 orchestrator 执行的验证命令",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "command"],
            "properties": {
              "name": {
                "type": "string",
                "description": "命令名称（如 '单元测试'）"
              },
              "command": {
                "type": "string",
                "description": "shell 命令（如 'pytest tests/X.py -v'）"
              },
              "timeout_seconds": {
                "type": "integer",
                "description": "超时秒数",
                "default": 120
              }
            }
          }
        }
      }
    },

    "dev_agent": {
      "type": "object",
      "description": "DEV Agent 的执行配置",
      "properties": {
        "agent_type": {
          "type": "string",
          "description": "Agent 类型",
          "default": "claude_code"
        },
        "allow_bash": {
          "type": "boolean",
          "description": "是否允许执行 shell 命令",
          "default": false
        },
        "test_execution_owner": {
          "type": "string",
          "enum": ["dev", "orchestrator"],
          "description": "谁负责运行测试",
          "default": "orchestrator"
        },
        "run_in_worktree": {
          "type": "boolean",
          "description": "是否在独立 git worktree 中执行",
          "default": false
        }
      }
    }
  }
}
