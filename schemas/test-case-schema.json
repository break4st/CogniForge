{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/test-case-schema.json",
  "title": "Test Case Schema",
  "description": "QA Agent 测试用例文档的结构化输出",
  "type": "object",
  "required": ["meta", "test_cases"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "module", "title", "author", "created"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "文档唯一标识，格式: test_case-{module}-{seq}"
        },
        "type": {
          "type": "string",
          "const": "test_case",
          "description": "文档类型"
        },
        "module": {
          "type": "string",
          "description": "所属模块名"
        },
        "title": {
          "type": "string",
          "description": "文档标题"
        },
        "author": {
          "type": "string",
          "const": "qa_agent",
          "description": "作者标识"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        }
      }
    },
    "test_cases": {
      "type": "array",
      "description": "测试用例列表",
      "items": {
        "type": "object",
        "required": ["name", "type", "priority", "description", "expected_result"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "测试用例名称"
          },
          "type": {
            "type": "string",
            "enum": ["unit", "integration", "e2e", "performance", "security"],
            "description": "测试类型"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "优先级"
          },
          "description": {
            "type": "string",
            "description": "测试描述"
          },
          "steps": {
            "type": "array",
            "items": {"type": "string"},
            "description": "测试步骤"
          },
          "expected_result": {
            "type": "string",
            "description": "期望结果"
          }
        }
      }
    }
  }
}
