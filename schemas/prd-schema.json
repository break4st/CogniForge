{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/prd-schema.json",
  "title": "PRD Schema",
  "description": "CogniForge 产品需求文档 JSON Schema",
  "type": "object",
  "required": ["meta", "overview", "requirements", "user_stories", "priorities"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created", "version", "last_modified", "last_author"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "文档唯一标识，如 prd-current"
        },
        "type": {
          "type": "string",
          "const": "prd"
        },
        "title": {
          "type": "string",
          "description": "项目名称"
        },
        "author": {
          "type": "string",
          "description": "初始作者标识，如 pm_agent"
        },
        "created": {
          "type": "string",
          "description": "创建时间，ISO 格式"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "当前版本号"
        },
        "last_modified": {
          "type": "string",
          "description": "最近修改时间，ISO 格式"
        },
        "last_author": {
          "type": "string",
          "description": "最近修改的作者标识"
        }
      }
    },
    "overview": {
      "type": "string",
      "description": "项目概述"
    },
    "requirements": {
      "type": "array",
      "description": "功能需求列表",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "status", "version"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d{3,}$",
            "description": "需求唯一标识，如 REQ-001"
          },
          "name": {
            "type": "string",
            "description": "需求名称"
          },
          "description": {
            "type": "string",
            "description": "需求描述"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "changed", "deprecated", "removed"],
            "description": "需求状态"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "需求版本号"
          },
          "acceptance_criteria": {
            "type": "array",
            "description": "验收条件",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string",
            "enum": ["高", "中", "低"],
            "description": "优先级"
          },
          "depends_on": {
            "type": "array",
            "description": "依赖的需求 ID 列表",
            "items": {
              "type": "string",
              "pattern": "^REQ-\\d{3,}$"
            }
          },
          "supersedes": {
            "type": "array",
            "description": "被替代的旧需求 ID 列表",
            "items": {
              "type": "string",
              "pattern": "^REQ-\\d{3,}$"
            }
          },
          "related_user_stories": {
            "type": "array",
            "description": "关联的用户故事 ID 列表",
            "items": {
              "type": "string",
              "pattern": "^US-\\d{3,}$"
            }
          },
          "change_history": {
            "type": "array",
            "description": "变更历史记录",
            "items": {
              "type": "object",
              "required": ["version", "change_type", "summary", "reason"],
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "integer",
                  "description": "变更后的版本号"
                },
                "change_type": {
                  "type": "string",
                  "enum": ["created", "modified", "deprecated", "removed", "merged", "split", "superseded", "reprioritized"],
                  "description": "变更类型"
                },
                "summary": {
                  "type": "string",
                  "description": "变更摘要"
                },
                "reason": {
                  "type": "string",
                  "description": "变更原因"
                }
              }
            }
          }
        }
      }
    },
    "user_stories": {
      "type": "array",
      "description": "用户故事列表",
      "items": {
        "type": "object",
        "required": ["id", "role", "action", "goal"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^US-\\d{3,}$",
            "description": "用户故事唯一标识，如 US-001"
          },
          "role": {
            "type": "string",
            "description": "用户角色"
          },
          "action": {
            "type": "string",
            "description": "想要做的事"
          },
          "goal": {
            "type": "string",
            "description": "达成的目标"
          },
          "related_requirements": {
            "type": "array",
            "description": "关联的需求 ID 列表",
            "items": {
              "type": "string",
              "pattern": "^REQ-\\d{3,}$"
            }
          }
        }
      }
    },
    "priorities": {
      "type": "object",
      "description": "需求优先级映射 {REQ-ID: 优先级}",
      "patternProperties": {
        "^REQ-\\d{3,}$": {
          "type": "string",
          "enum": ["高", "中", "低"]
        }
      },
      "additionalProperties": false
    }
  }
}
