{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/prd-schema.json",
  "title": "PRD Schema",
  "description": "CogniForge 产品需求文档 JSON Schema",
  "type": "object",
  "required": ["meta", "overview", "requirements", "user_stories", "priorities"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created", "version"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "文档唯一标识，如 prd-001"
        },
        "type": {
          "type": "string",
          "const": "prd"
        },
        "title": {
          "type": "string",
          "description": "项目名称"
        },
        "author": {
          "type": "string",
          "description": "作者标识，如 pm_agent"
        },
        "created": {
          "type": "string",
          "description": "创建时间，ISO 格式"
        },
        "version": {
          "type": "integer",
          "description": "版本号"
        }
      }
    },
    "overview": {
      "type": "string",
      "description": "项目概述"
    },
    "requirements": {
      "type": "array",
      "description": "功能需求列表",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "需求名称"
          },
          "description": {
            "type": "string",
            "description": "需求描述"
          },
          "acceptance_criteria": {
            "type": "array",
            "description": "验收条件",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "user_stories": {
      "type": "array",
      "description": "用户故事列表",
      "items": {
        "type": "object",
        "required": ["role", "action", "goal"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "description": "用户角色"
          },
          "action": {
            "type": "string",
            "description": "想要做的事"
          },
          "goal": {
            "type": "string",
            "description": "达成的目标"
          }
        }
      }
    },
    "priorities": {
      "type": "object",
      "description": "需求优先级映射 {需求名: 高/中/低}",
      "additionalProperties": {
        "type": "string",
        "enum": ["高", "中", "低"]
      }
    }
  }
}
