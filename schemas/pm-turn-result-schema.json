{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/pm-turn-result-schema.json",
  "title": "PM Turn Result Schema",
  "description": "PM 每轮交互输出的结构化变更结果",
  "type": "object",
  "required": ["status", "operation", "message"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["updated", "need_clarification", "rejected", "no_change"],
      "description": "本轮处理状态"
    },
    "operation": {
      "type": "string",
      "enum": ["add", "modify", "remove", "deprecate", "merge", "split", "supersede", "reprioritize", "clarify", "no_change"],
      "description": "本轮执行的变更操作类型"
    },
    "doc_changed": {
      "type": "string",
      "const": "prd",
      "description": "被修改的文档类型"
    },
    "changed_file": {
      "type": "string",
      "default": "docs/prd.json",
      "description": "被修改的文件路径"
    },
    "affected_requirements": {
      "type": "array",
      "description": "本轮影响的需求列表",
      "items": {
        "type": "object",
        "required": ["id", "change_type"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-\\d{3,}$",
            "description": "需求 ID"
          },
          "change_type": {
            "type": "string",
            "enum": ["created", "modified", "removed", "deprecated", "merged", "split", "superseded", "reprioritized", "unchanged"],
            "description": "变更类型"
          },
          "before": {
            "type": "string",
            "description": "变更前的摘要（如适用）"
          },
          "after": {
            "type": "string",
            "description": "变更后的摘要（如适用）"
          },
          "reason": {
            "type": "string",
            "description": "变更原因"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "本轮检测到的冲突",
      "items": {
        "type": "object",
        "required": ["conflict_with", "description", "resolution"],
        "additionalProperties": false,
        "properties": {
          "conflict_with": {
            "type": "string",
            "description": "冲突对象（需求 ID）"
          },
          "description": {
            "type": "string",
            "description": "冲突描述"
          },
          "resolution": {
            "type": "string",
            "enum": ["resolved_by_update", "resolved_by_deprecation", "resolved_by_merge", "left_open", "rejected"],
            "description": "冲突解决方式"
          }
        }
      }
    },
    "message": {
      "type": "string",
      "description": "本轮操作的人类可读摘要"
    },
    "open_questions": {
      "type": "array",
      "description": "需要用户澄清的问题列表",
      "items": {
        "type": "string"
      }
    },
    "patches": {
      "type": "array",
      "description": "RFC 6902 JSON Patch 操作列表，直接作用于 prd.json",
      "items": {
        "type": "object",
        "required": ["op", "path", "value"],
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": ["add", "remove", "replace", "copy", "move", "test"],
            "description": "补丁操作类型"
          },
          "path": {
            "type": "string",
            "description": "JSON Pointer 路径"
          },
          "value": {
            "description": "操作值（add/replace/test 需要）"
          }
        }
      }
    }
  }
}
