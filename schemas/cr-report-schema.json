{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/cr-report-schema.json",
  "title": "CR Report Schema",
  "description": "Reviewer Agent 代码评审报告的结构化输出",
  "type": "object",
  "required": ["meta", "content"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["doc_id", "type", "title", "author", "created"],
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "description": "文档唯一标识，格式: cr-{module}-{seq}"
        },
        "type": {
          "type": "string",
          "const": "report",
          "description": "文档类型"
        },
        "title": {
          "type": "string",
          "description": "报告标题"
        },
        "author": {
          "type": "string",
          "const": "review_agent",
          "description": "作者标识"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "创建时间"
        }
      }
    },
    "content": {
      "type": "string",
      "description": "CR 评审内容，使用 PASS/FAIL 标注每项检查，包含改进建议"
    }
  }
}
