{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://cogniforge.dev/schemas/mde-turn-result-schema.json",
  "title": "MDE Turn Result Schema",
  "description": "MDE (Design) Agent 每轮 LLD 变更的结构化输出",
  "type": "object",
  "required": [
    "status", "operation", "module", "module_type",
    "doc_changed", "changed_file", "source",
    "affected_requirements", "affected_components", "affected_contracts",
    "affected_lld_objects", "upstream_issues",
    "conflicts", "open_questions", "patches",
    "implementation_handoff", "test_handoff", "message"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["updated", "need_clarification", "rejected", "no_change"],
      "description": "本轮处理状态"
    },
    "operation": {
      "type": "string",
      "enum": [
        "initial_generate",
        "modify_module",
        "add_interface", "modify_interface", "deprecate_interface",
        "add_data_model", "modify_data_model", "deprecate_data_model",
        "add_business_rule", "modify_business_rule",
        "add_domain_object", "modify_domain_object",
        "add_service_contract", "modify_service_contract",
        "add_flow", "modify_flow",
        "add_component_tree", "modify_component_tree",
        "add_route", "modify_route",
        "add_middleware", "modify_middleware",
        "add_index", "modify_index",
        "add_message_contract", "modify_message_contract",
        "update_traceability",
        "clarify", "no_change"
      ],
      "description": "本轮执行的 LLD 操作类型"
    },
    "module": { "type": "string", "description": "模块名" },
    "module_type": {
      "type": "string",
      "enum": ["service", "frontend", "gateway", "database", "infrastructure"]
    },
    "doc_changed": { "type": "boolean", "description": "本轮是否修改了 LLD 文档" },
    "changed_file": { "type": "string", "description": "被修改的 LLD 文件路径" },
    "source": {
      "type": "object",
      "required": [
        "prd_doc_id", "prd_version",
        "sad_doc_id", "sad_version", "se_turn_id",
        "lld_doc_id", "lld_before_version", "lld_after_version"
      ],
      "additionalProperties": false,
      "properties": {
        "prd_doc_id": { "type": "string" },
        "prd_version": { "type": "integer" },
        "sad_doc_id": { "type": "string" },
        "sad_version": { "type": "integer" },
        "se_turn_id": { "type": "string" },
        "lld_doc_id": { "type": "string" },
        "lld_before_version": { "type": "integer" },
        "lld_after_version": { "type": "integer" }
      }
    },
    "affected_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "impact", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "impact": { "type": "string", "enum": ["covered", "partially_covered", "uncovered", "changed", "blocked"] },
          "reason": { "type": "string" }
        }
      }
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "change_type", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "change_type": { "type": "string", "enum": ["used", "created", "modified", "deprecated", "removed", "unchanged"] },
          "reason": { "type": "string" }
        }
      }
    },
    "affected_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "change_type", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "change_type": { "type": "string", "enum": ["implemented", "consumed", "modified", "deprecated", "blocked", "unchanged"] },
          "reason": { "type": "string" }
        }
      }
    },
    "affected_lld_objects": {
      "type": "array",
      "description": "本轮修改的 LLD 内部对象",
      "items": {
        "type": "object",
        "required": ["id", "object_type", "change_type", "before", "after", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "object_type": {
            "type": "string",
            "enum": [
              "data_model", "interface", "domain_object",
              "service_contract", "business_rule",
              "frontend_component", "route", "state", "interaction_flow",
              "gateway_route", "middleware", "auth_policy", "rate_limiting",
              "database_index", "migration", "capacity",
              "message_contract", "reliability_rule", "topology"
            ]
          },
          "change_type": { "type": "string", "enum": ["created", "modified", "deprecated", "removed", "unchanged"] },
          "before": { "type": "string" },
          "after": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "upstream_issues": {
      "type": "array",
      "description": "MDE 发现的 PRD/SAD 问题，反馈给上游",
      "items": {
        "type": "object",
        "required": ["target", "issue_type", "description", "suggested_action"],
        "additionalProperties": false,
        "properties": {
          "target": { "type": "string", "enum": ["prd", "sad", "se", "pm"] },
          "issue_type": {
            "type": "string",
            "enum": [
              "missing_requirement", "ambiguous_requirement",
              "incomplete_contract", "missing_component_owner",
              "contract_conflict", "data_model_conflict", "architecture_gap"
            ]
          },
          "description": { "type": "string" },
          "suggested_action": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_with", "description", "resolution"],
        "additionalProperties": false,
        "properties": {
          "conflict_with": { "type": "string" },
          "description": { "type": "string" },
          "resolution": { "type": "string", "enum": ["resolved_by_update", "left_open", "rejected"] }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "patches": {
      "type": "array",
      "description": "RFC 6902 JSON Patch 操作列表，作用于当前模块的 LLD 文件",
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "additionalProperties": false,
        "properties": {
          "op": { "type": "string", "enum": ["add", "replace", "remove"] },
          "path": { "type": "string" },
          "value": {}
        }
      }
    },
    "implementation_handoff": {
      "type": "array",
      "description": "传递给 Dev Agent 的实现任务",
      "items": { "type": "string" }
    },
    "test_handoff": {
      "type": "array",
      "description": "传递给 QA Agent 的测试任务",
      "items": { "type": "string" }
    },
    "message": {
      "type": "string",
      "description": "本轮操作的人类可读摘要"
    }
  }
}
