#!/usr/bin/env bash
# 拦截 wiki 文件被提交到非 wiki 分支

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# wiki 分支允许提交
if [ "$CURRENT_BRANCH" = "wiki" ]; then
    exit 0
fi

# 检测是否暂存了 wiki 文件
WIKI_FILES=$(git diff --cached --name-only 2>/dev/null | grep '^\.cogniforge/wiki/' || true)

if [ -n "$WIKI_FILES" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  ⛔ 禁止将 wiki 文件提交到 '$CURRENT_BRANCH' 分支"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║  以下 wiki 文件已被暂存:"
    while IFS= read -r f; do
        printf "║    • %s\n" "$f"
    done <<< "$WIKI_FILES"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║  wiki 变更请通过 CogniForge 提交:"
    echo "║    cogniforge wiki push"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

exit 0
