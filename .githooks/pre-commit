#!/usr/bin/env bash
# 拦截 wiki/html 文件被提交到非 wiki 分支
# 三层防线第2层：拦截 git add -f 绕过 .gitignore 的行为

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# wiki 分支允许提交一切
if [ "$CURRENT_BRANCH" = "wiki" ]; then
    exit 0
fi

# 检测是否暂存了 .cogniforge 下的内容文件（wiki + html）
# --diff-filter=AM 只拦截新增和修改，放行删除（git rm）
BLOCKED_FILES=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -E '^\.cogniforge/(wiki|html)/' || true)

if [ -n "$BLOCKED_FILES" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  ⛔ 禁止将 wiki/html 文件提交到 '$CURRENT_BRANCH' 分支"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║  以下文件已被暂存:"
    while IFS= read -r f; do
        printf "║    • %s\n" "$f"
    done <<< "$BLOCKED_FILES"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║  wiki/html 变更请通过 CogniForge 提交:"
    echo "║    cogniforge wiki push"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

exit 0
