  "system_overview": {
    "description": "DeployFlow 是一款面向开发与运维人员的轻量级自动化部署客户端，运行于用户本地计算机。它提供图形化界面，支持多项目管理、多环境配置、SSH 安全连接、一键自动化部署、实时日志输出、部署历史追溯与一键回滚，以及部署脚本模板定制等功能。系统采用单体本地应用架构，通过内置后端服务与前端 SPA 配合，直接操作本地数据库和远程服务器，无需中心化服务端。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "管理项目下的环境配置",
          "测试连接",
          "执行部署",
          "查看实时日志"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "执行包体部署",
          "查看部署日志"
        ]
      },
      {
        "name": "技术经理",
        "permissions": [
          "创建/编辑/删除项目",
          "导入导出项目配置",
          "项目级管理权限"
        ]
      },
      {
        "name": "安全审计人员",
        "permissions": [
          "管理 SSH 密钥",
          "设置主密码",
          "查看密钥使用记录"
        ]
      },
      {
        "name": "SRE",
        "permissions": [
          "查看部署历史",
          "执行回滚操作",
          "清理过期版本"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层单体架构",
    "description": "系统将表现层、接入层、业务服务层和基础设施层进行分层设计，整体打包为桌面可执行程序。层间通过内部函数调用或本地 HTTP/WebSocket 通信，各业务模块独立成服务，通过依赖注入协作。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "前端管理界面"
        ]
      },
      {
        "name": "接入层",
        "components": [
          "API网关/路由"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署引擎服务",
          "密钥管理服务",
          "部署历史与回滚服务",
          "脚本模板服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "数据库层",
          "SSH客户端封装",
          "加密服务",
          "文件打包与解压工具"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTP REST + WebSocket",
        "description": "表现层与接入层之间的通信，通过本地 HTTP（127.0.0.1）的 REST API 调用与 WebSocket 长连接推送部署日志。"
      },
      {
        "protocol": "Python函数调用",
        "description": "接入层与业务服务层之间通过 FastAPI 路由分发，业务服务之间采用直接的 Python 类方法调用。"
      },
      {
        "protocol": "SQLAlchemy ORM",
        "description": "业务服务层通过 SQLAlchemy session 访问基础设施层的 SQLite 数据库，ORM 模型定义在数据库层组件中。"
      },
      {
        "protocol": "SSH/SFTP",
        "description": "业务服务层通过基础设施层的 SSH 客户端封装，使用 Paramiko 实现的 SSH2 协议连接远程服务器。"
      }
    ],
    "features": [
      "前后端分离的单体本地应用架构",
      "基于 FastAPI 的异步后端，高并发处理 WebSocket 连接",
      "使用 SQLite 嵌入式数据库，无需额外服务进程",
      "SSH 连接异步管理，支持多环境并发测试与部署",
      "主密码+AES-256-CBC 加密保护密钥库，满足本地离线安全需求",
      "Jinja2 模板引擎动态生成服务器端脚本",
      "部署过程实时日志推送，任务异步执行，失败自动回滚",
      "整体通过 PyInstaller 打包为单一可执行文件，跨平台分发"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.10+",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3 + TypeScript",
      "ui_library": "Element Plus"
    },
    "database": "SQLite (通过 SQLAlchemy ORM)",
    "ssh_library": "Paramiko",
    "encryption": "AES-256-CBC + PBKDF2",
    "template_engine": "Jinja2",
    "packaging": "PyInstaller"
  },
