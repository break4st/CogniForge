  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户在前端选择项目、环境、本地包体路径，点击部署。",
        "前端调用 POST /api/deploy，提交部署任务。",
        "部署引擎生成 task_id 并立即返回 202。",
        "引擎从环境服务获取环境配置及解密后的 SSH 密钥。",
        "通过 SSH 客户端连接远程服务器，验证可写性。",
        "生成唯一版本目录名，在远程创建目录。",
        "通过 SFTP 分块上传包体文件，同时通过 WebSocket 推送进度。",
        "在远端解压（如果需要）并设置文件权限。",
        "从脚本模板服务获取渲染后的启停脚本并上传至远程目录，添加执行权限。",
        "可选地执行用户自定义的后置命令。",
        "全部成功后，记录部署历史（成功状态）。",
        "若任何步骤失败，自动执行回滚：删除已创建的远程版本目录，推送失败结果并记录失败历史。"
      ]
    },
    {
      "name": "回滚流程",
      "steps": [
        "用户在历史界面筛选目标版本，点击回滚并二次确认。",
        "前端调用 POST /api/deploy-history/{id}