  "title": "System Architecture Design",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "DeployForge 是一款面向开发者的轻量级跨平台桌面工具（基于 Electron），用于本地管理多个项目并一键部署到远程服务器。系统提供直观的图形界面，允许用户配置多套环境（测试、灰度、生产），并进行安全的 SSH 连接、文件上传、版本化目录管理、启动脚本生成、部署历史追溯及回滚等操作。所有敏感数据在本地加密存储，部署过程提供实时进度反馈。",
    "roles": [
      {
        "name": "用户",
        "permissions": [
          "项目管理",
          "环境配置",
          "密钥管理",
          "一键部署",
          "历史查看与回滚",
          "脚本模板编辑"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 微内核（Electron 桌面应用）",
    "description": "整体分为表现层、通信层、核心服务层和存储层。表现层使用 React 构建，通过 Electron IPC 与主进程通信；核心服务层包含项目管理、环境管理、部署编排、SSH 客户端、脚本模板、历史版本、加密等服务；存储层使用 SQLite 和本地文件系统。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "React 应用组件（项目管理面板、环境配置表单、部署面板、历史记录列表、模板编辑器等）"
        ]
      },
      {
        "name": "通信层",
        "components": [
          "Electron IPC（ipcRenderer/ipcMain）"
        ]
      },
      {
        "name": "核心服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署编排引擎",
          "SSH客户端",
          "脚本模板服务",
          "历史版本服务",
          "加密服务"
        ]
      },
      {
        "name": "存储层",
        "components": [
          "SQLite 数据库",
          "文件系统（密钥库）"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "异步 IPC 消息 (JSON)",
        "description": "表现层与核心服务层通过主进程的 IPC 通道进行双向异步通信"
      },
      {
        "protocol": "内部函数调用/事件总线",
        "description": "通信层与核心服务层运行于同一 Node.js 主进程，通过直接函数调用和事件总线交互"
      },
      {
        "protocol": "SQL / ORM",
        "description": "核心服务层通过 better-sqlite3 同步 API 操作 SQLite 数据库"
      },
      {
        "protocol": "SSH (22端口) / SFTP",
        "description": "部署引擎和 SSH 客户端通过 SSH 协议与远程服务器通信，进行命令执行和文件传输"
      }
    ],
    "features": [
      "跨平台（Windows/macOS/Linux）",
      "离线可用，本地优先",
      "模块化、松耦合的服务设计",
      "基于时间戳的版本化部署与软链接回滚",
      "脚本模板可配置，支持多种语言/框架",
      "敏感数据 AES-256-GCM 加密存储",
      "SSH 加密隧道与主机密钥验证",
      "Electron 桌面应用，打包体积可控"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "TypeScript",
      "framework": "Node.js 20"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design",
      "state_management": "Zustand"
    },
    "database": "SQLite (better-sqlite3)",
    "ssh_library": "ssh2",
    "template_engine": "Handlebars",
    "encryption": "Node.js crypto (AES-256-GCM)",
    "logging": "winston",
    "packaging": "electron-builder"
  },
