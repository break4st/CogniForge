    "module_overview": "密钥管理服务负责主密码设定、验证，对私钥进行AES-256加密后持久化存储，并提供内存解密接口供其他服务使用，确保私钥不落盘。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [
        {
          "id": "SC-001",
          "name": "KeyManagementServiceContract",
          "description": "定义KeyManagementService提供的业务操作契约",
          "operations": [
            {
              "name": "upload_key",
              "description": "上传或更新指定环境的SSH私钥",
              "parameters": [
                {
                  "name": "environment_id",
                  "type": "integer"
                },
                {
                  "name": "master_password",
                  "type": "string"
                },
                {
                  "name": "key_file",
                  "type": "file"
                }
              ],
              "preconditions": [
                "环境必须存在",
                "主密码必须已设置且正确",
                "上传文件必须是有效PEM格式私钥"
              ],
              "postconditions": [
                "私钥加密后安全存储",
                "返回密钥指纹"
              ],
              "exceptions": [
                "ENV_NOT_FOUND",
                "UNAUTHORIZED",
                "INVALID_KEY",
                "ENCRYPTION_FAILED"
              ]
            },
            {
              "name": "set_master_password",
              "description": "首次设置或修改主密码",
              "parameters": [
                {
                  "name": "new_password",
                  "type": "string"
                }
              ],
              "preconditions": [
                "如果是修改，需提供旧密码验证"
              ],
              "postconditions": [
                "主密码哈希和盐值更新保存"
              ],
              "exceptions": [
                "WEAK_PASSWORD",
                "AUTH_FAILED"
              ]
            },
            {
              "name": "decrypt_key",
              "description": "内部解密私钥并在内存中提供（非API）",
              "parameters": [
                {
                  "name": "environment_id",
                  "type": "integer"
                },
                {
                  "name": "master_password",
                  "type": "string"
                }
              ],
              "preconditions": [
                "私钥存在且加密存储",
                "主密码正确"
              ],
              "postconditions": [
                "返回解密后的私钥对象（仅内存）"
              ],
              "exceptions": [
                "ENV_NOT_FOUND",
                "DECRYPTION_FAILED"
              ]
            }
          ]
        }
      ],
