          {
            "name": "KeyBindingPage",
            "path": "/projects/:pid/environments/:eid/keys",
            "description": "SSH 密钥绑定页，支持上传密钥文件或粘贴私钥内容",
            "props": [],
            "events": [],
            "state": [
              {
                "name": "environment",
                "type": "Environment",
                "description": "当前绑定的环境信息"
              },
              {
                "name": "keyBound",
                "type": "boolean",
                "description": "是否已成功绑定密钥"
              },
              {
                "name": "boundKeyInfo",
                "type": "object|null",
                "description": "已绑定密钥的信息（指纹等）"
              }
            ],
            "behavior": [
              "mount 时从 EnvironmentStore 加载当前环境信息",
              "密钥绑定成功后更新 keyBound 和 boundKeyInfo 状态"
            ],
            "edge_cases": [
              "环境已被其他用户删除（404）：展示错误提示并提供返回环境列表的链接",
              "密钥已绑定：展示已绑定密钥信息，提供重新绑定的确认按钮"
            ],
            "children": [
              {
                "name": "KeyUploadForm",
                "path": "/projects/:pid/environments/:eid/keys",
                "description": "SSH 密钥上传/粘贴表单，支持文件选择和文本粘贴两种方式",
                "props": [
                  {
                    "name": "environmentId",
                    "type": "integer",
                    "required": true,
                    "description": "目标环境 ID"
                  },
                  {
                    "name": "disabled",
                    "type": "boolean",
                    "required": false,
                    "description": "是否禁用表单（密钥已绑定时）"
                  }
                ],
                "events": [
                  {
                    "name": "bound",
                    "payload_type": "object"
                  },
                  {
                    "name": "error",
                    "payload_type": "string"
                  }
                ],
                "state": [
                  {
                    "name": "inputMode",
                    "type": "string",
                    "description": "输入模式：file（上传文件）或 paste（粘贴内容）"
                  },
                  {
                    "name": "form",
                    "type": "object",
                    "description": "表单数据 {key_name, private_key, passphrase}"
                  },
                  {
                    "name": "submitting",
                    "type": "boolean",
                    "description": "提交中"
                  }
                ],
                "behavior": [
                  "inputMode 切换时切换文件上传组件和文本输入框",
                  "提交时调用 POST /api/v1/environments/:eid/keys",
                  "绑定成功后触发 bound 事件并清空表单",
                  "文件上传模式：使用 FileReader 读取文件内容填充 private_key 字段"
                ],
                "edge_cases": [
                  "上传的密钥文件格式不正确（非 PEM 格式）：展示格式错误提示",
                  "粘贴的私钥内容包含多余空格或换行：前端做 trim 处理",
                  "passphrase 为可选字段，为空时不发送",
                  "密钥已绑定且 disabled=true 时：展示只读信息和「重新绑定」按钮"
                ],
                "children": []
              },
              {
                "name": "ConnectionTestButton",
                "path": "/projects/:pid/environments/:eid/keys",
                "description": "SSH 连接测试按钮，触发后展示测试结果",
                "props": [
                  {
                    "name": "environmentId",
                    "type": "integer",
                    "required": true,
                    "description": "目标环境 ID"
                  },
                  {
                    "name": "keyBound",
                    "type": "boolean",
                    "required": true,
                    "description": "密钥是否已绑定"
                  }
                ],
                "events": [
                  {
                    "name": "testResult",
                    "payload_type": "object"
                  }
                ],
                "state": [
                  {
                    "name": "testing",
                    "type": "boolean",
                    "description": "是否正在测试连接"
                  },
                  {
                    "name": "result",
                    "type": "object|null",
                    "description": "测试结果 {reachable, latency_ms, server_info, error}"
                  }
                ],
                "behavior": [
                  "点击按钮时调用 GET /api/v1/environments/:eid/test",
                  "测试期间按钮显示加载状态和「测试中...」文字",
                  "结果展示：成功显示绿色对勾和延迟信息，失败显示红色叉号和错误详情",
                  "接收 bound 事件后自动触发一次连接测试"
                ],
                "edge_cases": [
                  "密钥未绑定时按钮置灰并提示「请先绑定密钥」",
                  "测试请求超时（超过 30s）：展示超时错误并提示用户检查网络和服务器状态",
                  "按钮快速连点：请求发起后禁用按钮直至结果返回",
                  "测试结果中 reachable=false 但无具体 error：展示「目标服务器无响应」通用提示"
                ],
                "children": []
              }
            ]
          }
