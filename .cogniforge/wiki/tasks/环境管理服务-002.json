          "description": "环境配置信息表，存储各项目部署环境的连接参数与部署路径，引用自Primary Database LLD。",
          "fields": [
            {
              "name": "id",
              "type": "UUID",
              "required": true,
              "description": "环境唯一标识"
            },
            {
              "name": "project_id",
              "type": "UUID",
              "required": true,
              "description": "关联的项目ID"
            },
            {
              "name": "name",
              "type": "VARCHAR(255)",
              "required": true,
              "description": "环境名称"
            },
            {
              "name": "host",
              "type": "VARCHAR(255)",
              "required": true,
              "description": "服务器主机名或IP地址"
            },
            {
              "name": "port",
              "type": "INTEGER",
              "required": false,
              "description": "SSH端口号，默认22"
            },
            {
              "name": "username",
              "type": "VARCHAR(255)",
              "required": true,
              "description": "SSH登录用户名"
            },
            {
              "name": "deploy_path",
              "type": "TEXT",
              "required": true,
              "description": "部署到目标服务器的路径"
            },
            {
              "name": "key_material_id",
              "type": "UUID",
              "required": false,
              "description": "关联的密钥材料ID，外键引用密钥管理服务的密钥表"
