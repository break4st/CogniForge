  "context": {
    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/SSH连接池服务/lld-SSH连接池服务-001.json",
    "module_overview": "管理与远程服务器的SSH连接池，提供高效、可复用的远程连接能力，支持连接健康检查、自动重连、远程命令执行和文件传输通道提供",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "SshConnection",
            "states": [
              "idle",
              "active",
              "reconnecting",
              "closed",
              "error"
            ],
            "transitions": [
              {
                "from": "closed",
                "to": "idle",
                "trigger": "新建SSH连接（connect）成功",
                "actor": "连接池管理器"
              },
              {
                "from": "error",
                "to": "idle",
                "trigger": "错误重试后新建连接成功",
                "actor": "连接池管理器"
              },
              {
                "from": "idle",
                "to": "active",
                "trigger": "从池中分配连接用于命令执行或通道创建",
                "actor": "SshConnectionPoolService"
              },
              {
                "from": "active",
                "to": "idle",
                "trigger": "命令执行完成，释放通道后归还连接",
                "actor": "SshConnectionPoolService"
              },
              {
                "from": "active",
                "to": "reconnecting",
                "trigger": "健康检测发现transport断开（网络闪断）",
                "actor": "健康检查器"
              },
              {
                "from": "reconnecting",
                "to": "idle",
                "trigger": "重连成功，transport重新建立",
                "actor": "连接池管理器"
              },
              {
                "from": "reconnecting",
                "to": "error",
                "trigger": "重试max_retry_attempts次后仍失败",
                "actor": "连接池管理器"
              },
              {
                "from": "idle",
                "to": "closed",
                "trigger": "空闲超时关闭或主动调用release_connection",
                "actor": "清理任务或外部调用"
              },
              {
                "from": "error",
                "to": "closed",
                "trigger": "手动清理异常连接",
                "actor": "连接池管理器"
              },
              {
                "from": "active",
                "to": "error",
                "trigger": "命令执行中发生不可恢复异常（如SSH断开）",
                "actor": "SshConnectionPoolService"
              }
            ],
            "irreversible_rules": [
              "状态进入closed或error后必须由连接池管理器创建全新连接才能回到idle，不可从closed/error直接转为active",
              "active到error的转换不可逆，异常连接不能直接恢复为active"
            ],
            "concurrency": "连接池内部使用threading.Lock保护connections列表的读写，分配和归还操作互斥。单个SshConnection的state变更通过连接对象级锁同步，防止同一连接被并发分配给多个请求"
          }
        ]
      },
      "error_handling": {},
      "extra_sections": {}
    },
