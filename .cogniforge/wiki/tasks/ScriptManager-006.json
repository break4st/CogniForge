    "module_overview": "运维人员编写、管理启动/停止脚本模板，并对目标环境远程执行这些脚本的前端界面。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {},
      "error_handling": {},
      "extra_sections": {
        "component_tree": [
          {
            "name": "ScriptManagerApp",
            "path": "/scripts/*",
            "description": "脚本管理模块根路由容器，渲染子路由组件",
            "props": [],
            "events": [],
            "state": [
              {
                "name": "authToken",
                "type": "string",
                "description": "用户认证令牌，从全局 AuthProvider 获取"
              }
            ],
            "behavior": [
              "嵌套路由组件 <Outlet />，根据当前路径渲染对应子页面"
            ],
            "edge_cases": [
              "权限校验由全局路由守卫完成，模块内不做二次校验"
            ],
            "children": [
              {
                "name": "ScriptListPage",
                "path": "/scripts",
                "description": "脚本模板列表页，支持删除、跳转编辑/执行",
                "props": [],
                "events": [],
                "state": [
                  {
                    "name": "templates",
                    "type": "ScriptTemplate[]",
                    "description": "脚本模板列表"
                  },
                  {
                    "name": "loading",
                    "type": "boolean",
                    "description": "列表加载状态"
                  }
                ],
                "behavior": [
                  "挂载时调用 GET /api/script-templates 获取列表",
                  "点击「新建」跳转至 /scripts/new",
                  "点击「编辑」跳转至 /scripts/:id/edit",
                  "点击「执行」跳转至 /scripts/:id/execute",
                  "点击「删除」弹出确认框，确认后调用 DELETE /api/script-templates/:id，成功后刷新列表"
                ],
                "edge_cases": [
                  "列表为空时显示 Ant Design Empty 组件，并提供「创建第一个脚本」引导",
                  "删除操作返回错误时，提示用户「删除失败：xxx」",
                  "网络请求异常时展示错误提示"
                ],
                "children": [
                  {
                    "name": "ScriptTable",
                    "path": "列表页内部组件",
                    "description": "使用 Ant Design Table 渲染脚本模板列表",
                    "props": [
                      {
                        "name": "templates",
                        "type": "ScriptTemplate[]",
                        "required": true,
                        "description": "模板数据"
                      },
                      {
                        "name": "loading",
                        "type": "boolean",
                        "required": true,
                        "description": "加载状态"
                      },
                      {
                        "name": "onEdit",
                        "type": "(id: string) => void",
                        "required": true,
                        "description": "编辑回调"
                      },
                      {
                        "name": "onExecute",
                        "type": "(id: string) => void",
                        "required": true,
                        "description": "执行回调"
                      },
                      {
                        "name": "onDelete",
                        "type": "(id: string) => void",
                        "required": true,
                        "description": "删除回调"
                      }
                    ],
                    "events": [],
                    "state": [],
                    "behavior": [
                      "展示列：名称、类型、更新时间、操作（编辑、执行、删除）"
                    ],
                    "edge_cases": [
                      "无数据时呈现 Table 的 emptyText"
                    ]
                  }
                ]
              },
              {
                "name": "ScriptForm",
                "path": [
                  "/scripts/new",
                  "/scripts/:id/edit"
                ],
                "description": "脚本模板新增/编辑表单",
                "props": [
                  {
                    "name": "mode",
                    "type": "'create' | 'edit'",
                    "required": true,
                    "description": "表单模式"
                  },
                  {
                    "name": "templateId",
                    "type": "string",
                    "required": false,
                    "description": "编辑模式下的模板 ID"
                  }
                ],
                "events": [],
                "state": [
                  {
                    "name": "formData",
                    "type": "{ name: string, type: 'start' | 'stop', content: string }",
                    "description": "表单数据"
                  },
                  {
                    "name": "loading",
                    "type": "boolean",
                    "description": "提交加载状态"
                  },
                  {
                    "name": "originalData",
                    "type": "ScriptTemplate | null",
                    "description": "编辑模式下的原始数据"
                  }
                ],
                "behavior": [
                  "创建模式：直接渲染空表单",
                  "编辑模式：挂载时通过 templateId 调用 GET /api/script-templates/:id 填充表单",
                  "提交时调用 POST /api/script-templates（创建）或 PUT /api/script-templates/:id（更新）",
                  "保存成功后跳转回列表页，失败则显示错误提示"
                ],
                "edge_cases": [
                  "表单校验：名称必填，脚本内容必填",
                  "编辑时若模板不存在（404），显示错误并跳转回列表页",
                  "保存按钮设置 loading 状态防止重复提交"
                ]
              },
              {
                "name": "ScriptExecutePage",
                "path": "/scripts/:id/execute",
                "description": "选择目标主机并执行脚本，实时查看输出",
                "props": [],
                "events": [],
                "state": [
                  {
                    "name": "template",
                    "type": "ScriptTemplate | null",
                    "description": "当前模板信息"
                  },
                  {
                    "name": "hosts",
                    "type": "HostInfo[]",
                    "description": "可用主机列表"
                  },
                  {
                    "name": "selectedHostId",
                    "type": "string | null",
                    "description": "选中的主机 ID"
                  },
                  {
                    "name": "session",
                    "type": "ExecutionSession | null",
                    "description": "执行会话"
                  },
                  {
                    "name": "output",
                    "type": "string",
                    "description": "累积的输出文本"
                  },
                  {
                    "name": "executing",
                    "type": "boolean",
                    "description": "是否正在执行"
                  }
                ],
                "behavior": [
                  "挂载时获取模板详情 GET /api/script-templates/:id",
                  "获取主机列表 GET /api/hosts",
                  "用户选择主机后点击执行按钮，调用 POST /api/execute-script",
                  "获取 sessionId 后建立 WebSocket 连接 ws://<gateway>/ws/script-output/{sessionId}",
                  "接收 onmessage 事件追加输出文本",
                  "提供「中止执行」按钮，调用 POST /api/abort-execution"
                ],
                "edge_cases": [
                  "模板不存在（404）时提示并禁用执行",
                  "主机列表加载失败时提示用户检查环境模块",
                  "WebSocket 连接失败时重试 3 次，均失败则提示用户手动刷新",
                  "用户离开页面时弹出确认框「执行仍在进行，离开将断开连接」",
                  "输出过大时采用虚拟滚动渲染"
                ],
                "children": [
                  {
                    "name": "HostSelector",
                    "path": "执行页内部组件",
                    "description": "主机选择器，下拉或表格单选",
                    "props": [
                      {
                        "name": "hosts",
                        "type": "HostInfo[]",
                        "required": true,
                        "description": "主机列表"
                      },
                      {
                        "name": "selectedHostId",
                        "type": "string | null",
                        "required": false,
                        "description": "当前选中主机 ID"
                      },
                      {
                        "name": "onSelect",
                        "type": "(hostId: string) => void",
                        "required": true,
                        "description": "选择回调"
                      }
                    ],
                    "events": [
                      {
                        "name": "onSelect",
                        "payload_type": "string (hostId)"
                      }
                    ],
                    "state": [],
                    "behavior": [
                      "渲染 Ant Design Select 或 Radio.Group 展示主机名称和地址"
                    ],
                    "edge_cases": [
                      "主机列表为空时提示「无可用主机」",
                      "加载失败时在组件内显示错误信息"
                    ]
                  },
                  {
                    "name": "OutputPanel",
                    "path": "执行页内部组件",
                    "description": "实时显示脚本输出，支持中止操作",
                    "props": [
                      {
                        "name": "output",
                        "type": "string",
                        "required": true,
                        "description": "输出文本"
                      },
                      {
                        "name": "status",
                        "type": "string",
                        "required": true,
                        "description": "执行状态"
                      },
                      {
                        "name": "onAbort",
                        "type": "() => void",
                        "required": true,
                        "description": "中止回调"
                      }
                    ],
                    "events": [
                      {
                        "name": "onAbort",
                        "payload_type": "void"
                      }
                    ],
                    "state": [
                      {
                        "name": "containerRef",
                        "type": "React.RefObject<HTMLDivElement>",
                        "description": "输出容器引用，用于自动滚动到底部"
                      }
                    ],
                    "behavior": [
                      "接收 output 变化后更新显示，并自动滚动到底部",
                      "根据 status 显示不同状态标签",
                      "点击「中止执行」调用 onAbort"
                    ],
                    "edge_cases": [
                      "输出包含 ANSI 颜色码时进行简单解析并着色",
                      "输出行数过多时启用虚拟滚动"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
