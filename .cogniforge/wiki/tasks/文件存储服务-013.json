    "module_overview": "存储用户上传的可执行文件包，支持版本化管理和按需下载。作为基础设施层服务，负责文件在磁盘上的物理存储和元数据管理，为部署引擎提供文件包获取能力，为 Web 控制台提供上传和查询接口",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [
        {
          "name": "上传文件包",
          "method": "POST",
          "endpoint": "/api/v1/projects/:pid/packages",
          "description": "上传可执行文件包到指定项目，支持附带版本号和描述信息",
          "parameters": [
            {
              "name": "pid",
              "type": "integer",
              "description": "项目 ID（路径参数）"
            },
            {
              "name": "file",
              "type": "binary",
              "description": "上传的文件二进制数据（multipart/form-data，字段名 file）"
            },
            {
              "name": "version",
              "type": "string",
              "description": "版本号（可选），同一项目内 version 组合唯一"
            },
            {
              "name": "description",
              "type": "string",
              "description": "文件描述（可选），最大长度 500 字符"
            }
          ],
          "response": {
            "status": 201,
            "body": {
              "id": "integer",
              "project_id": "integer",
              "file_name": "string",
              "checksum": "string",
              "size": "integer",
              "version": "string",
              "uploaded_by": "integer",
              "created_at": "datetime"
            }
          },
          "error_codes": [
            {
              "code": 400,
              "message": "请求参数校验失败，如缺少文件数据或文件名为空"
            },
            {
              "code": 404,
              "message": "项目 ID 不存在"
            },
            {
              "code": 409,
              "message": "版本号冲突，同一项目下已存在相同 version 的文件包"
            },
            {
              "code": 413,
              "message": "文件大小超过单文件限制或项目存储配额已用尽"
            },
            {
              "code": 415,
              "message": "不支持的文件类型，扩展名不在 allowed_file_extensions 列表中"
            }
          ]
        }
      ],
