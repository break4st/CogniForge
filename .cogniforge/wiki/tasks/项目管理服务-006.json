              },
              {
                "from": "ARCHIVED",
                "to": "DELETED",
                "trigger": "管理员执行删除操作且通过关联检查",
                "actor": "管理员"
              }
            ],
            "irreversible_rules": [
              "从ARCHIVED或ACTIVE转换到DELETED后不可逆，且触发软删除或硬删除取决于实现策略（通常采用软删除保留审计）",
              "DELETED状态不能转换到任何其他状态"
