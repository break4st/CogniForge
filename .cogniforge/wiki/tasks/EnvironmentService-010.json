  "context": {
    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/EnvironmentService/lld-EnvironmentService-001.json",
    "module_overview": "环境配置管理服务，提供环境实体的完整生命周期管理，并对登录凭据（密码、私钥）进行加密保护。通过与 SSHService 的内部契约完成连接测试，向 SecurityService 调用加解密工具。所有操作均绑定到具体项目，确保多项目隔离。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [
        {
          "id": "SC-001",
          "name": "EnvironmentServiceContract",
          "description": "环境管理服务契约",
          "methods": [
            {
              "name": "createEnvironment",
              "description": "创建新环境",
              "precondition": "项目存在且用户有权限，环境名在项目内唯一",
              "postcondition": "环境已持久化，凭据已加密",
              "parameters": {
                "dto": "CreateEnvironmentDTO"
              },
              "returns": "Environment",
              "errors": [
                "ProjectNotFoundError",
                "DuplicateEnvironmentError",
                "EncryptionError"
              ],
              "semantics": "接收明文凭据，调用 SecurityService 加密后保存到数据库"
            },
            {
              "name": "getEnvironment",
              "description": "根据 ID 获取环境详情",
              "precondition": "环境存在且请求者有权访问所属项目",
              "postcondition": "返回环境信息，敏感字段保持加密",
              "parameters": {
                "id": "EnvironmentIdDTO"
              },
              "returns": "Environment",
              "errors": [
                "EnvironmentNotFoundError",
                "PermissionDeniedError"
              ],
              "semantics": "从数据库读取，不解密凭据"
            },
            {
              "name": "listEnvironments",
              "description": "列出指定项目的所有环境",
              "precondition": "项目存在且用户有权限",
              "postcondition": "返回环境列表",
              "parameters": {
                "filter": "EnvironmentFilterDTO"
              },
              "returns": "Environment[]",
              "errors": [
                "ProjectNotFoundError",
                "PermissionDeniedError"
              ],
              "semantics": "查询数据库，按项目 ID 过滤"
            },
            {
              "name": "updateEnvironment",
              "description": "更新环境信息",
              "precondition": "环境存在且用户有权限，若更改凭据则新凭据有效",
              "postcondition": "环境已更新，新凭据已重新加密",
              "parameters": {
                "dto": "UpdateEnvironmentDTO"
              },
              "returns": "Environment",
              "errors": [
                "EnvironmentNotFoundError",
                "PermissionDeniedError",
                "EncryptionError"
              ],
              "semantics": "部分更新，若提供密码或私钥则重新加密后替换"
            },
            {
              "name": "deleteEnvironment",
              "description": "删除环境",
              "precondition": "环境存在且无关联的进行中部署",
              "postcondition": "环境已删除",
              "parameters": {
                "id": "EnvironmentIdDTO"
              },
              "returns": "void",
              "errors": [
                "EnvironmentNotFoundError",
                "PermissionDeniedError",
                "EnvironmentInUseError"
              ],
              "semantics": "物理删除记录"
            },
            {
              "name": "testConnection",
              "description": "测试 SSH 连接并获取远程主目录",
              "precondition": "环境存在且凭据可解密",
              "postcondition": "连接测试完成，不改变环境数据",
              "parameters": {
                "dto": "TestConnectionDTO"
              },
              "returns": "ConnectionResultDTO",
              "errors": [
                "EnvironmentNotFoundError",
                "DecryptionError",
                "SshConnectionError"
              ],
              "semantics": "解密凭据后构造 ConnectionConfig 调用 SSHService.testConnection"
            }
          ]
        }
      ],
