  "context": {
    "module_type": "frontend",
    "lld_path": ".cogniforge/wiki/lld/DeployUI/lld-DeployUI-001.json",
    "module_overview": "部署入口的模态框组件，作为环境管理页面的一部分，为用户提供文件选择/拖拽、部署触发及实时进度展示功能。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {},
      "error_handling": {},
      "extra_sections": {
        "component_tree": [
          {
            "name": "DeployModal",
            "path": "环境详情页内嵌模态框",
            "description": "模态框外壳,管理部署生命周期状态,协调子组件通信",
            "props": [
              {
                "name": "visible",
                "type": "boolean",
                "required": true,
                "description": "控制显隐"
              },
              {
                "name": "environmentId",
                "type": "number",
                "required": true,
                "description": "目标环境 ID"
              },
              {
                "name": "onClose",
                "type": "function",
                "required": true,
                "description": "关闭回调"
              }
            ],
            "events": [
              {
                "name": "onDeploySuccess",
                "payload_type": "{ deploy_id: number }"
              },
              {
                "name": "onDeployError",
                "payload_type": "ErrorInfo"
              }
            ],
            "state": [
              {
                "name": "phase",
                "type": "string",
                "description": "阶段: idle / uploading / deploying / completed / failed"
              },
              {
                "name": "file",
                "type": "File / null",
                "description": "选中的文件对象"
              },
              {
                "name": "progress",
                "type": "DeployProgress / null",
                "description": "部署进度"
              },
              {
                "name": "error",
                "type": "ErrorInfo / null",
                "description": "错误信息"
              },
              {
                "name": "ws",
                "type": "WebSocket / null",
                "description": "WebSocket 实例引用"
              }
            ],
            "behavior": [
              "打开模态框后焦点自动落于文件上传区域",
              "用户点击「开始部署」:校验文件,发起 POST 请求上传,phase 变为 uploading",
              "上传成功返回 deploy_id 后,建立 WebSocket 连接,phase 变为 deploying",
              "收到 WebSocket 消息更新 progress,直至 status 变为 completed 或 failed,对应 phase 切换",
              "部署完成后 3 秒自动关闭模态框,并回调 onClose / onDeploySuccess",
              "任何环节出错设置 error 并切换 phase 到 failed"
            ],
            "edge_cases": [
              "文件大小超过前端限制(100MB):提示「文件过大,请压缩后重试」,阻止提交",
              "部署过程中用户强行关闭模态框:弹出确认对话框,确认后断开 WebSocket 并重置状态",
              "短时间内重复打开模态框:重置内部状态,允许重新部署",
              "WebSocket 断线重连失败后,保留最后进度,并显示「连接已中断,部署可能仍在后台执行」"
            ],
            "children": [
              {
                "name": "FileUploader",
                "path": "DeployModal 的子组件",
                "description": "提供文件拖放和点击选择功能,并反馈选中文件名",
                "props": [
                  {
                    "name": "onChange",
                    "type": "function",
                    "required": true,
                    "description": "文件变更回调,传递 File 对象"
                  },
                  {
                    "name": "disabled",
                    "type": "boolean",
                    "required": false,
                    "description": "禁用状态"
                  },
                  {
                    "name": "accept",
                    "type": "string",
                    "required": false,
                    "description": "允许的文件类型,如 .zip"
                  }
                ],
                "events": [
                  {
                    "name": "onDragEnter",
                    "payload_type": "none"
                  },
                  {
                    "name": "onDragLeave",
                    "payload_type": "none"
                  }
                ],
                "state": [
                  {
                    "name": "dragOver",
                    "type": "boolean",
                    "description": "当前拖拽悬停态"
                  },
                  {
                    "name": "fileName",
                    "type": "string / null",
                    "description": "选中文件名"
                  }
                ],
                "behavior": [
                  "支持 HTML5 drag & drop 及 input[type=file] 点击选择",
                  "拖拽文件到区域时高亮边框,离开时恢复",
                  "选择/放置文件后,读取 File 对象并通过 onChange 向上传递,同时显示文件名",
                  "当处于 disabled 状态时,禁止所有交互"
                ],
                "edge_cases": [
                  "用户拖拽多个文件:仅取第一个文件,忽略其余并提示「一次只能部署一个文件」",
                  "选择的文件类型不符合 accept:由浏览器原生筛选过滤,同时前端二次校验,显示「文件类型不支持」提示",
                  "拖拽区域与模态框滚动/点击无冲突(阻止事件冒泡)"
                ],
                "children": []
              },
              {
                "name": "ProgressDisplay",
                "path": "DeployModal 的子组件",
                "description": "以步骤条形式展示部署进度,实时反映当前状态",
                "props": [
                  {
                    "name": "progress",
                    "type": "DeployProgress",
                    "required": true,
                    "description": "包含部署步骤信息"
                  },
                  {
                    "name": "phase",
                    "type": "string",
                    "required": true,
                    "description": "部署阶段"
                  }
                ],
                "events": [],
                "state": [],
                "behavior": [
                  "使用 Ant Design Steps 组件渲染步骤列表,current_step 控制当前激活步骤",
                  "每个步骤展示名称(如「校验环境」「上传文件」「执行部署」「更新版本」)和状态(wait/process/finish/error)",
                  "当 phase 为 failed 且 progress.error 存在时,对应步骤标记为错误,并在步骤下显示错误详情",
                  "progress.message 实时显示在步骤条下方区域"
                ],
                "edge_cases": [
                  "如果 WebSocket 推送的步骤数量与前端预设步骤数不一致,以推送为准并动态调整步骤条",
                  "部署已完成但 progress.status 未及时更新,保持最后状态,不重复标记"
                ],
                "children": []
              },
              {
                "name": "ErrorDisplay",
                "path": "DeployModal 的子组件",
                "description": "当部署过程中出现错误时,高亮显示错误信息,并允许关闭或重试",
                "props": [
                  {
                    "name": "error",
                    "type": "ErrorInfo / null",
                    "required": true,
                    "description": "错误信息"
                  },
                  {
                    "name": "onRetry",
                    "type": "function",
                    "required": false,
                    "description": "重试回调"
                  },
                  {
                    "name": "onClose",
                    "type": "function",
                    "required": false,
                    "description": "关闭错误提示"
                  }
                ],
                "events": [],
                "state": [],
                "behavior": [
                  "当 error 不为 null 时,以 Ant Design Alert 或 Result 呈现,包含错误码、详情,并提供关闭按钮",
                  "如果错误可重试(如网络错误),提供「重试」按钮调用 onRetry",
                  "错误消失后,父组件需重置相关状态"
                ],
                "edge_cases": [
                  "连续出现多个错误:只显示最近一个,旧的自动清除",
                  "用户主动关闭错误后,允许其手动重新部署,不清除文件选择"
                ],
                "children": []
              }
            ]
          }
        ]
      }
