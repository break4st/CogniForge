  "context": {
    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/环境管理服务/lld-环境管理服务-001.json",
    "module_overview": "管理部署环境的配置，包括服务器地址、端口、认证方式等。提供环境的创建、编辑、删除、连通性测试等核心功能。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "Environment",
            "states": [
              "active",
              "inactive",
              "error"
            ],
            "transitions": [
              {
                "from": "inactive",
                "to": "active",
                "trigger": "用户手动启用/创建环境",
                "actor": "用户"
              },
              {
                "from": "active",
                "to": "inactive",
                "trigger": "用户手动停用环境",
                "actor": "用户"
              },
              {
                "from": "active",
                "to": "error",
                "trigger": "连通性测试连续失败",
                "actor": "系统"
              },
              {
                "from": "error",
                "to": "active",
                "trigger": "连通性测试成功或用户手动恢复",
                "actor": "用户或系统"
              },
              {
                "from": "inactive",
                "to": "error",
                "trigger": "连通性测试失败（允许从未激活状态测试）",
                "actor": "系统"
              },
              {
                "from": "error",
                "to": "inactive",
                "trigger": "用户手动停用异常环境",
                "actor": "用户"
              }
            ],
            "irreversible_rules": [
              "无不可逆转换：所有状态转换均可逆向操作"
            ],
            "concurrency": "使用乐观锁（updated_at字段）防止并发状态覆盖。更新状态时 WHERE updated_at = :old_updated_at，更新行数为0时说明并发冲突，抛出OptimisticLockError，由调用方决定是否重试"
          }
        ]
      },
      "error_handling": {},
      "extra_sections": {}
    },
