    "module_overview": "安全存储和管理 SSH 密钥，提供密钥的上传、绑定和验证功能。所有 SSH 私钥在落库前使用 AES-256-GCM 算法加密，仅在部署时由部署引擎通过内部接口获取解密后的密钥会话。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [
        {
          "name": "绑定密钥",
          "method": "POST",
          "endpoint": "/api/v1/environments/:eid/keys",
          "description": "上传 SSH 私钥，解析公钥指纹，AES-256 加密后存储并与指定环境绑定。如果私钥有 passphrase，使用 salt 衍生密钥后再尝试解析。",
          "parameters": [
            {
              "name": "eid",
              "type": "integer",
              "description": "环境 ID，路径参数"
            },
            {
              "name": "key_name",
              "type": "string",
              "description": "密钥名称，同一环境内唯一，长度 1-255 字符"
            },
            {
              "name": "private_key",
              "type": "string",
              "description": "SSH 私钥内容（PEM 格式，以 -----BEGIN ... PRIVATE KEY----- 开头）"
            },
            {
              "name": "passphrase",
              "type": "string",
              "description": "私钥的 passphrase（可选，如私钥没有密码则留空）"
            }
          ],
          "response": {
            "status": 200,
            "body": {
              "key_id": "integer",
              "environment_id": "integer",
              "fingerprint": "string",
              "bound_at": "datetime"
            }
          },
          "error_codes": [
            {
              "code": 400,
              "message": "SSH 私钥格式无效，无法解析"
            },
            {
              "code": 400,
              "message": "passphrase 错误，无法解密私钥"
            },
            {
              "code": 404,
              "message": "指定的环境 (eid) 不存在"
            },
            {
              "code": 409,
              "message": "同一环境下已存在同名密钥"
            },
            {
              "code": 422,
              "message": "请求体参数校验失败（如 key_name 为空、private_key 为空）"
            },
            {
              "code": 500,
              "message": "加密过程中发生内部错误"
            }
          ]
        }
      ],
