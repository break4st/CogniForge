        {
          "name": "ProjectService",
          "description": "提供项目实体创建、查询、更新、删除的业务逻辑",
          "methods": [
            {
              "name": "createProject",
              "signature": "(request: CreateProjectRequest, userId: str) -> ProjectResponse",
              "precondition": "userId不为空，项目名称在用户下唯一",
              "postcondition": "项目已持久化，返回项目信息",
              "description": "创建新项目，关联当前用户",
              "exceptions": [
                {
                  "name": "DuplicateProjectException",
                  "trigger": "同一用户下已存在同名项目",
                  "http_status": 409
                }
              ]
            },
            {
              "name": "getProject",
              "signature": "(projectId: str, userId: str) -> ProjectResponse",
              "precondition": "项目属于该用户",
              "postcondition": "返回项目信息",
              "description": "根据ID查询单个项目",
              "exceptions": [
                {
                  "name": "ProjectNotFoundException",
                  "trigger": "项目不存在或不属于该用户",
                  "http_status": 404
                }
              ]
            },
            {
              "name": "listProjects",
              "signature": "(userId: str) -> List[ProjectResponse]",
              "precondition": "userId有效",
              "postcondition": "返回用户所有项目列表",
              "description": "列出用户的所有项目",
              "exceptions": []
            },
            {
              "name": "updateProject",
              "signature": "(projectId: str, request: UpdateProjectRequest, userId: str) -> ProjectResponse",
              "precondition": "项目存在且属于用户",
              "postcondition": "项目信息已更新",
              "description": "更新项目名称或描述",
              "exceptions": [
                {
                  "name": "ProjectNotFoundException",
                  "trigger": "项目不存在或不属于该用户",
                  "http_status": 404
                },
                {
                  "name": "DuplicateProjectException",
                  "trigger": "更新后的名称与用户其他项目重名",
                  "http_status": 409
                }
              ]
            },
            {
              "name": "deleteProject",
              "signature": "(projectId: str, userId: str) -> None",
              "precondition": "项目存在且属于用户，且无活跃部署",
              "postcondition": "项目已删除",
              "description": "删除指定项目",
              "exceptions": [
                {
                  "name": "ProjectNotFoundException",
                  "trigger": "项目不存在或不属于该用户",
                  "http_status": 404
                },
                {
                  "name": "ProjectHasActiveDeploymentsException",
                  "trigger": "项目下存在活跃部署",
                  "http_status": 409
                }
              ]
            },
            {
