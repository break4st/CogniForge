            ],
            "transitions": [
              {
                "from": "active",
                "to": "revoked",
                "trigger": "管理员执行吊销操作",
                "actor": "管理员"
              },
              {
                "from": "active",
                "to": "expired",
                "trigger": "系统检测到密钥已超过有效期",
