              },
              {
                "from": "revoked",
                "to": "expired",
                "trigger": "系统检测到吊销密钥已超过有效期",
                "actor": "系统定时任务"
              }
            ],
            "irreversible_rules": [
              "一旦密钥状态变为revoked或expired，不可再回退到active",
              "密钥一旦删除，从数据库物理删除后不可恢复"
            ],
