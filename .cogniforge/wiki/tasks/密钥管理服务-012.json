      "business_rules": {
        "state_machines": [
          {
            "entity": "SshKey",
            "states": [
              "active",
              "deleted"
            ],
            "transitions": [
              {
                "from": "nonexistent",
                "to": "active",
                "trigger": "BindKey 成功执行",
                "actor": "用户（Web 控制台）"
              },
              {
                "from": "active",
                "to": "deleted",
                "trigger": "DeleteKey 成功执行",
                "actor": "用户（Web 控制台）"
              }
            ],
            "irreversible_rules": [
              "active -> deleted 转换不可逆：密钥一旦删除无法恢复，部署引擎将无法使用该密钥建立连接。如需重新使用必须上传新密钥。"
            ],
            "concurrency": "同一环境下并发绑定同名密钥时，由数据库唯一索引 (environment_id, key_name) 保证只插入成功一条，其余请求返回 409 Conflict。并发删除操作基于 PostgreSQL 行级锁保护，同一时刻只有一个删除请求能成功。"
          }
        ]
      },
