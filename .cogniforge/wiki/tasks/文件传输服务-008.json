  "context": {
    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/文件传输服务/lld-文件传输服务-001.json",
    "module_overview": "负责将待部署的可执行文件通过SCP安全传输到远程服务器的指定部署目录，提供文件上传接收、完整性校验及远程传输能力。接收部署引擎服务下发的传输请求（含目标服务器连接参数和SSH密钥标识），内部通过Paramiko建立SCP连接完成文件推送，并返回传输结果",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "TransferRecord",
            "states": [
              "pending",
              "connecting",
              "transferring",
              "success",
              "failed"
            ],
            "transitions": [
              {
                "from": "pending",
                "to": "connecting",
                "trigger": "resolveSshKey",
                "actor": "FileTransferService"
              },
              {
                "from": "connecting",
                "to": "transferring",
                "trigger": "scpConnected",
                "actor": "FileTransferService"
              },
              {
                "from": "connecting",
                "to": "failed",
                "trigger": "connectionFailed",
                "actor": "FileTransferService"
              },
              {
                "from": "transferring",
                "to": "success",
                "trigger": "transferCompleted",
                "actor": "FileTransferService"
              },
              {
                "from": "transferring",
                "to": "failed",
                "trigger": "transferFailed",
                "actor": "FileTransferService"
              },
              {
                "from": "transferring",
                "to": "transferring",
                "trigger": "retryAttempt",
                "actor": "FileTransferService"
              },
              {
                "from": "failed",
                "to": "connecting",
                "trigger": "retryAttempt（retryCount < maxRetries）",
                "actor": "FileTransferService"
              }
            ],
            "irreversible_rules": [
              "success 状态为终态，不可转换到其他任何状态",
              "failed 状态仅可转换到 connecting（重试），不可转换到 transferring 或 success",
              "pending 状态的传输请求若在10秒内未进入 connecting 状态，自动超时转为 failed"
            ],
            "concurrency": "单次TransferRecord实例的并发传输互斥；多个TransferRecord实例之间通过 max_concurrent_transfers 信号量控制并发上限，超限时请求排队等待"
          }
        ]
      },
      "error_handling": {},
      "extra_sections": {}
    },
    "external_contracts": [],
    "cross_module_deps": [],
    "tech_stack": [
      "Python",
      "FastAPI",
      "Paramiko",
      "REST + SSH/SCP"
    ],
    "upstream_artifacts": []
  },
  "expected_output_files": [
    "src/文件传输服务/service/state_machine.go"
  ],
  "layer": 1
}