        "component_tree": [
          {
            "name": "ScriptExecutePage",
            "path": "/scripts/:id/execute",
            "description": "选择目标主机并执行脚本，实时查看输出",
            "props": [],
            "events": [],
            "state": [
              {
                "name": "template",
                "type": "ScriptTemplate | null",
                "description": "当前模板信息"
              },
              {
                "name": "hosts",
                "type": "HostInfo[]",
                "description": "可用主机列表"
              },
              {
                "name": "selectedHostId",
                "type": "string | null",
                "description": "选中的主机 ID"
              },
              {
                "name": "session",
                "type": "ExecutionSession | null",
                "description": "执行会话"
              },
              {
                "name": "output",
                "type": "string",
                "description": "累积的输出文本"
              },
              {
                "name": "executing",
                "type": "boolean",
                "description": "是否正在执行"
              }
            ],
            "behavior": [
              "挂载时获取模板详情 GET /api/script-templates/:id",
              "获取主机列表 GET /api/hosts",
              "用户选择主机后点击执行按钮，调用 POST /api/execute-script",
              "获取 sessionId 后建立 WebSocket 连接 ws://<gateway>/ws/script-output/{sessionId}",
              "接收 onmessage 事件追加输出文本",
              "提供「中止执行」按钮，调用 POST /api/abort-execution"
            ],
            "edge_cases": [
              "模板不存在（404）时提示并禁用执行",
              "主机列表加载失败时提示用户检查环境模块",
              "WebSocket 连接失败时重试 3 次，均失败则提示用户手动刷新",
              "用户离开页面时弹出确认框「执行仍在进行，离开将断开连接」",
              "输出过大时采用虚拟滚动渲染"
            ],
            "children": [
              {
                "name": "HostSelector",
                "path": "执行页内部组件",
                "description": "主机选择器，下拉或表格单选",
                "props": [
                  {
                    "name": "hosts",
                    "type": "HostInfo[]",
                    "required": true,
                    "description": "主机列表"
                  },
                  {
                    "name": "selectedHostId",
                    "type": "string | null",
                    "required": false,
                    "description": "当前选中主机 ID"
                  },
                  {
                    "name": "onSelect",
                    "type": "(hostId: string) => void",
                    "required": true,
                    "description": "选择回调"
                  }
                ],
                "events": [
                  {
                    "name": "onSelect",
                    "payload_type": "string (hostId)"
                  }
                ],
                "state": [],
                "behavior": [
                  "渲染 Ant Design Select 或 Radio.Group 展示主机名称和地址"
                ],
                "edge_cases": [
                  "主机列表为空时提示「无可用主机」",
                  "加载失败时在组件内显示错误信息"
                ]
              },
              {
                "name": "OutputPanel",
                "path": "执行页内部组件",
                "description": "实时显示脚本输出，支持中止操作",
                "props": [
                  {
                    "name": "output",
                    "type": "string",
                    "required": true,
                    "description": "输出文本"
                  },
                  {
                    "name": "status",
                    "type": "string",
                    "required": true,
                    "description": "执行状态"
                  },
                  {
                    "name": "onAbort",
                    "type": "() => void",
                    "required": true,
                    "description": "中止回调"
                  }
                ],
                "events": [
                  {
                    "name": "onAbort",
                    "payload_type": "void"
                  }
                ],
                "state": [
                  {
                    "name": "containerRef",
                    "type": "React.RefObject<HTMLDivElement>",
                    "description": "输出容器引用，用于自动滚动到底部"
                  }
                ],
                "behavior": [
                  "接收 output 变化后更新显示，并自动滚动到底部",
                  "根据 status 显示不同状态标签",
                  "点击「中止执行」调用 onAbort"
                ],
                "edge_cases": [
                  "输出包含 ANSI 颜色码时进行简单解析并着色",
                  "输出行数过多时启用虚拟滚动"
                ]
              }
            ]
          }
        ]
      }
    },
