    "module_overview": "管理到远程服务器的 SSH 连接，提供连接复用和生命周期管理。维护连接池内的连接状态，支持连接的健康检测、自动重连、空闲超时回收和并发数控制，供环境管理服务和部署引擎服务内部调用。",
    "scope": {
      "data_models": [],
      "domain_objects": [
        {
          "name": "SSHConnection",
          "object_type": "entity",
          "description": "表示一条到远程服务器的 SSH 连接，封装底层 ssh.Client 和连接元数据。是连接池的核心管理单元。",
          "attributes": [
            {
              "name": "Id",
              "type": "string",
              "required": true,
              "source": "computed",
              "description": "连接唯一标识，UUID v4 格式，创建时生成"
            },
            {
              "name": "Host",
              "type": "string",
              "required": true,
              "source": "input",
              "description": "远程主机地址（IP 或域名）"
            },
            {
              "name": "Port",
              "type": "int",
              "required": true,
              "source": "input",
              "description": "SSH 端口号"
            },
            {
              "name": "KeyId",
              "type": "int64",
              "required": true,
              "source": "input",
              "description": "加密密钥 ID，用于从密钥管理服务获取解密密钥"
            },
            {
              "name": "Status",
              "type": "ConnectionStatus",
              "required": true,
              "source": "computed",
              "description": "连接当前状态：IDLE / ACTIVE / RECONNECTING / CLOSED / ERROR"
            },
            {
              "name": "Client",
              "type": "*ssh.Client",
              "required": true,
              "source": "computed",
              "description": "底层 golang.org/x/crypto/ssh 客户端实例（仅内存中，不序列化）"
            },
            {
              "name": "CreatedAt",
              "type": "time.Time",
              "required": true,
              "source": "computed",
              "description": "连接创建时间"
            },
            {
              "name": "LastUsedAt",
              "type": "time.Time",
              "required": true,
              "source": "computed",
              "description": "最近一次出借时间，用于判断空闲超时"
            },
            {
              "name": "ExpiresAt",
              "type": "time.Time",
              "required": true,
              "source": "computed",
              "description": "连接过期时间 = CreatedAt + idleTimeout，超时后自动关闭"
            },
            {
              "name": "UseCount",
              "type": "int64",
              "required": true,
              "source": "computed",
              "description": "累计被 GetConnection 出借的次数，用于统计复用率"
            }
          ]
        }
