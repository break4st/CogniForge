      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "SshKey",
            "states": [
              "active",
              "deleted"
            ],
            "transitions": [
              {
                "from": "active",
                "to": "deleted",
                "trigger": "用户通过密钥管理页面执行删除操作，或管理员强制吊销",
                "actor": "用户或管理员"
              }
            ],
            "irreversible_rules": [
              "SSH密钥删除为软删除（标记deleted_at），不支持恢复操作。如用户误删需重新上传密钥对",
              "密钥状态从 active 变为 deleted 后，关联的加密密钥存储记录标记为 revoked，不可逆"
            ],
            "concurrency": "删除操作使用乐观锁（检查updated_at版本），防止并发重复删除。单次删除操作同时更新ssh_keys表和加密密钥存储模块，两个操作在各自的事务中独立执行"
          }
        ]
      },
