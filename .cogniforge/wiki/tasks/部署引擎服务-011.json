    "lld_path": ".cogniforge/wiki/lld/部署引擎服务/lld-部署引擎服务-001.json",
    "module_overview": "核心部署执行单元，负责在远程服务器上创建目录、传输文件、生成脚本和执行部署",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "DeployTask",
            "states": [
              "pending",
              "running",
              "success",
              "failed",
              "rollbacking",
              "rolled_back",
              "cancelled"
            ],
            "transitions": [
              {
                "from": "pending",
                "to": "running",
                "trigger": "DeployExecutor 获取待处理任务并开始执行",
                "actor": "DeployExecutor"
              },
              {
                "from": "pending",
                "to": "cancelled",
                "trigger": "用户在调度执行前手动取消",
                "actor": "用户"
              },
              {
                "from": "running",
                "to": "success",
                "trigger": "所有部署步骤执行成功，服务启动正常",
                "actor": "DeployExecutor"
              },
              {
                "from": "running",
                "to": "failed",
                "trigger": "部署步骤执行失败且无需回滚，或回滚条件不满足（如首次部署无上一版本）",
                "actor": "DeployExecutor"
              },
              {
                "from": "running",
                "to": "rollbacking",
                "trigger": "部署步骤执行失败，系统决定触发自动回滚流程",
                "actor": "DeployExecutor"
              },
              {
                "from": "running",
                "to": "cancelled",
                "trigger": "用户手动取消正在执行的部署任务",
                "actor": "用户"
              },
              {
                "from": "rollbacking",
                "to": "rolled_back",
                "trigger": "回滚操作成功完成，远程服务恢复到上一版本",
                "actor": "DeployExecutor"
              },
              {
                "from": "rollbacking",
                "to": "rollback_failed",
                "trigger": "回滚操作在执行过程中也失败",
                "actor": "DeployExecutor"
              }
            ],
            "irreversible_rules": [
              "success 状态不可转换到其他任何状态——已成功的部署视为最终态",
              "rolled_back 状态不可逆——回滚完成后不可再次恢复已失败的新版本",
              "rollback_failed 状态不可逆——回滚失败需要人工介入处理",
              "cancelled 状态不可恢复——取消后的任务不可重新激活"
            ],
            "concurrency": "创建部署任务时使用 SELECT ... FOR UPDATE 锁定目标 project_id + environment_id 的活跃任务行；状态更新使用乐观锁（version 字段或 updated_at 比较）防止并发覆盖；DeployExecutor 通过分布式锁（Redis）确保同一时刻每个活跃任务只有一个执行协程"
          }
        ]
      },
      "error_handling": {},
      "extra_sections": {}
    },
