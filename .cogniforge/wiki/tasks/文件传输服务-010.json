      "domain_objects": [],
      "interfaces": [
        {
          "name": "文件传输 API（内部）",
          "method": "POST",
          "endpoint": "/api/transfer/upload",
          "description": "内部接口，将文件通过SCP传输到远程服务器。由部署引擎服务调用，传输连接参数（host、port、login_user、key_id）由调用方从对应环境的配置中获取后传入",
          "parameters": [
            {
              "name": "host",
              "type": "string",
              "description": "远程服务器IP地址或主机名"
            },
            {
              "name": "port",
              "type": "int",
              "description": "SSH端口号，范围1-65535"
            },
            {
              "name": "login_user",
              "type": "string",
              "description": "SSH登录用户名"
            },
            {
              "name": "key_id",
              "type": "uuid",
              "description": "SSH密钥ID，用于从密钥管理服务获取解密后的私钥进行SCP认证"
            },
            {
              "name": "local_path",
              "type": "string",
              "description": "本地待传输文件的绝对路径（文件传输服务所在节点的文件系统路径）"
            },
            {
              "name": "remote_path",
              "type": "string",
              "description": "远程服务器目标绝对路径，包含目标文件名"
            }
          ],
          "response": {
            "status": 200,
            "body": {
              "success": "bool",
              "transferred_bytes": "int",
              "elapsed_ms": "int"
            }
          },
          "error_codes": [
            {
              "code": 400,
              "message": "请求参数校验失败，如port超出范围、路径格式不合法、key_id非UUID格式"
            },
            {
              "code": 401,
              "message": "SSH密钥认证失败，密钥无效或与目标服务器不匹配"
            },
            {
              "code": 404,
              "message": "本地文件不存在或无法读取"
            },
            {
              "code": 408,
              "message": "SCP传输超时，连接建立或数据传输超过scp_timeout_seconds配置"
            },
            {
