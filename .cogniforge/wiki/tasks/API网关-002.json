        "route_table": [
          {
            "path_pattern": "/api/v1/health",
            "upstream": "API网关（自处理）",
            "description": "健康检查，网关自行处理，不转发到上游"
          },
          {
            "path_pattern": "/api/v1/auth/login",
            "upstream": "API网关（自处理）",
            "description": "用户登录，网关自行完成密码校验和 Token 签发"
          },
          {
            "path_pattern": "/api/v1/auth/refresh",
            "upstream": "API网关（自处理）",
            "description": "Token 刷新，网关自行校验 refresh_token 并签发新 token"
          },
          {
            "path_pattern": "/api/v1/auth/logout",
            "upstream": "API网关（自处理）",
            "description": "用户登出，网关自行将 Token 加入黑名单"
          },
          {
            "path_pattern": "/api/v1/auth/me",
