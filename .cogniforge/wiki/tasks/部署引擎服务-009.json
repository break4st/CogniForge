    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/部署引擎服务/lld-部署引擎服务-001.json",
    "module_overview": "核心部署编排服务，负责完整的部署流程调度、版本管理、脚本生成和进度推送。接收Web控制台的部署请求，协调密钥管理服务、SSH连接池服务、文件传输服务完成远程部署，通过WebSocket实时推送执行日志。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "Deployment",
            "states": [
              "pending",
              "running",
              "success",
              "failed"
            ],
            "transitions": [
              {
                "from": "pending",
                "to": "running",
                "trigger": "异步任务开始执行远程部署（executeDeployment）",
                "actor": "system"
              },
              {
                "from": "running",
                "to": "success",
                "trigger": "远程脚本执行完成且 exit_code=0",
                "actor": "system"
              },
              {
                "from": "running",
                "to": "failed",
                "trigger": "远程脚本执行完成但 exit_code≠0",
                "actor": "system"
              },
              {
                "from": "pending",
                "to": "failed",
                "trigger": "前置步骤失败（密钥解密/SSH连接/文件传输/目录创建）",
                "actor": "system"
              }
            ],
            "irreversible_rules": [
              "success 和 failed 为终态，不可转换到任何其他状态",
              "已成功的部署不可重新执行，如需重新部署必须创建新的部署记录"
            ],
            "concurrency": "状态更新使用数据库行级锁（SELECT FOR UPDATE）防止并发更新。RabbitMQ 消费端保证同一部署消息的串行处理（按 deploymentId hash 到固定队列分区）。Redis 部署进度缓存在部署完成/失败后设置 TTL=3600 自动清理"
          }
        ]
      },
      "error_handling": {},
      "extra_sections": {}
    },
