  "context": {
    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/DeploymentService/lld-DeploymentService-001.json",
    "module_overview": "DeploymentService 是部署流程的编排中枢，负责串联磁盘检查、文件上传、解压、版本目录创建、软链接切换、脚本生成及失败回滚等全链路操作。它作为后端服务，对前端 DeployUI 暴露 REST 接口，对内依赖 SSHService 执行远程命令、依赖 FileManager 管理本地临时文件、依赖 VersionService 维护版本记录。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [
        {
          "id": "SC-001",
          "name": "DeploymentService",
          "description": "DeploymentService 对外提供的契约，定义可调用的方法。",
          "methods": [
            {
              "name": "start_deployment",
              "description": "启动一个新的部署流程。",
              "parameters": [
                {
                  "name": "request",
                  "type": "DeployRequest",
                  "description": "部署请求数据"
                }
              ],
              "returns": {
                "type": "DeployResult",
                "description": "部署结果"
              },
              "exceptions": [
                {
                  "type": "ValueError",
                  "description": "参数无效"
                },
                {
                  "type": "DeployConflict",
                  "description": "已有进行中部署"
                },
                {
                  "type": "PreconditionFailed",
                  "description": "前置条件不满足"
                }
              ],
              "is_async": true
            },
            {
              "name": "get_deploy_status",
              "description": "查询指定部署任务的状态。",
              "parameters": [
                {
                  "name": "deploy_id",
                  "type": "Integer",
                  "description": "部署任务 ID"
                }
              ],
              "returns": {
                "type": "DeployResult",
                "description": "当前部署状态"
              },
              "exceptions": [
                {
                  "type": "NotFound",
                  "description": "部署任务不存在"
                }
              ],
              "is_async": false
            },
            {
              "name": "upload_file",
              "description": "上传构建产物到临时目录。",
              "parameters": [
                {
                  "name": "deploy_id",
                  "type": "Integer",
                  "description": "部署任务 ID"
                },
                {
                  "name": "file",
                  "type": "File",
                  "description": "上传文件对象"
                }
              ],
              "returns": {
                "type": "bool",
                "description": "上传是否成功"
              },
              "exceptions": [
                {
                  "type": "NotFound",
                  "description": "部署任务不存在"
                },
                {
                  "type": "IOError",
                  "description": "文件操作失败"
                }
              ],
              "is_async": true
            }
          ],
