  "context": {
    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/SSH连接池/lld-SSH连接池-001.json",
    "module_overview": "管理到远程服务器的 SSH 连接，提供连接复用和生命周期管理。维护连接池内的连接状态，支持连接的健康检测、自动重连、空闲超时回收和并发数控制，供环境管理服务和部署引擎服务内部调用。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "SSHConnection",
            "states": [
              "IDLE",
              "ACTIVE",
              "RECONNECTING",
              "CLOSED",
              "ERROR"
            ],
            "transitions": [
              {
                "from": "nonexistent",
                "to": "IDLE",
                "trigger": "新建连接创建完成并加入空闲队列",
                "actor": "连接池"
              },
              {
                "from": "IDLE",
                "to": "ACTIVE",
                "trigger": "GetConnection 从空闲队列取出",
                "actor": "调用方"
              },
              {
                "from": "ACTIVE",
                "to": "IDLE",
                "trigger": "ReleaseConnection 归还到空闲队列",
                "actor": "调用方"
              },
              {
                "from": "ACTIVE",
                "to": "ERROR",
                "trigger": "SFTP 传输/命令执行中发生不可恢复错误",
                "actor": "连接池"
              },
              {
                "from": "IDLE",
                "to": "RECONNECTING",
                "trigger": "健康检查发现空闲连接响应异常",
                "actor": "健康检查"
              },
              {
                "from": "RECONNECTING",
                "to": "IDLE",
                "trigger": "自动重连成功：使用相同配置重新建立 SSH 连接",
                "actor": "连接池"
              },
              {
                "from": "RECONNECTING",
                "to": "CLOSED",
                "trigger": "自动重连失败：超过 MaxRetries 次数限制",
                "actor": "连接池"
              },
              {
                "from": "RECONNECTING",
                "to": "ERROR",
                "trigger": "重连过程中发生意外错误（如密钥服务不可用）",
                "actor": "连接池"
              },
              {
                "from": "ERROR",
                "to": "CLOSED",
                "trigger": "CloseConnection 或清理流程关闭异常连接",
                "actor": "连接池"
              },
              {
                "from": "IDLE",
                "to": "CLOSED",
                "trigger": "空闲超时（超过 idleTimeout）或调用 CloseConnection",
                "actor": "连接池"
              },
              {
                "from": "ACTIVE",
                "to": "CLOSED",
                "trigger": "调用方调用 CloseConnection 强制关闭",
                "actor": "调用方"
              },
              {
                "from": "ERROR",
                "to": "CLOSED",
                "trigger": "健康检查回收异常连接",
                "actor": "健康检查"
              }
            ],
            "irreversible_rules": [
              "连接一旦进入 CLOSED 状态不可再转换为任何其他状态，底层 ssh.Client 的 Close() 已调用，socket 已关闭",
              "连接进入 ERROR 状态后必须先转 CLOSED 再销毁，不可直接回到 IDLE 或 ACTIVE 状态复用"
            ],
            "concurrency": "全局连接池使用 sync.RWMutex 保护池元数据；每台主机的 HostConnectionPool 使用独立的 sync.Mutex，减少跨主机锁竞争；GetConnection 在创建新连接前使用双检锁模式——先尝试不加锁读取空闲队列，无可用连接时再获取锁二次检查，避免锁争用；ActiveCount 使用 atomic.Int64 计数器保证 GetConnection/ReleaseConnection 并发时计数的准确性"
          }
        ]
      },
      "error_handling": {},
      "extra_sections": {}
    },
