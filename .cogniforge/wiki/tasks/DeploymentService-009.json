  "context": {
    "module_type": "service",
    "lld_path": ".cogniforge/wiki/lld/DeploymentService/lld-DeploymentService-001.json",
    "module_overview": "DeploymentService 是部署流程的编排中枢，负责串联磁盘检查、文件上传、解压、版本目录创建、软链接切换、脚本生成及失败回滚等全链路操作。它作为后端服务，对前端 DeployUI 暴露 REST 接口，对内依赖 SSHService 执行远程命令、依赖 FileManager 管理本地临时文件、依赖 VersionService 维护版本记录。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [
        {
          "id": "IF-001",
          "name": "REST POST /deployments",
          "endpoint": "/deployments",
          "method": "POST",
          "summary": "启动部署流程",
          "description": "接收部署请求，校验前置条件后创建部署任务并返回 deploy_id。",
          "auth": {
            "type": "token",
            "scopes": [
              "deploy:write"
            ]
          },
          "request": {
            "body": {
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "environment_id": {
                        "type": "integer",
                        "description": "目标环境 ID"
                      },
                      "version": {
                        "type": "string",
                        "description": "部署版本号（可选，不提供则自动生成）"
                      },
                      "file_path": {
                        "type": "string",
                        "description": "构建产物本地路径（可选，不提供则后续上传）"
                      }
                    },
                    "required": [
                      "environment_id"
                    ]
                  }
                }
              }
            }
          },
          "responses": {
            "202": {
              "description": "部署任务已创建",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "deploy_id": {
                        "type": "integer",
                        "description": "部署任务 ID"
                      },
                      "status": {
                        "type": "string",
                        "description": "初始状态，如 'queued'"
                      },
                      "message": {
                        "type": "string",
                        "description": "提示信息"
                      }
                    },
                    "required": [
                      "deploy_id",
                      "status"
                    ]
                  }
                }
              }
            },
            "400": {
              "description": "请求参数错误"
            },
            "409": {
              "description": "环境已有进行中部署"
            },
            "422": {
              "description": "前置条件不满足（环境离线或磁盘不足）"
            }
          }
        }
      ],
      "service_contracts": [],
