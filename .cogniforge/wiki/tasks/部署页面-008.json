            "state_machines": [
              {
                "name": "deployFlow",
                "states": [
                  "idle",
                  "deploying",
                  "success",
                  "error"
                ],
                "transitions": [
                  {
                    "from": "idle",
                    "to": "deploying",
                    "trigger": "onDeploy"
                  },
                  {
                    "from": "deploying",
                    "to": "success",
                    "trigger": "deploySuccess"
                  },
                  {
                    "from": "deploying",
                    "to": "error",
                    "trigger": "deployError"
                  },
                  {
                    "from": "error",
                    "to": "idle",
                    "trigger": "reset"
                  },
                  {
                    "from": "success",
                    "to": "idle",
                    "trigger": "reset"
                  }
                ]
              }
            ],
            "derived_state": [
              {
                "name": "isFormValid",
                "derivation": "deployFormState.projectId && deployFormState.environmentId && deployFormState.filePath && deployFormState.version",
                "type": "boolean"
              },
              {
                "name": "isDeploying",
                "derivation": "deployFormState.deployStatus === 'deploying'",
                "type": "boolean"
              }
            ]
          }
        ]
