                  "AppHeader",
                  "ProjectSwitcher",
                  "AppSidebar",
                  "ProjectListPage",
                  "ProjectDashboardPage",
                  "EnvironmentListPage",
                  "DeployFormPage"
                ]
              }
            ],
            "page": [
              {
                "name": "environmentStore",
                "type": "EnvironmentStore",
                "description": "当前项目下的环境列表和连接测试结果（页面级，切换项目时刷新）",
                "consumers": [
                  "ProjectDashboardPage",
                  "EnvironmentListPage",
                  "KeyBindingPage"
                ]
              },
              {
                "name": "deployStore",
                "type": "DeployStore",
                "description": "当前部署任务状态和日志（页面级，离开页面时停止轮询）",
                "consumers": [
                  "DeployFormPage",
                  "DeployProgressPage"
                ]
              }
            ],
            "caching_strategy": "ProjectStore 项目列表在应用生命周期内缓存，切换项目时不清空。EnvironmentStore 按 projectId 缓存，切换项目时重新加载。DeployStore 不缓存，每次进入部署进度页重新轮询。localStorage 持久化 authStore.token，页面刷新后自动恢复登录状态。"
