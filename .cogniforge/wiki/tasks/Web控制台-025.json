          {
            "global": [
              {
                "name": "authStore",
                "type": "AuthStore",
                "description": "用户认证状态，包括 Token、用户信息和登录状态",
                "consumers": [
                  "App",
                  "AppHeader",
                  "UserMenu"
                ]
              },
              {
                "name": "projectStore",
                "type": "ProjectStore",
