    "module_overview": "项目核心管理服务，处理项目的创建、编辑、删除以及项目与环境绑定关系。提供项目CRUD操作、项目与环境绑定关系管理、项目列表与概要信息查询、项目上下文切换与状态维护、项目删除时级联清理关联数据等能力。",
    "scope": {
      "data_models": [],
      "domain_objects": [],
      "interfaces": [],
      "service_contracts": [],
      "business_rules": {
        "state_machines": [
          {
            "entity": "Project",
            "states": [
              "active",
              "deleted"
            ],
            "transitions": [
              {
                "from": "active",
                "to": "deleted",
                "trigger": "delete_project() 被调用，且项目无进行中部署任务",
                "actor": "项目经理（通过API）"
              }
            ],
            "irreversible_rules": [
              "active → deleted 转换不可逆，API不提供恢复已删除项目的接口。如需恢复，需由数据库管理员直接操作修改 deleted_at 字段"
            ],
            "concurrency": "项目删除操作与同项目的部署操作可能并发，删除前必须检查并确保无 pending/running 状态的部署记录，通过事务包裹检查+删除操作保证原子性"
          }
        ]
      },
