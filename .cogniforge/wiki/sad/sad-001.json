      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "WebSocket /ws/deployments/:id/logs",
      "request": {
        "path_params": [
          {"name": "id", "type": "string", "description": "部署任务ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {}
      },
      "description": "WebSocket连接，实时推送部署执行日志"
    },
    {
      "interface": "SSH Key CRUD API",
      "provider": "Key Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "多种",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {}
      },
      "description": "SSH密钥的增删改查接口集。POST /api/keys（导入/生成）、DELETE /api/keys/:id、GET /api/keys（列表）"
    },
