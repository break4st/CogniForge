  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "运维人员在Web控制台选择目标项目和部署环境",
        "上传或选择已打包好的可执行文件",
        "系统生成部署版本号并创建部署任务",
        "部署执行服务从密钥管理服务获取该环境的SSH密钥",
        "部署执行服务通过SSH连接池建立到远程服务器的连接",
        "在远程服务器创建版本目录（如 /deploy/{project}/{env}/{version}/）",
        "文件传输模块通过SCP将可执行文件和配置上传到版本目录",
        "脚本生成引擎在远程服务器生成启动和停止脚本",
        "执行启动脚本，应用开始运行",
        "收集启动状态（成功/失败）并记录审计日志",
        "前端轮询部署状态并展示最终结果"
      ]
    },
    {
      "name": "项目管理流程",
      "steps": [
        "项目经理在Web控制台创建新项目",
        "填写项目名称、描述等基本信息",
        "为项目创建或关联部署环境（测试、灰度、正式线）",
        "每个环境配置连接参数和SSH密钥",
        "保存后项目和环境数据写入数据库",
        "后续可在项目列表中选择查看不同项目的部署配置"
      ]
    },
    {
      "name": "SSH密钥管理流程",
      "steps": [
        "运维人员添加SSH密钥，填写密钥名称和密钥内容",
        "密钥管理服务对密钥内容进行加密后存入数据库",
        "加密后的密钥密文存储在数据库中",
        "部署执行时，密钥管理服务解密并临时提供给SSH连接池",
        "部署完成后清除内存中的密钥明文",
        "运维人员可随时更新或删除密钥"
      ]
    }
  ]
