    },
    {
      "interface": "Transfer File via SCP (Internal)",
      "provider": "SSH Execution Service",
      "consumers": ["Deployment Orchestrator"],
      "type": "REST",
      "endpoint": "POST /api/internal/ssh/transfer",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "integer",
          "username": "string",
          "private_key": "string",
          "source_path": "string",
          "target_path": "string",
          "direction": "upload | download"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "bytes_transferred": "integer",
          "target_path": "string"
        }
      },
      "description": "内部接口，通过SCP/SFTP在本地与远程服务器之间传输文件"
    },
    {
      "interface": "Audit Log API",
      "provider": "Audit Service",
      "consumers": ["API Gateway", "Deployment Orchestrator", "Key Management Service", "Project Management Service", "Environment Management Service"],
      "type": "REST",
      "endpoint": "POST /api/audit/logs",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "action": "string",
          "actor": "string",
          "resource_type": "string",
          "resource_id": "string",
          "detail": "object",
          "result": "success | failure"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "log_id": "string",
          "created_at": "datetime"
        }
      },
      "description": "记录用户操作审计日志，全系统服务通过此接口统一写入审计记录"
    },
    {
      "interface": "Deployment History API",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/projects/:pid/deployments",
      "request": {
        "path_params": [
          {"name": "pid", "type": "string", "description": "项目ID"}
        ],
        "query_params": [
          {"name": "page", "type": "integer"},
          {"name": "page_size", "type": "integer"},
          {"name": "status", "type": "string", "description": "按状态过滤"}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "total": "integer",
          "items": [
            {
              "deployment_id": "string",
              "version": "string",
              "environment_name": "string",
              "status": "string",
              "started_at": "datetime",
              "completed_at": "datetime",
              "triggered_by": "string"
            }
          ]
        }
      },
      "description": "查询指定项目的部署历史记录，支持分页和状态过滤"
    }
  ],
  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户通过Web Console选择项目、目标环境和版本号，点击部署按钮",
        "Web Console发送POST /api/deployments请求到API Gateway",
        "API Gateway鉴权后将请求路由到Deployment Orchestrator",
        "Deployment Orchestrator创建部署任务记录，返回202 Accepted及task_id",
        "Web Console通过WebSocket /ws/deployments/:id/logs连接到实时日志频道",
        "Deployment Orchestrator向Key Management Service请求目标环境的SSH密钥（内部接口）",
        "Key Management Service解密后返回SSH密钥",
        "Deployment Orchestrator调用SSH Execution Service连接远程服务器",
        "SSH Execution Service在远程服务器上创建版本文件夹结构",
        "Deployment Orchestrator通过SSH Execution Service将可执行文件传输到远程服务器",
        "Deployment Orchestrator生成执行脚本并通过SSH Execution Service推送至远程服务器",
        "Deployment Orchestrator通过SSH Execution Service触发远程脚本执行",
        "SSH Execution Service实时回传执行日志",
        "Deployment Orchestrator将日志通过WebSocket频道推送至Web Console",
        "Web Console实时展示部署进度和日志",
        "部署完成，Deployment Orchestrator更新任务状态并写入审计日志到Audit Service"
      ]
    },
    {
      "name": "项目创建流程",
      "steps": [
        "用户在Web Console填写项目名称和描述，点击创建",
        "API Gateway接收POST /api/projects请求并路由到Project Management Service",
        "Project Management Service校验参数并创建项目记录",
        "项目创建成功后返回项目信息",
        "项目创建操作写入审计日志",
        "Web Console展示新创建的项目"
      ]
    },
    {
      "name": "环境配置流程",
      "steps": [
        "用户在项目详情页选择添加部署环境，填写环境名称、SSH连接参数",
        "API Gateway路由POST /api/projects/:pid/environments请求到Environment Management Service",
        "Environment Management Service校验参数并关联SSH密钥",
        "用户可选择对新建环境进行连接测试",
        "Environment Management Service调用SSH Execution Service执行连接验证",
        "环境配置持久化到Primary Database",
        "环境创建操作写入审计日志",
        "Web Console刷新显示新环境配置"
      ]
    },
    {
      "name": "SSH密钥管理流程",
      "steps": [
        "用户在Web Console选择导入已有密钥对或生成新密钥对",
        "API Gateway路由请求到Key Management Service",
        "Key Management Service对密钥内容进行加密存储",
        "密钥与项目/环境关联配置",
        "密钥创建操作写入审计日志"
      ]
    }
  ]
}
