  "system_overview": {
    "description": "多环境自动化部署管理平台，支持项目管理、多环境配置、SSH密钥安全存储、一键部署、部署历史与回滚、配置导入导出等功能。采用Web应用形态，可打包为桌面应用。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "创建/编辑/删除项目",
          "管理环境配置",
          "管理SSH密钥",
          "执行部署",
          "查看部署历史",
          "回滚部署",
          "导入导出配置"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目和环境的配置（密钥私钥不可见）",
          "在自己负责的项目下执行部署",
          "查看部署历史",
          "回滚自己部署过的版本"
        ]
      },
      {
        "name": "技术负责人",
        "permissions": [
          "查看所有项目和环境配置（只读）",
          "浏览全局部署记录",
          "查看审计信息"
        ]
      }
    ]
  },
  "architecture": {
    "style": "模块化单体架构（逻辑微服务）",
    "description": "采用前端 + BFF + 后端服务分层设计。后端按领域划分为多个服务模块（项目、环境、密钥、部署、历史、配置），通过 API 通信。可打包为单个可执行文件，提供Web访问界面。",
    "layers": [
      {
        "name": "前端层",
        "components": [
          "Web客户端"
        ]
      },
      {
        "name": "网关/BFF层",
        "components": [
          "API网关（可合并至后端）"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目服务",
          "环境服务",
          "密钥管理服务",
          "部署服务",
          "历史服务",
          "配置管理服务",
          "实时通信服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "数据库",
          "文件存储",
          "SSH客户端库",
          "加密库"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / WebSocket",
        "description": "前端通过 REST API 和 WebSocket 与网关/BFF 通信"
      },
      {
        "protocol": "HTTP (内部REST)",
        "description": "网关与业务服务层通信，或业务服务间互相调用（单体部署时为函数调用）"
      },
      {
        "protocol": "数据库驱动协议 (SQL)",
        "description": "业务服务与数据库交互"
      },
      {
        "protocol": "SSH (SFTP + Exec)",
        "description": "部署服务与远程服务器通信，用于文件上传和远程命令执行"
      },
      {
        "protocol": "本地文件I/O",
        "description": "密钥管理服务读写加密私钥，部署服务暂存上传文件"
      }
    ],
    "features": [
      "安全性：SSH私钥AES-256加密存储，解密后仅驻留内存",
      "实时反馈：WebSocket推送部署进度和远程输出",
      "可扩展性：按领域模块化设计，易于添加新功能",
      "数据一致性：部署操作记录采用事务保证一致性",
      "离线友好：前端可缓存静态资源，但部署操作需在线"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design",
      "language": "TypeScript"
    },
    "database": "PostgreSQL (生产) / SQLite (单机开发)",
    "orm": "SQLAlchemy 2.0",
    "migration": "Alembic",
    "ssh_library": "paramiko 或 asyncssh",
    "encryption": "Python cryptography 库 (AES-256-CBC)",
    "real_time": "WebSocket (FastAPI原生支持)",
    "packaging": "PyInstaller (可选，用于生成桌面应用)"
  },
