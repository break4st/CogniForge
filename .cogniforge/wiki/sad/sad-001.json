      "consumers": [
        "前端项目管理面板"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "search",
            "type": "string",
            "required": false,
            "description": "按名称搜索关键字"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "description": "项目列表 JSON 数组",
          "content": [
            {
              "id": "int",
              "name": "string",
              "description": "string",
              "created_at": "datetime"
            }
          ]
        }
      },
      "errors": [
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "服务器内部错误"
