  "system_overview": {
    "description": "本系统采用前后端分离的微服务架构，支持多项目自动化部署。前端为单页应用，通过API网关访问后端微服务。后端按业务边界拆分为项目、环境、SSH密钥、部署、历史等服务，部署任务通过消息队列异步执行，确保高可用和可扩展性。",
    "roles": [
      {
        "name": "项目经理",
        "permissions": [
          "创建项目",
          "编辑项目",
          "删除项目",
          "查看项目列表",
          "切换项目"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "管理环境配置",
          "上传SSH密钥",
          "测试连接",
          "查看部署历史"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "选择项目和环境",
          "上传文件并部署",
          "查看部署进度",
          "查看部署历史"
        ]
      },
      {
        "name": "系统管理员",
        "permissions": [
          "所有权限",
          "管理脚本模板",
          "导出日志",
          "查看所有数据"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构",
    "description": "系统分为接入层、网关层、服务层、数据层。服务层包含多个独立微服务，通过RESTful API和消息队列进行通信。部署任务采用异步处理，提升响应速度和可靠性。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "web-frontend"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "api-gateway"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "project-service",
          "environment-service",
          "ssh-key-service",
          "deployment-service",
          "deployment-executor",
          "history-service"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "postgresql",
          "message-queue"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST",
        "description": "前端与API网关之间的交互"
      },
      {
        "protocol": "HTTPS / REST",
        "description": "API网关与服务层之间的同步调用"
      },
      {
        "protocol": "AMQP",
        "description": "deployment-service 与 deployment-executor 通过 RabbitMQ 进行异步任务分发"
      },
      {
        "protocol": "SSH / SFTP",
        "description": "deployment-executor 与远程服务器进行文件上传和命令执行"
      },
      {
        "protocol": "TCP / SQL",
        "description": "各服务与 PostgreSQL 数据库的持久化访问"
      }
    ],
    "features": [
      "异步解耦部署流程，提升吞吐量",
      "SSH私钥AES-256加密存储，内存解密用完即销",
      "多项目数据物理隔离，通过project_id严格区分",
      "自动化版本文件夹创建及启动脚本生成",
      "全链路部署日志记录与一键重试",
      "服务独立部署，支持弹性扩容"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design"
    },
    "database": "PostgreSQL 15",
    "message_queue": "RabbitMQ",
    "async_task": "Celery",
    "ssh_library": "paramiko",
    "encryption_library": "cryptography",
    "containerization": "Docker",
    "orchestration": "Docker Compose / Kubernetes"
  },
