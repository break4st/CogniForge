{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-20 17:02"
  },
  "system_overview": {
    "description": "实现将打包好的可执行文件自动化部署到指定远程服务器的功能。支持用户自定义多套部署环境（如测试线、灰度线、正式线等），每套环境可通过密钥配置安全连接，部署时自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。用户可创建和管理多个项目，每个项目拥有独立的部署环境配置，支持在项目间灵活切换，满足多项目并行管理的需求。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "创建、编辑、删除部署项目",
          "配置和管理多套部署环境（测试线、灰度线、正式线）",
          "管理SSH密钥对并配置远程服务器连接",
          "上传可执行文件并触发一键部署",
          "查看部署日志和历史记录",
          "查看审计日志"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目列表和配置信息",
          "查看部署进度和实时日志",
          "查看部署历史记录",
          "查看项目部署状态"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层微服务架构",
    "description": "采用前后端分离的分层微服务架构。前端提供Web操作控制台，网关层负责请求路由和认证鉴权，业务层按领域拆分为项目管理、环境管理、部署编排、SSH执行、密钥管理和审计日志等微服务，数据层提供持久化存储与缓存加速。展示层与网关层通过HTTPS REST API通信，实时日志通过WebSocket推送；网关层与业务服务层通过内部REST API通信；业务服务层通过SQL/ORM访问数据库，通过Redis协议访问缓存，部署执行采用异步SSH连接池机制确保并发安全。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web Console"]
      },
      {
        "name": "网关层",
        "components": ["API Gateway"]
      },
      {
        "name": "业务服务层",
        "components": [
          "Project Management Service",
          "Environment Management Service",
          "Deployment Orchestrator",
          "SSH Execution Service",
          "Key Management Service",
          "Audit Service"
        ]
      },
      {
        "name": "数据层",
        "components": ["Primary Database", "Cache"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST API (JSON)， WebSocket (实时日志)"
      },
      {
        "protocol": "内部 REST API (JSON/HTTP)， AMQP (异步部署任务)"
      },
      {
        "protocol": "SQL (PostgreSQL)， Redis 协议， AMQP"
      }
    ],
    "features": [
      "多项目独立管理，配置完全隔离",
      "多环境灵活配置，环境间配置独立",
      "一键部署触发，全自动执行流程",
      "SSH密钥安全认证，加密存储",
      "版本化部署，自动创建版本目录并生成执行脚本",
      "实时日志推送，部署过程可视化",
      "完整审计追溯，操作全记录",
      "异步任务处理，部署不阻塞UI响应",
      "前后端分离，各层独立扩展"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Go",
      "framework": "Gin / Go-Zero"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL 15+",
    "cache": "Redis 7+",
    "mq": "RabbitMQ",
    "ssh_library": "golang.org/x/crypto/ssh",
    "deploy_protocol": "SCP / SFTP"
  },
  "components": [
    {
      "name": "Web Console",
      "type": "frontend",
      "description": "基于Web的管理控制台，提供项目、环境、部署等功能的操作界面",
      "responsibilities": [
        "项目CRUD操作界面",
        "部署环境配置界面",
        "SSH密钥管理界面",
        "一键部署触发及进度展示",
        "部署日志实时展示",
        "部署历史查询展示"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "系统统一入口网关，负责请求路由、身份认证、限流和日志记录",
      "responsibilities": [
        "请求路由分发到对应微服务",
        "用户身份认证与鉴权",
        "请求限流与防护",
        "统一日志记录与监控"
      ]
    },
    {
      "name": "Project Management Service",
      "type": "service",
      "description": "项目管理服务，负责部署项目的全生命周期管理",
      "responsibilities": [
        "创建、编辑、删除项目",
        "项目列表查询和详情获取",
        "项目下关联环境的管理",
        "项目维度的权限控制"
      ]
    },
    {
      "name": "Environment Management Service",
      "type": "service",
      "description": "环境管理服务，负责部署环境的配置管理",
      "responsibilities": [
        "部署环境的增删改查",
        "环境与SSH密钥的关联配置",
        "环境可用性验证",
        "环境标签化管理"
      ]
    },
    {
      "name": "Deployment Orchestrator",
      "type": "service",
      "description": "部署编排服务，核心调度引擎，负责编排整个部署流程",
      "responsibilities": [
        "接收部署请求并编排执行流程",
        "创建远程版本文件夹",
        "传输可执行文件到远程服务器",
        "生成并推送执行脚本",
        "管理部署任务状态流转",
        "触发远程执行并收集结果"
      ]
    },
    {
      "name": "SSH Execution Service",
      "type": "service",
      "description": "SSH执行服务，负责与远程服务器建立安全连接并执行命令",
      "responsibilities": [
        "SSH连接池管理与复用",
        "远程命令执行与结果返回",
        "文件安全传输（SCP/SFTP）",
        "连接超时与重试机制",
        "连接日志记录"
      ]
    },
    {
      "name": "Key Management Service",
      "type": "service",
      "description": "密钥管理服务，负责SSH密钥对的加密存储和管理",
      "responsibilities": [
        "SSH密钥对的生成、导入和删除",
        "密钥信息的加密存储",
        "密钥与部署环境的关联管理",
        "密钥解密提供给SSH执行服务"
      ]
    },
    {
      "name": "Audit Service",
      "type": "service",
      "description": "审计日志服务，负责全量操作行为的记录和查询",
      "responsibilities": [
        "记录所有用户操作行为",
        "部署操作全过程日志记录",
        "审计日志查询和导出",
        "日志持久化存储与归档"
      ]
    },
    {
      "name": "Primary Database",
      "type": "db",
      "description": "主数据库（PostgreSQL），存储系统所有业务数据",
      "responsibilities": [
        "项目信息持久化存储",
        "部署环境配置存储",
        "部署历史记录存储",
        "审计日志存储",
        "用户信息存储"
      ]
    },
    {
      "name": "Cache",
      "type": "cache",
      "description": "缓存层（Redis），加速热点数据访问和部署状态管理",
      "responsibilities": [
        "部署任务实时状态缓存",
        "会话信息缓存",
        "SSH连接池状态缓存",
        "热点配置数据缓存"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "Project CRUD API",
      "provider": "Project Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "多种",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {}
      },
      "description": "项目的增删改查接口集。POST /api/projects（创建）、DELETE /api/projects/:id（删除）、PUT /api/projects/:id（编辑）、GET /api/projects（列表）、GET /api/projects/:id（详情）"
    },
    {
      "interface": "Environment CRUD API",
      "provider": "Environment Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "多种",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {}
      },
      "description": "部署环境的增删改查接口集。POST /api/projects/:pid/environments（创建环境）、DELETE /api/environments/:id、PUT /api/environments/:id、GET /api/projects/:pid/environments（环境列表）、POST /api/environments/:id/test（连接测试）"
    },
    {
      "interface": "Trigger Deployment API",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/deployments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string",
          "environment_id": "string",
          "version": "string",
          "file_path": "string"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "string",
          "status": "string",
          "message": "string"
        }
      },
      "description": "触发一键部署，返回部署任务ID用于后续状态跟踪"
    },
    {
      "interface": "Deployment Status API",
      "provider": "Deployment Orchestrator",
