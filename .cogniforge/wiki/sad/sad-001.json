  "data_flow": [
    {
      "name": "用户登录流程",
      "steps": [
        "1. 用户在Web App输入凭证并提交",
        "2. API Gateway将请求路由至Auth Service",
        "3. Auth Service验证凭证并生成JWT",
        "4. Auth Service返回令牌，前端存储并用于后续请求"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "1. 用户在Web App选择项目、环境，上传文件并填写版本，点击部署",
        "2. Web App将文件及参数提交至API Gateway",
        "3. Gateway转发至Business Service，保存文件并创建部署记录",
        "4. Business Service将部署任务消息发送至RabbitMQ",
        "5. Deploy Engine消费消息，通过SCP传输文件至远程服务器",
        "6. Deploy Engine通过SSH执行命令：创建版本目录、解压、生成脚本、更新符号链接",
        "7. 期间通过WebSocket将执行日志推送给Web App",
        "8. 完成后Business Service更新部署记录状态"
      ]
    }
  ],
