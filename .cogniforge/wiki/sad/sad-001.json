  "title": "DeployFlow 系统架构方案",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "DeployFlow 是一款基于分层架构的轻量级自动化部署工具，采用前后端分离设计：React 前端提供直观的操作界面，Flask 后端处理核心业务逻辑并通过 REST API 与前端通信。系统使用 SQLite 本地存储项目、环境、历史等数据，通过 paramiko 库实现安全的 SSH 密钥认证与远程操作，支持多项目隔离、版本化部署、脚本定制及一键回滚。",
    "roles": [
      {
        "name": "用户",
        "permissions": [
          "创建、编辑、删除项目",
          "为项目配置测试/灰度/正式等多套环境",
          "进行 SSH 连接测试",
          "执行一键部署与查看实时进度",
          "自定义启动/停止脚本",
          "查看部署历史并执行回滚",
          "切换当前活动项目"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构（表现层-服务层-基础设施层-数据层）",
    "description": "系统采用清晰分层解耦：表现层基于 React SPA，通过 HTTPS REST 调用服务层；服务层由 Flask 核心应用实现，封装项目管理、环境配置、部署执行、历史记录等业务模块；基础设施层提供 SSH 连接池与 SFTP 传输能力；数据层使用 SQLite 数据库，通过 SQLAlchemy ORM 访问。各层间职责明确，便于独立开发和维护。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "React 前端应用"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "Flask API 核心服务",
          "部署执行引擎",
          "脚本模板管理器"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH 连接模块"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "SQLite 数据库"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "REST over HTTPS",
        "description": "表现层与服务层之间通过 RESTful API 通信，传递 JSON 格式数据"
      },
      {
        "protocol": "SQL (via SQLAlchemy ORM)",
        "description": "服务层通过 ORM 与 SQLite 数据库交互，进行持久化读写"
      },
      {
        "protocol": "SSH/SFTP",
        "description": "服务层通过 SSH 连接模块调用 paramiko 库，以加密通道执行远程命令和文件传输"
      }
    ],
    "features": [
      "轻量级单体应用，易于部署和分发",
      "前后端分离，UI 可独立迭代",
      "多项目完全隔离，数据独立管理",
      "基于 SSH 密钥的安全无密码自动化运维",
      "版本目录以时间戳或自定义标签命名，支持多版本共存与快速回滚",
      "内置脚本模板与变量替换，适应不同环境需求"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.10+",
      "framework": "Flask",
      "orm": "SQLAlchemy",
      "ssh_library": "paramiko"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design",
      "state_management": "React Context + hooks"
    },
    "database": "SQLite 3",
    "packaging": "Electron (可选，用于生成桌面安装包)"
  },
