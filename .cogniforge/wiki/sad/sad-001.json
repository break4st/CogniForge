  "data_flow": [
    {
      "name": "部署执行流程",
      "steps": [
        "用户在前端选择项目和目标环境，上传文件并填写版本信息。",
        "前端调用文件上传接口，文件存入 MinIO，返回文件 ID。",
        "用户点击“部署”，前端调用部署服务接口，传入项目、环境、文件、版本等信息。",
        "部署服务创建部署记录（状态 pending），并向 Redis 发布部署任务消息。",
        "部署执行服务监听任务，拉取环境配置（调用项目与环境服务），从安全服务获取解密私钥。",
        "建立 SSH 连接，依次：创建版本目录、SFTP 上传文件、生成启动脚本并 chmod +x、执行脚本。",
        "每一步生成日志事件，发布到 Redis 日志频道。",
        "网关/日志服务从 Redis 订阅日志频道，通过 WebSocket 将日志实时推送到前端。",
        "部署完成后（成功/失败），更新部署记录状态和耗时，写入部署历史。",
        "前端接收完成信号，展示最终结果。"
      ]
    },
    {
      "name": "回滚流程",
      "steps": [
        "用户从历史记录中选择一条成功部署，点击“回滚”。",
        "前端调用历史服务获取该记录的版本标识和文件 ID。",
        "前端跳转到部署准备页面，预填充环境、文件引用和版本标识（可修改）。",
        "用户确认后，发起一次新的部署（重复部署执行流程）。"
      ]
    }
  ],
