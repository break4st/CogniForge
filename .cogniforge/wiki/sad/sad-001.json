  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户通过Web控制台选择项目和目标环境",
        "上传可执行文件或选择已上传的构建产物",
        "前端调用DeployAPI触发部署",
        "部署编排服务接收请求，生成部署任务ID并写入Redis任务队列",
        "编排服务从Redis消费任务，调用KeyAPI获取目标环境的SSH密钥",
        "编排服务调用EnvironmentAPI获取目标服务器的连接信息",
        "SSH连接池建立或复用到远程服务器的连接",
        "远程命令执行器在远程服务器上创建版本化部署目录（如 /app/releases/v1.2.3/）",
        "文件传输引擎通过SCP/SFTP将文件传输到远程服务器目录",
        "脚本生成引擎根据项目配置生成启动脚本并写入部署目录",
        "远程命令执行器执行启动脚本，验证进程状态",
        "验证部署结果，执行健康检查",
        "版本管理服务记录本次部署版本号、时间戳、部署人等信息到PostgreSQL",
        "审计日志服务记录完整部署操作日志到PostgreSQL",
        "通过WebSocket实时推送部署进度和日志到前端看板",
        "部署完成，前端展示部署结果摘要"
      ]
    },
    {
      "name": "项目创建与环境配置流程",
      "steps": [
        "项目经理在Web控制台进入项目管理界面，创建新项目",
        "前端调用ProjectAPI创建项目",
        "API网关经认证中间件校验身份后路由到项目管理服务",
        "项目管理服务将项目信息持久化到PostgreSQL",
        "项目经理为项目添加多套环境（测试/灰度/正式），调用EnvironmentAPI",
        "环境管理服务为每套环境配置服务器地址和端口，存储到PostgreSQL",
        "运维管理员为每套环境配置SSH密钥，调用KeyAPI",
        "密钥管理服务对密钥内容进行AES-256加密后存储到PostgreSQL",
        "系统自动验证密钥有效性（尝试SSH连接到目标服务器）",
        "验证结果反馈给前端，环境配置完成"
      ]
    },
    {
      "name": "版本回滚流程",
      "steps": [
        "用户在Web控制台查看指定项目的部署历史版本列表",
        "调用VersionAPI查询版本记录",
        "用户选择需要回滚到的目标版本，触发回滚请求",
        "前端调用RollbackAPI发起回滚",
        "部署编排服务接收回滚任务，查询目标版本的部署文件和配置快照",
        "编排服务调用密钥和环境服务获取连接信息",
        "SSH连接池建立到远程服务器的连接",
        "远程命令执行器将当前版本目录备份（如 mv v2.0.0 v2.0.0_bak_20260522）",
        "将目标版本目录通过软链接切换为当前运行版本",
        "重新生成并执行目标版本的启动脚本",
        "验证回滚后服务状态（健康检查）",
        "版本管理服务更新版本状态（旧版本标记为 rolled_back）",
        "审计日志服务记录完整回滚操作日志"
      ]
    },
    {
      "name": "密钥管理流程",
      "steps": [
        "运维管理员在Web控制台进入环境配置界面，添加新SSH密钥",
        "输入密钥名称、选择密钥类型，粘贴密钥内容或上传密钥文件",
        "前端调用KeyAPI创建密钥",
        "API网关路由到密钥管理服务",
        "密钥管理服务对密钥内容进行AES-256加密",
        "加密后的密钥持久化到PostgreSQL数据库",
        "系统自动尝试使用该密钥SSH连接到目标服务器验证有效性",
        "验证结果反馈给前端（成功/失败及原因）",
        "密钥与目标环境绑定后生效"
      ]
    },
    {
      "name": "多项目切换流程",
      "steps": [
        "用户在Web控制台查看其有权限的所有项目列表",
        "选择目标项目进行切换",
        "前端调用ProjectSwitchAPI发起切换请求",
        "API网关路由到项目管理服务，服务更新用户当前项目上下文",
        "后端返回新项目详情的JWT Token（含项目上下文）",
        "前端刷新加载新项目的环境配置、部署记录和版本历史",
        "用户可在新项目环境下继续操作",
        "审计日志服务记录项目切换操作"
      ]
    }
  ]
}