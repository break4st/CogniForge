  "architecture_decisions": [
    {
      "id": "AD-001",
      "title": "选择本地B/S架构而非纯原生",
      "decision": "采用Electron + React + FastAPI构建桌面应用。",
      "rationale": "利用Web技术快速开发丰富UI，跨平台一致性好，避免为每个平台编写原生界面代码，降低维护成本。"
    },
    {
      "id": "AD-002",
      "title": "使用SQLite作为本地数据库",
      "decision": "嵌入SQLite，无需额外安装数据库服务器。",
      "rationale": "数据量小，仅单用户，无需并发处理，SQLite简单高效，适合本地应用。"
    }
  ],
  "risks": [
    {
      "id": "RSK-001",
      "description": "主密码丢失导致所有凭证无法解密",
      "impact": "高",
      "probability": "中",
      "mitigation": "在设置主密码时强烈提示用户自行保管备份，并可考虑后期增加恢复码机制。"
    },
    {
      "id": "RSK-002",
      "description": "大文件上传中断缺乏断点续传",
      "impact": "中",
      "probability": "低",
      "mitigation": "初期核心功能实现后，二期优化可加入基于SFTP的分块上传与重试。"
    }
