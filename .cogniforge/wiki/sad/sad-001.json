{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署管理系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-21 10:57"
  },
  "system_overview": {
    "description": "基于B/S架构的自动化部署管理平台，提供多项目、多环境的应用部署能力。系统通过Web控制台统一管理部署配置，采用SSH密钥安全连接远程服务器，支持一键完成可执行文件上传、版本目录创建和启动脚本生成的全自动化部署流程。支持测试线、灰度线、正式线等多套环境独立配置，满足企业级多项目并行部署管理需求。",
    "roles": [
      {
        "name": "系统管理员",
        "permissions": [
          "全局项目管理",
          "用户权限管理",
          "系统配置管理",
          "审计日志查看"
        ]
      },
      {
        "name": "运维工程师",
        "permissions": [
          "创建/编辑/删除部署环境",
          "配置SSH密钥",
          "执行部署操作",
          "查看部署状态和日志"
        ]
      },
      {
        "name": "开发工程师",
        "permissions": [
          "查看项目配置",
          "触发部署任务",
          "查看部署进度",
          "查看部署历史"
        ]
      },
      {
        "name": "技术负责人",
        "permissions": [
          "跨项目管理",
          "审批部署申请",
          "查看所有项目和环境的配置",
          "查看部署报表"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层微服务架构",
    "description": "采用前后端分离的分层微服务架构。前端为单页应用（SPA），后端通过API网关统一接入，核心业务拆分为多个领域服务（项目管理、环境管理、密钥管理、部署编排），服务间通过消息队列实现异步解耦。数据层采用关系型数据库持久化业务数据，Redis缓存热点数据，文件存储系统管理部署产物。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web管理控制台"]
      },
      {
        "name": "网关层",
        "components": ["API网关"]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "密钥管理服务",
          "部署编排服务",
          "SSH执行服务",
          "审计服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "关系型数据库",
          "缓存服务",
          "消息队列",
          "文件存储"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST + WebSocket"
      },
      {
        "protocol": "HTTP/REST + AMQP"
      },
      {
        "protocol": "SQL/Redis Protocol/AMQP/File I/O"
      }
    ],
    "features": [
      "前后端分离，松耦合架构",
      "API网关统一认证鉴权",
      "服务间异步消息通信",
      "密钥信息加密存储",
      "部署任务异步编排执行",
      "实时推送部署进度",
      "操作全链路审计",
      "水平可扩展"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Java 17",
      "framework": "Spring Boot 3.x + Spring Cloud"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5.x"
    },
    "database": "MySQL 8.0",
    "cache": "Redis 7.x",
    "mq": "RabbitMQ 3.x",
    "file_storage": "MinIO / 本地文件系统",
    "deployment": "Docker + Docker Compose",
    "api_gateway": "Spring Cloud Gateway"
  },
  "components": [
    {
      "name": "Web管理控制台",
      "type": "frontend",
      "description": "基于React的SPA应用，提供项目管理、环境配置、密钥管理、部署操作等可视化界面，通过WebSocket实时展示部署进度",
      "responsibilities": [
        "项目列表展示与搜索筛选",
        "部署环境CRUD操作界面",
        "SSH密钥管理界面",
        "一键部署触发与进度展示",
        "部署历史查看",
        "项目快速切换"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "统一API入口，负责请求路由、身份认证、权限校验、限流熔断、请求日志",
      "responsibilities": [
        "请求路由转发",
        "JWT令牌校验",
        "基于角色的权限控制",
        "接口限流与熔断",
        "统一请求日志记录",
        "WebSocket连接管理"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "负责项目生命周期的管理，包括项目的创建、编辑、删除以及项目间切换，维护项目与环境的关联关系",
      "responsibilities": [
        "项目CRUD操作",
        "项目-环境关联管理",
        "项目列表查询与搜索",
        "项目切换上下文管理"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理每套部署环境的配置信息，包括远程服务器地址、端口、关联的SSH密钥等",
      "responsibilities": [
        "部署环境CRUD操作",
        "环境参数配置管理",
        "环境-密钥关联管理",
        "检测环境连通性"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "管理系统中的所有SSH密钥对，对私钥进行加密存储，提供密钥与环境的关联绑定功能",
      "responsibilities": [
        "SSH密钥新增/更新/删除",
        "私钥加密存储与解密读取",
        "密钥-环境关联管理",
        "密钥有效性验证"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "核心部署引擎，负责编排整个部署流程：文件上传、版本目录创建、脚本生成、状态跟踪",
      "responsibilities": [
        "接收部署请求并编排执行流程",
        "生成带版本号的部署目录",
        "生成启动/停止脚本",
        "管理部署任务状态机",
        "通过消息队列派发SSH执行任务",
        "收集和推送部署进度"
      ]
    },
    {
      "name": "SSH执行服务",
      "type": "service",
      "description": "实际执行远程服务器操作的 worker 服务，通过SSH连接远程服务器执行文件传输和命令",
      "responsibilities": [
        "建立SSH连接",
        "上传可执行文件到远程服务器",
        "在远程服务器执行Shell命令",
        "返回执行结果和日志",
        "处理连接异常"
      ]
    },
    {
      "name": "审计服务",
      "type": "service",
      "description": "记录所有用户操作和系统事件，提供审计日志查询",
      "responsibilities": [
        "记录用户操作日志",
        "记录部署操作历史",
        "审计日志查询与导出",
        "异常操作告警"
      ]
    },
    {
      "name": "关系型数据库",
      "type": "db",
      "description": "MySQL 8.0，存储所有业务数据，包括项目信息、环境配置、密钥元数据、部署记录、审计日志等",
      "responsibilities": [
        "持久化存储业务数据",
        "保证数据一致性",
        "支持数据备份恢复"
      ]
    },
    {
      "name": "缓存服务",
      "type": "cache",
      "description": "Redis 7.x缓存，用于会话管理、部署状态缓存、数据缓存加速",
      "responsibilities": [
        "用户会话管理",
        "部署进度状态缓存",
        "热点数据查询加速",
        "分布式锁支持"
      ]
    },
    {
      "name": "消息队列",
      "type": "mq",
      "description": "RabbitMQ消息队列，解耦部署编排服务与SSH执行服务，实现异步处理",
      "responsibilities": [
        "部署任务异步分发",
        "SSH执行结果回传",
        "服务间解耦通信",
        "削峰填谷"
      ]
    },
    {
      "name": "文件存储",
      "type": "db",
      "description": "MinIO对象存储，存储上传的可执行文件部署包，支持版本化管理",
      "responsibilities": [
        "部署包文件存储",
        "文件版本管理",
        "文件安全访问控制"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "项目列表查询",
      "provider": "项目管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "keyword", "type": "string", "required": false, "description": "搜索关键字"},
          {"name": "page", "type": "integer", "required": false, "description": "页码"},
          {"name": "size", "type": "integer", "required": false, "description": "每页条数"}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {"type": "object", "description": "分页数据，包含项目列表"}
          }
        }
      },
      "description": "获取当前用户可见的项目列表，支持分页和关键字搜索"
    },
    {
      "interface": "创建项目",
      "provider": "项目管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "description": "项目名称"},
            "description": {"type": "string", "description": "项目描述"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {"type": "object", "description": "创建成功的项目信息"}
          }
        }
      },
      "description": "创建一个新项目"
    },
    {
      "interface": "环境列表查询",
      "provider": "环境管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "GET /api/projects/{projectId}/environments",
      "request": {
        "path_params": [
          {"name": "projectId", "type": "integer", "description": "项目ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {"type": "array", "description": "环境配置列表"}
          }
        }
      },
      "description": "获取指定项目下的所有部署环境配置"
    },
    {
      "interface": "创建部署环境",
      "provider": "环境管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "POST /api/projects/{projectId}/environments",
      "request": {
        "path_params": [
          {"name": "projectId", "type": "integer", "description": "项目ID"}
        ],
        "query_params": [],
        "body": {
          "type": "object",
          "required": ["name", "server_host", "server_port", "key_id"],
          "properties": {
            "name": {"type": "string", "description": "环境名称（如 测试线/灰度线/正式线）"},
            "server_host": {"type": "string", "description": "远程服务器地址"},
            "server_port": {"type": "integer", "description": "SSH端口"},
            "deploy_path": {"type": "string", "description": "部署基础路径"},
            "key_id": {"type": "integer", "description": "关联的SSH密钥ID"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {"type": "object", "description": "创建成功的环境信息"}
          }
        }
      },
      "description": "在指定项目下创建新的部署环境"
    },
    {
      "interface": "SSH密钥上传",
      "provider": "密钥管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "POST /api/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "required": ["name", "public_key", "private_key"],
          "properties": {
            "name": {"type": "string", "description": "密钥名称"},
            "public_key": {"type": "string", "description": "公钥内容"},
            "private_key": {"type": "string", "description": "私钥内容（加密传输）"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {
              "type": "object",
              "properties": {
                "id": {"type": "integer"},
                "name": {"type": "string"},
                "fingerprint": {"type": "string", "description": "密钥指纹"}
              }
            }
          }
        }
      },
      "description": "上传SSH密钥对，私钥在服务端AES加密后存储"
    },
    {
      "interface": "触发一键部署",
      "provider": "部署编排服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "POST /api/deployments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "required": ["project_id", "environment_id", "file_url"],
          "properties": {
            "project_id": {"type": "integer", "description": "项目ID"},
            "environment_id": {"type": "integer", "description": "部署环境ID"},
            "file_url": {"type": "string", "description": "部署包文件存储URL"},
            "version": {"type": "string", "description": "可选，自定义版本号"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {
              "type": "object",
              "properties": {
                "deployment_id": {"type": "integer", "description": "部署任务ID"},
                "status": {"type": "string", "description": "初始状态 pending"}
              }
            }
          }
        }
      },
      "description": "触发一次自动化部署任务，部署编排服务将异步执行完整部署流程"
    },
    {
      "interface": "部署进度查询",
      "provider": "部署编排服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "GET /api/deployments/{deploymentId}/progress",
      "request": {
        "path_params": [
          {"name": "deploymentId", "type": "integer", "description": "部署任务ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {
              "type": "object",
              "properties": {
                "status": {"type": "string", "description": "当前状态"},
                "progress": {"type": "integer", "description": "进度百分比"},
                "logs": {"type": "array", "description": "部署日志列表"}
              }
            }
          }
        }
      },
      "description": "查询指定部署任务的当前进度和日志"
    },
    {
      "interface": "部署进度WebSocket推送",
      "provider": "API网关",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "WebSocket /ws/deployments/{deploymentId}",
      "request": {
        "path_params": [
          {"name": "deploymentId", "type": "integer", "description": "部署任务ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "event": {"type": "string", "description": "事件类型 (progress/log/complete/error)"},
            "data": {"type": "object", "description": "进度数据"}
          }
        }
      },
      "description": "通过WebSocket实时推送部署进度到前端"
    },
    {
      "interface": "部署任务分发",
      "provider": "部署编排服务",
      "consumers": ["消息队列"],
      "type": "MQ",
      "endpoint": "AMQP exchange: deploy.task.direct",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "required": ["task_id", "server_host", "server_port", "private_key", "file_url", "deploy_path", "version"],
          "properties": {
            "task_id": {"type": "string", "description": "部署子任务ID"},
            "server_host": {"type": "string", "description": "远程服务器地址"},
            "server_port": {"type": "integer", "description": "SSH端口"},
            "private_key": {"type": "string", "description": "解密后的私钥内容"},
            "file_url": {"type": "string", "description": "部署包文件存储URL"},
            "deploy_path": {"type": "string", "description": "远程部署基础路径"},
            "version": {"type": "string", "description": "部署版本号"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {}
      },
      "description": "部署编排服务将SSH执行任务发送到消息队列，由SSH执行服务消费处理"
    },
    {
      "interface": "SSH执行结果回传",
      "provider": "SSH执行服务",
      "consumers": ["消息队列"],
      "type": "MQ",
      "endpoint": "AMQP exchange: deploy.result.direct",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "required": ["task_id", "status", "logs"],
          "properties": {
            "task_id": {"type": "string", "description": "部署子任务ID"},
            "status": {"type": "string", "description": "执行状态 (success/failed)"},
            "logs": {"type": "array", "description": "执行日志行列表"},
            "error_message": {"type": "string", "description": "失败时的错误信息"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {}
      },
      "description": "SSH执行服务完成任务后将结果发送到消息队列，由部署编排服务消费更新任务状态"
    },
    {
      "interface": "审计日志查询",
      "provider": "审计服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "GET /api/audit-logs",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "action_type", "type": "string", "required": false, "description": "操作类型筛选"},
          {"name": "operator", "type": "string", "required": false, "description": "操作人筛选"},
          {"name": "start_time", "type": "string", "required": false, "description": "开始时间"},
          {"name": "end_time", "type": "string", "required": false, "description": "结束时间"},
          {"name": "page", "type": "integer", "required": false},
          {"name": "size", "type": "integer", "required": false}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {"type": "object", "description": "分页审计日志数据"}
          }
        }
      },
      "description": "查询审计日志记录，支持按操作类型、操作人、时间范围筛选"
    },
    {
      "interface": "部署历史查询",
      "provider": "部署编排服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "GET /api/projects/{projectId}/deployments",
      "request": {
        "path_params": [
          {"name": "projectId", "type": "integer", "description": "项目ID"}
        ],
        "query_params": [
          {"name": "environment_id", "type": "integer", "required": false, "description": "按环境筛选"},
          {"name": "status", "type": "string", "required": false, "description": "按状态筛选"},
          {"name": "page", "type": "integer", "required": false},
          {"name": "size", "type": "integer", "required": false}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {"type": "integer"},
            "data": {"type": "object", "description": "分页部署历史数据"}
          }
        }
      },
      "description": "查询指定项目的部署历史记录"
    },
