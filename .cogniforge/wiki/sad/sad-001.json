      "consumers": ["API网关", "Web前端"],
      "type": "REST",
      "endpoint": "POST /api/v1/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "public_key": "string",
          "private_key": "string (encrypted on receipt)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "string (uuid)",
          "name": "string",
          "fingerprint": "string",
          "created_at": "string (datetime)"
        }
      },
      "description": "上传SSH密钥（私钥传输加密，服务端加密存储）"
    },
    {
      "interface": "ConnectionTestAPI",
      "provider": "环境管理服务",
      "consumers": ["API网关", "Web前端"],
      "type": "REST",
      "endpoint": "POST /api/v1/environments/{env_id}/test",
      "request": {
        "path_params": [
          {"name": "env_id", "type": "string (uuid)"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "reachable": "boolean",
          "latency_ms": "integer",
          "error": "string (optional)"
        }
      },
      "description": "测试指定环境的SSH连接是否可用"
    },
    {
      "interface": "DeployAPI",
      "provider": "部署引擎服务",
      "consumers": ["API网关", "Web前端"],
      "type": "REST",
      "endpoint": "POST /api/v1/deployments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string (uuid)",
          "environment_id": "string (uuid)",
          "version": "string",
          "artifact_path": "string",
          "rollback_on_failure": "boolean (default: false)"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "string (uuid)",
          "status": "enum (pending|running|success|failed)",
          "created_at": "string (datetime)"
        }
      },
      "description": "触发一键部署任务，返回部署ID用于后续状态查询"
    },
    {
      "interface": "DeployStatusAPI",
      "provider": "部署引擎服务",
      "consumers": ["API网关", "Web前端", "缓存"],
      "type": "REST",
      "endpoint": "GET /api/v1/deployments/{deployment_id}/status",
      "request": {
        "path_params": [
          {"name": "deployment_id", "type": "string (uuid)"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string (uuid)",
          "status": "string",
          "progress": "integer (0-100)",
          "current_step": "string",
          "logs": "array<LogEntry>",
          "started_at": "string (datetime)",
          "finished_at": "string (datetime, optional)"
        }
      },
      "description": "查询部署状态与日志（WebSocket推送相同结构）"
    },
    {
      "interface": "RollbackAPI",
      "provider": "部署引擎服务",
      "consumers": ["API网关", "Web前端"],
      "type": "REST",
      "endpoint": "POST /api/v1/deployments/{deployment_id}/rollback",
      "request": {
        "path_params": [
          {"name": "deployment_id", "type": "string (uuid)"}
        ],
        "query_params": [],
        "body": {
          "target_version": "string"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "rollback_deployment_id": "string (uuid)",
          "status": "string",
          "target_version": "string"
        }
      },
      "description": "发起版本回滚，创建新的回滚部署任务"
    },
    {
      "interface": "DeployLogStreamAPI",
      "provider": "部署引擎服务",
      "consumers": ["Web前端"],
      "type": "WebSocket",
      "endpoint": "WS /api/v1/deployments/{deployment_id}/logs/ws",
      "request": {
        "path_params": [
          {"name": "deployment_id", "type": "string (uuid)"}
        ],
        "query_params": [
          {"name": "token", "type": "string (JWT)"}
        ],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "stream": "array<LogEntry> (持续推送)"
        }
      },
      "description": "WebSocket实时推送部署日志（双向关闭后结束）"
    },
    {
      "interface": "SSHPoolAPI",
      "provider": "SSH连接池",
      "consumers": ["部署引擎服务", "文件传输模块", "脚本生成引擎"],
      "type": "内部方法调用",
      "endpoint": "内部: get_connection(env_id) -> SSHConnection",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "env_id": "string (uuid)",
          "timeout_seconds": "integer (default: 30)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "connection": "SSHConnection (opaque handle)",
          "server_info": "object"
        }
      },
      "description": "从连接池获取或创建指定环境的SSH连接"
    },
    {
      "interface": "FileTransferAPI",
      "provider": "文件传输模块",
      "consumers": ["部署引擎服务"],
      "type": "内部方法调用",
      "endpoint": "内部: transfer_file(conn, local_path, remote_dir)",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "connection": "SSHConnection",
          "local_path": "string",
          "remote_dir": "string",
          "version": "string",
          "on_progress": "callable(progress: int)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "remote_path": "string",
          "checksum": "string",
          "size_bytes": "integer",
          "duration_ms": "integer"
        }
      },
      "description": "通过已建立的SSH连接将文件传输到远程服务器"
    },
    {
      "interface": "ScriptGenerationAPI",
      "provider": "脚本生成引擎",
      "consumers": ["部署引擎服务"],
      "type": "内部方法调用",
      "endpoint": "内部: generate_script(action, params)",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "action": "enum (deploy|rollback|status_check)",
          "params": {
            "version": "string",
            "remote_path": "string",
            "artifact_name": "string",
            "platform": "enum (linux|windows)"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "script_content": "string",
          "script_type": "enum (bash|powershell)",
          "estimated_runtime_seconds": "integer"
        }
      },
      "description": "根据部署参数生成远程执行脚本内容"
    }
  ],
  "data_flow": [
    {
      "name": "项目创建与配置流程",
      "steps": [
        "用户在前端创建项目，填写项目名称与描述",
        "Web前端发送 POST /api/v1/projects 到API网关",
        "API网关鉴权通过后路由至项目管理服务",
        "项目管理服务校验参数，将项目信息写入关系型数据库",
        "项目管理服务返回项目详情至前端",
        "用户在前端为目标项目配置部署环境，上传SSH密钥",
        "环境管理服务加密存储密钥至数据库，记录环境配置",
        "环境管理服务返回环境配置结果至前端",
        "前端展示新创建的项目及已配置的环境列表"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "用户在前端选择目标环境、版本号和部署包，点击部署",
        "Web前端发送 POST /api/v1/deployments 到API网关",
        "API网关鉴权后路由至部署引擎服务",
        "部署引擎服务校验参数，创建部署记录写入数据库",
        "部署引擎服务下发异步任务到Celery队列",
        "部署引擎服务通过SSH连接池获取目标环境的SSH连接",
        "文件传输模块通过SSH连接将部署包上传至远程服务器的版本目录",
        "脚本生成引擎根据部署参数生成远程执行脚本",
        "远程通过SSH执行部署脚本，创建版本文件夹并运行",
        "部署引擎服务持续采集执行日志，通过WebSocket实时推送至前端",
        "部署完成后更新数据库状态，前端展示最终部署结果"
      ]
    },
    {
      "name": "版本回滚流程",
      "steps": [
        "用户在前端选择历史版本并发起回滚操作",
        "Web前端发送 POST /api/v1/deployments/{id}/rollback 到API网关",
        "API网关鉴权后路由至部署引擎服务",
        "部署引擎服务查找目标版本的部署记录与远程路径",
        "脚本生成引擎生成回滚脚本（停止当前版本、还原上一版本）",
        "通过SSH连接池获取连接，将回滚脚本传输到远程服务器并执行",
        "更新部署记录状态（回滚完成），推送结果至前端"
      ]
    },
    {
      "name": "项目切换流程",
      "steps": [
        "用户在前端点击切换至目标项目",
        "Web前端发送 POST /api/v1/projects/{project_id}/switch 到API网关",
        "API网关鉴权后路由至项目管理服务",
        "项目管理服务校验项目存在性，更新当前会话的项目上下文",
        "环境管理服务同步目标项目的环境配置列表",
        "返回目标项目详情与环境列表至前端",
        "前端刷新UI，展示目标项目的面板和环境信息"
      ]
    },
    {
      "name": "SSH连接测试流程",
