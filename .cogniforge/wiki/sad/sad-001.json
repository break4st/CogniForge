  "title": "CogniForge 自动化部署工具系统架构",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "CogniForge 是一款基于 Electron 的桌面应用程序，面向开发运维人员，提供多项目独立管理、安全 SSH 连接、一键部署、历史回溯等功能。系统采用模块化单体架构，通过主进程与渲染进程分离实现 UI 与业务逻辑的解耦，利用本地 SQLite 数据库存储配置与历史，并对敏感密钥实施 AES-256 加密。整体架构围绕项目管理、环境配置、部署执行和安全控制四大核心域构建，支持可扩展的部署流程和灵活的环境管理。",
    "roles": [
      {
        "name": "操作员（开发/运维/测试/安全/产品经理）",
        "permissions": [
          "创建、查看、编辑、删除项目",
          "管理所有环境的配置与密钥",
          "执行一键部署",
          "测试连接",
          "查看部署历史并执行回滚",
          "查阅审计日志"
        ]
      }
    ]
  },
  "architecture": {
    "style": "模块化单体（Electron 桌面应用）",
    "description": "系统采用 Electron 框架构建跨平台桌面应用，前端使用 React + TypeScript 实现丰富的用户界面，后端逻辑运行于 Electron 主进程，通过 IPC 通信与渲染进程交互。主要划分为表现层、业务逻辑层、基础服务层和数据持久层。表现层负责 UI 交互与快捷键响应；业务逻辑层包含项目管理、环境管理、部署引擎等核心模块；基础服务层封装 SSH/SFTP 通信、密钥加解密及审计日志；数据持久层采用 SQLite 本地数据库。各层之间通过定义好的服务接口解耦，确保单一职责和可测试性。",
    "layers": [
      {
        "name": "表现层（渲染进程）",
        "components": [
          "UI Shell",
          "项目列表视图",
          "环境管理视图",
          "部署操作视图",
          "历史记录视图"
        ]
      },
      {
        "name": "业务逻辑层（主进程）",
        "components": [
          "Project Manager",
          "Environment Manager",
          "Deployment Engine",
          "History & Rollback Service"
        ]
      },
      {
        "name": "基础服务层（主进程）",
        "components": [
          "SSH Service",
          "Security Module",
          "Audit Logger"
        ]
      },
      {
        "name": "数据持久层",
        "components": [
          "Data Access Layer (SQLite)"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "Electron IPC (contextBridge / ipcRenderer / ipcMain)",
        "description": "渲染进程通过预加载暴露的安全 API 调用主进程方法，主进程返回结果或事件推送，实现双向通信。"
      },
      {
        "protocol": "SSH2 / SFTP",
        "description": "SSH Service 使用 SSH2 协议与远程服务器建立安全连接，通过 SFTP 传输文件并执行 shell 命令。"
      },
      {
        "protocol": "SQLite Native API",
        "description": "Data Access Layer 通过 better-sqlite3 或类似库直接操作本地数据库文件。"
      }
    ],
    "features": [
      "Electron 跨平台桌面应用",
      "渲染进程-主进程 IPC 安全通信",
      "基于 SSH 密钥的远程认证",
      "AES-256 本地密钥加密存储",
      "流程化的部署步骤（进度反馈）",
      "版本化部署文件夹与可执行脚本生成",
      "部署历史完整记录与一键回滚",
      "快捷键与拖拽交互支持",
      "多项目数据隔离"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "TypeScript / Node.js",
      "runtime": "Electron 主进程",
      "ipc": "Electron ipcMain / contextBridge"
    },
    "frontend": {
      "framework": "React",
      "language": "TypeScript",
      "ui_library": "Ant Design",
      "runtime": "Electron 渲染进程"
    },
    "database": "SQLite (via better-sqlite3)",
    "ssh": "ssh2 / ssh2-sftp-client",
    "encryption": "Node.js crypto (AES-256-GCM)",
    "key_management": "OS 密钥环（可选）或主密码派生密钥"
  },
  "components": [
