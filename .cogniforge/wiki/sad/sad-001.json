{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统 - 系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-20 16:40"
  },
  "system_overview": {
    "description": "自动化部署系统是一个基于 Web 的可视化部署平台，支持用户管理多项目、多环境（测试线、灰度线、正式线），通过 SSH 密钥安全连接到远程服务器，实现一键式自动化部署。系统采用前后端分离的微服务架构，将项目管理、环境配置、部署执行等核心能力解耦为独立服务，确保可扩展性与可维护性。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "管理部署环境（创建/编辑/删除测试线、灰度线、正式线）",
          "配置服务器连接参数和SSH密钥",
          "查看部署日志和状态",
          "一键触发部署流程",
          "查看已部署版本列表"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目环境配置",
          "触发部署流程",
          "查看部署日志",
          "上传可执行文件"
        ]
      },
      {
        "name": "项目管理员",
        "permissions": [
          "创建/编辑/删除项目",
          "管理项目成员权限",
          "配置项目部署环境",
          "查看所有项目状态",
          "审批/回滚部署"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构（前后端分离）",
    "description": "系统采用前后端分离的微服务架构，前端为单页应用（SPA），后端按业务领域拆分为独立微服务。各服务通过 REST API 通信，异步任务通过消息队列解耦。数据存储采用关系型数据库为主、对象存储为辅的混合存储策略。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web管理控制台"]
      },
      {
        "name": "网关层",
        "components": ["API网关"]
      },
      {
        "name": "业务服务层",
        "components": ["项目管理服务", "环境管理服务", "部署编排服务", "SSH执行服务", "文件管理服务"]
      },
      {
        "name": "数据层",
        "components": ["关系型数据库", "文件存储", "消息队列", "缓存"]
      }
    ],
    "connections": [
      {"protocol": "REST/HTTPS"},
      {"protocol": "REST/HTTPS"},
      {"protocol": "AMQP/SQL"}
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "服务无状态设计，支持水平扩展",
      "异步任务处理，部署操作不阻塞用户",
      "SSH连接池复用，提升远程执行效率",
      "统一认证鉴权，保障系统安全",
      "完整审计日志，操作可追溯"
    ]
  },
  "components": [
    {
      "name": "Web管理控制台",
      "type": "frontend",
      "description": "基于 React/Vue 的单页应用，提供可视化的部署管理界面",
      "responsibilities": [
        "项目CRUD界面",
        "环境配置管理界面",
        "部署触发和进度展示",
        "部署日志和历史记录"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "统一API入口，负责路由、认证、限流",
      "responsibilities": [
        "统一请求入口",
        "JWT验证与鉴权",
        "请求路由",
        "API限流"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "管理项目全生命周期",
      "responsibilities": [
        "项目CRUD",
        "成员权限管理",
        "状态跟踪",
        "环境关联管理"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理部署环境配置和SSH密钥",
      "responsibilities": [
        "环境CRUD",
        "SSH密钥安全存储",
        "环境变量配置",
        "连接测试验证"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "核心部署引擎，任务编排和流程控制",
      "responsibilities": [
        "部署请求编排",
        "版本文件夹创建",
        "执行脚本生成",
        "状态管理",
        "回滚支持"
      ]
    },
    {
      "name": "SSH执行服务",
      "type": "service",
      "description": "SSH连接管理和远程命令执行",
      "responsibilities": [
        "SSH连接池管理",
        "远程命令执行",
        "文件传输",
        "心跳检测"
      ]
    },
    {
      "name": "文件管理服务",
      "type": "service",
      "description": "可执行文件上传和版本管理",
      "responsibilities": [
        "文件上传存储",
        "版本管理",
        "完整性校验",
        "按需分发"
      ]
    },
    {
      "name": "关系型数据库",
      "type": "db",
      "description": "结构化业务数据存储",
      "responsibilities": [
        "项目环境配置持久化",
        "部署历史记录",
        "用户权限数据",
        "审计日志"
      ]
    },
    {
      "name": "文件存储",
      "type": "db",
      "description": "可执行文件和脚本存储",
      "responsibilities": [
        "文件二进制存储",
        "脚本模板存储",
        "部署包归档"
      ]
    },
    {
      "name": "消息队列",
      "type": "mq",
      "description": "异步任务解耦和事件通知",
      "responsibilities": [
        "部署任务分发",
        "失败重试",
        "状态事件通知"
      ]
    },
    {
      "name": "缓存",
      "type": "cache",
      "description": "热点数据缓存",
      "responsibilities": [
        "项目状态缓存",
        "环境配置缓存",
        "SSH会话缓存",
        "部署进度缓存"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "项目创建接口",
      "provider": "项目管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "description": "string",
          "members": "array"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "name": "string",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "description": "创建新项目，包含项目基本信息和初始成员配置"
    },
    {
      "interface": "环境配置接口",
      "provider": "环境管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/environments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string",
          "name": "string",
          "env_type": "string",
          "server_host": "string",
          "server_port": "integer",
          "ssh_key": "string",
          "env_vars": "object"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "name": "string",
          "env_type": "string",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "description": "为指定项目创建部署环境，配置服务器连接参数和SSH密钥"
    },
    {
      "interface": "连接测试接口",
      "provider": "SSH执行服务",
      "consumers": ["环境管理服务"],
      "type": "REST",
      "endpoint": "POST /api/ssh/test",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "integer",
          "ssh_key": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string",
          "latency_ms": "integer"
        }
      },
      "description": "测试SSH连接到远程服务器是否可用"
    },
    {
      "interface": "触发部署接口",
      "provider": "部署编排服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/deploy",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string",
          "env_id": "string",
          "file_id": "string",
          "version": "string",
          "trigger_by": "string"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deploy_id": "string",
          "status": "string",
          "message": "string"
        }
      },
      "description": "触发一次部署任务，返回部署任务ID供后续轮询状态"
    },
    {
      "interface": "文件上传接口",
      "provider": "文件管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/files/upload",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string",
          "file": "binary",
          "filename": "string",
          "checksum": "string"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "file_id": "string",
          "version": "string",
          "size": "integer",
          "checksum": "string",
          "created_at": "datetime"
        }
      },
      "description": "上传可执行文件，返回文件ID和版本信息"
    },
    {
      "interface": "文件传输接口",
      "provider": "SSH执行服务",
      "consumers": ["文件管理服务"],
      "type": "REST",
      "endpoint": "POST /api/ssh/transfer",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "integer",
          "ssh_key": "string",
          "file_url": "string",
          "remote_path": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "remote_path": "string",
          "size": "integer"
        }
      },
      "description": "通过SSH传输文件到远程服务器的指定路径"
    },
    {
      "interface": "部署任务消息",
      "provider": "部署编排服务",
      "consumers": ["SSH执行服务"],
      "type": "MQ",
      "endpoint": "topic: deploy.task",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "deploy_id": "string",
          "host": "string",
          "port": "integer",
          "ssh_key": "string",
          "file_url": "string",
          "version": "string",
          "project_name": "string",
          "env_name": "string",
          "remote_base_path": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "deploy_id": "string",
          "status": "string",
          "log_url": "string"
        }
      },
      "description": "部署编排服务将部署任务推送到消息队列，SSH执行服务消费并执行远程操作"
    },
    {
      "interface": "部署日志推送",
      "provider": "SSH执行服务",
      "consumers": ["Web管理控制台"],
      "type": "WebSocket",
      "endpoint": "WS /ws/deploy/{deploy_id}/log",
      "request": {
        "path_params": [
          {"name": "deploy_id", "type": "string"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "type": "log|status|error",
          "data": "string",
          "timestamp": "datetime"
        }
      },
      "description": "通过WebSocket实时推送部署日志到前端控制台"
    },
    {
      "interface": "回滚部署接口",
      "provider": "部署编排服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/deploy/{deploy_id}/rollback",
      "request": {
        "path_params": [
          {"name": "deploy_id", "type": "string"}
        ],
        "query_params": [],
        "body": {
          "reason": "string",
          "trigger_by": "string"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "rollback_id": "string",
          "status": "string",
          "message": "string"
        }
      },
      "description": "回滚指定部署到上一个版本"
    }
  ],
  "data_flow": [
    {
      "name": "项目创建流程",
      "steps": [
        "用户填写项目信息并提交",
        "API网关验证JWT并路由到项目管理服务",
        "项目管理服务校验并创建记录到数据库",
        "返回创建结果，前端刷新项目列表"
      ]
    },
    {
      "name": "环境配置流程",
      "steps": [
        "用户选择项目并添加部署环境",
        "环境管理服务接收配置并安全存储SSH密钥",
        "用户发起连接测试请求",
        "SSH执行服务验证连接配置",
        "返回测试结果，更新状态"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "用户选择项目、环境和文件，点击部署",
        "API网关发送请求到部署编排服务",
        "部署编排服务创建部署任务并推送到消息队列",
        "文件管理服务传输文件到SSH执行服务",
        "SSH执行服务在远程创建版本文件夹 (/data/deploy/{project}/{env}/{version}/)",
        "上传可执行文件并生成执行脚本",
        "授予执行权限并运行部署脚本",
        "通过WebSocket实时展示部署日志和结果"
      ]
    },
    {
      "name": "部署回滚流程",
      "steps": [
        "用户在历史中选择版本发起回滚",
        "部署编排服务查询目标版本记录",
        "从文件存储获取历史文件并传输",
        "执行回滚脚本完成版本切换",
        "通知前端回滚结果"
      ]
    }
  ]
}
