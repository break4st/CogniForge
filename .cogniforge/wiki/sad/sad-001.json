  "system_overview": {
    "description": "该系统面向 DevOps 工程师、开发人员、发布经理、运维人员及团队负责人等角色，提供以项目为维度的部署环境管理、安全文件传输、一键自动化部署、实时日志查看、部署历史记录及版本回滚等功能。系统保障敏感数据加密存储，支持多项目并行操作，并通过严格的角色权限控制确保操作安全与合规。",
    "roles": [
      {
        "name": "DevOps 工程师",
        "permissions": [
          "项目管理（创建、编辑、删除、切换）",
          "环境配置管理（CRUD）",
          "部署执行",
          "查看部署历史及日志",
          "回滚操作",
          "连接测试",
          "私钥管理"
        ]
      },
      {
        "name": "后端开发人员",
        "permissions": [
          "查看现有项目和环境（无删除权限）",
          "上传部署文件",
          "执行部署到测试环境",
          "查看自身部署历史及日志"
        ]
      },
      {
        "name": "发布经理",
        "permissions": [
          "部署到生产环境（需授权）",
          "查看所有部署历史及实时日志",
          "回滚操作（需审批）"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "环境配置管理",
          "服务器脚本模板维护",
          "查看服务器端日志",
          "测试连接",
          "私钥管理"
        ]
      },
      {
        "name": "团队负责人",
        "permissions": [
          "查看所有项目的部署历史与统计",
          "一键回滚操作",
          "审批关键操作"
        ]
      },
      {
        "name": "系统管理员",
        "permissions": [
          "全系统管理",
          "用户与角色管理",
          "安全审计",
          "私钥加密管理",
          "历史记录删除（保留操作）"
        ]
      }
    ]
  },
  "architecture": {
    "style": "前后端分离 + 微服务风格",
    "description": "前端基于 React SPA，后端拆分为业务服务与基础设施服务，通过 API 网关统一入口，数据层使用 PostgreSQL、Redis 和 MinIO。服务间通过 REST/gRPC 或消息队列通信，实时日志通过 WebSocket 推送。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "Web 前端"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API 网关"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "项目与环境服务",
          "文件管理服务",
          "部署执行服务",
          "安全与密钥服务",
          "部署历史与日志服务",
          "用户与权限服务"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL",
          "Redis",
          "MinIO"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS",
        "description": "接入层（Web 前端）与网关层之间的加密通信"
      },
      {
        "protocol": "REST/WebSocket",
        "description": "网关层与服务层之间的通信，WebSocket 用于实时日志推送"
      },
      {
        "protocol": "REST/gRPC/Redis Pub/Sub",
        "description": "服务层内部组件之间的同步与异步通信"
      },
      {
        "protocol": "SQL/Redis Protocol/S3 API",
        "description": "服务层与数据层之间的通信"
      }
    ],
    "features": [
      "前后端分离",
      "基于 WebSocket 的实时日志推送",
      "微服务风格解耦",
      "SSH 密钥加密存储",
      "事件驱动的部署任务执行",
      "多项目并行管理",
      "基于角色的访问控制"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Go",
      "framework": "Gin"
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design"
    },
    "database": "PostgreSQL",
    "message_queue": "Redis",
    "object_storage": "MinIO",
    "gateway": "Nginx"
  },
