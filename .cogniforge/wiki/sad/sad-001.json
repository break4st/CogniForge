        }
      ]
    },
    {
      "id": "CTR-002",
      "interface": "环境管理 API",
      "provider_component_id": "CMP-004",
      "provider": "环境管理服务",
      "consumers": [
        "桌面客户端 (CMP-001)"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "POST /api/environments, GET /api/environments, GET /api/environments/{id}, PUT /api/environments/{id}, DELETE /api/environments/{id}, POST /api/environments/{id}/test-connection",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "环境ID"
          }
        ],
        "query_params": [
          {
            "name": "project_id",
            "type": "integer",
            "required": false,
            "description": "按项目ID筛选环境"
          }
        ],
        "body": {
          "name": "string (必填)",
          "type_tag": "string (可选)",
          "host": "string (必填)",
          "port": "integer (默认22)",
          "auth_type": "string (key/password，目前仅支持key)",
          "key_id": "integer (当auth_type为key时必填)",
          "remote_base_dir": "string (必填)",
          "pre_script": "string (可选)",
          "post_script": "string (可选)",
          "rollback_script": "string (可选)",
          "project_id": "integer (必填)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "type_tag": "string",
          "host": "string",
          "port": "integer",
          "auth_type": "string",
          "key_id": "integer或null",
          "remote_base_dir": "string",
          "pre_script": "string或null",
          "post_script": "string或null",
          "rollback_script": "string或null",
          "project_id": "integer",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "errors": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "环境不存在"
        },
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "请求体参数错误，比如密钥ID无效或不属于任何已注册密钥"
        },
        {
          "status": 409,
          "code": "REFERENCE_EXISTS",
          "message": "环境被项目关联且正在使用中，不可删除"
        },
        {
          "status": 502,
          "code": "SSH_CONNECTION_FAILED",
          "message": "SSH连接测试失败，包含具体原因如网络不通、认证失败等"
        }
      ],
      "description": "提供对部署环境配置的CRUD操作，以及一个测试连接的动作端点。创建或编辑时若选择密钥认证，必须从已注册密钥中选择。",
      "source_requirements": [
