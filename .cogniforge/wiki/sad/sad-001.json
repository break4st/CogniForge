    "version": 1
  },
  "system_overview": {
    "description": "CogniForge 是一个基于 Electron 的桌面应用，帮助开发者将本地打包文件一键部署到远程服务器。系统支持多项目管理、独立环境配置、安全凭据存储、实时日志回传、版本回滚等功能。采用分层架构，前端 React + TypeScript，后端 Node.js 集成在 Electron 主进程，本地使用 SQLite，通过 SSH 协议与远程服务器交互。",
    "roles": [
      {
        "name": "开发者",
        "permissions": [
          "项目管理",
          "环境配置",
          "一键部署",
          "查看历史",
          "回滚"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "管理凭据",
          "导入私钥",
          "设置主密码"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "查看部署历史",
          "执行回滚"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层 + 前后端分离（Electron 主进程与渲染进程）",
    "description": "渲染进程负责 UI 展示和用户交互，通过 Electron IPC 调用主进程的服务模块。主进程中的服务层包括项目服务、环境服务、部署服务、安全服务、SSH 服务等，通过数据访问层操作本地 SQLite 数据库。远程通信完全基于 SSH 协议。整体分为表示层、服务层、数据层和基础设施层。",
    "layers": [
      {
        "name": "表示层 (UI)",
        "components": [
          "项目管理页面",
          "环境配置页面",
          "部署页面",
          "部署历史页面",
          "主密码管理页面",
          "项目切换组件"
        ]
      },
      {
        "name": "应用服务层",
        "components": [
          "ProjectService",
          "EnvironmentService",
          "DeploymentService",
          "RollbackService",
          "SecurityService",
          "SSHService",
          "LoggerService"
        ]
      },
      {
        "name": "数据访问层",
        "components": [
          "DatabaseService"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "Electron Main Process",
          "IPC Bridge",
          "EncryptionUtils",
          "FileUtils"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "Electron IPC",
        "description": "渲染进程与主进程之间通过 contextBridge 和 ipcMain/ipcRenderer 双向通信"
      },
      {
        "protocol": "SSH (SSH2)",
        "description": "主进程中的 SSHService 通过 ssh2 库与远程服务器建立 SSH 连接，执行命令和 SFTP 文件传输"
      },
      {
        "protocol": "SQLite (同步SQL)",
        "description": "服务层组件通过 DatabaseService 执行本地 SQLite 数据库的读写操作，使用 better-sqlite3 同步接口"
      }
    ],
    "features": [
      "跨平台桌面应用 (Electron)",
      "分层解耦，服务可独立测试",
      "本地 SQLite 轻量化存储",
      "SSH 协议远程部署，无需服务器额外安装 Agent",
      "敏感数据 AES-256-GCM 加密，主密码 PBKDF2 派生密钥",
      "实时日志推送 (IPC 事件)",
      "多项目配置隔离，快速切换上下文"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "TypeScript",
      "framework": "Electron (Node.js runtime)",
      "libraries": [
        "better-sqlite3",
        "ssh2",
        "node-crypto"
      ]
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design",
      "build_tool": "Vite"
    },
    "database": "SQLite",
    "packaging": "electron-builder"
  },
