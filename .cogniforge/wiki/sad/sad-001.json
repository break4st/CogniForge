  "title": "根据已批准PRD自动设计系统架构",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "DeployOne 是一个面向开发团队的一键远程部署管理平台，通过可视化界面管理多个项目及多套部署环境，支持密钥安全连接远程服务器，上传软件包并实现自动化部署、进度实时展示，以及部署历史回溯与回滚。系统采用模块化单体架构 + 异步任务队列，前端为 SPA，后端提供 RESTful API 并通过 WebSocket 推送实时进度。",
    "roles": [
      {
        "name": "平台用户",
        "permissions": [
          "创建、编辑、删除项目",
          "切换当前项目",
          "管理环境配置并测试连接",
          "上传、下载、删除软件包",
          "发起一键部署并查看实时进度",
          "查询部署历史与日志",
          "执行回滚操作"
        ]
      }
    ]
  },
  "architecture": {
    "style": "模块化单体架构",
    "description": "后端整体作为一个服务，内部划分为项目管理、环境配置、软件包管理、部署编排、历史查询等模块。部署任务通过 Redis + Celery 异步执行，并通过 WebSocket 实时向前端推送步骤进度。前端为单页面应用（Vue 3），直接调用后端 API 并与 WebSocket 交互。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "前端 SPA（Vue 3）"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "Nginx（可选，亦可直接由后端服务提供静态资源）"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "API 接口服务（FastAPI）",
          "项目管理模块",
          "环境配置模块",
          "软件包管理模块",
          "部署编排模块",
          "历史与日志模块",
          "实时通知模块（WebSocket）",
          "认证模块（可选）",
          "异步任务 Worker（Celery）",
          "SSH 连接管理器"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL 数据库",
          "文件存储（本地磁盘或对象存储）"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST",
        "description": "前端通过 REST API 与后端服务层通信"
      },
      {
        "protocol": "WebSocket",
        "description": "前端与实时通知模块建立 WebSocket，接收部署进度和日志"
      },
      {
        "protocol": "TCP / SQL",
        "description": "服务层通过 ORM 与 PostgreSQL 数据库交互"
      },
      {
        "protocol": "AMQP / Redis",
        "description": "服务层通过消息队列投递部署异步任务到 Celery Worker"
      },
      {
        "protocol": "SSH / SFTP",
        "description": "部署 Worker 通过 SSH 协议与远程服务器交互"
      }
    ],
    "features": [
      "异步任务处理，保证部署过程不阻塞主服务",
      "WebSocket 实时推送部署进度与日志",
      "敏感信息加密存储",
      "基于项目的多环境数据隔离",
      "支持一键回滚至历史版本",
      "前后端分离，界面实时更新"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3 + TypeScript",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL",
    "file_storage": "本地文件系统（可扩展为 MinIO/S3）",
    "message_queue": "Celery + Redis",
    "ssh_library": "asyncssh",
    "encryption": "Fernet 对称加密"
  },
