{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "AutoDeploy 自动化部署平台 - 系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-21 10:30"
  },
  "system_overview": {
    "description": "AutoDeploy 自动化部署平台旨在实现将打包好的可执行文件自动化部署到指定远程服务器的功能。平台采用前后端分离的B/S架构，支持用户自定义多套部署环境（如测试线、灰度线、正式线等），通过SSH安全连接实现一键式自动化部署，并支持多项目并行管理。",
    "roles": [
      {
        "name": "开发者",
        "permissions": [
          "选择项目和部署环境",
          "发起一键部署",
          "查看部署日志",
          "查看项目列表"
        ]
      },
      {
        "name": "运维工程师",
        "permissions": [
          "配置和管理部署环境",
          "管理SSH密钥",
          "配置远程服务器连接信息",
          "测试连接有效性",
          "查看部署记录"
        ]
      },
      {
        "name": "技术经理",
        "permissions": [
          "创建/编辑/删除项目",
          "管理项目成员",
          "查看所有项目部署状态",
          "审计部署历史"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 服务化设计",
    "description": "系统采用经典的分层架构，表现层通过API网关与后端服务通信，服务层各服务职责单一、相互协作以完成部署编排，数据统一由关系型数据库持久化存储。API网关作为统一入口负责鉴权路由，服务层内部通过REST接口或消息队列异步通信，实现解耦与可扩展性。",
    "layers": [
      {
        "name": "表现层",
        "components": ["Web Console"]
      },
      {
        "name": "网关层",
        "components": ["API Gateway"]
      },
      {
        "name": "服务层",
        "components": [
          "Project Management Service",
          "Environment Management Service",
          "Deployment Orchestrator",
          "SSH Execution Service",
          "Key Management Service",
          "Audit Service",
          "File Storage"
        ]
      },
      {
        "name": "持久化层",
        "components": ["Primary Database"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "HTTPS/REST + AMQP"
      },
      {
        "protocol": "TCP/SQL"
      }
    ],
    "features": [
      "前后端分离，B/S架构",
      "RESTful API统一接口设计",
      "API网关统一鉴权与路由",
      "SSH安全连接远程执行",
      "SSH密钥加密存储",
      "异步部署执行与状态跟踪",
      "全操作审计日志追溯",
      "多项目数据完全隔离"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL",
    "cache": "Redis",
    "mq": "RabbitMQ"
  },
  "components": [
    {
      "name": "Web Console",
      "type": "frontend",
      "description": "用户交互界面，提供项目管理、环境管理、部署操作的可视化操作界面",
      "responsibilities": [
        "提供项目CRUD界面",
        "提供环境配置界面",
        "提供部署操作界面",
        "展示部署日志和状态",
        "密钥管理界面",
        "审计日志查询界面"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "系统统一API入口，负责请求路由、认证鉴权、请求限流",
      "responsibilities": [
        "请求路由分发",
        "用户身份认证",
        "接口权限校验",
        "请求限流与防护"
      ]
    },
    {
      "name": "Project Management Service",
      "type": "service",
      "description": "项目管理服务，负责项目的创建、编辑、删除和查询，实现多项目数据隔离",
      "responsibilities": [
        "项目CRUD操作",
        "项目环境关联管理",
        "项目列表查询与搜索",
        "项目间数据隔离"
      ]
    },
    {
      "name": "Environment Management Service",
      "type": "service",
      "description": "环境管理服务，负责部署环境的配置和管理，支持多套环境独立配置",
      "responsibilities": [
        "环境CRUD操作",
        "服务器连接信息配置",
        "环境标签和备注管理",
        "连接测试验证"
      ]
    },
    {
      "name": "Deployment Orchestrator",
      "type": "service",
      "description": "核心部署编排服务，协调文件传输、目录创建、脚本生成等部署流程，管理部署状态",
      "responsibilities": [
        "部署流程编排",
        "文件传输调度",
        "版本目录自动创建",
        "执行脚本自动生成",
        "部署状态跟踪和日志记录"
      ]
    },
    {
      "name": "SSH Execution Service",
      "type": "service",
      "description": "SSH远程执行服务，负责与远程服务器建立安全连接并执行命令和文件传输",
      "responsibilities": [
        "SSH连接管理",
        "远程命令执行",
        "文件传输(SFTP/SCP)",
        "连接超时与重试管理",
        "连接测试"
      ]
    },
    {
      "name": "Key Management Service",
      "type": "service",
      "description": "密钥管理服务，负责SSH密钥对的导入、存储和管理，确保密钥信息安全",
      "responsibilities": [
        "SSH密钥对生成",
        "密钥导入和导出",
        "密钥加密存储",
        "密钥与环境的关联管理"
      ]
    },
    {
      "name": "Audit Service",
      "type": "service",
      "description": "审计日志服务，记录所有部署操作和环境变更操作，提供可追溯的审计能力",
      "responsibilities": [
        "部署操作日志记录",
        "环境配置变更记录",
        "审计日志查询",
        "操作时间线追溯"
      ]
    },
    {
      "name": "Primary Database",
      "type": "db",
      "description": "系统主数据库PostgreSQL，持久化存储项目、环境、部署记录等核心业务数据",
      "responsibilities": [
        "项目数据存储",
        "环境配置存储",
        "部署记录存储",
        "审计日志存储",
        "用户数据存储",
        "SSH密钥元数据存储"
      ]
    },
    {
      "name": "File Storage",
      "type": "service",
      "description": "文件存储服务，管理上传的部署包文件，支持版本化和归档",
      "responsibilities": [
        "部署文件上传",
        "部署文件版本管理",
        "文件归档与清理"
      ]
    }
  ],
