  "architecture_decisions": [
    {
      "id": "AD-001",
      "decision": "采用微服务架构而非单体架构",
      "context": "系统需要多项目隔离、未来功能扩展（如多种部署策略）、以及高可用和独立部署能力。",
      "options": [
        "单体架构",
        "微服务架构"
      ],
      "chosen": "微服务架构",
      "rationale": "微服务提供更好的隔离性和可扩展性，允许部署执行服务独立扩缩容，也便于未来引入新语言或框架。虽然增加了分布式复杂度，但通过API网关和服务网格化可得到有效管理。",
      "implications": "需要引入服务发现、负载均衡、熔断和分布式追踪等机制；数据库按服务拆分可能存在分布式事务需求，但本系统服务间数据关联性不强，采用最终一致性即可。"
    },
    {
      "id": "AD-002",
      "decision": "使用PostgreSQL作为主数据库",
      "context": "需要存储项目、环境、部署记录等结构化关系数据，并保障事务一致性和查询能力。",
      "options": [
        "PostgreSQL",
        "MySQL",
        "MongoDB"
      ],
      "chosen": "PostgreSQL",
      "rationale": "关系型数据库适合本项目高度结构化且存在多表关联（如项目-环境-密钥-部署记录）的数据模型。PostgreSQL提供完善的ACID事务、JSON支持、丰富索引和成熟的语法，是保障数据一致性的坚实选择。",
      "implications": "开发团队需具备关系型数据库设计和优化能力。"
    },
    {
      "id": "AD-003",
      "decision": "引入RabbitMQ作为消息队列实现异步日志处理",
      "context": "部署过程会产生大量实时日志，若同步写入数据库会阻塞部署主流程，影响用户体验和系统吞吐量。",
      "options": [
        "直接写入数据库",
        "使用Redis List",
        "使用Kafka/RabbitMQ消息队列"
      ],
      "chosen": "RabbitMQ",
      "rationale": "消息队列天然解耦日志生产与消费。RabbitMQ相对于Kafka更轻量，易于部署和维护，且其推送模式和确认机制非常适合此类实时性要求较高的日志处理场景。",
      "implications": "需管理RabbitMQ集群的可用性，并处理消息重复和消费者异常。"
    },
    {
      "id": "AD-004",
      "decision": "对象存储使用MinIO，支持本地部署",
      "context": "需暂存用户上传的待部署文件，避免后端服务内存膨胀，并支持文件断点续传。",
      "options": [
        "本地文件系统",
        "云端对象存储(AWS S3等)",
        "MinIO"
      ],
      "chosen": "MinIO",
      "rationale": "MinIO是S3兼容的自托管对象存储，既能满足文件暂存需求，又能在私有化部署环境中运行，控制数据主权。它提供分片上传、生命周期管理等高级特性，实施成本低。",
      "implications": "需规划MinIO的容量和备份策略，如需后续扩展至云环境，因兼容S3可平滑迁移。"
    }
  ],
  "risks": [
    {
      "id": "RSK-001",
      "description": "分布式事务风险：当部署失败需要回滚时，可能涉及删除远程目录（成功）和更新部署记录状态（失败），导致远程资源与数据库状态不一致。",
      "severity": "中",
      "mitigation": "实现基于补偿的回滚机制，部署记录状态更新为重试或人工介入状态；引入Saga模式或事务性发件箱保证最终一致性。"
    },
    {
      "id": "RSK-002",
      "description": "SSH连接可靠性风险：网络抖动、服务器重启等可能导致正在执行的SSH会话中断，部署任务挂起。",
      "severity": "高",
      "mitigation": "部署服务实现超时机制和心跳检测；支持任务自动重试和手动重试；对于长时间任务，考虑使用类似于screen的会话保活技术。"
    },
    {
      "id": "RSK-003",
      "description": "密钥安全管理风险：内存解密密钥若被进程dump或被恶意软件窃取，可能导致私钥泄露。",
      "severity": "高",
      "mitigation": "严格的服务器访问控制；密钥管理服务运行在最小权限的隔离环境（如容器）；审计所有访问密钥的API调用；考虑未来集成硬件安全模块(HSM)或密钥管理服务(KMS)。"
    }
  ],
