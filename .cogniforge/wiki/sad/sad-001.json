  "architecture_decisions": [
    {
      "decision": "使用 WebSocket 传递实时日志",
      "rationale": "提升实时性，减少前端轮询压力，与部署执行流程自然结合"
    },
    {
      "decision": "私钥在应用层加密，内存中解密",
      "rationale": "密钥只存在于内存，不落盘，满足安全合规要求"
    },
    {
      "decision": "部署任务采用事件驱动（Redis Pub/Sub）",
      "rationale": "解耦 API 层与执行层，支持多实例并行处理和横向扩展"
    },
    {
      "decision": "文件存储独立，使用 MinIO",
      "rationale": "解耦文件与数据库，方便扩展和后续对接云存储"
    }
  ],
  "risks": [
    {
      "risk": "网络不稳定导致 SSH 连接中断",
      "impact": "部署失败，可能导致服务器目录残留",
      "mitigation": "增加重试机制、超时控制和回滚清理脚本"
    },
    {
      "risk": "大文件上传可能引起前端卡顿或后端资源耗尽",
      "impact": "用户体验差，部署搁浅",
      "mitigation": "前端切片上传、后端限制并发上传数，后续引入断点续传"
    },
    {
      "risk": "高并发 SSH 连接可能耗尽服务器资源",
      "impact": "部署延迟或失败",
      "mitigation": "引入连接池或限制单实例并发部署数，初期按需创建连接"
    }
  ],
  "open_questions": [
    "是否需要引入独立日志收集系统（如 ELK）用于长期存储和分析？",
    "回滚操作是否需要审批流程？当前设计为跳转确认后直接部署。",
    "分布式部署执行器的任务持久化与容错机制如何设计？（如 Redis 队列丢失）"
  ]
