    "version": 1
  },
  "system_overview": {
    "description": "本产品是一款面向开发团队的桌面端自动化部署工具，采用前后端分离的本地进程架构。前端基于Electron+React构建，后端为Python FastAPI本地服务，通过HTTP REST与WebSocket通信。系统支持项目隔离管理、多环境安全配置、一键SSH部署、版本历史与回滚，保障密钥加密存储。",
    "roles": [
      {
        "name": "项目负责人",
        "permissions": [
          "创建/编辑/删除项目",
          "配置所有环境",
          "执行部署到任意环境",
          "查看部署历史与日志",
          "执行版本回滚"
        ]
      },
      {
        "name": "开发者",
        "permissions": [
          "查看项目列表",
          "切换当前项目",
          "查看环境配置",
          "执行部署到指定环境",
          "查看部署历史与日志"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "管理所有环境配置（含生产密钥）",
          "设置版本保留策略",
          "执行部署与回滚",
          "测试环境连接"
        ]
      },
      {
        "name": "项目组全员",
        "permissions": [
          "查看项目列表",
          "切换当前项目",
          "查看部署历史（只读）"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 事件驱动",
    "description": "系统分为展示层（Electron+React）、网关层（Node.js Express）、服务层（Python FastAPI）和数据层（SQLite+文件系统）。网关层负责请求路由和WebSocket管理；服务层以异步任务执行部署操作；前端通过REST获取数据，通过WebSocket接收实时日志。",
    "layers": [
      {
        "name": "展示层",
        "components": [
          "项目列表与切换组件",
          "项目编辑对话框组件",
          "环境列表与配置组件",
          "环境连接测试组件",
          "部署任务发起组件",
          "实时日志与控制台组件",
          "部署历史与回滚组件",
          "主密码管理组件"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API路由代理",
          "WebSocket管理服务"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "项目管理服务",
          "环境配置服务",
          "部署执行服务",
          "版本历史服务",
          "凭证加密存储服务",
          "SSH/SFTP连接管理器"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "SQLite数据库",
          "文件存储（密钥、日志缓存）"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST",
        "description": "前端通过网关层代理调用后端REST API获取和提交数据"
      },
      {
        "protocol": "WebSocket",
        "description": "前端与网关层建立WebSocket连接，接收部署实时日志推送"
      },
      {
        "protocol": "内部HTTP",
        "description": "网关层将请求转发至后端FastAPI服务"
      },
      {
        "protocol": "ORM / SQL",
        "description": "服务层通过SQLAlchemy访问SQLite数据库"
      },
      {
        "protocol": "SSH / SFTP",
        "description": "后端服务通过paramiko库与远程服务器建立安全连接，执行部署命令和文件传输"
      }
    ],
    "features": [
      "前后端分离，本地HTTP服务通信",
      "异步任务队列实现非阻塞部署",
      "WebSocket实时日志推送",
      "密钥本地加密存储，支持主密码解锁",
      "多项目隔离，环境配置独立",
      "版本化部署与一键回滚",
      "Electron桌面壳集成前后端运行环境"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design"
    },
    "gateway": "Node.js + Express",
    "database": "SQLite",
    "orm": "SQLAlchemy",
    "ssh_library": "paramiko",
    "encryption": "cryptography (PBKDF2密钥派生)",
    "packaging": "Electron Builder + PyInstaller"
  },
