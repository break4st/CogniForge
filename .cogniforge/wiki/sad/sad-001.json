{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "一键自动化部署系统 — 系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-21 16:53"
  },
  "system_overview": {
    "description": "一键自动化部署系统是一个基于 Web 的自动化部署管理平台，采用前后端分离的分层架构。系统通过 SSH 协议实现与远程服务器的安全通信，支持多项目并行管理、多环境（测试/灰度/正式）独立配置、SSH 密钥加密存储与验证，以及一键触发的全自动化部署流程。部署时系统自动将可执行文件上传至远程服务器，创建版本化部署目录，生成启动/停止/重启脚本，并提供部署日志实时流式推送与一键回滚能力。",
    "roles": [
      {
        "name": "系统管理员",
        "permissions": [
          "全部项目管理权限",
          "全部环境管理权限",
          "全部密钥管理权限",
          "全部部署操作权限",
          "系统配置管理",
          "操作审计日志查看"
        ]
      },
      {
        "name": "运维工程师",
        "permissions": [
          "创建/编辑/删除项目",
          "配置和管理部署环境",
          "管理 SSH 密钥",
          "执行部署与回滚操作",
          "查看部署日志和状态"
        ]
      },
      {
        "name": "开发工程师",
        "permissions": [
          "查看项目列表和详情",
          "查看部署环境信息",
          "触发部署任务",
          "查看部署日志"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建和管理项目",
          "查看所有环境和部署状态",
          "查看操作审计日志",
          "无法操作密钥和部署执行"
        ]
      }
    ]
  },
  "architecture": {
    "style": "前后端分离的分层架构（Layered Architecture）",
    "description": "系统采用前后端分离架构，前端为单页应用（SPA），后端按业务领域划分为多个模块化服务。层间通过定义良好的 REST API 契约通信，保证各层可独立演进。SSH 密钥通过 AES-256 加密存储，部署日志通过 WebSocket 实时推送到前端。",
    "layers": [
      {
        "name": "展示层（Presentation Layer）",
        "components": ["Web 控制台"]
      },
      {
        "name": "接入层（Gateway Layer）",
        "components": ["API 网关", "认证中间件"]
      },
      {
        "name": "业务层（Business Layer）",
        "components": ["项目管理服务", "环境管理服务", "SSH 密钥管理服务", "部署编排服务", "审计日志服务"]
      },
      {
        "name": "持久层（Data Layer）",
        "components": ["项目数据库", "文件存储"]
      },
      {
        "name": "基础设施层（Infrastructure Layer）",
        "components": ["SSH 连接池", "远程执行引擎"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST",
        "description": "展示层与接入层之间：浏览器通过 HTTPS 发起 REST API 调用，经 API 网关统一路由"
      },
      {
        "protocol": "REST / WebSocket",
        "description": "接入层与业务层之间：API 网关将 REST 请求转发至对应业务服务；部署日志经 WebSocket 实时推送"
      },
      {
        "protocol": "SQL / 文件 I/O",
        "description": "业务层与持久层之间：业务服务通过 ORM 操作关系型数据库，部署包文件读写文件存储"
      },
      {
        "protocol": "SSH / SCP / SFTP",
        "description": "持久层与基础设施层之间：远程执行引擎通过 SSH 连接池在目标服务器上执行命令与文件传输"
      }
    ],
    "features": [
      "模块化分层，业务内聚低耦合",
      "RESTful API 统一接口规范",
      "SSH 密钥 AES-256 加密持久化",
      "部署日志 WebSocket 实时推送",
      "服务无状态设计，支持水平扩展",
      "操作全链路审计追踪",
      "版本化部署目录，一键无损回滚",
      "多项目数据严格隔离"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI",
      "async_support": "asyncio + Uvicorn",
      "orm": "SQLAlchemy 2.0 + Alembic",
      "auth": "PyJWT"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus",
      "build_tool": "Vite",
      "state_management": "Pinia",
      "websocket_client": "原生 WebSocket API"
    },
    "database": "PostgreSQL 15+",
    "cache": "Redis 7+",
    "message_queue": "无（采用 WebSocket 直推，不引入 MQ）",
    "ssh_library": "AsyncSSH",
    "file_storage": "本地文件系统 / 对象存储（MinIO）",
    "deployment": "Docker + Docker Compose"
  },
  "components": [
    {
      "name": "Web 控制台",
      "type": "frontend",
      "description": "基于 Vue 3 的浏览器端单页应用，提供项目看板、环境配置、密钥管理、部署操作和日志展示的图形化界面。",
      "responsibilities": [
        "项目列表展示与 CRUD 操作交互",
        "多环境配置表单与展示",
        "SSH 密钥管理界面",
        "一键部署触发与进度展示",
        "部署日志实时滚动展示",
        "项目间快速切换"
      ]
    },
    {
      "name": "API 网关",
      "type": "gateway",
      "description": "系统的统一入口，负责请求路由、身份认证、限流和日志记录。",
      "responsibilities": [
        "请求路由分发到对应业务服务",
        "JWT token 鉴权与校验",
        "接口调用频率限制",
        "请求/响应日志记录",
        "统一错误处理"
      ]
    },
    {
      "name": "认证中间件",
      "type": "gateway",
      "description": "基于 JWT 的用户身份认证与角色权限控制组件。",
      "responsibilities": [
        "用户登录与 Token 签发",
        "Token 刷新与过期管理",
        "基于角色的路由权限控制",
        "会话状态维护"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "处理项目的创建、编辑、删除、查询等业务逻辑，维护项目间的数据隔离。",
      "responsibilities": [
        "项目创建与参数校验",
        "项目信息编辑与更新",
        "项目删除（级联环境与部署记录）",
        "项目列表分页查询",
        "项目数据隔离保证"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理每个项目下的多套部署环境配置，包括测试、灰度、正式等环境。",
      "responsibilities": [
        "环境配置的增删改查",
        "环境参数（地址/端口/路径）校验",
        "环境与项目的关联管理",
        "部署目标环境选择"
      ]
    },
    {
      "name": "SSH 密钥管理服务",
      "type": "service",
      "description": "负责 SSH 密钥的添加、删除、加密存储和有效性验证。",
      "responsibilities": [
        "SSH 密钥上传与解析",
        "密钥 AES-256 加密存储",
        "密钥删除与轮换",
        "密钥连接有效性验证",
        "部署时密钥安全获取"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "部署流程的核心编排引擎，协调上传、目录创建、脚本生成和执行等步骤。",
      "responsibilities": [
        "接收部署请求并校验参数",
        "生成全局唯一版本号",
        "编排上传→创建目录→生成脚本→启动服务的全流程",
        "实时采集和推送部署日志",
        "支持部署回滚操作",
        "维护部署状态和结果记录"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录系统中所有用户操作，提供操作追溯和审计能力。",
      "responsibilities": [
        "记录用户关键操作事件",
        "记录操作时间、IP、操作详情",
        "审计日志持久化存储",
        "审计日志查询和导出"
      ]
    },
    {
      "name": "项目数据库",
      "type": "db",
      "description": "PostgreSQL 关系型数据库，存储项目信息、环境配置、部署记录和审计日志等结构化数据。密钥密文也存储于此。",
      "responsibilities": [
        "项目表：存储项目名称、描述、创建时间等",
        "环境表：存储服务器地址、端口、部署路径等",
        "密钥表：存储加密后的 SSH 密钥和元信息",
        "部署记录表：存储每次部署的版本、状态、结果",
        "审计日志表：存储操作审计记录"
      ]
    },
    {
      "name": "文件存储",
      "type": "db",
      "description": "本地文件系统或 MinIO 对象存储，用于暂存用户上传的可执行部署包。",
      "responsibilities": [
        "部署包文件的临时存储与管理",
        "文件与部署记录的关联",
        "定期清理历史部署包"
      ]
    },
    {
      "name": "SSH 连接池",
      "type": "service",
      "description": "管理与远程服务器的 SSH 连接，复用连接以减少握手开销。",
      "responsibilities": [
        "SSH 连接的创建与复用",
        "连接健康检测与自动重连",
        "连接池大小管理与回收",
        "超时控制与错误处理"
      ]
    },
    {
      "name": "远程执行引擎",
      "type": "service",
      "description": "在远程服务器上执行命令和脚本的核心执行组件，负责文件传输和命令执行。",
      "responsibilities": [
        "通过 SCP/SFTP 上传部署包",
        "在远程端创建版本目录",
        "远程执行 Shell 脚本（启动/停止/重启）",
        "实时捕获远程命令输出流",
        "远程命令执行超时与异常处理"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "用户认证接口",
      "provider": "认证中间件",
      "consumers": ["Web 控制台"],
      "type": "REST",
      "endpoint": "POST /api/auth/login",
      "request": {
        "body": {
          "username": "string",
          "password": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "access_token": "string (JWT)",
          "refresh_token": "string (JWT)",
          "token_type": "string",
          "expires_in": "int (seconds)"
        }
      },
      "description": "用户登录认证，签发 JWT access_token 和 refresh_token"
    },
    {
      "interface": "Token 刷新接口",
      "provider": "认证中间件",
      "consumers": ["Web 控制台"],
      "type": "REST",
      "endpoint": "POST /api/auth/refresh",
      "request": {
        "body": {
          "refresh_token": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "access_token": "string (JWT)",
          "expires_in": "int (seconds)"
        }
      },
      "description": "使用 refresh_token 获取新的 access_token"
    },
    {
      "interface": "项目管理接口",
      "provider": "项目管理服务",
      "consumers": ["API 网关", "Web 控制台"],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/projects[/:id]",
      "request": {
        "path_params": [
          {"name": "id", "type": "int", "description": "项目 ID（查询/编辑/删除时需要）"}
        ],
        "query_params": [
          {"name": "page", "type": "int", "description": "页码，默认 1"},
          {"name": "page_size", "type": "int", "description": "每页条数，默认 20"}
        ],
        "body": {
          "name": "string (必需，创建/编辑时)",
          "description": "string (可选)",
          "status": "string (可选，编辑时)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "name": "string",
          "description": "string",
          "environments_count": "int",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "description": "项目的增删改查操作，支持分页查询"
    },
    {
      "interface": "环境管理接口",
      "provider": "环境管理服务",
      "consumers": ["API 网关", "Web 控制台"],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/projects/:pid/environments[/:eid]",
      "request": {
        "path_params": [
          {"name": "pid", "type": "int", "description": "项目 ID"},
          {"name": "eid", "type": "int", "description": "环境 ID（查询/编辑/删除时需要）"}
        ],
        "body": {
          "name": "string (必需，如测试线/灰度线/正式线)",
          "host": "string (必需，服务器地址)",
          "port": "int (必需，SSH 端口，默认 22)",
          "deploy_path": "string (必需，部署路径)",
          "description": "string (可选)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "project_id": "int",
          "name": "string",
          "host": "string",
          "port": "int",
          "deploy_path": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "description": "项目下部署环境的增删改查操作"
    },
    {
      "interface": "SSH 密钥管理接口",
      "provider": "SSH 密钥管理服务",
      "consumers": ["API 网关", "Web 控制台", "部署编排服务"],
      "type": "REST",
      "endpoint": "POST/GET/DELETE /api/ssh-keys[/:id]",
      "request": {
        "path_params": [
          {"name": "id", "type": "int", "description": "密钥 ID"}
        ],
        "body": {
          "name": "string (必需，密钥名称)",
          "private_key": "string (必需，上传时，PEM 格式私钥内容)",
          "passphrase": "string (可选，密钥口令)",
          "project_id": "int (可选，关联项目)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "name": "string",
          "fingerprint": "string (SHA256 指纹，不含明文)",
          "project_id": "int",
          "created_at": "datetime"
        }
      },
      "description": "SSH 密钥的创建（上传）、查询、删除管理"
    },
    {
      "interface": "密钥验证接口",
      "provider": "SSH 密钥管理服务",
      "consumers": ["API 网关", "Web 控制台"],
      "type": "REST",
      "endpoint": "POST /api/ssh-keys/:id/verify",
      "request": {
        "path_params": [
          {"name": "id", "type": "int", "description": "密钥 ID"}
        ],
        "body": {
          "host": "string (必需，目标服务器地址)",
          "port": "int (必需，SSH 端口)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "bool",
          "message": "string"
        }
      },
      "description": "验证 SSH 密钥与目标服务器的连接有效性"
    },
    {
      "interface": "一键部署接口",
      "provider": "部署编排服务",
      "consumers": ["API 网关", "Web 控制台"],
      "type": "REST",
      "endpoint": "POST /api/deploy",
      "request": {
        "body": {
          "project_id": "int (必需)",
          "environment_id": "int (必需)",
          "ssh_key_id": "int (必需)",
          "file_path": "string (必需，部署包路径或上传文件)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "deploy_id": "int",
          "version": "string (生成的版本号，如 v20260521-001)",
          "status": "string (pending)",
          "message": "string"
        }
      },
      "description": "触发一键自动化部署任务，返回部署 ID 和版本号"
    },
    {
      "interface": "部署历史查询接口",
      "provider": "部署编排服务",
      "consumers": ["API 网关", "Web 控制台"],
      "type": "REST",
      "endpoint": "GET /api/deploy[/:id]",
      "request": {
        "path_params": [
          {"name": "id", "type": "int", "description": "部署记录 ID（查询单条时）"}
        ],
        "query_params": [
          {"name": "project_id", "type": "int", "description": "按项目筛选"},
          {"name": "environment_id", "type": "int", "description": "按环境筛选"},
          {"name": "page", "type": "int", "description": "页码"},
          {"name": "page_size", "type": "int", "description": "每页条数"}
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "project_id": "int",
          "environment_id": "int",
          "version": "string",
          "file_name": "string",
          "status": "string (pending/running/success/failed)",
          "started_at": "datetime",
          "finished_at": "datetime"
        }
      },
      "description": "查询部署历史记录"
    },
    {
      "interface": "部署日志 WebSocket 接口",
      "provider": "部署编排服务",
      "consumers": ["Web 控制台"],
      "type": "WS",
      "endpoint": "WS /api/deploy/:id/logs",
      "request": {
        "path_params": [
          {"name": "id", "type": "int", "description": "部署记录 ID"}
        ]
      },
      "response": {
        "status": 101,
        "body": {
          "type": "string (log/status/error)",
          "timestamp": "datetime",
          "message": "string",
          "stream": "string (stdout/stderr)"
        }
      },
      "description": "通过 WebSocket 实时推送部署日志流，前端主动连接后持续接收"
    },
    {
      "interface": "部署回滚接口",
      "provider": "部署编排服务",
      "consumers": ["API 网关", "Web 控制台"],
      "type": "REST",
      "endpoint": "POST /api/deploy/:id/rollback",
      "request": {
        "path_params": [
          {"name": "id", "type": "int", "description": "要回滚到的部署记录 ID"}
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "deploy_id": "int",
          "version": "string (回滚目标版本号)",
          "status": "string (running)",
          "message": "string"
        }
      },
      "description": "回滚到指定历史部署版本"
    },
    {
      "interface": "审计日志查询接口",
      "provider": "审计日志服务",
      "consumers": ["API 网关", "Web 控制台"],
      "type": "REST",
      "endpoint": "GET /api/audit-logs",
      "request": {
        "query_params": [
          {"name": "user_id", "type": "int", "description": "按用户筛选"},
          {"name": "action", "type": "string", "description": "按操作类型筛选"},
          {"name": "start_time", "type": "datetime", "description": "起始时间"},
          {"name": "end_time", "type": "datetime", "description": "结束时间"},
          {"name": "page", "type": "int", "description": "页码"},
          {"name": "page_size", "type": "int", "description": "每页条数"}
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "id": "int",
              "user_id": "int",
              "username": "string",
              "action": "string",
              "resource_type": "string",
              "resource_id": "int",
              "detail": "string",
              "ip_address": "string",
              "created_at": "datetime"
            }
          ],
          "total": "int",
          "page": "int",
          "page_size": "int"
        }
      },
      "description": "查询操作审计日志，支持多维度筛选和分页"
    },
    {
      "interface": "内部密钥解密接口",
      "provider": "SSH 密钥管理服务",
      "consumers": ["部署编排服务"],
      "type": "REST",
