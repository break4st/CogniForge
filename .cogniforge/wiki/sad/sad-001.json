  "data_flow": [
    {
      "name": "一键部署主流程",
      "steps": [
        "1. 前端调用发起部署API（POST /deployments）",
        "2. 部署执行服务验证参数",
        "3. 部署执行服务请求项目与环境管理服务获取环境详细配置（内部调用）",
        "4. 部署执行服务请求SSH密钥管理服务解密私钥（内部调用）",
        "5. 部署执行服务通过SSH客户端库连接到远程主机",
        "6. 在远程创建版本文件夹",
        "7. 流式上传文件到版本文件夹",
        "8. 生成并上传start.sh/stop.sh脚本",
        "9. 如果auto_start为true，执行start.sh",
        "10. 更新软链接current指向新版本文件夹",
        "11. 通过SSE向前端推送实时日志",
        "12. 调用部署历史服务记录部署信息"
      ]
    },
    {
      "name": "项目切换与上下文刷新",
      "steps": [
        "1. 用户在前端选择新项目",
        "2. 前端存储当前项目ID到状态/localStorage",
        "3. 前端使用新项目ID请求环境列表API",
        "4. 前端使用新项目ID请求部署历史列表API",
        "5. 界面更新显示新项目的数据"
      ]
    },
    {
      "name": "SSH连接测试",
      "steps": [
        "1. 前端调用测试连接API",
        "2. SSH密钥管理服务从数据库获取环境配置和加密私钥",
        "3. 解密私钥",
        "4. 尝试建立SSH连接",
        "5. 返回连接结果"
      ]
    }
  ],
