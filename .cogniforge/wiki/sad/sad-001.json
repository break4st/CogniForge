  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户在 UI 拖拽文件并选择环境，点击部署",
        "UI 通过 IPC 调用 Deployment Engine (startDeploy)",
        "Deployment Engine 检查环境连通性（通过 Environment Manager）",
        "调用 Security Module 解密目标环境的私钥",
        "使用 SSH Service 建立连接并执行 SFTP 上传文件、创建版本文件夹",
        "SSH Service 返回每个步骤的结果，Deployment Engine 推送进度事件到 UI",
        "文件传输完成后，Deployment Engine 调用 SSH Service 执行 shell 命令生成 deploy.sh 脚本并赋予可执行权限",
        "部署成功后，Deployment Engine 调用 History & Rollback Service 保存记录",
        "UI 接收最终成功事件并通知用户"
      ]
    },
    {
      "name": "环境连通性测试",
      "steps": [
        "用户在 UI 点击“测试连接”",
        "UI 调用 Environment Manager 的 testConnection IPC",
        "Environment Manager 获取该环境的加密私钥，调用 Security Module 解密",
        "调用 SSH Service 尝试连接并执行简单命令（如 echo ok）",
        "SSH Service 返回成功/失败，Environment Manager 通过 IPC 将结果返回 UI 展示"
      ]
    },
    {
      "name": "部署回滚",
      "steps": [
        "用户在历史页面选择某条历史记录，点击“回滚”",
        "UI 调用 History & Rollback Service 的 rollback IPC",
        "Service 根据历史记录找到远程 version 文件夹路径和 deploy.sh",
        "通过 Security Module 解密对应环境的私钥",
        "调用 SSH Service 执行回滚命令（执行 deploy.sh）",
        "执行成功后将此次回滚记录为新的特殊历史条目"
      ]
    }
  ],
