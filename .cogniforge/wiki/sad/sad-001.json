{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署管理系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-22 09:02"
  },
  "system_overview": {
    "description": "自动化部署管理系统是一个基于Web的企业级部署平台，支持将打包好的可执行文件自动化部署到指定远程服务器。系统采用前后端分离的BFF架构模式，后端以服务化方式组织业务逻辑，通过SSH协议与远程服务器安全通信。支持多项目管理、多环境配置（测试线、灰度线、正式线）、SSH密钥安全认证、版本自动管理与执行脚本生成，实现一键式自动化部署全流程。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "查看项目列表和环境状态",
          "选择目标环境和版本执行部署",
          "查看部署进度和结果",
          "查看已部署版本列表和历史记录",
          "测试环境SSH连接状态"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、删除部署环境",
          "配置环境连接参数",
          "为环境分配项目",
          "管理项目成员权限"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "创建和管理项目",
          "上传可执行文件/选择部署版本",
          "在项目间切换查看",
          "查看部署日志"
        ]
      },
      {
        "name": "安全管理员",
        "permissions": [
          "配置和管理SSH密钥对",
          "管理密钥与环境的绑定关系",
          "查看安全审计日志",
          "吊销或轮换密钥"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + BFF模式 + 服务化后端",
    "description": "系统采用前后端分离架构，前端为单页应用（SPA），后端通过BFF层为前端提供聚合接口。核心业务逻辑划分为多个职责单一的服务模块，通过依赖注入和事件驱动方式协作。与远程服务器的通信通过SSH连接池统一管理，确保连接复用和资源控制。密钥等敏感信息通过独立的密钥管理服务进行加解密存储，数据层使用PostgreSQL持久化业务数据与文件制品。",
    "layers": [
      {
        "name": "展示层",
        "components": [
          "Web控制台"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API网关"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署编排服务",
          "SSH连接池服务",
          "密钥管理服务"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL数据库",
          "文件存储"
        ]
      },
      {
        "name": "远程执行层",
        "components": [
          "目标远程服务器集群"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTP/REST + WebSocket - 展示层与网关层通信"
      },
      {
        "protocol": "gRPC - 网关层与业务服务层内部调用"
      },
      {
        "protocol": "SQL/ORM - 业务服务层与数据层持久化交互"
      },
      {
        "protocol": "SSH/SCP/SFTP - 业务服务层与远程执行层文件传输和命令执行"
      }
    ],
    "features": [
      "多项目与多环境隔离：每个项目拥有独立的部署环境配置集合，环境间完全隔离",
      "安全密钥管理：SSH密钥AES-256加密存储，密钥与环境绑定，支持密钥轮换与吊销",
      "异步部署执行：部署任务异步执行，前端通过WebSocket获取实时进度和日志流",
      "版本追溯：自动按版本号创建远程目录结构，保留历史版本支持回溯和回滚",
      "连接池复用：SSH连接池统一管理复用，减少频繁建连开销，支持健康检测与断线重连",
      "部署可视化：全流程步骤状态实时展示，日志流式输出"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design"
    },
    "database": "PostgreSQL",
    "cache": "Redis",
    "mq": "无（服务间采用gRPC同步调用，异步通过协程内事件驱动）",
    "protocol": {
      "api": "REST (前端 ↔ BFF) / gRPC (服务间)",
      "realtime": "WebSocket (部署状态推送)",
      "remote_access": "SSH/SCP/SFTP (远程服务器通信)"
    },
    "security": {
      "encryption": "AES-256 (密钥加密存储)",
      "auth": "JWT + RBAC (身份认证与权限控制)"
    }
  },
  "components": [
    {
      "name": "Web控制台",
      "type": "frontend",
      "description": "基于React的浏览器端单页应用，提供项目、环境、部署全流程的可视化操作界面",
      "responsibilities": [
        "项目CRUD操作界面和项目切换",
        "多环境配置管理界面（增删改查）",
        "SSH密钥上传和管理界面",
        "部署操作入口（选择环境 + 版本 -> 执行部署）",
        "部署进度实时展示和结果通知",
        "已部署版本列表和历史查看"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "系统的统一入口网关，负责请求路由、身份认证、权限校验和请求限流",
      "responsibilities": [
        "前端请求的路由分发",
        "用户身份认证与会话管理",
        "基于角色的接口访问控制（RBAC）",
        "请求速率限制和防滥用",
        "WebSocket连接管理"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "管理系统的核心业务实体——项目，包括项目创建、配置、状态管理和项目间切换",
      "responsibilities": [
        "项目的创建、更新、删除和查询",
        "项目配置的读写（项目级设置）",
        "项目与环境的关联管理",
        "项目间切换的数据隔离"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理部署环境的配置，包括连接参数、关联密钥和状态检测",
      "responsibilities": [
        "部署环境的CRUD操作",
        "环境连接参数配置（主机、端口、用户等）",
        "环境与SSH密钥的绑定管理",
        "环境连接测试（连通性检测）"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "部署任务的核心编排引擎，负责执行部署的完整工作流：传输文件 -> 创建目录 -> 生成脚本 -> 执行命令",
      "responsibilities": [
        "接收并校验部署请求",
        "协调部署工作流中各步骤的执行",
        "在远程服务器创建版本目录结构",
        "通过SSH传输可执行文件到远程服务器",
        "在远程服务器生成启动/停止等执行脚本",
        "收集并返回部署执行结果和日志",
        "记录部署历史用于版本追溯"
      ]
    },
    {
      "name": "SSH连接池服务",
      "type": "service",
      "description": "管理到远程服务器的SSH连接，提供连接复用、健康检测和并发控制",
      "responsibilities": [
        "SSH连接的创建、复用和回收",
        "连接池大小控制和资源管理",
        "SSH连接健康心跳检测",
        "断线自动重连机制",
        "并发连接数限制"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "SSH密钥的加密存储、生命周期管理和安全审计",
      "responsibilities": [
        "SSH密钥的AES-256加密存储",
        "密钥的上传、更新、吊销和删除",
        "密钥与环境的绑定关系管理",
        "密钥使用审计日志",
        "密钥格式校验和指纹计算"
      ]
    },
    {
      "name": "PostgreSQL数据库",
      "type": "database",
      "description": "系统的主数据库，存储项目、环境、部署记录、密钥等所有结构化业务数据",
      "responsibilities": [
        "项目、环境、密钥等实体数据的持久化",
        "部署历史记录和日志的存储",
        "事务性数据的一致性和完整性保障",
        "历史数据的查询和归档支持"
      ]
    },
    {
      "name": "文件存储",
      "type": "infrastructure",
      "description": "管理部署所需的可执行文件的存储和版本化",
      "responsibilities": [
        "可执行文件的上传和下载",
        "文件版本管理（同一文件多版本共存）",
        "文件的完整性校验（MD5/SHA256）"
      ]
    },
    {
      "name": "目标远程服务器集群",
      "type": "infrastructure",
      "description": "由多台远程Linux服务器组成的集群，是部署任务最终的执行目标",
      "responsibilities": [
        "接收SSH/SCP/SFTP连接请求",
        "接收可执行文件并持久化到文件系统",
        "执行启动/停止/状态检查脚本",
        "返回命令执行结果和日志输出"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "DeployService.ExecuteDeploy",
      "provider": "部署编排服务",
      "consumers": [
        "API网关"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/deploys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string (UUID，目标项目)",
          "environment_id": "string (UUID，目标环境)",
          "version": "string (部署版本号)",
          "file_id": "string (UUID，可执行文件ID)"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deploy_id": "string (UUID，部署任务ID)",
          "status": "string (PENDING/RUNNING/SUCCESS/FAILED)",
          "created_at": "string (ISO datetime)"
        }
      },
      "description": "发起一键部署任务，异步执行，返回任务ID后前端通过WebSocket轮询状态"
    },
    {
      "interface": "DeployService.GetDeployStatus",
      "provider": "部署编排服务",
      "consumers": [
        "API网关"
      ],
      "type": "WebSocket",
      "endpoint": "WS /api/v1/deploys/{deploy_id}/status",
      "request": {
        "path_params": [
          {
            "name": "deploy_id",
            "type": "string (UUID)",
            "description": "部署任务ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "step": "string (当前步骤名)",
          "status": "string (RUNNING/SUCCESS/FAILED)",
          "progress": "number (0-100)",
          "log": "string (当前日志片段)",
          "timestamp": "string (ISO datetime)"
        }
      },
      "description": "通过WebSocket实时推送部署任务的各步骤状态和日志流"
    },
    {
      "interface": "ProjectService.CRUD",
      "provider": "项目管理服务",
      "consumers": [
        "API网关"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/projects[/{project_id}]",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "string (UUID)",
            "description": "项目ID（更新/删除时必填）"
          }
        ],
        "query_params": [
          {
            "name": "page",
            "type": "integer",
            "description": "分页页码"
          },
          {
            "name": "page_size",
            "type": "integer",
            "description": "每页数量"
          }
        ],
        "body": {
          "name": "string (项目名称，创建/更新时必填)",
          "description": "string (项目描述，可选)",
          "environments": "string[] (关联的环境ID列表，可选)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "description": "string",
          "environments": "array",
          "created_at": "string (ISO datetime)",
          "updated_at": "string (ISO datetime)"
        }
      },
      "description": "项目的创建、查询、更新和删除操作"
    },
    {
      "interface": "EnvironmentService.CRUD",
      "provider": "环境管理服务",
      "consumers": [
        "API网关"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/environments[/{environment_id}]",
      "request": {
        "path_params": [
          {
            "name": "environment_id",
            "type": "string (UUID)",
            "description": "环境ID（更新/删除时必填）"
          }
        ],
        "query_params": [
          {
            "name": "project_id",
            "type": "string (UUID)",
            "description": "按项目过滤"
          }
        ],
        "body": {
          "name": "string (环境名称，如 测试线/灰度线/正式线)",
          "host": "string (远程服务器主机名或IP)",
          "port": "integer (SSH端口，默认22)",
          "username": "string (SSH登录用户名)",
          "key_id": "string (UUID，关联的SSH密钥ID)",
          "project_id": "string (UUID，所属项目)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_id": "string (UUID)",
          "project_id": "string (UUID)",
          "status": "string (ONLINE/OFFLINE/UNKNOWN)",
          "created_at": "string (ISO datetime)"
        }
      },
      "description": "部署环境的创建、查询、更新和删除操作"
    },
    {
      "interface": "EnvironmentService.TestConnection",
      "provider": "环境管理服务",
      "consumers": [
        "API网关"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/environments/{environment_id}/test",
      "request": {
        "path_params": [
          {
            "name": "environment_id",
            "type": "string (UUID)",
            "description": "待测试的环境ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "reachable": "boolean",
          "latency_ms": "integer",
          "error": "string (连接失败时的错误信息，可选)"
        }
      },
      "description": "测试目标环境的SSH连接连通性"
    },
    {
      "interface": "SshPoolService.GetConnection",
      "provider": "SSH连接池服务",
      "consumers": [
        "部署编排服务"
      ],
      "type": "gRPC",
      "endpoint": "GetConnection(GetConnectionRequest) returns (GetConnectionResponse)",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_fingerprint": "string (密钥指纹，用于从密钥管理服务获取解密密钥)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "connection_id": "string (UUID，连接句柄)",
          "session_id": "string (会话标识)",
          "expires_at": "string (ISO datetime，连接超时时间)"
        }
      },
      "description": "从连接池获取一个到目标服务器的SSH连接句柄"
    },
    {
      "interface": "KeyService.GetDecryptedKey",
      "provider": "密钥管理服务",
      "consumers": [
        "SSH连接池服务"
      ],
      "type": "gRPC",
      "endpoint": "GetDecryptedKey(GetDecryptedKeyRequest) returns (GetDecryptedKeyResponse)",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "key_id": "string (UUID，密钥ID)",
          "requestor": "string (请求方服务标识)",
          "request_id": "string (UUID，用于审计追踪)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "private_key": "string (PEM格式解密后的私钥内容，内存中临时使用)",
          "key_type": "string (RSA/ECDSA/ED25519)",
          "fingerprint": "string (密钥指纹)"
        }
      },
      "description": "从数据库取出加密密钥，解密后返回明文私钥（仅在内存中使用，不落盘）"
    },
    {
      "interface": "KeyService.ManageKeys",
      "provider": "密钥管理服务",
      "consumers": [
        "API网关"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/keys[/{key_id}]",
      "request": {
        "path_params": [
          {
            "name": "key_id",
            "type": "string (UUID)",
            "description": "密钥ID（更新/删除时必填）"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string (密钥名称)",
          "public_key": "string (公钥内容，可选)",
          "private_key": "string (私钥内容)",
          "passphrase": "string (私钥密码，可选)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "fingerprint": "string (SHA256指纹)",
          "algorithm": "string (RSA/ECDSA/ED25519)",
          "bound_environments": "string[] (已绑定的环境ID列表)",
          "created_at": "string (ISO datetime)"
        }
      },
      "description": "SSH密钥的上传、查询、更新、吊销和删除管理操作"
    },
    {
      "interface": "DeployService.GetHistory",
      "provider": "部署编排服务",
      "consumers": [
        "API网关"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/deploys/history?project_id={project_id}&environment_id={environment_id}",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "project_id",
            "type": "string (UUID)",
            "description": "按项目过滤"
          },
          {
            "name": "environment_id",
            "type": "string (UUID)",
            "description": "按环境过滤（可选）"
          },
          {
            "name": "page",
            "type": "integer",
            "description": "分页页码"
          },
          {
            "name": "page_size",
            "type": "integer",
            "description": "每页数量"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": "array",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "description": "查询指定项目的部署历史记录，用于版本追溯和回滚操作"
    },
    {
      "interface": "FileService.Upload",
      "provider": "文件存储",
      "consumers": [
        "API网关"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/files/upload",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string (UUID，所属项目)",
          "file": "binary (可执行文件内容，multipart/form-data)",
          "version": "string (版本号，可选，不指定则自动生成)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "file_id": "string (UUID)",
          "file_name": "string",
          "version": "string",
          "checksum": "string (SHA256)",
          "size_bytes": "integer",
          "created_at": "string (ISO datetime)"
        }
      },
      "description": "上传可执行文件并关联到指定项目，支持版本化管理和完整性校验"
    }
  ],
  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户通过Web控制台选择目标项目和部署环境，选择要部署的版本",
        "前端发送部署请求到API网关，网关鉴权后路由到部署编排服务",
