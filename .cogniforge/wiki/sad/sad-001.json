{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "远程自动化部署系统 — 系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-21 13:36"
  },
  "system_overview": {
    "description": "远程自动化部署系统是一个基于 Web 的一键式部署平台，采用前后端分离的微服务架构。系统通过 SSH 协议安全连接远程服务器，实现打包好的可执行文件的自动化部署。核心能力包括多项目独立管理、多套部署环境灵活切换、SSH 密钥安全存储、部署流程全自动编排、部署过程实时可视化。系统设计遵循最小权限原则，各服务独立部署、独立扩展，通过 API 网关统一接入，消息队列异步解耦长时任务。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "创建、编辑、删除部署环境",
          "配置环境的 SSH 连接参数和密钥",
          "执行环境连接测试",
          "查看部署历史和日志"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目列表和环境列表",
          "选择项目和目标环境执行一键部署",
          "查看部署进度和结果"
        ]
      },
      {
        "name": "技术负责人",
        "permissions": [
          "管理所有项目配置",
          "查看全局部署状态和统计",
          "审批重要环境的部署操作"
        ]
      },
      {
        "name": "部署管理员",
        "permissions": [
          "为每个项目配置独立的 SSH 密钥和服务器连接",
          "管理项目的环境隔离",
          "查看审计日志"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层微服务架构",
    "description": "系统采用分层微服务架构，从上到下依次为展示层（Web 控制台）、网关层（API 网关统一路由与鉴权）、服务层（六个领域服务各自独立）、数据层（关系型数据库 + 缓存 + 消息队列），以及外部集成层（通过 SSH 协议连接远程服务器）。服务之间通过 RESTful API 同步通信，长时部署任务通过消息队列异步编排，确保系统松耦合、可扩展。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web Console"]
      },
      {
        "name": "网关层",
        "components": ["API Gateway"]
      },
      {
        "name": "服务层",
        "components": [
          "Project Management Service",
          "Environment Management Service",
          "SSH Execution Service",
          "Deployment Orchestrator",
          "Audit Service",
          "Key Management Service"
        ]
      },
      {
        "name": "数据层",
        "components": ["Primary Database", "Redis", "RabbitMQ"]
      },
      {
        "name": "外部集成层",
        "components": ["Remote Servers"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "SQL / Redis Protocol / AMQP"
      },
      {
        "protocol": "SSH"
      }
    ],
    "features": [
      "前后端分离，API 网关统一入口",
      "服务无状态，水平扩展",
      "异步消息驱动部署流程",
      "SSH 密钥加密存储",
      "部署任务状态实时缓存",
      "全操作审计日志"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "mq": "RabbitMQ 3.12",
    "ssh": "Paramiko",
    "deployment": "Docker + Docker Compose",
    "api_docs": "OpenAPI 3.0 (自动生成)"
  },
  "components": [
    {
      "name": "Web Console",
      "type": "frontend",
      "description": "基于 React 的单页应用，提供用户操作界面",
      "responsibilities": [
        "项目列表展示与 CRUD 操作界面",
        "环境配置表单与连接测试触发",
        "一键部署按钮与进度可视化展示",
        "部署历史与审计日志查看"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "系统的统一入口网关，负责请求路由、认证和限流",
      "responsibilities": [
        "统一路由转发至各微服务",
        "请求身份认证与会话校验",
        "API 限流与防滥用",
        "请求响应日志记录",
        "跨域策略管理"
      ]
    },
    {
      "name": "Project Management Service",
      "type": "service",
      "description": "管理项目生命周期的微服务",
      "responsibilities": [
        "项目的创建、编辑、删除、查询",
        "项目与环境的关系绑定",
        "项目级别的配置管理"
      ]
    },
    {
      "name": "Environment Management Service",
      "type": "service",
      "description": "管理部署环境的微服务，负责环境配置与 SSH 密钥绑定",
      "responsibilities": [
        "环境的创建、编辑、删除、查询",
        "环境连接参数管理",
        "SSH 密钥与环境绑定",
        "连接测试触发"
      ]
    },
    {
      "name": "SSH Execution Service",
      "type": "service",
      "description": "核心执行引擎，通过 SSH 协议在远程服务器上执行命令和传输文件",
      "responsibilities": [
        "SSH 会话建立与密钥认证",
        "远程目录创建（带版本标识）",
        "文件传输（可执行文件上传）",
        "远程脚本生成与执行",
        "命令执行结果收集与返回"
      ]
    },
    {
      "name": "Deployment Orchestrator",
      "type": "service",
      "description": "部署流程的编排引擎，负责部署任务接收、状态管理和进度发布",
      "responsibilities": [
        "部署任务接收与状态管理",
        "部署步骤编排",
        "异步任务进度发布",
        "部署结果汇总与通知",
        "部署历史记录维护"
      ]
    },
    {
      "name": "Audit Service",
      "type": "service",
      "description": "全操作审计日志服务，记录所有关键操作事件",
      "responsibilities": [
        "记录项目创建、修改、删除操作",
        "记录环境配置变更",
        "记录每次部署请求与结果",
        "审计日志持久化存储与查询"
      ]
    },
    {
      "name": "Key Management Service",
      "type": "service",
      "description": "SSH 密钥安全管理的专用服务，负责密钥的加密存储与访问控制",
      "responsibilities": [
        "SSH 私钥的加密存储与解密使用",
        "密钥的导入与验证",
        "密钥访问权限控制",
        "密钥轮换支持"
      ]
    },
    {
      "name": "Primary Database",
      "type": "database",
      "description": "关系型数据库（PostgreSQL），存储系统全部持久化数据",
      "responsibilities": [
        "项目数据的持久化存储",
        "环境配置数据的持久化",
        "部署历史记录存储",
        "审计日志存储",
        "数据完整性与一致性保障"
      ]
    },
    {
      "name": "Redis",
      "type": "cache",
      "description": "内存缓存和实时状态存储，加速数据访问和实时状态追踪",
      "responsibilities": [
        "用户会话缓存",
        "部署任务实时状态缓存",
        "环境连接测试结果缓存",
        "配置缓存降低数据库压力"
      ]
    },
    {
      "name": "RabbitMQ",
      "type": "mq",
      "description": "消息队列，用于解耦部署请求的提交与执行，支持异步事件驱动通信",
      "responsibilities": [
        "部署任务消息的异步投递",
        "部署进度状态变更的通知分发",
        "服务间事件驱动通信",
        "削峰填谷，平滑处理部署高峰"
      ]
    },
    {
      "name": "Remote Servers",
      "type": "infrastructure",
      "description": "外部远程服务器，承载部署目标环境",
      "responsibilities": [
        "提供 SSH 可访问的远程执行环境",
        "接收部署文件并执行部署脚本",
        "返回命令执行结果"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "Project CRUD API",
      "provider": "Project Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST/GET/PUT/DELETE /api/v1/projects[/{id}]",
      "request": {
        "path_params": [
          {"name": "id", "type": "string", "format": "uuid", "required": false, "description": "项目 ID，GET/PUT/DELETE 时需要"}
        ],
        "query_params": [
          {"name": "page", "type": "integer", "required": false, "description": "分页页码"},
          {"name": "size", "type": "integer", "required": false, "description": "每页条数"}
        ],
        "body": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "description": "项目名称"},
            "description": {"type": "string", "description": "项目描述"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "name": {"type": "string"},
            "description": {"type": "string"},
            "created_at": {"type": "string", "format": "date-time"},
            "updated_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "description": "项目的增删改查接口，API Gateway 将前端请求路由至 Project Management Service"
    },
    {
      "interface": "Environment CRUD API",
      "provider": "Environment Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST/GET/PUT/DELETE /api/v1/environments[/{id}]",
      "request": {
        "path_params": [
          {"name": "id", "type": "string", "format": "uuid", "required": false, "description": "环境 ID"}
        ],
        "query_params": [
          {"name": "project_id", "type": "string", "format": "uuid", "required": false, "description": "按项目筛选环境"}
        ],
        "body": {
          "type": "object",
          "properties": {
            "project_id": {"type": "string", "format": "uuid", "description": "所属项目 ID"},
            "name": {"type": "string", "description": "环境名称（如 测试线、灰度线、正式线）"},
            "host": {"type": "string", "description": "远程服务器主机地址"},
            "port": {"type": "integer", "description": "SSH 端口，默认 22"},
            "username": {"type": "string", "description": "SSH 登录用户名"},
            "key_id": {"type": "string", "format": "uuid", "description": "绑定的 SSH 密钥 ID"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "project_id": {"type": "string", "format": "uuid"},
            "name": {"type": "string"},
            "host": {"type": "string"},
            "port": {"type": "integer"},
            "username": {"type": "string"},
            "connection_status": {"type": "string", "enum": ["unknown", "connected", "failed"]},
            "created_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "description": "部署环境的增删改查接口，支持按项目筛选环境列表"
    },
    {
      "interface": "Connection Test API",
      "provider": "Environment Management Service",
      "consumers": ["API Gateway", "SSH Execution Service"],
      "type": "REST",
      "endpoint": "POST /api/v1/environments/{id}/test-connection",
      "request": {
        "path_params": [
          {"name": "id", "type": "string", "format": "uuid", "required": true, "description": "环境 ID"}
        ],
        "query_params": [],
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "success": {"type": "boolean"},
            "message": {"type": "string"},
            "latency_ms": {"type": "integer"}
          }
        }
      },
      "description": "测试指定环境的 SSH 连接是否可达，内部调用 SSH Execution Service 执行轻量探测命令"
    },
    {
      "interface": "Deploy Trigger API",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/v1/projects/{project_id}/deploy",
      "request": {
        "path_params": [
          {"name": "project_id", "type": "string", "format": "uuid", "required": true, "description": "项目 ID"}
        ],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "environment_id": {"type": "string", "format": "uuid", "description": "目标环境 ID"},
            "file_path": {"type": "string", "description": "可执行文件路径（服务器本地路径或上传路径）"},
            "version": {"type": "string", "description": "部署版本标识，如 v1.2.3"}
          }
        }
      },
      "response": {
        "status": 202,
        "body": {
          "type": "object",
          "properties": {
            "deployment_id": {"type": "string", "format": "uuid"},
            "status": {"type": "string", "enum": ["pending", "running", "success", "failed"]},
            "message": {"type": "string"}
          }
        }
      },
      "description": "提交部署请求，Deployment Orchestrator 创建部署记录后立即返回，异步执行实际部署流程"
    },
    {
      "interface": "Deploy Status API",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/v1/deployments/{deployment_id}/status",
      "request": {
        "path_params": [
          {"name": "deployment_id", "type": "string", "format": "uuid", "required": true, "description": "部署记录 ID"}
        ],
        "query_params": [],
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "deployment_id": {"type": "string", "format": "uuid"},
            "status": {"type": "string", "enum": ["pending", "running", "success", "failed"]},
            "progress": {"type": "integer", "description": "进度百分比 0-100"},
            "current_step": {"type": "string", "description": "当前执行步骤名称"},
            "steps": {"type": "array", "items": {"type": "object", "properties": {
              "name": {"type": "string"},
              "status": {"type": "string", "enum": ["pending", "running", "success", "failed"]},
              "started_at": {"type": "string", "format": "date-time"},
              "finished_at": {"type": "string", "format": "date-time"}
            }}},
            "logs": {"type": "array", "items": {"type": "string"}, "description": "部署日志行"},
            "started_at": {"type": "string", "format": "date-time"},
            "finished_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "description": "轮询查询部署任务的实时状态和进度，Web Console 通过此接口实现进度可视化"
    },
    {
      "interface": "SSH Execute API",
      "provider": "SSH Execution Service",
      "consumers": ["Environment Management Service", "Deployment Orchestrator"],
      "type": "REST",
      "endpoint": "POST /internal/ssh/execute",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "host": {"type": "string", "description": "目标服务器地址"},
            "port": {"type": "integer", "description": "SSH 端口"},
            "username": {"type": "string", "description": "登录用户名"},
            "key_id": {"type": "string", "format": "uuid", "description": "SSH 密钥 ID（引用 KMS）"},
            "command": {"type": "string", "description": "待执行的命令"},
            "timeout": {"type": "integer", "description": "命令执行超时时间（秒）"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "success": {"type": "boolean"},
            "stdout": {"type": "string"},
            "stderr": {"type": "string"},
            "exit_code": {"type": "integer"},
            "duration_ms": {"type": "integer"}
          }
        }
      },
      "description": "内部接口，在远程服务器上执行命令并返回执行结果。仅限服务间调用，不对外暴露"
    },
    {
      "interface": "SSH File Transfer API",
      "provider": "SSH Execution Service",
      "consumers": ["Deployment Orchestrator"],
      "type": "REST",
      "endpoint": "POST /internal/ssh/upload",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "host": {"type": "string"},
            "port": {"type": "integer"},
            "username": {"type": "string"},
            "key_id": {"type": "string", "format": "uuid"},
            "local_path": {"type": "string", "description": "本地文件路径"},
            "remote_path": {"type": "string", "description": "远程目标路径"},
            "mkdir": {"type": "boolean", "description": "是否自动创建远程目录"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "success": {"type": "boolean"},
            "remote_path": {"type": "string"},
            "size_bytes": {"type": "integer"},
            "duration_ms": {"type": "integer"}
          }
        }
      },
      "description": "内部接口，将文件上传到远程服务器。用于部署时将可执行文件传输到目标机器"
    },
    {
      "interface": "KMS Key Management API",
      "provider": "Key Management Service",
      "consumers": ["Environment Management Service"],
      "type": "REST",
      "endpoint": "POST /internal/kms/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "action": {"type": "string", "enum": ["store", "get", "delete", "validate"], "description": "密钥操作类型"},
            "key_id": {"type": "string", "format": "uuid", "description": "密钥 ID（get/delete 时需要）"},
            "private_key": {"type": "string", "description": "SSH 私钥内容（store 时需要）"},
            "passphrase": {"type": "string", "description": "密钥口令（可选）"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "success": {"type": "boolean"},
            "key_id": {"type": "string", "format": "uuid"},
            "fingerprint": {"type": "string", "description": "密钥指纹"},
            "message": {"type": "string"}
          }
        }
      },
      "description": "内部接口，SSH 密钥的加密存储、解密获取、验证和删除。密钥以加密形式持久化到 Primary Database"
    },
    {
      "interface": "Audit Log API",
      "provider": "Audit Service",
      "consumers": ["Project Management Service", "Environment Management Service", "Deployment Orchestrator", "Key Management Service", "SSH Execution Service"],
      "type": "REST",
      "endpoint": "POST /internal/audit/log",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "actor": {"type": "string", "description": "操作主体（用户 ID 或服务名）"},
            "action": {"type": "string", "description": "操作类型（如 project.create, deploy.trigger）"},
            "resource_type": {"type": "string", "description": "资源类型（如 project, environment, deployment）"},
            "resource_id": {"type": "string", "description": "资源 ID"},
            "detail": {"type": "object", "description": "操作详情"},
            "result": {"type": "string", "enum": ["success", "failure"], "description": "操作结果"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "success": {"type": "boolean"},
            "log_id": {"type": "string", "format": "uuid"},
            "recorded_at": {"type": "string", "format": "date-time"}
          }
        }
      },
      "description": "内部接口，所有服务在执行关键操作后调用此接口记录审计日志"
    },
    {
      "interface": "Deploy Task Queue",
      "provider": "RabbitMQ",
      "consumers": ["Deployment Orchestrator", "SSH Execution Service"],
      "type": "MQ",
      "endpoint": "exchange: deploy.tasks / queue: deploy_tasks",
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "deployment_id": {"type": "string", "format": "uuid"},
            "project_id": {"type": "string", "format": "uuid"},
            "environment_id": {"type": "string", "format": "uuid"},
            "file_path": {"type": "string"},
            "version": {"type": "string"}
          }
        }
      },
      "response": {
        "body": {
          "type": "object",
          "properties": {
            "deployment_id": {"type": "string", "format": "uuid"},
            "step": {"type": "string"},
            "status": {"type": "string", "enum": ["running", "success", "failed"]},
            "message": {"type": "string"},
            "timestamp": {"type": "string", "format": "date-time"}
          }
        }
      },
