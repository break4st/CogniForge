  "title": "基于已批准的 PRD 文档的系统架构方案",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "面向开发者和运维人员的轻量级持续部署桌面工具，支持多项目管理、多环境配置、密钥加密、一键自动化部署、版本历史与回滚。客户端本地运行，通过 SSH/SFTP 与远程服务器交互。",
    "roles": [
      {
        "name": "操作员",
        "permissions": [
          "project:create",
          "project:edit",
          "project:delete",
          "project:view",
          "environment:create",
          "environment:edit",
          "environment:delete",
          "environment:view",
          "environment:test_connection",
          "deployment:execute",
          "deployment:log_view",
          "version_history:view",
          "version_history:rollback",
          "master_password:set",
          "master_password:change"
        ]
      }
    ]
  },
  "architecture": {
    "style": "本地优先的分层桌面架构",
    "description": "系统分为表现层、应用服务层和基础设施层。表现层负责 UI 交互，通过 IPC 通道调用主进程服务；应用服务层封装业务逻辑，协调基础设施能力；基础设施层提供加密、存储、SSH 连接等底层支持。层间通过清晰接口通信，确保模块化和可测试性。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "ProjectListView",
          "EnvironmentView",
          "DeployPanel",
          "VersionHistoryView",
          "MasterPasswordDialog",
          "IPC Bridge"
        ]
      },
      {
        "name": "应用服务层",
        "components": [
          "MasterPasswordService",
          "ProjectService",
          "EnvironmentService",
          "DeploymentService",
          "VersionHistoryService",
          "DeploymentLogService"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "ConfigStore",
          "CryptoService",
          "SshClient",
          "Logger"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "Electron IPC（contextBridge + ipcRenderer.invoke）",
        "description": "表现层通过预定义的 IPC 通道调用主进程服务，请求-响应模式，传递序列化数据。"
      },
      {
        "protocol": "本地方法调用（TypeScript 接口）",
        "description": "应用服务层内部组件通过依赖注入或直接导入调用，使用 Promise 异步接口。"
      },
      {
        "protocol": "本地方法调用",
        "description": "应用服务层依赖基础设施层的抽象接口（ConfigStore、CryptoService、SshClient），实现通过构造函数或工厂注入。"
      }
    ],
    "features": [
      "本地加密存储，主密码派生密钥",
      "一键自动化部署流水线（上传、脚本生成、软链更新）",
      "多项目和环境的完全隔离",
      "部署日志实时回显",
      "历史版本回滚能力",
      "前后脚本自定义执行"
    ]
  },
  "tech_stack": {
    "desktop": "Electron 28+",
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5.x",
      "language": "TypeScript"
    },
    "backend": {
      "runtime": "Node.js 18+",
      "language": "TypeScript"
    },
    "database": "本地 JSON 文件（通过 ConfigStore 管理）",
    "encryption": "Node.js crypto 模块 (PBKDF2, AES-256-CBC)",
    "ssh_library": "node-ssh (基于 ssh2)",
    "packaging": "electron-builder (Windows, macOS, Linux)"
  },
