{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-22 10:47"
  },
  "system_overview": {
    "description": "自动化部署系统实现将打包好的可执行文件一键部署到远程服务器的功能。支持用户自定义多套部署环境（测试线、灰度线、正式线），通过SSH密钥配置安全连接，自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。同时支持多项目管理，每个项目拥有独立的部署环境配置，满足多项目并行管理的需求。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "创建、编辑、删除部署环境",
          "为每套环境配置SSH密钥安全连接",
          "测试环境连接有效性",
          "标记环境类型（测试/灰度/正式）"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "选择目标项目和部署环境",
          "选择版本进行一键部署",
          "查看部署状态和执行日志"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、删除项目",
          "跨项目查看所有部署状态",
          "管理项目成员权限"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层微服务架构",
    "description": "系统采用前后端分离的分层微服务架构。前端提供Web控制台交互界面；API网关统一接入请求路由和认证；后端按业务域拆分为项目管理、环境管理、部署执行、密钥管理、审计日志等微服务；数据层采用PostgreSQL持久化存储。部署执行服务通过SSH连接池与远程服务器通信，实现自动化部署。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "Web控制台"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API网关"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署执行服务",
          "密钥管理服务",
          "审计日志服务"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL数据库"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH连接池"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "REST/gRPC"
      },
      {
        "protocol": "SQL"
      },
      {
        "protocol": "SSH"
      }
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "微服务架构，各服务独立演进",
      "API网关统一入口，安全管控",
      "SSH密钥安全存储，加密传输",
      "异步部署任务，支持状态追踪",
      "完整审计日志，操作可追溯"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "mq": "RabbitMQ",
    "ssh": "paramiko"
  },
  "components": [
    {
      "name": "Web控制台",
      "type": "frontend",
      "description": "用户交互界面，提供项目管理、环境管理、部署操作等功能页面",
      "responsibilities": [
        "项目创建、编辑、删除、切换",
        "部署环境配置管理",
        "SSH密钥上传和管理",
        "部署触发和状态可视化",
        "部署历史日志查看"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "统一API入口，负责请求路由、认证鉴权、流量控制",
      "responsibilities": [
        "请求路由转发到对应微服务",
        "用户身份认证和权限校验",
        "请求日志记录",
        "限流和熔断保护"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "负责项目维度的CRUD操作和项目管理逻辑",
      "responsibilities": [
        "创建、编辑、删除项目",
        "项目列表查询和详情展示",
        "项目下环境关联管理",
        "项目基础信息维护"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理多套部署环境的配置信息，包括环境类型和服务器连接参数",
      "responsibilities": [
        "环境的创建、编辑、删除",
        "环境类型标签管理（测试/灰度/正式）",
        "服务器连接参数配置",
        "环境与项目关联关系管理",
        "连接可用性测试"
      ]
    },
    {
      "name": "部署执行服务",
      "type": "service",
      "description": "核心部署引擎，负责上传文件到远程服务器并生成部署脚本",
      "responsibilities": [
        "接收部署请求并创建部署任务",
        "通过SSH连接池建立远程连接",
        "在远程服务器创建版本目录",
        "上传可执行文件到远程服务器",
        "自动生成启动/停止/重启脚本",
        "更新部署状态和进度反馈"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "安全管理SSH密钥和敏感凭证，提供加密存储和访问控制",
      "responsibilities": [
        "SSH密钥的安全加密存储",
        "密钥与部署环境关联绑定",
        "密钥生命周期管理（创建、轮换、吊销）",
        "密钥访问权限控制",
        "密钥解密传递给部署服务"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录系统所有关键操作的审计日志，确保操作可追溯",
      "responsibilities": [
        "记录用户登录和操作日志",
        "记录部署操作的完整生命周期",
        "记录密钥管理操作",
        "审计日志的查询和导出"
      ]
    },
    {
      "name": "PostgreSQL数据库",
      "type": "database",
      "description": "关系型数据库，集中存储所有业务数据",
      "responsibilities": [
        "项目信息持久化存储",
        "环境配置信息存储",
        "SSH密钥密文存储",
        "部署记录和历史日志存储",
        "审计日志持久化"
      ]
    },
    {
      "name": "SSH连接池",
      "type": "infrastructure",
      "description": "管理到远程服务器的SSH连接池，复用连接提高效率",
      "responsibilities": [
        "SSH连接建立和维护",
        "连接池复用管理",
        "连接健康检查和自动重连",
        "文件传输（SCP/SFTP）",
        "远程命令执行"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "创建部署任务",
      "provider": "API网关",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/deployments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": {
            "type": "string",
            "description": "目标项目ID"
          },
          "environment_id": {
            "type": "string",
            "description": "目标环境ID"
          },
          "version": {
            "type": "string",
            "description": "部署版本号"
          },
          "artifact_path": {
            "type": "string",
            "description": "可执行文件路径或上传文件"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "deployment_id": {
            "type": "string",
            "description": "部署任务ID"
          },
          "status": {
            "type": "string",
            "description": "初始状态 pending"
          },
          "created_at": {
            "type": "datetime",
            "description": "创建时间"
          }
        }
      },
      "description": "开发人员通过Web控制台触发一键部署，API网关认证后转发到部署执行服务"
    },
    {
      "interface": "查询部署状态",
      "provider": "API网关",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/deployments/{deployment_id}",
      "request": {
        "path_params": [
          {
            "name": "deployment_id",
            "type": "string",
            "description": "部署任务ID"
          }
        ],
        "query_params": [],
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "string",
            "description": "部署任务ID"
          },
          "status": {
            "type": "string",
            "description": "部署状态 pending/running/success/failed"
          },
          "project_id": {
            "type": "string",
            "description": "项目ID"
          },
          "environment_id": {
            "type": "string",
            "description": "环境ID"
          },
          "version": {
            "type": "string",
            "description": "部署版本"
          },
          "steps": {
            "type": "array",
            "description": "部署步骤列表及状态"
          },
          "logs": {
            "type": "string",
            "description": "执行日志"
          },
          "created_at": {
            "type": "datetime",
            "description": "创建时间"
          },
          "updated_at": {
            "type": "datetime",
            "description": "最后更新时间"
          }
        }
      },
      "description": "Web控制台轮询或用户手动刷新部署状态和日志"
    },
    {
      "interface": "创建项目",
      "provider": "API网关",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "description": {
            "type": "string",
            "description": "项目描述"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {
            "type": "string",
            "description": "项目ID"
          },
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "description": {
            "type": "string",
            "description": "项目描述"
          },
          "created_at": {
            "type": "datetime",
            "description": "创建时间"
          }
        }
      },
      "description": "项目经理创建新项目，API网关转发到项目管理服务"
    },
    {
      "interface": "创建部署环境",
      "provider": "API网关",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/environments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": {
            "type": "string",
            "description": "所属项目ID"
          },
          "name": {
            "type": "string",
            "description": "环境名称"
          },
          "type": {
            "type": "string",
            "description": "环境类型 test/staging/production"
          },
          "host": {
            "type": "string",
            "description": "远程服务器主机地址"
          },
          "port": {
            "type": "integer",
            "description": "SSH端口 默认22"
          },
          "username": {
            "type": "string",
            "description": "SSH登录用户名"
          },
          "key_id": {
            "type": "string",
            "description": "关联的SSH密钥ID"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {
            "type": "string",
            "description": "环境ID"
          },
          "name": {
            "type": "string",
            "description": "环境名称"
          },
          "type": {
            "type": "string",
            "description": "环境类型"
          },
          "status": {
            "type": "string",
            "description": "连接状态 untested/available/unavailable"
          },
          "created_at": {
            "type": "datetime",
            "description": "创建时间"
          }
        }
      },
      "description": "运维人员配置部署环境，API网关转发到环境管理服务"
    },
    {
      "interface": "上传SSH密钥",
      "provider": "API网关",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": {
            "type": "string",
            "description": "密钥名称"
          },
          "public_key": {
            "type": "string",
            "description": "公钥内容"
          },
          "private_key": {
            "type": "string",
            "description": "私钥内容（加密传输）"
          },
          "passphrase": {
            "type": "string",
            "description": "私钥密码（可选）"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {
            "type": "string",
            "description": "密钥ID"
          },
          "name": {
            "type": "string",
            "description": "密钥名称"
          },
          "fingerprint": {
            "type": "string",
            "description": "密钥指纹"
          },
          "created_at": {
            "type": "datetime",
            "description": "创建时间"
          }
        }
      },
      "description": "运维人员上传SSH密钥，API网关转发到密钥管理服务加密存储"
    },
    {
      "interface": "测试环境连接",
      "provider": "API网关",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/environments/{environment_id}/test",
      "request": {
        "path_params": [
          {
            "name": "environment_id",
            "type": "string",
            "description": "环境ID"
          }
        ],
        "query_params": [],
        "body": null
      },
      "response": {
        "status": 200,
        "body": {
          "status": {
            "type": "string",
            "description": "连接结果 available/unavailable"
          },
          "message": {
            "type": "string",
            "description": "结果描述"
          },
          "latency_ms": {
            "type": "integer",
            "description": "连接延迟毫秒"
          }
        }
      },
      "description": "运维人员验证环境配置的SSH连接是否可用"
    },
    {
      "interface": "密钥解密（内部）",
      "provider": "密钥管理服务",
      "consumers": [
        "部署执行服务"
      ],
      "type": "REST",
      "endpoint": "POST /api/internal/keys/decrypt",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "key_id": {
            "type": "string",
            "description": "密钥ID"
          },
          "session_token": {
            "type": "string",
            "description": "内部会话认证令牌"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "private_key": {
            "type": "string",
            "description": "解密后的私钥内容（内存级，用完即弃）"
          },
          "fingerprint": {
            "type": "string",
            "description": "密钥指纹"
          }
        }
      },
      "description": "部署执行服务在执行部署前向密钥管理服务请求解密SSH私钥"
    },
    {
      "interface": "记录审计日志（内部）",
      "provider": "审计日志服务",
      "consumers": [
        "部署执行服务",
        "密钥管理服务",
        "项目管理服务",
        "环境管理服务"
      ],
      "type": "REST",
      "endpoint": "POST /api/internal/audit-logs",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "action": {
            "type": "string",
            "description": "操作类型"
          },
          "operator_id": {
            "type": "string",
            "description": "操作人ID"
          },
          "operator_name": {
            "type": "string",
            "description": "操作人名称"
          },
          "resource_type": {
            "type": "string",
            "description": "资源类型 project/environment/deployment/key"
          },
          "resource_id": {
            "type": "string",
            "description": "资源ID"
          },
          "detail": {
            "type": "object",
            "description": "操作详情"
          },
          "ip_address": {
            "type": "string",
            "description": "请求来源IP"
          },
          "timestamp": {
            "type": "datetime",
            "description": "操作时间"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {
            "type": "string",
            "description": "审计日志ID"
          },
          "status": {
            "type": "string",
            "description": "记录状态"
          },
          "created_at": {
            "type": "datetime",
            "description": "记录时间"
          }
        }
      },
      "description": "各微服务在执行关键操作后记录审计日志，确保全程可追溯"
    }
  ],
  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "开发人员通过Web控制台选择目标项目和部署环境",
        "开发人员选择部署版本并上传或指定可执行文件路径",
        "Web控制台发送部署请求到API网关",
        "API网关认证身份并转发请求到部署执行服务",
        "部署执行服务创建部署任务，初始化状态为pending",
        "部署执行服务从密钥管理服务获取目标环境的SSH密钥（解密后）",
        "部署执行服务从SSH连接池获取远程服务器连接",
        "通过SSH在远程服务器创建版本标识的部署目录",
        "通过SCP/SFTP上传可执行文件到远程服务器的部署目录",
        "SSH连接池自动生成启动/停止/重启脚本并保存到远程服务器",
        "部署执行服务更新部署状态为success，记录完整操作日志到审计日志服务",
        "Web控制台轮询部署状态，展示部署结果和日志信息"
      ]
    },
    {
      "name": "环境配置流程",
      "steps": [
        "运维人员在Web控制台进入环境管理页面",
        "创建新的部署环境，填写服务器连接参数",
        "选择关联的SSH密钥或上传新密钥",
        "密钥通过密钥管理服务加密存储到数据库",
        "调用环境管理服务保存环境配置到PostgreSQL",
        "执行连接测试验证配置有效性",
        "环境状态标记为可用"
      ]
    },
    {
      "name": "项目管理流程",
      "steps": [
        "项目经理在Web控制台创建新项目",
        "填写项目名称、描述等基本信息",
        "项目管理服务持久化项目信息到PostgreSQL",
        "在项目下添加多个部署环境（引用已配置的环境）",
        "项目创建完成后可进行部署操作"
      ]
    },
    {
      "name": "SSH密钥管理流程",
      "steps": [
        "运维人员在密钥管理页面上传SSH公钥和私钥",
        "密钥管理服务对私钥进行AES加密后存储到数据库",
        "密钥与特定部署环境关联绑定",
        "部署时部署执行服务通过内部API请求解密密钥",
        "密钥解密后仅存于内存，使用后立即清除",
        "密钥可被吊销或轮换，历史部署记录保留旧密钥引用"
      ]
    }
  ]
}