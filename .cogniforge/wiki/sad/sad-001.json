{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统 - 系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-22 17:22"
  },
  "system_overview": {
    "description": "自动化部署系统是一个支持多项目、多环境、一键式远程部署的平台。用户可创建多个项目，每个项目独立配置多套部署环境（测试线、灰度线、正式线），通过 SSH 安全连接实现可执行文件的自动化上传、版本目录创建和执行脚本生成，完成自动化部署全流程。系统采用前后端分离的分层架构，以 RESTful API 为核心通信方式，确保各模块高内聚低耦合。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "查看项目列表",
          "选择目标项目和版本",
          "执行一键部署到测试环境",
          "查看部署实时日志"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建/编辑/删除项目",
          "管理项目的部署环境配置",
          "在项目间切换",
          "查看所有部署记录"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目信息",
          "选择版本文件部署到灰度环境",
          "查看部署结果"
        ]
      },
      {
        "name": "部署负责人",
        "permissions": [
          "配置正式环境的 SSH 密钥和连接参数",
          "验证环境连通性",
          "审批正式环境部署",
          "查看审计日志"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 微服务风格",
    "description": "系统采用前后端分离的分层架构，前端为单页应用（SPA），后端划分为多个职责单一的服务模块，通过 API 网关统一接入。服务层内部采用领域驱动设计划分边界，数据存储统一通过数据访问层管理，部署任务通过消息队列异步处理，保证系统可伸缩性和可靠性。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "Web 管理控制台"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API 网关"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "项目服务",
          "环境配置服务",
          "部署编排服务",
          "密钥管理服务",
          "审计日志服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "关系型数据库",
          "消息队列",
          "缓存"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST（表现层 → 网关层）"
      },
      {
        "protocol": "REST / gRPC（网关层 → 服务层）"
      },
      {
        "protocol": "SQL / AMQP / Redis 协议（服务层 → 基础设施层）"
      }
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "API 网关统一认证鉴权和路由",
      "服务层按业务领域拆分，独立演进",
      "部署任务异步化，用户无阻塞体验",
      "密钥信息加密存储（AES-256），保障安全性",
      "全流程审计日志，支持操作追溯",
      "实时日志推送（WebSocket），部署过程透明可观测",
      "SSH 安全连接预检机制，提前发现连接异常"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI（异步）"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL 15+",
    "cache": "Redis 7+",
    "mq": "RabbitMQ",
    "deploy_protocol": "SSH (paramiko / asyncssh)",
    "auth": "JWT + RBAC",
    "realtime": "WebSocket (FastAPI WebSocket)"
  },
  "components": [
    {
      "name": "Web 管理控制台",
      "type": "frontend",
      "description": "基于 Vue 3 + Element Plus 构建的单页应用，提供项目、环境、部署任务的图形化管理界面。通过 WebSocket 实时展示部署日志和结果反馈。",
      "responsibilities": [
        "项目 CRUD 操作界面",
        "部署环境配置管理界面",
        "一键部署操作入口（选择项目/环境/版本文件）",
        "部署日志实时展示（WebSocket）",
        "连接验证触发和结果展示",
        "审计日志检索与展示"
      ]
    },
    {
      "name": "API 网关",
      "type": "gateway",
      "description": "系统统一入口，基于 FastAPI 中间件实现，负责请求路由、JWT 身份认证、RBAC 权限校验、流量控制和跨域处理。",
      "responsibilities": [
        "统一认证鉴权（JWT Token 校验与解析）",
        "请求路由转发至对应微服务",
        "基于角色的权限控制（RBAC）",
        "请求限流和超时控制",
        "跨域处理（CORS）",
        "网关层访问日志记录"
      ]
    },
    {
      "name": "项目服务",
      "type": "service",
      "description": "项目管理核心服务，维护项目的生命周期和元数据，提供项目维度的权限隔离。",
      "responsibilities": [
        "创建/编辑/删除项目",
        "项目列表查询与详情获取",
        "项目与部署环境的关联管理",
        "项目间的数据隔离与权限控制"
      ]
    },
    {
      "name": "环境配置服务",
      "type": "service",
      "description": "管理每个项目下的多套部署环境配置，包括连接参数、环境类型（测试/灰度/正式）和环境变量。",
      "responsibilities": [
        "环境的创建/编辑/删除",
        "环境类型管理（测试/灰度/正式）",
        "连接参数（主机、端口、用户名）维护",
        "环境变量配置管理",
        "环境与项目的关联维护"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "安全管理 SSH 密钥和密码凭据，提供加密存储、密钥注入和连通性验证，确保凭据明文不出库。",
      "responsibilities": [
        "SSH 密钥对的生成和导入",
        "密码认证凭据管理",
        "密钥和密码的 AES-256 加密存储",
        "连通性验证（预检机制）",
        "部署时的密钥安全注入（临时解密）"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "自动化部署的核心调度服务，以异步任务方式编排完整部署流程：从消息队列消费部署请求，依次执行文件上传、目录创建、脚本生成、远程执行和结果反馈。",
      "responsibilities": [
        "接收和解析部署请求参数（从消息队列消费）",
        "编排部署流程（上传文件 / 创建目录 / 生成脚本 / 执行部署）",
        "通过 SSH 连接远程服务器执行操作",
        "实时的部署进度和日志推送（WebSocket）",
        "部署结果持久化和状态更新（success/failed）",
        "多版本目录管理和清理策略"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录系统中所有关键操作的不可变审计日志，支持操作追溯和合规审查，日志仅允许追加写入。",
      "responsibilities": [
        "记录用户操作日志（增删改查操作）",
        "记录部署操作全链路事件",
        "审计日志持久化存储（仅追加写入，不可修改或删除）",
        "多维度检索（按时间/操作类型/用户/项目）",
        "操作时间、操作人、操作内容、结果完整记录"
      ]
    },
    {
      "name": "关系型数据库",
      "type": "database",
      "description": "PostgreSQL 15+ 存储项目信息、环境配置、部署记录和审计日志等结构化数据。",
      "responsibilities": [
        "项目数据持久化（projects 表）",
        "环境配置数据持久化（environments 表）",
        "部署记录持久化（deployments 表）",
        "审计日志持久化（audit_logs 表，仅追加）",
        "密钥元数据存储（keys 表，密文存储）"
      ]
    },
    {
      "name": "消息队列",
      "type": "infrastructure",
      "description": "RabbitMQ 承载异步部署任务，解耦部署请求发起方与执行方，提升系统响应速度和可靠性。",
      "responsibilities": [
        "部署任务异步投递（deploy_tasks 队列）",
        "任务队列消费者负载均衡",
        "部署任务失败重试机制",
        "任务状态的发布与订阅"
      ]
    },
    {
      "name": "缓存",
      "type": "infrastructure",
      "description": "Redis 7+ 提供会话缓存、项目列表缓存和 WebSocket 连接管理。",
      "responsibilities": [
        "JWT 黑名单（登出后令牌失效）缓存",
        "项目和环境列表缓存，减少数据库查询",
        "WebSocket 连接状态管理",
        "部署进度临时存储"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "创建项目",
      "provider": "项目服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "description": {
            "type": "string",
            "description": "项目描述"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {
            "type": "integer",
            "description": "项目 ID"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "created_at": {
            "type": "datetime"
          }
        }
      },
      "description": "创建新项目，返回项目详情。"
    },
    {
      "interface": "获取项目列表",
      "provider": "项目服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "projects": {
            "type": "array",
            "items": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "environments_count": {
                "type": "integer"
              },
              "created_at": {
                "type": "datetime"
              }
            }
          }
        }
      },
      "description": "获取当前用户有权访问的所有项目列表。"
    },
    {
      "interface": "创建部署环境",
      "provider": "环境配置服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/projects/{project_id}/environments",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "integer",
            "description": "项目 ID"
          }
        ],
        "query_params": [],
        "body": {
          "name": {
            "type": "string",
            "description": "环境名称"
          },
          "env_type": {
            "type": "string",
            "enum": [
              "test",
              "staging",
              "production"
            ],
            "description": "环境类型"
          },
          "host": {
            "type": "string",
            "description": "远程服务器主机地址"
          },
          "port": {
            "type": "integer",
            "description": "SSH 端口，默认 22"
          },
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "credential_id": {
            "type": "integer",
            "description": "关联的凭据 ID"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "env_type": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "credential_id": {
            "type": "integer"
          }
        }
      },
      "description": "为指定项目创建一套部署环境配置。"
    },
    {
      "interface": "创建凭据",
      "provider": "密钥管理服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/credentials",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": {
            "type": "string",
            "description": "凭据名称"
          },
          "type": {
            "type": "string",
            "enum": [
              "ssh_key",
              "password"
            ],
            "description": "凭据类型"
          },
          "value": {
            "type": "string",
            "description": "SSH 私钥内容或登录密码（传输加密）"
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {
            "type": "integer",
            "description": "凭据 ID"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "description": "密钥指纹（仅 SSH 密钥类型返回）"
          }
        }
      },
      "description": "创建并加密存储 SSH 密钥或密码凭据。明文仅用于加密，不出库持久化。"
    },
    {
      "interface": "验证连通性",
      "provider": "密钥管理服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/credentials/{credential_id}/verify",
      "request": {
        "path_params": [
          {
            "name": "credential_id",
            "type": "integer",
            "description": "凭据 ID"
          }
        ],
        "query_params": [],
        "body": {
          "host": {
            "type": "string",
            "description": "目标主机地址"
          },
          "port": {
            "type": "integer",
            "description": "SSH 端口"
          },
          "username": {
            "type": "string",
            "description": "登录用户名"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": {
            "type": "boolean"
          },
          "latency_ms": {
            "type": "integer",
            "description": "连接延迟（毫秒）"
          },
          "server_info": {
            "type": "string",
            "description": "远程服务器信息"
          }
        }
      },
      "description": "使用指定凭据测试到远程服务器的 SSH 连通性，返回延迟和服务器信息。"
    },
    {
      "interface": "发起部署",
      "provider": "部署编排服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/projects/{project_id}/environments/{env_id}/deployments",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "integer",
            "description": "项目 ID"
          },
          {
            "name": "env_id",
            "type": "integer",
            "description": "环境 ID"
          }
        ],
        "query_params": [],
        "body": {
          "version": {
            "type": "string",
            "description": "部署版本号"
          },
          "file_path": {
            "type": "string",
            "description": "可执行文件路径"
          },
          "deploy_description": {
            "type": "string",
            "description": "部署说明"
          }
        }
      },
      "response": {
        "status": 202,
        "body": {
          "task_id": {
            "type": "string",
            "description": "部署任务 ID（UUID）"
          },
          "status": {
            "type": "string",
            "description": "初始状态: pending"
          },
          "created_at": {
            "type": "datetime"
          }
        }
      },
      "description": "发起一键部署请求，服务端异步处理后返回 task_id，前端通过 WebSocket 获取实时进度。"
    },
    {
      "interface": "部署日志实时推送",
      "provider": "部署编排服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "WebSocket",
      "endpoint": "WS /api/v1/deployments/{task_id}/logs",
      "request": {
        "path_params": [
          {
            "name": "task_id",
            "type": "string",
            "description": "部署任务 ID"
          }
        ],
        "query_params": [
          {
            "name": "token",
            "type": "string",
            "description": "JWT 认证令牌"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "frame_type": "text",
          "data": {
            "event": {
              "type": "string",
              "enum": [
                "log",
                "progress",
                "complete",
                "error"
              ]
            },
            "message": {
              "type": "string"
            },
            "timestamp": {
              "type": "datetime"
            }
          }
        }
      },
      "description": "通过 WebSocket 实时推送指定部署任务的执行日志和执行进度。"
    },
    {
      "interface": "查询审计日志",
      "provider": "审计日志服务",
      "consumers": [
        "Web 管理控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/audit-logs",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "page",
            "type": "integer",
            "description": "页码"
          },
          {
            "name": "page_size",
            "type": "integer",
            "description": "每页条数"
          },
          {
            "name": "user_id",
            "type": "integer",
            "description": "按用户筛选（可选）"
          },
          {
            "name": "action_type",
            "type": "string",
            "description": "按操作类型筛选（可选）"
          },
          {
            "name": "start_time",
            "type": "datetime",
            "description": "起始时间（可选）"
          },
          {
            "name": "end_time",
            "type": "datetime",
            "description": "结束时间（可选）"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "total": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "id": {
                "type": "integer"
              },
              "user": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "result": {
                "type": "string"
              },
              "ip_address": {
                "type": "string"
              },
              "created_at": {
                "type": "datetime"
              }
            }
          }
        }
      },
      "description": "按多维度条件检索审计日志，支持分页。"
    }
  ],
  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户在 Web 控制台选择目标项目和部署环境",
        "用户上传或选择已打包的可执行文件，指定版本号",
        "前端调用 POST /api/v1/projects/{project_id}/environments/{env_id}/deployments 发起部署请求",
        "API 网关校验 JWT Token 和 RBAC 权限，转发至部署编排服务",
        "部署编排服务接收请求，创建部署任务记录（状态: pending），写数据库",
        "部署编排服务将任务消息发布到 RabbitMQ 的 deploy_tasks 队列",
