  "system_overview": {
    "description": "本项目为一个自动化部署控制台，采用本地B/S架构，前端基于React，后端基于FastAPI，通过Electron打包为跨平台桌面应用。主要用户角色为部署操作员，拥有全部业务权限，实现项目管理、环境配置、一键安全部署、部署历史查询等功能。",
    "roles": [
      {
        "name": "部署操作员",
        "permissions": [
          "创建/编辑/删除/切换项目",
          "创建/编辑/删除/复制环境",
          "测试环境SSH连接",
          "执行一键部署任务",
          "查看部署历史与详细日志",
          "重新部署历史版本",
          "管理主密钥与凭证加密"
        ]
      }
    ]
  },
  "architecture": {
    "style": "本地三层架构（表现层-应用层-数据层）+ 基础设施层",
    "description": "系统划分为表现层（前端React SPA）、应用服务层（后端FastAPI）、数据持久层（SQLite）以及基础设施层（操作系统IO/SSH）。表现层与应用层通过HTTP REST通信，应用层与数据层通过SQL通信，应用层通过SSH/SFTP协议与远程服务器交互。整体打包为Electron桌面应用。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "导航与布局组件",
          "项目管理面板",
          "环境管理面板",
          "部署面板",
          "部署历史面板",
          "凭证设置面板"
        ]
      },
      {
        "name": "应用服务层",
        "components": [
          "项目服务组件",
          "环境服务组件",
          "部署服务组件",
          "历史与日志服务组件",
          "加密服务组件",
          "SSH客户端组件"
        ]
      },
      {
        "name": "数据持久层",
        "components": [
          "SQLite数据库"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "Electron主进程",
          "Python后端子进程",
          "本地文件系统",
          "SSH远程服务器"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTP/1.1 + JSON",
        "description": "表现层前端的axios HTTP客户端与应用服务层的FastAPI REST接口进行通信，本地回路地址。"
      },
      {
        "protocol": "SQL",
        "description": "应用服务层通过SQLAlchemy ORM操作SQLite数据库文件。"
      },
      {
        "protocol": "SSH/SFTP",
        "description": "应用服务层的SSH客户端组件通过paramiko库使用SSH/SFTP协议连接远程服务器，执行命令和文件传输。"
      }
    ],
    "features": [
      "本地化运行，无需云端服务",
      "异步非阻塞处理部署任务",
      "版本化目录隔离部署",
      "主密码保护凭证加密存储",
      "可扩展脚本模板",
      "跨平台桌面一致体验"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.10+",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5"
    },
    "database": "SQLite 3",
    "desktop": "Electron"
  },
