  "data_flow": [
    {
      "name": "一键部署与实时日志流",
      "steps": [
        "1. 前端调用 POST /api/deployments，上传文件和 environment_id",
        "2. 后端 API 服务创建部署记录（状态：pending），存储临时文件",
        "3. 后端返回 202 和 deployment_id",
        "4. 前端建立 WebSocket 连接 ws://.../deployments/{id}/logs",
        "5. 后端启动异步部署任务（部署执行器）",
        "6. 部署执行器逐步执行：解密密钥 -> SSH 连接 -> 远程创建版本目录 -> SFTP 上传文件 -> 生成启动脚本并赋予执行权限 -> 更新符号链接",
        "7. 每一步通过 WebSocket 推送日志消息到前端",
        "8. 部署完成，执行器更新部署记录状态为 success 或 failed，并推送最终消息",
        "9. 前端实时渲染日志并反映最终状态"
      ]
    },
    {
      "name": "测试远程连接流",
      "steps": [
        "1. 前端调用 POST /api/environments/{id}/test-connection",
        "2. 后端 API 服务获取环境配置，通过密钥加密服务解密私钥",
        "3. 使用 SSH 客户端模块尝试连接远程服务器",
        "4. 返回连接结果（成功/失败信息）给前端"
      ]
    },
    {
      "name": "回滚流程",
      "steps": [
        "1. 前端调用 POST /api/deployments/{id}/rollback",
        "2. 后端 API 服务验证目标部署记录是否成功",
        "3. 创建新的部署记录（类型为 rollback，状态 pending）",
        "4. 启动回滚任务：部署执行器连接远程，将 current 符号链接指向目标版本目录",
        "5. 推送回滚日志，更新记录状态"
      ]
    }
  ],
