  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "CogniDeploy 是一款本地单用户自动化部署工具，采用前后端分离的分层架构。前端提供多项目管理、环境配置、一键部署及历史回溯等交互；后端通过 RESTful API 提供业务服务，并利用 SSH/SFTP 协议与远程服务器交互，所有敏感凭证使用 AES-256 加密存储。系统运行在本地，数据库使用 SQLite，整体强调安全性、易用性和部署过程的可视化。",
    "roles": [
      {
        "name": "开发者",
        "permissions": [
          "创建项目",
          "配置环境",
          "触发部署",
          "查看部署状态"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "管理多套环境",
          "配置服务器及密钥"
        ]
      },
      {
        "name": "安全管理员",
        "permissions": [
          "确保密钥加密存储",
          "限制密钥明文显示"
        ]
      },
      {
        "name": "日常使用者",
        "permissions": [
          "一键部署",
          "查看部署进度"
        ]
      },
      {
        "name": "项目负责人",
        "permissions": [
          "查看部署历史",
          "执行版本回滚"
        ]
      },
      {
        "name": "工程师",
        "permissions": [
          "管理启停脚本模板",
          "远程执行脚本"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 前后端分离",
    "description": "系统划分为表现层、接入层、服务层、数据层和基础设施层。表现层为 React 单页应用，通过本地 HTTP/WebSocket 与接入层（FastAPI 网关）通信；服务层封装所有业务逻辑，依赖基础设施层实现 SSH 连接与加密；数据层采用 SQLite 持久化信息。各层职责清晰，便于维护和扩展。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "Dashboard",
          "ProjectManager",
          "EnvironmentManager",
          "KeyManager",
          "DeployUI",
          "DeployHistory",
          "ScriptManager",
          "Navigation"
        ]
      },
      {
        "name": "接入层",
        "components": [
          "APIGateway"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "ProjectService",
          "EnvironmentService",
          "KeyManagementService",
          "DeploymentService",
          "VersionService",
          "ScriptTemplateService",
          "SSHService"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "SQLiteDatabase"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "EncryptionUtil",
          "FileManager"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST",
        "description": "表现层通过本地的 HTTPS REST 调用接入层 API，获取数据或提交操作"
      },
      {
        "protocol": "WebSocket",
        "description": "部署进度等实时状态通过 WebSocket 从服务层推送至表现层"
      },
      {
        "protocol": "Python 函数调用",
        "description": "接入层路由到服务层，以及服务层之间的内部调用"
      },
      {
        "protocol": "SQL (via SQLAlchemy)",
        "description": "服务层通过 ORM 查询和操作 SQLite 数据库"
      },
      {
        "protocol": "SSH / SFTP",
        "description": "SSHService 使用 paramiko 库通过 SSH 协议与远程服务器交互，包括命令执行和文件传输"
      }
    ],
    "features": [
      "本地单机运行，无需独立服务器部署",
      "前后端分离，前端可独立开发调试",
      "基于 AES-256 的密钥加密存储，主密码由用户设定",
      "部署过程事务化，失败自动回滚",
      "支持通过模板生成标准化的启停脚本",
      "简洁的 UI 交互，拖拽上传与进度可视化",
      "基于 SQLite 的轻量级数据持久化"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design"
    },
    "database": "SQLite",
    "orm": "SQLAlchemy",
    "ssh_library": "paramiko",
    "encryption": "cryptography (AES-256)",
    "real_time": "FastAPI WebSocket"
  },
