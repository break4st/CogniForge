  "architecture_decisions": [
    {
      "id": "AD-001",
      "title": "选择 FastAPI 作为后端框架",
      "context": "需要高性能的异步 Web 框架，内置 WebSocket 支持和自动文档生成，便于快速开发和维护。",
      "decision": "采用 FastAPI 框架。",
      "consequences": "Python 生态丰富，适合 I/O 密集型任务；利用 asyncio 处理异步部署；参数验证自动化。"
    },
    {
      "id": "AD-002",
      "title": "使用 Paramiko 进行 SSH 操作",
      "context": "需要从 Python 应用中管理 SSH 连接、执行远程命令和 SFTP 文件传输。",
      "decision": "选用 Paramiko 库，封装为可复用的 SSH 客户端模块。",
      "consequences": "纯 Python 实现，无需外部依赖；成熟稳定；能满足所有 SSH/SFTP 需求。"
    },
    {
      "id": "AD-003",
      "title": "WebSocket 用于实时日志推送",
      "context": "用户希望在触发部署后能看到实时的命令行输出进度。",
      "decision": "在部署过程中，后端通过 WebSocket 将日志逐行推送到前端。",
      "consequences": "前端需保持 WebSocket 连接；后端需管理连接与部署任务的生命周期。"
    },
    {
      "id": "AD-004",
      "title": "密钥加密存储方案",
      "context": "SSH 私钥属于敏感信息，必须以密文形式存储。",
      "decision": "使用 Python 的 cryptography 库，采用 AES-256-GCM 加密，主密钥从环境变量或密钥管理服务注入。",
      "consequences": "保障数据安全；加密和解密过程增加少量 CPU 开销。"
    },
    {
      "id": "AD-005",
      "title": "部署异步执行与状态管理",
      "context": "部署流程涉及网络传输和远程命令，可能耗时较长，不能阻塞 HTTP 请求。",
      "decision": "使用 FastAPI 的 BackgroundTasks 启动部署任务，并通过 WebSocket 和数据库状态字段同步进展。",
      "consequences": "降低请求等待；若应用重启会中断未完成任务（后续可升级为 Celery 等独立任务队列）。"
    }
  ],
  "risks": [
    {
      "id": "RISK-001",
      "description": "远程服务器网络不稳定导致部署中断",
      "severity": "中等",
      "mitigation": "提供取消机制；保留已传输的部分文件；下次部署时可由操作员手动清理。"
    },
    {
      "id": "RISK-002",
      "description": "上传大尺寸部署包可能导致服务器内存压力",
      "severity": "低",
      "mitigation": "限制上传文件大小（如 500MB）；使用流式读取。"
    },
    {
      "id": "RISK-003",
      "description": "主密钥泄露导致所有私钥被解密",
      "severity": "高",
      "mitigation": "主密钥由运维团队安全管理，禁止写入代码仓库；生产环境使用密钥管理服务。"
    },
    {
      "id": "RISK-004",
      "description": "同时部署到同一环境可能产生冲突",
      "severity": "低",
      "mitigation": "通过部署记录状态检查，禁止同一环境有运行中的部署时再次触发。"
    }
  ],
  "open_questions": [
    {
      "id": "Q-001",
      "question": "未来是否需要用户认证和基于角色的权限控制？",
      "context": "当前 PRD 未提及多用户，但实际团队使用可能需要。",
      "impact": "若需要，需增加认证模块和用户管理数据模型。"
    },
    {
      "id": "Q-002",
      "question": "回滚操作是否需要停止当前运行的服务并重新启动？",
      "context": "PRD 仅提到切换符号链接，但实际应用可能需要进程管理。",
      "impact": "若需要，部署执行器必须支持远程执行服务管理命令（如 supervisorctl/systemctl）。"
    },
