  "title": "系统架构设计",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "本系统为面向开发与运维人员的本地桌面应用，基于 Electron 构建，支持多项目、多环境的自动化一键部署。用户通过 React 界面集中管理项目、环境、脚本模板与部署历史，通过 SSH/SFTP 将本地产物上传至远程服务器并自动生成启动脚本。",
    "roles": [
      {
        "name": "部署操作员",
        "permissions": [
          "管理项目",
          "管理环境",
          "执行一键部署",
          "查看部署历史与日志",
          "管理脚本模板"
        ]
      }
    ]
  },
  "architecture": {
    "style": "本地前后端分离的分层架构",
    "description": "采用 Electron 主进程与渲染进程分离的模式。主进程运行 Express 服务提供本地 REST API，处理业务逻辑与远程连接；渲染进程使用 React + Ant Design 构建用户界面。系统分为表示层、应用服务层、数据访问层和基础设施层。",
    "layers": [
      {
        "name": "表示层",
        "components": [
          "GUI 客户端"
        ]
      },
      {
        "name": "应用服务层",
        "components": [
          "API 网关与路由",
          "项目管理服务",
          "环境管理服务",
          "部署执行器",
          "脚本引擎",
          "历史与日志服务"
        ]
      },
      {
        "name": "数据访问层",
        "components": [
          "数据访问层"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH/SFTP 客户端",
          "文件系统组件",
          "数据库"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "本地 HTTP (REST API)",
        "description": "渲染进程通过 window.fetch 调用主进程 Express 服务暴露的 API，仅限本地访问"
      },
      {
        "protocol": "函数调用",
        "description": "应用服务层内部组件通过模块导入直接调用，数据访问层通过 DAO 封装调用"
      },
      {
        "protocol": "SSH/SFTP",
        "description": "基础设施层 SSH/SFTP 客户端通过 SSH 协议与远程服务器通信，用于命令执行和文件传输"
      }
    ],
    "features": [
      "本地离线运行，无外部依赖",
      "跨平台支持 (Windows, macOS, Linux)",
      "模块化分层设计，便于扩展",
      "实时部署进度反馈",
      "密钥路径管理，不存储密钥内容"
    ]
  },
  "tech_stack": {
    "desktop_framework": "Electron",
    "backend": {
      "language": "TypeScript",
      "runtime": "Node.js",
      "framework": "Express"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5.x"
    },
    "database": "SQLite 3",
    "remote_connection": "ssh2 + ssh2-sftp-client",
    "logging": "winston",
    "packaging": "electron-builder"
  },
