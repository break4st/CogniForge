  "data_flow": [
    {
      "name": "环境配置与测试连接流程",
      "steps": [
        "用户在 React UI 填写环境信息点击“测试连接”",
        "渲染进程通过 IPC environment:test 请求主进程",
        "Main Router 调用 Environment Manager",
        "Environment Manager 从数据库读取环境配置，通过 Crypto Service 解密密文凭据",
        "调用 SSH Client 尝试连接目标服务器",
        "SSH Client 返回连接结果",
        "结果返回 UI，更新连通性状态"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "用户选择项目、环境、文件，确认版本号后点击“部署”",
        "UI 校验后通过 IPC deployment:start 请求主进程",
        "Deployment Engine 获取解密后的环境配置",
        "通过 SSH Client 连接服务器，检查版本目录是否存在",
        "若存在，根据用户选择覆盖或中止",
        "创建版本文件夹，通过 SFTP 上传文件（实时推送进度）",
        "调用 File Manager 生成启动脚本并上传",
        "记录部署成功，触发 History Service 写入",
        "若失败，清理远程临时文件夹（回滚），记录失败",
        "完成后 UI 弹窗提示结果"
      ]
    },
    {
      "name": "多项目管理与切换流程",
      "steps": [
        "用户新建项目，UI 通过 IPC project:create 请求主进程",
        "Project Manager 在数据库创建项目并自动添加示例环境",
        "用户切换项目，UI 发送 project:switch 请求",
        "主进程更新当前项目上下文",
        "后续所有环境、历史查询均基于新项目过滤"
      ]
    }
  ],
