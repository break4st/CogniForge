{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-22 09:39"
  },
  "system_overview": {
    "description": "实现将打包好的可执行文件自动化部署到指定远程服务器的功能。支持用户自定义多套部署环境（测试线、灰度线、正式线），每套环境通过SSH密钥/密码配置安全连接，部署时自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。用户可创建和管理多个项目，每个项目拥有独立的部署环境配置，支持在项目间灵活切换，满足多项目并行管理需求。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "配置和管理多套部署环境（测试线、灰度线、正式线）",
          "管理SSH密钥和密码认证信息",
          "验证远程服务器连通性",
          "监控部署执行状态和日志"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "触发一键自动化部署",
          "查看部署进度和实时日志",
          "查看项目部署配置信息"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、删除项目",
          "配置项目级部署参数",
          "在项目间灵活切换",
          "查看多项目部署概览"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层微服务架构 + 事件驱动管道",
    "description": "系统采用前后端分离的分层微服务架构。前端提供Web控制台交互界面，后端按业务领域拆分为多个微服务，通过API网关统一接入。部署任务通过消息队列异步执行，支持长时间运行的任务追踪和实时日志推送。SSH连接池管理远程服务器连接，密钥信息加密存储确保证书安全。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "Web控制台",
          "API网关"
        ]
      },
      {
        "name": "应用服务层",
        "components": [
          "项目管理服务",
          "环境配置服务",
          "部署编排服务",
          "审计日志服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH连接池",
          "密钥存储服务",
          "消息队列",
          "PostgreSQL数据库",
          "文件存储"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "REST/HTTPS, WebSocket"
      },
      {
        "protocol": "SSH, AMQP, SQL"
      }
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "API网关统一认证和路由",
      "异步消息驱动部署流水线",
      "加密存储敏感凭证信息",
      "SSH连接池复用，减少连接开销",
      "实时日志推送（WebSocket）",
      "多租户项目隔离"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Go",
      "framework": "Gin"
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis",
    "mq": "RabbitMQ",
    "ssh_lib": "golang.org/x/crypto/ssh",
    "auth": "JWT",
    "websocket": "gorilla/websocket"
  },
  "components": [
    {
      "name": "Web控制台",
      "type": "frontend",
      "description": "单页应用，提供项目管理、环境配置、部署操作和日志查看的图形界面",
      "responsibilities": [
        "项目CRUD操作界面",
        "环境配置表单",
        "部署触发按钮和进度展示",
        "实时日志展示",
        "项目切换导航"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "系统统一入口，处理认证鉴权、请求路由、限流和跨域",
      "responsibilities": [
        "用户认证和会话管理",
        "请求路由到对应微服务",
        "接口限流和保护",
        "统一错误处理",
        "请求日志记录"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "管理项目的创建、编辑、删除和查询，维护项目间隔离",
      "responsibilities": [
        "项目CRUD操作",
        "项目上下文切换",
        "项目级配置管理",
        "项目列表和搜索"
      ]
    },
    {
      "name": "环境配置服务",
      "type": "service",
      "description": "管理每套部署环境的连接参数、目标服务器信息和关联密钥",
      "responsibilities": [
        "环境CRUD操作",
        "环境类型管理（测试/灰度/正式）",
        "服务器目标配置",
        "环境与密钥关联管理",
        "连通性验证"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "部署任务的核心编排器，负责版本文件夹创建、文件上传、脚本生成和执行",
      "responsibilities": [
        "接收部署请求并创建部署任务",
        "通过SSH在远程创建版本文件夹",
        "上传可执行文件到远程服务器",
        "生成并执行启动脚本",
        "收集部署日志和状态反馈",
        "发布部署状态事件到消息队列"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录所有操作行为和部署历史，支持追溯审查",
      "responsibilities": [
        "记录用户操作日志",
        "记录部署历史",
        "提供日志查询接口",
        "日志归档"
      ]
    },
    {
      "name": "SSH连接池",
      "type": "service",
      "description": "管理到远程服务器的SSH连接池，复用连接减少握手开销",
      "responsibilities": [
        "SSH连接创建和复用",
        "连接健康检查",
        "自动重连机制",
        "连接超时管理",
        "并发连接控制"
      ]
    },
    {
      "name": "密钥存储服务",
      "type": "service",
      "description": "加密存储SSH私钥和密码，提供安全的凭证存取接口",
      "responsibilities": [
        "SSH密钥和密码加密存储",
        "密钥安全读取接口",
        "密钥生命周期管理",
        "访问权限控制"
      ]
    },
    {
      "name": "消息队列",
      "type": "infrastructure",
      "description": "异步处理部署任务，解耦部署请求和实际执行，支持任务状态追踪",
      "responsibilities": [
        "部署任务异步分发",
        "任务状态变更通知",
        "实时日志事件推送",
        "失败重试队列"
      ]
    },
    {
      "name": "PostgreSQL数据库",
      "type": "database",
      "description": "系统主数据库，存储项目、环境、部署记录等结构化数据",
      "responsibilities": [
        "项目数据持久化",
        "环境配置持久化",
        "部署记录存储",
        "审计日志存储",
        "用户数据存储"
      ]
    },
    {
      "name": "文件存储",
      "type": "infrastructure",
      "description": "暂存待部署的可执行文件，供部署服务上传到远程服务器",
      "responsibilities": [
        "可执行文件暂存",
        "版本文件管理",
        "临时文件清理"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "项目管理API",
      "provider": "项目管理服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/projects[/{id}]",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "string",
            "description": "项目ID"
          }
        ],
        "query_params": [
          {
            "name": "page",
            "type": "int",
            "description": "页码",
            "required": false
          },
          {
            "name": "page_size",
            "type": "int",
            "description": "每页条数",
            "required": false
          },
          {
            "name": "keyword",
            "type": "string",
            "description": "搜索关键词",
            "required": false
          }
        ],
        "body": {
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "description": {
            "type": "string",
            "description": "项目描述",
            "required": false
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "string",
            "description": "项目ID"
          },
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "description": {
            "type": "string",
            "description": "项目描述"
          },
          "created_at": {
            "type": "string",
            "description": "创建时间"
          },
          "updated_at": {
            "type": "string",
            "description": "更新时间"
          }
        }
      },
      "description": "项目的增删改查接口，通过API网关路由"
    },
    {
      "interface": "环境配置API",
      "provider": "环境配置服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/environments[/{id}]",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "string",
            "description": "环境ID"
          }
        ],
        "query_params": [
          {
            "name": "project_id",
            "type": "string",
            "description": "所属项目ID",
            "required": true
          }
        ],
        "body": {
          "name": {
            "type": "string",
            "description": "环境名称"
          },
          "env_type": {
            "type": "string",
            "enum": [
              "test",
              "gray",
              "production"
            ],
            "description": "环境类型"
          },
          "host": {
            "type": "string",
            "description": "目标服务器地址"
          },
          "port": {
            "type": "int",
            "description": "SSH端口"
          },
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "key_id": {
            "type": "string",
            "description": "关联密钥ID"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "string",
            "description": "环境ID"
          },
          "name": {
            "type": "string",
            "description": "环境名称"
          },
          "env_type": {
            "type": "string",
            "description": "环境类型"
          },
          "host": {
            "type": "string",
            "description": "目标服务器地址"
          },
          "status": {
            "type": "string",
            "description": "连通状态"
          }
        }
      },
      "description": "部署环境的增删改查接口"
    },
    {
      "interface": "连通性验证API",
      "provider": "环境配置服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/environments/{id}/verify",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "string",
            "description": "环境ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "reachable": {
            "type": "bool",
            "description": "是否连通"
          },
          "latency_ms": {
            "type": "int",
            "description": "延迟毫秒数"
          },
          "error": {
            "type": "string",
            "description": "错误信息",
            "required": false
          }
        }
      },
      "description": "验证远程服务器的SSH连通性"
    },
    {
      "interface": "部署触发API",
      "provider": "部署编排服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/deployments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": {
            "type": "string",
            "description": "项目ID"
          },
          "environment_id": {
            "type": "string",
            "description": "目标环境ID"
          },
          "version": {
            "type": "string",
