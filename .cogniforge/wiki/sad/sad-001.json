  "system_overview": {
    "description": "SmartDeploy 是一个面向开发者和运维团队的轻量级自动化部署平台，采用前后端分离架构，前端提供友好的 Web 操作界面，后端提供 RESTful API 服务，并负责实际的部署逻辑执行。系统通过项目管理、环境配置、脚本模板、部署执行和历史追踪等模块，实现一键部署和版本回滚。",
    "roles": [
      {
        "name": "系统管理员",
        "permissions": [
          "管理所有组件",
          "管理所有项目",
          "管理所有环境",
          "执行部署",
          "查看历史记录",
          "管理脚本模板"
        ]
      },
      {
        "name": "运维工程师",
        "permissions": [
          "创建和管理部署环境",
          "配置认证信息",
          "执行部署",
          "查看历史记录和回滚"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "创建项目",
          "选择环境进行部署",
          "查看历史记录"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建项目",
          "查看项目关联环境",
          "切换项目"
        ]
      },
      {
        "name": "团队主管",
        "permissions": [
          "编辑脚本模板",
          "查看所有部署历史"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构",
    "description": "系统采用前后端分离架构，前端为单页应用（SPA），后端拆分为多个职责清晰的微服务，包括管理服务（处理项目、环境、模板、历史等 CRUD 操作）、部署执行服务（负责实际的 SSH 连接、文件上传、脚本生成和执行）、WebSocket 服务（用于实时推送部署日志）。各服务通过 RESTful API 和消息队列进行通信，共享同一个数据库。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "Web 前端",
          "Nginx 反向代理"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API Gateway"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "管理服务",
          "部署执行服务",
          "WebSocket 服务"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "关系型数据库",
          "文件存储"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS",
        "description": "用户浏览器与 Nginx 之间的加密通信"
      },
      {
        "protocol": "HTTP",
        "description": "Nginx 反向代理到 API Gateway 和前端静态资源"
      },
      {
        "protocol": "REST",
        "description": "API Gateway 转发请求到后端管理服务"
      },
      {
        "protocol": "AMQP",
        "description": "管理服务通过消息队列向部署执行服务派发部署任务"
      },
      {
        "protocol": "WebSocket",
        "description": "WebSocket 服务从消息队列消费日志，推送到前端实时展示"
      },
      {
        "protocol": "SQL",
        "description": "管理服务和部署执行服务访问数据库"
      },
      {
        "protocol": "SFTP/SSH",
        "description": "部署执行服务通过 SSH 协议连接远程服务器，上传文件并执行命令"
      }
    ],
    "features": [
      "前后端分离",
      "微服务解耦",
      "异步任务队列",
      "实时日志推送",
      "敏感信息加密存储",
      "项目维度数据隔离",
      "脚本模板化",
      "部署历史可追溯"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "Flask / FastAPI"
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design"
    },
    "database": "PostgreSQL",
    "message_queue": "RabbitMQ / Redis",
    "file_storage": "本地文件系统 / MinIO",
    "containerization": "Docker",
    "reverse_proxy": "Nginx"
  },
