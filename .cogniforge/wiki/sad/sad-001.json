{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-20 15:21",
    "version": 1
  },
  "system_overview": {
    "description": "实现将打包好的可执行文件自动化部署到指定远程服务器的功能。支持用户自定义多套部署环境（如测试线、灰度线、正式线等），每套环境可通过SSH密钥配置安全连接，部署时自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。用户可创建和管理多个项目，每个项目拥有独立的部署环境配置，支持在项目间灵活切换，满足多项目并行管理的需求。",
    "roles": [
      {
        "name": "开发工程师",
        "permissions": [
          "创建和管理多个项目",
          "配置多套部署环境（测试线、灰度线、正式线）",
          "上传和管理SSH密钥",
          "执行一键自动化部署",
          "查看部署进度和结果",
          "在项目间切换管理"
        ]
      },
      {
        "name": "运维工程师",
        "permissions": [
          "管理各环境的SSH密钥和服务器连接配置",
          "测试服务器连通性",
          "审核部署环境配置安全性",
          "管理远程服务器访问权限"
        ]
      }
    ]
  },
  "architecture": {
    "style": "前后端分离的模块化架构",
    "description": "系统采用前后端分离的模块化架构，前端提供Web UI交互界面，后端按业务领域划分为项目管理、环境管理、部署执行、密钥管理等核心服务模块。通过消息队列实现异步部署任务调度，结合加密存储保障密钥安全，支持多环境多服务器的自动化部署流程。",
    "features": [
      "前后端分离，独立部署和扩展",
      "模块化设计，各服务职责单一",
      "异步部署任务队列，支持并发和重试",
      "加密存储敏感信息（SSH密钥等）",
      "可插拔的环境配置管理",
      "实时部署状态推送"
    ]
  },
  "components": [
    {
      "name": "Web UI",
      "type": "frontend",
      "description": "基于Web的图形用户界面，提供项目管理、环境配置、部署操作和状态查看等功能",
      "responsibilities": [
        "项目列表展示与搜索筛选",
        "部署环境配置表单",
        "部署操作入口与进度展示",
        "SSH密钥上传管理界面",
        "部署历史与日志查看"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "统一API网关，负责请求路由、认证鉴权、限流和日志记录",
      "responsibilities": [
        "请求路由转发",
        "用户身份认证",
        "接口访问控制",
        "请求日志记录",
        "限流保护"
      ]
    },
    {
      "name": "Project Service",
      "type": "service",
      "description": "项目管理服务，负责项目的CRUD操作和项目间切换",
      "responsibilities": [
        "项目创建、编辑、删除",
        "项目列表查询与关键字搜索",
        "项目切换管理",
        "项目与环境的关联管理"
      ]
    },
    {
      "name": "Environment Service",
      "type": "service",
      "description": "环境管理服务，负责部署环境的配置管理和连通性测试",
      "responsibilities": [
        "环境创建、编辑、删除",
        "环境类型标签管理",
        "服务器地址、端口、用户名等连接信息配置",
        "连通性测试"
      ]
    },
    {
      "name": "Key Management Service",
      "type": "service",
      "description": "密钥管理服务，负责SSH密钥的安全存储和管理",
      "responsibilities": [
        "SSH密钥上传与存储",
        "密钥内容加密解密",
        "密钥与环境的关联管理",
        "密钥更换与轮转"
      ]
    },
    {
      "name": "Deployment Service",
      "type": "service",
      "description": "部署执行服务，负责自动化部署流程的编排和执行",
      "responsibilities": [
        "部署任务创建与调度",
        "可执行文件上传到远程服务器",
        "远程版本目录创建",
        "启动/停止/重启执行脚本生成",
        "部署状态跟踪与反馈"
      ]
    },
    {
      "name": "Message Queue",
      "type": "mq",
      "description": "消息队列，负责异步部署任务分发和状态变更通知",
      "responsibilities": [
        "部署任务异步分发",
        "部署状态变更通知推送",
        "失败任务重试机制"
      ]
    },
    {
      "name": "Relational Database",
      "type": "db",
      "description": "关系型数据库，存储项目、环境、密钥、部署记录等全部结构化数据",
      "responsibilities": [
        "项目数据持久化",
        "环境配置数据存储",
        "密钥元数据存储",
        "部署历史记录存储"
      ]
    },
    {
      "name": "Cache",
      "type": "cache",
      "description": "缓存服务，缓存项目列表、环境配置等热点数据，提升系统响应速度",
      "responsibilities": [
        "缓存项目列表数据",
        "缓存环境配置信息",
        "缓存用户会话信息"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "Project Management API",
      "provider": "Project Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST/GET/PUT/DELETE /api/projects[/{id}]",
      "request": {
        "path_params": [
          {"name": "id", "type": "string", "description": "项目ID（查询/更新/删除时必填）"}
        ],
        "query_params": [
          {"name": "keyword", "type": "string", "description": "搜索关键字", "required": false},
          {"name": "page", "type": "int", "description": "页码", "required": false},
          {"name": "size", "type": "int", "description": "每页条数", "required": false}
        ],
        "body": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "description": "项目名称"},
            "description": {"type": "string", "description": "项目描述", "required": false}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "description": "项目ID"},
            "name": {"type": "string", "description": "项目名称"},
            "description": {"type": "string", "description": "项目描述"},
            "environment_count": {"type": "int", "description": "关联环境数量"},
            "created_at": {"type": "string", "description": "创建时间"},
            "updated_at": {"type": "string", "description": "更新时间"}
          }
        }
      },
      "description": "项目管理相关CRUD接口，通过API Gateway路由至Project Service，支持项目的创建、查询、更新和删除"
    },
    {
      "interface": "Environment Configuration API",
      "provider": "Environment Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST/GET/PUT/DELETE /api/projects/{projectId}/environments[/{id}]",
      "request": {
        "path_params": [
          {"name": "projectId", "type": "string", "description": "所属项目ID"},
          {"name": "id", "type": "string", "description": "环境ID（查询/更新/删除时必填）"}
        ],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "description": "环境名称"},
            "label": {"type": "string", "description": "环境标签（测试线/灰度线/正式线）"},
            "server_host": {"type": "string", "description": "服务器地址"},
            "server_port": {"type": "int", "description": "SSH端口，默认22"},
            "server_user": {"type": "string", "description": "服务器登录用户名"},
            "key_id": {"type": "string", "description": "关联的SSH密钥ID"},
            "deploy_path": {"type": "string", "description": "远程部署基础路径"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "description": "环境ID"},
            "project_id": {"type": "string", "description": "所属项目ID"},
            "name": {"type": "string", "description": "环境名称"},
            "label": {"type": "string", "description": "环境标签"},
            "server_host": {"type": "string", "description": "服务器地址"},
            "server_port": {"type": "int", "description": "SSH端口"},
            "server_user": {"type": "string", "description": "登录用户名"},
            "key_id": {"type": "string", "description": "关联密钥ID"},
            "deploy_path": {"type": "string", "description": "部署路径"},
            "last_test_at": {"type": "string", "description": "上次连通性测试时间", "required": false},
            "created_at": {"type": "string", "description": "创建时间"}
          }
        }
      },
      "description": "环境配置管理接口，支持环境的CRUD操作以及连通性测试（POST /environments/{id}/test-connection）"
    },
    {
      "interface": "Key Management API",
      "provider": "Key Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST/GET/DELETE /api/keys[/{id}]",
      "request": {
        "path_params": [
          {"name": "id", "type": "string", "description": "密钥ID（查询/删除时必填）"}
        ],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "name": {"type": "string", "description": "密钥名称"},
            "private_key": {"type": "string", "description": "SSH私钥内容（上传时明文传输，服务端加密存储）"},
            "passphrase": {"type": "string", "description": "密钥口令（可选）", "required": false},
            "description": {"type": "string", "description": "密钥描述", "required": false}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "description": "密钥ID"},
            "name": {"type": "string", "description": "密钥名称"},
            "fingerprint": {"type": "string", "description": "密钥指纹"},
            "description": {"type": "string", "description": "密钥描述"},
            "created_at": {"type": "string", "description": "创建时间"}
          }
        }
      },
      "description": "SSH密钥管理接口，支持密钥的上传、列表查看、删除和轮换。密钥私钥内容在服务端加密存储，返回数据不包含私钥原文"
    },
    {
      "interface": "Deployment Execution API",
      "provider": "Deployment Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST/GET /api/deployments[/{id}]",
      "request": {
        "path_params": [
          {"name": "id", "type": "string", "description": "部署记录ID（状态查询时必填）"}
        ],
        "query_params": [
          {"name": "project_id", "type": "string", "description": "按项目筛选部署历史", "required": false},
          {"name": "environment_id", "type": "string", "description": "按环境筛选部署历史", "required": false},
          {"name": "page", "type": "int", "description": "页码", "required": false},
          {"name": "size", "type": "int", "description": "每页条数", "required": false}
        ],
        "body": {
          "type": "object",
          "properties": {
            "project_id": {"type": "string", "description": "目标项目ID"},
            "environment_id": {"type": "string", "description": "目标环境ID"},
            "version": {"type": "string", "description": "部署版本号"},
            "artifact": {"type": "binary", "description": "可执行文件（二进制上传）"},
            "description": {"type": "string", "description": "部署说明", "required": false}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "description": "部署记录ID"},
            "project_id": {"type": "string", "description": "项目ID"},
            "environment_id": {"type": "string", "description": "环境ID"},
            "version": {"type": "string", "description": "部署版本号"},
            "status": {"type": "string", "description": "部署状态（pending/running/success/failed）"},
            "progress": {"type": "int", "description": "部署进度百分比"},
            "log": {"type": "string", "description": "部署日志"},
            "created_at": {"type": "string", "description": "创建时间"},
            "completed_at": {"type": "string", "description": "完成时间", "required": false}
          }
        }
      },
      "description": "部署执行接口，POST触发一键部署（返回task_id用于后续状态轮询），GET查询部署状态和详情。支持按项目和环境筛选部署历史"
    },
    {
      "interface": "Deployment Task Queue",
      "provider": "Deployment Service",
      "consumers": ["Message Queue"],
      "type": "MQ",
      "endpoint": "queue://deployment.task",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "task_id": {"type": "string", "description": "部署任务唯一ID"},
            "project_id": {"type": "string", "description": "项目ID"},
            "environment_id": {"type": "string", "description": "环境ID"},
            "server_host": {"type": "string", "description": "目标服务器地址"},
            "server_port": {"type": "int", "description": "SSH端口"},
            "server_user": {"type": "string", "description": "登录用户名"},
            "encrypted_key": {"type": "string", "description": "加密后的SSH私钥"},
            "deploy_path": {"type": "string", "description": "远程部署基础路径"},
            "version": {"type": "string", "description": "部署版本号"},
            "artifact_url": {"type": "string", "description": "可执行文件存储URL"},
            "created_at": {"type": "string", "description": "任务创建时间"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "accepted": {"type": "bool", "description": "消息是否成功入队"}
          }
        }
      },
      "description": "部署任务异步消息队列。Deployment Service将包含全部部署参数的详细任务消息发布到MQ，由worker异步消费执行，支持消息持久化和失败重试"
    },
    {
      "interface": "Deployment Status Notification",
      "provider": "Message Queue",
      "consumers": ["Deployment Service"],
      "type": "MQ",
      "endpoint": "topic://deployment.status",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "task_id": {"type": "string", "description": "部署任务ID"},
            "status": {"type": "string", "description": "状态（running/success/failed）"},
            "progress": {"type": "int", "description": "进度百分比"},
            "log": {"type": "string", "description": "增量日志"},
            "timestamp": {"type": "string", "description": "状态时间戳"}
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "received": {"type": "bool", "description": "是否成功接收"}
          }
        }
      },
      "description": "部署状态变更通知。Deployment Service在执行过程中将状态变更事件发布到MQ，Deployment Service自身或其他消费者订阅以实时更新部署状态"
    }
  ],
  "topology": {
    "description": "系统采用四层拓扑结构：接入层提供Web UI和API统一入口，服务层包含全部核心业务服务，中间件层通过消息队列实现异步通信解耦，数据层负责持久化存储和热点缓存。",
    "layers": [
      {
        "name": "接入层",
        "components": ["Web UI", "API Gateway"]
      },
      {
        "name": "服务层",
        "components": ["Project Service", "Environment Service", "Key Management Service", "Deployment Service"]
      },
      {
        "name": "中间件层",
        "components": ["Message Queue"]
      },
      {
        "name": "数据层",
        "components": ["Relational Database", "Cache"]
      }
    ],
    "connections": [
      {"protocol": "HTTPS/REST", "description": "接入层与服务层通过HTTPS RESTful API通信"},
      {"protocol": "gRPC/REST", "description": "服务层内部服务间通过gRPC或REST同步调用"},
      {"protocol": "MQ/AMQP", "description": "服务层与中间件层通过AMQP协议进行异步消息通信"},
      {"protocol": "SQL/Redis", "description": "服务层与数据层通过SQL协议访问数据库，通过Redis协议访问缓存"}
    ]
  },
  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户在Web UI选择项目、环境和版本号，上传可执行文件",
        "API Gateway接收请求并转发至Deployment Service",
        "Deployment Service创建部署任务并返回task_id",
        "Deployment Service将任务发送到Message Queue异步执行",
        "Deployment Service从队列消费任务，通过SSH连接到远程服务器",
        "在远程服务器按版本号创建独立部署目录",
        "上传可执行文件到远程服务器",
        "生成启动/停止/重启等执行脚本",
        "通过Message Queue发送部署状态变更事件",
        "Web UI实时更新部署进度和结果"
      ]
    },
    {
      "name": "环境配置流程",
      "steps": [
        "用户填写环境配置表单（服务器地址、端口、用户名等）",
        "关联已上传的SSH密钥",
        "Environment Service测试远程服务器连通性",
        "配置信息保存到Relational Database",
        "结果返回前端确认"
      ]
    },
    {
      "name": "密钥管理流程",
      "steps": [
        "用户在Web UI上传SSH密钥或选择更换密钥",
        "API Gateway转发请求至Key Management Service",
        "Key Management Service对密钥私钥内容进行加密存储",
        "密钥元数据（非私钥原文）保存到Relational Database",
        "加密后的密钥与对应环境关联",
        "操作结果返回前端确认"
      ]
    }
  ]
}
