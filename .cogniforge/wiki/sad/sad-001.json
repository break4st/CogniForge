  "architecture_decisions": [
    {
      "id": "ADR-001",
      "title": "选择 Electron 架构",
      "date": "2026-05-24",
      "status": "accepted",
      "context": "需要跨平台的桌面应用，团队具有 Web 前端开发经验。",
      "decision": "采用 Electron 作为桌面框架，结合 React 构建 UI。",
      "consequences": "优点：开发效率高，跨平台一致性佳；缺点：资源占用略高，启动速度较原生差。"
    },
    {
      "id": "ADR-002",
      "title": "使用 better-sqlite3 同步 API",
      "date": "2026-05-24",
      "status": "accepted",
      "context": "本地数据存储需要简单、高效、无需异步处理。",
      "decision": "选择 better-sqlite3 作为 SQLite 驱动，采用同步调用。",
      "consequences": "优点：代码逻辑简单，无回调地狱；缺点：阻塞主线程，但数据量小影响可忽略。"
    },
    {
      "id": "ADR-003",
      "title": "IPC 通信模式设计",
      "date": "2026-05-24",
      "status": "accepted",
      "context": "渲染进程与主进程需要安全、异步的通信机制。",
      "decision": "采用 ipcRenderer.invoke / ipcMain.handle 进行请求-响应，并增加推送通道用于实时事件。",
      "consequences": "满足请求/响应和实时推送两种场景，保持架构清晰。"
    },
    {
      "id": "ADR-004",
      "title": "敏感信息加密方案",
      "date": "2026-05-24",
      "status": "accepted",
      "context": "密码和私钥必须加密存储。",
      "decision": "使用 AES-256-GCM 加密算法，主密钥可用 OS 密钥链或主密码派生。",
      "consequences": "强度高，性能损失小，但需妥善管理主密钥以防丢失。"
    }
  ],
  "risks": [
    {
      "id": "RISK-001",
      "description": "主密钥丢失导致所有加密数据不可恢复",
      "mitigation": "提示用户备份主密码，或强制使用 OS 密钥链（Keytar）存储，增加导出加密数据的选项。",
      "impact": "高",
      "probability": "低"
    },
    {
      "id": "RISK-002",
      "description": "SQLite 数据库文件损坏",
