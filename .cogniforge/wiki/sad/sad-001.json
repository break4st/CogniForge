{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-22 15:20"
  },
  "system_overview": {
    "description": "自动化部署系统提供将打包好的可执行文件一键部署到远程服务器的能力。支持多项目并行管理、多套部署环境（测试线、灰度线、正式线）独立配置、SSH密钥安全连接，部署时自动在远程服务器创建版本目录并生成启动/停止脚本，实现全流程自动化。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "管理部署环境（新增/编辑/删除测试线、灰度线、正式线）",
          "配置和管理SSH安全密钥",
          "选择可执行文件和目标环境触发一键部署",
          "查看部署结果和历史记录"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑和删除项目",
          "为项目关联多套部署环境",
          "在项目间切换查看部署配置和状态",
          "统筹管理多个项目的发布进度"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层单体架构（初期）+ 模块化演进",
    "description": "采用前后端分离的分层架构。前端为单页应用提供交互界面，后端按业务领域划分为环境管理、项目管理、部署执行、密钥管理、审计日志等模块。各模块通过REST API通信，部署执行引擎通过SSH协议与远程服务器交互。数据层使用关系型数据库存储项目和环境配置，密钥信息加密存储。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "Web管理控制台",
          "部署状态仪表盘",
          "项目切换导航"
        ]
      },
      {
        "name": "API网关层",
        "components": [
          "REST API Gateway",
          "认证中间件",
          "请求校验"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署执行服务",
          "密钥管理服务",
          "审计日志服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH连接池",
          "文件传输模块",
          "脚本生成引擎",
          "关系型数据库",
          "缓存"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "REST/HTTPS"
      },
      {
        "protocol": "REST/HTTP"
      },
      {
        "protocol": "SQL + Redis序列化协议 + SSH"
      }
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "模块化业务服务，职责单一",
      "密钥信息加密存储满足安全要求",
      "异步部署任务，支持状态轮询",
      "审计日志记录所有操作行为",
      "环境隔离，多项目数据隔离",
      "JWT令牌认证保障API安全",
      "SSH连接池复用提升部署效率"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI",
      "auth": "JWT",
      "orm": "SQLAlchemy"
    },
    "frontend": {
      "framework": "Vue.js 3",
      "ui_library": "Element Plus",
      "state_management": "Pinia",
      "build_tool": "Vite"
    },
    "database": "PostgreSQL 15+",
    "cache": "Redis 7+",
    "protocol": {
      "api": "REST/HTTPS",
      "remote_access": "SSH/SCP/SFTP",
      "data_access": "SQL"
    },
    "deployment": {
      "containerization": "Docker（可选）",
      "reverse_proxy": "Nginx"
    }
  },
  "components": [
    {
      "name": "Web管理控制台",
      "type": "frontend",
      "description": "基于SPA框架的浏览器端管理界面，提供项目、环境、部署等功能的操作面板",
      "responsibilities": [
        "提供用户登录和权限管理界面",
        "展示项目列表和环境配置",
        "触发一键部署操作并实时展示进度",
        "管理SSH密钥的增删改"
      ]
    },
    {
      "name": "部署状态仪表盘",
      "type": "frontend",
      "description": "展示部署任务的实时状态和运行历史的面板组件",
      "responsibilities": [
        "轮询部署任务状态并实时更新界面",
        "展示部署历史记录和详情",
        "高亮展示失败任务和异常信息"
      ]
    },
    {
      "name": "项目切换导航",
      "type": "frontend",
      "description": "项目列表切换导航组件，支持在多个项目间快速切换上下文",
      "responsibilities": [
        "展示用户有权限的所有项目列表",
        "切换时触发环境配置加载",
        "标识当前选中的活动项目"
      ]
    },
    {
      "name": "REST API Gateway",
      "type": "gateway",
      "description": "统一的API入口，负责路由分发、身份认证和请求校验",
      "responsibilities": [
        "请求路由到对应业务服务",
        "JWT令牌校验和用户身份识别",
        "请求参数校验与格式化",
        "跨域和安全性头处理"
      ]
    },
    {
      "name": "认证中间件",
      "type": "gateway",
      "description": "JWT令牌认证中间件，拦截未授权请求并验证访问令牌",
      "responsibilities": [
        "JWT令牌签发和刷新",
        "令牌有效性校验与过期处理",
        "用户身份注入请求上下文"
      ]
    },
    {
      "name": "请求校验",
      "type": "gateway",
      "description": "请求参数格式校验和数据清洗中间件",
      "responsibilities": [
        "请求参数类型和格式校验",
        "请求体Schema验证",
        "防止注入和恶意请求过滤"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "处理项目的CRUD操作以及项目与环境的关系管理",
      "responsibilities": [
        "创建、编辑、删除项目",
        "为项目关联/解绑部署环境",
        "查询项目列表和详情",
        "项目切换时加载对应环境数据"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理部署环境的配置，包括连接参数和环境类型",
      "responsibilities": [
        "新增、编辑、删除部署环境",
        "管理环境类型标签（测试/灰度/正式）",
        "维护环境与项目的关联关系",
        "验证环境连接可用性"
      ]
    },
    {
      "name": "部署执行服务",
      "type": "service",
      "description": "核心部署引擎，负责版本目录创建、文件传输和脚本生成",
      "responsibilities": [
        "接收部署请求并创建部署任务",
        "在远程服务器创建带版本号的目录结构",
        "传输可执行文件和配置文件",
        "生成启动脚本和停止脚本",
        "收集部署结果并反馈状态"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "SSH密钥的安全存储和管理，包括加密和解密操作",
      "responsibilities": [
        "SSH密钥的加密存储",
        "密钥的添加、更新和删除",
        "部署时提供解密后的密钥用于连接",
        "密钥访问权限控制"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录所有用户操作和系统事件的审计轨迹",
      "responsibilities": [
        "记录部署操作的全过程日志",
        "记录项目和环境的配置变更",
        "记录密钥操作的安全事件",
        "提供日志查询和导出功能"
      ]
    },
    {
      "name": "SSH连接池",
      "type": "service",
      "description": "管理到远程服务器的SSH连接复用，避免频繁建立连接",
      "responsibilities": [
        "SSH连接的生命周期管理",
        "连接复用和超时回收",
        "断线重连机制",
        "连接健康检查"
      ]
    },
    {
      "name": "文件传输模块",
      "type": "service",
      "description": "通过SCP/SFTP协议将可执行文件和配置传输到远程服务器",
      "responsibilities": [
        "上传可执行文件到目标目录",
        "传输配置文件和脚本",
        "大文件分片传输支持",
        "传输完整性校验"
      ]
    },
    {
      "name": "脚本生成引擎",
      "type": "service",
      "description": "根据部署上下文自动生成远程服务器上的启动和停止脚本",
      "responsibilities": [
        "根据应用类型生成启动脚本模板",
        "生成停止脚本",
        "支持自定义脚本扩展",
        "脚本语法校验"
      ]
    },
    {
      "name": "关系型数据库",
      "type": "database",
      "description": "存储项目、环境、部署记录等结构化数据",
      "responsibilities": [
        "项目数据持久化",
        "环境配置持久化",
        "部署历史记录存储",
        "审计日志存储",
        "加密密钥密文存储"
      ]
    },
    {
      "name": "缓存",
      "type": "infrastructure",
      "description": "缓存会话信息和频繁读取的配置数据",
      "responsibilities": [
        "用户会话状态缓存",
        "项目列表缓存",
        "环境配置缓存",
        "部署任务状态临时存储"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "项目管理API",
      "provider": "REST API Gateway",
      "consumers": [
        "Web管理控制台"
      ],
      "type": "REST",
      "endpoint": "GET/POST /api/projects | PUT/DELETE /api/projects/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "integer",
            "description": "项目ID"
          }
        ],
        "query_params": [
          {
            "name": "page",
            "type": "integer",
            "description": "分页页码"
          },
          {
            "name": "size",
            "type": "integer",
            "description": "每页数量"
          }
        ],
        "body": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "项目名称"
            },
            "description": {
              "type": "string",
              "description": "项目描述"
            },
            "env_ids": {
              "type": "array",
              "items": "integer",
              "description": "关联环境ID列表"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "environments": {
              "type": "array"
            }
          }
        }
      },
      "description": "项目CRUD接口，由REST API Gateway统一暴露给前端"
    },
    {
      "interface": "环境管理API",
      "provider": "REST API Gateway",
      "consumers": [
        "Web管理控制台"
      ],
      "type": "REST",
      "endpoint": "GET/POST /api/environments | PUT/DELETE /api/environments/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "integer",
            "description": "环境ID"
          }
        ],
        "query_params": [
          {
            "name": "project_id",
            "type": "integer",
            "description": "按项目过滤环境"
          }
        ],
        "body": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "环境名称"
            },
            "type": {
              "type": "string",
              "enum": [
                "test",
                "gray",
                "production"
              ],
              "description": "环境类型"
            },
            "host": {
              "type": "string",
              "description": "服务器地址"
            },
            "port": {
              "type": "integer",
              "description": "SSH端口"
            },
            "key_id": {
              "type": "integer",
              "description": "关联密钥ID"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "status": {
              "type": "string"
            }
          }
        }
      },
      "description": "环境CRUD接口，支持按项目过滤查询"
    },
    {
      "interface": "一键部署API",
      "provider": "REST API Gateway",
      "consumers": [
        "Web管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/deploy",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "integer",
              "description": "目标项目ID"
            },
            "env_id": {
              "type": "integer",
              "description": "目标环境ID"
            },
            "artifact_path": {
              "type": "string",
              "description": "可执行文件路径"
            },
            "config_path": {
              "type": "string",
              "description": "配置文件路径（可选）"
            },
            "version": {
              "type": "string",
              "description": "自定义版本号（可选，默认自动生成）"
            }
          },
          "required": [
            "project_id",
            "env_id",
            "artifact_path"
          ]
        }
      },
      "response": {
        "status": 202,
        "body": {
          "type": "object",
          "properties": {
            "deploy_id": {
              "type": "string",
              "description": "部署任务ID"
            },
            "status": {
              "type": "string",
              "description": "任务状态（pending）"
            },
            "version": {
              "type": "string",
              "description": "生成的版本号"
            }
          }
        }
      },
      "description": "触发一键部署，创建异步部署任务并返回任务ID用于状态轮询"
    },
    {
      "interface": "部署状态查询API",
      "provider": "REST API Gateway",
      "consumers": [
        "部署状态仪表盘"
      ],
      "type": "REST",
      "endpoint": "GET /api/deploy/{deploy_id}/status",
      "request": {
        "path_params": [
          {
            "name": "deploy_id",
            "type": "string",
            "description": "部署任务ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "deploy_id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "running",
                "success",
                "failed"
              ]
            },
            "progress": {
              "type": "integer",
              "description": "进度百分比"
            },
            "logs": {
              "type": "array",
              "items": "string",
              "description": "部署日志"
            },
            "started_at": {
              "type": "string",
              "format": "datetime"
            },
            "finished_at": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      },
      "description": "前端轮询部署任务状态和进度"
    },
    {
      "interface": "密钥管理API",
      "provider": "REST API Gateway",
      "consumers": [
        "Web管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/keys | GET/PUT/DELETE /api/keys/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "integer",
            "description": "密钥ID"
          }
        ],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "密钥名称"
            },
            "key_content": {
              "type": "string",
              "description": "密钥内容（PEM格式）"
            },
            "description": {
              "type": "string",
              "description": "密钥备注"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string",
              "description": "密钥指纹"
            }
          }
        }
      },
      "description": "SSH密钥CRUD接口，密钥内容传输后服务端加密存储"
    },
    {
      "interface": "审计日志查询API",
      "provider": "REST API Gateway",
      "consumers": [
        "Web管理控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/audit-logs",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "page",
            "type": "integer",
            "description": "分页页码"
          },
          {
            "name": "size",
            "type": "integer",
            "description": "每页数量"
          },
          {
            "name": "action_type",
            "type": "string",
            "description": "操作类型过滤"
          },
          {
            "name": "project_id",
            "type": "integer",
            "description": "按项目过滤"
          },
          {
            "name": "start_time",
            "type": "string",
            "description": "开始时间"
          },
          {
            "name": "end_time",
            "type": "string",
            "description": "结束时间"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "action": {
                    "type": "string"
                  },
                  "operator": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "created_at": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "description": "审计日志分页查询与导出接口"
    },
    {
      "interface": "获取解密密钥",
      "provider": "密钥管理服务",
      "consumers": [
        "部署执行服务"
      ],
      "type": "REST",
      "endpoint": "GET /internal/keys/{key_id}/decrypt",
      "request": {
        "path_params": [
          {
            "name": "key_id",
            "type": "integer",
            "description": "密钥ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "key_id": {
              "type": "integer"
            },
            "decrypted_key": {
              "type": "string",
              "description": "解密后的密钥明文（内存级临时返回）"
            },
            "expires_in": {
              "type": "integer",
              "description": "有效期（秒）"
            }
          }
        }
      },
      "description": "内部接口，部署执行服务在部署时调用以获取解密后的SSH密钥"
    },
    {
      "interface": "SSH连接管理",
      "provider": "SSH连接池",
      "consumers": [
        "部署执行服务"
      ],
      "type": "REST",
      "endpoint": "POST /internal/ssh/connect | POST /internal/ssh/exec",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "key_content": {
              "type": "string"
            },
            "command": {
              "type": "string",
