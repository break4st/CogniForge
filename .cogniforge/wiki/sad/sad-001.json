  "title": "基于已批准的 PRD 文档，自动设计系统架构方案",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "CogniDeploy 是一套面向开发与运维团队的自动化部署平台，统一管理多套部署环境、通过 SSH 安全连接远程服务器、一键将本地可执行文件部署并生成版本目录与启动脚本，同时提供完整的部署历史追踪。系统支持多项目独立管理，且对环境配置、私钥进行加密保存，保障安全性。",
    "roles": [
      {
        "name": "开发工程师",
        "permissions": [
          "创建、编辑、删除部署环境（含 SSH 私钥配置）",
          "创建和管理项目",
          "触发一键部署",
          "查看部署进度与日志"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "执行环境连通性测试",
          "查看部署历史与详细日志",
          "管理服务器侧文件夹权限"
        ]
      },
      {
        "name": "多项目管理者",
        "permissions": [
          "创建多个项目",
          "为项目绑定/解绑环境",
          "切换项目上下文",
          "确保不同项目环境隔离"
        ]
      },
      {
        "name": "安全审计员",
        "permissions": [
          "查看系统的密钥管理策略（不可查看明文）",
          "审查部署历史",
          "确保系统满足安全基线"
        ]
      }
    ]
  },
  "architecture": {
    "style": "模块化单体 + 前后端分离",
    "description": "采用一个内部松耦合的单体后端（逻辑上划分为多个领域服务模块），配合清晰的前后端分离模式。后端各模块通过内部 API 交互，但对外暴露统一 RESTful API。部署执行采用 Celery 异步任务队列以保证非阻塞。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "Web前端SPA"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "Nginx反向代理"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "环境管理服务",
          "连通性测试服务",
          "项目管理服务",
          "部署编排器",
          "远程版本与脚本生成器",
          "部署历史与日志服务",
          "密钥管理组件",
          "进度通知器"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL数据库",
          "Redis缓存"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / WSS / SSE",
        "description": "前端与网关之间的安全通信，支持实时事件流"
      },
      {
        "protocol": "HTTPS / REST",
        "description": "网关将请求转发到后端 FastAPI 服务"
      },
      {
        "protocol": "内部函数调用 / AMQP (Celery)",
        "description": "服务层内部模块间通信，部署任务使用 Celery 消息队列异步执行"
      },
      {
        "protocol": "SQL",
        "description": "服务层通过 ORM 访问 PostgreSQL 数据库"
      },
      {
        "protocol": "Redis Protocol",
        "description": "Celery broker 与结果后端，以及进度通知的 pub/sub"
      }
    ],
    "features": [
      "高安全：私钥 AES-256 加密存储，传输过程仅内存处理",
      "实时反馈：部署进度通过 SSE 推送至前端",
      "多项目隔离：环境绑定与部署操作完全隔离",
      "可追溯：全量部署历史记录，支持过滤",
      "易用性：一键部署，清晰进度与错误提示",
      "可扩展：环境、项目、部署服务各自解耦"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI",
      "async_task": "Celery (Redis broker)",
      "ssh_library": "Paramiko",
      "encryption": "cryptography (AES-256-GCM)"
    },
    "frontend": {
      "framework": "React 18 + TypeScript",
      "ui_library": "Ant Design 5",
      "state_management": "Zustand",
      "realtime": "EventSource (SSE)"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "gateway": "Nginx"
  },
