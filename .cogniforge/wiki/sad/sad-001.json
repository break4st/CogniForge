        "在远程服务器上创建版本化目录（如 /opt/app/releases/v1.0.0/）",
        "上传可执行文件包到版本目录",
        "自动生成 start.sh、stop.sh、restart.sh 执行脚本",
        "执行启动脚本完成部署",
        "实时回传部署进度和日志到 Web 控制台",
        "Web 控制台轮询 GET /api/v1/deploy/:taskId/status 展示进度",
        "部署成功或失败后更新任务状态",
        "审计日志服务记录完整部署过程"
      ]
    },
    {
      "name": "项目切换",
      "steps": [
        "用户在 Web 控制台的项目列表中选择目标项目",
        "前端切换当前上下文，展示选中项目的仪表盘",
        "自动加载该项目的环境列表和部署历史",
        "用户可在新项目下执行环境配置和部署操作",
        "所有后续 API 请求携带当前项目 ID 上下文"
      ]
    }
  ]
}