  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "1. 桌面客户端发送 POST /api/deployments 请求，携带 project_id 和 environment_id。",
        "2. API网关转发请求到部署引擎。",
        "3. 部署引擎创建 pending 状态的部署记录，并立即返回202及 deployment_id。",
        "4. 客户端建立 WebSocket 连接到 ws://.../logs/{deployment_id}。",
        "5. 部署引擎异步执行：检查本地产物 -> SSH连接远程 -> 创建版本目录 -> SFTP上传文件 -> 执行前置脚本 -> 执行后置脚本 -> 更新软链接。",
        "6. 每一步输出通过回调发送给日志服务。",
        "7. 日志服务存储日志并推送实时条目到客户端。",
        "8. 所有步骤成功后，部署状态标记为 success，版本历史服务创建版本记录；若失败则标记 failed 并记录错误。",
        "9. 日志服务推送最终状态消息，WebSocket连接关闭。"
      ]
    },
    {
      "name": "版本回滚流程",
      "steps": [
        "1. 用户在客户端版本历史界面选择成功版本，确认回滚。",
        "2. 客户端发送 POST /api/deployments/{id}/rollback 请求。",
        "3. 版本历史服务验证该版本状态为 success。",
        "4. 通过 SSH 连接管理器登录远程服务器，执行回滚脚本或默认切换当前软链接指向目标版本目录。",
        "5. 成功后，生成一条新的 Deployment 记录，type=rollback, status=success，并记录时间。",
        "6. 返回成功响应给客户端，界面刷新版本列表。"
      ]
    },
    {
      "name": "环境测试连接",
      "steps": [
        "1. 用户在环境编辑表单点击“测试连接”。",
        "2. 客户端发送 POST /api/environments/{id}/test-connection 请求。",
        "3. 环境管理服务获取环境配置，调用 SSH 连接管理器尝试连接。",
        "4. 连接成功则返回200，失败则返回502并携带详细错误信息。"
      ]
    }
  ],
