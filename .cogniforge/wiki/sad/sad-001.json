  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "前端用户选择项目、环境、本地文件，点击部署",
        "前端发送 POST /api/projects/{id}/deploy 携带参数",
        "DeploymentOrchestrator 校验文件、获取环境配置、生成部署摘要",
        "返回 deployment_id 并提交 Celery 异步任务",
        "Celery Worker 解密私钥 → 建立 SSH 连接 → 创建远程目录 → 上传文件 → 生成启动脚本",
        "ProgressNotifier 通过 SSE 向前端实时推送进度",
        "任务完成或失败后，将结果和日志写入 DeploymentHistory",
        "前端 SSE 监听，动态更新进度条与状态"
      ]
    },
    {
      "name": "环境创建与连通性测试",
      "steps": [
        "前端环境表单填写信息，提交创建请求",
        "EnvironmentService 接收，调用 KeyManager 加密私钥",
        "自动触发 ConnectivityTester 执行 TCP/SSH/写权限测试",
        "测试通过才允许保存环境记录",
        "测试失败则返回详细错误，阻止保存"
      ]
    },
    {
      "name": "项目多环境绑定",
      "steps": [
        "用户在项目管理页面选择一个项目",
        "从全局环境池中选择环境进行绑定",
        "后端 ProjectService 更新绑定关系表",
        "前端切换项目时，部署面板仅显示该项目绑定的环境"
      ]
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "Environment",
      "description": "存储部署环境配置信息，包括服务器地址、端口和加密后的私钥。",
      "source_requirements": [
        "REQ-001"
      ],
      "fields": [
        {
          "name": "id",
          "type": "integer (PK)",
          "required": true,
          "description": "环境唯一标识"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "环境名称，唯一"
        },
        {
          "name": "server_address",
          "type": "string",
          "required": true,
          "description": "服务器 IP 或域名"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "SSH 端口，默认 22"
        },
        {
          "name": "auth_type",
          "type": "string",
          "required": true,
          "description": "认证类型，固定为'ssh_key'"
        },
        {
          "name": "encrypted_private_key",
          "type": "text",
          "required": true,
          "description": "AES-256 加密后的私钥密文"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "required": true,
          "description": "最后更新时间"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "Project",
      "description": "项目基本单元，用于隔离不同业务的部署配置。",
      "source_requirements": [
        "REQ-003"
      ],
      "fields": [
        {
          "name": "id",
          "type": "integer (PK)",
          "required": true,
          "description": "项目唯一标识"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "项目名称，唯一"
        },
        {
          "name": "description",
          "type": "text",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "创建时间"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "ProjectEnvironmentBinding",
      "description": "项目和环境的绑定关系表，多对多关联。",
      "source_requirements": [
        "REQ-003",
        "REQ-007"
      ],
      "fields": [
        {
          "name": "id",
          "type": "integer (PK)",
          "required": true,
          "description": "绑定记录 ID"
        },
        {
          "name": "project_id",
          "type": "integer (FK)",
          "required": true,
          "description": "关联的项目 ID"
        },
        {
          "name": "environment_id",
          "type": "integer (FK)",
          "required": true,
          "description": "关联的环境 ID"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "绑定时间"
        }
      ]
    },
    {
      "id": "DM-004",
      "name": "DeploymentHistory",
      "description": "记录每次部署的详细信息，用于追溯和重新部署。",
      "source_requirements": [
        "REQ-006"
      ],
      "fields": [
        {
          "name": "id",
          "type": "string (UUID)",
          "required": true,
          "description": "部署历史唯一标识"
        },
        {
          "name": "project_id",
          "type": "integer (FK)",
          "required": true,
          "description": "所属项目 ID"
        },
        {
          "name": "environment_id",
          "type": "integer (FK)",
          "required": true,
          "description": "目标环境 ID"
        },
        {
          "name": "local_file_path",
          "type": "string",
          "required": true,
          "description": "部署的本地文件路径"
        },
        {
          "name": "remote_path",
          "type": "string",
          "required": true,
          "description": "远程部署目标路径"
        },
        {
          "name": "version_folder",
          "type": "string",
          "required": true,
          "description": "生成的版本文件夹名称"
        },
        {
          "name": "deployed_at",
          "type": "datetime",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "duration",
          "type": "integer",
          "required": false,
          "description": "消耗时间（秒）"
        },
        {
          "name": "status",
          "type": "enum(pending, in_progress, success, failed)",
          "required": true,
          "description": "部署状态"
        },
        {
          "name": "failure_reason",
          "type": "text",
          "required": false,
          "description": "失败原因"
        },
        {
          "name": "log",
          "type": "text",
          "required": false,
          "description": "完整执行日志"
        },
        {
          "name": "auto_executed",
          "type": "boolean",
          "required": true,
          "description": "是否在部署完成后自动运行脚本"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "记录创建时间"
        }
      ]
    }
