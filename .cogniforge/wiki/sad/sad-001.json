  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "本系统采用前后端分离的 Web 架构，核心为后端 API 服务 + 前端单页应用，并引入异步任务执行和实时日志推送机制。系统角色目前统一为“用户”，拥有全部操作权限。用户通过浏览器界面完成项目和环境的配置、部署触发、历史查看与回滚等全部功能。后端负责数据持久化、SSH 安全连接、文件传输、版本化管理以及日志实时推送。整体追求轻量、易部署、易扩展。",
    "roles": [
      {
        "name": "用户",
        "permissions": [
          "项目管理（创建、编辑、删除）",
          "环境管理（创建、编辑、删除）",
          "密钥管理（添加、删除、测试连接）",
          "触发部署与查看实时日志",
          "查看部署历史与执行回滚"
        ]
      }
    ]
  },
  "architecture": {
    "style": "前后端分离 + 异步任务执行 + 实时通信",
    "description": "系统逻辑上划分为接入层、服务层和实时通道。接入层使用 Nginx 提供静态资源和反向代理；服务层包含后端 API 服务、部署执行器、SSH 客户端模块和密钥加密服务；数据层采用 PostgreSQL；实时通道通过 WebSocket 集成于 API 服务中。后端 API 处理同步 CRUD 请求，部署任务异步执行并通过 WebSocket 向前端推送实时日志。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "Nginx 反向代理服务器"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "后端 API 服务",
          "部署执行器",
          "SSH 客户端模块",
          "密钥加密服务"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL 数据库"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS",
        "description": "前端通过 HTTPS 访问 Nginx，Nginx 将 API 请求反向代理至后端 API 服务。"
      },
      {
        "protocol": "WebSocket (wss)",
        "description": "前端通过 Nginx 代理的 WebSocket 连接到后端 API 服务的 WebSocket 端点，用于实时日志推送。"
      },
      {
        "protocol": "REST",
        "description": "后端 API 服务通过 REST 接口调用部署执行器（部署触发、状态查询等），内部实现可采用进程内调用或轻量消息队列。"
      },
      {
        "protocol": "SQL",
        "description": "后端 API 服务通过数据库驱动与 PostgreSQL 进行数据持久化交互。"
      },
      {
        "protocol": "SSH/SFTP",
        "description": "部署执行器通过 SSH 客户端模块与远程目标服务器通信，执行连接、文件传输和命令执行。"
      }
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "部署流程异步化，不阻塞用户请求",
      "WebSocket 实现实时日志推送",
      "SSH 密钥加密存储保障安全",
      "远程服务器版本化目录管理",
      "通过符号链接实现快速回滚",
      "Nginx 反向代理提供统一入口和负载均衡能力"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL",
    "reverse_proxy": "Nginx",
    "async_task": {
      "library": "Python asyncio 配合后台任务（FastAPI BackgroundTasks）或 Celery（可选）"
    },
    "ssh_library": "Paramiko",
    "encryption": "cryptography 库 (AES-256)"
  },
