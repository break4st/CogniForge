{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "系统架构方案",
    "author": "architect_agent",
    "created": "2026-05-23 22:38",
    "version": 1
  },
  "system_overview": {
    "description": "本平台定位为本地运行的 Web 应用，旨在为开发、运维、发布等角色提供一站式的项目、环境与部署管理工具。用户通过浏览器访问本地服务，完成项目创建、多环境配置、基于 SSH 的自动化部署、版本历史追溯与一键回滚等操作。系统强调安全与溯源，所有 SSH 密钥加密存储且仅在内存中使用，部署过程全程留痕。",
    "roles": [
      {
        "name": "管理员",
        "permissions": [
          "项目管理（增删改查）",
          "环境配置管理",
          "密钥管理",
          "部署执行",
          "回滚操作",
          "脚本模板管理",
          "历史记录查看"
        ]
      }
    ]
  },
  "architecture": {
    "style": "本地 B/S 架构（前后端分离）",
    "description": "前端负责交互与展示，后端负责业务逻辑、安全代理及持久化，两者通过 RESTful API 通信。接入层基于 React 的单页应用，服务层基于 Python FastAPI，数据层采用 SQLite 与本地文件系统。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "Web 前端 UI",
          "API 网关/认证"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "项目管理服务",
          "环境配置服务",
          "密钥管理服务",
          "部署执行引擎",
          "脚本模板服务",
          "版本历史服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH 客户端模块",
          "数据库访问层",
          "文件存储管理"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTP/JSON REST API"
      },
      {
        "protocol": "Python 函数调用 / SQL / 文件 I/O"
      }
    ],
    "features": [
      "本地优先，单机存储",
      "前后端分离，异步实时推送",
      "密钥加密存储，内存解密使用",
      "部署全步骤日志记录与回滚",
      "脚本模板化，支持环境变量注入",
      "轻量 SQLite，可扩展至 PostgreSQL"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.10+",
      "framework": "FastAPI",
      "orm": "SQLAlchemy",
      "ssh_lib": "asyncssh / paramiko"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5",
      "state_mgmt": "Zustand / React Context",
      "build_tool": "Vite"
    },
    "database": "SQLite",
    "file_storage": "本地文件系统",
    "security": "cryptography (AES-256)",
    "server": "Uvicorn"
  },
  "components": [
    {
      "id": "CMP-001",
      "name": "Web 前端 UI",
      "type": "frontend",
      "description": "提供项目管理、环境配置、部署操作、历史回滚、密钥管理、模板编辑等可视化界面；实时回显部署日志。",
      "responsibilities": [
        "渲染用户界面",
        "接收用户输入并调用后端 API",
        "展示实时部署日志（SSE）",
        "管理前端路由与状态"
      ]
    },
    {
      "id": "CMP-002",
      "name": "API 网关/认证",
      "type": "gateway",
      "description": "统一接收前端请求，进行基础请求校验；未来可接入本地 token 认证，当前提供透传功能。",
      "responsibilities": [
        "路由转发",
        "基础参数校验",
        "(未来) 认证鉴权"
      ]
    },
    {
      "id": "CMP-003",
      "name": "项目管理服务",
      "type": "service",
      "description": "负责项目的增删改查、项目间切换上下文逻辑。",
      "responsibilities": [
        "创建项目",
        "编辑项目",
        "删除项目（校验关联环境）",
        "查询项目列表",
        "切换当前激活项目"
      ]
    },
    {
      "id": "CMP-004",
      "name": "环境配置服务",
      "type": "service",
      "description": "管理每个项目下的多套环境（主机、端口、认证方式、部署路径、环境变量等），提供连接测试。",
      "responsibilities": [
        "增删改查环境配置",
        "测试 SSH 连接",
        "管理环境变量键值对",
        "绑定密钥"
      ]
    },
    {
      "id": "CMP-005",
      "name": "密钥管理服务",
      "type": "service",
      "description": "支持导入、生成密钥对；使用主密钥加密存储私钥；提供解密接口（仅内存传输）。",
      "responsibilities": [
        "导入 SSH 私钥",
        "生成密钥对",
        "加密存储私钥",
        "解密私钥供内部调用",
        "删除密钥"
      ]
    },
    {
      "id": "CMP-006",
      "name": "部署执行引擎",
      "type": "service",
      "description": "接收部署请求，按步骤执行 SSH 连接、文件夹创建、文件上传、压缩包解压、脚本生成、钩子执行；实时推送日志。",
      "responsibilities": [
        "解析部署请求",
        "协调 SSH 客户端执行步骤",
        "调用脚本模板服务渲染脚本",
        "管理部署流程生命周期",
        "推送实时日志"
      ]
    },
    {
      "id": "CMP-007",
      "name": "脚本模板服务",
      "type": "service",
      "description": "管理默认及自定义的启动/停止/检查脚本模板，支持环境变量渲染。",
      "responsibilities": [
        "存储和检索模板",
        "渲染模板（注入环境变量、端口等）",
        "模板版本管理"
      ]
    },
    {
      "id": "CMP-008",
      "name": "版本历史服务",
      "type": "service",
      "description": "记录每次部署的元信息（版本、环境、时间、状态、校验码）；提供回滚触发逻辑。",
      "responsibilities": [
        "记录部署历史",
        "查询部署历史",
        "处理回滚请求",
        "验证目标版本存在性"
      ]
    },
    {
      "id": "CMP-009",
      "name": "SSH 客户端模块",
      "type": "infrastructure",
      "description": "封装 SSH 连接、命令执行、文件传输（SFTP）功能，供部署引擎和环境服务调用。",
      "responsibilities": [
        "建立 SSH 连接（密钥认证）",
        "执行远程命令",
        "SFTP 文件上传/下载",
        "管理连接会话"
      ]
    },
    {
      "id": "CMP-010",
      "name": "数据库访问层",
      "type": "infrastructure",
      "description": "通过 ORM 提供对 SQLite 的 CRUD 操作，管理项目、环境、部署历史、模板等实体。",
      "responsibilities": [
        "ORM 实体定义",
        "会话管理",
        "数据查询与持久化",
        "数据库迁移"
      ]
    },
    {
      "id": "CMP-011",
      "name": "文件存储管理",
      "type": "infrastructure",
      "description": "管理密钥文件、部署包暂存区、模板文件的本地读写。",
      "responsibilities": [
        "安全读写加密密钥文件",
        "暂存上传的部署包",
        "清理过期文件",
        "管理模板文件存储"
      ]
    }
  ],
  "contracts": [
    {
      "id": "CTR-001",
      "interface": "获取项目列表",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "search",
            "type": "string",
            "required": false,
            "desc": "按名称搜索"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "projects": [
            {
              "id": "int",
              "name": "string",
              "description": "string",
              "created_at": "string"
            }
          ]
        }
      },
      "description": "返回所有项目列表，支持按名称模糊搜索"
    },
    {
      "id": "CTR-002",
      "interface": "创建项目",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string (必填)",
          "description": "string (可选)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "description": "string",
          "created_at": "string"
        }
      },
      "description": "新建项目，名称不能重复"
    },
    {
      "id": "CTR-003",
      "interface": "编辑项目",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "PUT /api/projects/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string",
          "description": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "name": "string",
          "description": "string"
        }
      },
      "description": "更新指定项目信息"
    },
    {
      "id": "CTR-004",
      "interface": "删除项目",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "DELETE /api/projects/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204
      },
      "description": "删除项目，若有关联环境返回 409 并要求确认"
    },
    {
      "id": "CTR-005",
      "interface": "获取环境列表",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/projects/{project_id}/environments",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "environments": [
            {
              "id": "int",
              "name": "string",
              "host": "string",
              "port": "int",
              "auth_type": "string",
              "deploy_root": "string",
              "env_vars": "object"
            }
          ]
        }
      },
      "description": "获取指定项目下的所有环境配置"
    },
    {
      "id": "CTR-006",
      "interface": "创建环境",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/projects/{project_id}/environments",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string",
          "host": "string",
          "port": "int",
          "auth_type": "string",
          "key_id": "int?",
          "password": "string?",
          "deploy_root": "string",
          "env_vars": "object?"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "host": "string"
        }
      },
      "description": "在指定项目下新建环境"
    },
    {
      "id": "CTR-007",
      "interface": "编辑环境",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "PUT /api/environments/{env_id}",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string",
          "host": "string",
          "port": "int",
          "deploy_root": "string",
          "env_vars": "object"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "name": "string"
        }
      },
      "description": "更新环境配置"
    },
    {
      "id": "CTR-008",
      "interface": "删除环境",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "DELETE /api/environments/{env_id}",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204
      },
      "description": "删除指定环境"
    },
    {
      "id": "CTR-009",
      "interface": "测试环境连接",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/environments/{env_id}/test-connection",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "success": "bool",
          "message": "string"
        }
      },
      "description": "测试能否通过 SSH 连接目标主机"
    },
    {
      "id": "CTR-010",
      "interface": "获取密钥列表",
      "provider": "密钥管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "keys": [
            {
              "id": "int",
              "name": "string",
              "fingerprint": "string",
              "type": "string",
              "created_at": "string"
            }
          ]
        }
      },
      "description": "列出所有已存储的密钥名称及指纹，不返回私钥内容"
    },
    {
      "id": "CTR-011",
      "interface": "导入/生成密钥",
      "provider": "密钥管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "type": "string (import | generate)",
          "private_key": "string? (导入时必填)",
          "passphrase": "string?"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "fingerprint": "string",
          "public_key": "string (如果是生成密钥)"
        }
      },
      "description": "导入已有私钥或生成新密钥对，私钥被加密存储"
    },
    {
      "id": "CTR-012",
      "interface": "删除密钥",
      "provider": "密钥管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "DELETE /api/keys/{key_id}",
      "request": {
        "path_params": [
          {
            "name": "key_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204
      },
      "description": "删除指定密钥，若被环境引用则返回错误"
    },
    {
      "id": "CTR-013",
      "interface": "触发部署",
      "provider": "部署执行引擎",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/deploy",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "int",
          "environment_id": "int",
          "version": "string (可选)",
          "file": "binary (multipart/form-data)",
          "hooks": "object? (可选)"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "task_id": "string",
          "status": "string"
        }
      },
      "description": "接受部署请求，返回异步任务 ID，前端通过 SSE 订阅日志"
    },
    {
      "id": "CTR-014",
      "interface": "部署日志推送",
      "provider": "部署执行引擎",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/deploy/logs/{task_id}",
      "request": {
        "path_params": [
          {
            "name": "task_id",
            "type": "string"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": "SSE 流，每条消息包含 step 和 message"
      },
      "description": "通过 Server-Sent Events 实时推送部署步骤日志"
    },
    {
      "id": "CTR-015",
      "interface": "获取部署历史",
      "provider": "版本历史服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/environments/{env_id}/deployments",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "type": "int"
          }
        ],
        "query_params": [
          {
            "name": "version",
            "type": "string",
            "required": false
          },
          {
            "name": "start_date",
            "type": "string",
            "required": false
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "deployments": [
            {
              "id": "int",
              "version": "string",
              "environment_id": "int",
              "status": "string",
              "md5": "string",
              "created_at": "string",
              "operator": "string"
            }
          ]
        }
      },
      "description": "按环境查询历史部署记录，支持版本和时间过滤"
    },
    {
      "id": "CTR-016",
      "interface": "执行回滚",
      "provider": "版本历史服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/deploy/rollback",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "deployment_id": "int"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "task_id": "string",
          "message": "string"
        }
      },
      "description": "对指定的成功部署记录发起回滚，返回新任务 ID 并推送日志"
    },
    {
      "id": "CTR-017",
      "interface": "获取脚本模板",
      "provider": "脚本模板服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/templates",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "project_id",
            "type": "int",
            "required": false
          },
          {
            "name": "scope",
            "type": "string (project | environment)",
            "required": false
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "templates": [
            {
              "id": "int",
              "name": "string",
              "content": "string",
              "scope": "string",
              "version": "int"
            }
          ]
        }
      },
      "description": "获取默认或项目/环境级别的脚本模板"
    },
    {
      "id": "CTR-018",
      "interface": "更新脚本模板",
      "provider": "脚本模板服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "PUT /api/templates/{template_id}",
      "request": {
        "path_params": [
          {
            "name": "template_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {
          "content": "string",
          "scope": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "version": "int"
        }
      },
      "description": "编辑模板内容，新版本生效时旧部署不受影响"
    }
  ],
  "data_flow": [
    {
      "name": "一键自动化部署流程",
      "steps": [
        "1. 用户在前端选择项目、环境，上传文件包，填写版本号，点击部署",
        "2. 前端发送 POST /api/deploy 请求",
        "3. API 网关路由到部署执行引擎",
        "4. 部署引擎调用环境配置服务获取目标主机、端口、部署路径及环境变量",
        "5. 部署引擎调用密钥管理服务获取解密后的私钥（内存中）",
        "6. 部署引擎通过 SSH 客户端模块建立远程连接",
        "7. SSH 客户端在远程部署根路径创建以版本号命名的文件夹",
        "8. SSH 客户端通过 SFTP 上传部署文件（若为压缩包则远程解压）",
        "9. 部署引擎调用脚本模板服务渲染启动/停止/检查脚本",
        "10. SSH 客户端将生成的脚本上传至版本文件夹并赋予执行权限",
        "11. 若配置了部署后钩子，SSH 客户端执行钩子命令",
        "12. 各步骤日志通过部署引擎推送至 SSE 频道，前端实时展示",
        "13. 部署完成后，部署引擎调用版本历史服务记录部署详情（版本、环境、MD5、状态等）",
        "14. 前端接收成功/失败状态并展示"
      ]
    },
    {
      "name": "版本回滚流程",
      "steps": [
        "1. 用户在前端查看某环境的历史部署列表",
        "2. 用户点击某条成功记录的“回滚”按钮",
        "3. 前端发送 POST /api/deploy/rollback 请求（携带 deployment_id）",
        "4. 版本历史服务接收请求，验证该部署记录存在且为成功状态",
        "5. 版本历史服务调用 SSH 客户端模块检查远程目标版本文件夹是否存在",
        "6. 若不存在，返回错误提示；若存在，继续",
        "7. 版本历史服务触发部署执行引擎（或直接调用 SSH 客户端）",
        "8. SSH 客户端连接远程，切换到目标版本目录",
        "9. 执行该目录下的 start.sh（或重新渲染并执行）",
        "10. 实时推送操作日志至前端",
        "11. 版本历史服务新增一条历史记录，状态为“回滚成功”，并关联原部署",
        "12. 前端展示回滚结果"
      ]
    }
  ]
}