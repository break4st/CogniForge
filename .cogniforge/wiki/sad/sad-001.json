            "name": "id",
            "type": "string",
            "description": "密钥ID"
          }
        ],
        "query_params": [],
        "body": {
          "name": {
            "type": "string",
            "description": "密钥名称"
          },
          "type": {
            "type": "string",
            "enum": [
              "ssh_key",
              "password"
