{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-22 11:15",
    "version": 1
  },
  "system_overview": {
    "description": "本系统为一站式自动化部署平台，实现对打包好的可执行文件向远程服务器的自动化部署。系统采用 B/S 架构，提供 Web 控制台操作界面，后端通过 SSH 协议与目标服务器交互。支持多项目、多环境（测试线/灰度线/正式线）的灵活管理，每个环境独立配置 SSH 密钥认证，部署时自动创建版本目录并生成执行脚本，实现一键式部署。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "创建/编辑/删除部署环境",
          "配置 SSH 密钥和连接参数",
          "测试环境连接",
          "查看部署日志"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目和环境列表",
          "选择项目和环境进行部署",
          "上传可执行文件包",
          "查看部署进度和日志"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建/编辑/删除项目",
          "查看项目部署历史",
          "跨项目切换管理",
          "查看项目总体状态"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层单体架构 + 前后端分离",
    "description": "系统采用前后端分离的分层架构。前端为 SPA 单页应用，通过 REST API 与后端通信。后端采用分层结构：接入层（API 控制器）→ 业务服务层 → 基础设施层。业务服务层内部按领域划分为项目管理、环境管理、部署引擎、密钥管理四大核心模块。基础设施层封装 SSH 连接池、文件存储和审计日志等通用能力。这种分层方式在保持较小部署单元的同时，确保各领域逻辑的清晰边界和可测试性。",
    "layers": [
      {
        "name": "表现层",
        "components": [
          "Web控制台"
        ]
      },
      {
        "name": "接入层",
        "components": [
          "API网关",
          "认证中间件"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署引擎服务",
          "密钥管理服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH连接池",
          "文件存储服务",
          "审计日志服务",
          "数据库"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "REST over HTTPS"
      },
      {
        "protocol": "REST over HTTPS（内部 RPC）"
      },
      {
        "protocol": "SQL / SSH / 文件 I/O"
      }
    ],
    "features": [
      "前后端分离，Web 控制台通过 REST API 驱动",
      "业务按领域划分，四类核心服务职责单一",
      "SSH 连接池化管理，复用连接降低开销",
      "所有操作写入审计日志，满足可审核性要求",
      "密钥存储与使用分离，密钥管理服务专责加密存储",
      "部署引擎可独立扩展，支持异步部署任务队列"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Go",
      "framework": "Gin",
      "runtime": "Go 1.22+"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus",
      "build_tool": "Vite"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "ssh_library": "golang.org/x/crypto/ssh",
    "deploy_protocol": "SSH (SFTP + 远程命令执行)",
    "api_style": "RESTful JSON API"
  },
  "components": [
    {
      "name": "Web控制台",
      "type": "frontend",
      "description": "浏览器端 SPA 应用，提供项目、环境、部署管理的可视化操作界面",
      "responsibilities": [
        "项目列表展示与切换",
        "部署环境配置表单",
        "SSH 密钥上传/粘贴配置",
        "部署操作触发与进度展示",
        "部署日志实时查看"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "REST API 统一入口，负责请求路由、认证鉴权、请求校验和响应封装",
      "responsibilities": [
        "请求路由分发到对应业务服务",
        "统一身份认证与会话管理",
        "请求参数校验与错误格式化",
        "跨域处理和限流"
      ]
    },
    {
      "name": "认证中间件",
      "type": "gateway",
      "description": "嵌入在 API 网关中的认证拦截模块，验证用户的登录会话和操作权限",
      "responsibilities": [
        "用户会话 Token 校验",
        "请求身份解析和注入上下文",
        "基于角色的操作鉴权",
        "未授权请求拦截"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "管理项目生命周期，维护项目及其关联的环境和部署记录",
      "responsibilities": [
        "项目的创建、编辑、删除",
        "项目列表查询和当前项目切换",
        "项目-环境关联关系维护",
        "项目部署历史记录查询"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理部署环境的配置，包括服务器地址、端口、认证方式等",
      "responsibilities": [
        "环境的创建、编辑、删除",
        "环境连接参数配置（地址、端口）",
        "环境与密钥的绑定关系管理",
        "环境连通性测试"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "安全存储和管理 SSH 密钥，提供密钥的上传、绑定和验证功能",
      "responsibilities": [
        "SSH 密钥的安全存储（加密后落库）",
        "密钥与环境的绑定管理",
        "密钥有效性验证",
        "部署时提供解密后的密钥会话"
      ]
    },
    {
      "name": "部署引擎服务",
      "type": "service",
      "description": "核心部署执行单元，负责在远程服务器上创建目录、传输文件、生成脚本和执行部署",
      "responsibilities": [
        "接收部署请求并解析部署参数",
        "在远程服务器创建版本化目录结构",
        "上传可执行文件包到远程服务器",
        "生成启动/停止/重启执行脚本",
        "实时回传部署进度和日志",
        "处理部署失败的回滚逻辑"
      ]
    },
    {
      "name": "SSH连接池",
      "type": "service",
      "description": "管理到远程服务器的 SSH 连接，提供连接复用和生命周期管理",
      "responsibilities": [
        "SSH 连接的创建、复用和销毁",
        "连接健康检测和自动重连",
        "连接超时管理",
        "并发连接数控制"
      ]
    },
    {
      "name": "文件存储服务",
      "type": "service",
      "description": "存储用户上传的可执行文件包，支持版本化管理和按需下载",
      "responsibilities": [
        "可执行文件包的上传和存储",
        "文件版本化管理",
        "部署时按需提供文件下载",
        "存储空间配额管理"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录系统中所有关键操作的审计日志，确保操作可追溯",
      "responsibilities": [
        "记录项目的创建/修改/删除操作",
        "记录环境配置变更和密钥操作",
        "记录每次部署的全流程日志",
        "日志的持久化存储和查询"
      ]
    },
    {
      "name": "数据库",
      "type": "database",
      "description": "关系型数据库，存储项目、环境、密钥、部署记录和审计日志等持久化数据",
      "responsibilities": [
        "项目数据的持久化存储",
        "环境配置数据存储",
        "加密后的密钥信息存储",
        "部署记录和审计日志存储",
        "数据完整性约束和事务支持"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "创建项目",
      "provider": "项目管理服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "identifier": "string"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "name": "string",
          "identifier": "string",
          "created_at": "datetime"
        }
      },
      "description": "创建新项目，返回项目基本信息"
    },
    {
      "interface": "获取项目列表",
      "provider": "项目管理服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "projects": "array<object>",
          "total": "integer"
        }
      },
      "description": "获取当前用户可访问的所有项目列表"
    },
    {
      "interface": "创建环境",
      "provider": "环境管理服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/projects/:pid/environments",
      "request": {
        "path_params": [
          "pid: integer"
        ],
        "query_params": [],
        "body": {
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "description": "string"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "description": "为指定项目创建新的部署环境"
    },
    {
      "interface": "绑定密钥",
      "provider": "密钥管理服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/environments/:eid/keys",
      "request": {
        "path_params": [
          "eid: integer"
        ],
        "query_params": [],
        "body": {
          "key_name": "string",
          "private_key": "string",
          "passphrase": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "key_id": "integer",
          "environment_id": "integer",
          "fingerprint": "string",
          "bound_at": "datetime"
        }
      },
      "description": "上传 SSH 密钥并与指定环境绑定"
    },
    {
      "interface": "测试连接",
      "provider": "环境管理服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/environments/:eid/test",
      "request": {
        "path_params": [
          "eid: integer"
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "reachable": "boolean",
          "latency_ms": "integer",
          "server_info": "string",
          "error": "string"
        }
      },
      "description": "测试指定环境的 SSH 连通性"
    },
    {
      "interface": "发起部署",
      "provider": "部署引擎服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/deploy",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "integer",
          "environment_id": "integer",
          "file_package_id": "integer",
          "version": "string",
          "description": "string"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "task_id": "integer",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "description": "创建部署任务，异步执行部署操作"
    },
    {
      "interface": "查询部署状态",
      "provider": "部署引擎服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/deploy/:taskId/status",
      "request": {
        "path_params": [
          "taskId: integer"
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "task_id": "integer",
          "status": "string",
          "progress": "integer",
          "current_step": "string",
          "logs": "array<string>",
          "started_at": "datetime",
          "completed_at": "datetime",
          "error": "string"
        }
      },
      "description": "轮询查询部署任务的当前状态和实时日志"
    },
    {
      "interface": "远程连接测试",
      "provider": "SSH连接池",
      "consumers": [
        "环境管理服务"
      ],
      "type": "RPC",
      "endpoint": "internal",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "integer",
          "key_id": "integer"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "connected": "boolean",
          "latency_ms": "integer"
        }
      },
      "description": "内部调用：环境管理服务通过 SSH 连接池测试目标服务器连通性"
    },
    {
      "interface": "远程文件传输",
      "provider": "SSH连接池",
      "consumers": [
        "部署引擎服务"
      ],
      "type": "RPC",
      "endpoint": "internal",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "integer",
          "env_key_id": "integer",
          "remote_path": "string",
          "file_content": "binary"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "transferred": "boolean",
          "bytes": "integer",
          "checksum": "string"
        }
      },
      "description": "内部调用：部署引擎通过 SSH 连接池将文件传输到远程服务器"
    },
    {
      "interface": "获取文件包",
      "provider": "文件存储服务",
      "consumers": [
        "部署引擎服务"
      ],
      "type": "RPC",
      "endpoint": "internal",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "file_package_id": "integer"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "file_data": "binary",
          "file_name": "string",
          "checksum": "string",
          "size": "integer"
        }
      },
      "description": "内部调用：部署引擎从文件存储服务获取待部署的文件包"
    },
    {
      "interface": "记录审计日志",
      "provider": "审计日志服务",
      "consumers": [
        "项目管理服务",
        "环境管理服务",
        "部署引擎服务",
        "密钥管理服务"
      ],
      "type": "RPC",
      "endpoint": "internal",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "action": "string",
          "actor": "string",
          "resource_type": "string",
          "resource_id": "integer",
          "detail": "object",
          "timestamp": "datetime"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "log_id": "integer",
          "recorded": "boolean"
        }
      },
      "description": "内部调用：各业务服务将关键操作记录到审计日志"
    }
  ],
  "data_flow": [
    {
      "name": "创建项目",
      "steps": [
        "用户在 Web 控制台填写项目名称和标识",
        "Web 控制台调用 POST /api/v1/projects 发送请求",
        "API 网关校验身份后路由到项目管理服务",
        "项目管理服务校验项目参数，写入数据库",
        "返回创建成功的项目信息给 Web 控制台",
        "审计日志服务记录项目创建操作"
      ]
    },
    {
      "name": "配置环境与密钥",
      "steps": [
        "用户在 Web 控制台选择项目，进入环境管理页面",
        "用户填写环境名称（如测试线）、服务器地址和端口",
        "Web 控制台调用 POST /api/v1/projects/:pid/environments",
