      "type": "REST",
      "endpoint": "POST /api/internal/ssh/execute",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "integer",
          "username": "string",
          "private_key": "string",
          "command": "string",
          "timeout_seconds": "integer"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "exit_code": "integer",
          "stdout": "string",
          "stderr": "string",
          "execution_id": "string"
        }
      },
