    {
      "id": "CMP-004",
      "name": "SSH密钥管理服务",
      "type": "service",
      "status": "active",
      "version": 1,
      "description": "负责私钥文件的加密存储、解密、以及连接测试。密钥内容使用 AES-256 加密后存入数据库，仅在需要时解密到内存中使用。连接测试功能验证密钥能否登录目标主机。",
      "responsibilities": [
        "接收私钥内容，加密后保存到环境配置",
        "提供密钥解密方法（仅返回内存中的私钥对象）",
        "执行 SSH 连接测试，返回连接状态详情",
        "不暴露明文密钥到前端或日志"
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "contracts": [
        "CTR-004",
        "CTR-005"
