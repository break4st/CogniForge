{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-22 16:31"
  },
  "system_overview": {
    "description": "自动化部署系统实现将打包好的可执行文件通过SSH安全通道一键式部署到远程服务器。系统采用B/S架构，支持用户自定义多套部署环境（测试线、灰度线、正式线）和多项目管理，通过Web界面完成从环境配置到部署触发的全流程操作，满足运维人员、开发人员和项目经理在不同场景下的部署需求。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "创建、编辑、删除部署环境",
          "配置和管理SSH密钥",
          "查看所有项目的部署配置",
          "验证服务器连接可用性",
          "查看部署日志和运行状态"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目列表和部署环境",
          "选择项目与目标环境触发部署",
          "查看自己的部署历史和结果",
          "上传可执行文件并指定版本号"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建和管理项目",
          "为项目分配运维人员",
          "查看所有项目的部署状态总览",
          "跨项目切换和管理"
        ]
      }
    ]
  },
  "architecture": {
    "style": "前后端分离的分层架构（B/S架构）",
    "description": "系统采用前后端分离的B/S架构，前端为单页应用（SPA）提供用户交互界面，后端采用分层架构分为接入层、业务服务层和基础设施层。各层职责清晰，通过RESTful API通信，数据库统一存储持久化数据。系统核心为部署编排引擎，负责管理部署流程的状态机转换，确保部署任务的可靠性执行。",
    "layers": [
      {
        "name": "展示层",
        "components": [
          "Web前端"
        ]
      },
      {
        "name": "接入层",
        "components": [
          "API网关"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "密钥管理服务",
          "部署编排引擎",
          "部署日志服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "关系型数据库",
          "缓存服务",
          "SSH连接池",
          "文件存储"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "SSH (TCP)"
      },
      {
        "protocol": "WebSocket（部署日志实时推送）"
      }
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "RESTful API统一接口规范",
      "SSH密钥安全认证，密钥加密存储",
      "部署流程状态机驱动，可审计可追溯",
      "多环境多项目独立配置隔离",
      "实时日志推送，部署过程可视化"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Java/Go",
      "framework": "Spring Boot / Gin"
    },
    "frontend": {
      "framework": "React/Vue",
      "ui_library": "Ant Design / Element UI"
    },
    "database": "MySQL/PostgreSQL",
    "cache": "Redis",
    "mq": "RabbitMQ/Kafka（用于异步部署任务和日志推送）",
    "protocol": "HTTPS / RESTful API / WebSocket",
    "deploy": "Docker容器化部署",
    "auth": "JWT令牌认证"
  },
  "components": [
    {
      "name": "Web前端",
      "type": "frontend",
      "description": "基于React/Vue构建的单页应用，提供项目管理、环境配置、部署触发和日志查看等用户界面",
      "responsibilities": [
        "渲染项目列表、环境配置表单、部署控制面板等UI组件",
        "通过REST API与后端通信",
        "通过WebSocket实时展示部署日志",
        "表单验证和用户输入校验"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "系统的统一入口，负责请求路由、身份认证、限流和日志记录",
      "responsibilities": [
        "统一的HTTP入口和请求路由分发",
        "JWT令牌校验和用户身份认证",
        "请求速率限制和防滥用",
        "跨域请求处理和请求/响应日志记录"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "负责项目的增删改查以及与部署环境的关联配置",
      "responsibilities": [
        "创建、编辑、删除项目",
        "查询项目列表和详情",
        "项目与环境配置的关联管理",
        "验证项目名称唯一性"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理部署环境（测试线/灰度线/正式线）及每套环境的服务器连接参数",
      "responsibilities": [
        "创建、编辑、删除部署环境",
        "为环境配置远程服务器主机、端口、用户名等连接参数",
        "环境与密钥的绑定管理",
        "连接可用性测试"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "管理SSH密钥对的存储、验证和生命周期，确保密钥安全",
      "responsibilities": [
        "SSH私钥的安全加密存储",
        "公钥指纹管理和验证",
        "密钥与部署环境的关联",
        "密钥有效性校验"
      ]
    },
    {
      "name": "部署编排引擎",
      "type": "service",
      "description": "系统的核心组件，负责部署任务的状态机管理、远程执行和结果反馈",
      "responsibilities": [
        "接收部署请求并创建部署任务",
        "通过SSH在远程服务器创建版本号目录结构",
        "传输可执行文件到远程服务器",
        "生成并执行部署脚本",
        "管理部署任务状态机（待部署→部署中→成功/失败）",
        "处理部署超时和异常重试"
      ]
    },
    {
      "name": "部署日志服务",
      "type": "service",
      "description": "记录和查询部署任务的执行日志，通过WebSocket实时推送",
      "responsibilities": [
        "持久化部署任务的操作日志",
        "通过WebSocket向前端实时推送日志流",
        "支持按项目、环境、时间范围查询历史日志",
        "日志归档和清理策略管理"
      ]
    },
    {
      "name": "关系型数据库",
      "type": "database",
      "description": "持久化存储项目、环境、密钥、部署任务和日志等结构化数据",
      "responsibilities": [
        "存储项目、部署环境、SSH密钥元数据",
        "存储部署任务记录和执行日志",
        "支持数据迁移和备份恢复",
        "保证数据一致性和完整性约束"
      ]
    },
    {
      "name": "缓存服务",
      "type": "infrastructure",
      "description": "缓存频繁查询的配置数据和会话状态，减轻数据库负载",
      "responsibilities": [
        "缓存项目和环境配置信息",
        "缓存用户会话和JWT令牌",
        "缓存部署任务状态快照",
        "提升系统响应速度"
      ]
    },
    {
      "name": "SSH连接池",
      "type": "service",
      "description": "管理到远程服务器的SSH连接池，复用连接以提高部署效率",
      "responsibilities": [
        "建立和维护到远程服务器的SSH连接",
        "连接复用和空闲连接回收",
        "连接健康检查和自动重连",
        "并发连接数限制和管理"
      ]
    },
    {
      "name": "文件存储",
      "type": "infrastructure",
      "description": "存储上传的可执行文件部署包，支持文件版本管理和分发",
      "responsibilities": [
        "接收并存储上传的可执行文件",
        "按项目和版本号组织文件目录",
        "文件完整性校验",
        "提供文件下载和传输接口"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "ProjectAPI",
      "provider": "项目管理服务",
      "consumers": [
        "Web前端"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/projects",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "integer",
            "description": "项目ID"
          }
        ],
        "query_params": [
          {
            "name": "page",
            "type": "integer",
            "description": "页码"
          },
          {
            "name": "page_size",
            "type": "integer",
            "description": "每页数量"
          }
        ],
        "body": {
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "description": {
            "type": "string",
            "description": "项目描述"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "integer",
            "description": "项目ID"
          },
          "name": {
            "type": "string",
            "description": "项目名称"
          },
          "description": {
            "type": "string",
            "description": "项目描述"
          },
          "created_at": {
            "type": "datetime",
            "description": "创建时间"
          }
        }
      },
      "description": "项目的增删改查接口"
    },
    {
      "interface": "EnvironmentAPI",
      "provider": "环境管理服务",
      "consumers": [
        "Web前端"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/environments",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "type": "integer",
            "description": "环境ID"
          }
        ],
        "query_params": [
          {
            "name": "project_id",
            "type": "integer",
            "description": "所属项目ID"
          }
        ],
        "body": {
          "name": {
            "type": "string",
            "description": "环境名称（测试线/灰度线/正式线）"
          },
          "host": {
            "type": "string",
            "description": "远程服务器主机地址"
          },
          "port": {
            "type": "integer",
            "description": "SSH端口"
          },
          "username": {
            "type": "string",
            "description": "登录用户名"
          },
          "key_id": {
            "type": "integer",
            "description": "绑定的SSH密钥ID"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "integer",
            "description": "环境ID"
          },
          "name": {
            "type": "string",
            "description": "环境名称"
          },
          "host": {
            "type": "string",
            "description": "远程服务器主机地址"
          },
          "port": {
            "type": "integer",
            "description": "SSH端口"
          },
          "status": {
            "type": "string",
            "description": "连接状态（在线/离线）"
          }
        }
      },
      "description": "部署环境的配置管理接口"
    },
    {
      "interface": "KeyManagementAPI",
      "provider": "密钥管理服务",
      "consumers": [
        "Web前端",
        "环境管理服务"
      ],
      "type": "REST",
      "endpoint": "GET/POST/DELETE /api/v1/keys",
      "request": {
        "path_params": [
          {
            "name": "key_id",
            "type": "integer",
            "description": "密钥ID"
          }
        ],
        "body": {
          "name": {
            "type": "string",
            "description": "密钥名称"
          },
          "public_key": {
            "type": "string",
            "description": "公钥内容"
          },
          "private_key": {
            "type": "string",
            "description": "私钥内容（加密传输）"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "integer",
            "description": "密钥ID"
          },
          "name": {
            "type": "string",
            "description": "密钥名称"
          },
          "fingerprint": {
            "type": "string",
            "description": "公钥指纹"
          },
          "created_at": {
            "type": "datetime",
            "description": "创建时间"
          }
        }
      },
      "description": "SSH密钥的上传、查询和删除接口"
    },
    {
      "interface": "ConnectionTestAPI",
      "provider": "部署编排引擎",
      "consumers": [
        "Web前端"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/environments/{env_id}/test",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "type": "integer",
            "description": "环境ID"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "success": {
            "type": "boolean",
            "description": "连接是否成功"
          },
          "message": {
            "type": "string",
            "description": "连接结果消息"
          }
        }
      },
      "description": "测试指定环境的SSH连接可用性"
    },
    {
      "interface": "DeployAPI",
      "provider": "部署编排引擎",
      "consumers": [
        "Web前端"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/deploy",
      "request": {
        "body": {
          "project_id": {
            "type": "integer",
            "description": "项目ID"
          },
          "env_id": {
            "type": "integer",
            "description": "目标环境ID"
          },
          "version": {
            "type": "string",
            "description": "版本号"
          },
          "file_path": {
            "type": "string",
            "description": "可执行文件路径"
          }
        }
      },
      "response": {
        "status": 202,
        "body": {
          "task_id": {
            "type": "integer",
            "description": "部署任务ID"
          },
          "status": {
            "type": "string",
            "description": "初始状态: pending"
          }
        }
      },
      "description": "触发一键部署任务"
    },
    {
      "interface": "DeployStatusAPI",
      "provider": "部署编排引擎",
      "consumers": [
        "Web前端"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/deploy/{task_id}/status",
      "request": {
        "path_params": [
          {
            "name": "task_id",
            "type": "integer",
            "description": "部署任务ID"
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "task_id": {
            "type": "integer",
            "description": "部署任务ID"
          },
          "status": {
            "type": "string",
            "description": "当前状态: pending/deploying/success/failed"
          },
          "version": {
            "type": "string",
            "description": "部署版本号"
          },
          "started_at": {
            "type": "datetime",
            "description": "开始时间"
          },
          "finished_at": {
            "type": "datetime",
            "description": "完成时间"
          }
        }
      },
      "description": "查询部署任务状态"
    },
    {
      "interface": "LogAPI",
      "provider": "部署日志服务",
      "consumers": [
        "Web前端"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/logs",
      "request": {
        "query_params": [
          {
            "name": "project_id",
            "type": "integer",
            "description": "项目ID"
          },
          {
            "name": "env_id",
            "type": "integer",
            "description": "环境ID"
          },
          {
            "name": "start_time",
            "type": "datetime",
            "description": "起始时间"
          },
          {
            "name": "end_time",
            "type": "datetime",
            "description": "结束时间"
          },
          {
            "name": "status",
            "type": "string",
            "description": "部署状态过滤"
          },
          {
            "name": "page",
            "type": "integer",
            "description": "页码"
          },
          {
            "name": "page_size",
            "type": "integer",
            "description": "每页数量"
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "total": {
            "type": "integer",
            "description": "总记录数"
          },
          "items": {
            "type": "array",
            "description": "部署记录列表"
          }
        }
      },
      "description": "部署历史日志查询接口"
    },
    {
      "interface": "LogWebSocket",
      "provider": "部署日志服务",
      "consumers": [
        "Web前端"
      ],
      "type": "WebSocket",
      "endpoint": "WS /api/v1/ws/logs?task_id={task_id}",
      "request": {
        "query_params": [
          {
            "name": "task_id",
            "type": "integer",
            "description": "部署任务ID"
          }
        ]
      },
      "response": {
        "body": {
          "type": {
            "type": "string",
            "description": "消息类型: log/status/error"
          },
          "data": {
            "type": "string",
            "description": "日志内容"
          },
          "timestamp": {
            "type": "datetime",
            "description": "时间戳"
          }
        }
      },
      "description": "通过WebSocket实时推送部署日志流"
    },
    {
      "interface": "FileUploadAPI",
      "provider": "文件存储",
      "consumers": [
        "Web前端"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/files/upload",
      "request": {
        "body": {
          "project_id": {
            "type": "integer",
            "description": "项目ID"
          },
          "version": {
            "type": "string",
            "description": "版本号"
          },
          "file": {
            "type": "binary",
            "description": "可执行文件（multipart form-data）"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "file_id": {
            "type": "integer",
            "description": "文件ID"
          },
          "file_path": {
            "type": "string",
            "description": "存储路径"
          },
          "checksum": {
            "type": "string",
            "description": "文件校验和"
          }
        }
      },
      "description": "上传可执行文件部署包"
    }
  ],
  "data_flow": [
    {
      "name": "项目创建流程",
      "steps": [
        "用户在前端填写项目名称和描述信息",
        "前端向POST /api/v1/projects发送创建请求",
        "API网关校验JWT令牌，通过后将请求路由到项目管理服务",
        "项目管理服务验证项目名称唯一性，写入数据库",
        "缓存服务更新项目列表缓存",
        "返回创建成功响应给前端，前端刷新项目列表"
      ]
    },
    {
      "name": "环境配置与密钥绑定流程",
      "steps": [
        "运维人员在前端选择项目，进入环境配置页面",
        "运维人员上传SSH公钥/私钥或创建密钥对",
        "密钥管理服务接收密钥，使用AES加密私钥后持久化存储",
        "运维人员创建部署环境（测试线），填写目标服务器主机、端口、用户名",
        "环境管理服务将环境与已上传的SSH密钥绑定",
        "运维人员触发连接测试，部署编排引擎通过SSH连接池尝试连接远程服务器",
        "连接结果返回前端展示，确认环境配置可用"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "开发人员在前端选择项目和目标部署环境（如测试线）",
        "输入版本号并上传可执行文件（或指定已上传的文件路径）",
        "前端调用POST /api/v1/deploy触发部署任务",
