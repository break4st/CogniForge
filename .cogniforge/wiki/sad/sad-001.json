      "responsibilities": [
        "展示和管理项目、环境列表",
        "提供部署参数的输入界面（文件选择、部署选项）",
        "显示部署进度和日志",
        "查询和展示部署历史",
        "项目切换与状态记忆"
      ],
      "source_requirements": [
