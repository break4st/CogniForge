  "architecture_decisions": [
    {
      "id": "AD-001",
      "title": "采用前后端分离单体架构",
      "decision": "初期选择单体架构而非微服务，以降低复杂度",
      "status": "proposed",
      "impact": "加速开发和部署，未来可按模块拆分为微服务"
    },
    {
      "id": "AD-002",
      "title": "使用异步SSH库 asyncssh",
      "decision": "选择asyncssh而非同步Paramiko，以匹配FastAPI的异步特性",
      "status": "proposed",
      "impact": "提高并发性能，避免阻塞事件循环"
    },
    {
      "id": "AD-003",
      "title": "SSE推送日志",
      "decision": "使用Server-Sent Events而非WebSocket推送部署日志",
      "status": "proposed",
      "impact": "简化实现，满足单向服务器推送需求，无需客户端频繁轮询"
    },
    {
      "id": "AD-004",
      "title": "密钥加密存储",
      "decision": "使用Fernet对称加密存储私钥，密钥保存在环境变量或配置中",
      "status": "proposed",
      "impact": "保护敏感信息，但需妥善保管加密密钥"
    },
    {
      "id": "AD-005",
      "title": "单一用户角色",
      "decision": "当前阶段不实现用户认证和多角色权限控制",
      "status": "accepted",
      "impact": "简化开发，后期可扩展用户系统"
    }
  ],
  "risks": [
    {
      "id": "RISK-001",
      "description": "大文件上传过程中网络中断导致部署失败",
      "mitigation": "初期可要求部署文件较小，或引入断点续传机制；部署失败时可重试",
      "severity": "中"
    },
    {
      "id": "RISK-002",
      "description": "加密密钥的管理与泄露风险",
      "mitigation": "加密密钥通过环境变量注入，定期轮换，不提交到代码仓库",
      "severity": "高"
    },
    {
      "id": "RISK-003",
      "description": "并发部署到同一环境可能造成版本冲突",
      "mitigation": "在部署服务中增加环境锁，同一个环境同时只允许一个部署任务",
      "severity": "中"
    },
    {
      "id": "RISK-004",
      "description": "远程服务器操作系统差异（如Windows）",
      "mitigation": "当前假设为类Unix系统，若需支持Windows，需生成不同脚本格式",
      "severity": "低"
    }
  ],
  "open_questions": [
    {
      "id": "OQ-001",
      "question": "是否需要支持部署文件的断点续传？",
      "context": "PRD未明确传输可靠性机制，对大文件可能不友好"
    },
    {
      "id": "OQ-002",
      "question": "是否需要在部署前自动备份上一版本？",
      "context": "回滚需求目前仅提供路径，自动备份能提升回滚速度"
    },
    {
      "id": "OQ-003",
      "question": "是否需要用户管理和权限控制？",
      "context": "PRD没有用户系统，但实际使用可能需要区分不同操作者的权限"
    }
  ]
