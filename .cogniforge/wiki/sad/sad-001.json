          "project_id": {
            "type": "string",
            "description": "所属项目ID"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "string",
            "description": "密钥ID"
          },
          "name": {
            "type": "string",
