  "title": "多项目多环境自动化部署工具系统架构文档",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "本系统为一个桌面应用程序，采用客户端-服务器架构，两者均运行在用户本地机器上。前端负责界面展示与交互，后端负责业务逻辑、任务调度和与远程服务器的实际通信。系统支持多项目管理，允许开发、测试及运维人员安全、高效地将本地构建产物一键部署到不同环境，并具备实时日志查看、版本历史审计和一键回滚能力。",
    "roles": [
      {
        "name": "普通用户",
        "permissions": [
          "创建/编辑/删除项目",
          "创建/编辑/删除环境",
          "导入/生成/删除SSH密钥",
          "执行一键部署",
          "查看实时部署日志",
          "查看版本历史并执行回滚",
          "在项目间切换"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 事件驱动（日志推送）",
    "description": "系统在逻辑上分为四层：表示层、网关层/API层、业务服务层和基础设施层。内部采用异步任务处理部署流程，并使用WebSocket实现实时日志传输。层间通过RESTful API、WebSocket和内部函数调用通信，与远程服务器通过SSH/SFTP协议交互。",
    "layers": [
      {
        "name": "表示层",
        "components": [
          "桌面客户端 (CMP-001)"
        ]
      },
      {
        "name": "网关层/API层",
        "components": [
          "API 网关服务 (CMP-002)"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务 (CMP-003)",
          "环境管理服务 (CMP-004)",
          "密钥管理服务 (CMP-005)",
          "部署引擎 (CMP-006)",
          "日志服务 (CMP-007)",
          "版本历史服务 (CMP-008)"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH 连接管理器 (CMP-009)",
          "密钥安全模块 (CMP-010)",
          "数据持久层 (CMP-011)"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS (本地)",
        "description": "表示层与网关层之间所有CRUD请求及部署触发均通过REST API通信，运行在localhost。"
      },
      {
        "protocol": "WebSocket (WSS)",
        "description": "表示层与网关层之间通过WebSocket建立持久连接，用于从服务端推送实时日志流。"
      },
      {
        "protocol": "内部函数调用",
        "description": "网关层与业务服务层、各业务服务之间的通信，采用直接调用，保证低延迟。"
      },
      {
        "protocol": "SQL (通过ORM)",
        "description": "业务服务层通过ORM或SQL语句操作SQLite数据库，进行数据持久化。"
      },
      {
        "protocol": "SSH/SFTP",
        "description": "基础设施层的SSH连接管理器通过SSH协议执行远程命令，通过SFTP传输文件至远程服务器。"
      }
    ],
    "features": [
      "安全性：私钥经AES-256加密后存储，所有远程连接基于密钥认证，禁止密码登录。",
      "实时性：基于WebSocket的日志推送，实现部署过程的毫秒级细粒度展示。",
      "可靠性：部署任务原子化执行，失败立即中止；回滚通过远程符号链接原子切换。",
      "可扩展性：项目、环境、密钥均为独立实体，支持灵活绑定；通过自定义前后置脚本扩展部署行为。",
      "轻量化：整体打包为桌面应用，内嵌Python运行时和后端服务，安装即用，无额外数据库服务器依赖。"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React + TypeScript",
      "ui_library": "Ant Design"
    },
    "desktop_shell": "Electron",
    "database": "SQLite (via SQLAlchemy)",
    "ssh_library": "Paramiko",
    "encryption": "cryptography 库 (Fernet/AES-GCM)",
    "task_scheduling": "asyncio + BackgroundTasks",
    "packaging": "PyInstaller"
  },
