  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户在前端选择项目与环境，上传文件压缩包",
        "前端通过 POST /api/deployments 提交部署请求",
        "Flask API 接收请求，校验参数，创建部署记录状态置为 'queued'",
        "部署执行引擎异步领取任务，更新状态为 'deploying'",
        "引擎通过 SSH 连接模块建立 SFTP 连接，上传文件包并实时报告进度",
        "引擎在远程创建版本目录（如 `/deploy_root/20260524_194030`），执行解压",
        "引擎调用脚本模板管理器生成 start.sh / stop.sh 并上传到版本目录",
        "引擎根据 auto_start 配置决定是否远程执行 start.sh",
        "引擎将部署结果（成功/失败信息、远程路径等）写入部署历史记录",
        "前端通过轮询或 WebSocket 获取进度更新，直至状态变为 'success' 或 'failed'"
      ]
    },
    {
      "name": "项目切换数据刷新流程",
      "steps": [
        "用户在前端项目列表点击目标项目",
        "前端存储当前选中项目ID",
        "前端调用 GET /api/projects/{project_id}/environments 获取环境列表",
        "前端调用 GET /api/deployments?project_id=... 获取该项目的部署历史",
        "页面渲染环境标签与历史记录表格，内容随项目切换即时更新"
      ]
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "Project",
      "description": "表示一个部署项目，包含基本信息。",
      "source_requirements": [
        "REQ-001"
      ],
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "name",
          "type": "String (unique)",
          "required": true,
          "description": "项目名称，全局唯一"
        },
        {
          "name": "description",
          "type": "Text",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": true,
          "description": "最后更新时间"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "Environment",
      "description": "表示项目下的一套部署环境配置，与项目多对一关联。",
      "source_requirements": [
        "REQ-002",
        "REQ-005"
      ],
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "project_id",
          "type": "Integer (FK)",
          "required": true,
          "description": "所属项目ID"
        },
        {
          "name": "name",
          "type": "String",
          "required": true,
          "description": "环境名称，如测试线、正式线"
        },
        {
          "name": "host",
          "type": "String",
          "required": true,
          "description": "服务器地址"
        },
        {
          "name": "port",
          "type": "Integer",
          "required": true,
          "description": "SSH 端口号"
        },
        {
          "name": "auth_type",
          "type": "String",
          "required": true,
          "description": "认证类型，固定为 'ssh_key'"
        },
        {
          "name": "private_key_path",
          "type": "String",
          "required": true,
          "description": "本地密钥文件路径"
        },
        {
          "name": "deploy_root_dir",
          "type": "String",
          "required": true,
          "description": "远程服务器部署根目录"
        },
        {
          "name": "custom_start_script",
          "type": "Text (nullable)",
          "required": false,
          "description": "自定义启动脚本内容，为空则使用默认模板"
        },
        {
          "name": "custom_stop_script",
          "type": "Text (nullable)",
          "required": false,
          "description": "自定义停止脚本内容，为空则使用默认模板"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": true,
          "description": "最后更新时间"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "Deployment",
      "description": "记录每一次部署任务的信息，包括状态、远程路径等，支持回滚关联。",
      "source_requirements": [
        "REQ-004",
        "REQ-006"
      ],
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "project_id",
          "type": "Integer (FK)",
          "required": true,
          "description": "所属项目ID"
        },
        {
          "name": "environment_id",
          "type": "Integer (FK)",
          "required": true,
          "description": "目标环境ID"
        },
        {
          "name": "version_tag",
          "type": "String",
          "required": true,
          "description": "版本标签，用户自定义或生成的时间戳"
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "description": "状态：queued/deploying/success/failed/rolled_back"
        },
        {
          "name": "remote_path",
          "type": "String",
          "required": false,
          "description": "部署成功后远程版本目录路径"
        },
        {
          "name": "error_message",
          "type": "Text",
          "required": false,
          "description": "失败时的错误信息"
        },
        {
          "name": "rollback_from_id",
          "type": "Integer (FK self, nullable)",
          "required": false,
          "description": "若为回滚操作，指向原始部署记录ID"
        },
        {
          "name": "deployed_at",
          "type": "DateTime",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "finished_at",
          "type": "DateTime",
          "required": false,
          "description": "部署结束时间"
        }
      ]
    },
    {
      "id": "DM-004",
      "name": "ScriptTemplate",
      "description": "存储系统级别的默认脚本模板（也可存储环境/项目级模板，通过关联字段区分）。此处仅呈现默认模板概念。",
      "source_requirements": [
        "REQ-005"
      ],
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "type",
          "type": "String",
          "required": true,
          "description": "脚本类型：start / stop"
        },
        {
          "name": "content",
          "type": "Text",
          "required": true,
          "description": "脚本内容，可包含占位符如 ${PORT}, ${JAVA_OPTS} 等"
        },
        {
          "name": "description",
          "type": "String",
          "required": false,
          "description": "模板描述"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        }
      ]
    }
