          },
          "output": {
            "type": "string",
            "description": "命令执行输出"
          },
          "exit_code": {
            "type": "int",
            "description": "退出码"
          }
        }
      },
      "description": "内部接口，部署编排服务通过此接口在远程服务器执行命令"
    },
    {
      "interface": "审计日志API",
      "provider": "审计日志服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/audit-logs",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "project_id",
            "type": "string",
            "description": "项目ID",
            "required": false
          },
          {
            "name": "action",
            "type": "string",
            "description": "操作类型",
            "required": false
          },
          {
            "name": "page",
            "type": "int",
            "description": "页码",
            "required": false
          },
          {
            "name": "page_size",
            "type": "int",
            "description": "每页条数",
            "required": false
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "total": {
            "type": "int",
            "description": "总条数"
          },
          "items": {
            "type": "array",
            "items": "object",
            "description": "日志条目列表"
          }
        }
      },
      "description": "查询操作审计日志和部署历史"
    }
  ],
  "data_flow": [
    {
      "name": "创建并配置项目",
      "steps": [
        "用户通过Web控制台填写项目信息",
        "Web控制台调用API网关 POST /api/v1/projects",
        "API网关认证后路由到项目管理服务",
        "项目管理服务验证数据并写入PostgreSQL",
