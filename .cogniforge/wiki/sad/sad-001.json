            "type": "string",
            "description": "认证凭证"
          },
          "commands": {
            "type": "array",
            "items": "string",
            "description": "待执行的命令列表"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "session_id": {
            "type": "string",
