  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户通过Web Console选择项目、目标环境和部署文件",
        "Web Console调用 Deployment API (POST /api/deployments) 发起部署请求",
        "Deployment Orchestrator 接收请求并记录部署开始日志到 Audit Service",
        "Deployment Orchestrator 向 Environment Management Service 获取目标环境连接配置",
        "Deployment Orchestrator 向 Key Management Service 获取关联的SSH私钥",
        "Deployment Orchestrator 向 File Storage 获取部署文件内容",
        "Deployment Orchestrator 调用 SSH Execution Service 的 File Transfer 接口将部署文件上传到远程服务器",
        "SSH Execution Service 在远程服务器创建带版本标识的部署目录",
        "SSH Execution Service 将上传的文件放置到版本目录",
        "Deployment Orchestrator 调用 SSH Execution Service 的 Execute 接口在远程服务器生成并执行启动脚本",
        "SSH Execution Service 返回执行结果和日志",
        "Deployment Orchestrator 将部署结果和日志持久化到 Primary Database",
        "Deployment Orchestrator 更新部署状态并通过 Audit Service 记录完成事件",
