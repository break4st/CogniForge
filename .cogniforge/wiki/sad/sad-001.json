    {
      "id": "CTR-005",
      "interface": "查询部署记录",
      "provider_component_id": "CMP-007",
      "provider": "日志与审计服务",
      "consumers": [
        "DeployFlow Web 前端",
        "API 网关"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "GET /api/v1/deployments",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "project_id",
            "type": "string",
            "required": false,
            "description": "按项目ID筛选"
          },
          {
            "name": "status",
            "type": "string",
            "required": false,
            "enum": [
              "success",
              "failed",
              "in_progress"
            ],
            "description": "按部署状态筛选"
          },
          {
            "name": "start_date",
            "type": "string",
            "format": "date-time",
            "required": false,
            "description": "查询开始时间"
          },
          {
            "name": "end_date",
            "type": "string",
            "format": "date-time",
            "required": false,
            "description": "查询结束时间"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "array",
          "items": {
            "type": "object",
