  "architecture_decisions": [
    {
      "decision_id": "AD-001",
      "decision": "选择Celery作为异步任务框架",
      "reason": "部署任务耗时长，必须异步执行以保持API响应迅速。Celery成熟稳定，与Python技术栈无缝集成，支持任务重试和结果存储。",
      "alternatives": "RQ, 简化的自定义后台线程。Celery生态更完善。"
    },
    {
      "decision_id": "AD-002",
      "decision": "采用PostgreSQL作为主数据库",
      "reason": "需要支持事务（如更新部署状态和记录日志的一致性）、JSON字段（存储环境变量）和复杂查询。PRD中未特别要求，但根据团队技术栈预判，PostgreSQL是最佳通用选择。",
      "alternatives": "MySQL, MongoDB。MongoDB不擅长强事务的关联查询。"
    },
    {
      "decision_id": "AD-003",
      "decision": "凭证加密采用AES-256-CBC，密钥与业务配置分离",
      "reason": "满足PRD中对密钥和密码加密存储的严格安全要求（REQ-006）。密钥管理应与业务服务隔离，可使用环境变量注入或专用KMS。",
      "alternatives": "RSAs，但对称加密性能更高，适合快速解密凭证以建立SSH连接。"
    }
  ],
  "risks": [
    {
      "risk_id": "RISK-001",
      "risk": "SSH连接与文件传输的稳定性",
      "impact": "高",
      "description": "部署任务依赖稳定的SSH连接，网络波动或服务器配置问题可能导致部署中途失败，产生垃圾文件或锁文件。",
      "mitigation": "在部署引擎中实现重试机制和幂等性操作；每次部署前检查磁盘空间和网络连通性；部署失败后尝试回滚清理已创建目录。"
    },
    {
      "risk_id": "RISK-002",
      "risk": "敏感凭证泄露风险",
      "impact": "极高",
      "description": "虽然凭证加密存储，但在内存解密和使用过程中若处理不当，可能被恶意利用导致服务器被入侵。",
      "mitigation": "严格控制日志输出，禁止打印任何凭证信息；内存中的解密凭证使用后立即清除；对访问凭证的内部服务施行严格的网络策略和最小权限原则。"
    }
  ],
  "open_questions": [
