{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-22 14:27"
  },
  "system_overview": {
    "description": "实现将打包好的可执行文件自动化部署到指定远程服务器的功能。支持用户自定义多套部署环境（如测试线、灰度线、正式线等），每套环境可通过密钥配置安全连接，部署时自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。用户可创建和管理多个项目，每个项目拥有独立的部署环境配置，支持在项目间灵活切换，满足多项目并行管理的需求。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "配置和管理多套部署环境",
          "上传和管理SSH密钥",
          "执行一键部署操作",
          "查看部署日志和进度",
          "测试环境连接"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "选择目标环境和文件触发部署",
          "查看部署实时日志",
          "查看部署历史记录"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、删除项目",
          "为项目绑定部署环境",
          "查看项目列表和概要信息",
          "在项目间切换",
          "查看各项目部署状态"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 微服务架构",
    "description": "系统采用前后端分离的分层架构，前端提供Web管理控制台，后端采用微服务架构划分为多个独立服务，通过API网关统一接入。数据层使用关系型数据库持久化项目和环境配置，密钥信息加密存储。部署执行时通过SSH连接池与远程服务器通信，支持实时日志推送。",
    "layers": [
      {
        "name": "Web控制层",
        "components": [
          "Web管理控制台"
        ]
      },
      {
        "name": "API网关层",
        "components": [
          "API网关"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境配置服务",
          "部署引擎服务",
          "密钥管理服务",
          "审计日志服务"
        ]
      },
      {
        "name": "数据持久层",
        "components": [
          "PostgreSQL主数据库",
          "加密密钥存储",
          "Redis缓存"
        ]
      },
      {
        "name": "远程集成层",
        "components": [
          "SSH连接池服务",
          "文件传输服务"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "REST/gRPC"
      },
      {
        "protocol": "SQL/Redis协议"
      },
      {
        "protocol": "SSH/SCP"
      }
    ],
    "features": [
      "多项目独立管理，上下文隔离",
      "环境与项目解耦，支持环境复用",
      "SSH密钥加密存储，安全连接",
      "一键触发部署，自动版本化管理",
      "实时日志推送，部署过程可视化",
      "完整的操作审计记录"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "mq": "RabbitMQ",
    "protocol": "REST + WebSocket + SSH/SCP",
    "auth": "JWT",
    "ssh_library": "Paramiko"
  },
  "components": [
    {
      "name": "Web管理控制台",
