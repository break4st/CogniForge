  "contracts": [
    {
      "id": "CTR-001",
      "interface": "创建项目",
      "provider_component_id": "CMP-003",
      "provider": "项目管理服务",
      "consumers": [
        "DeployFlow Web 前端",
        "API 网关"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "POST /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "项目名称，全局唯一"
            },
            "description": {
              "type": "string",
              "description": "项目描述"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "message": "请求参数缺失或格式错误"
        },
        {
