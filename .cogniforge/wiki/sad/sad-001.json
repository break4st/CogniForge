{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-20 15:41"
  },
  "system_overview": {
    "description": "实现将打包好的可执行文件自动化部署到指定远程服务器的功能，支持多环境、多项目管理，通过密钥配置安全连接，自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。系统采用分层架构，前端通过 API Gateway 统一接入，业务层按领域拆分为项目、部署、环境等微服务，确保各模块职责清晰、可独立扩展。",
    "roles": [
      {
        "name": "开发者",
        "permissions": [
          "一键部署可执行文件到指定环境",
          "查看部署历史与版本记录",
          "在项目间切换查看"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "配置多套部署环境（测试线、灰度线、正式线）",
          "管理 SSH 密钥对与安全连接",
          "查看部署日志与错误详情"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、删除项目",
          "为项目分配环境配置",
          "管理项目成员与权限"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 微服务",
    "description": "系统采用分层架构，自顶向下分为四层：展示层（Web UI）、接入层（API Gateway）、业务层（领域服务）、基础设施层（数据存储与中间件）。各业务服务按领域职责拆分，通过 API Gateway 统一对外暴露 RESTful 接口，服务间通过同步调用或异步消息队列通信。部署执行引擎作为核心服务，负责 SSH 连接、文件传输与远程脚本生成。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web UI"]
      },
      {
        "name": "接入层",
        "components": ["API Gateway"]
      },
      {
        "name": "业务层",
        "components": ["Project Service", "Environment Service", "Deploy Service", "SSH Executor", "Version Manager"]
      },
      {
        "name": "基础设施层",
        "components": ["Relational Database", "Cache", "Message Queue"]
      }
    ],
    "connections": [
      {
        "protocol": "REST/HTTPS"
      },
      {
        "protocol": "REST/HTTPS + WebSocket"
      },
      {
        "protocol": "SQL + Redis Protocol + AMQP"
      }
    ],
    "features": [
      "一键自动化部署，全流程无人干预",
      "多环境隔离配置，支持测试/灰度/正式线",
      "SSH 密钥安全管理与加密传输",
      "自动版本文件夹创建与部署脚本生成",
      "多项目独立管理，灵活切换",
      "异步任务队列，大文件传输不阻塞"
    ]
  },
  "components": [
    {
      "name": "Web UI",
      "type": "frontend",
      "description": "基于浏览器的人机交互界面，提供项目管理、环境配置、一键部署、部署历史查看等功能",
      "responsibilities": [
        "项目列表展示与 CRUD 操作",
        "部署环境配置表单",
        "一键部署触发与进度展示",
        "部署历史与版本查看",
        "SSH 密钥管理界面"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "系统统一入口网关，负责请求路由、认证鉴权、限流熔断、请求转发与日志记录",
      "responsibilities": [
        "统一接入所有客户端请求",
        "身份认证与权限校验",
        "请求路由到对应业务服务",
        "限流与熔断保护",
        "统一错误处理与日志记录"
      ]
    },
    {
      "name": "Project Service",
      "type": "service",
      "description": "项目管理领域服务，负责项目的创建、编辑、删除、列表查询以及与部署环境的关系绑定",
      "responsibilities": [
        "项目 CRUD 操作",
        "项目与环境关联管理",
        "项目成员权限管理",
        "项目级别的配置隔离"
      ]
    },
    {
      "name": "Environment Service",
      "type": "service",
      "description": "环境配置管理服务，负责多套部署环境（测试线、灰度线、正式线）的独立配置与 SSH 连接信息管理",
      "responsibilities": [
        "部署环境的创建与配置",
        "SSH 连接信息（主机、端口、用户）管理",
        "环境级别的密钥绑定管理",
        "环境状态健康检查"
      ]
    },
    {
      "name": "Deploy Service",
      "type": "service",
      "description": "核心部署编排服务，接收部署请求后协调文件传输、远程执行、版本创建等全流程，支持异步任务处理",
      "responsibilities": [
        "接收并校验部署请求",
        "编排完整部署流程",
        "调用 Version Manager 创建版本文件夹",
        "调用 SSH Executor 传输文件与执行脚本",
        "记录部署日志与状态",
        "异步任务进度推送"
      ]
    },
    {
      "name": "SSH Executor",
      "type": "service",
      "description": "SSH 远程执行引擎，负责建立安全连接、传输文件、执行远程命令，支持密钥认证方式",
      "responsibilities": [
        "建立 SSH 安全连接",
        "通过 SCP/SFTP 传输可执行文件",
        "远程创建目录与生成脚本",
        "执行远程部署命令并捕获输出",
        "连接异常处理与重试机制"
      ]
    },
    {
      "name": "Version Manager",
      "type": "service",
      "description": "版本管理服务，负责自动生成版本标识、在远程服务器创建版本化文件夹并生成部署执行脚本",
      "responsibilities": [
        "基于时间戳/语义化生成版本号",
        "在远程服务器创建版本文件夹结构",
        "自动生成 start.sh/stop.sh 等执行脚本",
        "维护版本历史记录与元数据"
      ]
    },
    {
      "name": "Relational Database",
      "type": "db",
      "description": "关系型数据库，持久化存储项目信息、环境配置、密钥元数据、部署记录、版本历史等结构化数据",
      "responsibilities": [
        "项目管理数据持久化",
        "环境配置信息存储",
        "部署记录与审计日志存储",
        "版本历史元数据存储"
      ]
    },
    {
      "name": "Cache",
      "type": "cache",
      "description": "缓存中间件，缓存频繁读取的环境配置、SSH 连接信息、部署状态等，降低数据库压力",
      "responsibilities": [
        "缓存环境配置与密钥信息",
        "缓存部署进度与状态",
        "缓存项目列表",
        "提升系统响应速度"
      ]
    },
    {
      "name": "Message Queue",
      "type": "mq",
      "description": "消息队列，解耦部署请求的提交与执行，支持异步任务处理与状态通知",
      "responsibilities": [
        "异步部署任务队列",
        "部署状态变更通知",
        "服务间异步事件通信",
        "削峰填谷，避免突发部署请求压垮系统"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "创建部署任务",
      "provider": "Deploy Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/v1/deploy",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string",
          "environment_id": "string",
          "artifact_path": "string",
          "description": "string (optional)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "task_id": "string",
          "status": "string",
          "message": "string"
        }
      },
      "description": "发起一键部署请求，返回异步任务 ID，前端据此轮询部署进度"
    },
    {
      "interface": "查询部署状态",
      "provider": "Deploy Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/v1/deploy/{task_id}/status",
      "request": {
        "path_params": [
          {"name": "task_id", "type": "string", "description": "部署任务 ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "task_id": "string",
          "status": "string (pending/running/success/failed)",
          "progress": "integer (0-100)",
          "logs": "string"
        }
      },
      "description": "查询指定部署任务的当前状态与执行日志"
    },
    {
      "interface": "版本回滚",
      "provider": "Deploy Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/v1/deploy/rollback",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string",
          "environment_id": "string",
          "version_id": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "task_id": "string",
          "status": "string",
          "message": "string"
        }
      },
      "description": "回滚到指定历史版本，停止当前服务并重新执行目标版本的启动脚本"
    },
    {
      "interface": "查看部署历史",
      "provider": "Deploy Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/v1/deploy/history",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "project_id", "type": "string", "description": "项目筛选"},
          {"name": "environment_id", "type": "string", "description": "环境筛选"},
          {"name": "page", "type": "integer", "description": "页码"},
          {"name": "page_size", "type": "integer", "description": "每页条数"}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "task_id": "string",
              "version": "string",
              "status": "string",
              "created_at": "datetime",
              "description": "string"
            }
          ],
          "total": "integer",
          "page": "integer"
        }
      },
      "description": "分页查询部署历史记录与版本列表"
    },
    {
      "interface": "创建项目",
      "provider": "Project Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "description": "string",
          "environment_ids": ["string"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "project_id": "string",
          "name": "string",
          "created_at": "datetime"
        }
      },
      "description": "创建新项目并关联部署环境"
    },
    {
      "interface": "查询项目列表",
      "provider": "Project Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "page", "type": "integer", "description": "页码"},
          {"name": "page_size", "type": "integer", "description": "每页条数"}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "project_id": "string",
              "name": "string",
              "description": "string",
              "environment_count": "integer",
              "created_at": "datetime"
            }
          ],
          "total": "integer",
          "page": "integer"
        }
      },
      "description": "分页获取项目列表"
    },
    {
      "interface": "创建环境",
      "provider": "Environment Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/v1/environments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "type": "string (test/gray/production)",
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_id": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "environment_id": "string",
          "name": "string",
          "type": "string",
          "connectivity_status": "string",
          "created_at": "datetime"
        }
      },
      "description": "创建部署环境配置，指定 SSH 连接信息与绑定的密钥"
    },
    {
      "interface": "查询环境列表",
      "provider": "Environment Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/v1/environments",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "project_id", "type": "string", "description": "按项目筛选"},
          {"name": "type", "type": "string", "description": "按环境类型筛选"}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": [
            {
              "environment_id": "string",
              "name": "string",
              "type": "string",
              "host": "string",
              "connectivity_status": "string"
            }
          ]
        }
      },
      "description": "获取所有部署环境列表，可按项目或环境类型筛选"
    },
    {
      "interface": "获取环境配置",
      "provider": "Environment Service",
      "consumers": ["Deploy Service"],
      "type": "REST",
      "endpoint": "GET /api/v1/environments/{environment_id}/config",
      "request": {
        "path_params": [
          {"name": "environment_id", "type": "string", "description": "环境 ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "environment_id": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_fingerprint": "string",
          "deploy_path": "string"
        }
      },
      "description": "Deploy Service 获取目标环境的 SSH 连接详情（服务间调用，不经过 API Gateway）"
    },
    {
      "interface": "创建版本",
      "provider": "Version Manager",
      "consumers": ["Deploy Service"],
      "type": "REST",
      "endpoint": "POST /api/v1/versions",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "environment_id": "string",
          "project_id": "string",
          "artifact_name": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "version_id": "string",
          "version": "string (e.g., v20260520_154100)",
          "remote_path": "string"
        }
      },
      "description": "生成版本号并在远程服务器创建版本文件夹（Deploy Service -> Version Manager 服务间调用）"
    },
    {
      "interface": "执行远程部署",
      "provider": "SSH Executor",
      "consumers": ["Deploy Service"],
      "type": "REST",
      "endpoint": "POST /api/v1/ssh/execute",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "connection": {
            "host": "string",
            "port": "integer",
            "username": "string",
            "key_content": "string"
          },
          "commands": ["string"],
          "files": [
            {
              "local_path": "string",
              "remote_path": "string"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "exit_code": "integer",
          "stdout": "string",
          "stderr": "string",
          "execution_time_ms": "integer"
        }
      },
      "description": "执行远程 SSH 命令与文件传输（Deploy Service -> SSH Executor 服务间调用）"
    }
  ],
  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "开发者通过 Web UI 选择项目、目标环境和可执行文件，点击部署",
        "Web UI 调用 API Gateway 的 POST /api/v1/deploy 发起部署请求",
        "API Gateway 鉴权后转发请求到 Deploy Service",
        "Deploy Service 校验请求参数，生成部署任务 ID，将任务推入 Message Queue",
        "Deploy Service 返回部署任务 ID 给前端，前端开始轮询状态",
        "Deploy Service 从 Message Queue 消费部署任务",
        "Deploy Service 调用 Environment Service 获取目标环境的 SSH 连接配置",
        "Deploy Service 调用 Version Manager 生成版本号并在远程创建版本文件夹及脚本",
        "Deploy Service 调用 SSH Executor 上传可执行文件到远程版本文件夹",
        "SSH Executor 通过 SSH 连接执行远程部署脚本（启动服务）",
        "SSH Executor 返回执行结果与日志给 Deploy Service",
        "Deploy Service 更新部署记录状态并持久化到 Database",
        "Deploy Service 通过消息队列/WebSocket 推送最终部署结果给 Web UI",
        "开发者在 Web UI 上查看部署结果与日志"
      ]
    },
    {
      "name": "环境配置流程",
      "steps": [
        "运维人员通过 Web UI 进入环境管理页面",
        "运维人员填写环境名称、类型（测试线/灰度线/正式线）、SSH 连接信息",
        "运维人员上传或选择已配置的 SSH 密钥",
        "Web UI 调用 API Gateway 的 POST /api/v1/environments",
        "Environment Service 保存环境配置到 Database，并更新 Cache",
        "Environment Service 执行 SSH 连接测试，验证配置有效性",
        "运维人员收到环境创建成功通知"
      ]
    },
    {
      "name": "项目管理流程",
      "steps": [
        "项目经理通过 Web UI 创建新项目，填写项目名称与描述",
        "项目经理为项目关联已配置的部署环境",
        "Web UI 调用 API Gateway 的 POST /api/v1/projects",
        "Project Service 将项目信息持久化到 Database",
        "开发者可在项目列表中选择该项目进行部署操作"
      ]
    },
    {
      "name": "版本回滚流程",
      "steps": [
        "开发者在 Web UI 查看部署历史与版本列表",
        "开发者选择某个历史版本，点击回滚",
        "Web UI 调用 API Gateway 的 POST /api/v1/deploy/rollback",
        "Deploy Service 查询该版本的部署元数据与文件路径",
        "Deploy Service 调用 SSH Executor 在远程服务器停止当前服务",
        "Deploy Service 调用 SSH Executor 重新执行指定版本的启动脚本",
        "部署成功后在 Database 中记录回滚操作与当前活跃版本"
      ]
    }
  ]
}
