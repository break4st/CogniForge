  "data_flow": [
    {
      "name": "一键部署数据流",
      "steps": [
        "用户在前端选择环境和文件，点击部署",
        "前端调用POST /api/deployments，传递环境ID、文件路径、版本号等",
        "部署服务组件接收请求，进行预检查（本地文件、远程连接与权限）",
        "预检查通过后，建立SSH连接，通过SFTP上传文件",
        "远程创建版本目录，解压或移动文件",
        "根据环境模板生成启动脚本并赋权",
        "可选执行健康检查命令",
        "每步输出记录到历史与日志服务，更新部署记录状态"
      ]
    },
    {
      "name": "环境连接测试数据流",
      "steps": [
        "用户点击某环境的“测试连接”",
        "前端调用POST /api/environments/{id}/test-connection",
        "环境服务组件获取环境加密凭证，调用加密服务解密",
        "环境服务组件将解密后的连接信息传给SSH客户端尝试连接",
        "SSH客户端返回成功或错误，环境服务组件返回前端结果"
      ]
    },
    {
      "name": "主密钥设置与验证流程",
      "steps": [
        "首次启动时，前端显示设置主密码界面",
        "用户输入主密码，前端调用POST /api/master-key",
        "加密服务组件使用PBKDF2派生密钥，生成验证令牌并加密存储",
        "后续启动时，要求输入主密码，调用POST /api/master-key/verify",
        "加密服务验证令牌，成功则缓存主密钥，否则拒绝访问"
      ]
    }
  ],
