    {
      "id": "CTR-003",
      "interface": "deploy:execute",
      "provider_component_id": "CMP-010",
      "provider": "DeploymentService",
      "consumers": [
        "DeployPanel"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "ipc:deploy:execute",
      "request": {
        "projectId": "string",
        "envId": "string",
        "localFilePath": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "versionDir": "string (created directory name)"
        }
      },
      "errors": [
        {
          "status": 400,
          "code": "MISSING_FILE",
          "message": "本地文件不存在"
        },
        {
