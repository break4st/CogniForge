{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-20 16:26"
  },
  "system_overview": {
    "description": "实现将打包好的可执行文件自动化部署到指定远程服务器的功能。支持用户自定义多套部署环境（如测试线、灰度线、正式线等），每套环境可通过密钥配置安全连接，部署时自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。用户可创建和管理多个项目，每个项目拥有独立的部署环境配置，支持在项目间灵活切换，满足多项目并行管理的需求。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "配置和管理多套部署环境（测试线、灰度线、正式线）",
          "配置SSH密钥安全连接",
          "执行一键部署操作",
          "查看部署历史和日志",
          "回滚部署版本"
        ]
      },
      {
        "name": "研发工程师",
        "permissions": [
          "查看项目部署环境",
          "将自测通过的程序部署到测试环境",
          "查看部署状态和结果"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑和管理项目",
          "查看所有项目的部署配置",
          "查看项目部署历史记录",
          "在项目间切换管理"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构 + 分层架构",
    "description": "系统采用前后端分离的微服务架构，前端通过API网关统一接入后端服务。后端按业务领域拆分为项目管理、环境管理、部署编排和SSH执行四个核心服务，数据层统一存储。各服务间通过REST API通信，部署流程通过编排服务协调多个原子服务完成。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web管理控制台"]
      },
      {
        "name": "网关层",
        "components": ["API网关"]
      },
      {
        "name": "业务服务层",
        "components": ["项目管理服务", "环境管理服务", "部署编排服务", "SSH执行服务"]
      },
      {
        "name": "数据层",
        "components": ["关系型数据库", "文件存储"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "SSH"
      },
      {
        "protocol": "JDBC"
      }
    ],
    "features": [
      "前后端分离，独立部署",
      "API网关统一入口，鉴权和路由",
      "业务服务按领域拆分，独立演进",
      "SSH连接池复用，提升执行效率",
      "异步任务编排，部署过程可观测",
      "文件分片传输，支持大文件部署"
    ]
  },
  "components": [
    {
      "name": "Web管理控制台",
      "type": "frontend",
      "description": "用户交互界面，提供项目管理、环境配置、部署操作和状态查看等功能",
      "responsibilities": [
        "展示项目列表和详情",
        "管理部署环境配置",
        "触发一键部署操作",
        "实时展示部署进度",
        "查看部署历史记录"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "系统统一入口，负责请求路由、身份认证、权限校验和流量控制",
      "responsibilities": [
        "请求路由和负载均衡",
        "用户身份认证",
        "接口权限校验",
        "请求日志记录"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "管理项目生命周期，包括项目的创建、编辑、删除和查询",
      "responsibilities": [
        "创建、编辑、删除项目",
        "项目信息查询",
        "项目列表管理",
        "项目与环境关联管理"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理部署环境的配置信息，包括环境创建、SSH密钥配置和连接测试",
      "responsibilities": [
        "创建、编辑、删除部署环境",
        "SSH密钥信息的加密存储",
        "远程服务器连接测试",
        "环境与项目的关联管理"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "核心部署流程编排，协调版本创建、文件传输、脚本生成和执行等步骤",
      "responsibilities": [
        "触发部署任务并编排流程",
        "创建版本化部署目录",
        "管理部署任务状态",
        "记录部署历史",
        "支持版本回滚"
      ]
    },
    {
      "name": "SSH执行服务",
      "type": "service",
      "description": "负责与远程服务器建立SSH连接，执行文件传输和命令执行",
      "responsibilities": [
        "管理SSH连接池",
        "执行远程文件传输（SCP/SFTP）",
        "在远程服务器执行Shell命令",
        "返回执行结果和日志"
      ]
    },
    {
      "name": "关系型数据库",
      "type": "db",
      "description": "持久化存储项目、环境、部署记录等结构化数据",
      "responsibilities": [
        "存储项目信息",
        "存储环境配置（含加密密钥）",
        "存储部署历史记录",
        "存储用户信息"
      ]
    },
    {
      "name": "文件存储",
      "type": "service",
      "description": "存储打包好的可执行文件和部署产生的脚本文件",
      "responsibilities": [
        "接收并存储上传的可执行文件",
        "存储生成的部署脚本",
        "提供文件下载接口"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "项目管理接口",
      "provider": "项目管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "description": "string"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "description": "创建新项目"
    },
    {
      "interface": "项目管理查询接口",
      "provider": "项目管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "page", "type": "int"},
          {"name": "page_size", "type": "int"}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": "array<object>",
          "total": "int",
          "page": "int"
        }
      },
      "description": "查询项目列表"
    },
    {
      "interface": "环境管理接口",
      "provider": "环境管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/environments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "int",
          "name": "string",
          "type": "string（test/staging/production）",
          "host": "string",
          "port": "int",
          "ssh_key": "string（加密传输）",
          "username": "string"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "int",
          "status": "string"
        }
      },
      "description": "创建部署环境并配置SSH连接信息"
    },
    {
      "interface": "连接测试接口",
      "provider": "SSH执行服务",
      "consumers": ["环境管理服务"],
      "type": "REST",
      "endpoint": "POST /api/ssh/test-connection",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "int",
          "username": "string",
          "ssh_key": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "bool",
          "message": "string",
          "latency_ms": "int"
        }
      },
      "description": "测试SSH连接到远程服务器是否可用"
    },
    {
      "interface": "部署触发接口",
      "provider": "部署编排服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/deployments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "int",
          "environment_id": "int",
          "version": "string",
          "file_url": "string",
          "deploy_script": "string"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "int",
          "status": "string（pending）",
          "created_at": "datetime"
        }
      },
      "description": "触发一键部署任务，返回部署任务ID用于后续轮询状态"
    },
    {
      "interface": "部署状态查询接口",
      "provider": "部署编排服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/deployments/{id}/status",
      "request": {
        "path_params": [
          {"name": "id", "type": "int"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "int",
          "status": "string（running/success/failed）",
          "progress": "int（0-100）",
          "current_step": "string",
          "logs": "array<string>"
        }
      },
      "description": "查询指定部署任务的当前状态和进度"
    },
    {
      "interface": "SSH远程执行接口",
      "provider": "SSH执行服务",
      "consumers": ["部署编排服务"],
      "type": "REST",
      "endpoint": "POST /api/ssh/execute",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "int",
          "username": "string",
          "ssh_key": "string",
          "command": "string",
          "timeout": "int"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "bool",
          "stdout": "string",
          "stderr": "string",
          "exit_code": "int"
        }
      },
      "description": "在远程服务器上执行Shell命令（用于创建目录、执行部署脚本等）"
    },
    {
      "interface": "文件传输接口",
      "provider": "SSH执行服务",
      "consumers": ["部署编排服务"],
      "type": "REST",
      "endpoint": "POST /api/ssh/upload",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "int",
          "username": "string",
          "ssh_key": "string",
          "remote_path": "string",
          "file_content": "binary（分片传输）"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "bool",
          "file_size": "int",
          "remote_path": "string"
        }
      },
      "description": "通过SCP/SFTP将可执行文件上传到远程服务器指定目录"
    },
    {
      "interface": "部署历史查询接口",
      "provider": "部署编排服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/deployments/history",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "project_id", "type": "int"},
          {"name": "environment_id", "type": "int（可选）"},
          {"name": "page", "type": "int"},
          {"name": "page_size", "type": "int"}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": "array<object>",
          "total": "int",
          "page": "int",
          "page_size": "int"
        }
      },
      "description": "按项目分页查询部署历史记录列表"
    },
    {
      "interface": "文件上传接口",
      "provider": "文件存储",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "POST /api/files/upload",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "file": "binary（multipart/form-data）",
          "project_id": "int"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "file_id": "int",
          "file_url": "string",
          "file_size": "int",
          "md5": "string"
        }
      },
      "description": "上传可执行文件到文件存储服务"
    },
    {
      "interface": "部署状态推送接口",
      "provider": "部署编排服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "WebSocket /api/deployments/{id}/ws",
      "request": {
        "path_params": [
          {"name": "id", "type": "int"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "protocol": "websocket",
          "message_type": "JSON",
          "events": [
            "progress: {step, percentage}",
            "log: {message, level}",
            "complete: {status, summary}"
          ]
        }
      },
      "description": "通过WebSocket实时推送部署进度和日志到前端"
    }
  ],
  "data_flow": [
    {
      "name": "项目创建流程",
      "steps": [
        "用户在Web控制台填写项目信息",
        "请求经API网关路由到项目管理服务",
        "项目管理服务验证并创建项目记录",
        "项目信息持久化到关系型数据库",
        "返回创建成功结果给前端"
      ]
    },
    {
      "name": "环境配置流程",
      "steps": [
        "用户选择项目并添加部署环境",
        "环境管理服务接收环境配置（含SSH密钥）",
        "SSH密钥加密后持久化存储",
        "环境管理服务调用SSH执行服务测试连接",
        "连接测试结果返回前端展示"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "用户选择项目和目标环境，上传可执行文件",
        "文件存储至文件存储服务",
        "部署编排服务创建版本化部署目录（按日期/版本号）",
        "编排服务调用SSH执行服务创建远程目录",
        "编排服务调用文件传输接口上传可执行文件到远程服务器",
        "编排服务调用SSH接口在远程生成执行脚本",
        "编排服务执行部署脚本",
        "部署进度实时推送至Web控制台",
        "部署结果（成功/失败）记录到数据库",
        "通知用户部署完成"
      ]
    },
    {
      "name": "部署历史查看流程",
      "steps": [
        "用户在前端选择项目查看部署历史",
        "请求经API网关路由到部署编排服务",
        "部署编排服务查询数据库获取历史记录",
        "返回按时间排序的部署历史列表",
        "用户可点击查看单次部署详情"
      ]
    }
  ]
}
