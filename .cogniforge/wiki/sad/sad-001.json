    {
      "id": "CMP-005",
      "name": "部署执行服务",
      "type": "service",
      "status": "active",
      "version": 1,
      "description": "核心部署逻辑。接收部署请求后，调用环境服务获取远程信息，调用密钥服务解密私钥，通过 SSH 建立连接，执行版本文件夹创建、文件上传、脚本生成、软链接更新等操作。同时通过 SSE 通道推送实时日志，并记录部署历史。",
      "responsibilities": [
        "验证部署参数（项目、环境、文件）",
        "通过 SSH 连接远程主机",
        "创建版本文件夹：{label}_{timestamp}",
        "流式上传本地文件到远程版本文件夹",
        "生成并上传 start.sh / stop.sh 脚本",
        "可选执行启动脚本",
        "更新软链接 current 指向最新版本",
        "通过 SSE 推送实时进度和日志",
        "将部署记录写入部署历史"
      ],
