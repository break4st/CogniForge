{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动部署系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-21 10:08"
  },
  "system_overview": {
    "description": "自动部署系统是一个基于 Web 的一键式自动化部署平台，支持用户创建和管理多个项目，每个项目拥有独立的部署环境配置（如测试线、灰度线、正式线）。系统通过 SSH 密钥认证安全连接远程服务器，自动完成可执行文件上传、版本化目录创建、执行脚本生成等部署流程，并提供实时部署状态和日志展示。系统采用前后端分离的微服务架构，通过异步消息队列驱动部署任务执行，确保高可用和可扩展性。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "创建、编辑、删除部署环境",
          "配置每个环境的名称、标识和连接参数",
          "管理 SSH 密钥信息",
          "执行连接测试验证配置",
          "触发生成部署并监控状态"
        ]
      },
      {
        "name": "开发工程师",
        "permissions": [
          "上传或指定可执行文件",
          "一键触发部署到指定环境",
          "查看部署实时状态和日志",
          "选择部署目标版本"
        ]
      },
      {
        "name": "技术管理者",
        "permissions": [
          "创建、删除项目",
          "在多个项目间灵活切换",
          "查看所有项目的部署配置",
          "监控多项目的部署状态"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构",
    "description": "系统采用前后端分离的微服务架构，整体分为四层：接入层（Web Console）提供用户交互界面；网关层（API Gateway）统一入口、路由和认证；服务层由多个职责单一的服务组成，包括项目管理、环境管理、密钥管理、部署编排、SSH执行和审计服务；数据层包含关系型数据库、缓存、消息队列和文件存储。各服务之间通过 REST API 和消息队列解耦通信，部署任务通过异步消息驱动，支持实时状态推送。",
    "layers": [
      {
        "name": "接入层",
        "components": ["Web Console"]
      },
      {
        "name": "网关层",
        "components": ["API Gateway"]
      },
      {
        "name": "服务层",
        "components": [
          "Project Management Service",
          "Environment Management Service",
          "Key Management Service",
          "Deployment Orchestrator",
          "SSH Execution Service",
          "Audit Service"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL",
          "Redis",
          "RabbitMQ",
          "File Storage"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST (JSON)"
      },
      {
        "protocol": "HTTPS / REST (JSON)"
      },
      {
        "protocol": "SQL / PostgreSQL Wire Protocol / Redis Serialization Protocol / AMQP / File I/O"
      }
    ],
    "features": [
      "前后端分离，接入层与网关层通过 REST API 通信",
      "异步消息驱动部署，Deployment Orchestrator 通过 MQ 下发任务",
      "SSH 密钥加密存储，Key Management Service 独立负责密钥生命周期",
      "WebSocket 实时推送部署日志和状态",
      "多租户项目隔离，每个项目的环境配置独立存储",
      "可横向扩展的无状态服务层",
      "全操作审计日志，Audit Service 记录所有变更操作"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "mq": "RabbitMQ 3.12",
    "file_storage": "本地文件系统 / 对象存储 (MinIO)",
    "ssh_library": "asyncssh",
    "real_time_push": "WebSocket (FastAPI WebSocket)"
  },
  "components": [
    {
      "name": "Web Console",
      "type": "frontend",
      "description": "单页应用前端，提供项目、环境、密钥管理和部署操作的可视化界面",
      "responsibilities": [
        "项目和部署环境的 CRUD 操作界面",
        "SSH 密钥上传和管理界面",
        "一键触发部署操作",
        "实时展示部署日志和状态（WebSocket）",
        "多项目切换和导航"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "系统的统一入口网关，负责请求路由、用户认证、限流和日志记录",
      "responsibilities": [
        "统一接收所有前端请求并进行路由分发",
        "用户身份认证和会话管理",
        "请求限流和防护",
        "请求日志记录",
        "转发 WebSocket 连接至相应服务"
      ]
    },
    {
      "name": "Project Management Service",
      "type": "service",
      "description": "管理项目生命周期，提供项目的创建、查询、修改和删除功能",
      "responsibilities": [
        "项目的 CRUD 操作",
        "维护项目与环境的关联关系",
        "项目列表查询和搜索"
      ]
    },
    {
      "name": "Environment Management Service",
      "type": "service",
      "description": "管理部署环境的配置，包括服务器连接参数、环境标识等",
      "responsibilities": [
        "部署环境的 CRUD 操作",
        "环境与项目的绑定关系管理",
        "连接配置参数的验证",
        "连接测试能力（委托 SSH Execution Service 执行）"
      ]
    },
    {
      "name": "Key Management Service",
      "type": "service",
      "description": "负责 SSH 密钥的安全存储、管理和生命周期控制",
      "responsibilities": [
        "SSH 私钥的加密存储",
        "密钥的上传和删除",
        "密钥与环境的关联管理",
        "为 SSH Execution Service 提供密钥解密接口"
      ]
    },
    {
      "name": "Deployment Orchestrator",
      "type": "service",
      "description": "部署流程编排引擎，管理部署任务的创建、调度和执行状态跟踪",
      "responsibilities": [
        "接收部署请求并创建部署任务",
        "将部署任务拆分为步骤并发布到消息队列",
        "跟踪部署状态和进度",
        "通过 WebSocket 推送实时部署日志",
        "管理版本化目录结构"
      ]
    },
    {
      "name": "SSH Execution Service",
      "type": "service",
      "description": "远程命令执行服务，通过 SSH 连接到远程服务器并执行部署操作",
      "responsibilities": [
        "建立 SSH 连接到远程服务器",
        "执行远程命令（创建目录、传输文件、生成脚本等）",
        "实时回传命令执行日志",
        "处理连接错误和重试逻辑"
      ]
    },
    {
      "name": "Audit Service",
      "type": "service",
      "description": "记录系统中所有关键操作和变更的审计日志",
      "responsibilities": [
        "记录用户操作行为（部署、配置变更等）",
        "持久化审计日志到数据库",
        "提供审计日志查询接口"
      ]
    },
    {
      "name": "PostgreSQL",
      "type": "database",
      "description": "主数据库，存储项目、环境、密钥元信息、部署记录和审计日志",
      "responsibilities": [
        "持久化存储项目和环境配置数据",
        "存储部署记录和审计日志",
        "存储用户账号信息",
        "保证数据一致性和事务完整性"
      ]
    },
    {
      "name": "Redis",
      "type": "cache",
      "description": "缓存和会话存储，用于提升系统响应速度和维护实时状态",
      "responsibilities": [
        "用户会话存储",
        "部署实时状态缓存",
        "WebSocket 连接管理信息",
        "分布式锁（防止部署冲突）"
      ]
    },
    {
      "name": "RabbitMQ",
      "type": "infrastructure",
      "description": "异步消息队列，解耦部署任务的生产和消费",
      "responsibilities": [
        "接收部署任务消息",
        "分发任务到 SSH Execution Service",
        "确保任务可靠投递和至少一次消费",
        "支持任务确认和重试"
      ]
    },
    {
      "name": "File Storage",
      "type": "infrastructure",
      "description": "存储用户上传的可执行文件和部署产物",
      "responsibilities": [
        "接收和存储上传的可执行文件",
        "为部署任务提供文件下载/传输路径",
        "文件版本管理",
        "存储部署生成的脚本等中间产物"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "CreateProject",
      "provider": "Project Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": {"type": "string", "required": true, "description": "项目名称"},
          "description": {"type": "string", "required": false, "description": "项目描述"}
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {"type": "string", "description": "项目ID"},
          "name": {"type": "string", "description": "项目名称"},
          "description": {"type": "string", "description": "项目描述"},
          "created_at": {"type": "string", "description": "创建时间"}
        }
      },
      "description": "创建一个新项目"
    },
    {
      "interface": "ListProjects",
      "provider": "Project Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": {
          "page": {"type": "integer", "required": false, "default": 1},
          "page_size": {"type": "integer", "required": false, "default": 20}
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "total": {"type": "integer"},
          "items": {"type": "array", "items": {"$ref": "Project"}}
        }
      },
      "description": "获取当前用户的项目列表"
    },
    {
      "interface": "DeleteProject",
      "provider": "Project Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "DELETE /api/projects/{project_id}",
      "request": {
        "path_params": [{"name": "project_id", "type": "string"}],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204,
        "body": {}
      },
      "description": "删除指定项目及其关联的所有环境配置"
    },
    {
      "interface": "CreateEnvironment",
      "provider": "Environment Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/projects/{project_id}/environments",
      "request": {
        "path_params": [{"name": "project_id", "type": "string"}],
        "query_params": [],
        "body": {
          "name": {"type": "string", "required": true, "description": "环境名称（如 测试线）"},
          "label": {"type": "string", "required": true, "description": "环境标识（如 test/staging/prod）"},
          "host": {"type": "string", "required": true, "description": "远程服务器主机地址"},
          "port": {"type": "integer", "required": true, "default": 22, "description": "SSH 端口"},
          "username": {"type": "string", "required": true, "description": "SSH 登录用户名"},
          "key_id": {"type": "string", "required": true, "description": "关联的 SSH 密钥 ID"},
          "deploy_path": {"type": "string", "required": true, "description": "远程部署根路径"}
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "label": {"type": "string"},
          "host": {"type": "string"},
          "port": {"type": "integer"},
          "username": {"type": "string"},
          "deploy_path": {"type": "string"},
          "created_at": {"type": "string"}
        }
      },
      "description": "为指定项目创建一个新的部署环境"
    },
    {
      "interface": "TestConnection",
      "provider": "Environment Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/environments/{env_id}/test",
      "request": {
        "path_params": [{"name": "env_id", "type": "string"}],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "success": {"type": "boolean", "description": "连接是否成功"},
          "message": {"type": "string", "description": "结果消息"}
        }
      },
      "description": "测试指定环境的 SSH 连接是否可用"
    },
    {
      "interface": "UploadKey",
      "provider": "Key Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": {"type": "string", "required": true, "description": "密钥名称"},
          "private_key": {"type": "string", "required": true, "description": "SSH 私钥内容（PEM 格式）"},
          "passphrase": {"type": "string", "required": false, "description": "私钥密码（可选）"}
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "fingerprint": {"type": "string", "description": "密钥指纹"},
          "created_at": {"type": "string"}
        }
      },
      "description": "上传 SSH 私钥，系统将加密存储"
    },
    {
      "interface": "DeleteKey",
      "provider": "Key Management Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "DELETE /api/keys/{key_id}",
      "request": {
        "path_params": [{"name": "key_id", "type": "string"}],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204,
        "body": {}
      },
      "description": "删除指定 SSH 密钥"
    },
    {
      "interface": "TriggerDeployment",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/projects/{project_id}/deployments",
      "request": {
        "path_params": [{"name": "project_id", "type": "string"}],
        "query_params": [],
        "body": {
          "environment_id": {"type": "string", "required": true, "description": "目标环境 ID"},
          "file_path": {"type": "string", "required": false, "description": "可执行文件路径（已上传）"},
          "version": {"type": "string", "required": true, "description": "部署版本号"},
          "description": {"type": "string", "required": false, "description": "部署说明"}
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deployment_id": {"type": "string"},
          "status": {"type": "string", "description": "初始状态: pending"},
          "created_at": {"type": "string"}
        }
      },
      "description": "触发一次新的部署，系统将异步执行部署流程"
    },
    {
      "interface": "GetDeploymentStatus",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "GET /api/deployments/{deployment_id}",
      "request": {
        "path_params": [{"name": "deployment_id", "type": "string"}],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "id": {"type": "string"},
          "project_id": {"type": "string"},
          "environment_id": {"type": "string"},
          "version": {"type": "string"},
          "status": {"type": "string", "description": "pending/running/success/failed"},
          "steps": {"type": "array", "items": {"type": "object"}},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"}
        }
      },
      "description": "查询指定部署任务的当前状态和进度"
    },
    {
      "interface": "DeploymentLogStream",
      "provider": "Deployment Orchestrator",
      "consumers": ["Web Console"],
      "type": "REST",
      "endpoint": "WebSocket /ws/deployments/{deployment_id}/logs",
      "request": {
        "path_params": [{"name": "deployment_id", "type": "string"}],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "type": {"type": "string", "description": "log/status/error"},
          "data": {"type": "string"},
          "timestamp": {"type": "string"}
        }
      },
      "description": "通过 WebSocket 实时推送部署日志和状态更新"
    },
    {
      "interface": "UploadFile",
      "provider": "File Storage",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "POST /api/files/upload",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "file": {"type": "binary", "required": true, "description": "可执行文件"},
          "project_id": {"type": "string", "required": true}
        }
      },
      "response": {
        "status": 200,
        "body": {
          "file_id": {"type": "string"},
          "file_name": {"type": "string"},
          "size": {"type": "integer"},
          "storage_path": {"type": "string"},
          "uploaded_at": {"type": "string"}
        }
      },
      "description": "上传可执行文件到文件存储"
    },
    {
      "interface": "DispatchDeployTask",
      "provider": "RabbitMQ",
      "consumers": ["Deployment Orchestrator", "SSH Execution Service"],
      "type": "MQ",
      "endpoint": "AMQP exchange: deploy.task",
      "request": {
        "body": {
          "deployment_id": {"type": "string"},
          "environment_id": {"type": "string"},
          "file_path": {"type": "string"},
          "version": {"type": "string"},
          "steps": {"type": "array", "items": {"type": "string"}}
        }
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": {"type": "string"},
          "step": {"type": "string"},
          "status": {"type": "string"},
          "output": {"type": "string"}
        }
      },
      "description": "Deployment Orchestrator 将部署步骤发布到 MQ，SSH Execution Service 消费并执行"
    },
    {
      "interface": "ExecuteSSHCommand",
      "provider": "SSH Execution Service",
      "consumers": ["Deployment Orchestrator"],
      "type": "REST",
      "endpoint": "内部 gRPC / internal/ssh/execute",
      "request": {
        "body": {
          "host": {"type": "string"},
          "port": {"type": "integer"},
          "username": {"type": "string"},
          "key_content": {"type": "string", "description": "解密后的私钥内容"},
          "command": {"type": "string"},
          "timeout": {"type": "integer"}
        }
      },
      "response": {
        "body": {
          "exit_code": {"type": "integer"},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"},
          "executed_at": {"type": "string"}
        }
      },
      "description": "在远程服务器上执行一条 SSH 命令并返回结果"
    },
    {
      "interface": "QueryAuditLogs",
      "provider": "Audit Service",
      "consumers": ["API Gateway"],
      "type": "REST",
      "endpoint": "GET /api/audit/logs",
      "request": {
        "path_params": [],
        "query_params": {
          "project_id": {"type": "string", "required": false},
          "action": {"type": "string", "required": false},
          "page": {"type": "integer", "required": false, "default": 1},
          "page_size": {"type": "integer", "required": false, "default": 20}
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "total": {"type": "integer"},
          "items": {"type": "array", "items": {"$ref": "AuditLogEntry"}}
        }
      },
      "description": "查询审计日志"
    }
  ],
  "data_flow": [
    {
      "name": "项目创建流程",
      "steps": [
        "用户在 Web Console 填写项目信息并提交",
        "API Gateway 接收请求并认证，路由至 Project Management Service",
        "Project Management Service 验证数据并写入 PostgreSQL",
        "返回创建成功结果至 Web Console",
        "Audit Service 记录项目创建操作"
      ]
    },
    {
      "name": "部署环境配置流程",
      "steps": [
        "用户在 Web Console 选择项目并添加部署环境",
        "API Gateway 路由请求至 Environment Management Service",
        "Environment Management Service 验证服务器连接参数",
        "用户上传 SSH 密钥至 Key Management Service，密钥加密存储至 PostgreSQL",
        "密钥 ID 返回并关联到环境配置",
        "用户触发连接测试，Environment Management Service 委托 SSH Execution Service 执行测试",
        "SSH Execution Service 从 Key Management Service 获取解密密钥，建立连接",
        "测试结果实时返回 Web Console"
      ]
    },
    {
      "name": "一键自动化部署流程",
      "steps": [
        "用户上传可执行文件至 File Storage",
