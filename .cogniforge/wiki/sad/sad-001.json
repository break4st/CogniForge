  "data_flow": [
    {
      "name": "部署执行流程",
      "steps": [
        "用户在前端选择环境和包，点击部署",
        "前端POST /api/deployments，携带environment_id和package_id",
        "API服务验证数据，创建状态为pending的部署记录",
        "API服务将部署任务消息（含环境配置、包路径等）投递至Redis队列",
        "部署Worker从队列获取任务，更新部署记录为running",
        "Worker通过Redis Pub/Sub发布初始日志，API服务WebSocket转发至前端",
        "Worker建立SSH连接，在远程执行：创建versions/v{版本号}目录",
        "Worker通过SFTP上传包文件，实时发布进度日志",
        "Worker执行解压命令，在远程目录生成start.sh脚本",
        "若环境配置启用auto_update_current，执行ln -sfn创建/更新软链接",
        "若有自定义命令，执行部署前/后命令",
        "Worker发布完成日志，更新部署记录状态为success/failed",
        "前端通过WebSocket接收最终结果，界面更新"
      ]
    },
    {
      "name": "回滚流程",
      "steps": [
        "用户查看部署历史，对某成功记录点击回滚",
        "前端POST /api/deployments/{id}/rollback",
        "API服务验证原部署记录存在且成功，创建新的回滚部署记录（状态pending）",
        "API投递回滚任务到Redis队列，携带原部署远程路径信息",
        "Worker获取任务，更新记录为running，开始日志推送",
        "Worker SSH连接服务器，验证目标版本目录存在",
        "Worker执行ln -sfn将current指向目标版本目录",
        "若有重启命令，执行重启",
        "Worker完成任务，更新状态并推送完成日志"
      ]
    },
    {
      "name": "项目切换数据刷新",
      "steps": [
        "用户点击顶部项目选择器，切换至另一项目",
        "前端更新全局状态（当前项目ID）",
        "前端自动发送请求：GET /api/projects/{new_id}/environments",
        "前端自动发送请求：GET /api/projects/{new_id}/packages",
        "前端自动发送请求：GET /api/projects/{new_id}/deployments",
        "API服务根据项目ID过滤数据返回",
        "各个组件接收响应并更新视图，无需整页刷新"
      ]
    }
  ],
  "data_models": [
    {
      "name": "Project",
      "fields": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY"},
        {"name": "name", "type": "string", "constraints": "UNIQUE, NOT NULL"},
        {"name": "description", "type": "text", "constraints": "NULLABLE"},
        {"name": "created_at", "type": "datetime", "constraints": "NOT NULL"},
        {"name": "updated_at", "type": "datetime", "constraints": "NOT NULL"}
      ],
      "description": "项目信息表"
    },
    {
      "name": "Environment",
      "fields": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY"},
        {"name": "project_id", "type": "UUID", "constraints": "FOREIGN KEY (Project.id) ON DELETE CASCADE"},
        {"name": "name", "type": "string", "constraints": "NOT NULL, UNIQUE(project_id, name)"},
        {"name": "server_host", "type": "string", "constraints": "NOT NULL"},
        {"name": "server_port", "type": "integer", "constraints": "NOT NULL DEFAULT 22"},
        {"name": "auth_type", "type": "enum('password','private_key')", "constraints": "NOT NULL"},
        {"name": "auth_credential", "type": "text", "constraints": "NOT NULL (加密存储)"},
        {"name": "base_path", "type": "string", "constraints": "NOT NULL"},
        {"name": "auto_update_current", "type": "boolean", "constraints": "NOT NULL DEFAULT false"},
        {"name": "custom_commands", "type": "text", "constraints": "NULLABLE"},
        {"name": "created_at", "type": "datetime", "constraints": "NOT NULL"},
        {"name": "updated_at", "type": "datetime", "constraints": "NOT NULL"}
      ],
      "description": "部署环境配置表"
    },
    {
      "name": "Package",
      "fields": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY"},
        {"name": "project_id", "type": "UUID", "constraints": "FOREIGN KEY (Project.id) ON DELETE CASCADE"},
        {"name": "version", "type": "string", "constraints": "NOT NULL, UNIQUE(project_id, version)"},
        {"name": "description", "type": "text", "constraints": "NULLABLE"},
        {"name": "file_path", "type": "string", "constraints": "NOT NULL"},
        {"name": "file_size", "type": "bigint", "constraints": "NOT NULL"},
        {"name": "uploaded_at", "type": "datetime", "constraints": "NOT NULL"}
      ],
      "description": "部署包元数据表"
    },
    {
      "name": "Deployment",
      "fields": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY"},
        {"name": "project_id", "type": "UUID", "constraints": "FOREIGN KEY (Project.id) ON DELETE CASCADE"},
        {"name": "environment_id", "type": "UUID", "constraints": "FOREIGN KEY (Environment.id) ON DELETE SET NULL"},
        {"name": "package_id", "type": "UUID", "constraints": "FOREIGN KEY (Package.id) ON DELETE SET NULL"},
        {"name": "type", "type": "enum('deploy','rollback')", "constraints": "NOT NULL"},
        {"name": "status", "type": "enum('pending','running','success','failed')", "constraints": "NOT NULL"},
        {"name": "log", "type": "text", "constraints": "NULLABLE (最终日志聚合)"},
        {"name": "remote_path", "type": "string", "constraints": "NULLABLE"},
        {"name": "start_time", "type": "datetime", "constraints": "NULLABLE"},
        {"name": "end_time", "type": "datetime", "constraints": "NULLABLE"},
        {"name": "created_by", "type": "UUID", "constraints": "FOREIGN KEY (User.id)"},
        {"name": "created_at", "type": "datetime", "constraints": "NOT NULL"}
      ],
      "description": "部署记录表"
    },
    {
      "name": "User",
      "fields": [
        {"name": "id", "type": "UUID", "constraints": "PRIMARY KEY"},
        {"name": "username", "type": "string", "constraints": "UNIQUE, NOT NULL"},
        {"name": "password_hash", "type": "string", "constraints": "NOT NULL"},
        {"name": "role", "type": "string", "constraints": "DEFAULT 'developer'"}
      ],
      "description": "用户表（简化认证）"
    }
  ],
