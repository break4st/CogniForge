  "contracts": [
    {
      "id": "CTR-001",
      "interface": "项目管理 API",
      "provider_component_id": "CMP-003",
      "provider": "项目管理服务",
      "consumers": [
        "桌面客户端 (CMP-001)"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "POST /api/projects, GET /api/projects, GET /api/projects/{id}, PUT /api/projects/{id}, DELETE /api/projects/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "项目ID"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string (必填)",
          "description": "string (可选)",
          "local_build_path": "string (必填)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "description": "string",
          "local_build_path": "string",
          "status": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "errors": [
        {
          "status": 409,
          "code": "DUPLICATE_NAME",
          "message": "项目名称已存在"
        },
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "项目不存在"
        },
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "请求体参数错误"
        }
      ],
      "description": "提供对项目实体的创建、查询、更新、删除操作。删除项目时会将状态设为归档，不物理删除。",
      "source_requirements": [
        "REQ-006"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
