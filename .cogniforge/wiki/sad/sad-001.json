  "data_flow": [
    {
      "name": "用户一键部署流程",
      "steps": [
        "1. 用户在前端（CMP-001）填写部署参数并触发部署",
        "2. 请求通过API网关（CMP-002）认证和路由",
        "3. 部署引擎服务（CMP-006）接收到请求，创建异步任务，并立即返回task_id",
        "4. 前端建立WebSocket连接，准备接收实时日志",
        "5. 部署任务执行：CMP-006调用项目管理服务（CMP-004）获取环境和项目配置",
        "6. CMP-006调用服务器管理服务（CMP-005）获取解密后的服务器SSH连接信息",
        "7. CMP-006通过SSH连接远程服务器，执行创建目录、上传文件、解压、生成脚本等操作",
        "8. 每执行一步，CMP-006通过WebSocket将日志推送到前端（CMP-001）",
        "9. 任务完成后，CMP-006发布'DeploymentCompleted'事件到消息队列",
        "10. 日志与历史服务（CMP-007）消费事件，持久化日志和部署记录"
      ]
    },
    {
      "name": "用户登录流程",
      "steps": [
        "1. 前端提交凭证",
        "2. API网关接收后，内部调用用户服务（CMP-003）的认证接口",
        "3. 用户服务验证凭证，生成并返回JWT Token",
        "4. 网关将Token返回前端"
      ]
    }
  ],
