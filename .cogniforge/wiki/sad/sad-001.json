          "status": 400,
          "code": "CANNOT_ROLLBACK",
          "message": "只有成功的部署才能回滚"
        }
      ],
      "description": "基于指定成功部署记录重新发起一次部署（使用相同环境和包），实现回滚。",
      "source_requirements": [
        "REQ-005"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 SAD"
        }
      ]
    }
  ],
  "data_flow": [
    {
      "name": "一键部署主流程",
      "steps": [
        "用户在部署控制台选择环境与软件包，点击部署",
        "前端 POST /api/deployments 携带 environment_id 和 package_id",
        "后端部署编排模块创建 Deployment 记录，通过 Celery 异步发送任务",
        "后端返回 deployment_id",
        "前端建立 WebSocket 连接 /ws/deployments/{deployment_id}",
        "Worker 依次执行：SSH 连接 → 创建版本文件夹 → 上传包 → 解压 → 生成脚本并赋权 → 执行后置命令",
        "每一步通过实时通知模块推送进度和日志到前端",
        "前端更新进度条和日志输出",
        "任务完成或失败，Deployment 更新状态"
      ]
    },
    {
      "name": "回滚流程",
      "steps": [
        "用户从历史面板点击成功部署记录的回滚按钮",
        "前端 POST /api/deployments/{id}/rollback",
        "后端历史模块获取该记录的 environment_id 和 package_id",
        "调用部署编排模块，创建新的 Deployment 并散发异步任务",
        "返回新 deployment_id，前端跳转到部署控制台并连接 WebSocket"
      ]
    },
    {
      "name": "环境测试连接流程",
      "steps": [
        "用户在前端环境表单点击“测试连接”",
        "前端 POST /api/environments/{env_id}/test_connection",
        "后端环境模块解密凭据，使用 SSH 连接管理器建立临时 SSH",
        "返回连接成功或失败详情"
      ]
    }
  ],
