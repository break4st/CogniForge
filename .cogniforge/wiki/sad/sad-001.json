  "system_overview": {
    "description": "DeployFlow 是一款面向小型技术团队的桌面客户端，通过可视化界面管理多套远程环境的连接信息和SSH密钥，实现一键部署与版本回滚。系统采用单体桌面分层架构，基于 Electron 构建，无需服务端。",
    "roles": [
      {
        "name": "开发人员",
        "permissions": [
          "管理环境配置",
          "管理密钥",
          "执行部署",
          "查看部署历史",
          "管理项目"
        ]
      },
      {
        "name": "安全运维人员",
        "permissions": [
          "管理密钥",
          "管理环境配置",
          "执行部署",
          "查看部署历史"
        ]
      },
      {
        "name": "技术负责人",
        "permissions": [
          "管理项目",
          "管理环境配置",
          "管理密钥",
          "执行部署",
          "查看部署历史"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "查看部署历史",
          "执行回滚",
          "管理环境配置"
        ]
      }
    ]
  },
  "architecture": {
    "style": "单体桌面分层架构",
    "description": "基于 Electron 构建跨平台桌面应用，渲染进程处理 UI，主进程处理业务逻辑和 SSH 连接，通过 IPC 通信。内部采用模块化设计，分为表示层、应用层和基础设施层。",
    "layers": [
      {
        "name": "表示层",
        "components": [
          "GUI前端"
        ]
      },
      {
        "name": "应用层",
        "components": [
          "项目管理模块",
          "环境管理模块",
          "密钥管理模块",
          "部署引擎",
          "历史管理模块"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "本地数据库",
          "SSH客户端模块",
          "加密模块"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "Electron IPC",
        "description": "渲染进程通过 IPC 调用主进程方法，主进程返回结果或推送事件。"
      },
      {
        "protocol": "SOCKS (ssh2 库内部)",
        "description": "SSH 客户端通过 SSH 协议与远程服务器通信，包括 SFTP 文件传输和远程命令执行。"
      },
      {
        "protocol": "SQL (sqlite3 库)",
        "description": "应用层通过 ORM 或 SQL 语句操作本地 SQLite 数据库。"
      }
    ],
    "features": [
      "跨平台桌面应用",
      "本地加密存储密钥",
      "可视化环境管理",
      "一键部署与版本目录管理",
      "部署历史与回滚"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Node.js (主进程)",
      "framework": "Electron"
    },
    "frontend": {
      "framework": "React + TypeScript",
      "ui_library": "Ant Design"
    },
    "database": "SQLite",
    "ss_libra": "ssh2",
    "encryption": "Node.js crypto (AES-256-GCM, PBKDF2)"
  },
