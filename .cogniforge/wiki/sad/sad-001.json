  "architecture_decisions": [
    {
      "id": "AD-001",
      "title": "选择 Electron 而非原生桌面框架",
      "context": "需要跨平台（Windows、macOS、Linux）且快速开发丰富的 GUI。",
      "decision": "选用 Electron 结合 React + Ant Design，提供一致的 UI 体验。",
      "rationale": "团队熟悉 Web 技术栈，开发效率高；Electron 生态成熟，可方便集成 Node.js 库（ssh2、better-sqlite3）进行系统操作。",
      "consequences": "应用包体积较大，内存占用略高；但能满足多平台需求，保证迭代速度。"
    },
    {
      "id": "AD-002",
      "title": "密钥加密存储于本地 SQLite",
      "context": "需安全存储 SSH 私钥，防止泄露。",
      "decision": "使用 AES-256-GCM 加密私钥后存入 SQLite，加密密钥由用户主密码或系统密钥环派生，解密仅在内存中进行。",
      "rationale": "能有效保护数据静止安全，且符合 PRD REQ-005 要求，避免私钥明文存储。",
      "consequences": "首次使用需设置主密码，增加用户操作；若忘记主密码，加密数据可能无法恢复。需提供找回或重置机制（如清空所有密钥配置）。"
    },
    {
      "id": "AD-003",
      "title": "部署流程幂等性与原子性",
      "context": "REQ-003 要求部署过程状态清晰，失败不影响远端起服务。",
      "decision": "部署引擎采用步骤化设计，每一步失败可重试，且所有部署操作先上传至临时目录，最后原子性重命名至目标版本文件夹。",
      "rationale": "避免因传输中断导致残留半成品文件夹；临时目录失败不影响原服务。",
      "consequences": "额外增加一次重命名操作，但复杂度可控，能极大提升部署可靠性。"
    }
  ],
  "risks": [
    {
      "id": "RISK-001",
      "description": "SSH 连接稳定性受网络环境影响，部署中断需可靠恢复。",
      "mitigation": "部署引擎支持步骤重试，记录中断点；网络超时参数配置可调。",
      "severity": "中"
    },
    {
      "id": "RISK-002",
      "description": "主密码丢失可能导致所有已存私钥无法解密。",
      "mitigation": "首次设置时强制提醒用户妥善保管；提供“重置密码”（清空所有密钥）选项。",
      "severity": "高"
    }
  ],
