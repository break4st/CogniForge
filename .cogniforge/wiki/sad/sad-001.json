{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "系统架构方案",
    "author": "architect_agent",
    "created": "2026-05-23 22:38",
    "version": 1
  },
  "system_overview": {
    "description": "本平台定位为本地运行的 Web 应用，旨在为开发、运维、发布等角色提供一站式的项目、环境与部署管理工具。用户通过浏览器访问本地服务，完成项目创建、多环境配置、基于 SSH 的自动化部署、版本历史追溯与一键回滚等操作。系统强调安全与溯源，所有 SSH 密钥加密存储且仅在内存中使用，部署过程全程留痕。",
    "roles": [
      {
        "name": "管理员",
        "permissions": [
          "项目管理（增删改查）",
          "环境配置管理",
          "密钥管理",
          "部署执行",
          "回滚操作",
          "脚本模板管理",
          "历史记录查看"
        ]
      }
    ]
  },
  "architecture": {
    "style": "本地 B/S 架构（前后端分离）",
    "description": "前端负责交互与展示，后端负责业务逻辑、安全代理及持久化，两者通过 RESTful API 通信。接入层基于 React 的单页应用，服务层基于 Python FastAPI，数据层采用 SQLite 与本地文件系统。",
    "layers": [
      {
        "name": "接入层",
        "components": [
          "Web 前端 UI",
          "API 网关/认证"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "项目管理服务",
          "环境配置服务",
          "密钥管理服务",
          "部署执行引擎",
          "脚本模板服务",
          "版本历史服务"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH 客户端模块",
          "数据库访问层",
          "文件存储管理"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTP/JSON REST API"
      },
      {
        "protocol": "Python 函数调用 / SQL / 文件 I/O"
      }
    ],
    "features": [
      "本地优先，单机存储",
      "前后端分离，异步实时推送",
      "密钥加密存储，内存解密使用",
      "部署全步骤日志记录与回滚",
      "脚本模板化，支持环境变量注入",
      "轻量 SQLite，可扩展至 PostgreSQL"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.10+",
      "framework": "FastAPI",
      "orm": "SQLAlchemy",
      "ssh_lib": "asyncssh / paramiko"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5",
      "state_mgmt": "Zustand / React Context",
      "build_tool": "Vite"
    },
    "database": "SQLite",
    "file_storage": "本地文件系统",
    "security": "cryptography (AES-256)",
    "server": "Uvicorn"
  },
  "components": [
    {
      "id": "CMP-001",
      "name": "部署执行与脚本管理",
      "type": "service",
      "description": "整合部署执行与脚本模板管理功能。接收部署请求，按步骤执行 SSH 连接、文件夹创建、文件上传、压缩包解压、脚本生成、钩子执行，并推动实时日志；同时管理默认及自定义的启动/停止/检查脚本模板，支持环境变量渲染。",
      "responsibilities": [
        "解析部署请求",
        "协调 SSH 客户端执行步骤",
        "调用脚本模板服务渲染脚本",
        "管理部署流程生命周期",
        "推送实时日志",
        "存储和检索模板",
        "渲染模板（注入环境变量、端口等）",
        "模板版本管理"
      ]
    },
    {
      "id": "CMP-002",
      "name": "版本历史与回滚",
      "type": "service",
      "description": "记录每次部署的元信息（版本、环境、时间、状态、校验码），提供回滚触发逻辑，并与 SSH 客户端协作完成回滚操作。",
      "responsibilities": [
        "记录部署历史",
        "查询部署历史",
        "处理回滚请求",
        "验证目标版本存在性",
        "触发回滚并与 SSH 客户端交互",
        "记录回滚历史"
      ]
    },
    {
      "id": "CMP-003",
      "name": "SSH 与文件管理",
      "type": "infrastructure",
      "description": "封装 SSH 连接、命令执行、文件传输（SFTP）功能，供部署引擎和环境服务调用；同时管理密钥文件、部署包暂存区、模板文件的本地读写。",
      "responsibilities": [
        "建立 SSH 连接（密钥认证）",
        "执行远程命令",
        "SFTP 文件上传/下载",
        "管理连接会话",
        "安全读写加密密钥文件",
        "暂存上传的部署包",
        "清理过期文件",
        "管理模板文件存储"
      ]
    }
  ],
  "contracts": [
    {
      "id": "CTR-001",
      "interface": "获取项目列表",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "search",
            "type": "string",
            "required": false,
            "desc": "按名称搜索"
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "projects": [
            {
              "id": "int",
              "name": "string",
              "description": "string",
              "created_at": "string"
            }
          ]
        }
      },
      "description": "返回所有项目列表，支持按名称模糊搜索"
    },
    {
      "id": "CTR-002",
      "interface": "创建项目",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string (必填)",
          "description": "string (可选)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "description": "string",
          "created_at": "string"
        }
      },
      "description": "新建项目，名称不能重复"
    },
    {
      "id": "CTR-003",
      "interface": "编辑项目",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "PUT /api/projects/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string",
          "description": "string"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "name": "string",
          "description": "string"
        }
      },
      "description": "更新指定项目信息"
    },
    {
      "id": "CTR-004",
      "interface": "删除项目",
      "provider": "项目管理服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "DELETE /api/projects/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204
      },
      "description": "删除项目，若有关联环境返回 409 并要求确认"
    },
    {
      "id": "CTR-005",
      "interface": "获取环境列表",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "GET /api/projects/{project_id}/environments",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "environments": [
            {
              "id": "int",
              "name": "string",
              "host": "string",
              "port": "int",
              "auth_type": "string",
              "deploy_root": "string",
              "env_vars": "object"
            }
          ]
        }
      },
      "description": "获取指定项目下的所有环境配置"
    },
    {
      "id": "CTR-006",
      "interface": "创建环境",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "POST /api/projects/{project_id}/environments",
      "request": {
        "path_params": [
          {
            "name": "project_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string",
          "host": "string",
          "port": "int",
          "auth_type": "string",
          "key_id": "int?",
          "password": "string?",
          "deploy_root": "string",
          "env_vars": "object?"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "host": "string"
        }
      },
      "description": "在指定项目下新建环境"
    },
    {
      "id": "CTR-007",
      "interface": "编辑环境",
      "provider": "环境配置服务",
      "consumers": [
        "Web 前端 UI"
      ],
      "type": "REST",
      "endpoint": "PUT /api/environments/{env_id}",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "type": "int"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string",
          "host": "string",
          "port": "int",
          "deploy_root": "string"
        }
      }
    }
  ]
}