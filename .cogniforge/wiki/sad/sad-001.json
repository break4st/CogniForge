  "system_overview": {
    "description": "智能部署管理器（SmartDeploy）是一款面向开发与运维人员的自动化部署工具。系统支持多项目管理、多环境配置、SSH密钥安全存储、一键自动化部署、版本化目录与脚本生成、部署历史回溯以及项目快速切换。采用微服务架构风格，前后端分离，通过异步消息和实时日志推送提升用户体验。",
    "roles": [
      {
        "name": "管理员",
        "permissions": [
          "manage:projects",
          "manage:environments",
          "manage:keys",
          "deploy:execute",
          "view:history",
          "manage:users"
        ]
      },
      {
        "name": "普通用户",
        "permissions": [
          "view:projects",
          "view:environments",
          "deploy:execute",
          "view:history"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务",
    "description": "采用微服务架构，将系统拆分为API网关、认证服务、业务服务、部署引擎等独立服务。服务间通过REST和AMQP通信，部署任务使用消息队列异步处理，实时日志通过WebSocket推送到前端，确保系统高可用、可扩展和松耦合。",
    "layers": [
      {
        "name": "前端层",
        "components": [
          "Web App"
        ]
      },
      {
        "name": "API网关层",
        "components": [
          "API Gateway"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "Auth Service",
          "Business Service",
          "Deploy Engine"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "MySQL",
          "Redis",
          "RabbitMQ",
          "File Storage"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST",
        "description": "前端通过API网关以REST方式调用后端服务，网关将请求路由至Auth Service和Business Service。"
      },
      {
        "protocol": "AMQP (RabbitMQ)",
        "description": "业务服务将部署任务发布到消息队列，部署引擎消费队列中的任务。"
      },
      {
        "protocol": "WebSocket",
        "description": "部署引擎在执行过程中将实时日志通过WebSocket推送至前端，连接经API网关代理。"
      },
      {
        "protocol": "SQL / TCP",
        "description": "业务服务通过SQL与MySQL交互进行数据持久化，认证服务也可访问同一数据库存储用户信息。"
      },
      {
        "protocol": "TCP / RESP",
        "description": "Redis用于缓存用户会话、临时数据及部署日志流，各服务通过标准Redis客户端连接。"
      }
    ],
    "features": [
      "高可用：服务可独立水平扩展，关键组件支持集群部署",
      "可扩展：新功能可通过新增服务或扩展现有服务实现",
      "松耦合：服务间通过消息队列和明确定义的接口解耦",
      "安全性：SSH私钥使用AES-256加密存储，传输层使用HTTPS",
      "实时性：部署日志通过WebSocket实时推送"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5"
    },
    "database": "MySQL 8.0",
    "cache": "Redis 7",
    "message_queue": "RabbitMQ 3.12",
    "object_storage": "MinIO (或本地文件系统)",
    "containerization": "Docker + Docker Compose"
  },
