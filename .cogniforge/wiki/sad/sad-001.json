  "title": "远程自动化部署系统架构文档",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "远程自动化部署系统旨在帮助开发者将打包后的可执行文件一键部署到远程服务器。系统支持多项目、多环境（测试线、灰度线、正式线）的独立配置，通过 SSH 密钥实现安全连接，自动在远程创建版本文件夹并生成启动/停止脚本，实现版本化部署与快速回滚。同时提供多项目管理能力，允许用户在项目间灵活切换，满足并行开发与运维需求。",
    "roles": [
      {
        "name": "研发工程师",
        "permissions": [
          "创建/编辑/删除项目",
          "配置/管理部署环境",
          "上传/管理SSH密钥",
          "执行一键部署",
          "查看部署历史与审计",
          "切换项目与上下文保持"
        ]
      },
      {
        "name": "运维工程师",
        "permissions": [
          "执行一键部署",
          "查看部署历史与审计",
          "配置/管理部署环境"
        ]
      },
      {
        "name": "技术负责人",
        "permissions": [
          "查看部署历史与审计"
        ]
      }
    ]
  },
  "architecture": {
    "style": "前后端分离单体应用",
    "description": "采用前后端分离的单体应用架构，前端为 React SPA，后端为基于 FastAPI 的 Python 服务。内部按功能模块划分为项目与环境管理、SSH 密钥管理、部署执行、部署历史等服务组件，数据持久化到 PostgreSQL 数据库。部署执行通过 SSH 与远程服务器交互，实时日志通过 SSE 推送。",
    "layers": [
      {
        "name": "前端层",
        "components": [
          "Web前端应用"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API网关/反向代理"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目与环境管理服务",
          "SSH密钥管理服务",
          "部署执行服务",
          "部署历史与审计服务"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "关系型数据库",
          "文件存储"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "SSH客户端库"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "REST",
        "description": "前端与后端所有业务API均通过RESTful协议通信，JSON格式数据传输"
      },
      {
        "protocol": "Server-Sent Events",
        "description": "部署执行服务向前端推送实时日志采用SSE协议"
      }
    ],
    "features": [
      "多项目管理与上下文切换",
      "环境配置与SSH密钥加密存储",
      "一键版本化部署（SSH传输、脚本生成、软链接管理）",
      "部署历史审计与回滚指引",
      "实时部署进度推送"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI",
      "orm": "SQLAlchemy",
      "migration": "Alembic",
      "ssh_library": "asyncssh",
      "encryption": "cryptography"
    },
    "frontend": {
      "framework": "React",
      "language": "TypeScript",
      "build_tool": "Vite",
      "ui_library": "Ant Design",
      "state_management": "Zustand",
      "routing": "React Router v6",
      "http_client": "Axios"
    },
    "database": "PostgreSQL",
    "infrastructure": {
      "web_server": "Nginx",
      "app_server": "Uvicorn",
      "containerization": "Docker (可选)",
      "process_manager": "systemd (可选)"
    }
  },
  "components": [
