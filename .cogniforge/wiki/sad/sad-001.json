{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "远程自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-21 15:01",
    "version": 1
  },
  "system_overview": {
    "description": "远程自动化部署系统是一个基于 Web 的一键式部署平台，采用前后端分离的微服务架构。系统通过 SSH 协议安全连接远程服务器，实现打包好的可执行文件的自动化部署。核心能力包括多项目独立管理、多套部署环境灵活切换、SSH 密钥安全存储、部署流程全自动编排、部署过程实时可视化。系统设计遵循最小权限原则，各服务独立部署、独立扩展，通过 API 网关统一接入，消息队列异步解耦长时任务。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "创建、编辑、删除部署环境",
          "配置环境的 SSH 连接参数和密钥",
          "执行环境连接测试",
          "查看部署历史和日志"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目列表和环境列表",
          "选择项目和目标环境执行一键部署",
          "查看部署进度和结果"
        ]
      },
      {
        "name": "技术负责人",
        "permissions": [
          "管理所有项目配置",
          "查看全局部署状态和统计",
          "审批重要环境的部署操作"
        ]
      },
      {
        "name": "部署管理员",
        "permissions": [
          "为每个项目配置独立的 SSH 密钥和服务器连接",
          "管理项目的环境隔离",
          "查看审计日志"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层微服务架构",
    "description": "系统采用分层微服务架构，从上到下依次为展示层（Web 控制台）、网关层（API 网关统一路由与鉴权）、服务层（六个领域服务各自独立）、数据层（关系型数据库 + 缓存 + 消息队列），以及外部集成层（通过 SSH 协议连接远程服务器）。服务之间通过 RESTful API 同步通信，长时部署任务通过消息队列异步编排，确保系统松耦合、可扩展。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web Console"]
      },
      {
        "name": "网关层",
        "components": ["API Gateway"]
      },
      {
        "name": "服务层",
        "components": [
          "Project Management Service",
          "Environment Management Service",
          "SSH Execution Service",
          "Deployment Orchestrator",
          "Audit Service",
          "Key Management Service"
        ]
      },
      {
        "name": "数据层",
        "components": ["Primary Database", "Redis", "RabbitMQ"]
      },
      {
        "name": "外部集成层",
        "components": ["Remote Servers"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "HTTPS/REST"
      },
      {
        "protocol": "SQL / Redis Protocol / AMQP"
      },
      {
        "protocol": "SSH"
      }
    ],
    "features": [
      "前后端分离，API 网关统一入口",
      "服务无状态，水平扩展",
      "异步消息驱动部署流程",
      "SSH 密钥加密存储",
      "部署任务状态实时缓存",
      "全操作审计日志"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI",
      "async_support": "asyncio + uvicorn"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5.x",
      "state_management": "React Query + Context API",
      "real_time": "Server-Sent Events (SSE)"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "mq": "RabbitMQ 3.12",
    "deployment_protocol": "SSH-2",
    "containerization": "Docker + Docker Compose",
    "api_gateway": "Nginx + OpenResty"
  },
  "components": [
    {
      "name": "Web Console",
      "type": "frontend",
      "description": "基于 React 的单页应用，提供用户操作界面",
      "responsibilities": [
        "项目列表展示与 CRUD 操作界面",
        "环境配置表单与连接测试触发",
        "一键部署按钮与进度可视化展示",
        "部署历史与审计日志查看"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "系统的统一入口网关，负责请求路由、认证和限流",
      "responsibilities": [
        "统一路由转发至各微服务",
        "请求身份认证与会话校验",
        "API 限流与防滥用",
        "请求响应日志记录",
        "跨域策略管理"
      ]
    },
    {
      "name": "Project Management Service",
      "type": "service",
      "description": "管理项目生命周期的微服务",
      "responsibilities": [
        "项目的创建、编辑、删除、查询",
        "项目与环境的关系绑定",
        "项目级别的配置管理"
      ]
    },
    {
      "name": "Environment Management Service",
      "type": "service",
      "description": "管理部署环境的微服务，负责环境配置与 SSH 密钥绑定",
      "responsibilities": [
        "环境的创建、编辑、删除、查询",
        "环境连接参数管理",
        "SSH 密钥与环境绑定",
        "连接测试触发"
      ]
    },
    {
      "name": "SSH Execution Service",
      "type": "service",
      "description": "核心执行引擎，通过 SSH 协议在远程服务器上执行命令和传输文件",
      "responsibilities": [
        "SSH 会话建立与密钥认证",
        "远程目录创建（带版本标识）",
        "文件传输（可执行文件上传）",
        "远程脚本生成与执行",
        "命令执行结果收集与返回"
      ]
    },
    {
      "name": "Deployment Orchestrator",
      "type": "service",
      "description": "部署流程的编排引擎，负责部署任务接收、状态管理和进度发布",
      "responsibilities": [
        "部署任务接收与状态管理",
        "部署步骤编排",
        "异步任务进度发布",
        "部署结果汇总与通知",
        "部署历史记录维护"
      ]
    },
    {
      "name": "Audit Service",
      "type": "service",
      "description": "全操作审计日志服务，记录所有关键操作事件",
      "responsibilities": [
        "记录项目创建、修改、删除操作",
        "记录环境配置变更",
        "记录每次部署请求与结果",
        "审计日志持久化存储与查询"
      ]
    },
    {
      "name": "Key Management Service",
      "type": "service",
      "description": "SSH 密钥安全管理的专用服务，负责密钥的加密存储与访问控制",
      "responsibilities": [
        "SSH 私钥的加密存储与解密使用",
        "密钥的导入与验证",
        "密钥访问权限控制",
        "密钥轮换支持"
      ]
    },
    {
      "name": "Primary Database",
      "type": "database",
      "description": "关系型数据库（PostgreSQL），存储系统全部持久化数据",
      "responsibilities": [
        "项目数据的持久化存储",
        "环境配置数据的持久化",
        "部署历史记录存储",
        "审计日志存储",
        "数据完整性与一致性保障"
      ]
    },
    {
      "name": "Redis",
      "type": "cache",
      "description": "内存缓存和实时状态存储，加速数据访问和实时状态追踪",
      "responsibilities": [
        "用户会话缓存",
        "部署任务实时状态缓存",
        "环境连接测试结果缓存",
        "配置缓存降低数据库压力"
      ]
    },
    {
      "name": "RabbitMQ",
      "type": "mq",
      "description": "消息队列，用于解耦部署请求的提交与执行，支持异步事件驱动通信",
      "responsibilities": [
        "部署任务消息的异步投递",
        "部署进度状态变更的通知分发",
        "服务间事件驱动通信",
        "削峰填谷，平滑处理部署高峰"
      ]
    },
    {
      "name": "Remote Servers",
      "type": "service",
      "description": "外部远程服务器，承载部署目标环境",
      "responsibilities": [
        "提供 SSH 可访问的远程执行环境",
        "接收部署文件并执行部署脚本",
        "返回命令执行结果"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "ProjectCRUD",
      "provider": "Project Management Service",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "POST /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "description": "string (optional)",
          "tags": "string[] (optional)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "string (uuid)",
          "name": "string",
          "description": "string",
          "tags": "string[]",
          "created_at": "string (datetime)"
        }
      },
      "description": "创建新项目，返回项目完整信息"
    },
    {
      "interface": "ProjectQuery",
      "provider": "Project Management Service",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "GET /api/v1/projects",
      "request": {
        "path_params": [],
        "query_params": {
          "page": "int (default 1)",
          "page_size": "int (default 20)",
          "search": "string (optional)"
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": "Project[]",
          "total": "int",
          "page": "int",
          "page_size": "int"
        }
      },
      "description": "分页查询项目列表"
    },
    {
      "interface": "EnvironmentCRUD",
      "provider": "Environment Management Service",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "POST /api/v1/environments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string (uuid)",
          "name": "string",
          "label": "string (enum: test/gray/prod)",
          "host": "string",
          "port": "int (default 22)",
          "username": "string",
          "key_id": "string (uuid, optional)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "string (uuid)",
          "project_id": "string (uuid)",
          "name": "string",
          "label": "string",
          "host": "string",
          "port": "int",
          "username": "string",
          "created_at": "string (datetime)"
        }
      },
      "description": "为指定项目创建新的部署环境"
    },
    {
      "interface": "ConnectionTest",
      "provider": "Environment Management Service",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "POST /api/v1/environments/{id}/test",
      "request": {
        "path_params": {
          "id": "string (uuid)"
        },
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string",
          "latency_ms": "int (optional)"
        }
      },
      "description": "测试指定环境的 SSH 连接可达性"
    },
    {
      "interface": "DeployRequest",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "POST /api/v1/projects/{project_id}/deploy",
      "request": {
        "path_params": {
          "project_id": "string (uuid)"
        },
        "query_params": [],
        "body": {
          "environment_id": "string (uuid)",
          "artifact_path": "string",
          "version": "string",
          "description": "string (optional)"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "string (uuid)",
          "status": "string (enum: pending)",
          "estimated_duration": "string (optional)"
        }
      },
      "description": "提交一键部署请求，返回 deployment_id 用于后续轮询状态"
    },
    {
      "interface": "DeployStatusQuery",
      "provider": "Deployment Orchestrator",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "GET /api/v1/deployments/{deployment_id}/status",
      "request": {
        "path_params": {
          "deployment_id": "string (uuid)"
        },
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string (uuid)",
          "status": "string (enum: pending/running/success/failed)",
          "current_step": "string",
          "progress_pct": "int (0-100)",
          "logs": "string[]",
          "started_at": "string (datetime)",
          "finished_at": "string (datetime, optional)"
        }
      },
      "description": "查询指定部署任务的实时状态和进度日志"
    },
    {
      "interface": "SSHExecute",
      "provider": "SSH Execution Service",
      "consumers": ["Environment Management Service", "Deployment Orchestrator"],
      "type": "REST",
      "endpoint": "POST /internal/ssh/execute",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "int",
          "username": "string",
          "key_id": "string (uuid)",
          "command": "string",
          "timeout_seconds": "int (default 300)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "stdout": "string",
          "stderr": "string",
          "exit_code": "int",
          "duration_ms": "int"
        }
      },
      "description": "内部接口，在远程服务器上执行指定 shell 命令并返回结果"
    },
    {
      "interface": "SSHFileTransfer",
      "provider": "SSH Execution Service",
      "consumers": ["Deployment Orchestrator"],
      "type": "REST",
      "endpoint": "POST /internal/ssh/upload",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "host": "string",
          "port": "int",
          "username": "string",
          "key_id": "string (uuid)",
          "remote_path": "string",
          "file_content_base64": "string",
          "file_mode": "string (default '0755')"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "file_size": "int",
          "checksum": "string (sha256)"
        }
      },
      "description": "内部接口，将可执行文件以 base64 形式传输到远程服务器"
    },
    {
      "interface": "AuditLog",
      "provider": "Audit Service",
      "consumers": ["Project Management Service", "Environment Management Service", "SSH Execution Service", "Deployment Orchestrator", "Key Management Service"],
      "type": "REST",
      "endpoint": "POST /internal/audit/log",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "action": "string",
          "actor": "string (user_id)",
          "resource_type": "string",
          "resource_id": "string (uuid)",
          "detail": "object",
          "result": "string (enum: success/failure)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "audit_id": "string (uuid)",
          "logged_at": "string (datetime)"
        }
      },
      "description": "内部接口，微服务调用以记录关键操作审计日志"
    },
    {
      "interface": "KeyManagement",
      "provider": "Key Management Service",
      "consumers": ["Environment Management Service"],
      "type": "REST",
      "endpoint": "POST /internal/keys/import",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string",
          "private_key": "string (PEM format, will be encrypted at rest)",
          "passphrase": "string (optional)",
          "project_id": "string (uuid)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "key_id": "string (uuid)",
          "name": "string",
          "fingerprint": "string (SHA256 fingerprint)",
          "created_at": "string (datetime)"
        }
      },
      "description": "内部接口，导入 SSH 私钥并加密存储"
    },
    {
      "interface": "DeployTaskQueue",
      "provider": "RabbitMQ",
      "consumers": ["Deployment Orchestrator", "SSH Execution Service"],
      "type": "MQ",
      "endpoint": "exchange: deploy.tasks / routing_key: deploy.execute",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "deployment_id": "string (uuid)",
          "project_id": "string (uuid)",
          "environment_id": "string (uuid)",
          "version": "string",
          "artifact_path": "string",
          "ssh_config": {
            "host": "string",
            "port": "int",
            "username": "string",
            "key_id": "string (uuid)"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string (uuid)",
          "status": "string",
          "message": "string"
        }
      },
      "description": "Deployment Orchestrator 发布部署任务消息，SSH Execution Service 消费并执行"
    },
    {
      "interface": "DeployProgressQueue",
      "provider": "RabbitMQ",
      "consumers": ["SSH Execution Service", "Deployment Orchestrator"],
      "type": "MQ",
      "endpoint": "exchange: deploy.progress / routing_key: deploy.progress.update",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "deployment_id": "string (uuid)",
          "status": "string (enum: running/success/failed)",
          "current_step": "string",
          "progress_pct": "int (0-100)",
          "logs": "string[]",
          "timestamp": "string (datetime)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "received": "boolean"
        }
      },
      "description": "SSH Execution Service 在执行过程中发布进度消息，Deployment Orchestrator 消费并更新状态"
    }
  ],
  "data_flow": [
    {
      "name": "项目管理流程",
      "steps": [
        "用户通过 Web Console 填写项目表单",
        "API Gateway 接收请求并校验身份",
        "API Gateway 转发 POST /api/v1/projects 到 Project Management Service",
        "Project Management Service 校验项目参数",
        "写入 Primary Database 持久化项目数据",
        "发送审计日志到 Audit Service",
        "返回创建结果给前端"
      ]
    },
    {
      "name": "环境配置与连接测试流程",
      "steps": [
        "用户在 Web Console 选择项目后进入环境管理",
        "填写环境参数并选择/导入 SSH 密钥",
        "API Gateway 转发请求到 Environment Management Service",
        "Environment Management Service 校验参数",
        "调用 Key Management Service 加密存储 SSH 密钥",
        "写入 Primary Database 持久化环境数据",
        "用户点击「测试连接」触发连接测试",
        "Environment Management Service 调用 SSH Execution Service 执行轻量探测命令",
        "测试结果经 API Gateway 返回前端展示"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "用户在 Web Console 选择项目、目标环境和部署文件",
        "Web Console 调用 POST /api/v1/projects/{id}/deploy 提交部署请求",
        "API Gateway 转发到 Deployment Orchestrator",
        "Deployment Orchestrator 创建部署记录写入 Primary Database，状态为 pending",
        "Orchestrator 发布部署任务消息到 RabbitMQ deploy_tasks 队列",
        "Web Console 开始轮询 GET /api/v1/deployments/{id}/status 获取进度",
        "SSH Execution Service 消费队列消息，执行实际部署步骤",
        "SSH Execution Service 在远程服务器创建带版本标识的目录结构",
        "SSH Execution Service 上传可执行文件到远程目录",
        "SSH Execution Service 生成部署脚本并传输到远程服务器",
        "SSH Execution Service 执行部署脚本并收集执行结果",
        "每完成一个步骤，SSH Execution Service 通过 RabbitMQ 发布进度消息",
        "Deployment Orchestrator 消费进度消息，更新 Redis 中的实时状态和数据库中记录",
        "Web Console 轮询到最终结果，展示部署成功/失败与详细日志"
      ]
    },
    {
      "name": "审计日志记录流程",
      "steps": [
        "各微服务在执行关键操作时构建审计事件",
        "调用 Audit Service 的 /internal/audit/log 接口",
        "Audit Service 校验事件格式，补全时间戳",
        "审计日志写入 Primary Database 的 audit_logs 表",
        "审计日志可通过 Web Console 的管理界面查询和导出"
      ]
    }
  ]
}
