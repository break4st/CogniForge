{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统架构",
    "author": "architect_agent",
    "created": "2026-05-22 17:15"
  },
  "system_overview": {
    "description": "自动化部署系统提供将可执行文件一键部署到远程服务器的完整解决方案。系统支持用户自定义多套部署环境（测试线、灰度线、正式线），通过SSH密钥配置安全连接，部署时自动在远程服务器创建版本化文件夹并生成执行脚本。同时支持多项目管理，每个项目拥有独立的环境配置，满足并行管理需求。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "创建、编辑、删除部署环境",
          "配置SSH密钥和服务器连接",
          "测试环境连接可用性",
          "查看部署日志和状态"
        ]
      },
      {
        "name": "开发工程师",
        "permissions": [
          "选择项目和目标环境",
          "上传可执行文件",
          "触发一键部署",
          "查看部署进度和结果"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、删除项目",
          "查看所有项目列表和状态",
          "在项目间切换管理",
          "查看部署历史记录"
        ]
      },
      {
        "name": "安全管理员",
        "permissions": [
          "审核SSH密钥配置",
          "管理密钥上传和吊销",
          "查看审计日志",
          "监控安全连接状态"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构",
    "description": "采用前后端分离的微服务架构，前端通过API网关统一接入，后端按业务域拆分为多个独立服务（项目管理、环境管理、部署引擎、SSH密钥管理、审计日志）。服务间通过消息队列实现异步解耦，部署任务采用事件驱动模型异步执行，前端通过WebSocket实时推送部署进度。数据库采用关系型数据库存储核心业务数据，Redis用于缓存和会话管理。",
    "layers": [
      {
        "name": "接入层",
        "components": ["Web控制台"]
      },
      {
        "name": "网关层",
        "components": ["API网关"]
      },
      {
        "name": "服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署引擎服务",
          "SSH密钥管理服务",
          "审计日志服务"
        ]
      },
      {
        "name": "数据层",
        "components": ["PostgreSQL", "Redis", "RabbitMQ"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST (JSON)"
      },
      {
        "protocol": "HTTPS / REST (JSON)"
      },
      {
        "protocol": "SQL / Redis协议 / AMQP"
      }
    ],
    "features": [
      "前后端分离，独立部署演进",
      "微服务架构，按业务域拆分",
      "统一API网关，集中路由和鉴权",
      "异步部署任务，事件驱动执行",
      "WebSocket实时进度推送",
      "SSH密钥加密存储，安全审计追踪",
      "多租户项目管理隔离"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Go",
      "framework": "Gin",
      "runtime": "Docker容器化部署"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5",
      "state_management": "Zustand",
      "build_tool": "Vite"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "mq": "RabbitMQ 3.12",
    "ssh": "golang.org/x/crypto/ssh",
    "protocol": {
      "api": "RESTful JSON",
      "realtime": "WebSocket",
      "async": "AMQP"
    }
  },
  "components": [
    {
      "name": "Web控制台",
      "type": "frontend",
      "description": "基于React的管理控制台，提供项目、环境、部署的全流程可视化操作界面",
      "responsibilities": [
        "项目列表展示和管理操作",
        "部署环境配置表单",
        "SSH密钥上传和管理界面",
        "一键部署触发与进度可视化",
        "部署历史记录和日志查看",
        "通过WebSocket实时接收部署状态推送"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "统一入口网关，负责请求路由、身份认证、限流和日志记录",
      "responsibilities": [
        "前端请求路由到后端各服务",
        "统一身份认证和鉴权",
        "请求速率限制",
        "跨域配置",
        "请求日志记录",
        "静态资源托管"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "负责项目的创建、编辑、删除、查询以及项目间切换等管理功能",
      "responsibilities": [
        "项目CRUD操作",
        "项目列表查询与分页",
        "项目状态管理",
        "项目-环境关联关系维护"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理部署环境的配置信息，包括服务器地址、连接参数、环境类型等",
      "responsibilities": [
        "部署环境CRUD操作",
        "环境类型管理（测试线/灰度线/正式线）",
        "环境-项目关联关系维护",
        "环境配置的校验",
        "服务器连接测试（ping/SSH）"
      ]
    },
    {
      "name": "部署引擎服务",
      "type": "service",
      "description": "核心部署引擎，接收部署请求后异步执行文件传输、脚本生成和远程执行等部署步骤",
      "responsibilities": [
        "接收和校验部署请求",
        "生成部署任务并投递到消息队列",
        "通过SSH连接到远程服务器",
        "在远程服务器创建版本化文件夹",
        "上传可执行文件到远程服务器",
        "生成并执行启动脚本",
        "实时更新部署状态并推送",
        "记录部署日志"
      ]
    },
    {
      "name": "SSH密钥管理服务",
      "type": "service",
      "description": "管理SSH密钥的上传、存储、验证和吊销，确保远程连接的安全性",
      "responsibilities": [
        "SSH密钥上传和解析",
        "密钥加密存储管理",
        "密钥与环境的关联绑定",
        "密钥有效性验证",
        "密钥吊销和轮换",
        "密钥使用审计记录"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "统一记录系统中的所有操作行为，支持查询和审计追踪",
      "responsibilities": [
        "操作日志的采集和存储",
        "审计日志查询和筛选",
        "日志分级管理",
        "操作时间线和用户行为追溯"
      ]
    },
    {
      "name": "PostgreSQL",
      "type": "database",
      "description": "主数据库，存储项目、环境、部署记录、密钥元数据、审计日志等核心业务数据",
      "responsibilities": [
        "业务数据持久化存储",
        "事务性数据一致性保障",
        "数据备份和恢复",
        "索引优化查询性能"
      ]
    },
    {
      "name": "Redis",
      "type": "cache",
      "description": "缓存服务，用于会话管理、部署状态缓存、WebSocket连接管理等场景",
      "responsibilities": [
        "用户会话缓存",
        "部署实时状态缓存",
        "WebSocket连接管理",
        "分布式锁（防重复部署）"
      ]
    },
    {
      "name": "RabbitMQ",
      "type": "infrastructure",
      "description": "消息队列，解耦部署请求的接收与执行，实现异步处理",
      "responsibilities": [
        "部署任务异步投递",
        "任务队列管理和调度",
        "消息持久化保障不丢失",
        "消息确认和重试机制"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "创建项目",
      "provider": "项目管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": {"type": "string", "description": "项目名称", "required": true},
          "description": {"type": "string", "description": "项目描述", "required": false}
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {"type": "integer", "description": "项目ID"},
          "name": {"type": "string", "description": "项目名称"},
          "description": {"type": "string", "description": "项目描述"},
          "created_at": {"type": "string", "description": "创建时间"}
        }
      },
      "description": "创建一个新的部署项目"
    },
    {
      "interface": "获取项目列表",
      "provider": "项目管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "page", "type": "integer", "description": "页码", "default": 1},
          {"name": "page_size", "type": "integer", "description": "每页数量", "default": 20}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "projects": {"type": "array", "items": {"type": "object"}, "description": "项目列表"},
          "total": {"type": "integer", "description": "总记录数"},
          "page": {"type": "integer", "description": "当前页码"},
          "page_size": {"type": "integer", "description": "每页数量"}
        }
      },
      "description": "获取当前用户的所有项目列表"
    },
    {
      "interface": "编辑项目",
      "provider": "项目管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "PUT /api/projects/{project_id}",
      "request": {
        "path_params": [
          {"name": "project_id", "type": "integer", "description": "项目ID"}
        ],
        "query_params": [],
        "body": {
          "name": {"type": "string", "description": "项目名称", "required": false},
          "description": {"type": "string", "description": "项目描述", "required": false}
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": {"type": "integer", "description": "项目ID"},
          "name": {"type": "string", "description": "项目名称"},
          "description": {"type": "string", "description": "项目描述"},
          "updated_at": {"type": "string", "description": "更新时间"}
        }
      },
      "description": "编辑指定项目的名称和描述信息"
    },
    {
      "interface": "删除项目",
      "provider": "项目管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "DELETE /api/projects/{project_id}",
      "request": {
        "path_params": [
          {"name": "project_id", "type": "integer", "description": "项目ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204,
        "body": {}
      },
      "description": "删除指定项目及其关联的环境配置"
    },
    {
      "interface": "创建部署环境",
      "provider": "环境管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/projects/{project_id}/environments",
      "request": {
        "path_params": [
          {"name": "project_id", "type": "integer", "description": "所属项目ID"}
        ],
        "query_params": [],
        "body": {
          "name": {"type": "string", "description": "环境名称", "required": true},
          "type": {"type": "string", "enum": ["test", "canary", "production"], "description": "环境类型", "required": true},
          "server_host": {"type": "string", "description": "服务器主机地址", "required": true},
          "server_port": {"type": "integer", "description": "SSH端口", "default": 22, "required": true},
          "deploy_path": {"type": "string", "description": "远程部署路径", "required": true}
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {"type": "integer", "description": "环境ID"},
          "name": {"type": "string", "description": "环境名称"},
          "type": {"type": "string", "description": "环境类型"},
          "server_host": {"type": "string", "description": "服务器地址"},
          "server_port": {"type": "integer", "description": "SSH端口"},
          "deploy_path": {"type": "string", "description": "部署路径"},
          "created_at": {"type": "string", "description": "创建时间"}
        }
      },
      "description": "为指定项目创建一个新的部署环境"
    },
    {
      "interface": "获取环境列表",
      "provider": "环境管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/projects/{project_id}/environments",
      "request": {
        "path_params": [
          {"name": "project_id", "type": "integer", "description": "项目ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "environments": {"type": "array", "items": {"type": "object"}, "description": "环境列表"}
        }
      },
      "description": "获取指定项目下的所有部署环境"
    },
    {
      "interface": "测试环境连接",
      "provider": "环境管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/environments/{env_id}/test-connection",
      "request": {
        "path_params": [
          {"name": "env_id", "type": "integer", "description": "环境ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "connected": {"type": "boolean", "description": "连接是否成功"},
          "message": {"type": "string", "description": "连接结果消息"},
          "latency_ms": {"type": "integer", "description": "延迟毫秒数"}
        }
      },
      "description": "测试到指定环境远程服务器的SSH连接是否可用"
    },
    {
      "interface": "上传SSH密钥",
      "provider": "SSH密钥管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/environments/{env_id}/keys",
      "request": {
        "path_params": [
          {"name": "env_id", "type": "integer", "description": "环境ID"}
        ],
        "query_params": [],
        "body": {
          "key_name": {"type": "string", "description": "密钥名称", "required": true},
          "key_type": {"type": "string", "enum": ["ed25519", "rsa"], "description": "密钥类型", "required": true},
          "private_key": {"type": "string", "description": "私钥内容", "required": true},
          "passphrase": {"type": "string", "description": "密钥口令", "required": false}
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": {"type": "integer", "description": "密钥ID"},
          "key_name": {"type": "string", "description": "密钥名称"},
          "key_type": {"type": "string", "description": "密钥类型"},
          "fingerprint": {"type": "string", "description": "密钥指纹"},
          "created_at": {"type": "string", "description": "上传时间"}
        }
      },
      "description": "为指定部署环境上传SSH私钥，密钥将加密存储"
    },
    {
      "interface": "删除SSH密钥",
      "provider": "SSH密钥管理服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "DELETE /api/keys/{key_id}",
      "request": {
        "path_params": [
          {"name": "key_id", "type": "integer", "description": "密钥ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 204,
        "body": {}
      },
      "description": "吊销并删除指定SSH密钥"
    },
    {
      "interface": "触发部署",
      "provider": "部署引擎服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "POST /api/deployments",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": {"type": "integer", "description": "项目ID", "required": true},
          "environment_id": {"type": "integer", "description": "目标环境ID", "required": true},
          "file_name": {"type": "string", "description": "可执行文件名", "required": true},
          "file_content": {"type": "string", "description": "文件内容(Base64编码)", "required": true},
          "version": {"type": "string", "description": "版本号", "required": false}
        }
      },
      "response": {
        "status": 202,
        "body": {
          "deployment_id": {"type": "integer", "description": "部署记录ID"},
          "status": {"type": "string", "description": "初始状态", "default": "pending"},
          "created_at": {"type": "string", "description": "创建时间"}
        }
      },
      "description": "触发一次一键部署，上传可执行文件并自动部署到目标环境"
    },
    {
      "interface": "获取部署状态",
      "provider": "部署引擎服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/deployments/{deployment_id}",
      "request": {
        "path_params": [
          {"name": "deployment_id", "type": "integer", "description": "部署记录ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": {"type": "integer", "description": "部署记录ID"},
          "project_id": {"type": "integer", "description": "项目ID"},
          "environment_id": {"type": "integer", "description": "环境ID"},
          "status": {"type": "string", "enum": ["pending", "running", "success", "failed"], "description": "部署状态"},
          "version": {"type": "string", "description": "版本号"},
          "remote_path": {"type": "string", "description": "远程部署路径"},
          "logs": {"type": "array", "items": {"type": "string"}, "description": "部署日志"},
          "started_at": {"type": "string", "description": "开始时间"},
          "finished_at": {"type": "string", "description": "完成时间"}
        }
      },
      "description": "获取指定部署任务的当前状态和日志"
    },
    {
      "interface": "获取部署历史",
      "provider": "部署引擎服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/deployments",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "project_id", "type": "integer", "description": "项目ID筛选"},
          {"name": "environment_id", "type": "integer", "description": "环境ID筛选"},
          {"name": "status", "type": "string", "description": "状态筛选"},
          {"name": "page", "type": "integer", "description": "页码", "default": 1},
          {"name": "page_size", "type": "integer", "description": "每页数量", "default": 20}
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "deployments": {"type": "array", "items": {"type": "object"}, "description": "部署记录列表"},
          "total": {"type": "integer", "description": "总记录数"}
        }
      },
      "description": "查询部署历史记录列表，支持按项目、环境和状态筛选"
    },
    {
      "interface": "WebSocket部署状态推送",
      "provider": "部署引擎服务",
      "consumers": ["Web控制台"],
      "type": "REST",
      "endpoint": "WS /ws/deployments/{deployment_id}",
      "request": {
        "path_params": [
          {"name": "deployment_id", "type": "integer", "description": "部署记录ID"}
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "type": {"type": "string", "enum": ["status", "log", "complete"], "description": "消息类型"},
          "data": {"type": "object", "description": "消息数据"}
        }
      },
      "description": "通过WebSocket实时推送部署进度和日志到前端"
    },
    {
      "interface": "查询审计日志",
      "provider": "审计日志服务",
      "consumers": ["API网关"],
      "type": "REST",
      "endpoint": "GET /api/audit-logs",
      "request": {
        "path_params": [],
        "query_params": [
          {"name": "action", "type": "string", "description": "操作类型筛选"},
          {"name": "actor", "type": "string", "description": "操作人筛选"},
          {"name": "start_time", "type": "string", "description": "开始时间"},
