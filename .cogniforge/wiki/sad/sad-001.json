  "title": "DeployFlow 多项目自动化部署平台 系统架构文档",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "DeployFlow 是一款面向开发团队的自动化部署管理工具，目标是将本地打包好的可执行文件安全、快速地部署到远程服务器。系统采用微服务架构，支持多项目独立管理，每个项目可配置多套环境，通过密钥安全连接服务器，实现一键式标准化部署，并提供审计追溯和密钥加密存储。",
    "roles": [
      {
        "name": "项目经理",
        "permissions": [
          "创建项目",
          "编辑项目",
          "删除项目",
          "查看所有项目部署历史"
        ]
      },
      {
        "name": "开发工程师",
        "permissions": [
          "管理自己负责项目的环境配置",
          "在项目下执行部署",
          "查看项目部署历史"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "管理所有项目的环境配置",
          "执行所有项目的部署操作"
        ]
      },
      {
        "name": "安全管理员",
        "permissions": [
          "管理密钥库（添加、吊销私钥）",
          "查看密钥使用审计日志"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构",
    "description": "系统由多个独立微服务组成，包括项目管理、环境管理、密钥管理、部署编排和日志审计服务。前端通过API网关统一访问后端服务。部署执行过程中产生的实时日志通过消息队列异步处理，确保系统响应性和可扩展性。",
    "layers": [
      {
        "name": "表示层",
        "components": [
          "DeployFlow Web 前端"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API 网关"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "密钥管理服务",
          "部署编排服务",
          "日志与审计服务"
        ]
      },
      {
        "name": "数据层与基础设施",
        "components": [
          "关系数据库 PostgreSQL",
          "键值缓存 Redis",
          "消息队列 RabbitMQ",
          "对象存储 MinIO"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTP/REST",
        "description": "表示层与网关层之间、网关层与服务层之间使用RESTful API进行同步通信，所有请求经过JWT认证和路由。"
      },
      {
        "protocol": "gRPC",
        "description": "服务间同步内部调用（如密钥管理服务向部署编排服务或环境管理服务提供解密后的密钥）使用gRPC，以获得更高性能和强类型契约。"
      },
      {
        "protocol": "AMQP",
        "description": "部署编排服务通过RabbitMQ消息队列异步推送实时部署日志给日志与审计服务，实现削峰填谷和解耦。"
      },
      {
        "protocol": "WebSocket",
        "description": "前端通过网关代理的WebSocket连接至部署编排服务，接收实时部署日志流。"
      }
    ],
    "features": [
      "高可用：关键服务无状态设计，支持多副本部署；数据库和消息队列采用主从复制或集群模式。",
      "可扩展：独立服务可根据负载水平扩展，特别是部署编排服务。",
      "独立部署：每个微服务可独立构建、测试和部署，互不影响。",
      "安全纵深防御：密钥静态加密存储，传输加密，仅在内存解密且用完即毁。",
      "可观测性：集中式日志收集、结构化日志输出和部署全流程追踪。"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design"
    },
    "database": "PostgreSQL",
    "cache": "Redis",
    "message_queue": "RabbitMQ",
    "object_storage": "MinIO",
    "internal_rpc": "gRPC",
    "auth": "JWT (JSON Web Tokens)",
    "deployment_engine": "Paramiko (SSH), asyncssh (可选异步支持)"
  },
