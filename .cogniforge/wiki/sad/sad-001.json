      "provider_component_id": "CMP-004",
      "provider": "环境管理服务",
      "consumers": [
        "DeployFlow Web 前端",
        "API 网关"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "POST /api/v1/environments/{env_id}/test-connection",
      "request": {
        "path_params": [
          {
            "name": "env_id",
            "description": "环境ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "success",
                "failure"
              ]
            },
