  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户选择项目、环境、本地文件、版本标签",
        "前端调用 deployment.start IPC",
        "DeploymentService 从 EnvironmentService 获取解密凭据",
        "DeploymentService 调用 SSHService 建立连接",
        "执行远程命令创建 releases/<version> 目录",
        "SFTP 上传文件并校验 MD5",
        "生成并上传管理脚本 (start/stop/restart)",
        "若配置前置脚本则执行",
        "更新 current 软链接指向新版本",
        "若配置后置脚本则执行",
        "整个过程通过 LoggerService 推送实时日志",
        "记录部署结果到数据库",
        "成功则返回部署记录 ID；失败则清理远程文件并抛出错误"
      ]
    },
    {
      "name": "回滚流程",
      "steps": [
        "用户在部署历史页面选择一条记录并确认回滚",
        "调用 deployment.rollback IPC",
        "RollbackService 查询原部署记录，获取环境和版本信息",
        "验证远程服务器上该版本目录是否存在",
        "更新 current 软链接指向该版本目录",
        "尝试执行该版本目录下的 start.sh",
        "记录回滚操作（新部署记录或状态更新）"
      ]
    },
    {
      "name": "主密码设置/验证流程",
      "steps": [
        "首次启动或修改主密码时，前端弹出设置界面",
        "通过 IPC 调用 masterPassword.set/change",
        "SecurityService 使用 PBKDF2 派生密钥，存储哈希",
        "修改主密码时，用旧密码解密所有敏感数据，再用新密码重新加密",
        "启动验证时，读取哈希并验证输入的密码"
      ]
    }
  ],
