  "title": "基于已批准的PRD文档的系统架构设计",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "AutoShip 是一个多项目、多环境的自动化部署平台，采用分层单体架构，结合异步任务执行部署操作。系统包含前端SPA、API网关、Web API服务、部署Worker、数据库和文件存储。支持项目管理、环境配置、包管理、一键部署与回滚，并通过WebSocket实现实时日志推送。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": ["创建/管理项目", "配置环境（含凭据）", "触发部署"]
      },
      {
        "name": "开发人员",
        "permissions": ["上传部署包", "执行测试环境部署"]
      },
      {
        "name": "发布协调员",
        "permissions": ["管理密钥", "执行安全部署"]
      },
      {
        "name": "团队负责人",
        "permissions": ["查看部署历史", "执行回滚操作"]
      },
      {
        "name": "系统管理员",
        "permissions": ["自定义启动脚本", "高级环境配置"]
      }
    ]
  },
  "architecture": {
    "style": "分层单体 + 异步任务",
    "description": "整体采用分层架构，前端通过网关访问后端API，API服务处理业务逻辑，通过消息队列将部署任务派发给独立的Worker进程执行。Worker完成SSH操作后将日志通过Redis Pub/Sub实时推送到前端。数据层使用关系数据库存储元数据，文件系统存储部署包。",
    "layers": [
      {
        "name": "接入层",
        "components": ["AutoShip UI"]
      },
      {
        "name": "网关层",
        "components": ["Nginx 反向代理"]
      },
      {
        "name": "服务层",
        "components": ["AutoShip API 服务", "部署执行 Worker"]
      },
      {
        "name": "数据层",
        "components": ["PostgreSQL 数据库", "包文件存储"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS / REST",
        "description": "前端与API服务之间通过HTTPS进行RESTful JSON通信"
      },
      {
        "protocol": "WebSocket",
        "description": "前端与API服务建立WebSocket连接，接收实时部署日志"
      },
      {
        "protocol": "SQL",
        "description": "API服务通过ORM（SQLAlchemy）与PostgreSQL数据库通信"
      },
      {
        "protocol": "Redis 消息队列 (Celery)",
        "description": "API服务将部署任务放入Redis队列，Worker从队列取任务"
      },
      {
        "protocol": "Redis Pub/Sub",
        "description": "Worker将部署日志发布到Redis频道，API服务订阅后通过WebSocket推向前端"
      },
      {
        "protocol": "SSH / SFTP",
        "description": "部署Worker通过SSH协议连接远程服务器，进行文件传输和命令执行"
      }
    ],
    "features": [
      "异步任务解耦部署操作，避免阻塞API服务",
      "WebSocket实现实时日志推送，提升用户体验",
      "凭据加密存储（AES），保障敏感信息安全",
      "包文件独立存储，支持横向扩展（如切换到对象存储）",
      "前端采用全局状态管理，实现项目切换数据即时刷新",
      "Worker可独立扩展，提高部署并发能力"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL 15",
    "message_queue": "Redis (Celery broker)",
    "file_storage": "本地文件系统 / MinIO 对象存储",
    "ssh_library": "paramiko",
    "reverse_proxy": "Nginx",
    "real_time": "WebSocket (FastAPI) + Redis Pub/Sub"
  },
