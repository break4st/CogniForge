            "required": false
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "deployment_id": {
            "type": "string",
            "description": "部署任务ID"
          },
          "status": {
            "type": "string",
            "description": "初始状态（pending）"
          },
          "created_at": {
            "type": "string",
            "description": "创建时间"
          }
        }
      },
      "description": "触发一键自动化部署，返回任务ID供后续追踪"
    },
    {
      "interface": "部署状态查询API",
      "provider": "部署编排服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/deployments/{id}",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "string",
            "description": "部署任务ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "id": {
            "type": "string",
            "description": "部署任务ID"
          },
          "project_id": {
            "type": "string",
            "description": "项目ID"
          },
