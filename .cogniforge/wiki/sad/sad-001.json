{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "学生管理系统 - 系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-20 13:44"
  },
  "system_overview": "构建一个全面的学生管理系统，用于高效管理学生信息、班级信息、年级信息以及学习统计数据，为学校提供数字化的管理解决方案。系统支持三类用户角色：管理员（管理学生、班级和年级信息）、老师（查看所教班级的学生信息和统计数据）、学生（查看个人基本信息和学习统计数据）。",
  "architecture": "采用微服务架构风格，将系统拆分为多个高内聚低耦合的领域服务。前端通过 API Gateway 统一接入，后端按业务领域划分为学生服务、班级服务、年级服务、统计服务四个微服务，共享关系型数据库作为主存储，Redis 作为缓存层提升查询性能，消息队列用于异步统计任务解耦。每个微服务独立部署、独立演进，通过 API Gateway 对外暴露 RESTful 接口。",
  "components": [
    {
      "name": "Web UI",
      "type": "frontend",
      "description": "用户交互界面，面向管理员、老师、学生三类角色提供不同的视图和操作能力",
      "responsibilities": [
        "提供学生信息管理界面（增删改查）",
        "提供班级信息管理界面（创建、编辑、分配学生）",
        "提供年级信息管理界面（创建、编辑、关联班级）",
        "提供学习统计数据看板和可视化图表",
        "基于用户角色（管理员/老师/学生）控制功能权限和视图范围"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "系统统一入口，负责请求路由、身份认证、限流和协议转换",
      "responsibilities": [
        "统一接收所有客户端请求并路由到对应后端服务",
        "用户身份认证与 Token 校验",
        "请求频率限制和访问控制",
        "请求/响应格式统一转换",
        "跨域处理和日志记录"
      ]
    },
    {
      "name": "Student Service",
      "type": "service",
      "description": "学生信息管理核心服务，负责学生基础数据的增删改查",
      "responsibilities": [
        "学生基本信息的创建、修改、删除",
        "按条件查询学生信息（姓名、学号、班级等）",
        "学生信息的唯一性校验（学号不可重复）",
        "学生-班级关联关系的维护"
      ]
    },
    {
      "name": "Class Service",
      "type": "service",
      "description": "班级信息管理服务，负责班级的创建维护及学生分配管理",
      "responsibilities": [
        "班级的创建、编辑和删除",
        "班级列表和详情查询",
        "学生分配到班级的管理",
        "班级下学生名单的查询",
        "班级-年级关联关系的维护"
      ]
    },
    {
      "name": "Grade Service",
      "type": "service",
      "description": "年级信息管理服务，负责年级的划分及与班级的层级关联",
      "responsibilities": [
        "年级信息的创建、编辑和查询",
        "年级列表的查看",
        "班级与年级的层级关联管理",
        "年级下班级结构的查看"
      ]
    },
    {
      "name": "Statistics Service",
      "type": "service",
      "description": "学习统计服务，负责学习数据的记录、统计分析和报告生成",
      "responsibilities": [
        "学生学习数据的录入和存储",
        "按学生维度统计学习情况",
        "按班级/年级维度汇总统计",
        "统计报告和图表数据的生成",
        "异步处理大批量统计数据计算任务"
      ]
    },
    {
      "name": "Relational Database",
      "type": "db",
      "description": "关系型数据库，作为系统的主存储，持久化所有业务数据",
      "responsibilities": [
        "存储学生、班级、年级等基础数据",
        "存储学习记录和统计数据",
        "确保数据一致性和事务完整性",
        "支持复杂查询和聚合分析"
      ]
    },
    {
      "name": "Cache",
      "type": "cache",
      "description": "Redis 缓存层，提升热点数据的查询性能，减轻数据库压力",
      "responsibilities": [
        "缓存学生信息查询结果",
        "缓存班级/年级列表和结构数据",
        "缓存统计结果减少重复计算",
        "处理缓存失效和更新策略"
      ]
    },
    {
      "name": "Message Queue",
      "type": "mq",
      "description": "消息队列，用于异步任务处理，解耦核心业务与统计计算",
      "responsibilities": [
        "接收统计数据计算请求",
        "异步分发统计任务到 Statistics Service",
        "削峰填谷，避免统计任务阻塞核心业务流程",
        "保证消息可靠投递和消费"
      ]
    }
  ],
