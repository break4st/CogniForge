  "title": "一键自动化多环境部署及多项目管理系统架构文档",
  "source_prd": {
    "doc_id": "prd-current",
    "version": 1
  },
  "system_overview": {
    "description": "本系统是一个基于Web的中心化管理平台，旨在解决多项目、多环境下的应用手动部署痛点。它采用前后端分离的微服务架构，通过Web界面和RESTful API，为用户提供远程服务器管理、环境配置、一键自动化部署、部署历史追溯以及安全凭证管理等功能。",
    "roles": [
      {
        "name": "开发者",
        "permissions": [
          "管理本人负责项目的服务器和环境配置",
          "执行一键部署操作",
          "查看部署历史与日志"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、归档项目",
          "查看所有关联项目的部署进度和历史",
          "管理项目成员"
        ]
      },
      {
        "name": "运维人员",
        "permissions": [
          "管理所有服务器认证凭证（密钥/密码）",
          "定义和修改全局部署脚本模板",
          "配置系统级安全策略",
          "查看所有项目的部署状态"
        ]
      },
      {
        "name": "测试人员",
        "permissions": [
          "查看指定项目的部署历史",
          "下载部署日志文件",
          "执行一键回滚操作",
          "重试失败的部署任务"
        ]
      },
      {
        "name": "DevOps工程师",
        "permissions": [
          "生成和管理API Token",
          "通过API触发部署任务",
          "查询任务执行状态",
          "集成外部CI/CD流水线"
        ]
      }
    ]
  },
  "architecture": {
    "style": "微服务架构",
    "description": "系统采用前后端分离的分层微服务架构。前端为React SPA，通过API网关与后端服务通信。后端核心业务被拆分为用户服务、项目管理服务、服务器管理服务、部署引擎服务和日志历史服务。部署引擎采用异步任务队列处理长期运行的任务，并通过WebSocket推送实时日志。所有敏感数据均加密存储，项目间数据严格隔离。",
    "layers": [
      {
        "name": "前端层",
        "components": [
          "项目管理前端(Web应用)"
        ]
      },
      {
        "name": "网关层",
        "components": [
          "API网关"
        ]
      },
      {
        "name": "服务层",
        "components": [
          "用户服务",
          "项目管理服务",
          "服务器管理服务",
          "部署引擎服务",
          "日志与历史服务"
        ]
      },
      {
        "name": "数据与基础设施层",
        "components": [
          "关系型数据库(PostgreSQL)",
          "缓存数据库(Redis)",
          "加密凭证库"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS",
        "description": "前端与API网关之间使用HTTPS进行安全通信。"
      },
      {
        "protocol": "HTTP/REST",
        "description": "API网关将请求通过HTTP/REST路由至后端各微服务，实现内部服务间的同步调用。"
      },
      {
        "protocol": "WebSocket",
        "description": "前端通过WebSocket与部署引擎服务建立长连接，以实时接收部署日志流。"
      },
      {
        "protocol": "消息队列(Redis Streams/RabbitMQ)",
        "description": "服务间通过消息队列进行异步、事件驱动的通信，如部署完成事件通知。"
      },
      {
        "protocol": "SSH",
        "description": "部署引擎服务通过SSH协议直接连接远程目标服务器，执行文件传输和命令执行操作。"
      }
    ],
    "features": [
      "微服务解耦，独立部署与扩展",
      "BFF模式，通过API网关聚合前端数据",
      "异步任务处理，使用Celery和消息队列保证部署任务的可靠执行",
      "实时日志推送，基于WebSocket",
      "项目级数据隔离，所有查询强制带项目ID",
      "敏感信息加密存储，AES-256加密SSH凭证",
      "高可用，关键服务多实例部署，数据库主从备份",
      "可扩展，可水平扩展部署引擎工作节点以应对并发部署"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python",
      "framework": "FastAPI",
      "task_queue": "Celery with Redis/RabbitMQ",
      "ssh_library": "paramiko",
      "auth_library": "PyJWT",
      "encryption_library": "cryptography"
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design",
      "language": "TypeScript",
      "real_time_communication": "WebSocket Client"
    },
    "database": "PostgreSQL",
    "cache": "Redis",
    "message_queue": "Redis Streams / RabbitMQ",
    "deployment": "Docker, Kubernetes (可选)"
  },
