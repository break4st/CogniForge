        },
        {
          "status": 500,
          "code": "SSH_CONNECTION_ERROR",
          "message": "SSH连接失败，包含具体错误原因"
        }
      ],
      "description": "使用当前环境配置（含密钥）尝试建立SSH连接以验证连通性",
