    },
    {
      "name": "环境配置服务",
      "type": "service",
      "description": "管理部署环境的配置信息，包括服务器地址、端口、登录用户等",
      "responsibilities": [
        "部署环境CRUD操作",
        "环境连接测试",
        "环境状态管理",
        "环境与项目关联查询"
      ]
    },
    {
      "name": "部署引擎服务",
      "type": "service",
      "description": "核心部署编排服务，负责版本目录创建、脚本生成、远程执行和进度管理",
      "responsibilities": [
        "部署任务编排与调度",
        "自动生成版本号及部署目录",
        "生成部署执行脚本",
        "实时推送部署进度和日志",
        "部署结果通知"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "SSH密钥的安全存储和管理，提供加密解密和密钥验证能力",
      "responsibilities": [
        "SSH密钥加密存储",
        "密钥解密用于SSH连接",
        "密钥有效性验证",
        "密钥与环境的绑定管理"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录所有用户操作和系统事件的审计日志，支持查询和追踪",
      "responsibilities": [
        "操作日志记录",
        "部署历史归档",
        "日志查询与筛选"
      ]
    },
    {
      "name": "PostgreSQL主数据库",
      "type": "database",
      "description": "关系型数据库，持久化存储项目、环境、部署记录等结构化数据",
      "responsibilities": [
        "项目数据存储",
        "环境配置数据存储",
        "部署记录持久化",
        "用户操作审计日志存储"
      ]
    },
    {
      "name": "加密密钥存储",
      "type": "database",
      "description": "专门用于存储SSH密钥的安全存储模块，数据加密后落盘",
      "responsibilities": [
        "SSH私钥加密存储",
        "密钥密文读取",
        "访问权限控制"
      ]
    },
    {
      "name": "Redis缓存",
      "type": "database",
      "description": "缓存服务，用于SSH连接池状态管理、WebSocket会话管理和高频读取数据的缓存加速",
      "responsibilities": [
        "SSH连接池状态缓存",
        "WebSocket会话管理",
        "高频读取数据缓存",
        "部署进度临时存储"
      ]
    },
    {
      "name": "SSH连接池服务",
      "type": "service",
      "description": "管理与远程服务器的SSH连接池，提供高效、可复用的远程连接能力",
      "responsibilities": [
        "SSH连接建立与复用",
        "连接健康检查与自动重连",
        "远程命令执行",
        "文件传输通道提供"
      ]
    },
    {
      "name": "文件传输服务",
      "type": "service",
      "description": "负责将可执行文件传输到远程服务器的指定目录",
      "responsibilities": [
        "待部署文件上传接收",
        "文件完整性校验",
        "文件远程传输（SCP/RSYNC）"
      ]
    }
  ],
