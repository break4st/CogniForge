            "type": "string",
            "description": "环境ID"
          },
          "version": {
            "type": "string",
            "description": "版本号"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "success",
              "failed"
            ],
            "description": "部署状态"
          },
          "steps": {
            "type": "array",
            "items": "object",
            "description": "部署步骤详情"
          },
          "created_at": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "required": false
          }
        }
      },
      "description": "查询部署任务的当前状态和进度详情"
    },
    {
      "interface": "部署日志WebSocket",
      "provider": "部署编排服务",
      "consumers": [
        "Web控制台"
      ],
      "type": "REST",
      "endpoint": "WS /api/v1/ws/deployments/{id}/logs",
      "request": {
        "path_params": [
          {
            "name": "id",
            "type": "string",
            "description": "部署任务ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "type": {
            "type": "string",
            "enum": [
              "log",
              "status",
              "error"
            ],
            "description": "消息类型"
          },
          "timestamp": {
            "type": "string",
            "description": "时间戳"
          },
          "message": {
            "type": "string",
            "description": "日志内容"
          },
          "step": {
            "type": "string",
            "description": "当前步骤"
          }
        }
      },
      "description": "通过WebSocket实时推送部署过程的日志输出和状态变更"
    },
    {
      "interface": "密钥存储API",
      "provider": "密钥存储服务",
