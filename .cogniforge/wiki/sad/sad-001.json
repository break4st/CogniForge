  "architecture_decisions": [
    {
      "decision": "选择Electron而非原生GUI框架",
      "reason": "团队熟悉Web技术栈，开发效率高，跨平台支持好。"
    },
    {
      "decision": "使用SQLite数据库",
      "reason": "零配置，适合本地桌面应用，满足小型数据的CRUD需求。"
    },
    {
      "decision": "主密码派生加密密钥方案",
      "reason": "用户设置一个主密码，加密密钥由PBKDF2派生，不存储密钥本身，提高安全性。"
    },
    {
      "decision": "IPC通信而非HTTP",
      "reason": "Electron推荐的主进程与渲染进程通信方式，安全且高效。"
    }
  ],
  "risks": [
    {
      "risk": "私钥加密密钥派生依赖主密码，若用户遗忘主密码将无法解密私钥，导致无法部署。",
      "mitigation": "提示用户妥善保管主密码，不提供找回功能，如需重置需重新导入私钥。"
    },
    {
      "risk": "部署过程中网络中断可能导致远程遗留不完整版本目录，虽然系统会尽力清理，但极端情况（如进程强制结束）可能失败。",
      "mitigation": "记录并提示用户手动清理，或在下次连接时提供清理选项。"
    },
    {
      "risk": "SQLite不支持复杂的并发控制，但在单用户桌面场景下足够；若后续需要多人共享可迁移。",
      "mitigation": "保持单实例访问，未来可考虑迁移到更好的存储方案。"
    }
  ],
