        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string",
          "status": "string",
          "progress": "integer",
          "started_at": "datetime",
          "completed_at": "datetime",
          "log_summary": "string"
        }
      },
      "description": "查询部署任务执行状态和进度"
    },
