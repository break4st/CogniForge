  "contracts": [
    {
      "id": "CTR-001",
      "interface": "获取全局项目列表及状态",
      "provider_component_id": "CMP-011",
      "provider": "ProjectService",
      "consumers": [
        "Dashboard",
        "Navigation"
      ],
      "type": "REST",
      "status": "active",
      "version": 1,
      "endpoint": "GET /api/projects",
      "request": {
        "path_params": [],
        "query_params": [
          {
            "name": "search",
            "type": "string",
            "required": false
          },
          {
            "name": "sort",
            "type": "string",
            "required": false
          }
        ],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "projects": [
            {
