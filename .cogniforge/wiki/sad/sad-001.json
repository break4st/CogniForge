  "title": "SmartDeploy 系统架构文档",
  "source_prd": {
    "doc_id": "prc-current",
    "version": 1
  },
  "system_overview": {
    "description": "SmartDeploy 是一款基于 Electron 的桌面应用，通过分层架构实现安全、高效的一键远程部署。系统由 React 前端、Node.js 主进程和 SQLite 数据库构成，所有业务逻辑与敏感数据均在本地处理并加密存储。",
    "roles": [
      {
        "name": "运维工程师",
        "permissions": [
          "创建与管理环境配置",
          "测试环境连通性"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "选择项目与环境进行一键部署",
          "查看部署日志"
        ]
      },
      {
        "name": "技术负责人",
        "permissions": [
          "管理所有项目",
          "导入/导出项目配置",
          "切换项目上下文"
        ]
      },
      {
        "name": "产品经理",
        "permissions": [
          "查看部署历史记录",
          "追踪版本部署情况"
        ]
      },
      {
        "name": "信息安全管理员",
        "permissions": [
          "审核加密存储机制",
          "确认密钥文件安全保存"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构（桌面应用）",
    "description": "系统划分为表示层（React UI）、业务逻辑层（Electron 主进程中的各类服务）、数据层（SQLite + 文件系统）。层间通过 Electron IPC 和直接函数调用通信，基础设施层提供 SSH 连接与加解密能力。",
    "layers": [
      {
        "name": "表示层",
        "components": [
          "CMP-001 React UI"
        ]
      },
      {
        "name": "业务逻辑层",
        "components": [
          "CMP-002 Main Router",
          "CMP-003 Environment Manager",
          "CMP-004 SSH Client",
          "CMP-005 Deployment Engine",
          "CMP-006 Project Manager",
          "CMP-007 History Service",
          "CMP-008 Crypto Service",
          "CMP-010 File Manager"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "CMP-009 SQLite Database"
        ]
      },
      {
        "name": "基础设施层",
        "components": [
          "CMP-004 SSH Client",
          "CMP-008 Crypto Service",
          "CMP-010 File Manager"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "Electron IPC",
        "description": "表示层与业务逻辑层之间的异步请求-响应及事件推送"
      },
      {
        "protocol": "SQL",
        "description": "业务层服务通过 better-sqlite3 同步 API 访问本地 SQLite 数据库"
      },
      {
        "protocol": "FS API",
        "description": "文件管理服务直接调用 Node.js fs 模块操作文件系统"
      },
      {
        "protocol": "SSH/SFTP",
        "description": "SSH Client 通过 SSH 协议连接远程服务器，利用 SFTP 传输文件"
      }
    ],
    "features": [
      "本地桌面应用，无需后端服务",
      "多项目管理与上下文隔离",
      "AES-256-GCM 加密存储敏感凭据",
      "版本化部署，自动生成启动脚本",
      "实时部署进度推送",
      "部署故障自动回滚",
      "部署历史审计与重新部署"
    ]
  },
  "tech_stack": {
    "desktop_framework": "Electron",
    "frontend": {
      "framework": "React 18",
      "language": "TypeScript",
      "ui_library": "Ant Design",
      "state_management": "Zustand"
    },
    "backend": {
      "language": "JavaScript/TypeScript",
      "runtime": "Node.js",
      "main_process_dependencies": [
        "better-sqlite3",
        "node-ssh",
        "keytar"
      ]
    },
    "database": "SQLite",
    "encryption": "AES-256-GCM (Node.js crypto)",
    "build_tool": "Electron Builder + Vite"
  },
