{
  "meta": {
    "doc_id": "sad-001",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-22 13:47"
  },
  "system_overview": {
    "description": "自动化部署系统实现将打包好的可执行文件一键部署到指定远程服务器的功能。支持用户自定义多套部署环境（测试线、灰度线、正式线），每套环境通过SSH密钥安全连接。部署时自动在远程服务器上创建版本文件夹并生成启动脚本。用户可创建和管理多个项目，每个项目拥有独立的部署环境配置，支持项目间灵活切换，满足多项目并行管理需求。",
    "roles": [
      {
        "name": "运维管理员",
        "permissions": [
          "配置和管理SSH密钥",
          "管理服务器连接信息",
          "审计所有部署操作",
          "管理系统安全设置"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建/编辑/删除项目",
          "为项目配置多套部署环境",
          "查看所有项目部署状态",
          "管理团队成员权限"
        ]
      },
      {
        "name": "运维工程师",
        "permissions": [
          "选择目标环境和项目执行一键部署",
          "查看部署历史记录",
          "执行版本回滚",
          "监控部署进度"
        ]
      },
      {
        "name": "开发工程师",
        "permissions": [
          "上传可执行文件并部署到测试环境",
          "查看个人项目的部署状态",
          "触发测试环境部署"
        ]
      },
      {
        "name": "测试工程师",
        "permissions": [
          "将指定版本部署到灰度线进行测试",
          "查看测试环境部署记录",
          "回滚测试环境版本"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 前后端分离",
    "description": "采用前后端分离的分层架构，前端通过API网关与后端服务通信。后端采用微服务风格划分为多个领域服务，各服务通过RESTful API交互。SSH执行层作为独立模块负责与远程服务器通信。数据层使用PostgreSQL持久化业务数据，Redis提供缓存和异步任务队列。前端UI层划分为独立视图模块（看板、项目管理、环境配置），接入层统一处理认证与审计，业务层按领域拆分保障单一职责。",
    "layers": [
      {
        "name": "展示层",
        "components": [
          "Web管理控制台",
          "部署进度看板",
          "项目管理界面",
          "环境配置界面"
        ]
      },
      {
        "name": "接入层",
        "components": [
          "API网关",
          "认证中间件",
          "审计日志过滤器"
        ]
      },
      {
        "name": "业务服务层",
        "components": [
          "项目管理服务",
          "环境管理服务",
          "部署编排服务",
          "密钥管理服务",
          "版本管理服务",
          "审计日志服务"
        ]
      },
      {
        "name": "执行层",
        "components": [
          "SSH连接池",
          "文件传输引擎",
          "脚本生成引擎",
          "远程命令执行器"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL主数据库",
          "Redis缓存",
          "文件存储"
        ]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST (展示层 → 接入层)"
      },
      {
        "protocol": "REST/gRPC (接入层 → 业务服务层)"
      },
      {
        "protocol": "内部API调用 (业务服务层 → 执行层)"
      },
      {
        "protocol": "TCP/SSL + Redis协议 (业务服务层 → 数据层)"
      }
    ],
    "features": [
      "前后端分离，独立部署和扩展",
      "服务无状态设计，支持水平扩展",
      "SSH连接池复用，减少连接开销",
      "异步任务队列处理部署任务",
      "加密存储敏感信息（密钥和凭证）",
      "完整的审计日志链路，满足可审核性要求",
      "版本化部署目录隔离，支持快速回滚",
      "WebSocket实时推送部署进度"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Go",
      "framework": "Gin"
    },
    "frontend": {
      "framework": "React",
      "ui_library": "Ant Design"
    },
    "database": "PostgreSQL 15+",
    "cache": "Redis 7+",
    "mq": "Redis Stream",
    "ssh_lib": "golang.org/x/crypto/ssh",
    "file_transfer": "SCP/SFTP (通过 golang.org/x/crypto/ssh)",
    "auth": "JWT (JSON Web Token)",
    "real_time": "WebSocket (gorilla/websocket)"
  },
  "components": [
    {
      "name": "Web管理控制台",
      "type": "frontend",
      "description": "基于React的单页应用，提供部署系统的完整操作界面，整合所有视图模块",
      "responsibilities": [
        "提供项目管理和切换界面",
        "提供部署环境配置界面",
        "提供一键部署触发界面",
        "展示部署进度和实时日志",
        "提供部署历史查询和回滚操作"
      ]
    },
    {
      "name": "部署进度看板",
      "type": "frontend",
      "description": "Web管理控制台内的嵌入式视图，实时展示部署任务状态和进度",
      "responsibilities": [
        "实时展示部署任务执行进度",
        "通过WebSocket接收并展示部署日志",
        "部署失败时展示错误详情和排查建议",
        "支持取消正在执行的部署任务"
      ]
    },
    {
      "name": "项目管理界面",
      "type": "frontend",
      "description": "Web管理控制台内的嵌入式视图，管理项目和项目切换",
      "responsibilities": [
        "展示项目列表和基本信息",
        "提供项目创建、编辑、删除操作界面",
        "支持项目切换的交互操作",
        "展示每个项目的环境配置概览"
      ]
    },
    {
      "name": "环境配置界面",
      "type": "frontend",
      "description": "Web管理控制台内的嵌入式视图，配置部署环境和SSH密钥",
      "responsibilities": [
        "提供部署环境配置表单",
        "提供SSH密钥上传和配置界面",
        "展示环境连接状态和健康检查结果",
        "支持密钥有效性验证操作"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "统一API入口，负责请求路由、认证鉴权和限流",
      "responsibilities": [
        "统一路由转发到后端服务",
        "用户身份认证和Token校验",
        "请求速率限制和防护",
        "跨域和请求头处理",
        "API文档聚合"
      ]
    },
    {
      "name": "认证中间件",
      "type": "gateway",
      "description": "JWT认证过滤器，嵌入API网关的请求处理链中",
      "responsibilities": [
        "JWT Token签发和验证",
        "用户会话管理",
        "权限角色校验",
        "Token刷新机制"
      ]
    },
    {
      "name": "审计日志过滤器",
      "type": "gateway",
      "description": "请求级审计过滤器，自动捕获所有经过网关的API请求信息",
      "responsibilities": [
        "自动记录所有API请求的元数据",
        "提取请求方身份和时间戳",
        "将原始审计事件投递到审计日志服务",
        "不阻塞正常请求流程"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "负责项目的CRUD操作和项目间切换",
      "responsibilities": [
        "创建、编辑、删除项目",
        "项目列表查询和详情获取",
        "项目切换与会话管理",
        "项目成员权限管理"
      ]
    },
    {
      "name": "环境管理服务",
      "type": "service",
      "description": "管理每套部署环境（测试/灰度/正式）的配置信息",
      "responsibilities": [
        "环境的创建、编辑、删除",
        "环境与项目的关联管理",
        "环境连接信息（地址、端口）配置",
        "环境状态健康检查"
      ]
    },
    {
      "name": "部署编排服务",
      "type": "service",
      "description": "核心服务，编排一键部署的完整流程，调度执行层各模块协作",
      "responsibilities": [
        "接收部署请求并编排部署流程",
        "协调密钥获取、环境连接、文件传输、脚本生成等子任务",
        "部署进度跟踪和状态推送",
        "异常处理和回滚触发",
        "异步任务队列管理"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "管理SSH密钥的全生命周期，保障密钥安全存储和使用",
      "responsibilities": [
        "SSH密钥的添加、更新、删除",
        "密钥的加密存储（AES-256）",
        "密钥有效性验证",
        "密钥与环境的绑定管理"
      ]
    },
    {
      "name": "版本管理服务",
      "type": "service",
      "description": "管理部署版本记录，支持版本回滚",
      "responsibilities": [
        "部署版本号自动生成",
        "部署版本历史记录查询",
        "版本回滚操作支持",
        "版本间差异对比"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "记录所有操作行为，满足可审核性要求",
      "responsibilities": [
        "记录用户操作日志",
        "记录部署事件日志",
        "审计日志查询和导出",
        "异常操作告警"
      ]
    },
    {
      "name": "SSH连接池",
      "type": "service",
      "description": "管理和复用SSH连接，提高远程执行效率",
      "responsibilities": [
        "SSH连接的建立和维护",
        "连接池复用和超时管理",
        "断线自动重连",
        "连接健康检测"
      ]
    },
    {
      "name": "文件传输引擎",
      "type": "service",
      "description": "负责将打包文件通过SCP/SFTP传输到远程服务器",
      "responsibilities": [
        "文件分片传输和校验",
        "断点续传支持",
        "传输进度上报",
        "传输完整性校验（MD5/SHA256）"
      ]
    },
    {
      "name": "脚本生成引擎",
      "type": "service",
      "description": "根据部署配置自动生成远程服务器的启动脚本",
      "responsibilities": [
        "根据项目类型生成标准启动脚本模板",
        "注入环境变量和启动参数",
        "生成服务注册和健康检查脚本",
        "支持自定义脚本扩展"
      ]
    },
    {
      "name": "远程命令执行器",
      "type": "service",
      "description": "通过SSH在远程服务器上执行命令，完成目录操作和脚本执行",
      "responsibilities": [
        "在远程服务器上创建版本部署目录",
        "执行文件解压和权限设置",
        "执行启动脚本并监控进程状态",
        "收集命令执行结果和错误输出"
      ]
    },
    {
      "name": "PostgreSQL主数据库",
      "type": "database",
      "description": "持久化存储所有业务数据",
      "responsibilities": [
        "存储项目和部署环境配置",
        "存储加密后的密钥信息",
        "存储部署版本历史记录",
        "存储审计日志数据",
        "存储用户权限信息"
      ]
    },
    {
      "name": "Redis缓存",
      "type": "infrastructure",
      "description": "缓存热数据和部署任务状态，同时作为异步消息队列",
      "responsibilities": [
        "缓存项目列表和环境配置",
        "存储部署任务实时状态",
        "会话和Token缓存",
        "异步任务队列（部署任务）"
      ]
    },
    {
      "name": "文件存储",
      "type": "infrastructure",
      "description": "存储上传的可执行文件包和历史构建产物",
      "responsibilities": [
        "存储用户上传的部署包",
        "按项目和版本组织文件目录",
        "提供文件下载接口（用于回滚）",
        "文件生命周期管理和自动清理"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "DeployAPI",
      "provider": "API网关",
      "consumers": [
        "Web管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/deploy",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "project_id": "string (UUID, 项目标识)",
          "environment_id": "string (UUID, 目标环境标识)",
          "file_path": "string (上传文件路径或已上传的文件标识)",
          "version": "string (可选，指定版本号，为空则自动生成)",
          "description": "string (可选，本次部署说明)"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "task_id": "string (UUID, 部署任务ID)",
          "status": "string (部署状态: pending/ running/ success/ failed)",
          "created_at": "string (ISO8601 时间戳)"
        }
      },
      "description": "触发一键部署任务，返回任务ID供后续轮询进度"
    },
    {
      "interface": "DeployStatusAPI",
      "provider": "API网关",
      "consumers": [
        "Web管理控制台",
        "部署进度看板"
      ],
      "type": "REST",
      "endpoint": "GET /api/v1/deploy/:taskId",
      "request": {
        "path_params": [
          {
            "name": "taskId",
            "type": "string (UUID)",
            "description": "部署任务ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "task_id": "string (UUID)",
          "status": "string (任务状态)",
          "progress": "integer (0-100 进度百分比)",
          "current_step": "string (当前执行步骤描述)",
          "logs": [
            "string (日志行)"
          ],
          "error": "string (可选，错误信息)",
          "version": "string (部署版本号)",
          "started_at": "string (ISO8601)",
          "completed_at": "string (可选，ISO8601)"
        }
      },
      "description": "查询部署任务的当前状态和进度详情"
    },
    {
      "interface": "DeployProgressWS",
      "provider": "API网关",
      "consumers": [
        "部署进度看板"
      ],
      "type": "MQ",
      "endpoint": "WS /api/v1/ws/deploy/:taskId",
      "request": {
        "path_params": [
          {
            "name": "taskId",
            "type": "string (UUID)",
            "description": "部署任务ID"
          }
        ],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "type": "string (事件类型: progress/ log/ error/ complete)",
          "data": "object (事件负载，按type不同结构不同)"
        }
      },
      "description": "通过WebSocket实时推送部署进度、日志和状态变更事件"
    },
    {
      "interface": "RollbackAPI",
      "provider": "API网关",
      "consumers": [
        "Web管理控制台"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/deploy/:taskId/rollback",
      "request": {
        "path_params": [
          {
            "name": "taskId",
            "type": "string (UUID)",
            "description": "原部署任务ID"
          }
        ],
        "query_params": [],
        "body": {
          "target_version": "string (可选，目标回滚版本号)"
        }
      },
      "response": {
        "status": 202,
        "body": {
          "rollback_task_id": "string (UUID, 回滚任务ID)",
          "status": "string (回滚状态)",
          "created_at": "string (ISO8601)"
        }
      },
      "description": "发起版本回滚操作，恢复到指定历史版本"
    },
    {
      "interface": "ProjectAPI",
      "provider": "API网关",
      "consumers": [
        "项目管理界面"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/projects[/:projectId]",
      "request": {
        "path_params": [
          {
            "name": "projectId",
            "type": "string (UUID)",
            "description": "项目ID（GET/PUT/DELETE时使用）"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string (项目名称)",
          "description": "string (可选，项目描述)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "description": "string",
          "environments": [
            "object (环境列表，嵌套)"
          ],
          "created_at": "string (ISO8601)",
          "updated_at": "string (ISO8601)"
        }
      },
      "description": "项目的增删改查操作"
    },
    {
      "interface": "EnvironmentAPI",
      "provider": "API网关",
      "consumers": [
        "环境配置界面"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/environments[/:envId]",
      "request": {
        "path_params": [
          {
            "name": "envId",
            "type": "string (UUID)",
            "description": "环境ID"
          }
        ],
        "query_params": [],
        "body": {
          "project_id": "string (UUID, 所属项目)",
          "name": "string (环境名称，如 测试线/灰度线/正式线)",
          "host": "string (服务器地址)",
          "port": "integer (SSH端口，默认22)",
          "key_id": "string (UUID, 绑定的密钥ID)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "project_id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "key_id": "string (UUID)",
          "status": "string (健康状态: online/ offline/ unknown)",
          "created_at": "string (ISO8601)"
        }
      },
      "description": "部署环境的增删改查和状态检查"
    },
    {
      "interface": "KeyAPI",
      "provider": "API网关",
      "consumers": [
        "环境配置界面"
      ],
      "type": "REST",
      "endpoint": "GET/POST/PUT/DELETE /api/v1/keys[/:keyId]",
      "request": {
        "path_params": [
          {
            "name": "keyId",
            "type": "string (UUID)",
            "description": "密钥ID"
          }
        ],
        "query_params": [],
        "body": {
          "name": "string (密钥名称)",
          "content": "string (密钥内容或Base64编码)",
          "type": "string (密钥类型: rsa/ ecdsa/ ed25519)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "fingerprint": "string (密钥指纹)",
          "type": "string",
          "created_at": "string (ISO8601)",
          "content": "string (响应中不返回实际内容，仅返回指纹)"
        }
      },
      "description": "SSH密钥的增删改查，内容始终加密存储，响应中不泄露明文"
    },
    {
      "interface": "KeyVerifyAPI",
      "provider": "API网关",
      "consumers": [
        "环境配置界面"
      ],
      "type": "REST",
      "endpoint": "POST /api/v1/keys/:keyId/verify",
      "request": {
        "path_params": [
          {
            "name": "keyId",
            "type": "string (UUID)",
