        }
      },
      "description": "上传SSH密钥对，私钥经AES-256加密后存储，返回密钥指纹"
    },
    {
      "interface": "删除SSH密钥",
      "provider": "密钥管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "DELETE /api/keys/{id}",
