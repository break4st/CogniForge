{
  "meta": {
    "doc_id": "sad-002",
    "type": "sad",
    "title": "一键自动化部署系统 — 系统架构设计",
    "author": "architect_agent",
    "created": "2026-05-21 16:39"
  },
  "system_overview": {
    "description": "一键自动化部署系统是一个基于 Web 的部署管理平台，采用前后端分离的分层微服务架构。核心能力包括：多项目独立管理与灵活切换、多套部署环境（测试/灰度/正式）自定义配置、SSH 密钥安全连接、一键式自动化部署编排、部署过程实时可视化与日志推送、部署历史追溯与版本回滚。系统通过 API 网关统一接入和认证，长时部署任务通过消息队列异步解耦，SSH 执行引擎负责远程服务器操作，全操作审计日志确保可追溯性。架构遵循最小权限原则，各服务无状态设计支持独立水平扩展。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "创建、编辑、删除部署环境",
          "配置环境 SSH 连接参数（主机、端口、用户名）",
          "导入和管理 SSH 密钥",
          "执行环境连接测试验证配置有效性",
          "查看部署历史和日志",
          "执行版本回滚操作"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "查看项目列表和环境列表",
          "选择项目和目标环境执行一键部署",
          "查看部署进度和实时日志",
          "查看部署结果通知"
        ]
      },
      {
        "name": "项目管理者",
        "permissions": [
          "创建、编辑、删除项目",
          "在多个项目间切换管理",
          "查看全局部署状态和统计",
          "查看审计日志"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层微服务架构",
    "description": "系统采用严格的分层微服务架构，从上到下分为五层：展示层（Web 控制台 SPA）→ 网关层（API 网关统一路由、认证、限流、跨域）→ 服务层（六个领域服务 + 一个回滚管理服务，各自承担单一职责）→ 数据层（PostgreSQL 持久化、Redis 缓存与实时状态、RabbitMQ 异步消息）→ 外部集成层（SSH 协议连接远程服务器）。服务间同步通信采用 RESTful API，长时部署任务通过消息队列异步编排实现削峰填谷和任务解耦。部署进度通过 SSE（Server-Sent Events）实现前端实时推送，避免轮询开销。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web Console"]
      },
      {
        "name": "网关层",
        "components": ["API Gateway"]
      },
      {
        "name": "服务层",
        "components": [
          "Project Management Service",
          "Environment Management Service",
          "Key Management Service",
          "SSH Execution Service",
          "Deployment Orchestrator",
          "Rollback Manager",
          "Audit Service"
        ]
      },
      {
        "name": "数据层",
        "components": ["Primary Database", "Redis", "RabbitMQ"]
      },
      {
        "name": "外部集成层",
        "components": ["Remote Servers"]
      }
    ],
    "connections": [
      {
        "protocol": "HTTPS/REST（Web Console ↔ API Gateway）、SSE（API Gateway → Web Console 实时推送）"
      },
      {
        "protocol": "HTTPS/REST（API Gateway ↔ 各微服务）"
      },
      {
        "protocol": "SQL（PostgreSQL）/ Redis Protocol / AMQP（RabbitMQ）"
      },
      {
        "protocol": "SSH-2（SSH Execution Service ↔ Remote Servers）"
      }
    ],
    "features": [
      "前后端分离，React SPA + FastAPI 微服务",
      "API 网关统一入口，集中鉴权与限流",
      "服务无状态设计，支持独立水平扩展",
      "异步消息驱动部署流程，削峰填谷",
      "SSH 密钥 AES-256 加密存储",
      "部署进度 SSE 实时推送，可视化展示",
      "全操作审计日志，所有变更可追溯",
      "版本回滚支持，一键恢复历史部署"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11+",
      "framework": "FastAPI",
      "async_support": "asyncio + uvicorn"
    },
    "frontend": {
      "framework": "React 18",
      "ui_library": "Ant Design 5.x",
      "state_management": "React Query + Context API",
      "real_time": "Server-Sent Events (SSE)"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "mq": "RabbitMQ 3.12",
    "deployment_protocol": "SSH-2",
    "containerization": "Docker + Docker Compose",
    "api_gateway": "Nginx + OpenResty"
  },
  "components": [
    {
      "name": "Web Console",
      "type": "frontend",
      "description": "基于 React 18 + Ant Design 5.x 的单页应用，提供完整的用户操作界面和部署可视化体验",
      "responsibilities": [
        "项目列表展示与 CRUD 操作界面",
        "部署环境配置表单与 SSH 密钥管理界面",
        "一键部署触发按钮与进度可视化（进度条 + 实时日志流）",
        "部署历史记录查看与版本回滚操作",
        "审计日志查询与导出",
        "多项目间快速切换导航"
      ]
    },
    {
      "name": "API Gateway",
      "type": "gateway",
      "description": "基于 Nginx + OpenResty 的统一入口网关，负责请求路由转发、身份认证、限流和 SSE 连接管理",
      "responsibilities": [
        "统一路由转发至各微服务",
        "JWT 请求身份认证与会话校验",
        "API 限流与防滥用",
        "SSE 连接代理与长连接管理",
        "跨域策略（CORS）管理",
        "请求响应日志记录"
      ]
    },
    {
      "name": "Project Management Service",
      "type": "service",
      "description": "管理项目生命周期的领域服务，每个项目拥有独立的环境配置和部署历史",
      "responsibilities": [
        "项目的创建、编辑、删除、查询",
        "项目与环境的关系绑定与管理",
        "项目级别的配置参数管理",
        "项目列表分页和搜索"
      ]
    },
    {
      "name": "Environment Management Service",
      "type": "service",
      "description": "管理部署环境配置的领域服务，负责环境参数管理与连接测试",
      "responsibilities": [
        "环境的创建、编辑、删除、查询",
        "环境连接参数（主机、端口、用户名、标签）管理",
        "SSH 密钥与环境的绑定关系管理",
        "触发环境连接测试并返回结果"
      ]
    },
    {
      "name": "Key Management Service",
      "type": "service",
      "description": "SSH 密钥安全管理的专用服务，负责密钥的加密存储、解密使用和访问控制",
      "responsibilities": [
        "SSH 私钥的导入、验证和 AES-256 加密存储",
        "按需解密并提供 SSH 连接使用的密钥",
        "密钥访问权限控制（按项目隔离）",
        "密钥指纹计算与展示",
        "支持密钥轮换"
      ]
    },
    {
      "name": "SSH Execution Service",
      "type": "service",
      "description": "核心执行引擎，通过 SSH-2 协议在远程服务器上执行命令、传输文件、生成管理脚本",
      "responsibilities": [
        "SSH 会话建立与密钥认证",
        "远程目录创建（带版本标识的部署目录）",
        "可执行文件上传传输",
        "远程管理脚本生成（启动/停止/重启/状态检查）与执行",
        "命令执行结果收集、解析与返回",
        "执行进度实时发布到消息队列"
      ]
    },
    {
      "name": "Deployment Orchestrator",
      "type": "service",
      "description": "部署流程的编排引擎，负责任务接收、状态管理、步骤编排和进度分发",
      "responsibilities": [
        "部署任务接收、校验与状态管理",
        "部署步骤编排与执行调度",
        "通过 RabbitMQ 异步下发执行任务",
        "消费进度消息并更新实时状态（Redis + DB）",
        "部署结果汇总与通知",
        "部署历史记录持久化维护"
      ]
    },
    {
      "name": "Rollback Manager",
      "type": "service",
      "description": "版本回滚管理服务，负责回滚操作编排和历史版本管理",
      "responsibilities": [
        "查询指定部署的历史版本列表",
        "回滚操作请求接收与校验",
        "回滚步骤编排（备份当前版本 → 恢复目标版本 → 验证）",
        "回滚过程中的进度跟踪与推送",
        "回滚操作记录审计"
      ]
    },
    {
      "name": "Audit Service",
      "type": "service",
      "description": "全操作审计日志服务，记录所有关键操作事件，支持查询和导出",
      "responsibilities": [
        "记录项目创建、修改、删除操作",
        "记录环境配置变更",
        "记录 SSH 密钥导入和使用",
        "记录每次部署请求与结果",
        "记录回滚操作",
        "审计日志持久化存储、查询与导出"
      ]
    },
    {
      "name": "Primary Database",
      "type": "database",
      "description": "PostgreSQL 15 关系型数据库，存储系统全部持久化数据",
      "responsibilities": [
        "项目数据的持久化存储（projects 表）",
        "环境配置数据的持久化（environments 表）",
        "SSH 密钥密文存储（keys 表）",
        "部署历史记录存储（deployments 表）",
        "版本快照记录存储（deployment_snapshots 表）",
        "审计日志存储（audit_logs 表）",
        "数据完整性与一致性保障"
      ]
    },
    {
      "name": "Redis",
      "type": "cache",
      "description": "Redis 7 内存缓存，加速数据访问和实时状态追踪",
      "responsibilities": [
        "用户会话缓存与分布式 session",
        "部署任务实时状态缓存（status + progress + logs）",
        "环境连接测试结果缓存",
        "配置缓存降低数据库查询压力"
      ]
    },
    {
      "name": "RabbitMQ",
      "type": "mq",
      "description": "RabbitMQ 3.12 消息队列，用于解耦部署请求与执行，支持异步事件驱动",
      "responsibilities": [
        "部署任务消息异步投递（deploy.tasks 交换机）",
        "部署进度状态变更通知分发（deploy.progress 交换机）",
        "回滚任务异步投递（rollback.tasks 交换机）",
        "服务间事件驱动通信",
        "削峰填谷，平滑处理并发部署高峰"
      ]
    },
    {
      "name": "Remote Servers",
      "type": "service",
      "description": "外部远程 Linux 服务器，承载部署目标环境，通过 SSH-2 协议接入",
      "responsibilities": [
        "提供 SSH 可访问的远程执行环境",
        "接收部署文件并存储到版本目录",
        "执行部署管理脚本（启动/停止/重启）",
        "返回命令执行结果与退出码"
      ]
    }
  ],
  "contracts": [
