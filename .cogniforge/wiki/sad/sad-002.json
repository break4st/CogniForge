          "duration_ms": "int"
        }
      },
      "description": "内部接口，在远程服务器上执行指定 shell 命令并返回完整结果"
    },
    {
      "interface": "SSHFileTransfer",
      "provider": "SSH Execution Service",
      "consumers": ["Deployment Orchestrator"],
      "type": "REST",
      "endpoint": "POST /internal/ssh/upload",
      "request": {
        "path_params": {},
        "query_params": {},
        "body": {
          "host": "string",
          "port": "int",
          "username": "string",
          "key_id": "string (uuid)",
          "remote_path": "string",
          "file_content_base64": "string",
          "file_mode": "string (default '0755')"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "file_size": "int",
          "checksum": "string (sha256)"
        }
      },
      "description": "内部接口，将可执行文件以 base64 形式传输到远程服务器的指定路径"
    },
    {
      "interface": "AuditLog",
      "provider": "Audit Service",
      "consumers": [
        "Project Management Service",
        "Environment Management Service",
        "Key Management Service",
        "SSH Execution Service",
        "Deployment Orchestrator",
        "Rollback Manager"
      ],
      "type": "REST",
      "endpoint": "POST /internal/audit/log",
      "request": {
        "path_params": {},
        "query_params": {},
        "body": {
          "action": "string",
          "actor": "string (user_id)",
          "resource_type": "string",
          "resource_id": "string (uuid)",
          "detail": "object",
          "result": "string (enum: success/failure)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "audit_id": "string (uuid)",
          "logged_at": "string (datetime)"
        }
      },
      "description": "内部接口，各微服务在执行关键操作后调用以记录审计日志"
    },
    {
      "interface": "AuditLogQuery",
      "provider": "Audit Service",
      "consumers": ["API Gateway", "Web Console"],
      "type": "REST",
      "endpoint": "GET /api/v1/audit/logs",
      "request": {
        "path_params": {},
        "query_params": {
          "page": "int (default 1)",
          "page_size": "int (default 20)",
          "action": "string (optional)",
          "actor": "string (optional)",
          "resource_type": "string (optional)",
          "start_date": "string (datetime, optional)",
          "end_date": "string (datetime, optional)"
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "items": "AuditLogEntry[]",
          "total": "int",
          "page": "int",
          "page_size": "int"
        }
      },
      "description": "分页查询审计日志，支持按操作类型、操作者、资源类型和时间范围筛选"
    },
    {
      "interface": "DeployTaskQueue",
      "provider": "RabbitMQ",
      "consumers": ["Deployment Orchestrator", "SSH Execution Service"],
      "type": "MQ",
      "endpoint": "exchange: deploy.tasks / routing_key: deploy.execute",
      "request": {
        "path_params": {},
        "query_params": {},
        "body": {
          "deployment_id": "string (uuid)",
          "project_id": "string (uuid)",
          "environment_id": "string (uuid)",
          "version": "string",
          "file_content_base64": "string",
          "ssh_config": {
            "host": "string",
            "port": "int",
            "username": "string",
            "key_id": "string (uuid)"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string (uuid)",
          "status": "string",
          "message": "string"
        }
      },
      "description": "Deployment Orchestrator 发布部署任务消息，SSH Execution Service 消费并执行远程部署"
    },
    {
      "interface": "DeployProgressQueue",
      "provider": "RabbitMQ",
      "consumers": ["SSH Execution Service", "Deployment Orchestrator"],
      "type": "MQ",
      "endpoint": "exchange: deploy.progress / routing_key: deploy.progress.update",
      "request": {
        "path_params": {},
        "query_params": {},
        "body": {
          "deployment_id": "string (uuid)",
          "status": "string (enum: running/success/failed)",
          "current_step": "string",
          "progress_pct": "int (0-100)",
          "logs": "string[]",
          "timestamp": "string (datetime)"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "received": "boolean"
        }
      },
      "description": "SSH Execution Service 在执行过程中发布进度消息，Deployment Orchestrator 消费并更新状态缓存"
    },
    {
      "interface": "RollbackTaskQueue",
      "provider": "RabbitMQ",
      "consumers": ["Rollback Manager", "SSH Execution Service"],
      "type": "MQ",
      "endpoint": "exchange: rollback.tasks / routing_key: rollback.execute",
      "request": {
        "path_params": {},
        "query_params": {},
        "body": {
          "rollback_id": "string (uuid)",
          "project_id": "string (uuid)",
          "target_deployment_id": "string (uuid)",
          "ssh_config": {
            "host": "string",
            "port": "int",
            "username": "string",
            "key_id": "string (uuid)"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "rollback_id": "string (uuid)",
          "status": "string",
          "message": "string"
        }
      },
      "description": "Rollback Manager 发布回滚任务消息，SSH Execution Service 消费并执行远程回滚操作"
    }
  ],
  "data_flow": [
    {
      "name": "项目管理流程",
      "steps": [
        "用户通过 Web Console 填写项目表单（名称、描述、标签）",
        "Web Console 调用 POST /api/v1/projects 经 API Gateway 转发",
        "API Gateway 校验 JWT 身份认证",
        "Gateway 转发请求到 Project Management Service",
        "Project Management Service 校验项目参数合法性",
        "写入 Primary Database projects 表持久化",
        "发送审计事件到 Audit Service (/internal/audit/log)",
        "返回 201 创建结果经 Gateway 到前端展示"
      ]
    },
    {
      "name": "环境配置与密钥导入流程",
      "steps": [
        "用户在 Web Console 选择目标项目，进入环境管理页面",
        "填写环境参数或导入 SSH 私钥",
        "导入密钥：调用 POST /api/v1/keys/import 经 Gateway 到 Key Management Service",
        "Key Management Service 验证密钥格式，计算指纹",
        "密钥 AES-256 加密后存入 Primary Database keys 表",
        "返回 key_id 给 Environment Management Service 绑定环境",
        "创建环境：调用 POST /api/v1/projects/{id}/environments 写入 DB",
        "用户点击「测试连接」→ Environment Management Service 调用 SSH Execution Service 执行探测命令",
        "连接测试结果经 Gateway 返回前端展示"
      ]
    },
    {
      "name": "一键部署流程",
      "steps": [
        "用户在 Web Console 选择项目、目标环境和可执行文件（拖拽/选择上传）",
        "Web Console 将文件编码为 base64，调用 POST /api/v1/projects/{id}/deploy",
        "API Gateway 认证后转发到 Deployment Orchestrator",
        "Orchestrator 创建部署记录写入数据库，状态 pending",
        "Orchestrator 发布任务消息到 RabbitMQ deploy.tasks 交换机",
        "Orchestrator 将部署 ID 和状态写入 Redis 缓存",
        "Web Console 建立 SSE 连接 GET /api/v1/deployments/{id}/stream 监听实时推送",
        "SSH Execution Service 消费队列消息，开始执行部署",
        "在远程服务器创建版本目录 /opt/deploy/{project}/{version}/",
        "上传可执行文件到远程服务器",
        "生成启动/停止/重启/状态检查脚本并传输",
        "执行部署脚本（启动服务），收集输出和退出码",
        "每完成一步，SSH Execution Service 通过 deploy.progress 交换机发布进度消息",
        "Orchestrator 消费进度消息，更新 Redis 实时状态和数据库记录",
        "Orchestrator 通过 SSE push 进度给 Web Console",
        "部署完成，前端展示成功/失败结果和完整日志"
      ]
    },
    {
      "name": "部署历史查看与回滚流程",
      "steps": [
        "用户在 Web Console 进入项目部署历史页面",
        "Web Console 调用 GET /api/v1/projects/{id}/deployments 分页查询历史记录",
        "历史列表展示每次部署的时间、环境、版本号、状态",
        "用户选择一条历史记录查看详情（日志、文件清单等）",
        "用户点击「回滚到此版本」确认回滚操作",
        "Web Console 调用 POST /api/v1/projects/{id}/rollback 提交回滚请求",
        "API Gateway 认证后转发到 Rollback Manager",
        "Rollback Manager 创建回滚记录写入数据库，状态 pending",
        "Rollback Manager 发布回滚任务到 RabbitMQ rollback.tasks 交换机",
        "SSH Execution Service 消费回滚消息",
        "在远程服务器备份当前版本目录",
        "将目标历史版本的部署文件恢复到部署目录",
        "执行服务重启脚本验证恢复状态",
        "回滚进度通过 SSE 实时推送到前端",
        "回滚完成，更新数据库记录和审计日志"
      ]
    },
    {
      "name": "审计日志记录流程",
      "steps": [
        "各微服务在执行关键操作时构建标准化审计事件",
        "调用 Audit Service 的 POST /internal/audit/log 接口",
        "Audit Service 校验事件格式，补充时间戳和来源标识",
        "审计日志写入 Primary Database audit_logs 表",
        "审计日志通过 Web Console 管理界面查询和导出"
      ]
    }
  ]
}
