{
  "meta": {
    "doc_id": "sad-002",
    "type": "sad",
    "title": "自动化部署系统",
    "author": "architect_agent",
    "created": "2026-05-22 14:30"
  },
  "system_overview": {
    "description": "实现将打包好的可执行文件自动化部署到指定远程服务器的功能。支持用户自定义多套部署环境（如测试线、灰度线、正式线等），每套环境可通过密钥配置安全连接，部署时自动在远程服务器上创建版本文件夹并生成执行脚本，实现一键式自动化部署。用户可创建和管理多个项目，每个项目拥有独立的部署环境配置，支持在项目间灵活切换，满足多项目并行管理的需求。",
    "roles": [
      {
        "name": "运维人员",
        "permissions": [
          "配置和管理多套部署环境",
          "上传和管理SSH密钥",
          "执行一键部署操作",
          "查看部署日志和进度",
          "测试环境连接"
        ]
      },
      {
        "name": "开发人员",
        "permissions": [
          "选择目标环境和文件触发部署",
          "查看部署实时日志",
          "查看部署历史记录"
        ]
      },
      {
        "name": "项目经理",
        "permissions": [
          "创建、编辑、删除项目",
          "为项目绑定部署环境",
          "查看项目列表和概要信息",
          "在项目间切换",
          "查看各项目部署状态"
        ]
      }
    ]
  },
  "architecture": {
    "style": "分层架构 + 微服务架构",
    "description": "系统采用前后端分离架构，前端为单页应用（SPA）提供Web管理控制台，后端拆分为多个微服务，通过API网关统一接入。各服务职责单一，通过REST API相互调用。数据层使用PostgreSQL持久化业务数据，Redis提供缓存加速和WebSocket会话管理。远程集成层封装SSH连接池和文件传输能力，与目标服务器安全通信。",
    "layers": [
      {
        "name": "展示层",
        "components": ["Web管理控制台"]
      },
      {
        "name": "网关层",
        "components": ["API网关"]
      },
      {
        "name": "服务层",
        "components": [
          "项目管理服务",
          "环境配置服务",
          "部署引擎服务",
          "密钥管理服务",
          "审计日志服务"
        ]
      },
      {
        "name": "数据层",
        "components": [
          "PostgreSQL主数据库",
          "加密密钥存储",
          "Redis缓存"
        ]
      },
      {
        "name": "远程集成层",
        "components": [
          "SSH连接池服务",
          "文件传输服务"
        ]
      }
    ],
    "connections": [
      {"protocol": "HTTPS/REST"},
      {"protocol": "REST"},
      {"protocol": "SQL/Redis协议"},
      {"protocol": "SSH/SCP"}
    ],
    "features": [
      "前后端分离，API网关统一接入",
      "微服务拆分，职责单一独立部署",
      "多项目隔离，每个项目独立绑定环境",
      "SSH密钥加密存储，安全连接远程服务器",
      "WebSocket实时推送部署日志",
      "一键部署，自动版本化目录管理",
      "完整审计日志，操作可追溯"
    ]
  },
  "tech_stack": {
    "backend": {
      "language": "Python 3.11",
      "framework": "FastAPI"
    },
    "frontend": {
      "framework": "Vue 3",
      "ui_library": "Element Plus"
    },
    "database": "PostgreSQL 15",
    "cache": "Redis 7",
    "protocol": "REST + WebSocket + SSH/SCP",
    "auth": "JWT",
    "ssh_library": "Paramiko",
    "message_format": "JSON"
  },
  "components": [
    {
      "name": "Web管理控制台",
      "type": "frontend",
      "description": "用户交互界面，提供项目管理、环境配置、部署操作的可视化操作面板，采用Vue 3 SPA架构",
      "responsibilities": [
        "项目CRUD操作界面",
        "部署环境配置表单",
        "SSH密钥上传与管理界面",
        "一键部署触发按钮",
        "部署实时日志展示",
        "部署历史记录查询",
        "项目切换与上下文管理"
      ]
    },
    {
      "name": "API网关",
      "type": "gateway",
      "description": "统一API入口，负责请求路由分发、身份认证、权限校验、跨域管理和访问控制",
      "responsibilities": [
        "前端请求路由转发到对应后端服务",
        "JWT令牌验签与身份认证",
        "接口级别权限校验",
        "跨域请求处理",
        "统一错误响应格式",
        "请求日志记录"
      ]
    },
    {
      "name": "项目管理服务",
      "type": "service",
      "description": "项目核心管理服务，处理项目的创建、编辑、删除以及项目与环境绑定关系",
      "responsibilities": [
        "项目CRUD操作",
        "项目与环境绑定关系管理",
        "项目列表与概要信息查询",
        "项目上下文切换与状态维护",
        "项目删除时级联清理关联数据"
      ]
    },
    {
      "name": "环境配置服务",
      "type": "service",
      "description": "部署环境配置管理服务，维护远程服务器连接参数和环境状态",
      "responsibilities": [
        "部署环境CRUD操作",
        "环境连接测试",
        "环境与项目的关联查询",
        "环境状态标记与管理"
      ]
    },
    {
      "name": "部署引擎服务",
      "type": "service",
      "description": "核心部署编排服务，负责完整的部署流程调度、版本管理、脚本生成和进度推送",
      "responsibilities": [
        "部署任务接收与编排调度",
        "自动生成带时间戳的版本号",
        "在远程服务器创建版本化部署目录",
        "生成并传输部署执行脚本",
        "通过WebSocket实时推送部署日志",
        "部署状态管理（进行中/成功/失败）",
        "部署历史记录归档"
      ]
    },
    {
      "name": "密钥管理服务",
      "type": "service",
      "description": "SSH密钥全生命周期管理服务，提供安全存储、加解密和验证能力",
      "responsibilities": [
        "SSH密钥对上传与加密存储",
        "密钥解密用于SSH连接认证",
        "密钥有效性验证与指纹计算",
        "密钥与环境的绑定管理",
        "密钥删除与生命周期管理"
      ]
    },
    {
      "name": "审计日志服务",
      "type": "service",
      "description": "统一审计日志服务，接收各业务服务的操作日志并持久化，支持多维筛选查询",
      "responsibilities": [
        "操作审计日志写入与持久化",
        "部署历史记录归档管理",
        "审计日志按时间、资源类型、操作者多维查询",
        "日志数据定期清理策略"
      ]
    },
    {
      "name": "PostgreSQL主数据库",
      "type": "database",
      "description": "关系型数据库，持久化存储项目、环境配置、部署记录、审计日志等全部结构化业务数据",
      "responsibilities": [
        "项目信息持久化存储",
        "部署环境配置数据存储",
        "部署任务与历史记录存储",
        "用户操作审计日志存储",
        "项目-环境关联关系存储"
      ]
    },
    {
      "name": "加密密钥存储",
      "type": "database",
      "description": "专用于SSH私钥的安全存储模块，数据经AES-256加密后落盘，与主数据库隔离",
      "responsibilities": [
        "SSH私钥加密后持久化存储",
        "密钥密文安全读取",
        "密钥存储与业务数据存储隔离",
        "仅允许密钥管理服务访问"
      ]
    },
    {
      "name": "Redis缓存",
      "type": "infrastructure",
      "description": "高性能缓存服务，用于SSH连接池状态管理、WebSocket会话管理和高频读取数据缓存加速",
      "responsibilities": [
        "SSH连接池活跃连接状态缓存",
        "WebSocket长连接会话管理",
        "高频读取数据（项目列表等）缓存加速",
        "部署实时进度临时存储与推送"
      ]
    },
    {
      "name": "SSH连接池服务",
      "type": "service",
      "description": "远程服务器SSH连接管理服务，维护连接池实现高效复用，提供命令执行和通道能力",
      "responsibilities": [
        "SSH连接建立、复用与回收",
        "连接健康检查与自动重连",
        "远程Shell命令执行",
        "为文件传输提供SCP通道",
        "连接超时与异常处理"
      ]
    },
    {
      "name": "文件传输服务",
      "type": "service",
      "description": "负责将待部署的可执行文件通过SCP安全传输到远程服务器的指定部署目录",
      "responsibilities": [
        "待部署文件接收与临时存储",
        "文件完整性校验（MD5/SHA256）",
        "通过SCP将文件传输到远程服务器",
        "传输进度反馈",
        "传输失败重试机制"
      ]
    }
  ],
  "contracts": [
    {
      "interface": "创建项目",
      "provider": "项目管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "POST /api/projects",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string(required, max_len=128)",
          "description": "string(optional, max_len=500)"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "uuid",
          "name": "string",
          "description": "string",
          "created_at": "datetime(ISO8601)"
        }
      },
      "description": "创建新项目，返回项目唯一标识和创建时间"
    },
    {
