  "data_flow": [
    {
      "name": "一键部署流程",
      "steps": [
        "用户通过Web管理控制台选择目标项目和待部署环境，上传可执行文件并点击部署按钮",
        "Web控制台调用部署引擎服务的 POST /api/deployments 接口触发部署任务",
        "部署引擎服务接收请求，生成版本号（vYYYYMMDD-HHmmss），创建部署记录并返回部署ID和版本号",
        "部署引擎服务调用密钥管理服务内部接口解密获取目标环境的SSH私钥",
        "部署引擎服务调用SSH连接池服务建立与远程服务器的SSH连接",
        "SSH连接池从密钥管理服务获取解密密钥并完成SSH握手认证",
        "部署引擎服务通过文件传输服务将可执行文件通过SCP传输到远程服务器临时目录",
        "部署引擎服务通过SSH连接在远程服务器创建版本化部署目录（如 /opt/app/{project}/{version}/）",
        "部署引擎服务远程生成部署执行脚本并赋予可执行权限",
        "部署引擎服务远程执行脚本完成部署，实时捕获stdout/stderr",
        "部署引擎服务通过WebSocket将执行日志实时推送到Web控制台展示",
        "部署完成，部署引擎服务更新部署状态（success/failed）并写入审计日志"
      ]
    },
    {
      "name": "项目管理流程",
      "steps": [
        "项目经理通过Web管理控制台创建项目，填写名称和描述",
        "Web控制台调用项目管理服务 POST /api/projects 提交项目信息",
        "项目管理服务校验参数合法性，将项目信息持久化到PostgreSQL",
        "项目管理服务返回创建成功的项目信息（含ID和创建时间）",
        "项目经理进入项目详情页，为项目绑定一个或多个部署环境",
        "项目管理服务维护项目与环境的关联关系至PostgreSQL",
        "用户在项目间切换时，项目管理服务通过 POST /api/projects/{id}/switch 返回目标项目的完整上下文",
        "项目列表页通过 GET /api/projects 展示所有项目及其最近部署状态"
      ]
    },
    {
      "name": "环境配置与密钥管理流程",
      "steps": [
        "运维人员在Web控制台创建部署环境，填写服务器地址、端口、登录用户等信息",
        "运维人员上传SSH密钥对，Web控制台调用密钥管理服务 POST /api/keys 提交密钥",
        "密钥管理服务对私钥进行AES-256加密后存入加密密钥存储，返回密钥指纹",
        "运维人员将密钥绑定到部署环境，完成环境配置",
        "运维人员触发连接测试，环境配置服务调用SSH连接池尝试建立连接",
        "SSH连接池从密钥管理服务解密密钥，向目标服务器发起SSH握手",
        "连接测试结果（成功/失败、延迟）返回给Web控制台展示",
        "环境配置持久化到PostgreSQL，关联密钥ID",
        "所有操作由审计日志服务记录归档"
      ]
    }
  ]
}
