      "interface": "实时日志推送",
      "provider": "部署引擎服务",
      "consumers": ["Web管理控制台"],
      "type": "WebSocket",
      "endpoint": "WS /ws/deployments/{id}/logs",
      "request": {
        "path_params": [{"id": "uuid"}],
        "query_params": [],
        "body": {}
      },
      "response": {
        "status": 101,
        "body": {
          "protocol": "WebSocket",
          "message_format": {"type": "string(log/status/error)", "data": "string", "timestamp": "datetime"}
        }
      },
      "description": "建立WebSocket长连接，部署引擎实时推送执行日志帧到前端展示"
    },
    {
      "interface": "上传SSH密钥",
      "provider": "密钥管理服务",
      "consumers": ["Web管理控制台"],
      "type": "REST",
      "endpoint": "POST /api/keys",
      "request": {
        "path_params": [],
        "query_params": [],
        "body": {
          "name": "string(required, max_len=64)",
          "private_key": "string(required, PEM格式)",
          "public_key": "string(optional)",
          "passphrase": "string(optional)"
