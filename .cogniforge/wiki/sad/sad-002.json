        },
        "query_params": {},
        "body": {}
      },
      "response": {
        "status": 200,
        "body": {
          "versions": [
            {
              "deployment_id": "string (uuid)",
              "version": "string",
              "status": "string",
              "created_at": "string (datetime)"
