  "service_contracts": [
    {
      "id": "SC-001",
      "name": "KeyManagerService",
      "description": "密钥管理服务契约，提供加密和解密操作",
      "source_contract_id": "CTR-001",
      "status": "active",
      "version": 1,
      "methods": [
        {
          "name": "encrypt",
          "description": "加密明文私钥",
          "parameters": [
            {
              "name": "plaintext",
              "type": "str",
              "description": "明文私钥"
            }
          ],
          "return_type": "EncryptedKey",
          "exceptions": [
            "EncryptionError"
          ]
        },
        {
          "name": "decrypt",
          "description": "解密密文私钥",
          "parameters": [
            {
              "name": "encrypted_key",
              "type": "EncryptedKey",
              "description": "加密密钥对象"
            }
          ],
          "return_type": "str",
          "exceptions": [
            "DecryptionError"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "加密使用 AES-256-GCM",
        "解密后明文立即擦除"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "name": "主密钥安全性",
      "description": "主密钥必须从安全环境变量加载，不得硬编码或出现在日志中",
      "invariants": [
        "主密钥必须为 32 字节",
        "主密钥只能通过环境变量设置"
      ]
    },
    {
      "id": "BR-002",
      "name": "明文私钥保护",
      "description": "明文私钥仅在内存中短暂存在，使用后必须立即安全擦除",
      "invariants": [
        "解密后明文存储在 bytearray",
        "使用后调用 secure_erase() 清零"
      ]
    },
    {
      "id": "BR-003",
      "name": "加密算法要求",
      "description": "必须使用 AES-256-GCM 进行加密，确保机密性和完整性",
      "invariants": [
        "每次加密生成随机 nonce（12字节）",
        "tag 长度 16 字节"
      ]
    },
    {
      "id": "BR-004",
      "name": "日志安全",
      "description": "禁止记录任何明文密钥或可推导明文的参数",
      "invariants": [
        "日志中不得包含 plaintext",
        "日志中不得包含 master_key"
      ]
    },
    {
      "id": "BR-005",
      "name": "内部调用认证",
      "description": "加密和解密接口仅限内部服务调用，需实施认证",
      "invariants": [
        "调用方需提供有效的服务令牌",
        "令牌验证失败返回 403"
      ]
    }
  ],
  "error_handling": {
    "strategy": "统一错误响应格式，区分客户端错误和服务器错误。加解密操作失败时记录详细日志但不得泄露密钥信息。",
    "errors": [
      {
        "code": "ENCRYPTION_FAILED",
        "description": "加密操作失败",
        "http_status": 500,
        "log": "记录加密失败原因，不记录明文字段"
      },
      {
        "code": "DECRYPTION_FAILED",
        "description": "解密操作失败：密钥不匹配或数据损坏",
        "http_status": 500,
        "log": "记录解密失败原因，不记录加密数据"
      },
      {
        "code": "INVALID_INPUT",
        "description": "输入参数无效",
        "http_status": 400,
        "log": "记录无效参数信息"
      },
      {
        "code": "MASTER_KEY_NOT_LOADED",
        "description": "主密钥未加载",
        "http_status": 500,
        "log": "记录主密钥加载失败"
      },
      {
        "code": "AUTHENTICATION_FAILED",
        "description": "调用方认证失败",
        "http_status": 403,
        "log": "记录认证失败"
      }
    ]
  }
}