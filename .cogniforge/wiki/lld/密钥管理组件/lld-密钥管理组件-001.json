  "data_models": [
    {
      "id": "DM-001",
      "name": "encrypted_keys",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "encrypted_keys"
      },
      "description": "存储经过 AES-256-GCM 加密后的 SSH 私钥密文，以及解密所需的 nonce 和 tag。每条记录关联一个环境（environment）。",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "description": "主键"
        },
        {
          "name": "environment_id",
          "type": "uuid",
          "required": true,
          "description": "关联环境表，唯一"
        },
        {
          "name": "ciphertext",
          "type": "bytea",
          "required": true,
          "description": "加密后的私钥字节"
        },
        {
          "name": "nonce",
          "type": "bytea",
          "required": true,
          "description": "AES-GCM 随机数"
        },
        {
          "name": "tag",
          "type": "bytea",
          "required": true,
          "description": "认证标签"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "encrypted_keys_pkey",
          "unique": true,
          "columns": [
            "id"
          ]
        },
        {
          "name": "idx_encrypted_keys_env",
          "unique": true,
          "columns": [
            "environment_id"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "environment_id 外键引用 environments(id)，ON DELETE CASCADE"
      ],
      "lifecycle": {
        "create": "插入 (环境创建或更新时)",
        "update": "更新密文数据 (覆盖旧值)",
        "delete": "随环境记录级联删除",
        "retention": "与环境生命周期一致"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
