  "module_boundary": {
    "in_scope": [
      "主密钥的加载与安全管理（支持环境变量注入）",
      "提供 encrypt(plaintext: str) -> EncryptedKey 接口",
      "提供 decrypt(encrypted: EncryptedKey) -> str 接口",
      "密文存储结构定义与数据库写入/读取操作",
      "明文内存安全擦除（使用 bytearray 立即清零）",
      "调用方身份验证（内部服务互信）"
    ],
    "out_of_scope": [
      "主密钥的生成与分发策略",
      "SSH 连接建立、远程命令执行等",
      "环境、项目的 CRUD 管理",
      "前端 UI 交互",
      "部署编排的整体流程控制"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-002"
    ],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "使用主密钥（用户设定或系统生成）对 SSH 私钥进行 AES-256 加密存储；解密时仅在内存中提供明文，用完即毁；禁止日志记录明文。",
    "dependencies": [],
    "tech_stack": [
      "Python 3.11+",
      "cryptography (AES-256-GCM)",
      "psycopg2 / SQLAlchemy",
      "FastAPI (internal call)"
    ]
  },
