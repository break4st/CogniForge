  "interfaces": [
    {
      "id": "IF-001",
      "name": "encrypt_private_key",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "POST",
      "endpoint": "/internal/v1/key/encrypt",
      "parameters": [
        {
          "name": "request_body",
          "in": "body",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "plaintext": {
                "type": "string",
                "description": "明文私钥"
              }
            },
            "required": [
              "plaintext"
            ]
          }
        }
      ],
      "response": {
        "status_code": 200,
        "body": {
          "type": "object",
          "properties": {
            "encrypted_key": {
              "$ref": "DO-001"
            }
          }
        }
      },
      "description": "将明文私钥加密，返回 EncryptedKey 对象",
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "调用方必须经过内部服务认证",
        "不记录明文日志"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
