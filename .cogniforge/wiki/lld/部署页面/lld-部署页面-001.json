        "description": "选择本地可执行文件",
        "rules": [],
        "next": "step3"
      },
      {
        "id": "step3",
        "type": "user_action",
        "trigger": "用户输入版本号",
        "description": "输入版本标签",
        "rules": [],
        "next": "step4"
      },
      {
        "id": "step4",
        "type": "user_action",
        "trigger": "用户点击部署按钮",
        "description": "触发部署",
        "rules": [
          "所有必填字段非空"
        ],
        "next": "step5"
      },
      {
        "id": "step5",
        "type": "system_action",
        "trigger": "部署启动",
        "description": "显示部署状态和日志",
        "rules": [],
        "next": "step6"
      },
      {
        "id": "step6",
        "type": "system_action",
        "trigger": "部署完成或错误",
        "description": "显示最终结果",
        "rules": [],
        "next": null
      }
    ]
  }
