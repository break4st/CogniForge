  "overview": {
    "description": "部署页面是Electron渲染进程中的一个React单页组件，提供用户选择目标环境、指定本地可执行文件、输入版本标签并触发部署的交互界面。部署过程中通过面板实时显示远程执行日志，结束后给出成功或失败反馈。",
    "dependencies": [
      "ProjectContext",
      "EnvironmentService"
    ],
    "tech_stack": [
      "React",
      "Ant Design",
      "Vite",
      "TypeScript"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": [
        "CMP-103",
        "CMP-107"
      ],
      "sad_contract_ids": [
        "CTR-005",
        "CTR-006"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002"
        ],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "前端页面作为CMP-103和CMP-107的消费者，通过IPC使用部署启动和日志流服务，实现REQ-003的部署UI及实时反馈。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "DeployFormState",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "部署表单状态，绑定页面UI控件，控制部署流程和反馈",
      "fields": [
        {
          "name": "projectId",
          "type": "string",
          "required": true,
          "description": "从全局上下文获得的当前项目ID，只读"
        },
        {
          "name": "environmentId",
          "type": "string",
          "required": true,
          "description": "用户选中的目标环境ID"
        },
        {
          "name": "filePath",
          "type": "string",
          "required": true,
          "description": "通过文件选择器获取的本地可执行文件路径"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "description": "用户输入的版本标签"
        },
        {
          "name": "deployStatus",
          "type": "string",
          "required": true,
          "description": "当前部署状态（idle/deploying/success/error）"
        },
        {
          "name": "errorMessage",
          "type": "string",
          "required": false,
          "description": "当deployStatus为error时存储的错误详情"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [],
      "source_contracts": [
        "CTR-005"
      ],
      "constraints": [
        "projectId必须来自全局上下文且非空",
        "启动部署前所有字段必须非空"
      ],
      "lifecycle": {
        "create": "页面加载时初始化",
        "update": "用户交互或IPC回调时更新",
        "delete": "页面卸载时销毁",
        "retention": "不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "LogEntry",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "单条日志条目，用于LogViewer渲染",
      "fields": [
        {
          "name": "id",
          "type": "number",
          "required": true,
          "description": "自增序号，用于列表key"
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "日志时间戳，ISO 8601格式"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "日志文本内容"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [],
      "source_contracts": [
        "CTR-006"
      ],
      "constraints": [
        "日志量超过1000条时应截断旧日志，仅保留最近500条"
      ],
      "lifecycle": {
        "create": "接收到日志推送时创建",
        "update": "不更新",
        "delete": "页面卸载或部署结束后清空",
        "retention": "不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
