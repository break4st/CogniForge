  "route_design": [
    {
      "page": "/deploy",
      "mapping": "DeployPage",
      "path": "/deploy",
      "component": "DeployPage",
      "auth_guard": false,
      "meta": {
        "title": "部署页面"
      }
    }
  ],
  "state_design": {
    "state_variables": [
      {
        "name": "deployFormState",
        "type": "DeployFormState",
        "initial_value": {
          "projectId": "",
          "environmentId": "",
          "filePath": "",
          "version": "",
          "deployStatus": "idle",
          "errorMessage": ""
        }
      },
      {
        "name": "logs",
        "type": "LogEntry[]",
        "initial_value": []
      }
    ],
    "state_machines": [
      {
        "name": "deployFlow",
        "states": [
          "idle",
          "deploying",
          "success",
          "error"
        ],
        "transitions": [
          {
            "from": "idle",
            "to": "deploying",
            "trigger": "onDeploy"
          },
          {
            "from": "deploying",
            "to": "success",
            "trigger": "deploySuccess"
          },
          {
            "from": "deploying",
            "to": "error",
            "trigger": "deployError"
          },
          {
            "from": "error",
            "to": "idle",
            "trigger": "reset"
          },
          {
            "from": "success",
            "to": "idle",
            "trigger": "reset"
          }
        ]
      }
    ],
    "derived_state": [
      {
        "name": "isFormValid",
        "derivation": "deployFormState.projectId && deployFormState.environmentId && deployFormState.filePath && deployFormState.version",
        "type": "boolean"
      },
      {
        "name": "isDeploying",
        "derivation": "deployFormState.deployStatus === 'deploying'",
        "type": "boolean"
      }
    ]
  },
  "interaction_flows": [
    {
      "name": "选择环境",
      "trigger_action": "用户点击环境下拉框",
      "pre_conditions": [
        "环境列表已加载"
      ],
      "steps": [
        "用户点击环境下拉框",
        "系统展示可用环境列表",
        "用户选择一个环境",
        "系统更新environmentId值"
      ],
      "post_conditions": [
        "deployFormState.environmentId已更新"
      ],
      "alternative_paths": [
        "如果环境列表为空，显示禁用提示"
      ],
      "error_handling": "如果加载环境列表失败，显示错误提示"
    },
    {
      "name": "选择文件",
      "trigger_action": "用户点击文件选择按钮",
      "pre_conditions": [
        "无"
      ],
      "steps": [
        "用户点击文件选择按钮",
        "系统打开文件选择对话框",
        "用户选择本地可执行文件",
        "系统更新filePath值"
      ],
      "post_conditions": [
        "deployFormState.filePath已更新"
      ],
      "alternative_paths": [
        "如果用户取消选择，不更新filePath"
      ],
      "error_handling": "如果文件选择失败，不做任何操作"
    },
    {
      "name": "输入版本号",
      "trigger_action": "用户在版本输入框中输入",
      "pre_conditions": [
        "无"
      ],
      "steps": [
        "用户在版本输入框中输入",
        "系统同步更新version值"
      ],
      "post_conditions": [
        "deployFormState.version已更新"
      ],
      "alternative_paths": [],
      "error_handling": "无"
    },
    {
      "name": "启动部署",
      "trigger_action": "用户点击部署按钮",
      "pre_conditions": [
        "表单验证通过（所有必填字段非空）"
      ],
      "steps": [
        "用户点击部署按钮",
        "系统将deployStatus设置为deploying",
        "系统调用IPC start-deploy通道发送部署参数",
        "系统等待部署结果和日志"
      ],
      "post_conditions": [
        "部署启动",
        "deployStatus变为deploying",
        "日志面板开始接收日志"
      ],
      "alternative_paths": [
        "如果表单未通过验证，不启动部署并显示验证错误"
      ],
      "error_handling": "如果IPC调用失败，捕获异常，设置deployStatus为error，显示错误信息"
    }
  ],
  "error_handling": {
    "strategy": "使用React Error Boundary捕获渲染错误，显示回退UI；IPC超时后置deployStatus为error；表单验证错误在字段下方显示红色提示；部署过程错误通过日志面板显示，最终错误通过通知和状态字段显示"
  },
  "api_integration": [
    {
      "page": "部署页面",
      "name": "启动部署",
      "description": "向主进程发送部署命令",
      "type": "ipc",
      "endpoint": "start-deploy",
      "channel": "start-deploy",
      "direction": "request",
      "payload": {
        "projectId": "string",
        "environmentId": "string",
        "filePath": "string",
        "version": "string"
      },
      "response": {
        "success": "boolean"
      },
      "error_channel": "deploy-error",
      "timeout": 0,
      "retry": 0,
      "fallback": "显示错误提示"
    },
    {
      "page": "部署页面",
      "name": "接收日志",
      "description": "接收部署实时日志",
      "type": "ipc",
      "endpoint": "deploy-log",
      "channel": "deploy-log",
      "direction": "subscribe",
      "payload": {
        "log": "LogEntry"
      },
      "response": {},
      "error_channel": "",
      "timeout": 0,
      "retry": 0,
      "fallback": ""
    },
    {
      "page": "部署页面",
      "name": "接收部署结果",
      "description": "接收最终部署结果",
      "type": "ipc",
      "endpoint": "deploy-result",
      "channel": "deploy-result",
      "direction": "subscribe",
      "payload": {
        "status": "string",
        "message": "string"
      },
      "response": {},
      "error_channel": "",
      "timeout": 0,
      "retry": 0,
      "fallback": ""
    }
  ],
  "workflow": {
    "title": "部署页面交互流程",
    "steps": [
      {
        "id": "step1",
        "type": "user_action",
        "trigger": "用户点击环境下拉框",
