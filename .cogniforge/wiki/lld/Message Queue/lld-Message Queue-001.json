{
  "meta": {
    "doc_id": "lld-Message Queue-001",
    "type": "lld",
    "module_type": "ModuleType.SERVICE",
    "module": "Message Queue",
    "title": "LLD - Message Queue",
    "author": "design_agent",
    "created": "2026-05-21 09:53"
  },
  "overview": {
    "description": "RabbitMQ消息队列基础设施，用于异步解耦部署编排服务与SSH执行服务，支持任务可靠投递、失败重试和死信处理。定义系统消息拓扑（Exchange/Queue/Binding）、消息契约和投递策略，保障部署任务不丢失、不重复消费。",
    "dependencies": [
      "Deployment Orchestrator",
      "SSH Execution Service"
    ],
    "tech_stack": [
      "RabbitMQ",
      "Docker 容器化部署"
    ]
  },
  "data_models": [
    {
      "name": "DeploymentTaskMessage",
      "type": "struct",
      "ownership": "owned",
      "description": "部署任务消息体，Deployment Orchestrator投递到deployment.execute队列的消息结构",
      "fields": [
        {"name": "deployment_id", "type": "integer", "required": true, "description": "部署任务ID"},
        {"name": "project_id", "type": "integer", "required": true, "description": "项目ID"},
        {"name": "environment_id", "type": "integer", "required": true, "description": "目标环境ID"},
        {"name": "version", "type": "string", "required": true, "description": "版本号"},
        {"name": "artifact_path", "type": "string", "required": true, "description": "可执行文件路径或下载URL"},
        {"name": "host", "type": "string", "required": true, "description": "远程主机地址（IP或域名）"},
        {"name": "port", "type": "integer", "required": true, "description": "SSH端口号"},
        {"name": "username", "type": "string", "required": true, "description": "SSH登录用户名"},
        {"name": "key_id", "type": "integer", "required": true, "description": "密钥ID，用于从Key Management Service获取加密密钥"},
        {"name": "commands", "type": "array[string]", "required": true, "description": "要执行的部署命令列表"},
        {"name": "trace_id", "type": "string", "required": true, "description": "链路追踪ID，用于关联跨服务日志"},
        {"name": "timestamp", "type": "string", "required": true, "description": "消息创建时间戳（ISO 8601格式）"},
        {"name": "retry_count", "type": "integer", "required": false, "description": "重试次数，初始为0，每次重试递增"}
      ]
    },
    {
      "name": "DeploymentResultMessage",
      "type": "struct",
      "ownership": "owned",
      "description": "部署结果回传消息体，SSH Execution Service执行完成后投递到deployment.result队列的消息结构",
      "fields": [
        {"name": "deployment_id", "type": "integer", "required": true, "description": "部署任务ID"},
        {"name": "success", "type": "boolean", "required": true, "description": "SSH执行是否成功"},
        {"name": "exit_code", "type": "integer", "required": true, "description": "SSH命令退出码"},
        {"name": "stdout", "type": "string", "required": false, "description": "标准输出内容"},
        {"name": "stderr", "type": "string", "required": false, "description": "标准错误输出"},
        {"name": "error_message", "type": "string", "required": false, "description": "执行错误信息，success=false时有效"},
        {"name": "trace_id", "type": "string", "required": true, "description": "链路追踪ID"},
        {"name": "timestamp", "type": "string", "required": true, "description": "消息创建时间戳（ISO 8601格式）"}
      ]
    },
    {
      "name": "DeploymentLogMessage",
      "type": "struct",
      "ownership": "owned",
      "description": "部署日志消息体，SSH Execution Service执行过程中实时推送日志片段的队列消息结构",
      "fields": [
        {"name": "deployment_id", "type": "integer", "required": true, "description": "部署任务ID"},
        {"name": "message", "type": "string", "required": true, "description": "日志内容文本"},
        {"name": "level", "type": "string", "required": true, "description": "日志级别：info|warn|error"},
        {"name": "timestamp", "type": "string", "required": true, "description": "日志产生时间（ISO 8601格式）"}
      ]
    },
    {
      "name": "cogniforge_deployment_exchange",
      "type": "config",
      "ownership": "owned",
      "description": "主Topic Exchange定义，用于部署消息的路由分发。所有部署相关消息（执行任务、结果回传、实时日志）均通过此Exchange路由",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "Exchange名称：cogniforge.deployment"},
        {"name": "type", "type": "string", "required": true, "description": "Exchange类型：topic"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true，服务重启后Exchange保留"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false，所有队列解绑后不自动删除"}
      ]
    },
    {
      "name": "deployment_dlq_exchange",
      "type": "config",
      "ownership": "owned",
      "description": "死信Exchange定义，消费失败且达到重试上限的消息转入此Exchange，路由到deployment.dlq队列等待人工处理",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "Exchange名称：cogniforge.deployment.dlq"},
        {"name": "type", "type": "string", "required": true, "description": "Exchange类型：direct"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false"}
      ]
    },
    {
      "name": "deployment_retry_exchange",
      "type": "config",
      "ownership": "owned",
      "description": "重试Exchange定义，消费失败的消息经死信路由到此Exchange，转入deployment.retry队列等待TTL超时后重新投递到主Exchange",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "Exchange名称：cogniforge.deployment.retry"},
        {"name": "type", "type": "string", "required": true, "description": "Exchange类型：direct"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false"}
      ]
    },
    {
      "name": "DeploymentExecuteQueue",
      "type": "config",
      "ownership": "owned",
      "description": "部署任务执行队列。Deployment Orchestrator投递任务消息到此队列，SSH Execution Service作为消费者从中拉取任务执行。启用死信转发到重试Exchange，消费失败的消息自动进入重试流程",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "队列名称：deployment.execute"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true，RabbitMQ重启后队列和消息不丢失"},
        {"name": "exclusive", "type": "boolean", "required": true, "description": "排他开关：false，允许多个消费者共享队列"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false"},
        {"name": "routing_key", "type": "string", "required": true, "description": "绑定路由键：deployment.execute"},
        {"name": "bind_exchange", "type": "string", "required": true, "description": "绑定的Exchange：cogniforge.deployment"},
        {"name": "dead_letter_exchange", "type": "string", "required": true, "description": "死信Exchange：cogniforge.deployment.retry"},
        {"name": "prefetch_count", "type": "integer", "required": true, "description": "消费者预取消息数量：1，每次只消费一条消息，防止并发冲突"}
      ]
    },
    {
      "name": "DeploymentResultQueue",
      "type": "config",
      "ownership": "owned",
      "description": "部署结果回传队列。SSH Execution Service执行完成后投递结果消息到此队列，Deployment Orchestrator消费处理后更新数据库状态并通过WebSocket推送前端",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "队列名称：deployment.result"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true"},
        {"name": "exclusive", "type": "boolean", "required": true, "description": "排他开关：false"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false"},
        {"name": "routing_key", "type": "string", "required": true, "description": "绑定路由键：deployment.result"},
        {"name": "bind_exchange", "type": "string", "required": true, "description": "绑定的Exchange：cogniforge.deployment"},
        {"name": "prefetch_count", "type": "integer", "required": true, "description": "消费者预取消息数量：1"}
      ]
    },
    {
      "name": "DeploymentLogQueue",
      "type": "config",
      "ownership": "owned",
      "description": "部署日志实时队列。SSH Execution Service执行过程中实时推送日志片段到此队列，Deployment Orchestrator消费后通过WebSocket推送前端实时展示",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "队列名称：deployment.log"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true"},
        {"name": "exclusive", "type": "boolean", "required": true, "description": "排他开关：false"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false"},
        {"name": "routing_key", "type": "string", "required": true, "description": "绑定路由键：deployment.log"},
        {"name": "bind_exchange", "type": "string", "required": true, "description": "绑定的Exchange：cogniforge.deployment"},
        {"name": "prefetch_count", "type": "integer", "required": true, "description": "消费者预取消息数量：10（日志消息轻量高频，允许批量消费提升吞吐）"}
      ]
    },
    {
      "name": "DeploymentDLQueue",
      "type": "config",
      "ownership": "owned",
      "description": "死信队列，存储重试次数耗尽（retry_count >= 3）的失败消息，用于人工介入排查错误原因并决定重新投递或丢弃",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "队列名称：deployment.dlq"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true"},
        {"name": "exclusive", "type": "boolean", "required": true, "description": "排他开关：false"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false"},
        {"name": "routing_key", "type": "string", "required": true, "description": "绑定路由键：deployment.dlq"},
        {"name": "bind_exchange", "type": "string", "required": true, "description": "绑定的Exchange：cogniforge.deployment.dlq"}
      ]
    },
    {
      "name": "DeploymentRetryQueue",
      "type": "config",
      "ownership": "owned",
      "description": "重试队列（TTL队列）。消费失败的消息经死信路由后进入此队列等待TTL超时，超时后自动重新投递到主Exchange的deployment.execute队列重新消费，实现延迟重试",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "队列名称：deployment.retry"},
        {"name": "durable", "type": "boolean", "required": true, "description": "持久化开关：true"},
        {"name": "exclusive", "type": "boolean", "required": true, "description": "排他开关：false"},
        {"name": "auto_delete", "type": "boolean", "required": true, "description": "自动删除开关：false"},
        {"name": "routing_key", "type": "string", "required": true, "description": "绑定路由键：deployment.retry"},
        {"name": "bind_exchange", "type": "string", "required": true, "description": "绑定的Exchange：cogniforge.deployment.retry"},
        {"name": "message_ttl", "type": "integer", "required": true, "description": "消息TTL（毫秒）：30000，消息在此队列中存活30秒后自动过期转入死信"},
        {"name": "dead_letter_exchange", "type": "string", "required": true, "description": "死信Exchange（TTL超时后重新投递到主Exchange）：cogniforge.deployment"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "Publish Deployment Task",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.execute (producer)",
      "description": "Deployment Orchestrator生产端将部署任务消息投递到deployment.execute队列。启用publisher confirms确保可靠投递，delivery_mode=2持久化消息体，消息JSON序列化后不超过512KB限制",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID"},
        {"name": "project_id", "type": "integer", "description": "项目ID"},
        {"name": "environment_id", "type": "integer", "description": "目标环境ID"},
        {"name": "version", "type": "string", "description": "版本号"},
        {"name": "artifact_path", "type": "string", "description": "可执行文件路径或下载URL"},
        {"name": "host", "type": "string", "description": "远程主机地址"},
        {"name": "port", "type": "integer", "description": "SSH端口号"},
        {"name": "username", "type": "string", "description": "SSH登录用户名"},
        {"name": "key_id", "type": "integer", "description": "密钥ID"},
        {"name": "commands", "type": "array[string]", "description": "部署命令列表"},
        {"name": "trace_id", "type": "string", "description": "链路追踪ID"},
        {"name": "timestamp", "type": "string", "description": "消息创建时间戳（ISO 8601格式）"},
        {"name": "retry_count", "type": "integer", "description": "重试次数，初始为0"}
      ],
      "response": {
        "status": 200,
        "body": {
          "published": "boolean",
          "message_id": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "MQ连接失败：RabbitMQ Broker不可达或TCP连接被拒绝"},
        {"code": 500, "message": "消息投递超时：Broker未在5秒超时内返回basic.ack确认"},
        {"code": 500, "message": "消息序列化失败：JSON编码异常或消息体超过Broker最大限制"}
      ]
    },
    {
      "name": "Consume Deployment Task",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.execute (consumer)",
      "description": "SSH Execution Service消费端从deployment.execute队列拉取部署任务消息。消费成功后调用basic_ack确认；可恢复异常（网络抖动）调用basic_nack(requeue=false)转入死信重试；不可恢复异常（格式错误）basic_ack丢弃",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID"},
        {"name": "project_id", "type": "integer", "description": "项目ID"},
        {"name": "environment_id", "type": "integer", "description": "目标环境ID"},
        {"name": "version", "type": "string", "description": "版本号"},
        {"name": "artifact_path", "type": "string", "description": "可执行文件路径或下载URL"},
        {"name": "host", "type": "string", "description": "远程主机地址"},
        {"name": "port", "type": "integer", "description": "SSH端口号"},
        {"name": "username", "type": "string", "description": "SSH登录用户名"},
        {"name": "key_id", "type": "integer", "description": "密钥ID"},
        {"name": "commands", "type": "array[string]", "description": "部署命令列表"},
        {"name": "trace_id", "type": "string", "description": "链路追踪ID"},
        {"name": "timestamp", "type": "string", "description": "消息创建时间戳"},
        {"name": "retry_count", "type": "integer", "description": "当前重试次数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "consumed": "boolean",
          "delivery_tag": "integer"
        }
      },
      "error_codes": [
        {"code": 500, "message": "MQ连接中断：消费端与Broker的TCP连接异常断开，自动恢复机制将触发重连"},
        {"code": 500, "message": "消息反序列化失败：JSON解析错误或必需字段缺失，消息将被ack丢弃"}
      ]
    },
    {
      "name": "Publish Deployment Result",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.result (producer)",
      "description": "SSH Execution Service执行完成后将部署结果消息投递到deployment.result队列。Deployment Orchestrator消费端接收后更新部署状态和日志到数据库，并通过WebSocket推送最终部署结果到Web Console",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID"},
        {"name": "success", "type": "boolean", "description": "SSH执行是否成功"},
        {"name": "exit_code", "type": "integer", "description": "SSH命令退出码"},
        {"name": "stdout", "type": "string", "description": "标准输出内容"},
        {"name": "stderr", "type": "string", "description": "标准错误输出"},
        {"name": "error_message", "type": "string", "description": "执行错误信息，success=false时有效"},
        {"name": "trace_id", "type": "string", "description": "链路追踪ID"},
        {"name": "timestamp", "type": "string", "description": "消息创建时间戳（ISO 8601格式）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "published": "boolean",
          "message_id": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "MQ连接失败或结果消息投递超时：Broker未确认消息接收"}
      ]
    },
    {
      "name": "Consume Deployment Result",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.result (consumer)",
      "description": "Deployment Orchestrator消费端从deployment.result队列拉取结果消息，解析并更新deployments表状态和日志，通过WebSocket推送最终部署结果（success/failed）到前端",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID"},
        {"name": "success", "type": "boolean", "description": "SSH执行是否成功"},
        {"name": "exit_code", "type": "integer", "description": "SSH命令退出码"},
        {"name": "stdout", "type": "string", "description": "标准输出内容"},
        {"name": "stderr", "type": "string", "description": "标准错误输出"},
        {"name": "error_message", "type": "string", "description": "执行错误信息"},
        {"name": "trace_id", "type": "string", "description": "链路追踪ID"},
        {"name": "timestamp", "type": "string", "description": "消息创建时间戳"}
      ],
      "response": {
        "status": 200,
        "body": {
          "consumed": "boolean",
          "delivery_tag": "integer"
        }
      },
      "error_codes": [
        {"code": 500, "message": "MQ连接中断或消息反序列化失败"}
      ]
    },
    {
      "name": "Publish Deployment Log",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.log (producer)",
      "description": "SSH Execution Service在执行过程中通过Paramiko的channel.recv实时捕获标准输出流，切割为日志片段后实时投递到deployment.log队列。Deployment Orchestrator消费后通过WebSocket推送到Web Console实时展示",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID"},
        {"name": "message", "type": "string", "description": "日志内容文本"},
        {"name": "level", "type": "string", "description": "日志级别：info|warn|error"},
        {"name": "timestamp", "type": "string", "description": "日志产生时间（ISO 8601格式）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "published": "boolean",
          "message_id": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "MQ连接失败或日志消息投递超时：日志消息丢失不影响核心部署流程，仅影响前端实时展示"}
      ]
    },
    {
      "name": "Consume Deployment Log",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.log (consumer)",
      "description": "Deployment Orchestrator消费端从deployment.log队列批量拉取日志消息，通过WebSocket连接按序推送到Web Console实时展示，消息处理完毕后basic_ack批量确认",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID"},
        {"name": "message", "type": "string", "description": "日志内容文本"},
        {"name": "level", "type": "string", "description": "日志级别"},
        {"name": "timestamp", "type": "string", "description": "日志产生时间"}
      ],
      "response": {
        "status": 200,
        "body": {
          "consumed": "boolean",
          "delivery_tag": "integer"
        }
      },
      "error_codes": [
        {"code": 500, "message": "MQ连接中断或日志消息反序列化失败"}
      ]
    }
  ],
  "error_handling": "RabbitMQ消息队列的错误处理分为四个层面：\n\n(1) 连接层 — 服务启动时自动初始化RabbitMQ连接，启用连接恢复机制（automatic_recovery），在连接断开时自动重连（重试间隔5秒）。连接长时间不可达时记录ERROR日志并触发运维告警通知排查。\n\n(2) 投递层 — 生产者启用publisher confirms机制（confirm_select），在消息确认回调中处理投递结果：Broker返回basic.ack表示投递成功；Broker返回basic.nack或投递超时（默认5秒超时阈值）表示投递失败，由生产者重试最多3次后仍失败则记录错误日志并标记部署状态为failed。\n\n(3) 消费层 — 消费者采用手动确认模式（manual_ack），按消息处理结果执行不同确认操作：处理成功调用basic_ack确认消费，消息正式出队；可恢复类型异常（如SSH连接超时、远程命令执行失败）调用basic_nack(requeue=false)拒绝消息，通过死信机制转入deployment.retry重试队列等待30秒后重新投递；不可恢复类型异常（如消息格式错误、必需字段缺失）直接basic_ack确认消费丢弃消息，防止死信队列无限堆积；消费者进程崩溃或TCP连接断开时，Broker自动将已投递但未确认的unacked消息重新入队（requeue=true），由其他消费者或重连后的同一消费者重新消费。\n\n(4) 重试与死信层 — 消息处理失败后的流转策略采用'重试队列+TTL+死信'的延迟重试模式：第1次失败后消息路由到deployment.retry队列等待30秒TTL超时，过期后自动投递到cogniforge.deployment Exchange重新回到deployment.execute队列重新消费；第2次失败重复上述流程且retry_count递增为2；第3次失败retry_count递增为3；当retry_count >= 3时消息不再转入重试队列而是路由到deployment.dlq死信队列，不再自动重试，由运维人员通过RabbitMQ Management Plugin（管理端口15672）查看死信详情、排查错误原因后手动决定重新投递或丢弃。每条消息的retry_count字段由消费者检测到异常后在nack前写入消息头，重试队列只做TTL延迟转发，不修改消息体内容。"
}
