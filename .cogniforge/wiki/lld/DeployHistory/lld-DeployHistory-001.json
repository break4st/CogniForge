  "state_design": {
    "description": "各组件的主要状态设计",
    "components": [
      {
        "component_id": "CMP-002",
        "states": [
          {
            "name": "deployments",
            "type": "array of DeploymentSummary",
            "description": "部署历史列表数据"
          },
          {
            "name": "loading",
            "type": "boolean",
            "description": "列表加载状态"
          },
          {
            "name": "error",
            "type": "string | null",
            "description": "列表加载错误信息"
          }
        ]
      },
      {
        "component_id": "CMP-003",
        "states": [
          {
            "name": "deploymentDetail",
            "type": "DeploymentDetail | null",
            "description": "部署详情数据"
          },
          {
            "name": "loading",
            "type": "boolean",
            "description": "详情加载状态"
          },
          {
            "name": "error",
            "type": "string | null",
