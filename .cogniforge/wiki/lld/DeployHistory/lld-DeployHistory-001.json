          }
        ]
      }
    ]
  },
  "route_design": {
    "description": "部署历史模块的路由配置",
    "routes": [
      {
        "path": "/deploy-history",
        "component": "DeployHistoryLayout",
        "exact": false,
        "children": [
          {
            "path": "",
            "component": "DeployHistoryPage",
            "exact": true
          },
          {
            "path": ":deploymentId",
            "component": "DeployHistoryDetailPage",
            "exact": true
          }
        ]
      }
    ]
  },
  "interaction_flows": {
    "description": "关键交互流程",
    "flows": [
      {
        "id": "FLOW-001",
        "name": "查看部署历史列表",
        "trigger": "用户导航到部署历史页面",
        "steps": [
          "1. DeployHistoryPage 挂载",
          "2. 检查 projectId 和 environmentId 是否存在",
          "3. 调用 API 获取部署历史列表 (GET /api/deployments?projectId=...&environmentId=...)",
          "4. 展示加载状态",
          "5. 处理响应，更新 deployments 状态或显示错误",
          "6. 列表按 deployedAt 降序显示"
        ]
      },
      {
        "id": "FLOW-002",
        "name": "查看部署详情",
        "trigger": "用户从列表点击某条记录",
        "steps": [
          "1. 导航到 /deploy-history/:deploymentId",
          "2. DeployHistoryDetailPage 挂载，获取 deploymentId 参数",
          "3. 调用 API 获取部署详情 (GET /api/deployments/:deploymentId)",
          "4. 展示加载状态",
          "5. 处理响应，更新 deploymentDetail 状态或显示错误",
          "6. 渲染 DeploymentInfoCard 和 DeploymentLog"
        ]
      },
      {
        "id": "FLOW-003",
        "name": "执行回滚",
        "trigger": "用户在详情页点击回滚按钮",
        "steps": [
          "1. 显示回滚确认对话框，填写目标版本（可选）",
          "2. 用户确认",
          "3. 调用回滚 API (POST /api/deployments/:deploymentId/rollback, body: { targetVersion })",
          "4. 处理响应，显示成功或失败消息",
          "5. 成功后跳转回列表页并刷新"
        ]
      },
      {
        "id": "FLOW-004",
        "name": "清理旧版本",
        "trigger": "用户在列表页点击清理按钮",
        "steps": [
          "1. 显示清理对话框，输入保留数量 keepCount",
          "2. 用户确认",
          "3. 调用清理 API (POST /api/deployments/cleanup, body: { projectId, environmentId, keepCount })",
          "4. 处理响应，显示成功或失败消息",
          "5. 成功后刷新列表"
        ]
      }
    ]
  },
  "api_integration": {
    "description": "API 集成点",
    "integrations": [
      {
        "contract_id": "CTR-001",
        "method": "GET",
        "endpoint": "/api/deployments",
        "description": "获取部署历史列表",
        "request": {
          "params": {
            "projectId": "string",
            "environmentId": "string"
          }
        },
        "response": {
          "type": "array of DeploymentSummary"
        }
      },
      {
        "contract_id": "CTR-002",
        "method": "GET",
        "endpoint": "/api/deployments/:id",
        "description": "获取部署详情",
        "request": {
          "params": {
            "id": "string"
          }
        },
        "response": {
          "type": "DeploymentDetail"
        }
      },
      {
        "contract_id": "CTR-003",
        "method": "POST",
        "endpoint": "/api/deployments/:id/rollback",
        "description": "发起回滚",
        "request": {
          "body": {
            "targetVersion": "string (optional)"
          }
        },
        "response": {
          "type": "object",
          "fields": {
            "success": "boolean",
            "message": "string"
          }
        }
      },
      {
        "contract_id": "CTR-004",
        "method": "POST",
        "endpoint": "/api/deployments/cleanup",
        "description": "清理旧版本",
        "request": {
          "body": {
            "projectId": "string",
            "environmentId": "string",
            "keepCount": "number"
          }
        },
        "response": {
          "type": "object",
          "fields": {
            "success": "boolean",
            "message": "string",
            "deletedCount": "number"
          }
        }
      }
    ]
  },
  "error_handling": {
    "strategy": "统一错误处理：API 调用失败时，在组件中捕获异常，展示错误信息。对于网络错误显示通用提示，对于业务错误显示后端返回的消息。关键操作（回滚、清理）提供重试选项。日志展示组件对长日志实现虚拟滚动避免性能问题。",
    "fallback_ui": "错误时在组件内显示 Alert 组件，不影响页面其他部分渲染。列表加载失败显示错误提示和重试按钮；详情加载失败显示返回按钮和重试链接；操作失败显示通知。"
  }
}