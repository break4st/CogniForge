  "data_models": [
    {
      "id": "DM-001",
      "name": "EncryptedKeyRecord",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Security-Module-001",
        "model_name": "encrypted_keys"
      },
      "description": "存储加密后的私钥及关联元数据，支持密钥标识、加密算法参数与密文存储。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "自增主键，唯一标识一条加密密钥记录"
        },
        {
          "name": "key_alias",
          "type": "TEXT NOT NULL UNIQUE",
          "required": true,
          "description": "密钥别名，用于业务层引用，必须唯一"
        },
        {
          "name": "created_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "记录创建时间，ISO 8601格式"
        },
        {
          "name": "encrypted_private_key",
          "type": "BLOB NOT NULL",
          "required": true,
          "description": "经 AES-256-GCM 加密后的私钥密文"
        },
        {
          "name": "iv",
          "type": "BLOB NOT NULL",
          "required": true,
          "description": "AES-256-GCM 使用的初始化向量"
        },
        {
          "name": "auth_tag",
          "type": "BLOB NOT NULL",
          "required": true,
          "description": "GCM 模式认证标签，用于完整性校验"
        },
        {
          "name": "algorithm",
          "type": "TEXT NOT NULL CHECK(algorithm = 'aes-256-gcm')",
          "required": true,
          "description": "加密算法标识，固定为 'aes-256-gcm'"
        }
      ],
      "indexes": [
        {
          "name": "idx_key_alias",
          "unique": true,
          "columns": [
            "key_alias"
          ]
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "通过 SecurityService.encrypt 方法新增一条加密密钥记录",
        "update": "不允许直接更新；如需更换密钥，应删除旧记录后重新创建",
        "delete": "通过 SecurityService 内部逻辑根据 key_alias 删除记录，并安全擦除内存中的明文",
        "retention": "长期保留，直至显式删除"
      },
      "source_requirements": [
        "REQ-005"
      ],
      "source_components": [
        "CMP-007"
      ],
      "source_contracts": [
        "CTR-007"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建 EncryptedKeyRecord 数据模型",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "AuditLogRecord",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Security-Module-001",
        "model_name": "audit_logs"
      },
      "description": "存储安全操作审计日志，记录操作类型、目标对象及结果，不包含私钥明文。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "自增主键，唯一标识一条审计日志条目"
        },
        {
          "name": "timestamp",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "日志记录时间，ISO 8601格式"
        },
        {
          "name": "action",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "操作类型，如 'encrypt', 'decrypt', 'delete' 等"
        },
        {
          "name": "target",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "操作目标对象标识，如密钥别名"
        },
        {
          "name": "result",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "操作结果，如 'success', 'failure' 等"
        },
        {
          "name": "details",
          "type": "TEXT",
          "required": false,
          "description": "可选附加信息，如错误描述，不得包含私钥明文"
        }
      ],
      "indexes": [
        {
          "name": "idx_timestamp",
          "unique": false,
          "columns": [
            "timestamp"
          ]
        },
        {
          "name": "idx_action",
          "unique": false,
          "columns": [
            "action"
          ]
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "每条安全操作完成后自动写入审计日志",
        "update": "不允许修改，审计日志为不可变记录",
        "delete": "只读保留，除非达到保留期限后由管理员清理",
        "retention": "默认永久保留，可配置定期归档或清理策略"
      },
      "source_requirements": [
        "REQ-005"
      ],
      "source_components": [
        "CMP-007"
      ],
      "source_contracts": [
        "CTR-007"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建 AuditLogRecord 数据模型",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "SecurityService",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-007",
      "provider_component_id": "CMP-007",
      "method": "INTERNAL",
      "endpoint": "SecurityModule/SecurityService",
      "description": "安全服务接口，提供私钥加密、解密和安全销毁，以及审计日志记录功能。",
      "parameters": [],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "encrypt": {
            "description": "加密私钥",
            "input": {
              "privateKey": "string (明文私钥)",
              "keyId": "string (可选，密钥标识符)"
            },
            "output": {
              "success": "boolean",
              "encryptedKeyId": "string (用于后续解密的引用ID)"
            }
          },
          "decrypt": {
            "description": "解密私钥，返回明文引用",
            "input": {
              "encryptedKeyId": "string (加密时返回的引用ID)"
            },
            "output": {
              "success": "boolean",
              "privateKeyHandle": "string (内存中明文私钥的引用句柄)"
            }
          },
          "destroyPrivateKey": {
            "description": "安全销毁内存中的私钥明文",
            "input": {
              "privateKeyHandle": "string (解密返回的引用句柄)"
            },
            "output": {
              "success": "boolean"
            }
          },
          "auditLog": {
            "description": "记录审计日志",
            "input": {
              "action": "string",
              "target": "string",
              "result": "string"
            },
            "output": {
              "success": "boolean",
              "logId": "string"
            }
          }
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_INPUT",
          "message": "输入参数无效或缺失"
        },
        {
          "status": 500,
          "code": "ENCRYPTION_FAILED",
          "message": "加密操作失败"
        },
        {
          "status": 500,
          "code": "DECRYPTION_FAILED",
          "message": "解密操作失败"
        },
        {
          "status": 404,
          "code": "KEY_NOT_FOUND",
          "message": "未找到指定的加密密钥"
        },
        {
          "status": 500,
          "code": "AUDIT_LOG_FAILED",
          "message": "审计日志记录失败"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
