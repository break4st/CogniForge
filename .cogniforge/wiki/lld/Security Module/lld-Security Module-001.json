  "module_boundary": {
    "in_scope": [
      "私钥加密（AES-256-GCM）",
      "私钥解密（内存明文，用后即毁）",
      "安全擦除内存中的私钥",
      "密钥派生（主密码或OS密钥环）",
      "审计日志记录（action, target, result）",
      "与SQLite交互存储密文和审计日志",
      "实现CTR-007定义的接口"
    ],
    "out_of_scope": [
      "SSH连接管理",
      "部署流程编排",
      "环境连通性测试逻辑（非加密部分）",
      "UI交互",
      "密钥生成（仅加解密存储）"
    ],
    "owned_components": [
      "CMP-007"
    ],
