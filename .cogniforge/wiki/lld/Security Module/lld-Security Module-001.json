  "workflow": {
    "name": "SecurityModuleInitialization",
    "description": "模块初始化流程：验证数据库连接，检查密钥环可用性，加载必要配置",
    "steps": [
      {
        "order": 1,
        "name": "OpenDatabase",
        "action": "打开或创建SQLite数据库文件，执行建表语句",
