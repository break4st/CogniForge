{
  "meta": {
    "doc_id": "lld-Web管理控制台-001",
    "type": "lld",
    "module_type": "frontend",
    "module": "Web管理控制台",
    "title": "Web管理控制台详细设计",
    "author": "design_agent",
    "created": "2026-05-22T00:00:00Z"
  },
  "overview": {
    "description": "用户交互界面，提供项目管理、环境配置、部署操作的可视化操作面板，采用 Vue 3 SPA 架构。用户通过浏览器访问，所有请求通过 API 网关转发至后端业务服务。实时日志通过 WebSocket 从部署引擎服务推送至前端。",
    "dependencies": ["API网关"],
    "tech_stack": ["Vue 3", "Element Plus", "REST", "WebSocket", "JWT"]
  },
  "data_models": [
    {
      "name": "AuthState",
      "type": "store",
      "ownership": "owned",
      "description": "全局认证状态，存储登录用户信息和 JWT token",
      "fields": [
        { "name": "token", "type": "string", "required": true, "description": "JWT 访问令牌" },
        { "name": "username", "type": "string", "required": true, "description": "当前登录用户名" },
        { "name": "role", "type": "string", "required": true, "description": "用户角色（admin/operator/viewer）" },
        { "name": "permissions", "type": "string[]", "required": true, "description": "权限标识列表" }
      ]
    },
    {
      "name": "AppState",
      "type": "store",
      "ownership": "owned",
      "description": "全局应用状态",
      "fields": [
        { "name": "sidebarCollapsed", "type": "boolean", "required": true, "description": "侧边栏是否收起" }
      ]
    },
    {
      "name": "ProjectSummary",
      "type": "struct",
      "ownership": "owned",
      "description": "项目列表项概要信息",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "description": "项目 ID" },
        { "name": "name", "type": "string", "required": true, "description": "项目名称" },
        { "name": "env_count", "type": "int", "required": true, "description": "已绑定的环境数量" },
        { "name": "last_deploy_status", "type": "string", "required": false, "description": "最近一次部署状态" }
      ]
    },
    {
      "name": "ProjectDetail",
      "type": "struct",
      "ownership": "owned",
      "description": "项目完整信息",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "description": "项目 ID" },
        { "name": "name", "type": "string", "required": true, "description": "项目名称" },
        { "name": "description", "type": "string", "required": true, "description": "项目描述" },
        { "name": "environments", "type": "uuid[]", "required": true, "description": "绑定的环境 ID 列表" },
        { "name": "created_at", "type": "datetime", "required": true, "description": "创建时间" }
      ]
    },
    {
      "name": "EnvironmentInfo",
      "type": "struct",
      "ownership": "owned",
      "description": "部署环境信息",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "description": "环境 ID" },
        { "name": "name", "type": "string", "required": true, "description": "环境名称" },
        { "name": "host", "type": "string", "required": true, "description": "服务器地址" },
        { "name": "port", "type": "int", "required": true, "description": "SSH 端口" },
        { "name": "status", "type": "string", "required": true, "description": "连接状态（online/offline/unknown）" }
      ]
    },
    {
      "name": "EnvironmentCreateForm",
      "type": "struct",
      "ownership": "owned",
      "description": "创建环境的表单数据",
      "fields": [
        { "name": "name", "type": "string", "required": true, "description": "环境名称" },
        { "name": "host", "type": "string", "required": true, "description": "服务器地址" },
        { "name": "port", "type": "int", "required": true, "description": "SSH 端口" },
        { "name": "login_user", "type": "string", "required": true, "description": "登录用户名" },
        { "name": "key_id", "type": "uuid", "required": true, "description": "绑定的 SSH 密钥 ID" }
      ]
    },
    {
      "name": "KeyInfo",
      "type": "struct",
      "ownership": "owned",
      "description": "SSH 密钥信息",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "description": "密钥 ID" },
        { "name": "name", "type": "string", "required": true, "description": "密钥名称" },
        { "name": "fingerprint", "type": "string", "required": true, "description": "密钥指纹" },
        { "name": "created_at", "type": "datetime", "required": true, "description": "创建时间" }
      ]
    },
    {
      "name": "DeployRequest",
      "type": "struct",
      "ownership": "owned",
      "description": "一键部署请求参数",
      "fields": [
        { "name": "project_id", "type": "uuid", "required": true, "description": "目标项目 ID" },
        { "name": "environment_id", "type": "uuid", "required": true, "description": "目标环境 ID" },
        { "name": "file_url", "type": "string", "required": true, "description": "待部署文件下载 URL" },
        { "name": "deploy_script", "type": "string", "required": true, "description": "部署执行脚本" }
      ]
    },
    {
      "name": "DeployResult",
      "type": "struct",
      "ownership": "owned",
      "description": "部署任务创建结果",
      "fields": [
        { "name": "deployment_id", "type": "uuid", "required": true, "description": "部署任务 ID" },
        { "name": "status", "type": "string", "required": true, "description": "初始状态" },
        { "name": "version", "type": "string", "required": true, "description": "本次部署版本号" }
      ]
    },
    {
      "name": "DeploymentRecord",
      "type": "struct",
      "ownership": "owned",
      "description": "部署任务完整记录",
      "fields": [
        { "name": "deployment_id", "type": "uuid", "required": true, "description": "部署任务 ID" },
        { "name": "project_id", "type": "uuid", "required": true, "description": "项目 ID" },
        { "name": "environment_id", "type": "uuid", "required": true, "description": "环境 ID" },
        { "name": "status", "type": "string", "required": true, "description": "部署状态" },
        { "name": "version", "type": "string", "required": true, "description": "版本号" },
        { "name": "started_at", "type": "datetime", "required": true, "description": "开始时间" },
        { "name": "finished_at", "type": "datetime", "required": false, "description": "完成时间" },
        { "name": "log_summary", "type": "string", "required": false, "description": "日志摘要" }
      ]
    },
    {
      "name": "DeployHistoryItem",
      "type": "struct",
      "ownership": "owned",
      "description": "部署历史列表项",
      "fields": [
        { "name": "deployment_id", "type": "uuid", "required": true, "description": "部署任务 ID" },
        { "name": "version", "type": "string", "required": true, "description": "版本号" },
        { "name": "environment_name", "type": "string", "required": true, "description": "环境名称" },
        { "name": "status", "type": "string", "required": true, "description": "部署状态" },
        { "name": "started_at", "type": "datetime", "required": true, "description": "开始时间" }
      ]
    },
    {
      "name": "AuditLogEntry",
      "type": "struct",
      "ownership": "owned",
      "description": "审计日志条目",
      "fields": [
        { "name": "id", "type": "uuid", "required": true, "description": "日志 ID" },
        { "name": "action", "type": "string", "required": true, "description": "操作动作" },
        { "name": "actor", "type": "string", "required": true, "description": "操作者" },
        { "name": "resource_type", "type": "string", "required": true, "description": "资源类型" },
        { "name": "detail", "type": "string", "required": true, "description": "操作详情" },
        { "name": "created_at", "type": "datetime", "required": true, "description": "操作时间" }
      ]
    },
    {
      "name": "Pagination",
      "type": "struct",
      "ownership": "owned",
      "description": "分页参数",
      "fields": [
        { "name": "page", "type": "int", "required": true, "description": "当前页码" },
        { "name": "page_size", "type": "int", "required": true, "description": "每页条数" },
        { "name": "total", "type": "int", "required": true, "description": "总记录数" }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "ProjectListPage",
      "method": "frontend",
      "endpoint": "/projects",
      "description": "项目列表页面，展示所有项目及其最近部署状态",
      "parameters": [
        { "name": "page", "type": "int", "description": "当前页码，URL query 参数" },
        { "name": "page_size", "type": "int", "description": "每页条数，URL query 参数" }
      ],
      "response": {
        "status": 200,
        "body": {
          "pageTitle": "string",
          "projects": "ProjectSummary[]",
          "pagination": "Pagination"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未登录，重定向至登录页" },
        { "code": 403, "message": "无权限访问" }
      ]
    },
    {
      "name": "ProjectDetailPage",
      "method": "frontend",
      "endpoint": "/projects/:id",
      "description": "项目详情页面，展示项目完整信息和绑定环境",
      "parameters": [
        { "name": "id", "type": "uuid", "description": "项目 ID，路由路径参数" }
      ],
      "response": {
        "status": 200,
        "body": {
          "project": "ProjectDetail",
          "environments": "EnvironmentInfo[]"
        }
      },
      "error_codes": [
        { "code": 404, "message": "项目不存在，展示空状态提示" }
      ]
    },
    {
      "name": "EnvironmentPage",
      "method": "frontend",
      "endpoint": "/environments",
      "description": "环境管理页面，展示所有部署环境及连接状态",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "pageTitle": "string",
          "environments": "EnvironmentInfo[]"
        }
      },
      "error_codes": []
    },
    {
      "name": "KeyManagementPage",
      "method": "frontend",
      "endpoint": "/keys",
      "description": "SSH密钥管理页面，展示已上传密钥列表",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "pageTitle": "string",
          "keys": "KeyInfo[]"
        }
      },
      "error_codes": []
    },
    {
      "name": "DeployPage",
      "method": "frontend",
      "endpoint": "/deploy",
      "description": "一键部署页面，提供部署表单和实时日志展示",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "pageTitle": "string",
          "deployResult": "DeployResult"
        }
      },
      "error_codes": []
    },
    {
      "name": "DeployHistoryPage",
      "method": "frontend",
      "endpoint": "/deployments",
      "description": "部署历史页面，按项目筛选查看历史部署记录",
      "parameters": [
        { "name": "project_id", "type": "uuid", "description": "项目 ID 筛选，URL query 参数" },
        { "name": "page", "type": "int", "description": "当前页码" },
        { "name": "page_size", "type": "int", "description": "每页条数" }
      ],
      "response": {
        "status": 200,
        "body": {
          "pageTitle": "string",
          "history": "DeployHistoryItem[]",
          "pagination": "Pagination"
        }
      },
      "error_codes": []
    },
    {
      "name": "AuditLogPage",
      "method": "frontend",
      "endpoint": "/audit",
      "description": "审计日志页面，支持按资源类型和时间范围筛选查询",
      "parameters": [
        { "name": "resource_type", "type": "string", "description": "资源类型筛选" },
        { "name": "page", "type": "int", "description": "当前页码" },
        { "name": "page_size", "type": "int", "description": "每页条数" }
      ],
      "response": {
        "status": 200,
        "body": {
          "pageTitle": "string",
          "logs": "AuditLogEntry[]",
          "pagination": "Pagination"
        }
      },
      "error_codes": []
    }
  ],
  "error_handling": {
    "strategy": "前端通过 Axios 拦截器统一捕获 HTTP 错误，根据状态码分类处理：4xx 展示用户可理解的错误提示，5xx 展示服务不可用提示并引导重试。WebSocket 断线自动重连，重连间隔指数退避（1s/2s/4s/8s，最大 30s）。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      { "code": 400, "name": "请求参数错误", "description": "表单校验未通过或参数非法，在表单字段旁展示具体错误信息" },
      { "code": 401, "name": "未授权", "description": "JWT token 过期或无效，清除本地 token 并重定向至登录页" },
      { "code": 403, "name": "权限不足", "description": "当前用户无操作权限，展示「无权限」提示弹窗" },
      { "code": 404, "name": "资源不存在", "description": "请求的资源不存在或已被删除，展示空状态占位图" },
      { "code": 409, "name": "资源冲突", "description": "创建/更新操作与其他资源冲突，展示冲突详情" },
      { "code": 422, "name": "表单校验错误", "description": "提交的数据校验失败，在表单字段下方展示具体错误信息" },
      { "code": 500, "name": "服务器内部错误", "description": "后端服务异常，展示「服务暂时不可用，请稍后重试」全局提示" },
      { "code": 502, "name": "网关错误", "description": "API 网关不可达或超时，展示「网络连接异常」提示" },
      { "code": 0, "name": "WebSocket 断线", "description": "实时日志连接断开，自动尝试重连并在界面展示「重新连接中…」状态" }
    ]
  },
  "component_tree": [
    {
      "name": "App",
      "path": "App.vue",
      "description": "根组件，挂载全局路由出口和全局状态初始化",
      "props": [],
      "events": [],
      "state": [],
      "behavior": [
        "应用启动时从 localStorage 恢复 JWT token 并初始化 AuthStore",
        "监听路由变化，动态更新页面标题"
      ],
      "edge_cases": [
        "token 过期时自动登出并跳转登录页"
      ],
      "children": [
        {
          "name": "DefaultLayout",
          "path": "layouts/DefaultLayout.vue",
          "description": "默认页面布局，包含侧边栏、顶部导航栏和内容区",
          "props": [],
          "events": [],
          "state": [
            { "name": "sidebarCollapsed", "type": "boolean", "description": "侧边栏是否收起，从 useAppStore 读取" }
          ],
          "behavior": [
            "挂载时初始化侧边栏菜单高亮项（根据当前路由）",
            "路由切换时自动关闭移动端侧边栏抽屉"
          ],
          "edge_cases": [
            "小屏设备自动收起侧边栏并切换为抽屉模式"
          ],
          "children": [
            {
              "name": "Sidebar",
              "path": "components/Sidebar.vue",
              "description": "左侧导航侧边栏，显示模块菜单项",
              "props": [
                { "name": "collapsed", "type": "boolean", "required": true, "description": "是否收起" }
              ],
              "events": [
                { "name": "menuSelect", "payload_type": "string" }
              ],
              "state": [
                { "name": "menuItems", "type": "MenuItem[]", "description": "导航菜单配置项" },
                { "name": "activeRoute", "type": "string", "description": "当前激活的路由路径" }
              ],
              "behavior": [
                "根据用户角色过滤菜单项（admin 可见所有菜单，operator 可见操作类菜单，viewer 仅可见列表页）",
                "点击菜单项触发 router.push 导航并高亮当前项"
              ],
              "edge_cases": [
                "无权限菜单项直接隐藏，不展示灰色不可点状态"
              ],
              "children": []
            },
            {
              "name": "Navbar",
              "path": "components/Navbar.vue",
              "description": "顶部导航栏，显示当前用户名和退出按钮",
              "props": [
                { "name": "username", "type": "string", "required": true, "description": "当前登录用户名" }
              ],
              "events": [
                { "name": "logout", "payload_type": "void" }
              ],
              "state": [
                { "name": "userMenuVisible", "type": "boolean", "description": "用户下拉菜单是否展开" }
              ],
              "behavior": [
                "点击用户头像展示下拉菜单（个人信息/退出登录）",
                "点击退出登录清除 AuthStore 并跳转登录页"
              ],
              "edge_cases": [],
              "children": []
            }
          ]
        },
        {
          "name": "ProjectListPage",
          "path": "pages/ProjectListPage.vue",
          "description": "项目列表页，展示所有项目卡片和分页",
          "props": [],
          "events": [],
          "state": [
            { "name": "projects", "type": "ProjectSummary[]", "description": "项目列表" },
            { "name": "pagination", "type": "Pagination", "description": "分页信息" },
            { "name": "loading", "type": "boolean", "description": "加载中状态" },
            { "name": "createDialogVisible", "type": "boolean", "description": "创建项目对话框可见性" }
          ],
          "behavior": [
            "mount 时调用 GET /api/projects?page=1&page_size=10 加载列表",
            "切换页码时重新请求对应页数据",
            "点击「新建项目」按钮打开 ProjectCreateDialog",
            "项目创建成功后关闭对话框并刷新列表",
            "项目删除成功后刷新列表"
          ],
          "edge_cases": [
            "列表为空时展示空状态插图：暂无项目，点击按钮创建第一个项目",
            "网络错误时展示重试按钮"
          ],
          "children": [
            {
              "name": "ProjectCreateDialog",
              "path": "components/ProjectCreateDialog.vue",
              "description": "新建项目对话框",
              "props": [
                { "name": "visible", "type": "boolean", "required": true, "description": "对话框是否显示" }
              ],
              "events": [
                { "name": "created", "payload_type": "ProjectSummary" },
                { "name": "close", "payload_type": "void" }
              ],
              "state": [
                { "name": "form", "type": "object", "description": "表单数据 { name: string, description: string }" },
                { "name": "submitting", "type": "boolean", "description": "提交中状态" },
                { "name": "rules", "type": "object", "description": "Element Plus 表单校验规则" }
              ],
              "behavior": [
                "打开时重置表单",
                "名称字段校验：必填、长度 1-50 字符、不允许特殊字符",
                "描述字段校验：可选、最大 200 字符",
                "提交时调用 POST /api/projects",
                "创建成功触发 created 事件并关闭对话框",
                "创建失败展示具体错误信息"
              ],
              "edge_cases": [
                "表单校验不通过时禁止提交并在对应字段下展示错误文字",
                "提交过程中重复点击按钮无效（submitting 状态禁用按钮）",
                "名称重复时后端返回 409，前端在名称字段下展示「该项目名称已存在」"
              ],
              "children": []
            },
            {
              "name": "ProjectCard",
              "path": "components/ProjectCard.vue",
              "description": "项目卡片，展示项目概要信息",
              "props": [
                { "name": "project", "type": "ProjectSummary", "required": true, "description": "项目概要信息" }
              ],
              "events": [
                { "name": "click", "payload_type": "uuid" },
                { "name": "delete", "payload_type": "uuid" }
              ],
              "state": [
                { "name": "deleting", "type": "boolean", "description": "删除中状态" }
              ],
              "behavior": [
                "点击卡片主体区域跳转至 /projects/{id} 详情页",
                "点击删除图标弹出确认框：「确定删除项目？」",
                "确认删除后调用 DELETE /api/projects/{id}",
                "删除成功后触发 delete 事件通知父组件刷新列表",
                "根据 last_deploy_status 展示状态标签颜色：success=绿色、failed=红色、running=蓝色"
              ],
              "edge_cases": [
                "删除确认框取消后不执行任何操作",
                "删除失败时展示错误提示，不清除卡片"
              ],
              "children": []
            }
          ]
        },
        {
          "name": "ProjectDetailPage",
          "path": "pages/ProjectDetailPage.vue",
          "description": "项目详情页，展示项目完整信息和绑定环境列表",
          "props": [],
          "events": [],
