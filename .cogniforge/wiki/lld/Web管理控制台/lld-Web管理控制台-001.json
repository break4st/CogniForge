{
  "meta": {
    "doc_id": "lld-Web管理控制台-001",
    "type": "lld",
    "module_type": "frontend",
    "module": "Web管理控制台",
    "title": "Web管理控制台详细设计文档",
    "author": "design_agent",
    "created": "2026-05-22T00:00:00Z"
  },
  "overview": {
    "description": "基于React+Ant Design的单页应用，提供部署系统的完整操作界面，整合项目管理、环境配置、一键部署、部署监控、版本回滚和审计日志等核心功能模块，作为用户与后端服务的唯一交互入口",
    "dependencies": [
      "API网关",
      "认证中间件"
    ],
    "tech_stack": [
      "React",
      "Ant Design",
      "JWT",
      "WebSocket"
    ]
  },
  "data_models": [
    {
      "name": "UserAuthStore",
      "type": "store",
      "ownership": "owned",
      "description": "用户认证与权限状态管理",
      "fields": [
        { "name": "token", "type": "string", "required": false, "description": "JWT token，空表示未登录" },
        { "name": "userInfo", "type": "object", "required": false, "description": "当前用户基本信息" },
        { "name": "roles", "type": "string[]", "required": false, "description": "用户角色列表" },
        { "name": "isAuthenticated", "type": "boolean", "required": true, "description": "是否已认证" }
      ]
    },
    {
      "name": "ProjectStore",
      "type": "store",
      "ownership": "owned",
      "description": "项目列表与当前项目上下文管理",
      "fields": [
        { "name": "projects", "type": "Project[]", "required": true, "description": "用户有权限的项目列表" },
        { "name": "currentProjectId", "type": "string", "required": false, "description": "当前选中项目ID" },
        { "name": "currentProject", "type": "object", "required": false, "description": "当前项目详情" },
        { "name": "loading", "type": "boolean", "required": true, "description": "项目列表加载状态" }
      ]
    },
    {
      "name": "DeployStore",
      "type": "store",
      "ownership": "owned",
      "description": "部署任务状态与进度管理",
      "fields": [
        { "name": "tasks", "type": "Map<string, DeployTask>", "required": true, "description": "部署任务映射（taskId → 任务详情）" },
        { "name": "activeTaskId", "type": "string", "required": false, "description": "当前活跃的部署任务ID" },
        { "name": "wsConnected", "type": "boolean", "required": true, "description": "WebSocket连接状态" }
      ]
    },
    {
      "name": "EnvironmentStore",
      "type": "store",
      "ownership": "owned",
      "description": "环境配置与SSH密钥管理",
      "fields": [
        { "name": "environments", "type": "Environment[]", "required": true, "description": "当前项目的环境列表" },
        { "name": "currentEnvId", "type": "string", "required": false, "description": "当前选中环境ID" },
        { "name": "loading", "type": "boolean", "required": true, "description": "环境列表加载状态" }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "PageDashboard",
      "method": "frontend",
      "endpoint": "/",
      "description": "仪表盘首页，展示部署概览统计和最近部署动态",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "project_count": "integer",
          "recent_deployments": "DeploymentSummary[]",
          "environment_stats": "object"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未认证，跳转登录页" },
        { "code": 403, "message": "无仪表盘访问权限" }
      ]
    },
    {
      "name": "PageProjectList",
      "method": "frontend",
      "endpoint": "/projects",
      "description": "项目管理页面，展示项目列表并支持项目的创建和编辑",
      "parameters": [
        { "name": "page", "type": "integer", "description": "当前页码" },
        { "name": "page_size", "type": "integer", "description": "每页条数" }
      ],
      "response": {
        "status": 200,
        "body": {
          "projects": "Project[]",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未认证，跳转登录页" },
        { "code": 403, "message": "无项目管理权限" }
      ]
    },
    {
      "name": "PageEnvironmentConfig",
      "method": "frontend",
      "endpoint": "/projects/:projectId/environments",
      "description": "环境配置页面，管理指定项目的部署环境及SSH密钥",
      "parameters": [
        { "name": "projectId", "type": "string (UUID)", "description": "项目标识" }
      ],
      "response": {
        "status": 200,
        "body": {
          "environments": "Environment[]",
          "project_name": "string"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未认证" },
        { "code": 403, "message": "无环境配置权限，仅admin可管理SSH密钥" },
        { "code": 404, "message": "项目不存在" }
      ]
    },
    {
      "name": "PageDeploy",
      "method": "frontend",
      "endpoint": "/projects/:projectId/deploy",
      "description": "一键部署页面，选择环境和文件触发部署任务",
      "parameters": [
        { "name": "projectId", "type": "string (UUID)", "description": "项目标识" }
      ],
      "response": {
        "status": 200,
        "body": {
          "environments": "Environment[]",
          "project_name": "string"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未认证" },
        { "code": 403, "message": "无部署权限" },
        { "code": 404, "message": "项目不存在" },
        { "code": 400, "message": "项目下无可用环境" }
      ]
    },
    {
      "name": "PageDeployProgress",
      "method": "frontend",
      "endpoint": "/projects/:projectId/deploy/:taskId",
      "description": "部署进度展示页面，显示实时进度、日志和结果",
      "parameters": [
        { "name": "projectId", "type": "string (UUID)", "description": "项目标识" },
        { "name": "taskId", "type": "string (UUID)", "description": "部署任务ID" }
      ],
      "response": {
        "status": 200,
        "body": {
          "task_id": "string (UUID)",
          "status": "string",
          "progress": "integer",
          "current_step": "string",
          "logs": "string[]",
          "version": "string"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未认证" },
        { "code": 404, "message": "部署任务不存在" }
      ]
    },
    {
      "name": "PageVersionHistory",
      "method": "frontend",
      "endpoint": "/projects/:projectId/history",
      "description": "部署历史页面，查询版本记录并支持回滚操作",
      "parameters": [
        { "name": "projectId", "type": "string (UUID)", "description": "项目标识" },
        { "name": "page", "type": "integer", "description": "页码" },
        { "name": "page_size", "type": "integer", "description": "每页条数" },
        { "name": "environment_id", "type": "string (UUID)", "description": "按环境筛选（可选）" }
      ],
      "response": {
        "status": 200,
        "body": {
          "versions": "VersionRecord[]",
          "total": "integer"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未认证" },
        { "code": 404, "message": "项目不存在" }
      ]
    },
    {
      "name": "PageAuditLog",
      "method": "frontend",
      "endpoint": "/audit-logs",
      "description": "审计日志查询页面，支持多维度筛选和查看操作记录",
      "parameters": [
        { "name": "page", "type": "integer", "description": "页码" },
        { "name": "page_size", "type": "integer", "description": "每页条数" },
        { "name": "start_time", "type": "string (ISO8601)", "description": "筛选起始时间" },
        { "name": "end_time", "type": "string (ISO8601)", "description": "筛选结束时间" },
        { "name": "operator", "type": "string", "description": "筛选操作人" },
        { "name": "action_type", "type": "string", "description": "筛选操作类型" }
      ],
      "response": {
        "status": 200,
        "body": {
          "logs": "AuditLogEntry[]",
          "total": "integer"
        }
      },
      "error_codes": [
        { "code": 401, "message": "未认证" },
        { "code": 403, "message": "无审计日志查看权限，仅admin可访问" }
      ]
    }
  ],
  "error_handling": {
    "strategy": "全局采用Ant Design notification + 内联错误提示的分层处理策略。API调用异常由统一拦截层捕获，401自动跳转登录页，403展示权限不足提示，4xx展示业务错误详情，5xx展示服务器错误并支持重试。表单验证错误以内联形式展示在对应字段下方。网络断开时展示断网提示条，恢复后自动隐藏。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      { "code": "401", "name": "认证失败", "description": "JWT token过期或无效，自动跳转到登录页，原路径存入localStorage以便登录后回跳" },
      { "code": "403", "name": "权限不足", "description": "用户角色无当前操作权限，展示权限不足提示，部分UI元素根据角色控制显隐" },
      { "code": "404", "name": "资源不存在", "description": "请求的项目/环境/部署任务不存在，展示空状态提示并返回列表页链接" },
      { "code": "422", "name": "参数校验失败", "description": "请求参数格式错误，表单字段内联展示具体错误信息" },
      { "code": "500", "name": "服务器错误", "description": "后端服务异常，展示通用错误页并提供「重试」按钮，自动上报错误信息" },
      { "code": "NETWORK", "name": "网络异常", "description": "前端检测到网络断开，展示全局断网提示条；恢复后自动隐藏并重新加载数据" },
      { "code": "TIMEOUT", "name": "请求超时", "description": "API请求超过30秒未响应，提示用户检查网络并支持重试" }
    ]
  },
  "component_tree": [
    {
      "name": "App",
      "path": "/",
      "description": "根组件，包含路由配置、全局状态Provider和错误边界",
      "props": [],
      "events": [],
      "state": [
        { "name": "isAuthenticated", "type": "boolean", "description": "用户认证状态，决定渲染登录页还是主应用" }
      ],
      "behavior": [
        "mount 时从localStorage读取JWT token并验证有效性",
        "token有效则初始化UserAuthStore并渲染主布局",
        "token无效或过期则渲染登录页",
        "全局未捕获异常由ErrorBoundary捕获并展示错误页"
      ],
      "edge_cases": [
        "token在应用使用中过期：下次API请求收到401，清除token并跳转登录页",
        "路由匹配失败：展示404页面并提供返回首页的链接",
        "空项目列表：展示引导创建项目的提示"
      ],
      "children": [
        {
          "name": "Layout",
          "path": "/",
          "description": "主布局容器，由顶部栏（含项目切换器）、侧边栏导航和路由内容区组成",
          "props": [],
          "events": [],
          "state": [
            { "name": "sidebarCollapsed", "type": "boolean", "description": "侧边栏折叠状态，持久化到localStorage" },
            { "name": "currentMenuKey", "type": "string", "description": "当前高亮菜单项key，根据路由自动匹配" }
          ],
          "behavior": [
            "mount 时从localStorage恢复sidebarCollapsed状态",
            "路由变化时自动更新currentMenuKey",
            "项目切换时重新加载侧边栏项目级菜单"
          ],
          "edge_cases": [
            "浏览器窗口宽度<768px时自动折叠侧边栏",
            "无当前选中项目时隐藏项目级菜单项（环境配置、部署、历史）"
          ],
          "children": [
            {
              "name": "ProjectSwitcher",
              "path": "/",
              "description": "顶部栏项目切换器下拉组件，展示用户有权限的所有项目并支持快速切换",
              "props": [
                { "name": "projects", "type": "Project[]", "required": true, "description": "用户有权限的项目列表" },
                { "name": "currentProjectId", "type": "string", "required": false, "description": "当前选中项目ID" }
              ],
              "events": [
                { "name": "onSwitch", "payload_type": "string (项目ID)" }
              ],
              "state": [
                { "name": "dropdownOpen", "type": "boolean", "description": "下拉菜单展开/收起状态" },
                { "name": "searchKeyword", "type": "string", "description": "项目搜索关键词" }
              ],
              "behavior": [
                "点击切换按钮展开项目下拉列表",
                "支持输入关键词过滤项目列表",
                "选择项目后触发onSwitch事件并收起下拉菜单",
                "切换项目后更新全局ProjectStore.currentProjectId"
              ],
              "edge_cases": [
                "仅有一个项目时自动选中不展示切换器",
                "项目名称过长时截断显示并tooltip展示全称",
                "搜索无结果时展示空状态提示",
                "项目列表加载失败时展示重试按钮"
              ]
            },
            {
              "name": "Sidebar",
              "path": "/",
              "description": "侧边栏导航组件，按权限动态展示菜单项",
              "props": [
                { "name": "collapsed", "type": "boolean", "required": true, "description": "折叠状态" },
                { "name": "projectId", "type": "string", "required": false, "description": "当前项目ID，决定是否展示项目级菜单" },
                { "name": "userRoles", "type": "string[]", "required": true, "description": "当前用户角色列表，控制菜单项显隐" }
              ],
              "events": [
                { "name": "onToggleCollapse", "payload_type": "void" }
              ],
              "state": [
                { "name": "menuItems", "type": "MenuItem[]", "description": "经过权限过滤后的菜单项列表" }
              ],
              "behavior": [
                "mount 时根据userRoles和projectId动态构建菜单项",
                "点击菜单项导航到对应路由并高亮当前项",
                "点击折叠按钮触发onToggleCollapse事件"
              ],
              "edge_cases": [
                "无项目时不展示项目级菜单组（环境配置、部署、历史）",
                "admin角色展示所有菜单项，operator不展示审计日志",
                "侧边栏折叠时只显示图标，hover展开子菜单"
              ]
            },
            {
              "name": "Dashboard",
              "path": "/",
              "description": "仪表盘首页，展示跨项目的部署概览统计信息和最近部署动态",
              "props": [],
              "events": [],
              "state": [
                { "name": "stats", "type": "object", "description": "部署统计数据（总项目数、总部署次数、成功率等）" },
                { "name": "recentDeployments", "type": "DeploymentSummary[]", "description": "最近5条部署记录" },
                { "name": "loading", "type": "boolean", "description": "数据加载状态" }
              ],
              "behavior": [
                "mount 时请求仪表盘统计数据和最近部署记录",
                "每30秒自动轮询刷新最近部署状态",
                "点击部署记录跳转到对应部署进度页"
              ],
              "edge_cases": [
                "首次加载无数据时展示空状态引导提示",
                "统计接口失败时展示部分加载状态，不影响其他模块",
                "自动轮询间隔内组件卸载时清除定时器"
              ]
            },
            {
              "name": "ProjectList",
              "path": "/projects",
              "description": "项目列表页面，以表格形式展示所有项目并支持搜索、创建和编辑",
              "props": [],
              "events": [
                { "name": "onSelectProject", "payload_type": "string (项目ID)" }
              ],
              "state": [
                { "name": "projects", "type": "Project[]", "description": "项目列表数据" },
                { "name": "total", "type": "integer", "description": "项目总数" },
                { "name": "page", "type": "integer", "description": "当前页码" },
                { "name": "pageSize", "type": "integer", "description": "每页条数" },
                { "name": "loading", "type": "boolean", "description": "加载状态" },
                { "name": "searchKeyword", "type": "string", "description": "搜索关键词" },
                { "name": "projectFormVisible", "type": "boolean", "description": "项目表单Modal显隐" },
                { "name": "editingProject", "type": "object", "description": "编辑中的项目数据，新建时为null" }
              ],
              "behavior": [
                "mount 时请求项目列表（第一页）",
                "页码/每页条数变化时重新请求",
                "搜索关键词变化时debounce 300ms后重新请求",
                "点击创建按钮打开ProjectForm（编辑模式为null）",
                "点击项目行进入项目详情或跳转部署页",
                "项目保存成功后关闭form并刷新列表"
              ],
              "edge_cases": [
                "搜索无结果时展示空状态和清除搜索的建议",
                "项目名过长时表格列截断加tooltip",
                "翻页到末页后删除最后一条数据自动回退到前一页"
              ]
            },
            {
              "name": "ProjectForm",
              "path": "/projects",
              "description": "项目创建/编辑表单Modal，包含项目名称、描述等字段",
              "props": [
                { "name": "visible", "type": "boolean", "required": true, "description": "Modal显隐状态" },
                { "name": "project", "type": "Project", "required": false, "description": "编辑模式时传入已有项目数据，新建时为null" },
                { "name": "onClose", "type": "() => void", "required": true, "description": "关闭Modal回调" },
                { "name": "onSaved", "type": "(project: Project) => void", "required": true, "description": "保存成功回调" }
              ],
              "events": [
                { "name": "onSave", "payload_type": "Project (表单数据)" },
                { "name": "onCancel", "payload_type": "void" }
              ],
              "state": [
                { "name": "submitting", "type": "boolean", "description": "提交中状态，防止重复提交" },
                { "name": "formErrors", "type": "object", "description": "表单字段校验错误信息" }
              ],
              "behavior": [
                "mount时根据project参数初始化表单（编辑模式回填数据）",
                "表单提交前执行字段校验（名称必填且唯一、描述长度限制）",
                "校验通过后调用项目创建/更新API",
                "提交完成后触发onSaved回调并关闭Modal"
              ],
              "edge_cases": [
                "项目名称已存在时展示后端返回的重复名称错误",
                "提交过程中网络中断时展示错误提示，保留表单数据",
                "表单未保存直接关闭时弹出确认提示"
              ]
            },
            {
              "name": "EnvironmentList",
              "path": "/projects/:projectId/environments",
              "description": "环境列表页面，展示指定项目的所有部署环境及其SSH密钥绑定状态",
              "props": [
                { "name": "projectId", "type": "string", "required": true, "description": "从路由参数获取的项目ID" }
              ],
              "events": [
                { "name": "onAddEnvironment", "payload_type": "void" },
                { "name": "onConfigureSSH", "payload_type": "string (环境ID)" }
              ],
              "state": [
                { "name": "environments", "type": "Environment[]", "description": "环境列表" },
                { "name": "loading", "type": "boolean", "description": "加载状态" },
                { "name": "envFormVisible", "type": "boolean", "description": "环境表单Modal显隐" },
                { "name": "sshConfigVisible", "type": "boolean", "description": "SSH密钥配置Modal显隐" },
                { "name": "selectedEnvId", "type": "string", "description": "选中编辑或配置SSH的环境ID" }
              ],
              "behavior": [
                "mount时根据projectId请求环境列表",
                "每个环境项展示环境名称、类型（测试/灰度/正式）、服务器地址、密钥绑定状态",
                "点击添加按钮打开EnvironmentForm",
                "点击SSH配置按钮打开SSHKeyConfig",
                "展示密钥有效性验证状态图标（已验证/未验证/验证失败）"
              ],
