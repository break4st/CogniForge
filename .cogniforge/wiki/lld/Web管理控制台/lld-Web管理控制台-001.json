      "method": "frontend",
      "endpoint": "/projects/create",
      "description": "提供项目创建表单，填写项目名称（必填）和描述后提交，提交后调用 POST /api/projects，创建成功跳转至项目列表页",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "参数校验失败（项目名称为必填）"
        },
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 409,
          "message": "项目名称已存在"
        }
      ]
    },
    {
      "name": "项目切换",
      "method": "frontend",
      "endpoint": "-（操作触发型）",
      "description": "用户在项目列表页点击项目卡片触发上下文切换，调用 POST /api/projects/{projectId}/switch，返回项目信息和关联环境列表，更新 ProjectStore.currentProject 和 EnvironmentStore",
      "parameters": [
        {
          "name": "projectId",
          "type": "integer",
          "description": "目标项目ID（POST /api/projects/{projectId}/switch）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 404,
          "message": "项目不存在"
        }
      ]
    },
    {
      "name": "项目环境管理页",
      "method": "frontend",
      "endpoint": "/projects/:projectId/environments",
      "description": "展示指定项目下的所有部署环境配置列表，支持查看环境详情和跳转至新建环境页。调用 API: GET /api/projects/{projectId}/environments",
      "parameters": [
        {
          "name": "projectId",
          "type": "integer",
          "description": "项目ID（路径参数）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "array"
        }
      },
      "error_codes": [
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 403,
          "message": "无权限访问该项目"
        },
        {
          "code": 404,
          "message": "项目不存在"
        }
      ]
    },
    {
      "name": "创建部署环境页",
      "method": "frontend",
      "endpoint": "/projects/:projectId/environments/create",
      "description": "提供部署环境创建表单，填写环境名称、服务器地址、SSH端口（必填）、部署路径并关联SSH密钥后提交。调用 API: POST /api/projects/{projectId}/environments",
      "parameters": [
        {
          "name": "projectId",
          "type": "integer",
          "description": "项目ID（路径参数）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "参数校验失败（环境名称/服务器地址/SSH端口/密钥ID为必填）"
        },
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 404,
          "message": "项目或关联密钥不存在"
        }
      ]
    },
    {
      "name": "SSH密钥管理页",
      "method": "frontend",
      "endpoint": "/keys",
      "description": "提供SSH密钥对上传界面，填写密钥名称、公钥和私钥内容后提交，密钥元数据在页面中展示。调用 API: POST /api/keys",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "参数校验失败（密钥名称/公钥/私钥为必填）"
        },
        {
          "code": 401,
          "message": "未登录或令牌过期"
        }
      ]
    },
    {
      "name": "部署触发页",
      "method": "frontend",
      "endpoint": "/projects/:projectId/deployments/create",
      "description": "提供一键部署触发界面，选择目标部署环境、部署包文件URL和版本号后提交，发起部署任务后跳转至部署进度页。调用 API: POST /api/deployments",
      "parameters": [
        {
          "name": "projectId",
          "type": "integer",
          "description": "项目ID（路径参数，传递给 POST /api/deployments 的 project_id）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "参数校验失败（项目ID/环境ID/文件URL为必填）"
        },
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 404,
          "message": "项目或环境不存在"
        }
      ]
    },
    {
      "name": "部署进度页",
      "method": "frontend",
      "endpoint": "/deployments/:deploymentId",
      "description": "实时展示部署任务进度。页面初始化时调用 GET /api/deployments/{deploymentId}/progress 获取当前进度，同时通过 WebSocket /ws/deployments/{deploymentId} 接收实时推送的 progress / log / complete / error 事件，更新 DeploymentStore",
      "parameters": [
        {
          "name": "deploymentId",
          "type": "integer",
          "description": "部署任务ID（路径参数）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 404,
          "message": "部署任务不存在"
        },
        {
          "code": "WS",
          "message": "WebSocket连接失败或断开"
        }
      ]
    },
    {
      "name": "部署历史页",
      "method": "frontend",
      "endpoint": "/projects/:projectId/deployments",
      "description": "展示指定项目的部署历史记录列表，支持按环境（environment_id）、部署状态（status）筛选和分页浏览。调用 API: GET /api/projects/{projectId}/deployments",
      "parameters": [
        {
          "name": "projectId",
          "type": "integer",
          "description": "项目ID（路径参数）"
        },
        {
          "name": "environment_id",
          "type": "integer",
          "description": "按环境筛选（传递给 GET /api/projects/{projectId}/deployments?environment_id=）"
        },
        {
          "name": "status",
          "type": "string",
          "description": "按状态筛选（传递给 GET /api/projects/{projectId}/deployments?status=）"
        },
        {
          "name": "page",
          "type": "integer",
          "description": "页码"
        },
        {
          "name": "size",
          "type": "integer",
          "description": "每页条数"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 404,
          "message": "项目不存在"
        }
      ]
    },
    {
      "name": "审计日志页",
      "method": "frontend",
      "endpoint": "/audit-logs",
      "description": "展示系统审计日志记录，支持按操作类型（action_type）、操作人（operator）、时间范围（start_time / end_time）筛选和分页浏览。调用 API: GET /api/audit-logs",
      "parameters": [
        {
          "name": "action_type",
          "type": "string",
          "description": "操作类型筛选"
        },
        {
          "name": "operator",
          "type": "string",
          "description": "操作人筛选"
        },
        {
          "name": "start_time",
          "type": "string",
          "description": "开始时间筛选"
        },
        {
          "name": "end_time",
          "type": "string",
          "description": "结束时间筛选"
        },
        {
          "name": "page",
          "type": "integer",
          "description": "页码"
        },
        {
          "name": "size",
          "type": "integer",
          "description": "每页条数"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 403,
          "message": "无审计日志访问权限"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "前端通过统一的HTTP响应拦截器捕获所有API错误，按HTTP状态码分类处理：4xx错误在UI中展示Ant Design Message组件提示用户可理解的错误信息；5xx错误展示「服务暂不可用，请稍后重试」；网络异常展示断网提示并支持恢复后自动刷新。表单级校验由Ant Design Form组件在客户端侧即时校验必填字段和格式，避免无效请求发送到后端。WebSocket连接采用指数退避重连策略，断连期间在页面上方展示连接状态提示条。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "前端表单提交前已进行Ant Design表单校验，后端返回400时在前端Message.error中展示具体错误信息"
      },
      {
        "code": "401",
        "name": "认证失败",
        "description": "用户未登录或JWT令牌过期，前端全局拦截器检测到401后跳转至登录页或触发令牌刷新"
      },
      {
        "code": "403",
        "name": "权限不足",
        "description": "当前用户无权限执行操作，前端展示无权限提示并禁用对应操作入口按钮"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "请求的目标资源不存在，页面加载时检测到404后展示Ant Design Empty空态或Result组件的404提示"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "创建资源时与已有资源冲突，在前端Message.warning中展示具体冲突原因"
      },
      {
        "code": "5xx",
        "name": "服务端错误",
        "description": "后端服务异常，前端统一展示「服务暂不可用，请稍后重试」，不暴露后端错误详情"
      },
      {
        "code": "WS",
        "name": "WebSocket连接异常",
        "description": "WebSocket连接断开或连接失败，前端自动采用指数退避策略重连（1s / 2s / 4s / 8s / 16s 最大30s），重连期间在页面顶部展示黄色提示条，重连成功后自动隐藏并重新同步进度数据"
      },
      {
        "code": "NETWORK",
        "name": "网络异常",
        "description": "浏览器请求超时或网络断开，前端监听window.online/offline事件，断网时展示全屏遮罩提示，网络恢复后自动刷新当前页面数据"
      }
    ]
  }
}
