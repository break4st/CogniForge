      "parameters": [
        {
          "name": "keyword",
          "type": "string",
          "description": "搜索关键字（传递给 GET /api/projects?keyword=）"
        },
        {
          "name": "page",
          "type": "integer",
          "description": "页码（传递给 GET /api/projects?page=）"
        },
        {
          "name": "size",
          "type": "integer",
          "description": "每页条数（传递给 GET /api/projects?size=）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "data": "object"
        }
      },
      "error_codes": [
        {
          "code": 401,
          "message": "未登录或令牌过期"
        },
        {
          "code": 403,
          "message": "无权限访问"
        }
      ]
    },
