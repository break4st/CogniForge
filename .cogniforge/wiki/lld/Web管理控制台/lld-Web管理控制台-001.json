{
  "meta": {
    "doc_id": "lld-Web管理控制台-001",
    "type": "lld",
    "module_type": "ModuleType.FRONTEND",
    "module": "Web管理控制台",
    "title": "LLD - Web管理控制台",
    "author": "design_agent",
    "created": "2026-05-21 10:59"
  },
  "overview": {
    "description": "基于React 18的SPA应用，使用Ant Design 5.x组件库构建，提供项目管理、部署环境配置、SSH密钥管理、一键部署触发与进度展示、部署历史查看、审计日志查询等可视化界面。通过WebSocket实时接收部署进度推送，采用组件化路由架构按业务域划分页面模块。",
    "dependencies": [
      "API网关",
      "项目管理服务",
      "环境管理服务",
      "密钥管理服务",
      "部署编排服务",
      "审计服务"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design 5.x"
    ]
  },
  "data_models": [
    {
      "name": "ProjectStore",
      "type": "store",
      "ownership": "owned",
      "description": "项目管理状态存储，维护项目列表分页数据、当前选中项目、搜索关键字等前端状态",
      "fields": [
        {
          "name": "projects",
          "type": "Array<object>",
          "required": true,
          "description": "项目列表数据（每项包含id、name、description等）"
        },
        {
          "name": "total",
          "type": "integer",
          "required": true,
          "description": "项目总数（用于分页）"
        },
        {
          "name": "page",
          "type": "integer",
          "required": true,
          "description": "当前页码"
        },
        {
          "name": "size",
          "type": "integer",
          "required": true,
          "description": "每页条数"
        },
        {
          "name": "keyword",
          "type": "string",
          "required": false,
          "description": "搜索关键字"
        },
        {
          "name": "currentProject",
          "type": "object | null",
          "required": false,
          "description": "当前选中的项目信息（含环境列表）"
        },
        {
          "name": "loading",
          "type": "boolean",
          "required": true,
          "description": "列表加载状态"
        }
      ]
    },
    {
      "name": "EnvironmentStore",
      "type": "store",
      "ownership": "owned",
      "description": "部署环境状态存储，维护当前项目下的环境配置列表",
      "fields": [
        {
          "name": "environments",
          "type": "Array<object>",
          "required": true,
          "description": "环境配置列表（每项包含id、name、server_host、server_port、deploy_path、key_id、key_name等）"
        },
        {
          "name": "loading",
          "type": "boolean",
          "required": true,
          "description": "环境列表加载状态"
        },
        {
          "name": "selectedEnv",
          "type": "object | null",
          "required": false,
          "description": "当前选中的部署环境"
        }
      ]
    },
    {
      "name": "SSHKeyStore",
      "type": "store",
      "ownership": "owned",
      "description": "SSH密钥管理状态存储",
      "fields": [
        {
          "name": "keyList",
          "type": "Array<object>",
          "required": true,
          "description": "已上传的密钥列表（每项包含id、name、fingerprint等）"
        },
        {
          "name": "uploading",
          "type": "boolean",
          "required": true,
          "description": "密钥上传中状态"
        }
      ]
    },
    {
      "name": "DeploymentStore",
      "type": "store",
      "ownership": "owned",
      "description": "部署任务状态存储，维护部署进度、WebSocket连接状态、部署历史等",
      "fields": [
        {
          "name": "currentDeployment",
          "type": "object | null",
          "required": false,
          "description": "当前进行中的部署任务信息（deployment_id、status等）"
        },
        {
          "name": "deploymentStatus",
          "type": "string | null",
          "required": false,
          "description": "当前部署任务状态（pending / running / completed / failed）"
        },
        {
          "name": "progress",
          "type": "integer",
          "required": false,
          "description": "当前部署进度百分比（0-100）"
        },
        {
          "name": "logs",
          "type": "Array<string>",
          "required": false,
          "description": "部署日志列表"
        },
        {
          "name": "wsConnected",
          "type": "boolean",
          "required": true,
          "description": "WebSocket连接状态"
        },
        {
          "name": "history",
          "type": "Array<object>",
          "required": true,
          "description": "部署历史列表（每项包含deployment_id、project_id、environment_id、status、version、created_at等）"
        },
        {
          "name": "historyTotal",
          "type": "integer",
          "required": true,
          "description": "部署历史总数"
        },
        {
          "name": "historyPage",
          "type": "integer",
          "required": true,
          "description": "历史记录当前页码"
        },
        {
          "name": "loading",
          "type": "boolean",
          "required": true,
          "description": "加载状态"
        }
      ]
    },
    {
      "name": "AuditLogStore",
      "type": "store",
      "ownership": "owned",
      "description": "审计日志查询状态存储",
      "fields": [
        {
          "name": "logs",
          "type": "Array<object>",
          "required": true,
          "description": "审计日志列表（每项包含id、action_type、operator、description、created_at等）"
        },
        {
          "name": "total",
          "type": "integer",
          "required": true,
          "description": "日志总数"
        },
        {
          "name": "page",
          "type": "integer",
          "required": true,
          "description": "当前页码"
        },
        {
          "name": "size",
          "type": "integer",
          "required": true,
          "description": "每页条数"
        },
        {
          "name": "filters",
          "type": "object",
          "required": false,
          "description": "查询筛选条件（action_type、operator、start_time、end_time）"
        },
        {
          "name": "loading",
          "type": "boolean",
          "required": true,
          "description": "加载状态"
        }
      ]
    }
  ],
  "interfaces": [
    {
