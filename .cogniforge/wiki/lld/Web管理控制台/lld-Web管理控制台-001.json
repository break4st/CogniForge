{
  "meta": {
    "doc_id": "lld-Web管理控制台-001",
    "type": "lld",
    "module": "Web管理控制台",
    "title": "LLD - Web管理控制台",
    "author": "design_agent",
    "created": "2026-05-20 16:27"
  },
  "overview": {
    "description": "用户交互界面，提供项目管理、环境配置、部署操作和状态查看等功能。作为系统的展示层，通过API网关与后端业务服务通信，并通过WebSocket接收实时部署进度推送。采用前后端分离的单页应用架构。",
    "dependencies": ["API网关", "文件存储", "部署编排服务"],
    "tech_stack": ["Vue 3", "TypeScript", "Pinia（状态管理）", "Vue Router", "WebSocket", "SCSS"]
  },
  "data_models": [
    {
      "name": "Project",
      "type": "interface",
      "description": "项目信息",
      "fields": [
        {"name": "id", "type": "number", "required": true, "description": "项目唯一标识"},
        {"name": "name", "type": "string", "required": true, "description": "项目名称"},
        {"name": "description", "type": "string", "required": false, "description": "项目描述"},
        {"name": "created_at", "type": "string", "required": true, "description": "创建时间（ISO 8601）"}
      ]
    },
    {
      "name": "Environment",
      "type": "interface",
      "description": "部署环境信息",
      "fields": [
        {"name": "id", "type": "number", "required": true, "description": "环境唯一标识"},
        {"name": "project_id", "type": "number", "required": true, "description": "所属项目ID"},
        {"name": "name", "type": "string", "required": true, "description": "环境名称"},
        {"name": "type", "type": "string", "required": true, "description": "环境类型：test/staging/production"},
        {"name": "host", "type": "string", "required": true, "description": "远程服务器地址"},
        {"name": "port", "type": "number", "required": true, "description": "SSH端口"},
        {"name": "status", "type": "string", "required": true, "description": "连接状态：connected/disconnected/unknown"},
        {"name": "created_at", "type": "string", "required": false, "description": "创建时间"}
      ]
    },
    {
      "name": "EnvironmentForm",
      "type": "interface",
      "description": "环境创建/编辑表单数据（不含返回的id和status）",
      "fields": [
        {"name": "project_id", "type": "number", "required": true, "description": "所属项目ID"},
        {"name": "name", "type": "string", "required": true, "description": "环境名称"},
        {"name": "type", "type": "string", "required": true, "description": "环境类型"},
        {"name": "host", "type": "string", "required": true, "description": "远程服务器地址"},
        {"name": "port", "type": "number", "required": true, "description": "SSH端口"},
        {"name": "ssh_key", "type": "string", "required": true, "description": "SSH密钥内容（加密传输）"},
        {"name": "username", "type": "string", "required": true, "description": "SSH登录用户名"}
      ]
    },
    {
      "name": "DeploymentRecord",
      "type": "interface",
      "description": "部署任务记录",
      "fields": [
        {"name": "deployment_id", "type": "number", "required": true, "description": "部署任务ID"},
        {"name": "project_id", "type": "number", "required": true, "description": "项目ID"},
        {"name": "environment_id", "type": "number", "required": true, "description": "目标环境ID"},
        {"name": "version", "type": "string", "required": true, "description": "部署版本号"},
        {"name": "status", "type": "string", "required": true, "description": "状态：pending/running/success/failed"},
        {"name": "created_at", "type": "string", "required": true, "description": "创建时间"},
        {"name": "completed_at", "type": "string", "required": false, "description": "完成时间"}
      ]
    },
    {
      "name": "DeploymentStatus",
      "type": "interface",
      "description": "部署实时状态（WebSocket推送及状态轮询）",
      "fields": [
        {"name": "deployment_id", "type": "number", "required": true, "description": "部署任务ID"},
        {"name": "status", "type": "string", "required": true, "description": "当前状态：running/success/failed"},
        {"name": "progress", "type": "number", "required": true, "description": "进度百分比0-100"},
        {"name": "current_step", "type": "string", "required": true, "description": "当前执行步骤描述"},
        {"name": "logs", "type": "array<string>", "required": true, "description": "部署日志行列表"}
      ]
    },
    {
      "name": "FileUploadResult",
      "type": "interface",
      "description": "文件上传结果",
      "fields": [
        {"name": "file_id", "type": "number", "required": true, "description": "文件唯一标识"},
        {"name": "file_url", "type": "string", "required": true, "description": "文件访问URL"},
        {"name": "file_size", "type": "number", "required": true, "description": "文件大小（字节）"},
        {"name": "md5", "type": "string", "required": true, "description": "文件MD5校验值"}
      ]
    },
    {
      "name": "PaginatedResponse",
      "type": "interface",
      "description": "通用分页响应结构",
      "fields": [
        {"name": "items", "type": "array<object>", "required": true, "description": "数据项列表"},
        {"name": "total", "type": "number", "required": true, "description": "总记录数"},
        {"name": "page", "type": "number", "required": true, "description": "当前页码"},
        {"name": "page_size", "type": "number", "required": false, "description": "每页条数"}
      ]
    },
    {
      "name": "WebSocketEvent",
      "type": "interface",
      "description": "WebSocket推送事件结构",
      "fields": [
        {"name": "event", "type": "string", "required": true, "description": "事件类型：progress/log/complete"},
        {"name": "data", "type": "object", "required": true, "description": "事件数据，progress含step/percentage，log含message/level，complete含status/summary"}
      ]
    },
    {
      "name": "AppStore",
      "type": "store",
      "description": "前端全局状态管理",
      "fields": [
        {"name": "currentProject", "type": "Project | null", "required": false, "description": "当前选中的项目"},
        {"name": "projectList", "type": "Project[]", "required": true, "description": "项目列表"},
        {"name": "environmentList", "type": "Environment[]", "required": true, "description": "当前项目的环境列表"},
        {"name": "activeDeployments", "type": "Map<number, DeploymentStatus>", "required": true, "description": "进行中的部署任务状态映射"},
        {"name": "loading", "type": "Record<string, boolean>", "required": true, "description": "各模块加载状态"},
        {"name": "error", "type": "string | null", "required": false, "description": "全局错误信息"}
      ]
    },
    {
      "name": "ApiError",
      "type": "interface",
      "description": "API错误响应结构",
      "fields": [
        {"name": "code", "type": "number", "required": true, "description": "HTTP状态码"},
        {"name": "message", "type": "string", "required": true, "description": "错误描述"},
        {"name": "details", "type": "string", "required": false, "description": "详细错误信息"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "项目列表页",
      "method": "frontend",
      "endpoint": "/projects",
      "description": "展示所有项目列表，支持分页浏览，提供创建项目入口",
      "parameters": [
        {"name": "page", "type": "number", "description": "当前页码，默认1"},
        {"name": "page_size", "type": "number", "description": "每页条数，默认10"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array<Project>",
          "total": "number",
          "page": "number"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未登录或登录已过期"},
        {"code": 403, "message": "无权限查看项目列表"}
      ]
    },
    {
      "name": "创建项目页",
      "method": "frontend",
      "endpoint": "/projects/create",
      "description": "提供表单填写项目名称和描述，提交后调用项目管理服务创建项目",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "id": "number",
          "name": "string",
          "description": "string",
          "created_at": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "表单验证失败（项目名称为必填）"},
        {"code": 409, "message": "项目名称已存在"}
      ]
    },
    {
      "name": "项目详情页",
      "method": "frontend",
      "endpoint": "/projects/:id",
      "description": "展示单个项目的详细信息，包括关联的环境列表和部署历史概览",
      "parameters": [
        {"name": "id", "type": "number", "description": "项目ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "number",
          "name": "string",
          "description": "string",
          "created_at": "string"
        }
      },
      "error_codes": [
        {"code": 404, "message": "项目不存在"},
        {"code": 403, "message": "无权限查看该项目"}
      ]
    },
    {
      "name": "环境列表页",
      "method": "frontend",
      "endpoint": "/projects/:id/environments",
      "description": "管理指定项目的部署环境，展示环境列表和连接状态，提供添加/编辑/删除操作",
      "parameters": [
        {"name": "id", "type": "number", "description": "项目ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "environments": "array<Environment>"
        }
      },
      "error_codes": [
        {"code": 404, "message": "项目不存在"},
        {"code": 403, "message": "无权限管理环境"}
      ]
    },
    {
      "name": "创建环境页",
      "method": "frontend",
      "endpoint": "/projects/:id/environments/create",
      "description": "提供环境配置表单（名称、类型、主机、端口、SSH密钥、用户名），提交后创建环境并测试连接",
      "parameters": [
        {"name": "id", "type": "number", "description": "项目ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "number",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "number",
          "status": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "表单验证失败（必填项缺失或格式错误）"},
        {"code": 422, "message": "SSH连接测试失败（主机不可达或密钥无效）"}
      ]
    },
    {
      "name": "部署执行页",
      "method": "frontend",
      "endpoint": "/projects/:id/deploy",
      "description": "部署操作主页面。选择目标环境、上传可执行文件、填写版本号和部署脚本，触发一键部署",
      "parameters": [
        {"name": "id", "type": "number", "description": "项目ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "environments": "array<Environment>"
        }
      },
      "error_codes": [
        {"code": 400, "message": "部署参数验证失败"},
        {"code": 404, "message": "项目或环境不存在"},
        {"code": 413, "message": "上传文件超过大小限制"}
      ]
    },
    {
      "name": "部署进度页",
      "method": "frontend",
      "endpoint": "/deployments/:id",
      "description": "展示单次部署的实时进度、步骤详情和日志输出，通过WebSocket实时更新状态",
      "parameters": [
        {"name": "id", "type": "number", "description": "部署任务ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "number",
          "status": "string",
          "progress": "number",
          "current_step": "string",
          "logs": "array<string>"
        }
      },
      "error_codes": [
        {"code": 404, "message": "部署任务不存在"},
        {"code": 410, "message": "部署任务已过期或已被清理"}
      ]
    },
    {
      "name": "部署历史页",
      "method": "frontend",
      "endpoint": "/projects/:id/history",
      "description": "按项目分页查看部署历史记录，展示每次部署的版本、环境、状态和时间",
      "parameters": [
        {"name": "id", "type": "number", "description": "项目ID（路径参数）"},
        {"name": "page", "type": "number", "description": "当前页码，默认1"},
        {"name": "page_size", "type": "number", "description": "每页条数，默认10"},
        {"name": "environment_id", "type": "number", "description": "按环境筛选（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array<DeploymentRecord>",
          "total": "number",
          "page": "number",
          "page_size": "number"
        }
      },
      "error_codes": [
        {"code": 404, "message": "项目不存在"},
        {"code": 403, "message": "无权限查看部署历史"}
      ]
    }
  ],
  "error_handling": "前端统一错误处理策略：1）所有API请求通过axios拦截器统一捕获HTTP错误，4xx错误展示用户友好的提示消息，5xx错误展示'服务器异常，请稍后重试'；2）网络断连时展示断网提示条，自动重连后恢复；3）表单提交前进行字段校验（必填项、格式、范围），校验不通过时在表单项旁展示具体错误文案；4）WebSocket连接异常时自动重连，指数退避（1s/2s/4s/8s，最大30s），重连期间展示'连接中...'状态提示；5）文件上传进度条展示实时上传百分比，上传失败保留已填表单数据并提供重新上传按钮；6）全局错误边界（ErrorBoundary）捕获未预期组件异常，避免白屏，展示'页面出错了，请刷新重试'。"
}
