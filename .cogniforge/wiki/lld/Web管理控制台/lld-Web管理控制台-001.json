                  ]
                },
                {
                  "name": "AuditLogTable",
                  "path": "/audit-logs",
                  "description": "审计日志表格组件，展示日志条目并支持排序和分页",
                  "props": [
                    { "name": "logs", "type": "AuditLogEntry[]", "required": true, "description": "日志条目数据" },
                    { "name": "loading", "type": "boolean", "required": true, "description": "加载状态" },
                    { "name": "total", "type": "integer", "required": true, "description": "总条数" },
                    { "name": "page", "type": "integer", "required": true, "description": "当前页码" },
                    { "name": "pageSize", "type": "integer", "required": true, "description": "每页条数" }
                  ],
                  "events": [
                    { "name": "onPageChange", "payload_type": "object {page, pageSize}" },
                    { "name": "onSort", "payload_type": "object {column, order}" }
                  ],
                  "state": [
                    { "name": "sortedColumn", "type": "string", "description": "当前排序列" },
                    { "name": "sortOrder", "type": "string", "description": "排序方向（ascend/descend）" },
                    { "name": "expandedRow", "type": "string", "description": "展开的行ID，查看完整详情" }
                  ],
                  "behavior": [
                    "表格列：时间戳、操作人、操作类型、操作对象、结果、来源IP",
                    "结果列以标签样式展示（success绿色/failure红色）",
                    "支持点击行展开查看完整详情",
                    "支持按时间戳列排序",
                    "分页变化时触发onPageChange事件"
                  ],
                  "edge_cases": [
                    "日志条目超过100页时隐藏超出页码以保持性能",
                    "单行详情过长时限制最大高度并启用内部滚动",
                    "表格数据为空时展示空状态插槽"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "state_design": {
    "global": [
      {
        "name": "UserAuthStore",
        "type": "GlobalStore",
        "description": "全局认证状态，包含JWT token、用户信息和角色列表，应用初始化时加载，token过期时清空",
        "consumers": ["App", "Layout", "Sidebar", "AuditLogPage", "ProjectList"]
      },
      {
        "name": "ProjectStore",
        "type": "GlobalStore",
        "description": "全局项目上下文，包含项目列表和当前选中项目ID，项目切换时更新全局状态",
        "consumers": ["Layout", "ProjectSwitcher", "Sidebar", "EnvironmentList", "DeployForm", "VersionHistory"]
      },
      {
        "name": "DeployStore",
        "type": "GlobalStore",
        "description": "全局部署任务状态映射，部署进度页启动时写入，Dashboard和进度页读取轮询结果",
        "consumers": ["Dashboard", "DeployProgress", "DeployForm"]
      }
    ],
    "caching_strategy": "用户认证信息（token+角色）持久化到localStorage，页面刷新后自动恢复。项目列表缓存5分钟，切换项目时失效。部署日志仅保存在运行时DeployStore中，页面刷新后重新请求。环境列表缓存2分钟，且在当前项目ID不变时复用。审计日志不做前端缓存，每次查询重新请求。侧边栏折叠状态持久化到localStorage。"
  },
  "route_design": [
