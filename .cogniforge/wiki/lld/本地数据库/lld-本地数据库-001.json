    {
      "id": "DM-004",
      "name": "部署记录表 (DeploymentRecord)",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "存储每次部署的历史记录，包括部署时间、状态、日志输出等，关联到环境。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "记录唯一标识"
        },
        {
          "name": "environment_id",
          "type": "INTEGER NOT NULL",
          "required": true,
          "description": "部署的目标环境ID"
        },
        {
          "name": "deploy_time",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "status",
          "type": "TEXT CHECK(status IN ('pending','running','success','failed'))",
          "required": true,
          "description": "部署状态"
        },
        {
          "name": "log_output",
          "type": "TEXT",
          "required": false,
          "description": "部署过程的控制台日志"
        },
        {
          "name": "commit_hash",
          "type": "TEXT",
          "required": false,
          "description": "对应的代码仓库提交哈希"
        },
        {
          "name": "created_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
