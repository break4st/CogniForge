  "interfaces": [
    {
      "id": "IF-001",
      "name": "数据库访问接口",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "TypeORM Repository API + Transaction API",
      "description": "基于 TypeORM 的 Repository API 提供的数据库访问接口，封装了对所有数据模型的 CRUD 操作和事务管理能力。供上层业务模块通过依赖注入调用。",
      "parameters": [],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "repository": "TypeORM.Repository<Entity>",
          "methods": [
            "find(options?: FindManyOptions<Entity>): Promise<Entity[]>",
            "findOne(options?: FindOneOptions<Entity>): Promise<Entity | undefined>",
            "save(entity: DeepPartial<Entity>): Promise<Entity>",
            "delete(criteria: DeleteCriteria): Promise<DeleteResult>",
            "create(entityLike: DeepPartial<Entity>): Entity",
            "merge(mergeIntoEntity: Entity, ...entityLikes: DeepPartial<Entity>[]): Entity"
          ],
          "transaction": "manager.transaction(runInTransaction: (entityManager: EntityManager) => Promise<any>)"
        }
      },
      "error_codes": [
        {
          "status": 500,
          "code": "DB_INSERT_ERROR",
          "message": "插入数据失败，可能是唯一约束冲突或字段类型不匹配。"
        },
        {
          "status": 500,
          "code": "DB_QUERY_ERROR",
          "message": "查询数据失败，可能是数据库连接异常或 SQL 语法错误。"
        },
        {
          "status": 500,
          "code": "DB_TRANSACTION_ERROR",
          "message": "事务执行失败，已自动回滚。"
        }
      ],
