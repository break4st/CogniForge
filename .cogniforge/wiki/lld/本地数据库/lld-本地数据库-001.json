    {
      "id": "DM-003",
      "name": "密钥表 (Key)",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "存储加密后的SSH密钥或其他凭据，关联到环境或全局使用。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "密钥唯一标识"
        },
        {
          "name": "name",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "密钥标识名称"
        },
        {
          "name": "encrypted_private_key",
          "type": "TEXT",
          "required": false,
          "description": "加密后的私钥内容"
        },
        {
          "name": "public_key",
          "type": "TEXT",
          "required": false,
          "description": "公钥内容"
        },
        {
          "name": "passphrase_encrypted",
          "type": "TEXT",
          "required": false,
          "description": "可选，加密后的口令"
        },
        {
          "name": "type",
          "type": "TEXT CHECK(type IN ('ssh','token','password'))",
          "required": true,
          "description": "密钥类型"
        },
        {
          "name": "environment_id",
          "type": "INTEGER",
          "required": false,
          "description": "关联的环境ID，可空表示全局或未绑定"
        },
        {
          "name": "created_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
