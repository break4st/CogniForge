    {
      "id": "DM-005",
      "name": "文件清单表 (FileManifest)",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "存储每次部署涉及的文件列表，包括文件路径、大小、校验和等信息，关联到部署记录。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "文件记录唯一标识"
        },
        {
          "name": "deployment_record_id",
          "type": "INTEGER NOT NULL",
          "required": true,
          "description": "所属部署记录ID"
        },
        {
          "name": "file_path",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "文件在项目中的相对路径"
        },
        {
          "name": "file_size",
          "type": "INTEGER",
          "required": false,
          "description": "文件大小（字节）"
        },
        {
          "name": "checksum",
          "type": "TEXT",
          "required": false,
          "description": "文件校验和 (SHA256)"
        },
        {
          "name": "status",
          "type": "TEXT CHECK(status IN ('transferred','skipped','failed'))",
          "required": false,
          "description": "文件传输状态"
        },
        {
          "name": "created_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "创建时间"
        }
      ],
      "indexes": [
