  "data_models": [
    {
      "id": "DM-001",
      "name": "项目表 (Project)",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "存储项目的基本信息，包括名称、描述、创建和更新时间。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "项目唯一标识"
        },
        {
          "name": "name",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "TEXT",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_project_name",
          "unique": true,
          "columns": [
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-007"
      ],
      "source_contracts": [
        "CTR-007"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "INSERT INTO project ...",
        "update": "UPDATE project ...",
        "delete": "DELETE FROM project WHERE id=? (级联删除关联环境?)",
        "retention": "永久保留，无自动清理"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "环境表 (Environment)",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "存储项目的部署环境信息，如环境名称、主机地址、端口等，关联到项目。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "环境唯一标识"
        },
        {
          "name": "project_id",
          "type": "INTEGER NOT NULL",
          "required": true,
          "description": "所属项目ID，外键关联 project.id"
        },
        {
          "name": "name",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "环境名称，如 'production', 'staging'"
        },
        {
          "name": "host",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "目标主机地址"
        },
        {
          "name": "port",
          "type": "INTEGER",
          "required": false,
          "description": "SSH 端口或其他通信端口"
        },
        {
          "name": "deploy_path",
          "type": "TEXT",
          "required": false,
          "description": "部署路径"
        },
        {
          "name": "created_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_environment_project_id",
          "unique": false,
          "columns": [
            "project_id"
          ]
        },
        {
          "name": "idx_environment_name_project",
          "unique": true,
          "columns": [
            "name",
            "project_id"
          ]
        }
