  "error_handling": {
    "strategy": "网关统一捕获所有错误，返回标准 JSON 格式 {code, message}。",
    "error_codes": [
      {
        "code": 400,
        "message": "请求参数错误"
      },
      {
        "code": 401,
        "message": "认证失败"
      },
      {
        "code": 403,
        "message": "权限不足"
      },
      {
        "code": 404,
        "message": "资源不存在"
      },
      {
        "code": 429,
        "message": "请求过多，触发限流"
      },
