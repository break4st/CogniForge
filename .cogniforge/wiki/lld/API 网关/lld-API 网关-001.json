      "id": "DM-003",
      "name": "限流策略模型",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Gateway-001",
        "model_name": "限流策略表"
      },
      "description": "定义全局、用户级别或特定端点的限流规则，包含速率限制、突发容量、时间窗口等参数。",
      "fields": [
        {
          "name": "id",
          "type": "string (UUID)",
          "required": true,
          "description": "限流策略唯一标识符"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "策略名称，如 'rate-limiting-basic'"
        },
        {
          "name": "type",
          "type": "enum('global', 'user', 'endpoint')",
          "required": true,
          "description": "策略类型：全局、用户级别、特定端点"
        },
        {
          "name": "target",
          "type": "string",
