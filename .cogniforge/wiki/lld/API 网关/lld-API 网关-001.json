  "data_models": [
    {
      "id": "DM-001",
      "name": "路由规则模型",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Gateway-001",
        "model_name": "路由规则表"
      },
      "description": "定义将外部请求映射到上游服务的路由表条目，包含路径模式、目标服务地址、超时等属性。",
      "fields": [
        {
          "name": "id",
          "type": "string (UUID)",
          "required": true,
          "description": "路由规则唯一标识符"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "路由规则名称，便于识别"
        },
        {
          "name": "path_pattern",
          "type": "string",
          "required": true,
          "description": "请求路径匹配模式，如 /api/v1/projects/*"
        },
        {
          "name": "methods",
          "type": "array of string",
          "required": false,
          "description": "允许的HTTP方法列表，如 [\"GET\",\"POST\"]；为空表示所有方法"
        },
        {
          "name": "upstream_host",
          "type": "string",
          "required": true,
          "description": "上游服务主机地址，如 project-service"
        },
        {
          "name": "upstream_port",
          "type": "integer",
          "required": false,
          "description": "上游服务端口号，默认80"
        },
        {
          "name": "upstream_path",
          "type": "string",
          "required": false,
          "description": "转发到上游时重写的路径，可选，默认为原始路径"
        },
        {
          "name": "timeout_ms",
          "type": "integer",
          "required": false,
          "description": "上游连接超时时间（毫秒），默认60000"
        },
        {
          "name": "retries",
          "type": "integer",
          "required": false,
          "description": "失败重试次数，默认0"
        },
        {
          "name": "strip_path",
          "type": "boolean",
          "required": false,
          "description": "转发前是否去除匹配的前缀路径，默认true"
        },
        {
          "name": "enabled",
          "type": "boolean",
          "required": true,
          "description": "路由是否启用，默认true"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_route_path_pattern",
          "unique": true,
          "columns": ["path_pattern"]
        },
        {
          "name": "idx_route_name",
          "unique": true,
          "columns": ["name"]
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "通过网关管理接口或配置文件创建路由规则",
        "update": "通过网关管理接口更新规则属性",
        "delete": "通过网关管理接口删除路由规则",
        "retention": "长期存储，与运行配置一致"
      },
      "source_requirements": ["REQ-001"],
      "source_components": ["CMP-001"],
      "source_contracts": [],
