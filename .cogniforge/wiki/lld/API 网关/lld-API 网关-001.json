  "data_models": [
    {
      "id": "DM-001",
      "name": "JWTClaims",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "JWT Token 载荷结构，网关在验证 Token 后从中提取授权信息，不持久化存储。",
      "fields": [
        {
          "name": "user_id",
          "type": "string",
          "required": true,
          "description": "用户唯一标识"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "用户名"
        },
        {
          "name": "roles",
          "type": "[]string",
          "required": true,
          "description": "角色列表"
        },
        {
          "name": "exp",
          "type": "int64",
          "required": true,
          "description": "过期时间戳"
        },
        {
          "name": "iat",
          "type": "int64",
          "required": true,
          "description": "签发时间戳"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "登录或刷新 Token 时由用户服务签发",
        "update": "",
        "delete": "",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "RouteRule",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "路由规则配置模型，定义路径模式、上游服务地址、所需角色、限流类型等。支持热加载。",
      "fields": [
        {
          "name": "pattern",
          "type": "string",
          "required": true,
          "description": "匹配路径模式，如 /api/projects/**"
        },
        {
          "name": "upstream",
          "type": "string",
          "required": true,
          "description": "上游服务地址，如 http://project-env-service:8080"
        },
        {
          "name": "methods",
          "type": "[]string",
          "required": true,
          "description": "允许的 HTTP 方法"
        },
        {
          "name": "required_roles",
          "type": "[]string",
          "required": false,
          "description": "访问所需角色列表，空表示仅需认证"
        },
        {
          "name": "rate_limit_type",
          "type": "string",
          "required": true,
          "description": "限流类型：global、per_user、none"
        },
        {
          "name": "auth_required",
          "type": "boolean",
          "required": true,
          "description": "是否需要认证"
        },
        {
          "name": "ws_upgrade",
          "type": "boolean",
          "required": true,
          "description": "是否支持 WebSocket 升级"
        },
        {
          "name": "description",
          "type": "string",
          "required": true,
          "description": "路由说明"
        }
      ],
      "source_requirements": [
        "REQ-001"
