    "owned_components": ["CMP-001"],
    "owned_contracts": [],
    "consumed_contracts": ["CTR-001", "CTR-002", "CTR-004", "CTR-005"],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "系统统一流量入口，负责请求认证（JWT验证）、根据URL路径将请求路由至对应的下游微服务（项目管理服务、环境管理服务、部署编排服务等），提供基础限流和访问控制，并将前端WebSocket连接代理至部署编排服务的实时日志流，同时记录请求访问日志供审计。",
    "dependencies": [
      "项目管理服务 (CMP-003)",
      "环境管理服务 (CMP-004)",
      "部署编排服务 (CMP-006)",
      "日志与审计服务 (CMP-007)"
    ],
    "tech_stack": [
      "Nginx + Lua/OpenResty (或 Kong)"
    ]
  },
