  "module_boundary": {
    "in_scope": [
      "请求认证 (JWT 验证)",
      "路由转发 (REST + WebSocket)",
      "限流控制",
      "WebSocket 代理至部署编排服务实时日志",
      "请求访问日志记录"
    ],
    "out_of_scope": [
      "JWT 签发 (由认证服务负责)",
      "业务逻辑处理",
      "数据库直接操作",
      "用户管理",
      "项目管理",
      "环境管理",
      "密钥管理",
      "部署编排",
      "日志审计存储"
