  "module_boundary": {
    "in_scope": [
      "统一入口接收所有 HTTP/HTTPS 和 WebSocket 请求",
      "请求路由转发至后端微服务",
      "JWT 认证与鉴权，提取用户标识和角色",
      "全局、每用户、特殊端点三级流量限制",
      "WebSocket 升级与代理，实时日志推送",
      "SSL 终结（前置 Nginx 完成，网关内部处理明文）",
      "统一错误响应格式和返回码"
    ],
    "out_of_scope": [
      "业务逻辑实现",
      "用户密码存储与校验",
      "文件直接存储至 MinIO",
      "部署执行的具体步骤",
      "密钥加密解密操作",
      "权限模型的完整定义与存储"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003",
      "DM-004"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "API 网关作为系统统一入口，负责请求路由、认证鉴权、限流、WebSocket 代理及 SSL 终结。基于 Gin 框架实现，使用 JWT 进行用户身份验证和角色授权，结合 Redis 实现分布式限流和日志推送订阅，前端所有请求均通过网关访问后端微服务。",
    "dependencies": [
      "用户与权限服务",
      "项目与环境服务",
      "文件管理服务",
      "部署执行服务",
      "安全与密钥服务",
      "部署历史与日志服务",
      "Redis"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "jwt-go",
      "gorilla/websocket",
      "Redis",
      "Nginx"
    ]
  },
