    "fallback": "所有未捕获的错误返回 500，内部记录错误日志。"
  },
  "business_rules": {
    "description": "网关核心业务规则，包括认证流程、限流逻辑、路由匹配和错误处理。",
    "auth_rules": [
      "所有非公开路径（除登录、注册、Token刷新、健康检查外）必须携带有效 JWT Token",
      "Token 格式为 Authorization: Bearer <token>",
      "Token 过期或无效返回 401",
      "角色检查：如果路由配置了 required_roles，则用户必须至少拥有其中一个角色，否则返回 403"
    ],
    "rate_limiting_rules": [
      "全局限流：所有请求共享，默认 1000/s，突发 200",
      "每用户限流：基于 user_id，默认 100/60s，突发 20",
      "特定端点可配置单独限流规则，覆盖全局和用户限流",
      "WebSocket 连接限流单独处理，按连接数限制"
    ],
    "routing_rules": [
      "根据请求路径和方法匹配路由表",
      "支持路径参数和通配符",
      "匹配成功后，按序执行中间件链（RequestID, Logging, RateLimiter, Auth, RBAC, Forward）",
      "WebSocket 升级请求特殊处理，执行 Upgrade 后代理"
    ],
    "error_handling_rules": [
      "所有错误响应统一格式：{code: number, message: string}",
      "404：未匹配到路由",
      "401：Token 无效或过期",
      "403：权限不足",
      "429：触发限流",
      "502：上游服务连接失败",
      "503：路由配置的上游服务不可达"
    ]
  },
