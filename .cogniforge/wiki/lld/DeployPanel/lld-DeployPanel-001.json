{
  "meta": {
    "doc_id": "lld-service-deploy-001",
    "type": "lld",
    "module_type": "service",
    "module": "deploy-service",
    "title": "部署服务 LLD"
  },
  "overview": {
    "description": "部署服务，负责接收前端部署请求，管理部署流程，与后端 IPC 通信，并推送部署状态和日志。"
  },
  "domain_objects": [
    {
      "name": "DeployFormState",
      "description": "部署表单状态结构",
      "fields": [
        {
          "name": "projectId",
          "type": "string",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "envId",
          "type": "string",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "localFilePath",
          "type": "string",
          "required": true,
          "description": "本地文件路径"
        },
        {
          "name": "preScript",
          "type": "string?",
          "required": false,
          "description": "前置脚本"
        },
        {
          "name": "postScript",
          "type": "string?",
          "required": false,
          "description": "后置脚本"
        }
      ]
    },
    {
      "name": "DeployLogEntry",
      "description": "部署日志条目",
      "fields": [
        {
          "name": "timestamp",
          "type": "number",
          "required": true,
          "description": "时间戳"
        },
        {
          "name": "level",
          "type": "string",
          "required": true,
          "description": "日志级别"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "日志内容"
        }
      ]
    },
    {
      "name": "DeployState",
      "description": "部署状态枚举",
      "type": "enum",
      "values": [
        "IDLE",
        "UPLOADING",
        "SUCCESS",
        "FAILED",
        "CANCELLING"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "CTR-001",
      "name": "StartDeploy",
      "method": "POST",
      "endpoint": "/api/deploy/start",
      "description": "启动部署",
      "request": {
        "body": "DeployFormState"
      },
      "response": {
        "body": {
          "status": "string",
          "message": "string"
        }
      },
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-001"
      ]
    },
    {
      "id": "CTR-002",
      "name": "CancelDeploy",
      "method": "POST",
      "endpoint": "/api/deploy/cancel",
      "description": "取消部署",
      "request": {
        "body": {}
      },
      "response": {
        "body": {
          "status": "string",
          "message": "string"
        }
      },
      "source_requirements": [
        "REQ-006"
      ],
      "source_components": [
        "CMP-001"
      ]
    },
    {
      "id": "CTR-003",
      "name": "DeployLogStream",
      "method": "GET",
      "endpoint": "/api/deploy/logs",
      "description": "获取部署日志流（通过 IPC 事件模拟）",
      "request": {
        "query": {
          "sessionId": "string"
        }
      },
      "response": {
        "body": {
          "logs": "DeployLogEntry[]"
        }
      },
      "source_requirements": [
        "REQ-005"
      ],
      "source_components": [
        "CMP-001"
      ]
    }
  ],
  "interfaces": [
    {
      "name": "DeployFormState",
      "type": "struct",
      "method": "POST",
      "endpoint": "/api/deploy/start",
      "description": "部署表单数据",
      "response": {
        "body": "DeployFormState"
      },
      "fields": [
        {
          "name": "projectId",
          "type": "string",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "envId",
          "type": "string",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "localFilePath",
          "type": "string",
          "required": true,
          "description": "本地文件路径"
        },
        {
          "name": "preScript",
          "type": "string?",
          "required": false,
          "description": "前置脚本"
        },
        {
          "name": "postScript",
          "type": "string?",
          "required": false,
          "description": "后置脚本"
        }
      ]
    },
    {
      "name": "DeployState",
      "type": "enum",
      "values": [
        "IDLE",
        "UPLOADING",
        "SUCCESS",
        "FAILED",
        "CANCELLING"
      ],
      "method": "POST",
      "endpoint": "/api/deploy/state",
      "description": "部署状态",
      "response": {
        "body": "DeployState"
      }
    }
  ]
}