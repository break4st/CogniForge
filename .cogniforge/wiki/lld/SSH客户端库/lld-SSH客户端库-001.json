  "module_boundary": {
    "in_scope": [
      "异步SSH连接管理（建立、维持、关闭）",
      "远程命令执行",
      "SFTP文件上传/下载",
      "连接错误处理和超时重试",
      "与SSH密钥管理服务集成以获取解密私钥"
    ],
    "out_of_scope": [
      "私钥加密/解密逻辑（由SSH密钥管理服务负责）",
      "部署流程编排（由部署执行服务负责）",
      "用户权限校验（由上层服务负责）",
      "SSH密钥的存储和管理"
    ],
