    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-003"
    ],
    "owned_data_models": [],
    "consumed_data_models": [],
    "description": "SSH客户端库提供异步SSH连接管理、远程命令执行和SFTP文件传输功能，依赖asyncssh库，与SSH密钥管理服务集成获取解密私钥，支持连接池、重试和错误处理。"
  },
  "overview": {
    "description": "SSH客户端库提供异步SSH连接管理、远程命令执行和SFTP文件传输功能，依赖asyncssh库，与SSH密钥管理服务集成获取解密私钥，支持连接池、重试和错误处理。",
    "dependencies": [
      "asyncssh (ssh_library)",
      "cryptography (用于解密后的私钥加载)"
    ],
    "tech_stack": [
      "asyncssh",
      "cryptography"
    ]
  },
