  "workflow": {
    "name": "典型部署流程",
    "description": "部署服务使用SSH客户端库的流程",
    "steps": [
      {
        "order": 1,
        "name": "连通性检测",
        "action": "调用test_connectivity检查目标主机端口可达性",
        "timeout_seconds": 5,
        "on_failure": "终止部署"
      },
      {
        "order": 2,
        "name": "建立连接",
        "action": "调用create_connection建立SSH会话",
        "timeout_seconds": 15,
        "on_failure": "重试或终止"
      },
      {
        "order": 3,
        "name": "上传部署包",
        "action": "调用upload_file传输文件至远程主机",
        "timeout_seconds": 300,
        "on_failure": "重试或终止"
      },
      {
        "order": 4,
        "name": "执行部署脚本",
        "action": "调用execute_command运行远程部署命令",
        "timeout_seconds": 120,
        "on_failure": "终止部署"
      },
      {
        "order": 5,
        "name": "关闭连接",
        "action": "显式关闭或通过with上下文释放连接",
        "timeout_seconds": 5,
        "on_failure": "记录警告"
      }
    ]
  },
