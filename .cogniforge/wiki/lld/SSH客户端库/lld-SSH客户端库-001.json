  "lld_objects": [
    {
      "name": "SSHClientLibrary",
      "description": "核心SSH客户端库，封装连接管理、命令执行、文件传输功能",
      "responsibilities": [
        "建立和关闭SSH连接",
        "执行远程命令",
        "上传/下载文件",
        "处理连接错误与重试"
      ]
    }
  ],
  "message_contracts": [],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "SSHClientManager",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-008",
      "method": "INTERNAL",
      "endpoint": "internal:ssh-client-manager",
      "parameters": [],
      "request_body": {},
      "response": {
        "body": {
          "type": "object",
