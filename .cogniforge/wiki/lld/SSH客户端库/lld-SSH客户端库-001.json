  "reliability_strategy": {
    "description": "SSH客户端库的可靠性策略，包括连接、命令执行、SFTP传输和错误处理的配置与规则。",
    "invariants": [
      "连接池大小不超过max_size",
      "命令执行超时不超过command_timeout_seconds",
      "重试次数不超过最大重试限制"
    ],
    "connection": {
      "timeout_seconds": 30,
      "keepalive_interval": 30,
      "max_connection_retries": 3,
      "retry_backoff": "exponential",
      "connection_pool": {
        "max_size": 10,
        "idle_timeout": 300,
        "eviction_policy": "LRU"
      }
    },
    "command_execution": {
      "max_retries": 2,
      "retryable_exit_codes": [
        255
      ],
      "retry_strategy": "exponential_backoff",
      "command_timeout_seconds": 300
    },
    "sftp_transfer": {
      "retry_on_failure": true,
      "max_retries": 3,
      "retry_backoff": "exponential"
    },
    "error_handling": {
      "retriable_exceptions": [
        "ConnectionError",
        "TimeoutError",
        "ChannelError"
      ],
      "circuit_breaker": {
        "enabled": false
      },
      "strategy": "exponential_backoff_retry"
    }
  },
  "topology": {
    "namespaces": [
      {
        "name": "ssh_connection_pool",
        "description": "用于缓存SSH连接池状态，键为连接标识，值为连接状态信息",
        "expiry_strategy": "基于空闲时间过期，默认空闲超时300秒"
      }
    ],
    "key_patterns": [
      {
        "pattern": "ssh:conn:{host}:{port}:{username}",
        "description": "SSH连接缓存键模板，唯一标识一个SSH连接",
        "ttl_seconds": 300
      }
    ],
    "expiry_strategy": "空闲过期 + TTL，连接空闲超过设定时间或总生存时间超过最大值时自动清理"
  },
  "data_models": [
    {
      "id": "DM-001",
      "name": "SSHConnectionConfig",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "封装SSH连接参数",
      "fields": [
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "远程主机地址"
        },
        {
          "name": "port",
          "type": "int",
          "required": false,
          "description": "SSH端口，默认22"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "登录用户名"
        },
        {
          "name": "private_key",
          "type": "string",
          "required": true,
          "description": "解密后的私钥内容"
        },
        {
          "name": "timeout",
          "type": "int",
          "required": false,
          "description": "连接超时秒数，默认10"
        },
        {
          "name": "retry_attempts",
          "type": "int",
          "required": false,
          "description": "连接重试次数，默认3"
        }
      ],
      "source_requirements": [
        "REQ-001",
        "REQ-002"
      ],
