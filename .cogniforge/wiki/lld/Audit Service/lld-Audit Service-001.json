{
  "meta": {
    "doc_id": "lld-Audit Service-001",
    "type": "lld",
    "module_type": "ModuleType.SERVICE",
    "module": "Audit Service",
    "title": "LLD - Audit Service",
    "author": "design_agent",
    "created": "2026-05-21 09:49"
  },
  "overview": {
    "description": "审计日志服务，负责记录系统中所有关键操作的审计日志，支持追溯和排查。提供审计日志的写入、查询、筛选和详情查看能力，为系统合规性和操作溯源提供数据支撑。",
    "dependencies": ["Primary Database"],
    "tech_stack": ["Python 3.11+", "FastAPI", "MySQL 8.0"]
  },
  "data_models": [
    {
      "name": "audit_logs",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "audit_logs"
      },
      "description": "审计日志表，继承自主数据库。记录系统中所有关键操作的审计轨迹，包括操作用户、操作类型、操作对象、操作时间、来源IP及操作结果等。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "审计日志ID，自增主键"},
        {"name": "user_id", "type": "integer", "required": true, "description": "操作用户ID"},
        {"name": "username", "type": "varchar(255)", "required": true, "description": "操作用户名"},
        {"name": "action_type", "type": "varchar(50)", "required": true, "description": "操作类型：create|update|delete|deploy|test|login"},
        {"name": "resource_type", "type": "varchar(50)", "required": true, "description": "资源类型：project|environment|key|deployment"},
        {"name": "resource_id", "type": "integer", "required": true, "description": "操作资源ID"},
        {"name": "resource_name", "type": "varchar(255)", "required": false, "description": "操作资源名称，便于快速识别"},
        {"name": "detail", "type": "json", "required": false, "description": "操作详情JSON，记录请求关键字段和变更内容"},
        {"name": "ip_address", "type": "varchar(45)", "required": true, "description": "请求来源IP地址，支持IPv4和IPv6"},
        {"name": "result", "type": "varchar(20)", "required": true, "description": "操作结果：success|failure"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "审计日志记录时间"}
      ]
    },
    {
      "name": "AuditRetentionConfig",
      "type": "config",
      "ownership": "owned",
      "description": "审计日志保留策略配置，从配置文件加载",
      "fields": [
        {"name": "retention_days", "type": "integer", "required": true, "description": "日志保留天数，默认90天"},
        {"name": "archive_enabled", "type": "boolean", "required": true, "description": "是否启用自动归档，默认true"},
        {"name": "archive_path", "type": "string", "required": false, "description": "归档文件存储路径"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "Create Audit Log",
      "method": "POST",
      "endpoint": "/api/audit/logs",
      "description": "创建审计日志记录。由API Gateway在用户执行关键操作后调用，将操作信息记录到审计日志表。",
      "parameters": [
        {"name": "user_id", "type": "integer", "description": "操作用户ID"},
        {"name": "username", "type": "string", "description": "操作用户名"},
        {"name": "action_type", "type": "string", "description": "操作类型：create|update|delete|deploy|test|login"},
        {"name": "resource_type", "type": "string", "description": "资源类型：project|environment|key|deployment"},
        {"name": "resource_id", "type": "integer", "description": "操作资源ID"},
        {"name": "resource_name", "type": "string", "description": "操作资源名称，可选"},
        {"name": "detail", "type": "object", "description": "操作详情JSON，可选"},
        {"name": "ip_address", "type": "string", "description": "请求来源IP地址"},
        {"name": "result", "type": "string", "description": "操作结果：success|failure"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败，必填字段缺失或格式不合法"},
        {"code": 500, "message": "审计日志写入数据库失败"}
      ]
    },
    {
      "name": "Query Audit Logs",
      "method": "GET",
      "endpoint": "/api/audit/logs",
      "description": "分页查询审计日志列表，支持按用户、操作类型、资源类型、时间范围等多维度筛选。按创建时间倒序排列。",
      "parameters": [
        {"name": "page", "type": "integer", "description": "页码，默认1"},
        {"name": "page_size", "type": "integer", "description": "每页条数，默认20"},
        {"name": "user_id", "type": "integer", "description": "按用户ID筛选，可选"},
        {"name": "action_type", "type": "string", "description": "按操作类型筛选：create|update|delete|deploy|test|login，可选"},
        {"name": "resource_type", "type": "string", "description": "按资源类型筛选：project|environment|key|deployment，可选"},
        {"name": "start_time", "type": "datetime", "description": "起始时间，可选"},
        {"name": "end_time", "type": "datetime", "description": "结束时间，可选"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array[object]",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "分页参数不合法或时间范围格式错误"},
        {"code": 500, "message": "审计日志查询失败"}
      ]
    },
    {
      "name": "Get Audit Log Detail",
      "method": "GET",
      "endpoint": "/api/audit/logs/{log_id}",
      "description": "获取单条审计日志的完整详情。",
      "parameters": [
        {"name": "log_id", "type": "integer", "description": "审计日志ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "user_id": "integer",
          "username": "string",
          "action_type": "string",
          "resource_type": "string",
          "resource_id": "integer",
          "resource_name": "string",
          "detail": "object",
          "ip_address": "string",
          "result": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "审计日志不存在"},
        {"code": 500, "message": "审计日志查询失败"}
      ]
    }
  ],
  "error_handling": "1）参数校验错误（400）：请求体缺少必填字段（user_id、username、action_type、resource_type、resource_id、ip_address、result）、action_type或resource_type枚举值不合法、分页参数为负数、时间范围格式无效时返回400。2）资源不存在（404）：查询审计日志详情时指定ID不存在则返回404。3）数据库错误：数据库连接失败或写入/查询超时（默认5秒超时），记录错误日志后返回500，不暴露数据库内部细节。4）归档处理失败：自动归档任务执行失败时记录告警日志，不影响当前日志写入和查询。5）内部错误（500）：所有未捕获异常统一返回500，响应体包含请求ID以便链路追踪。"
}
