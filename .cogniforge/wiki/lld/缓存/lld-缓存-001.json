{
  "meta": {
    "doc_id": "lld-缓存-001",
    "type": "lld",
    "module_type": "infrastructure",
    "module": "缓存",
    "title": "缓存模块详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "基于Redis 7+实现的缓存中间件，提供用户会话状态、项目列表、环境配置的缓存能力以及部署任务状态的临时存储。降低数据库读取压力，加速前端页面响应速度，确保在缓存不可用时业务可降级运行。",
    "dependencies": [],
    "tech_stack": ["Redis 7+"]
  },
  "data_models": [
    {
      "name": "用户会话缓存",
      "type": "store",
      "ownership": "owned",
      "description": "用户登录后的会话状态信息，存储JWT令牌和用户身份，用于认证中间件快速验证用户会话有效性",
      "fields": [
        {"name": "user_id", "type": "integer", "required": true, "description": "用户ID"},
        {"name": "token", "type": "string", "required": true, "description": "JWT令牌"},
        {"name": "expires_at", "type": "datetime", "required": true, "description": "过期时间"},
        {"name": "last_activity", "type": "datetime", "required": false, "description": "最后活跃时间，用于滑动过期判断"}
      ]
    },
    {
      "name": "项目列表缓存",
      "type": "store",
      "ownership": "owned",
      "description": "用户可见的项目列表缓存，从关系型数据库读取后按用户权限过滤后写入缓存",
      "fields": [
        {"name": "project_id", "type": "integer", "required": true, "description": "项目ID"},
        {"name": "name", "type": "string", "required": true, "description": "项目名称"},
        {"name": "description", "type": "string", "required": false, "description": "项目描述"},
        {"name": "env_count", "type": "integer", "required": false, "description": "关联环境数量"}
      ]
    },
    {
      "name": "环境配置缓存",
      "type": "store",
      "ownership": "owned",
      "description": "部署环境的连接参数和SSH密钥关联ID缓存，减少频繁查询数据库的压力",
      "fields": [
        {"name": "env_id", "type": "integer", "required": true, "description": "环境ID"},
        {"name": "name", "type": "string", "required": true, "description": "环境名称"},
        {"name": "type", "type": "string", "required": true, "description": "环境类型：test/gray/production"},
        {"name": "host", "type": "string", "required": true, "description": "服务器地址"},
        {"name": "port", "type": "integer", "required": true, "description": "SSH端口"},
        {"name": "key_id", "type": "integer", "required": true, "description": "关联SSH密钥ID"}
      ]
    },
    {
      "name": "部署任务状态缓存",
      "type": "store",
      "ownership": "owned",
      "description": "部署任务的实时状态，供前端轮询查询，任务完成后自动过期清理",
      "fields": [
        {"name": "deploy_id", "type": "string", "required": true, "description": "部署任务ID"},
        {"name": "status", "type": "string", "required": true, "description": "任务状态：pending/running/success/failed"},
        {"name": "progress", "type": "integer", "required": true, "description": "进度百分比（0-100）"},
        {"name": "logs", "type": "array", "required": false, "description": "部署过程日志行列表"},
        {"name": "started_at", "type": "datetime", "required": false, "description": "任务开始时间"},
        {"name": "finished_at", "type": "datetime", "required": false, "description": "任务结束时间"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "会话缓存读写接口",
      "method": "INTERNAL",
      "endpoint": "cache:session:{user_id}",
      "description": "写入和读取用户会话缓存，认证中间件调用此接口验证用户会话有效性",
      "parameters": [
        {"name": "user_id", "type": "integer", "description": "用户ID"},
        {"name": "session_data", "type": "object", "description": "包含token、expires_at等会话数据的JSON对象"},
        {"name": "ttl_seconds", "type": "integer", "description": "过期时间（秒），默认1800（30分钟）"}
      ],
      "response": {
        "status": 200,
        "body": {"data": "object"}
      },
      "error_codes": [
        {"code": 5001, "message": "缓存连接失败，降级为数据库查询"},
        {"code": 5002, "message": "缓存操作超时"},
        {"code": 5003, "message": "序列化/反序列化失败"}
      ]
    },
    {
      "name": "项目缓存读写接口",
      "method": "INTERNAL",
      "endpoint": "cache:project:*",
      "description": "项目列表和项目详情的缓存读写，项目管理服务在查询完成后自动写入缓存",
      "parameters": [
        {"name": "project_id", "type": "integer", "description": "项目ID（查询详情时使用，查列表时不传）"},
        {"name": "project_data", "type": "array|object", "description": "项目列表数组或单个项目对象"}
      ],
      "response": {
        "status": 200,
        "body": {"data": "object|array"}
      },
      "error_codes": [
        {"code": 5001, "message": "缓存连接失败，降级为数据库查询"},
        {"code": 5002, "message": "缓存操作超时"}
      ]
    },
    {
      "name": "环境配置缓存读写接口",
      "method": "INTERNAL",
      "endpoint": "cache:env:{env_id}",
      "description": "部署环境配置的缓存读写，部署执行服务在部署时快速获取环境参数",
      "parameters": [
        {"name": "env_id", "type": "integer", "description": "环境ID"},
        {"name": "env_config", "type": "object", "description": "包含host、port、key_id等环境配置数据"}
      ],
      "response": {
        "status": 200,
        "body": {"data": "object"}
      },
      "error_codes": [
        {"code": 5001, "message": "缓存连接失败，降级为数据库查询"},
        {"code": 5002, "message": "缓存操作超时"}
      ]
    },
    {
      "name": "部署任务状态缓存读写接口",
      "method": "INTERNAL",
      "endpoint": "cache:deploy:{deploy_id}",
      "description": "部署任务实时状态的缓存读写，部署执行服务写入状态，前端轮询读取",
      "parameters": [
        {"name": "deploy_id", "type": "string", "description": "部署任务ID"},
        {"name": "task_status", "type": "object", "description": "包含status、progress、logs等任务状态数据"},
        {"name": "ttl_seconds", "type": "integer", "description": "过期时间（秒），默认3600（1小时）"}
      ],
      "response": {
        "status": 200,
        "body": {"data": "object"}
      },
      "error_codes": [
        {"code": 5001, "message": "缓存连接失败，降级为数据库查询"},
        {"code": 5002, "message": "缓存操作超时"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "缓存操作异常不影响主业务流程：读取缓存失败时降级为直接查询数据库；写入缓存失败时仅记录错误日志不阻塞业务逻辑；连接异常自动重试3次后仍失败则断开连接并触发告警。",
    "response_format": {
      "body": {"code": "integer", "error": "string", "detail": "string"}
    },
    "categories": [
      {"code": 5001, "name": "连接失败", "description": "Redis服务不可用或网络异常导致连接失败，先自动重试3次（指数退避），重试均失败后返回降级信号供调用方处理"},
      {"code": 5002, "name": "操作超时", "description": "缓存读写操作超过设定的超时阈值，放弃本次操作并返回缓存未命中状态"},
      {"code": 5003, "name": "序列化异常", "description": "缓存数据JSON序列化或反序列化时格式错误或类型不匹配，记录告警日志并清空异常缓存键"},
      {"code": 5004, "name": "缓存未命中", "description": "请求的缓存键不存在或已过期，按正常未命中处理（非异常），由调用方从数据库重新加载"}
    ]
  },
  "topology": {
    "namespaces": [
      {
        "name": "session",
        "description": "用户会话状态缓存，存储登录后的JWT令牌和用户身份信息",
        "key_pattern": "session:{user_id}",
        "ttl_seconds": 1800,
        "expiry_policy": "滑动过期，每次访问（读取）刷新TTL"
      },
      {
        "name": "project",
        "description": "项目列表和项目详情缓存，加速前端项目切换和列表加载",
        "key_pattern": "project:list / project:{id}",
        "ttl_seconds": 300,
        "expiry_policy": "固定过期，到期后由业务层下一次查询时主动刷新"
      },
      {
        "name": "env",
        "description": "环境配置缓存，部署执行时快速获取环境连接参数",
        "key_pattern": "env:{id}",
        "ttl_seconds": 600,
        "expiry_policy": "固定过期，环境配置变更时主动失效对应缓存键"
      },
      {
        "name": "deploy",
        "description": "部署任务实时状态缓存，供前端轮询查询部署进度",
        "key_pattern": "deploy:{deploy_id}",
        "ttl_seconds": 3600,
        "expiry_policy": "任务完成后保留5分钟后自动过期清理"
      }
    ],
    "key_patterns": [
      {
        "pattern": "session:{user_id}",
        "type": "string",
        "ttl_seconds": 1800,
        "description": "用户会话数据JSON，user_id为整数用户ID"
      },
      {
        "pattern": "project:list",
        "type": "string",
        "ttl_seconds": 300,
        "description": "全量项目列表JSON数组"
      },
      {
        "pattern": "project:{id}",
        "type": "string",
        "ttl_seconds": 300,
        "description": "单个项目详情JSON，id为整数项目ID"
      },
      {
        "pattern": "env:{id}",
        "type": "string",
        "ttl_seconds": 600,
        "description": "环境配置JSON，id为整数环境ID"
      },
      {
        "pattern": "deploy:{deploy_id}",
        "type": "string",
        "ttl_seconds": 3600,
        "description": "部署任务状态JSON，deploy_id为字符串任务ID"
      }
    ],
    "expiry_strategy": "滑动过期与固定过期结合使用。用户会话采用30分钟滑动过期，每次读取操作自动刷新TTL，连续无操作30分钟后自动过期。项目列表和环境配置采用固定TTL到期失效，由业务层在查询时主动重建缓存。部署任务状态在任务完成后保留5分钟（TTL固定为5分钟），供前端最后一次状态轮询后自动清理。缓存键更新时（如项目修改、环境配置变更），同步调用删除操作主动失效相关缓存。"
  },
  "connection_contracts": {
    "host": "127.0.0.1",
    "port": 6379,
    "password_required": false,
    "db_index": 0,
    "connection_pool": {
      "max_connections": 50,
      "min_connections": 5,
      "health_check_interval_seconds": 30,
      "max_idle_seconds": 300
    },
    "timeout": {
      "connect_timeout_seconds": 5,
      "operation_timeout_seconds": 3,
      "socket_timeout_seconds": 5
    },
    "retry": {
      "max_attempts": 3,
      "backoff": "exponential",
      "initial_delay_ms": 100,
      "max_delay_ms": 2000
    },
    "serialization": "JSON格式序列化，Python字典和列表通过json.dumps/json.loads自动转换，支持嵌套对象"
  }
}
