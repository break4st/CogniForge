          "required": true
        },
        {
          "name": "action",
          "type": "varchar(255)",
          "required": true
        },
        {
          "name": "details",
          "type": "text",
          "required": false
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": false
        }
      ],
      "indexes": [
        {
          "name": "idx_audit_logs_user_id",
          "columns": ["user_id"],
          "type": "BTREE"
        },
        {
          "name": "idx_audit_logs_created_at",
          "columns": ["created_at"],
          "type": "BTREE"
        }
      ]
    }
  ],
  "capacity_estimation": {
    "estimate": "预计初期数据量较小，每月增长不超过10GB，单表行数在百万级，采用默认配置即可满足需求。"
  }
