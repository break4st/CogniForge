  "migration_strategy": {
    "strategy": "使用 Flyway 进行数据库迁移，版本化管理 SQL 脚本，每次发布前自动执行迁移。"
  },
  "connection_contracts": {
    "database_url": "jdbc:postgresql://localhost:5432/deployment_platform",
    "max_connections": 100,
    "connection_timeout": 30
  },
  "interfaces": [],
  "index_strategy": [
    "为高频查询字段创建索引；外键列自动创建索引；唯一约束列自动创建唯一索引；定期监控慢查询并优化索引。",
    "所有外键字段必须有索引",
    "唯一约束字段必须有唯一索引"
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "users",
      "ownership": "canonical",
      "description": "用户账户信息表",
      "type": "table",
      "fields": [
        {
          "name": "id",
          "type": "serial",
          "required": true
        },
        {
          "name": "username",
          "type": "varchar(50)",
          "required": true
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "required": true
        },
        {
          "name": "password_hash",
          "type": "varchar(255)",
          "required": true
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": false
        }
      ],
      "indexes": [
        {
          "name": "idx_users_username",
          "columns": ["username"],
          "type": "BTREE"
        },
        {
          "name": "idx_users_email",
          "columns": ["email"],
          "type": "UNIQUE"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "projects",
      "ownership": "canonical",
      "description": "项目信息表",
      "type": "table",
      "fields": [
        {
          "name": "id",
          "type": "serial",
          "required": true
        },
        {
          "name": "user_id",
          "type": "integer",
          "required": true
        },
        {
          "name": "name",
          "type": "varchar(100)",
          "required": true
        },
        {
          "name": "description",
          "type": "text",
          "required": false
        }
      ],
      "indexes": [
        {
          "name": "idx_projects_user_id",
          "columns": ["user_id"],
          "type": "BTREE"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "environments",
      "ownership": "canonical",
      "description": "环境信息表",
      "type": "table",
      "fields": [
        {
          "name": "id",
          "type": "serial",
          "required": true
        },
        {
          "name": "project_id",
          "type": "integer",
          "required": true
        },
        {
          "name": "name",
          "type": "varchar(100)",
          "required": true
        },
        {
          "name": "env_vars",
          "type": "jsonb",
          "required": false
        }
      ],
      "indexes": [
        {
          "name": "idx_environments_project_id",
          "columns": ["project_id"],
          "type": "BTREE"
        }
      ]
    },
    {
      "id": "DM-004",
      "name": "servers",
      "ownership": "canonical",
      "description": "服务器信息表",
      "type": "table",
      "fields": [
        {
          "name": "id",
          "type": "serial",
          "required": true
        },
        {
          "name": "project_id",
          "type": "integer",
          "required": true
        },
        {
          "name": "hostname",
          "type": "varchar(255)",
          "required": true
        },
        {
          "name": "ip_address",
          "type": "inet",
          "required": true
        }
      ],
      "indexes": [
        {
          "name": "idx_servers_project_id",
          "columns": ["project_id"],
          "type": "BTREE"
        }
      ]
    },
    {
      "id": "DM-005",
      "name": "deployments",
      "ownership": "canonical",
      "description": "部署记录表",
      "type": "table",
      "fields": [
        {
          "name": "id",
          "type": "serial",
          "required": true
        },
        {
          "name": "environment_id",
          "type": "integer",
          "required": true
        },
        {
          "name": "version",
          "type": "varchar(50)",
          "required": true
        },
        {
          "name": "status",
          "type": "varchar(20)",
          "required": true
        },
        {
          "name": "deployed_at",
          "type": "timestamp",
          "required": false
        }
      ],
      "indexes": [
        {
          "name": "idx_deployments_environment_id",
          "columns": ["environment_id"],
          "type": "BTREE"
        }
      ]
    },
    {
      "id": "DM-006",
      "name": "audit_logs",
      "ownership": "canonical",
      "description": "审计日志表",
      "type": "table",
      "fields": [
