        }
      ]
    },
    {
      "id": "DO-007",
      "name": "LogFileContent",
      "description": "日志文件内容对象",
      "attributes": [
        {
          "name": "content",
          "type": "string"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "历史与日志服务契约",
      "description": "定义历史与日志服务的提供和消费的接口集合。",
      "provider": {
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003",
          "IF-004",
          "IF-005",
          "IF-006"
        ]
      },
      "consumer": {
        "interfaces": []
      }
    }
  ],
  "business_rules": [
    {
      "invariants": [
        {
          "rule": "BR-001",
          "description": "部署记录的状态转换必须遵循：PENDING -> RUNNING -> COMPLETED|FAILED。",
          "scope": "DeploymentRecord",
          "type": "invariant"
        },
        {
          "rule": "BR-002",
          "description": "finished_at 仅在状态为 COMPLETED 或 FAILED 时填写。",
          "scope": "DeploymentRecord",
          "type": "invariant"
        },
        {
          "rule": "BR-003",
          "description": "日志文件路径必须在部署完成或失败后设置。",
          "scope": "DeploymentRecord",
          "type": "invariant"
        },
        {
          "rule": "BR-004",
          "description": "查询历史记录时必须分页，limit 默认为 20，最多 100。",
          "scope": "DeploymentHistoryQuery",
          "type": "invariant"
        },
        {
          "rule": "BR-005",
          "description": "日志文件下载时的文件名必须经过白名单校验，防止路径遍历攻击。",
          "scope": "LogFile",
          "type": "security"
        }
      ]
    },
    {
      "transitions": [
        {
          "entity": "DeploymentRecord",
          "states": ["PENDING", "RUNNING", "COMPLETED", "FAILED"],
          "allowed_transitions": [
            { "from": "PENDING", "to": "RUNNING" },
            { "from": "RUNNING", "to": "COMPLETED" },
            { "from": "RUNNING", "to": "FAILED" }
          ]
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "统一错误处理中间件捕获异常，返回标准格式错误响应。",
    "handlers": [
      {
        "type": "BAD_REQUEST",
        "status": 400,
        "description": "请求参数校验失败"
      },
      {
        "type": "NOT_FOUND",
        "status": 404,
        "description": "资源未找到"
      },
      {
        "type": "INTERNAL_ERROR",
        "status": 500,
        "description": "文件读取失败或数据库异常"
      }
    ]
  }
