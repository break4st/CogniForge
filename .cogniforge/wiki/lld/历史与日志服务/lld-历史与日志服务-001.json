        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeploymentRecord",
      "description": "部署历史记录实体",
      "attributes": [
        {
          "name": "id",
          "type": "integer"
        },
        {
          "name": "projectId",
          "type": "integer"
        },
        {
          "name": "environmentId",
          "type": "integer"
        },
        {
          "name": "status",
          "type": "DeploymentStatus"
        },
        {
          "name": "startedAt",
          "type": "Date"
        },
        {
          "name": "finishedAt",
          "type": "Date | null"
        },
        {
          "name": "logFilePath",
          "type": "string | null"
        },
        {
          "name": "createdBy",
          "type": "string"
        },
        {
          "name": "createdAt",
          "type": "Date"
        }
      ],
      "methods": [
        {
          "name": "isTerminal",
          "return_type": "boolean",
          "description": "判断部署是否处于终态"
        },
        {
          "name": "updateStatus",
          "parameters": [
            {
              "name": "newStatus",
              "type": "DeploymentStatus"
            },
            {
              "name": "finishedAt",
              "type": "Date | null"
            }
          ],
          "return_type": "void",
          "description": "更新部署状态和结束时间"
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "DeploymentStatus",
      "description": "部署状态枚举",
      "values": [
        "PENDING",
        "RUNNING",
        "COMPLETED",
        "FAILED"
      ]
    },
    {
      "id": "DO-003",
      "name": "LogFile",
