      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "GET",
      "endpoint": "/api/deployments/{id}",
      "description": "前端调用以获取单条部署记录的详细信息。",
      "parameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "部署记录ID"
