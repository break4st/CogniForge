      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "指定部署记录或日志目录不存在"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "IF-006",
      "name": "下载日志文件",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "GET",
      "endpoint": "/api/deployments/{id}/logs/download",
      "description": "下载指定的日志文件内容。",
      "parameters": [
        {
          "name": "id",
