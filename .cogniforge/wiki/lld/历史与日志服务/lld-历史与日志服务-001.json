  "data_models": [
    {
      "id": "DM-001",
      "name": "DeploymentHistory",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "DeploymentHistory"
      },
      "description": "存储每次部署的记录，包括状态、关联项目和环境、时间戳及日志文件路径。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "required": true,
          "description": "主键，自增ID"
        },
        {
          "name": "project_id",
          "type": "INTEGER",
          "required": true,
          "description": "关联的项目ID"
        },
        {
          "name": "environment_id",
          "type": "INTEGER",
          "required": true,
          "description": "关联的环境ID"
        },
        {
          "name": "status",
          "type": "VARCHAR(20)",
          "required": true,
          "description": "部署当前状态"
        },
        {
          "name": "started_at",
          "type": "DATETIME",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "finished_at",
          "type": "DATETIME",
          "required": false,
          "description": "部署结束时间（终态时才填写）"
        },
        {
          "name": "log_file_path",
          "type": "VARCHAR(500)",
          "required": false,
          "description": "关联的日志文件目录路径或标识"
        },
        {
          "name": "created_by",
          "type": "VARCHAR(100)",
          "required": true,
          "description": "触发部署的用户"
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "required": true,
          "description": "记录创建时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_project_id",
          "unique": false,
          "columns": [
            "project_id"
          ]
        },
        {
          "name": "idx_status",
          "unique": false,
          "columns": [
            "status"
          ]
        },
        {
          "name": "idx_created_at",
          "unique": false,
          "columns": [
            "created_at"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "部署启动时由 POST /api/deployments 创建",
        "update": "状态变更时更新 status 和 finished_at",
        "delete": "不物理删除，仅按策略归档清理",
        "retention": "按管理策略配置"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "创建部署记录",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "POST",
      "endpoint": "/api/deployments",
      "description": "部署执行器在启动部署时调用，创建一条初始状态为 PENDING 的历史记录。",
      "parameters": [],
      "request_body": {
        "project_id": "integer",
        "environment_id": "integer",
        "status": "string (枚举: PENDING)",
        "started_at": "string (ISO 8601 datetime)",
        "created_by": "string"
      },
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "environment_id": "integer",
          "status": "string",
          "started_at": "string",
          "finished_at": "string|null",
          "log_file_path": "string|null",
          "created_by": "string",
          "created_at": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "BAD_REQUEST",
          "message": "请求参数格式错误或缺失"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "IF-002",
      "name": "更新部署记录",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "PUT",
      "endpoint": "/api/deployments/{id}",
      "description": "部署执行器调用以更新部署状态、结束时间等。",
      "parameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "部署记录ID"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "新状态 (RUNNING, COMPLETED, FAILED)"
        },
        {
          "name": "finished_at",
          "type": "string",
          "required": false,
          "description": "结束时间，终态时必填"
        },
        {
          "name": "log_file_path",
          "type": "string",
          "required": false,
          "description": "日志文件路径，部署完成时设置"
        }
      ],
      "request_body": {
        "status": "string",
        "finished_at": "string",
        "log_file_path": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "environment_id": "integer",
          "status": "string",
          "started_at": "string",
          "finished_at": "string|null",
          "log_file_path": "string|null",
          "created_by": "string",
          "created_at": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "BAD_REQUEST",
          "message": "请求参数格式错误或缺失"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "IF-003",
      "name": "查询部署历史",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "GET",
      "endpoint": "/api/deployments",
      "description": "前端调用以获取部署历史列表，支持按项目、环境、状态筛选和分页。",
      "parameters": [
        {
          "name": "project_id",
          "type": "integer",
          "required": false,
          "description": "按项目ID筛选"
        },
        {
          "name": "environment_id",
          "type": "integer",
          "required": false,
          "description": "按环境ID筛选"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "description": "按状态筛选"
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "default": 20,
          "description": "分页限制"
        },
        {
          "name": "offset",
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "分页偏移"
        }
      ],
      "request_body": null,
      "response": {
        "status": 200,
        "body": {
          "data": [
            {
              "id": "integer",
              "project_id": "integer",
              "environment_id": "integer",
              "status": "string",
              "started_at": "string",
              "finished_at": "string|null",
              "log_file_path": "string|null",
              "created_by": "string",
              "created_at": "string"
            }
          ],
          "total": "integer",
          "limit": "integer",
          "offset": "integer"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "BAD_REQUEST",
          "message": "查询参数不合法"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "IF-004",
