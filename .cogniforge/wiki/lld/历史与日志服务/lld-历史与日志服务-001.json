      ],
      "request_body": null,
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "environment_id": "integer",
          "status": "string",
          "started_at": "string",
          "finished_at": "string|null",
          "log_file_path": "string|null",
          "created_by": "string",
          "created_at": "string"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "指定的部署记录不存在"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "IF-005",
      "name": "获取日志文件列表",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "GET",
      "endpoint": "/api/deployments/{id}/logs",
      "description": "获取指定部署记录关联的日志文件列表。",
      "parameters": [
        {
          "name": "id",
