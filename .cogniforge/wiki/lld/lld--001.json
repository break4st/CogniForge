  "service_contracts": [
    {
      "name": "DeploymentService",
      "description": "负责执行部署流水线的核心业务逻辑。",
      "methods": [
        {
          "name": "execute_deployment",
          "signature": "(deployRequest: DeployRequest) -> Deployment",
          "precondition": "deployRequest 中的 environmentId 对应的环境已通过连接测试且未被其他部署任务占用；本地 filePath 路径存在且可读。",
          "postcondition": "数据库中生成一条部署记录，其状态为终态(SUCCESS/FAILED/CANCELLED)；若成功，远程服务器目标路径下存在新部署的文件。",
          "description": "异步执行完整的部署流水线：预检查 -> SFTP上传 -> 远程执行部署脚本 -> 记录日志与更新状态。",
          "exceptions": [
            {
              "name": "EnvironmentNotFoundException",
              "trigger": "environmentId 在数据库中不存在",
              "http_status": 404
            },
            {
              "name": "FileNotFoundForUpload",
              "trigger": "filePath 对应的文件不存在",
              "http_status": 400
            },
            {
              "name": "DeploymentInProgressException",
              "trigger": "同一环境已有非终态的部署任务",
              "http_status": 409
            },
            {
              "name": "SshConnectionException",
              "trigger": "创建SSH连接或认证失败",
              "http_status": 500
            },
            {
              "name": "DeploymentExecutionException",
              "trigger": "远程执行部署脚本返回非零退出码",
              "http_status": 500
            }
          ]
        },
        {
          "name": "get_deployment_status",
          "signature": "(deploymentId: Long) -> Deployment",
          "precondition": "deploymentId 对应的部署记录存在。",
          "postcondition": "返回该部署记录的当前状态信息。",
          "description": "根据ID查询部署任务的详细状态。",
          "exceptions": [
            {
              "name": "DeploymentNotFoundException",
              "trigger": "deploymentId 对应的记录不存在",
              "http_status": 404
            }
          ]
        },
        {
          "name": "cancel_deployment",
          "signature": "(deploymentId: Long) -> Deployment",
          "precondition": "deploymentId 对应的部署记录存在且状态为 PENDING。",
          "postcondition": "该部署记录的状态更新为 CANCELLED，且异步任务被中止。",
          "description": "取消一个尚未开始执行的部署任务。",
          "exceptions": [
            {
              "name": "DeploymentNotFoundException",
              "trigger": "deploymentId 对应的记录不存在",
              "http_status": 404
            },
            {
              "name": "DeploymentNotCancellableException",
              "trigger": "部署状态不为 PENDING，无法取消",
              "http_status": 409
            }
          ]
        }
      ],
      "repository_dependencies": [
        "DeploymentRepository.findById(deploymentId) -> Deployment?",
        "DeploymentRepository.save(deployment) -> Deployment",
        "DeploymentRepository.existsActiveByEnvironmentId(environmentId) -> boolean"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "一个环境同一时间只能有一个部署任务处于非终态（PENDING， UPLOADING， RUNNING）。",
      "部署任务的生命周期只能向前推进，终态（SUCCESS， FAILED， CANCELLED）不可逆转。"
    ],
    "state_machines": [
      {
        "entity": "Deployment",
        "states": [
          "PENDING",
          "UPLOADING",
          "RUNNING",
          "SUCCESS",
          "FAILED",
          "CANCELLED"
        ],
        "transitions": [
          {
            "from": "PENDING",
            "to": "CANCELLED",
            "trigger": "用户发起取消操作",
            "actor": "User"
          },
          {
            "from": "PENDING",
            "to": "UPLOADING",
            "trigger": "预检查通过，开始上传文件",
            "actor": "System"
          },
          {
            "from": "UPLOADING",
            "to": "RUNNING",
