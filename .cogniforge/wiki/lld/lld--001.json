  "module_boundary": {
    "in_scope": [
      "部署任务的创建、执行与状态管理",
      "部署前的本地文件、远程连接权限预检查",
      "通过SFTP上传文件至远程服务器",
      "在远程服务器上创建版本目录并执行部署脚本",
      "部署过程实时日志记录"
    ],
    "out_of_scope": [
      "SSH连接的建立与管理（由SSH客户端组件提供）",
      "凭证的加解密（由加密服务组件提供）",
      "部署历史的持久化存储（由历史与日志服务组件提供）",
      "项目与环境的配置管理（由项目服务组件和环境服务组件提供）"
    ],
    "owned_components": [
      "CMP-004"
    ],
    "owned_contracts": [
