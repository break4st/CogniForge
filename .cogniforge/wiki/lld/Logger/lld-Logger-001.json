  "module_boundary": {
    "in_scope": [
      "Log formatting",
      "Log level filtering (info, warn, error)",
      "Log output to file",
      "Log output to console",
      "Log persistence (optional)",
      "Log query interface (optional)"
    ],
    "out_of_scope": [
      "Log collection from remote systems",
      "Log analysis or monitoring",
      "Log rotation or archival strategies",
      "Integration with external logging services",
      "Security event logging",
      "Audit trail compliance"
    ]
  },
  "overview": {
    "description": "提供统一的日志记录能力，支持不同级别（info, warn, error）的日志消息，可按需输出到文件和控制台。可选持久化和查询接口，为系统其他模块提供调试、追踪和错误诊断的基础支持。",
    "dependencies": [
      "ConfigStore"
    ],
    "tech_stack": [
      "Node.js 18+",
      "TypeScript"
    ]
  },
  "traceability": [],
  "message_contracts": [],
  "topology": {
    "exchanges": [],
    "namespaces": [
      "logger"
    ],
    "buckets": []
  },
  "reliability_strategy": {
    "ack_mode": "manual",
    "retry": {
      "max_retries": 3,
      "backoff": "exponential"
    },
    "dead_letter": "logger.deadletter",
    "idempotency": "基于LogEntry.id去重"
  },
  "error_handling": {
    "strategy": "日志写入失败时，根据配置决定是否重试，重试失败后记录到 dead letter 队列，并降级到控制台输出，确保系统主流程不受影响"
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "ILogger",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "N/A",
      "description": "提供统一的日志记录能力，支持初始化配置、记录不同级别的日志以及释放资源。",
      "parameters": [],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "success": "boolean"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_CONFIG",
          "message": "提供的日志配置无效"
        },
        {
          "status": 500,
          "code": "WRITE_ERROR",
          "message": "无法写入日志"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "LogEntry",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "单条日志记录的数据结构，包含时间戳、级别、消息、来源模块、可选的上下文字段和错误堆栈，用于在系统内统一传递和持久化日志信息。",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "id 必须全局唯一"
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "timestamp 必须符合 ISO 8601 格式"
        },
        {
          "name": "level",
          "type": "enum('info','warn','error')",
          "required": true,
          "description": "level 只能是 'info'、'warn' 或 'error'"
        },
        {
          "name": "module",
          "type": "string",
          "required": false,
          "description": "产生日志的模块名称，便于溯源"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "日志消息正文，人类可读的文本"
        },
        {
          "name": "context",
          "type": "object",
          "required": false,
          "description": "可选的上下文信息，键值对形式，用于附加结构化数据"
        },
        {
          "name": "stack",
          "type": "string",
          "required": false,
          "description": "错误堆栈信息，仅当 level 为 error 时建议提供"
        }
      ],
      "source_requirements": [],
      "source_components": [],
      "source_contracts": [],
      "constraints": [
        "id 必须全局唯一",
        "timestamp 必须符合 ISO 8601 格式",
        "level 只能是 'info'、'warn' 或 'error'"
      ],
      "lifecycle": {
        "create": "由 Logger 模块在记录日志时实例化",
        "update": "日志条目通常不可变，不提供更新操作",
        "delete": "由日志持久化层根据保留策略删除或归档",
        "retention": "保留时间由 LoggerConfig 中的 retentionDays 指定，过期后允许删除"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "LoggerConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "sad-001",
        "model_name": "Logger配置上下文"
      },
      "description": "日志输出配置，控制日志的行为，包括输出目标、最低记录级别、文件路径、是否异步写入、文件大小限制、保留天数等。由 ConfigStore 提供，Logger 模块在初始化时读取。",
      "fields": [
        {
          "name": "minLevel",
          "type": "enum('info','warn','error')",
          "required": true,
          "description": "最低记录级别，低于此级别的日志将被丢弃。默认为 'info'"
        },
        {
          "name": "outputTargets",
          "type": "array",
          "required": true,
          "description": "输出目标列表，支持同时输出到控制台和文件。例如 ['console', 'file']"
        },
        {
          "name": "filePath",
          "type": "string",
          "required": false,
          "description": "filePath 仅在 outputTargets 包含 'file' 时才有意义"
        },
        {
          "name": "async",
          "type": "boolean",
          "required": false,
          "description": "是否异步写入日志，默认为 true"
        },
        {
          "name": "maxFileSizeMB",
          "type": "number",
          "required": false,
          "description": "单个日志文件的最大大小，超过后按策略滚动，默认为 10"
        },
        {
          "name": "retentionDays",
          "type": "number",
          "required": false,
          "description": "日志保留天数，超过后允许清理，默认为 30"
        }
      ],
      "source_requirements": [],
      "source_components": [],
      "source_contracts": [],
      "constraints": [
        "minLevel 只能是 'info'、'warn' 或 'error'",
        "filePath 仅在 outputTargets 包含 'file' 时才有意义",
        "maxFileSizeMB 必须为正整数",
        "retentionDays 必须为正整数"
      ],
      "lifecycle": {
        "create": "由 ConfigStore 管理创建或由部署脚本初始化",
        "update": "管理员通过配置接口修改，Logger 模块动态感知",
        "delete": "通常不删除，而是禁用或重置",
        "retention": "与日志数据生命周期解耦，持久存储"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ]
}