  "module_boundary": {
    "in_scope": [
      "Project CRUD operations",
      "Environment CRUD operations (scoped to project)",
      "SSH key management (CRUD, encryption delegation)",
      "Environment connectivity testing",
      "Deployment triggering (file upload, async task initiation)",
      "Real-time deployment log streaming via WebSocket",
      "Deployment history retrieval with pagination and filtering",
      "Rollback initiation (create rollback deployment record, async rollback task)",
      "Deployment cancellation (signal async task)"
    ],
    "out_of_scope": [
      "User authentication and authorization (delegated to external auth service/Nginx)",
      "Actual SSH command execution (delegated to 部署执行器 component)",
      "Key encryption/decryption implementation (delegated to 密钥加密服务)",
      "Frontend UI rendering",
      "Database schema definition (owned by Primary Database)",
      "Deployment package building"
    ],
    "owned_components": [
      "CMP-002"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "The backend API service provides RESTful endpoints for managing projects, environments, SSH keys, and deployments. It coordinates with the deployment executor for async deployment tasks and the encryption service for key management. WebSocket endpoints stream real-time deployment logs.",
    "tech_stack": [
      "Python 3.10+ - Primary language",
      "FastAPI 0.95+ - Web framework",
      "PostgreSQL 14+ - Primary database",
      "asyncpg / SQLAlchemy[asyncio] latest stable - Async database access",
      "Paramiko 2.11+ - SSH connectivity testing",
      "cryptography 39.0+ - Encryption/decryption of keys (called via 密钥加密服务)",
      "Python asyncio stdlib - Async task management for deployments",
      "FastAPI BackgroundTasks built-in - Trigger background deployment tasks"
    ],
    "dependencies": [
      "部署执行器: internal_async asyncio task / background task - Execute deployment steps and stream logs",
      "密钥加密服务: internal_sync Python library call - Encrypt/decrypt SSH private keys",
      "SSH 客户端模块: internal_sync Paramiko library - Test SSH connectivity",
      "PostgreSQL 数据库: external SQL via async driver (asyncpg/SQLAlchemy) - Persist all data"
    ]
  },
  "business_rules": {
    "invariants": [
      "BR-001: Project names must be unique per user",
      "BR-002: Environment names must be unique within a project",
      "BR-003: SSH key names must be unique per user",
      "BR-004: Deployments can only be created for existing projects and environments",
      "BR-005: A deployment cannot be rolled back unless it is in 'success' status",
      "BR-006: A deployment cannot be cancelled unless it is in 'pending' or 'in_progress' status",
      "BR-007: WebSocket connections for deployment logs require valid deployment_id"
    ]
  },
