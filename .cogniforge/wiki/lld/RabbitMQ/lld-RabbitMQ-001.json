    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "声明和管理队列、交换机及其绑定关系",
      "定义消息体的标准和契约",
      "提供可靠的消息传递机制（持久化、确认、重试）",
      "处理连接、消息路由和异常回退"
    ],
    "out_of_scope": [
      "业务逻辑校验（如项目是否存在、权限检查）",
      "具体部署执行流",
      "用户直接操作"
    ],
    "owned_components": [
      "CMP-001",
      "CMP-002",
      "CMP-003"
    ],
    "owned_contracts": [
      "CTR-001",
      "CTR-002",
      "CTR-003"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "消息中间件，用于解耦业务服务与部署引擎，实现部署任务的异步处理与削峰填谷。保证部署任务的可靠传递，实现业务服务与部署引擎的松耦合，支持消息持久化，防止任务丢失。",
    "dependencies": [],
    "tech_stack": [
      "RabbitMQ 3.12",
      "AMQP 0-9-1",
      "pika 1.3",
      "JSON",
      "TLS 1.2 (optional)"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001",
        "CMP-002",
        "CMP-003"
      ],
      "sad_contract_ids": [
        "CTR-001",
        "CTR-002",
        "CTR-003"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002"
        ],
        "interfaces": [
          "IF-001",
          "IF-002"
        ],
        "domain_objects": [],
        "service_contracts": [
          "SC-001",
          "SC-002"
        ]
      },
      "coverage": "full",
      "notes": "部署任务异步可靠执行的核心需求由RabbitMQ拓扑和契约覆盖"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "DeployTaskMessage",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "由Business Service发布到RabbitMQ的部署任务消息体",
      "fields": [
        {
          "name": "task_id",
          "type": "UUID",
          "required": true,
          "description": "任务唯一标识"
        },
        {
          "name": "project_id",
          "type": "string",
          "required": true,
          "description": "项目标识"
        },
        {
          "name": "environment",
          "type": "string",
          "required": true,
          "description": "目标环境(dev/staging/prod)"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "description": "部署版本号"
        },
        {
          "name": "file_path",
          "type": "string",
          "required": true,
          "description": "部署包在MinIO/文件存储中的路径"
        },
        {
          "name": "user_id",
          "type": "string",
          "required": true,
          "description": "操作人ID"
        },
        {
          "name": "timestamp",
          "type": "ISO-8601 string",
          "required": true,
          "description": "消息生成时间"
        },
        {
          "name": "callback_id",
          "type": "string",
          "required": false,
          "description": "幂等性回调标识"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001",
        "CMP-002"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "消息体大小不超过1MB",
        "必须包含所有必填字段"
      ],
      "lifecycle": {
        "create": "生产者生成并发布",
        "update": "无更新操作",
        "delete": "消息消费后自动删除或落入死信",
        "retention": "持久化消息，消费后根据确认删除或死信保留7天"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "DeployResultMessage",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "Deploy Engine执行完毕后回写的结果消息",
      "fields": [
        {
          "name": "task_id",
          "type": "UUID",
          "required": true,
          "description": "关联的任务ID"
        },
        {
          "name": "status",
          "type": "enum(success,failed)",
          "required": true,
          "description": "执行结果状态"
        },
        {
          "name": "output_log_url",
          "type": "string",
          "required": true,
          "description": "日志存储路径"
        },
        {
          "name": "duration_ms",
          "type": "integer",
          "required": false,
          "description": "执行耗时(毫秒)"
        },
        {
          "name": "error_code",
          "type": "string",
          "required": false,
          "description": "失败时错误码"
        },
        {
          "name": "error_detail",
          "type": "string",
          "required": false,
          "description": "失败详情"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-002"
      ],
      "constraints": [
        "消息体大小不超过512KB"
      ],
      "lifecycle": {
        "create": "消费者处理完毕后生产",
        "update": "无更新操作",
        "delete": "消息消费后自动删除",
        "retention": "持久化消息，消费后删除"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "发布部署任务消息",
      "status": "active",
      "version": 1,
      "description": "Business Service通过该接口将部署任务发布到RabbitMQ",
      "type": "internal",
      "request": {
        "protocol": "AMQP",
        "message_format": "JSON",
        "schema_id": "DM-001",
        "routing_key": "deploy.task.request",
        "exchange": "deploy.exchange",
        "exchange_type": "direct"
      },
      "response": {
        "body": {
          "type": "object",
          "properties": {
            "accepted": {
              "type": "boolean",
              "description": "是否被broker接受"
            }
          },
          "description": "发布确认响应"
        }
      },
      "errors": [
        {
          "code": "CONNECTION_ERROR",
          "message": "无法连接到RabbitMQ",
          "handling": "重试连接并告警"
        },
        {
          "code": "PUBLISH_REJECTED",
          "message": "消息被拒绝（如路由失败）",
          "handling": "落入死信队列并通知"
        }
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "source_components": [
        "CMP-001",
        "CMP-002"
      ]
    },
    {
      "id": "IF-002",
      "name": "消费部署结果消息",
      "status": "active",
      "version": 1,
      "description": "部署引擎执行完成后，通过该接口接收结果消息",
      "type": "internal",
      "request": {
        "protocol": "AMQP",
        "message_format": "JSON",
        "schema_id": "DM-002",
        "routing_key": "deploy.result.response",
        "queue": "deploy.result.queue",
        "exchange": "deploy.exchange",
        "exchange_type": "direct"
      },
      "response": {
        "body": {
          "type": "object",
          "properties": {
            "ack": {
              "type": "boolean",
              "description": "确认消息"
            }
          },
          "description": "消费确认响应"
        }
      },
      "errors": [
        {
          "code": "CONSUME_ERROR",
          "message": "消费时发生异常",
          "handling": "消息重新入队或转入死信"
        }
      ],
      "source_contracts": [
        "CTR-002"
      ],
      "source_components": [
        "CMP-003"
      ]
    }
  ],
  "topology": {
    "exchanges": [
      {
        "name": "deploy.exchange",
        "type": "direct",
        "durable": true,
        "description": "部署任务直连交换机"
      }
    ],
    "queues": [
      {
        "name": "deploy.task.queue",
        "durable": true,
        "arguments": {
          "x-dead-letter-exchange": "deploy.dlx.exchange",
          "x-dead-letter-routing-key": "deploy.task.dlq"
        },
        "description": "部署任务队列"
      },
      {
        "name": "deploy.result.queue",
        "durable": true,
        "arguments": {},
        "description": "部署结果队列"
      },
      {
        "name": "deploy.task.dlq",
        "durable": true,
        "arguments": {},
        "description": "部署任务死信队列"
      }
    ],
    "bindings": [
      {
        "source": "deploy.exchange",
        "destination": "deploy.task.queue",
        "routing_key": "deploy.task.request",
        "destination_type": "queue"
      },
      {
        "source": "deploy.exchange",
        "destination": "deploy.result.queue",
        "routing_key": "deploy.result.response",
        "destination_type": "queue"
      }
    ]
  },
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "部署任务发布契约",
      "status": "active",
      "version": 1,
      "description": "定义部署任务消息的发布契约，包括队列绑定、消息格式和QoS",
      "source_components": [
        "CMP-001",
        "CMP-002"
      ],
      "provider": "CMP-001",
      "consumer": "CMP-003",
      "protocol": "AMQP",
      "message_schema": "DM-001",
      "topology": {
        "exchange": "deploy.exchange",
        "queue": "deploy.task.queue",
        "routing_key": "deploy.task.request",
        "exchange_type": "direct"
      },
      "qos": {
        "prefetch_count": 10
      },
      "methods": [
        {
          "name": "publishDeployTask",
          "type": "publish",
          "description": "发布部署任务消息",
          "request_schema": "DM-001",
          "response_schema": "none",
          "errors": [
            "PUBLISH_REJECTED"
          ]
        }
      ],
      "business_rules": [
        "消息必须持久化",
        "发布必须启用publisher confirm"
      ]
    },
    {
      "id": "SC-002",
      "name": "部署结果消费契约",
      "status": "active",
      "version": 1,
      "description": "定义部署结果消息的消费契约，包括队列绑定、消息格式和QoS",
      "source_components": [
        "CMP-003"
      ],
      "provider": "CMP-003",
      "consumer": "CMP-001",
      "protocol": "AMQP",
      "message_schema": "DM-002",
      "topology": {
        "exchange": "deploy.exchange",
        "queue": "deploy.result.queue",
        "routing_key": "deploy.result.response",
        "exchange_type": "direct"
      },
      "qos": {
        "prefetch_count": 5
      },
      "methods": [
        {
          "name": "consumeDeployResult",
          "type": "consume",
          "description": "消费部署结果消息",
          "request_schema": "DM-002",
          "response_schema": "none",
          "errors": [
            "CONSUME_ERROR"
          ]
        }
      ],
      "business_rules": [
        "消息必须手动确认",
        "消费失败时执行重试策略"
      ]
    }
  ],
  "error_handling": {
    "strategy": "dead_letter_with_retry",
    "retry_policy": {
      "max_attempts": 3,
      "initial_interval_ms": 1000,
      "backoff_multiplier": 2
    },
    "dead_letter_queue": "deploy.task.dlq",
    "fallback_action": "记录日志并通知运维"
  }
}