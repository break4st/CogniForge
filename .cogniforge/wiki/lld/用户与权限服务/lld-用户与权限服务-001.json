  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "UserService",
      "description": "用户认证与授权服务",
      "methods": [
        {
          "name": "Signup",
          "signature": "Signup(ctx context.Context, req SignupRequest) (*User, error)",
          "description": "用户注册",
          "precondition": "用户名和邮箱未占用",
          "postcondition": "创建新用户并返回用户信息",
          "parameters": [
            { "name": "ctx", "type": "context.Context", "description": "上下文" },
            { "name": "req", "type": "SignupRequest", "description": "注册请求" }
          ],
          "returns": [
            { "type": "*User", "description": "新创建的用户" },
            { "type": "error", "description": "错误信息" }
          ],
          "errors": ["USERNAME_EXISTS", "EMAIL_EXISTS", "VALIDATION_ERROR"]
        },
        {
          "name": "Login",
          "signature": "Login(ctx context.Context, req LoginRequest) (*TokenPair, error)",
          "description": "用户登录",
          "precondition": "提供的凭据有效且账号状态正常",
          "postcondition": "返回JWT令牌对",
          "parameters": [
            { "name": "ctx", "type": "context.Context", "description": "上下文" },
            { "name": "req", "type": "LoginRequest", "description": "登录请求" }
          ],
          "returns": [
            { "type": "*TokenPair", "description": "令牌对" },
            { "type": "error", "description": "错误信息" }
          ],
          "errors": ["INVALID_CREDENTIALS", "ACCOUNT_SUSPENDED"]
        },
        {
          "name": "RefreshToken",
          "signature": "RefreshToken(ctx context.Context, refreshToken string) (*TokenPair, error)",
          "description": "刷新令牌",
          "precondition": "refreshToken 有效且未过期/吊销",
          "postcondition": "新令牌对生成，旧refreshToken失效",
          "parameters": [
            { "name": "ctx", "type": "context.Context", "description": "上下文" },
            { "name": "refreshToken", "type": "string", "description": "刷新令牌" }
          ],
          "returns": [
            { "type": "*TokenPair", "description": "新令牌对" },
            { "type": "error", "description": "错误信息" }
          ],
          "errors": ["INVALID_REFRESH_TOKEN", "TOKEN_REVOKED", "TOKEN_EXPIRED"]
        },
        {
          "name": "GetProfile",
          "signature": "GetProfile(ctx context.Context, userId string) (*User, error)",
          "description": "获取用户个人资料",
          "precondition": "用户ID有效",
          "postcondition": "返回用户信息",
          "parameters": [
            { "name": "ctx", "type": "context.Context", "description": "上下文" },
            { "name": "userId", "type": "string", "description": "用户ID" }
          ],
          "returns": [
            { "type": "*User", "description": "用户信息" },
            { "type": "error", "description": "错误信息" }
          ],
          "errors": ["USER_NOT_FOUND"]
        },
        {
          "name": "ChangePassword",
          "signature": "ChangePassword(ctx context.Context, userId string, oldPassword, newPassword string) error",
          "description": "修改密码",
          "precondition": "旧密码正确，新密码满足强度要求",
          "postcondition": "密码更新",
          "parameters": [
            { "name": "ctx", "type": "context.Context", "description": "上下文" },
            { "name": "userId", "type": "string", "description": "用户ID" },
            { "name": "oldPassword", "type": "string", "description": "旧密码" },
            { "name": "newPassword", "type": "string", "description": "新密码" }
          ],
          "returns": [
            { "type": "error", "description": "错误信息" }