  "overview": {
    "description": "管理数字身份与访问控制，向上游（API 网关、其他微服务）提供统一的认证与授权决策点。核心功能包括用户账号生命周期、JWT 令牌管理、RBAC 权限模型。",
    "dependencies": [],
    "tech_stack": [
      "Go",
      "Gin",
      "PostgreSQL",
      "Redis"
    ]
  },
