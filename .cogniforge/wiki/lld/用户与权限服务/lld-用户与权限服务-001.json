  "data_models": [
    {
      "id": "DM-001",
      "name": "users",
      "type": "table",
      "description": "用户表",
      "columns": [
        { "name": "id", "type": "UUID", "required": true, "description": "主键" },
        { "name": "username", "type": "VARCHAR(255)", "required": true, "unique": true, "description": "用户名" },
        { "name": "email", "type": "VARCHAR(255)", "required": true, "unique": true, "description": "邮箱" },
        { "name": "password_hash", "type": "VARCHAR(255)", "required": true, "description": "密码哈希" },
        { "name": "status", "type": "VARCHAR(20)", "required": true, "default": "active", "description": "账号状态" },
        { "name": "created_at", "type": "TIMESTAMPTZ", "required": true, "default": "NOW()", "description": "创建时间" },
        { "name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "default": "NOW()", "description": "更新时间" }
      ],
      "constraints": [
        "PRIMARY KEY (id)",
        "UNIQUE (username)",
        "UNIQUE (email)"
      ],
      "indexes": [
        "INDEX idx_users_username ON users(username)",
        "INDEX idx_users_email ON users(email)"
      ]
    },
    {
      "id": "DM-002",
      "name": "roles",
      "type": "table",
      "description": "角色表",
      "columns": [
        { "name": "id", "type": "UUID", "required": true, "description": "主键" },
        { "name": "name", "type": "VARCHAR(100)", "required": true, "unique": true, "description": "角色名称" },
        { "name": "description", "type": "TEXT", "required": false, "description": "角色描述" },
        { "name": "created_at", "type": "TIMESTAMPTZ", "required": true, "default": "NOW()", "description": "创建时间" }
      ],
      "constraints": [
        "PRIMARY KEY (id)",
        "UNIQUE (name)"
      ],
      "indexes": [
        "INDEX idx_roles_name ON roles(name)"
      ]
    },
    {
      "id": "DM-003",
      "name": "permissions",
      "type": "table",
      "description": "权限表",
      "columns": [
        { "name": "id", "type": "UUID", "required": true, "description": "主键" },
        { "name": "resource", "type": "VARCHAR(255)", "required": true, "description": "资源标识" },
        { "name": "action", "type": "VARCHAR(50)", "required": true, "description": "操作" }
      ],
      "constraints": [
        "PRIMARY KEY (id)",
        "UNIQUE (resource, action)"
      ],
      "indexes": [
        "INDEX idx_permissions_resource_action ON permissions(resource, action)"
      ]
    },
    {
      "id": "DM-004",
      "name": "user_roles",
      "type": "table",
      "description": "用户角色关联表",
      "columns": [
        { "name": "user_id", "type": "UUID", "required": true, "description": "用户ID" },
        { "name": "role_id", "type": "UUID", "required": true, "description": "角色ID" }
      ],
      "constraints": [
        "PRIMARY KEY (user_id, role_id)",
        "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE",
        "FOREIGN KEY (role_id) REFERENCES roles(id) ON DELETE CASCADE"
      ],
      "indexes": [
        "INDEX idx_user_roles_user_id ON user_roles(user_id)",
        "INDEX idx_user_roles_role_id ON user_roles(role_id)"
      ]
    },
    {
      "id": "DM-005",
      "name": "role_permissions",
      "type": "table",
      "description": "角色权限关联表",
      "columns": [
        { "name": "role_id", "type": "UUID", "required": true, "description": "角色ID" },
        { "name": "permission_id", "type": "UUID", "required": true, "description": "权限ID" }
      ],
      "constraints": [
        "PRIMARY KEY (role_id, permission_id)",
        "FOREIGN KEY (role_id) REFERENCES roles(id) ON DELETE CASCADE",
        "FOREIGN KEY (permission_id) REFERENCES permissions(id) ON DELETE CASCADE"
      ],
      "indexes": [
        "INDEX idx_role_permissions_role_id ON role_permissions(role_id)",
        "INDEX idx_role_permissions_permission_id ON role_permissions(permission_id)"
      ]
    },
    {
      "id": "DM-006",
      "name": "refresh_tokens",
      "type": "table",
      "description": "刷新令牌存储表",
      "columns": [
        { "name": "id", "type": "UUID", "required": true, "description": "主键" },
        { "name": "user_id", "type": "UUID", "required": true, "description": "关联用户ID" },
        { "name": "token", "type": "VARCHAR(512)", "required": true, "unique": true, "description": "令牌值" },
        { "name": "expires_at", "type": "TIMESTAMPTZ", "required": true, "description": "过期时间" },
        { "name": "created_at", "type": "TIMESTAMPTZ", "required": true, "default": "NOW()", "description": "创建时间" },
        { "name": "revoked", "type": "BOOLEAN", "required": true, "default": "false", "description": "是否已吊销" }
      ],
      "constraints": [
        "PRIMARY KEY (id)",
        "UNIQUE (token)",
        "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"
      ],
      "indexes": [
        "INDEX idx_refresh_tokens_token ON refresh_tokens(token)",
        "INDEX idx_refresh_tokens_user_id ON refresh_tokens(user_id)"
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "用户注册",
      "endpoint": {
        "method": "POST",
        "path": "/api/v1/users/signup"
      },
      "protocol": "HTTP",
      "description": "注册新用户账号",
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "username": { "type": "string", "description": "用户名" },
            "email": { "type": "string", "format": "email", "description": "邮箱" },
            "password": { "type": "string", "description": "密码" }
          },
          "required": ["username", "email", "password"]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "format": "uuid", "description": "用户ID" },
            "username": { "type": "string" },
            "email": { "type": "string" },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      },
      "error_codes": [
        { "code": "USERNAME_EXISTS", "status": 409, "message": "用户名已存在" },
        { "code": "EMAIL_EXISTS", "status": 409, "message": "邮箱已存在" },
        { "code": "VALIDATION_ERROR", "status": 400, "message": "输入参数校验失败" }
      ]
    },
    {
      "id": "IF-002",
      "name": "用户登录",
      "endpoint": {
        "method": "POST",
        "path": "/api/v1/users/login"
      },
      "protocol": "HTTP",
      "description": "用户凭据登录，返回JWT令牌对",
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" }
          },
          "required": ["username", "password"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "access_token": { "type": "string" },
            "refresh_token": { "type": "string" },
            "expires_in": { "type": "integer" }
          }
        }
      },
      "error_codes": [
        { "code": "INVALID_CREDENTIALS", "status": 401, "message": "用户名或密码错误" },
        { "code": "ACCOUNT_SUSPENDED", "status": 403, "message": "账号已被暂停" }
      ]
    },
    {
      "id": "IF-003",
      "name": "刷新令牌",
      "endpoint": {
        "method": "POST",
        "path": "/api/v1/users/refresh"
      },
      "protocol": "HTTP",
      "description": "使用refresh token刷新access token",
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "refresh_token": { "type": "string" }
          },
          "required": ["refresh_token"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "access_token": { "type": "string" },
            "refresh_token": { "type": "string" },
            "expires_in": { "type": "integer" }
          }
        }
      },
      "error_codes": [
        { "code": "INVALID_REFRESH_TOKEN", "status": 401, "message": "无效的刷新令牌" },
        { "code": "TOKEN_REVOKED", "status": 401, "message": "令牌已吊销" },
        { "code": "TOKEN_EXPIRED", "status": 401, "message": "令牌已过期" }
      ]
    },
    {
      "id": "IF-004",
      "name": "查看个人资料",
      "endpoint": {
        "method": "GET",
        "path": "/api/v1/users/profile"
      },
      "protocol": "HTTP",
      "description": "获取当前登录用户的个人资料",
      "request": {
        "headers": {
          "Authorization": { "type": "string", "description": "Bearer <access_token>" }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "format": "uuid" },
            "username": { "type": "string" },
            "email": { "type": "string" },
            "status": { "type": "string" },
            "created_at": { "type": "string", "format": "date-time" }
          }
        }
      },
      "error_codes": [
        { "code": "UNAUTHORIZED", "status": 401, "message": "未提供有效令牌" },
        { "code": "USER_NOT_FOUND", "status": 404, "message": "用户不存在" }
      ]
    },
    {
      "id": "IF-005",
      "name": "修改密码",
      "endpoint": {
        "method": "PUT",
        "path": "/api/v1/users/password"
      },
      "protocol": "HTTP",
      "description": "修改当前用户密码",
      "request": {
        "headers": {
          "Authorization": { "type": "string", "description": "Bearer <access_token>" }
        },
        "body": {
          "type": "object",
          "properties": {
            "old_password": { "type": "string" },
            "new_password": { "type": "string" }
          },
          "required": ["old_password", "new_password"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "message": { "type": "string", "example": "Password updated successfully" }
          }
        }
      },
      "error_codes": [
        { "code": "INVALID_PASSWORD", "status": 400, "message": "旧密码错误" },
        { "code": "WEAK_PASSWORD", "status": 400, "message": "新密码强度不足" },
        { "code": "UNAUTHORIZED", "status": 401, "message": "未提供有效令牌" }
      ]
    },
    {
      "id": "IF-006",
      "name": "角色CRUD",
      "endpoint": {
        "method": "POST",
        "path": "/api/v1/admin/roles"
      },
      "protocol": "HTTP",
      "description": "管理角色（创建、更新、删除、查询）",
      "request": {
        "headers": {
          "Authorization": { "type": "string", "description": "Bearer <access_token>" }
        },
        "body": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["create", "update", "delete", "list"] },
            "role_id": { "type": "string", "format": "uuid", "description": "更新或删除时提供" },
            "name": { "type": "string", "description": "角色名称" },
            "description": { "type": "string" }
          },
          "required": ["action"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "oneOf": [
            {
              "description": "列表响应",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            {
              "description": "单个角色响应",
              "type": "object",
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          ]
        }
      },
      "error_codes": [
        { "code": "FORBIDDEN", "status": 403, "message": "无管理员权限" },
        { "code": "ROLE_EXISTS", "status": 409, "message": "角色名已存在" },
        { "code": "VALIDATION_ERROR", "status": 400, "message": "输入参数校验失败" }
      ]
    },
    {
      "id": "IF-007",
      "name": "分配用户角色",
      "endpoint": {
        "method": "POST",
        "path": "/api/v1/admin/users/roles"
      },
      "protocol": "HTTP",
      "description": "为用户分配或移除角色",
      "request": {
        "headers": {
          "Authorization": { "type": "string", "description": "Bearer <access_token>" }
        },
        "body": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "format": "uuid" },
            "role_ids": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" },
              "description": "要分配的角色ID列表"
            }
          },
          "required": ["user_id", "role_ids"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "message": { "type": "string", "example": "Roles updated successfully" }
          }
        }
      },
      "error_codes": [
        { "code": "FORBIDDEN", "status": 403, "message": "无管理员权限" },
        { "code": "USER_NOT_FOUND", "status": 404, "message": "用户不存在" },
        { "code": "ROLE_NOT_FOUND", "status": 404, "message": "角色不存在" }
      ]
    },
    {
      "id": "IF-008",
      "name": "权限列表查询",
      "endpoint": {
        "method": "GET",
        "path": "/api/v1/admin/permissions"
      },
      "protocol": "HTTP",
      "description": "获取所有权限列表",
      "request": {
        "headers": {
          "Authorization": { "type": "string", "description": "Bearer <access_token>" }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "resource": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        }
      },
      "error_codes": [
        { "code": "FORBIDDEN", "status": 403, "message": "需要管理员权限" }
      ]
    },
    {
      "id": "IF-009",
      "name": "令牌验证（内部）",
      "endpoint": {
        "method": "POST",
        "path": "/internal/verify-token"
      },
      "protocol": "HTTP",
      "description": "供其他服务内部调用的令牌验证接口",
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "token": { "type": "string" }
          },
          "required": ["token"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "valid": { "type": "boolean" },
            "user_id": { "type": "string", "format": "uuid" },
            "username": { "type": "string" },
            "roles": { "type": "array", "items": { "type": "string" } },
            "permissions": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "error_codes": [
        { "code": "INVALID_TOKEN", "status": 401, "message": "令牌无效" }
      ]
    },
    {
      "id": "IF-010",
      "name": "权限检查（内部）",
      "endpoint": {
        "method": "POST",
        "path": "/internal/check-permission"
      },
      "protocol": "HTTP",
      "description": "检查用户是否具备某个权限",
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "user_id": { "type": "string", "format": "uuid" },
            "permission": { "type": "string", "description": "资源:操作 格式" }
          },
          "required": ["user_id", "permission"]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "allowed": { "type": "boolean" }
          }
        }
      },
      "error_codes": [
        { "code": "USER_NOT_FOUND", "status": 404, "message": "用户不存在" }
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "object_type": "entity",
      "name": "User",
      "description": "用户实体，代表系统中的账户信息",
      "attributes": [
        { "name": "id", "type": "UUID", "required": true, "description": "唯一标识" },
        { "name": "username", "type": "string", "required": true, "description": "用户名" },
        { "name": "email", "type": "string", "required": true, "description": "邮箱" },
        { "name": "passwordHash", "type": "string", "required": true, "description": "密码哈希" },
        { "name": "status", "type": "UserStatus", "required": true, "description": "账号状态" },
        { "name": "createdAt", "type": "timestamp", "required": true, "description": "创建时间" },
        { "name": "updatedAt", "type": "timestamp", "required": true, "description": "更新时间" }
      ],
      "methods": [],
      "relationships": [
        { "target": "Role", "type": "many-to-many", "via": "user_roles" }
      ],
      "invariants": [
        "username 全局唯一",
        "email 全局唯一"
      ],
      "behaviour": "用户注册后创建，更新资料时修改，软删除时状态变更为 deleted",
      "source_requirements": ["REQ-001"]
    },
    {
      "id": "DO-002",
      "object_type": "entity",
      "name": "Role",
      "description": "角色实体，用于权限分组",
      "attributes": [
        { "name": "id", "type": "UUID", "required": true, "description": "唯一标识" },
        { "name": "name", "type": "string", "required": true, "description": "角色名称" },
        { "name": "description", "type": "string", "required": false, "description": "描述信息" },
        { "name": "createdAt", "type": "timestamp", "required": true, "description": "创建时间" }
      ],
      "methods": [],
      "relationships": [
        { "target": "Permission", "type": "many-to-many", "via": "role_permissions" }
      ],
      "invariants": ["角色名称唯一"],
      "behaviour": "由管理员进行CRUD操作",
