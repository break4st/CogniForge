{
  "meta": {
    "doc_id": "lld-Primary Database-001",
    "type": "lld",
    "module_type": "ModuleType.DATABASE",
    "module": "Primary Database",
    "title": "LLD - Primary Database",
    "author": "design_agent",
    "created": "2026-05-21 09:50"
  },
  "overview": {
    "description": "MySQL 8.0主数据库，存储项目信息、环境配置、密钥元数据、部署记录和审计日志等持久化数据。作为系统的单点真相源（Single Source of Truth），为所有微服务提供ACID事务保障和结构化数据存储能力。",
    "dependencies": [],
    "tech_stack": ["MySQL 8.0"]
  },
  "data_models": [
    {
      "name": "projects",
      "type": "table",
      "ownership": "canonical",
      "description": "项目信息表，存储项目的核心信息。由Project Management Service负责此表的读写操作。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "项目ID，自增主键"},
        {"name": "name", "type": "varchar(255)", "required": true, "description": "项目名称，全局唯一"},
        {"name": "description", "type": "text", "required": false, "description": "项目描述"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "datetime", "required": true, "description": "更新时间"}
      ],
      "indexes": [
        {"name": "PRIMARY", "type": "BTREE", "fields": ["id"], "unique": true},
        {"name": "uk_name", "type": "BTREE", "fields": ["name"], "unique": true},
        {"name": "idx_created_at", "type": "BTREE", "fields": ["created_at"], "unique": false}
      ]
    },
    {
      "name": "environments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署环境配置表，存储每个环境的连接参数和类型信息，通过project_id与项目关联。由Environment Management Service负责此表的读写操作。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "环境ID，自增主键"},
        {"name": "project_id", "type": "bigint", "required": true, "description": "所属项目ID，外键关联projects表"},
        {"name": "name", "type": "varchar(255)", "required": true, "description": "环境名称，同一项目内唯一"},
        {"name": "type", "type": "enum('test','gray','production')", "required": true, "description": "环境类型：test-测试线，gray-灰度线，production-正式线"},
        {"name": "host", "type": "varchar(255)", "required": true, "description": "远程主机地址（IP或域名）"},
        {"name": "port", "type": "int", "required": true, "description": "SSH端口号，默认22"},
        {"name": "username", "type": "varchar(128)", "required": true, "description": "SSH登录用户名"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "datetime", "required": true, "description": "更新时间"}
      ],
      "indexes": [
        {"name": "PRIMARY", "type": "BTREE", "fields": ["id"], "unique": true},
        {"name": "idx_project_id", "type": "BTREE", "fields": ["project_id"], "unique": false},
        {"name": "uk_project_env", "type": "BTREE", "fields": ["project_id", "name"], "unique": true},
        {"name": "idx_created_at", "type": "BTREE", "fields": ["created_at"], "unique": false}
      ]
    },
    {
      "name": "environment_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "SSH密钥元数据表，存储每个环境关联的SSH密钥加密信息和指纹。密钥内容经AES-256-GCM加密后存储，通过env_id与环境关联。由Key Management Service负责此表的读写操作。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "密钥ID，自增主键"},
        {"name": "env_id", "type": "bigint", "required": true, "description": "环境ID，外键关联environments表，每个环境最多一条记录"},
        {"name": "key_type", "type": "enum('rsa','ed25519')", "required": true, "description": "密钥类型：rsa或ed25519"},
        {"name": "encrypted_key", "type": "text", "required": true, "description": "AES-256-GCM加密后的SSH私钥内容（Base64编码存储）"},
        {"name": "fingerprint", "type": "varchar(255)", "required": true, "description": "密钥指纹，用于标识和验证密钥"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "datetime", "required": true, "description": "更新时间"}
      ],
      "indexes": [
        {"name": "PRIMARY", "type": "BTREE", "fields": ["id"], "unique": true},
        {"name": "uk_env_id", "type": "BTREE", "fields": ["env_id"], "unique": true},
        {"name": "idx_env_id", "type": "BTREE", "fields": ["env_id"], "unique": false}
      ]
    },
    {
      "name": "deployments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署任务记录表，存储每次部署的元数据和状态变化。由Deployment Orchestrator负责此表的读写操作，SSH Execution Service通过MQ间接更新状态。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "部署任务ID，自增主键"},
        {"name": "project_id", "type": "bigint", "required": true, "description": "项目ID，关联projects表"},
        {"name": "environment_id", "type": "bigint", "required": true, "description": "目标环境ID，关联environments表"},
        {"name": "version", "type": "varchar(64)", "required": true, "description": "版本号，如 v1.2.3"},
        {"name": "artifact_path", "type": "varchar(512)", "required": true, "description": "可执行文件路径或下载URL"},
        {"name": "description", "type": "varchar(1024)", "required": false, "description": "部署说明"},
        {"name": "status", "type": "enum('pending','running','success','failed')", "required": true, "description": "部署状态：pending-待执行，running-执行中，success-成功，failed-失败"},
        {"name": "progress", "type": "int", "required": true, "description": "进度百分比0-100，默认0"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "创建时间"},
        {"name": "started_at", "type": "datetime", "required": false, "description": "开始部署时间"},
        {"name": "finished_at", "type": "datetime", "required": false, "description": "部署完成时间"}
      ],
      "indexes": [
        {"name": "PRIMARY", "type": "BTREE", "fields": ["id"], "unique": true},
        {"name": "idx_project_id", "type": "BTREE", "fields": ["project_id"], "unique": false},
        {"name": "idx_environment_id", "type": "BTREE", "fields": ["environment_id"], "unique": false},
        {"name": "idx_status", "type": "BTREE", "fields": ["status"], "unique": false},
        {"name": "idx_created_at", "type": "BTREE", "fields": ["created_at"], "unique": false}
      ]
    },
    {
      "name": "deployment_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "部署日志表，记录部署执行过程中产生的详细操作日志。由Deployment Orchestrator在接收SSH执行日志后写入此表。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "日志ID，自增主键"},
        {"name": "deployment_id", "type": "bigint", "required": true, "description": "部署任务ID，关联deployments表"},
        {"name": "level", "type": "enum('info','warn','error')", "required": true, "description": "日志级别：info-信息，warn-警告，error-错误"},
        {"name": "message", "type": "text", "required": true, "description": "日志内容"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "日志记录时间"}
      ],
      "indexes": [
        {"name": "PRIMARY", "type": "BTREE", "fields": ["id"], "unique": true},
        {"name": "idx_deployment_id", "type": "BTREE", "fields": ["deployment_id"], "unique": false},
        {"name": "idx_created_at", "type": "BTREE", "fields": ["created_at"], "unique": false}
      ]
    },
    {
      "name": "audit_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "审计日志表，记录系统中所有关键操作的审计轨迹。由Audit Service在API Gateway调用后将操作信息写入此表。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "审计日志ID，自增主键"},
        {"name": "user_id", "type": "bigint", "required": true, "description": "操作用户ID"},
        {"name": "username", "type": "varchar(255)", "required": true, "description": "操作用户名"},
        {"name": "action_type", "type": "varchar(50)", "required": true, "description": "操作类型：create|update|delete|deploy|test|login"},
        {"name": "resource_type", "type": "varchar(50)", "required": true, "description": "资源类型：project|environment|key|deployment"},
        {"name": "resource_id", "type": "bigint", "required": true, "description": "操作资源ID"},
        {"name": "resource_name", "type": "varchar(255)", "required": false, "description": "操作资源名称，便于快速识别"},
        {"name": "detail", "type": "json", "required": false, "description": "操作详情JSON，记录请求关键字段和变更内容"},
        {"name": "ip_address", "type": "varchar(45)", "required": true, "description": "请求来源IP地址，支持IPv4和IPv6"},
        {"name": "result", "type": "varchar(20)", "required": true, "description": "操作结果：success|failure"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "审计日志记录时间"}
      ],
      "indexes": [
        {"name": "PRIMARY", "type": "BTREE", "fields": ["id"], "unique": true},
        {"name": "idx_user_id", "type": "BTREE", "fields": ["user_id"], "unique": false},
        {"name": "idx_action_type", "type": "BTREE", "fields": ["action_type"], "unique": false},
        {"name": "idx_resource_type", "type": "BTREE", "fields": ["resource_type"], "unique": false},
        {"name": "idx_created_at", "type": "BTREE", "fields": ["created_at"], "unique": false}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "MySQL Connection Pool",
      "method": "INTERNAL",
      "endpoint": "mysql://primary-database:3306/cogniforge",
      "description": "MySQL数据库连接池接口。所有微服务通过该接口建立到主数据库的连接，执行SQL操作。连接池参数由各服务的数据库客户端配置管理，包括最大连接数（默认20）、连接超时（默认5秒）、空闲连接回收时间等。",
      "parameters": [
        {"name": "host", "type": "string", "description": "数据库主机地址，容器内服务间访问使用 service name: primary-database"},
        {"name": "port", "type": "integer", "description": "MySQL服务端口，默认3306"},
        {"name": "database", "type": "string", "description": "数据库名称，默认cogniforge"},
        {"name": "user", "type": "string", "description": "数据库连接用户名，各服务使用独立的数据库账户以支持最小权限原则"},
        {"name": "password", "type": "string", "description": "数据库连接密码，通过环境变量注入，禁止硬编码"},
        {"name": "charset", "type": "string", "description": "字符集，默认 utf8mb4"},
        {"name": "pool_size", "type": "integer", "description": "连接池最大连接数，默认20"},
        {"name": "pool_recycle", "type": "integer", "description": "连接回收时间（秒），默认3600"},
        {"name": "pool_pre_ping", "type": "boolean", "description": "连接使用前是否执行探活检测，默认true"}
      ],
      "response": {
        "status": 200,
        "body": {
          "connection_id": "bigint",
          "server_version": "string",
          "connected": "boolean"
        }
      },
      "error_codes": [
        {"code": 2001, "message": "数据库连接超时（默认5秒）"},
        {"code": 2002, "message": "数据库认证失败：用户名或密码错误"},
        {"code": 2003, "message": "数据库不可达：主机地址错误或网络不可达"},
        {"code": 1045, "message": "访问被拒绝：用户权限不足"}
      ]
    },
    {
      "name": "Transaction Management",
      "method": "INTERNAL",
      "endpoint": "MySQL Transaction (InnoDB)",
      "description": "InnoDB事务管理接口。提供ACID事务保障，支持自动提交模式和显式事务控制（BEGIN/COMMIT/ROLLBACK）。默认隔离级别为READ COMMITTED，满足各服务对事务隔离性和并发性能的综合需求。",
      "parameters": [
        {"name": "isolation_level", "type": "string", "description": "事务隔离级别：READ COMMITTED（默认）| REPEATABLE READ | SERIALIZABLE"},
        {"name": "auto_commit", "type": "boolean", "description": "是否启用自动提交模式，默认true"},
        {"name": "timeout", "type": "integer", "description": "事务超时时间（秒），默认30，超时后自动回滚"}
      ],
      "response": {
        "status": 200,
        "body": {
          "transaction_id": "bigint",
          "committed": "boolean",
          "affected_rows": "integer"
        }
      },
      "error_codes": [
        {"code": 1213, "message": "死锁检测到，事务被回滚，需重试"},
        {"code": 1205, "message": "锁等待超时（默认50秒），事务被回滚"},
        {"code": 1062, "message": "唯一键冲突：违反UNIQUE约束，写入已存在的重复值"}
      ]
    }
  ],
  "error_handling": "1）连接层错误：数据库连接超时（5秒阈值）或连接池耗尽时，各微服务应实现连接重试机制（最多3次，指数退避），重试耗尽后返回500，响应体包含请求ID。2）查询超时：单条SQL查询超过默认5秒阈值时中断并记录慢查询日志，通过slow_query_log_file定位性能瓶颈。3）死锁错误（MySQL Error 1213）：InnoDB自动检测死锁并回滚受影响的事务，业务层需实现重试逻辑（至少1次）。4）唯一键冲突（MySQL Error 1062）：由服务层校验后捕获，转换为409 Conflict响应，不暴露数据库内部错误细节。5）约束违反：外键约束失败时返回相关错误码，服务层捕获后转换为404（引用的父记录不存在）或409（存在关联子记录禁止删除）。6）字段截断/类型不匹配：由FastAPI Pydantic模型在请求入口层校验，避免非法数据写入数据库。7）数据完整性保障：所有关键写操作均在事务中执行，事务失败时自动回滚保证数据一致性。所有数据库错误统一记录到各服务的应用日志，不向客户端暴露原始SQL错误信息。"
}
