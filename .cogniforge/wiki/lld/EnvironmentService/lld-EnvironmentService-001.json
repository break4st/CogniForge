{
  "meta": {
    "doc_id": "lld-EnvironmentService-001",
    "type": "lld",
    "module_type": "service",
    "module": "EnvironmentService",
    "title": "EnvironmentService LLD",
    "created": "2025-03-24T10:00:00Z",
    "author": "system",
    "status": "draft",
    "version": 1
  },
  "source": {
    "prd": {
      "doc_id": "prd-deploy-001",
      "version": 1
    },
    "sad": {
      "doc_id": "sad-EnvironmentService-001",
      "version": 1
    }
  },
  "overview": {
    "description": "环境配置服务，负责管理项目的部署环境配置，包括创建、编辑、删除、测试连接和设置默认环境。支持密码和私钥两种认证方式，并对敏感字段进行加密存储。"
  },
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "Environment",
      "object_type": "entity",
      "description": "环境配置实体，包含连接信息、认证方式及加密后的敏感字段。",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "description": "环境唯一标识",
          "source": "computed",
          "required": true
        },
        {
          "name": "projectId",
          "type": "string",
          "description": "所属项目 ID",
          "source": "input",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "description": "环境名称",
          "source": "input",
          "required": true
        },
        {
          "name": "host",
          "type": "string",
          "description": "SSH 主机地址",
          "source": "input",
          "required": true
        },
        {
          "name": "port",
          "type": "number",
          "description": "SSH 端口，默认 22",
          "source": "input",
          "required": false
        },
        {
          "name": "username",
          "type": "string",
          "description": "SSH 登录用户名",
          "source": "input",
          "required": true
        },
        {
          "name": "authType",
          "type": "string",
          "description": "认证方式",
          "source": "input",
          "required": true
        },
        {
          "name": "encryptedPassword",
          "type": "string",
          "description": "加密后的密码",
          "source": "derived",
          "required": false
        },
        {
          "name": "encryptedPrivateKey",
          "type": "string",
          "description": "加密后的私钥",
          "source": "derived",
          "required": false
        },
        {
          "name": "isDefault",
          "type": "boolean",
          "description": "是否为项目默认环境",
          "source": "input",
          "required": false
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "description": "创建时间",
          "source": "computed",
          "required": true
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "description": "更新时间",
          "source": "computed",
          "required": true
        }
      ]
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "EnvironmentModel",
      "description": "环境数据模型，对应数据库 environments 表",
      "fields": [
        { "name": "id", "type": "UUID", "description": "主键", "primary_key": true },
        { "name": "project_id", "type": "UUID", "description": "项目 ID", "foreign_key": "projects.id" },
        { "name": "name", "type": "VARCHAR(255)", "description": "环境名称" },
        { "name": "host", "type": "VARCHAR(255)", "description": "主机地址" },
        { "name": "port", "type": "INTEGER", "description": "SSH 端口" },
        { "name": "username", "type": "VARCHAR(255)", "description": "用户名" },
        { "name": "auth_type", "type": "VARCHAR(50)", "description": "认证类型" },
        { "name": "encrypted_password", "type": "TEXT", "description": "加密密码", "nullable": true },
        { "name": "encrypted_private_key", "type": "TEXT", "description": "加密私钥", "nullable": true },
        { "name": "is_default", "type": "BOOLEAN", "description": "是否默认" },
        { "name": "created_at", "type": "TIMESTAMP", "description": "创建时间" },
        { "name": "updated_at", "type": "TIMESTAMP", "description": "更新时间" }
      ],
      "constraints": [
        { "type": "UNIQUE", "fields": ["project_id", "name"] }
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "name 在同项目内唯一",
      "若 authType 为 password，则 password 必须提供且 privateKey 不可提供；若 authType 为 key，则 privateKey 必须提供且 password 不可提供",
      "加密后的密码和私钥应存储在对应的加密字段中",
      "同一项目下只能有一个默认环境，设置新的默认环境时需先取消旧的默认标识"
    ]
  },
  "service_contracts": {
    "description": "EnvironmentService 的 API 契约",
    "endpoints": [
      {
        "id": "IF-001",
        "name": "createEnvironment",
        "method": "POST",
        "endpoint": "/environments",
        "description": "创建环境配置",
        "request": {
          "body": {
            "description": "创建环境请求体",
            "required": true,
            "content_type": "application/json",
            "schema": {
              "type": "object",
              "properties": {
                "projectId": { "type": "string" },
                "name": { "type": "string" },
                "host": { "type": "string" },
                "port": { "type": "number" },
                "username": { "type": "string" },
                "authType": { "type": "string" },
                "password": { "type": "string" },
                "privateKey": { "type": "string" },
                "isDefault": { "type": "boolean" }
              },
              "required": ["projectId", "name", "host", "username", "authType"]
            }
          },
          "params": [],
          "query": []
        },
        "response": {
          "status": 201,
          "body": {
            "description": "成功创建环境后的响应体",
            "content_type": "application/json",
            "schema": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "projectId": { "type": "string" },
                "name": { "type": "string" },
                "host": { "type": "string" },
                "port": { "type": "number" },
                "username": { "type": "string" },
                "authType": { "type": "string" },
                "isDefault": { "type": "boolean" },
                "createdAt": { "type": "string", "format": "date-time" },
                "updatedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        },
        "authentication": "Bearer Token",
        "authorization": "需要创建环境权限",
        "status_codes": [201, 400, 401, 403, 409, 500]
      },
      {
        "id": "IF-002",
        "name": "editEnvironment",
        "method": "PUT",
        "endpoint": "/environments/{id}",
        "description": "编辑环境配置",
        "request": {
          "body": {
            "description": "编辑环境请求体",
            "required": true,
            "content_type": "application/json",
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "host": { "type": "string" },
                "port": { "type": "number" },
                "username": { "type": "string" },
                "authType": { "type": "string" },
                "password": { "type": "string" },
                "privateKey": { "type": "string" },
                "isDefault": { "type": "boolean" }
              }
            }
          },
          "params": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "type": "string",
              "description": "环境 ID"
            }
          ],
          "query": []
        },
        "response": {
          "status": 200,
          "body": {
            "description": "更新后的环境信息",
            "content_type": "application/json",
            "schema": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "projectId": { "type": "string" },
                "name": { "type": "string" },
                "host": { "type": "string" },
                "port": { "type": "number" },
                "username": { "type": "string" },
                "authType": { "type": "string" },
                "isDefault": { "type": "boolean" },
                "createdAt": { "type": "string", "format": "date-time" },
                "updatedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        },
        "authentication": "Bearer Token",
        "authorization": "需要编辑环境权限",
        "status_codes": [200, 400, 401, 403, 404, 409, 500]
      },
      {
        "id": "IF-003",
        "name": "deleteEnvironment",
        "method": "DELETE",
        "endpoint": "/environments/{id}",
        "description": "删除环境配置",
        "request": {
          "body": {},
          "params": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "type": "string",
              "description": "环境 ID"
            }
          ],
          "query": []
        },
        "response": {
          "status": 204,
          "body": {
            "description": "无内容"
          }
        },
        "authentication": "Bearer Token",
        "authorization": "需要删除环境权限",
        "status_codes": [204, 400, 401, 403, 404, 500]
      },
      {
        "id": "IF-004",
        "name": "testConnection",
        "method": "POST",
        "endpoint": "/environments/{id}/test-connection",
        "description": "测试环境连接",
        "request": {
          "body": {},
          "params": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "type": "string",
              "description": "环境 ID"
            }
          ],
          "query": []
        },
        "response": {
          "status": 200,
          "body": {
            "description": "连接测试结果",
            "content_type": "application/json",
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "message": { "type": "string" }
              }
            }
          }
        },
        "authentication": "Bearer Token",
        "authorization": "需要环境测试权限",
        "status_codes": [200, 400, 401, 403, 404, 500]
      },
      {
        "id": "IF-005",
        "name": "setDefaultEnvironment",
        "method": "PUT",
        "endpoint": "/environments/{id}/set-default",
        "description": "设置默认环境",
        "request": {
          "body": {},
          "params": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "type": "string",
              "description": "环境 ID"
            }
          ],
          "query": []
        },
        "response": {
          "status": 200,
          "body": {
            "description": "设置成功的环境信息",
            "content_type": "application/json",
            "schema": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "projectId": { "type": "string" },
                "name": { "type": "string" },
                "host": { "type": "string" },
                "port": { "type": "number" },
                "username": { "type": "string" },
                "authType": { "type": "string" },
                "isDefault": { "type": "boolean" },
                "createdAt": { "type": "string", "format": "date-time" },
                "updatedAt": { "type": "string", "format": "date-time" }
              }
            }
          }
        },
        "authentication": "Bearer Token",
        "authorization": "需要编辑环境权限",
        "status_codes": [200, 400, 401, 403, 404, 500]
      }
    ]
  },
  "interfaces": {
    "description": "环境服务对外接口定义",
    "methods": [
      {
        "name": "createEnvironment",
        "description": "创建环境，输入参数验证、加密敏感字段、持久化环境数据",
        "parameters": [
          { "name": "projectId", "type": "string", "required": true },
          { "name": "name", "type": "string", "required": true },
          { "name": "host", "type": "string", "required": true },
          { "name": "port", "type": "number", "required": false },
          { "name": "username", "type": "string", "required": true },
          { "name": "authType", "type": "string", "required": true },
          { "name": "password", "type": "string", "required": false },
          { "name": "privateKey", "type": "string", "required": false },
          { "name": "isDefault", "type": "boolean", "required": false }
        ],
        "return_type": "Environment",
        "exceptions": ["ValidationError", "DuplicateNameError", "EncryptionError"]
      },
      {
        "name": "editEnvironment",
        "description": "编辑环境，更新字段并重新加密敏感字段",
        "parameters": [
          { "name": "id", "type": "string", "required": true },
          { "name": "updates", "type": "object", "required": true }
        ],
        "return_type": "Environment",
        "exceptions": ["NotFoundError", "ValidationError", "EncryptionError"]
      },
      {
        "name": "deleteEnvironment",
        "description": "删除环境",
        "parameters": [
          { "name": "id", "type": "string", "required": true }
        ],
        "return_type": "void",
        "exceptions": ["NotFoundError"]
      },
      {
        "name": "testConnection",
        "description": "测试 SSH 连接",
        "parameters": [
          { "name": "id", "type": "string", "required": true }
        ],
        "return_type": "TestResult",
        "exceptions": ["NotFoundError", "ConnectionError"]
      },
      {
        "name": "setDefaultEnvironment",
        "description": "设置默认环境，先取消原有默认再设置新默认",
        "parameters": [
          { "name": "id", "type": "string", "required": true }
        ],
        "return_type": "Environment",
        "exceptions": ["NotFoundError"]
      }
    ]
  },
  "error_handling": {
    "strategy": {
      "description": "统一错误处理策略：使用 HTTP 状态码和 JSON 错误体，包含错误码和消息。未知错误返回 500。",
      "error_codes": [
        { "code": "ENV_NOT_FOUND", "status": 404, "message": "环境不存在" },
        { "code": "DUPLICATE_NAME", "status": 409, "message": "环境名称已存在" },
        { "code": "VALIDATION_ERROR", "status": 400, "message": "输入验证失败" },
        { "code": "ENCRYPTION_ERROR", "status": 500, "message": "加密失败" },
        { "code": "CONNECTION_ERROR", "status": 500, "message": "SSH 连接失败" },
        { "code": "UNAUTHORIZED", "status": 401, "message": "未认证" },
        { "code": "FORBIDDEN", "status": 403, "message": "无权限" }
      ]
    }
  }
}