  "service_contracts": [
    {
      "id": "SC-001",
      "name": "EnvironmentServiceContract",
      "description": "环境管理服务契约",
      "methods": [
        {
          "name": "createEnvironment",
          "description": "创建新环境",
          "precondition": "项目存在且用户有权限，环境名在项目内唯一",
          "postcondition": "环境已持久化，凭据已加密",
          "parameters": {
            "dto": "CreateEnvironmentDTO"
          },
          "returns": "Environment",
          "errors": [
            "ProjectNotFoundError",
            "DuplicateEnvironmentError",
            "EncryptionError"
          ],
          "semantics": "接收明文凭据，调用 SecurityService 加密后保存到数据库"
        },
        {
          "name": "getEnvironment",
          "description": "根据 ID 获取环境详情",
          "precondition": "环境存在且请求者有权访问所属项目",
          "postcondition": "返回环境信息，敏感字段保持加密",
          "parameters": {
            "id": "EnvironmentIdDTO"
          },
          "returns": "Environment",
          "errors": [
            "EnvironmentNotFoundError",
            "PermissionDeniedError"
          ],
          "semantics": "从数据库读取，不解密凭据"
        },
        {
          "name": "listEnvironments",
          "description": "列出指定项目的所有环境",
          "precondition": "项目存在且用户有权限",
          "postcondition": "返回环境列表",
          "parameters": {
            "filter": "EnvironmentFilterDTO"
          },
          "returns": "Environment[]",
          "errors": [
            "ProjectNotFoundError",
            "PermissionDeniedError"
          ],
          "semantics": "查询数据库，按项目 ID 过滤"
        },
        {
          "name": "updateEnvironment",
          "description": "更新环境信息",
          "precondition": "环境存在且用户有权限，若更改凭据则新凭据有效",
          "postcondition": "环境已更新，新凭据已重新加密",
          "parameters": {
            "dto": "UpdateEnvironmentDTO"
          },
          "returns": "Environment",
          "errors": [
            "EnvironmentNotFoundError",
            "PermissionDeniedError",
            "EncryptionError"
          ],
          "semantics": "部分更新，若提供密码或私钥则重新加密后替换"
        },
        {
          "name": "deleteEnvironment",
          "description": "删除环境",
          "precondition": "环境存在且无关联的进行中部署",
          "postcondition": "环境已删除",
          "parameters": {
            "id": "EnvironmentIdDTO"
          },
          "returns": "void",
          "errors": [
            "EnvironmentNotFoundError",
            "PermissionDeniedError",
            "EnvironmentInUseError"
          ],
          "semantics": "物理删除记录"
        },
        {
          "name": "testConnection",
          "description": "测试 SSH 连接并获取远程主目录",
          "precondition": "环境存在且凭据可解密",
          "postcondition": "连接测试完成，不改变环境数据",
          "parameters": {
            "dto": "TestConnectionDTO"
          },
          "returns": "ConnectionResultDTO",
          "errors": [
            "EnvironmentNotFoundError",
            "DecryptionError",
            "SshConnectionError"
          ],
          "semantics": "解密凭据后构造 ConnectionConfig 调用 SSHService.testConnection"
        }
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "环境的 projectId 在创建后不可变",
      "同一项目下环境名称唯一",
      "authType 必须为 'password' 或 'key'",
      "凭据（密码或私钥）在存储前必须加密",
      "删除环境前必须检查无关联的进行中部署"
    ],
    "rules": [
      {
        "id": "BR-001",
        "description": "创建环境时，必须对明文凭据进行加密",
        "trigger": "createEnvironment 调用",
        "action": "调用 SecurityService.encrypt(password) 或 encrypt(privateKey)",
        "precondition": "提供了有效的明文凭据"
      },
      {
        "id": "BR-002",
        "description": "更新环境凭据时，新的明文凭据必须重新加密",
        "trigger": "updateEnvironment 调用且包含密码或私钥字段",
        "action": "解密旧凭据（如果需要），加密新凭据"
      },
      {
        "id": "BR-003",
        "description": "测试连接时，解密存储的凭据以明文传递给 SSHService",
        "trigger": "testConnection 调用",
        "action": "调用 SecurityService.decrypt 获取明文，构造 ConnectionConfig"
      },
      {
        "id": "BR-004",
        "description": "所有操作必须校验 projectId 权限",
        "trigger": "任何环境操作",
        "action": "验证当前用户对 projectId 的访问权"
      }
    ]
  },
  "error_handling": {
    "strategy": "每项服务操作均通过 try-catch 捕获异常，将领域异常映射为统一错误响应。对外暴露明确的错误码和消息，内部记录详细日志。",
    "errors": [
      {
        "code": "ENV-001",
        "message": "Environment not found",
        "http_status": 404,
        "handling": "返回此错误，前端展示未找到环境"
      },
      {
        "code": "ENV-002",
        "message": "Duplicate environment name in project",
