    {
      "id": "IF-002",
      "endpoint": "POST /projects/{project_id}/environments",
      "description": "在指定项目下创建新环境",
      "parameters": [
        {
          "name": "project_id",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "项目 ID"
        }
      ],
      "request": {
        "body": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/domain_objects/DO-003"
              }
            }
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "新创建的环境 ID"
            },
            "name": {
              "type": "string",
              "description": "环境名称"
            }
          }
        },
        "description": "成功创建环境"
      },
      "errors": [
        {
          "status": 404,
          "description": "项目不存在"
        },
        {
          "status": 409,
          "description": "项目内名称重复"
