  "data_models": [
    {
      "id": "DM-001",
      "name": "environments",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environments"
      },
      "description": "环境配置表，存储项目关联的 SSH 连接信息和加密凭证",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "project_id",
          "type": "integer",
          "required": true,
          "description": "所属项目 ID"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "环境名称，项目内唯一"
        },
        {
          "name": "ip",
          "type": "string",
          "required": true,
          "description": "SSH 主机 IP"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "SSH 端口"
        },
        {
          "name": "auth_type",
          "type": "string",
          "required": true,
          "description": "认证类型：password 或 key"
        },
        {
          "name": "encrypted_credential",
          "type": "text",
          "required": true,
          "description": "加密后的凭证：私钥或密码"
        },
        {
          "name": "credential_fingerprint",
          "type": "string",
          "required": true,
          "description": "凭证指纹"
        },
        {
          "name": "deploy_root_path",
          "type": "string",
          "required": true,
          "description": "部署根目录"
        },
        {
          "name": "last_test_status",
          "type": "string",
          "required": true,
          "description": "最近一次连接测试状态：unknown, success, failed"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_project_id",
          "unique": false,
          "columns": [
            "project_id"
          ]
        },
        {
          "name": "uq_project_name",
          "unique": true,
          "columns": [
            "project_id",
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-002",
        "REQ-003"
      ],
      "source_components": [
        "CMP-012"
      ],
      "source_contracts": [
        "CTR-005",
        "CTR-006",
        "CTR-007"
      ],
      "constraints": [
        "auth_type 必须为 'password' 或 'key'",
        "last_test_status 必须为 'unknown', 'success', 'failed' 之一"
      ],
      "lifecycle": {
        "create": "通过服务层调用 SQLAlchemy 模型创建",
        "update": "通过服务层调用 SQLAlchemy 模型更新",
        "delete": "通过服务层调用 SQLAlchemy 模型删除"
      }
    }
  ],
