      "request": {
        "body": {
          "required": false
        }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "测试结果：success 或 failed"
            },
            "message": {
              "type": "string",
              "description": "附加信息"
            }
          }
        },
        "description": "返回测试结果"
      },
      "errors": [
        {
          "status": 404,
          "description": "环境不存在"
        }
