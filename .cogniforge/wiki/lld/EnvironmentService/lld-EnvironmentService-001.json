  "module_boundary": {
    "in_scope": [
      "环境配置的创建与查询（面向项目维度）",
      "私钥/密码的加密存储（借助 EncryptionUtil）",
      "凭证指纹的生成（私钥公钥指纹或密码哈希摘要）",
      "提供 RESTful 接口供前端 EnvironmentManager 调用",
      "协调测试连接流程：解密凭据 → 调用 SSHService → 更新状态 → 返回结果",
      "校验项目存在性（通过内部调用 ProjectService 或数据库查询）"
    ],
    "out_of_scope": [
      "实际的 SSH 连接、会话管理、命令执行（由 SSHService 负责）",
      "项目本身的管理（创建、删除、列表等，由 ProjectService 负责）",
      "前端 UI 渲染、路由、状态管理",
      "API 网关的认证与鉴权（由 APIGateway 统一处理）",
      "文件上传的物理存储及持久化（私钥只在内存中短暂停留，加密后即丢弃明文文件）"
    ],
    "owned_components": [
      "CMP-012"
    ],
    "owned_contracts": [
      "CTR-005",
      "CTR-006",
      "CTR-007"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "管理项目下的环境配置，包括环境的 CRUD、凭证加密存储、指纹生成，以及通过协调 SSHService 完成连接测试。",
    "dependencies": [
      "ProjectService",
      "SSHService",
      "EncryptionUtil"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "SQLAlchemy",
      "SQLite",
      "paramiko",
      "cryptography (AES-256)"
    ]
  },
