  "error_handling": {
    "strategy": "面向切面的统一异常处理，基于 FastAPI 的异常处理器和自定义异常类。",
    "error_catalog": [
      {
        "code": "PROJECT_NOT_FOUND",
        "http_status": 404,
        "message_template": "Project with ID {project_id} not found",
        "scenarios": [
          "创建环境时项目不存在",
          "查询环境列表时项目不存在"
        ]
      },
      {
        "code": "ENVIRONMENT_NOT_FOUND",
        "http_status": 404,
        "message_template": "Environment with ID {environment_id} not found",
        "scenarios": [
          "连接测试时环境 ID 无效"
        ]
      },
      {
        "code": "DUPLICATE_ENVIRONMENT_NAME",
        "http_status": 409,
        "message_template": "Environment name '{name}' already exists in project {project_id}",
        "scenarios": [
          "创建环境时名称重复"
        ]
      },
      {
        "code": "CREDENTIAL_ENCRYPTION_ERROR",
        "http_status": 500,
        "message_template": "Failed to encrypt credential",
        "scenarios": [
          "加密凭证时出现内部错误"
        ]
      },
      {
        "code": "SSH_CONNECTION_ERROR",
        "http_status": 502,
        "message_template": "SSH connection failed: {reason}",
        "scenarios": [
          "连接测试中 SSH 连接失败"
        ]
      }
    ],
    "recovery_mechanisms": {
      "transaction_rollback": true,
      "circuit_breaker": false,
      "retry": false
    },
    "source_requirements": [
      "REQ-002",
      "REQ-003"
    ]
  }
