  "data_models": [
    {
      "id": "DM-001",
      "name": "Environment (derived)",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "Environment"
      },
      "description": "引用自 Primary Database 的环境配置表，本服务仅关注环境管理的必要字段，敏感凭据以加密形态存储。",
      "fields": [
        {
          "name": "id",
          "type": "TEXT",
          "required": true,
          "description": "UUID 主键，唯一标识环境"
        },
        {
          "name": "projectId",
          "type": "TEXT",
          "required": true,
          "description": "所属项目 ID，不可为空"
        },
        {
          "name": "name",
          "type": "TEXT",
          "required": true,
          "description": "环境名称，同项目下唯一"
        },
        {
          "name": "host",
          "type": "TEXT",
          "required": true,
          "description": "远程主机地址或 IP"
        },
        {
          "name": "port",
          "type": "INTEGER",
          "required": true,
          "description": "SSH 端口，如 22"
        },
        {
          "name": "username",
          "type": "TEXT",
          "required": true,
          "description": "登录用户名"
        },
        {
          "name": "authType",
          "type": "TEXT",
          "required": true,
          "description": "认证类型：password 或 key"
        },
        {
          "name": "encryptedPassword",
          "type": "TEXT",
          "required": false,
          "description": "使用主密码加密后的密码"
        },
        {
          "name": "encryptedPrivateKey",
          "type": "TEXT",
          "required": false,
          "description": "使用主密码加密后的私钥文本"
        },
        {
          "name": "createdAt",
          "type": "TEXT",
          "required": true,
          "description": "创建时间 ISO 字符串"
        },
        {
          "name": "updatedAt",
          "type": "TEXT",
          "required": true,
          "description": "更新时间 ISO 字符串"
        }
      ],
      "indexes": [
        {
          "name": "idx_env_projectId",
          "unique": false,
          "columns": [
            "projectId"
          ]
        },
        {
          "name": "idx_env_project_name",
          "unique": true,
          "columns": [
            "projectId",
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-002"
      ],
      "constraints": [
        "authType 必须为 'password' 或 'key'",
        "projectId 不可修改",
        "name 在同一 projectId 下唯一"
      ],
      "lifecycle": {
        "create": "新建环境记录，通过 SecurityService 加密凭据后插入",
        "update": "更新非加密字段时可选择更新凭据，若更换凭据则重新加密",
        "delete": "物理删除或逻辑删除（需与部署状态检查配合）",
        "retention": "至少保留至关联部署记录清理"
      },
      "change_history": [
