      "source_requirements": [
        "REQ-002"
      ],
      "source_components": [
        "CMP-012"
      ],
      "source_contracts": [
        "CTR-006"
      ]
    },
    {
      "id": "IF-003",
      "endpoint": "POST /environments/{environment_id}/test-connection",
      "description": "对指定环境发起连接测试",
      "parameters": [
        {
          "name": "environment_id",
          "in": "path",
