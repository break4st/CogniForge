  "workflow": [
    {
      "name": "checkExists 调用流程",
      "description": "检查文件或目录是否存在的工作流",
      "trigger": "调用 checkExists 接口",
      "steps": [
        "1. 接收路径参数",
        "2. 校验参数有效性",
        "3. 调用 fs.access 或 fs.stat 检查存在性",
        "4. 返回结果对象"
      ],
      "rollback": [],
      "sla": {}
    },
    {
      "name": "getMetaData 调用流程",
      "description": "获取文件元数据的工作流",
      "trigger": "调用 getMetaData 接口",
      "steps": [
        "1. 接收路径参数",
        "2. 校验参数有效性",
        "3. 调用 fs.stat 获取文件信息",
        "4. 格式化并返回元数据"
      ],
      "rollback": [],
      "sla": {}
    },
    {
      "name": "createDirectory 调用流程",
      "description": "创建目录的工作流",
      "trigger": "调用 createDirectory 接口",
      "steps": [
        "1. 接收目录路径和选项",
        "2. 校验参数有效性",
        "3. 调用 fs.mkdir 创建目录",
        "4. 返回创建结果"
      ],
      "rollback": [],
      "sla": {}
    }
  ],
