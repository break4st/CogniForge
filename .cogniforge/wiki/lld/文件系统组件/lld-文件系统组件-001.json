  "data_models": [],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "checkExists",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "fs-utils:checkExists",
      "description": "检查指定路径的文件或目录是否存在",
      "parameters": [
        {
          "name": "path",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "本地绝对路径"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "exists": "boolean",
          "type": "'file' | 'directory' | 'none'"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_PARAM",
          "message": "路径参数非法"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "path 必须为非空字符串"
      ],
      "idempotency": "idempotent",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "getMetaData",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "fs-utils:getMetaData",
      "description": "读取文件/目录的元信息（大小、修改时间、类型、权限）",
      "parameters": [
        {
          "name": "path",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "本地绝对路径"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "size": "number",
          "modifiedAt": "string (ISO8601)",
          "isFile": "boolean",
          "isDirectory": "boolean",
          "permissions": "string"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "文件或目录不存在"
        },
        {
          "status": 403,
          "code": "PERMISSION_DENIED",
          "message": "权限不足"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "path 必须为非空字符串"
      ],
      "idempotency": "idempotent",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "createDirectory",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "fs-utils:createDirectory",
      "description": "创建目录，支持递归创建",
      "parameters": [
        {
          "name": "dirPath",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "目录路径"
        },
        {
          "name": "options",
          "type": "{ recursive: boolean }",
          "in": "body",
          "required": false,
          "description": "可选配置，默认 recursive: true"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "created": "boolean",
          "path": "string"
        }
      },
      "error_codes": [
        {
          "status": 409,
          "code": "CONFLICT",
          "message": "路径已存在同名文件"
        },
        {
          "status": 403,
          "code": "PERMISSION_DENIED",
          "message": "权限不足"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "dirPath 必须为非空字符串"
      ],
      "idempotency": "idempotent (当目录已存在时返回 created: false)",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
