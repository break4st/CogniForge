{
  "meta": {
    "doc_id": "lld-environment-page-001",
    "type": "lld",
    "module_type": "frontend",
    "module": "环境配置页面",
    "title": "环境配置页面 详细设计",
    "author": "design_agent",
    "created": "2025-04-09T12:00:00Z",
    "version": 2,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": ["REQ-002"]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": ["CMP-102"],
      "contracts": ["CTR-003", "CTR-004"],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "显示环境列表、添加/编辑/删除环境、测试连接、凭据脱敏输入"
    ],
    "out_of_scope": [
      "环境数据的持久化与加密存储",
      "SSH连接与认证的底层逻辑",
      "项目选择逻辑（由全局状态提供当前项目ID）",
      "数据库操作"
    ],
    "owned_components": ["FC-301", "FC-302", "FC-303", "FC-304", "FC-305"],
    "owned_contracts": [],
    "consumed_contracts": ["CTR-003", "CTR-004"],
    "owned_data_models": ["DM-001", "DM-002", "DM-003"],
    "consumed_data_models": []
  },
  "overview": {
    "description": "管理当前项目下的部署环境，支持添加、编辑、删除环境，提供测试连接按钮和凭据脱敏输入。",
    "dependencies": ["IEnvironmentService"],
    "tech_stack": ["TypeScript", "React", "Ant Design", "Vite", "Electron IPC"]
  },
  "traceability": [
    {
      "requirement_id": "REQ-002",
      "sad_component_ids": ["CMP-102"],
      "sad_contract_ids": ["CTR-003", "CTR-004"],
      "lld_objects": {
        "data_models": ["DM-001", "DM-002", "DM-003"],
        "interfaces": ["IF-001"],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "环境管理需求通过前端页面、数据模型和IPC调用完整覆盖。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "Environment",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "环境对象，用于列表展示和表单填充。",
      "fields": [
        { "name": "id", "type": "string", "required": true, "description": "环境唯一标识" },
        { "name": "name", "type": "string", "required": true, "description": "环境名称" },
        { "name": "host", "type": "string", "required": true, "description": "主机地址" },
        { "name": "port", "type": "number", "required": true, "description": "SSH端口" },
        { "name": "username", "type": "string", "required": true, "description": "登录用户名" },
        { "name": "authType", "type": "string", "required": true, "description": "认证方式，枚举: password, publickey" },
        { "name": "password", "type": "string", "required": false, "description": "密码，仅密码认证时使用，脱敏显示" },
        { "name": "privateKey", "type": "string", "required": false, "description": "私钥内容，仅公钥认证时使用，脱敏显示" },
        { "name": "remoteRootPath", "type": "string", "required": false, "description": "远程部署根路径，测试连接后可预填" },
        { "name": "projectId", "type": "string", "required": true, "description": "所属项目ID" },
        { "name": "status", "type": "string", "required": false, "description": "最近连接状态" }
      ],
      "constraints": [
        "authType 为 password 时 password 必填",
        "authType 为 publickey 时 privateKey 必填"
      ],
      "lifecycle": {
        "create": "通过添加环境表单创建",
        "update": "通过编辑环境表单更新",
        "delete": "通过删除按钮触发删除",
        "retention": "与项目生命周期一致"
      },
      "change_history": [
        { "version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD" }
      ]
    },
    {
      "id": "DM-002",
      "name": "EnvironmentFormFields",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "添加/编辑表单的内部状态，扩展了显示控制字段。",
      "fields": [
        { "name": "environment", "type": "DM-001", "required": true, "description": "继承所有字段" },
        { "name": "passwordVisible", "type": "boolean", "required": true, "description": "密码是否明文显示" },
        { "name": "privateKeyVisible", "type": "boolean", "required": true, "description": "私钥是否明文显示" }
      ],
      "constraints": [
        "passwordVisible 和 privateKeyVisible 仅影响前端显示，不改变实际值"
      ],
      "lifecycle": {
        "create": "表单打开时创建，关闭时销毁",
        "update": "在表单操作中更新显示状态",
        "delete": "",
        "retention": ""
      },
      "change_history": [
        { "version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD" }
      ]
    },
    {
      "id": "DM-003",
      "name": "TestConnectionResult",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "测试连接后返回的结果状态。",
      "fields": [
        { "name": "success", "type": "boolean", "required": true, "description": "连接是否成功" },
        { "name": "message", "type": "string", "required": false, "description": "错误或成功信息" },
        { "name": "remoteRootPath", "type": "string", "required": false, "description": "成功后返回的建议远程路径" }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "测试连接调用后创建临时结果对象",
        "update": "",
        "delete": "",
        "retention": ""
      },
      "change_history": [
        { "version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD" }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "IEnvironmentService",
      "method": "listEnvironments",
      "endpoint": "ipc://environment.list",
      "description": "前端调用的环境服务接口，通过 Electron IPC 实现。"
    },
    {
      "id": "IF-002",
      "name": "IEnvironmentService",
      "method": "createEnvironment",
      "endpoint": "ipc://environment.create",
      "description": "创建环境"
    },
    {
      "id": "IF-003",
      "name": "IEnvironmentService",
      "method": "updateEnvironment",
      "endpoint": "ipc://environment.update",
      "description": "更新环境"
    },
    {
      "id": "IF-004",
      "name": "IEnvironmentService",
      "method": "deleteEnvironment",
      "endpoint": "ipc://environment.delete",
      "description": "删除环境"
    },
    {
      "id": "IF-005",
      "name": "IEnvironmentService",
      "method": "testConnection",
      "endpoint": "ipc://environment.testConnection",
      "description": "测试环境连接"
    }
  ],
  "component_tree": [
    {
      "id": "FC-301",
      "name": "EnvironmentListPage",
      "type": "page",
      "description": "环境列表页面，包含列表、添加/编辑/删除操作",
      "props": [],
      "events": [],
      "children": ["FC-302"]
    },
    {
      "id": "FC-302",
      "name": "EnvironmentList",
      "type": "component",
      "description": "环境列表组件，展示所有环境",
      "props": [
        { "name": "environments", "type": "DM-001[]", "required": true }
      ],
      "events": [],
      "children": []
    },
    {
      "id": "FC-303",
      "name": "EnvironmentFormModal",
      "type": "component",
      "description": "添加/编辑环境的模态框",
      "props": [
        { "name": "visible", "type": "boolean", "required": true },
        { "name": "initialValues", "type": "DM-001", "required": false },
        { "name": "onSave", "type": "(data: DM-001) => void", "required": true },
        { "name": "onCancel", "type": "() => void", "required": true },
        { "name": "onTestConnection", "type": "(data: DM-001) => void", "required": true }
      ],
      "events": [],
      "children": ["FC-304"]
    },
    {
      "id": "FC-304",
      "name": "EnvironmentForm",
      "type": "component",
      "description": "环境表单，包含所有字段和脱敏控制",
      "props": [
        { "name": "form", "type": "FormInstance", "required": true },
        { "name": "initialValues", "type": "DM-001", "required": false }
      ],
      "events": [],
      "children": ["FC-305"]
    },
    {
      "id": "FC-305",
      "name": "MaskedInput",
      "type": "component",
      "description": "带显示/隐藏切换的密码/私钥输入框",
      "props": [
        { "name": "value", "type": "string", "required": false },
        { "name": "onChange", "type": "(value: string) => void", "required": true },
        { "name": "placeholder", "type": "string", "required": false }
      ],
      "events": [],
      "children": []
    }
  ],
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "加载环境列表",
      "trigger": "页面加载或项目切换",
      "steps": [
        "从全局状态获取 currentProjectId",
        "调用 listEnvironments(projectId)",
        "渲染 EnvironmentList 组件"
      ]
    },
    {
      "id": "FLOW-002",
      "name": "添加环境",
      "trigger": "点击添加按钮",
      "steps": [
        "打开 EnvironmentFormModal，visible=true，initialValues 为空",
        "用户填写表单并点击保存",
        "表单校验通过后调用 createEnvironment(data)",
        "成功后关闭模态框并刷新列表"
      ]
    },
    {
      "id": "FLOW-003",
      "name": "编辑环境",
      "trigger": "点击环境条目的编辑按钮",
      "steps": [
        "打开 EnvironmentFormModal，visible=true，initialValues 为该环境数据",
        "用户修改表单并点击保存",
        "表单校验通过后调用 updateEnvironment(id, data)",
        "成功后关闭模态框并刷新列表"
      ]
    },
    {
      "id": "FLOW-004",
      "name": "删除环境",
      "trigger": "点击环境条目的删除按钮",
      "steps": [
        "弹出确认对话框",
        "用户确认后调用 deleteEnvironment(id)",
        "成功后刷新列表"
      ]
    },
    {
      "id": "FLOW-005",
      "name": "测试连接",
      "trigger": "点击环境表单中的测试连接按钮",
      "steps": [
        "从表单获取当前填写的数据",
        "调用 testConnection(data)",
        "根据返回结果更新 UI 提示和 remoteRootPath"
      ]
    }
  ],
  "state_design": {
    "global": [
      {
        "name": "environments",
        "type": "DM-001[]",
        "initial_value": "[]",
        "description": "当前项目下的环境列表"
      },
      {
        "name": "loading",
        "type": "boolean",
        "initial_value": "false",
        "description": "列表加载状态"
      },
      {
        "name": "error",
        "type": "string | null",
        "initial_value": "null",
        "description": "加载错误信息"
      }
    ],
    "local": [
      {
        "name": "modalVisible",
        "type": "boolean",
        "initial_value": "false",
        "description": "模态框显示状态"
      },
      {
        "name": "editingEnvironment",
        "type": "DM-001 | null",
        "initial_value": "null",
        "description": "当前编辑的环境对象"
      },
      {
        "name": "connectionTestResult",
        "type": "DM-003 | null",
        "initial_value": "null",
        "description": "最近一次测试连接的结果"
      }
    ]
  },
  "route_design": [
    {
      "path": "/environments",
      "page": "FC-301",
      "auth_required": true
    }
  ],
  "api_integration": [
    {
      "page": "FC-301",
      "endpoint": "ipc://environment.list",
      "contract_id": "CTR-003",
      "description": "获取当前项目环境列表",
      "invocation": "GET",
      "name": "listEnvironments"
    },
    {
      "page": "FC-301",
      "endpoint": "ipc://environment.create",
      "contract_id": "CTR-003",
      "description": "创建新环境",
      "invocation": "POST",
      "name": "createEnvironment"
    },
    {
      "page": "FC-301",
      "endpoint": "ipc://environment.update",
      "contract_id": "CTR-003",
      "description": "更新环境",
      "invocation": "PUT",
      "name": "updateEnvironment"
    },
    {
      "page": "FC-301",
      "endpoint": "ipc://environment.delete",
      "contract_id": "CTR-003",
      "description": "删除环境",
      "invocation": "DELETE",
      "name": "deleteEnvironment"
    },
    {
      "page": "FC-301",
      "endpoint": "ipc://environment.testConnection",
      "contract_id": "CTR-004",
      "description": "测试环境连接",
      "invocation": "POST",
      "name": "testConnection"
    }
  ],
  "error_handling": {
    "strategy": "全局错误边界捕获渲染异常；API 调用失败时在组件内展示错误消息并允许重试；表单校验在提交前进行，不合规时高亮字段并阻止提交。",
    "auth": {
      "type": "redirect",
      "fallback": "重新登录页面"
    },
    "network": {
      "type": "retry",
      "max_retries": 3,
      "fallback": "显示网络错误提示"
    },
    "validation": {
      "type": "inline",
      "fallback": "在字段旁显示错误信息"
    }
  },
  "workflow": {
    "environment_create": {
      "description": "创建新环境的完整流程",
      "steps": [
        {
          "id": "1",
          "action": "用户点击添加按钮",
          "component": "FC-301"
        },
        {
          "id": "2",
          "action": "打开环境创建表单模态框",
          "component": "FC-303"
        },
        {
          "id": "3",
          "action": "用户填写表单",
          "component": "FC-304"
        },
        {
          "id": "4",
          "action": "用户可选择测试连接",
          "component": "FC-304"
        },
        {
          "id": "5",
          "action": "测试连接结果反馈",
          "component": "FC-304"
        },
        {
          "id": "6",
          "action": "用户提交表单",
          "component": "FC-304"
        },
        {
          "id": "7",
          "action": "前端调用 createEnvironment 接口",
          "component": "FC-301"
        },
        {
          "id": "8",
          "action": "刷新环境列表",
          "component": "FC-301"
        }
      ]
    }
  }
}