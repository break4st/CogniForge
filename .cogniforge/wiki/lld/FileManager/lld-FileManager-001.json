      },
      "coverage": "full",
      "notes": "覆盖文件保存、读取、私钥读取、安全删除、存在性检查所有基础能力"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "FileInfo",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "文件保存后的元信息，返回给调用方用于后续操作或完整性校验。",
      "fields": [
        {
          "name": "file_path",
          "type": "string",
          "required": true,
          "description": "文件在本地磁盘上的绝对路径"
        },
        {
          "name": "filename",
          "type": "string",
          "required": true,
          "description": "原始文件名"
        },
        {
          "name": "size_bytes",
          "type": "integer",
          "required": true,
          "description": "文件大小（字节）"
        },
        {
          "name": "sha256",
          "type": "string",
          "required": true,
          "description": "文件内容的 SHA-256 十六进制摘要"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "由 save_temp_file 接口创建并返回",
        "update": "不适用",
        "delete": "不适用（无持久化存储）",
        "retention": "不适用"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "save_temp_file",
      "status": "active",
      "version": 1,
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "file_manager.save_temp_file",
      "description": "接收二进制内容与文件名，保存到临时子目录，返回 FileInfo。",
      "parameters": [
        {
          "name": "content",
          "type": "bytes",
          "in": "body",
          "required": true,
          "description": "文件二进制内容"
        },
        {
          "name": "filename",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "要保存的文件名"
        },
        {
          "name": "sub_dir",
          "type": "string",
          "in": "body",
          "required": false,
          "description": "临时子目录名，默认为 deploy_packages"
        }
      ],
      "request_body": {
        "content": "bytes",
        "filename": "string",
        "sub_dir": "string (optional)"
      },
      "response": {
        "status": 200,
        "body": {
          "file_path": "string",
          "filename": "string",
          "size_bytes": "integer",
          "sha256": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_FILENAME",
          "message": "文件名包含非法字符或路径穿越符号"
        },
        {
          "status": 500,
          "code": "FILE_WRITE_ERROR",
          "message": "磁盘写入失败，可能空间不足或权限问题"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "文件名不能包含 ..、/、\\ 等危险字符",
        "保存前检查基目录是否存在，否则创建"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "read_file",
      "status": "active",
      "version": 1,
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "file_manager.read_file",
      "description": "读取指定路径的文件，返回二进制内容。",
      "parameters": [
        {
          "name": "file_path",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "文件的绝对路径，需位于允许的基目录下"
        }
      ],
      "request_body": {
        "file_path": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "content": "bytes"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "FILE_NOT_FOUND",
          "message": "文件不存在"
        },
        {
          "status": 403,
          "code": "PATH_TRAVERSAL_DETECTED",
          "message": "检测到路径穿越企图"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "校验文件路径在允许的基目录范围内",
        "文件不存在时返回特定错误码"
      ],
      "idempotency": "no_side_effects",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "read_private_key",
      "status": "active",
      "version": 1,
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "file_manager.read_private_key",
      "description": "读取私钥文件内容并进行基本格式校验，返回字符串。",
      "parameters": [
        {
          "name": "file_path",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "私钥文件的绝对路径"
        }
      ],
      "request_body": {
        "file_path": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "key_content": "string"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "FILE_NOT_FOUND",
          "message": "文件不存在"
        },
        {
          "status": 400,
          "code": "INVALID_KEY_FORMAT",
          "message": "私钥格式无效"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "检查文件扩展名是否为 .pem 或 .key",
        "验证文件内容是否以 -----BEGIN ... PRIVATE KEY----- 开头"
      ],
      "idempotency": "no_side_effects",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-004",
      "name": "delete_file",
      "status": "active",
      "version": 1,
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "file_manager.delete_file",
      "description": "安全删除文件，先覆写再删除。",
      "parameters": [
        {
          "name": "file_path",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "要删除的文件绝对路径"
        }
      ],
      "request_body": {
        "file_path": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "success": "boolean"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "FILE_NOT_FOUND",
          "message": "文件不存在"
        },
        {
          "status": 500,
          "code": "DELETE_ERROR",
          "message": "文件删除失败"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "确保文件路径在允许的范围内",
        "覆写操作默认执行三次随机数据"
      ],
      "idempotency": "idempotent",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-005",
      "name": "file_exists",
      "status": "active",
      "version": 1,
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "file_manager.file_exists",
      "description": "检查指定路径的文件是否存在。",
      "parameters": [
        {
          "name": "file_path",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "文件的绝对路径"
        }
      ],
      "request_body": {
        "file_path": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "exists": "boolean"
        }
      },
      "error_codes": [],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
