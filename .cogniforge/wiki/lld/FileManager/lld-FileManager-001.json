  "module_boundary": {
    "in_scope": [
      "保存二进制内容到本地临时目录",
      "读取任意文件二进制内容",
      "读取私钥文件并进行格式校验",
      "安全删除文件（覆写后删除）",
      "检查文件是否存在"
    ],
    "out_of_scope": [
      "文件加密/解密",
      "访问权限控制",
      "文件版本管理与自动清理",
      "元数据持久化存储",
      "网络文件传输"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "FileManager 是基础设施层组件，为服务层提供可靠的本地文件操作原语，包括文件暂存、读取、安全删除等。专注于本地文件系统交互，不包含业务逻辑或元数据持久化。",
    "dependencies": [],
    "tech_stack": [
      "Python 3.11",
      "标准库 os, shutil, pathlib, tempfile, hashlib"
    ]
  },
  "error_handling": {
    "strategy": "所有接口在遇到系统错误时抛出异常，由上层统一处理；错误码定义在各接口的 error_codes 中，遵循统一的错误码规范。"
  },
  "topology": {
    "exchanges": [],
    "namespaces": [
      {
        "name": "FileManagerNamespace",
        "description": "FileManager 功能命名空间",
        "operations": [
          "save_temp_file",
          "read_file",
          "read_private_key",
          "delete_file",
          "file_exists"
        ]
      }
    ],
    "buckets": []
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [],
