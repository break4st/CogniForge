{
  "meta": {
    "doc_id": "lld-Deployment Orchestrator-001",
    "type": "lld",
    "module_type": "ModuleType.SERVICE",
    "module": "Deployment Orchestrator",
    "title": "LLD - Deployment Orchestrator",
    "author": "design_agent",
    "created": "2026-05-21 09:47"
  },
  "overview": {
    "description": "部署编排服务，负责部署任务的创建、调度、状态管理，是部署流程的核心调度模块。接收API Gateway转发的一键部署请求，创建部署记录并写入数据库，通过RabbitMQ异步调度SSH Execution Service执行远程部署，通过WebSocket实时推送部署进度到Web Console。",
    "dependencies": [
      "API Gateway",
      "SSH Execution Service",
      "Primary Database",
      "Message Queue (RabbitMQ)",
      "Key Management Service"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "MySQL 8.0",
      "RabbitMQ",
      "Docker 容器化部署"
    ]
  },
  "data_models": [
    {
      "name": "deployments",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployments"
      },
      "description": "部署任务记录表，记录每次部署的元数据和状态变化",
      "fields": [
        {"name": "id", "type": "INTEGER AUTO_INCREMENT", "required": true, "description": "部署任务ID，自增主键"},
        {"name": "project_id", "type": "INTEGER", "required": true, "description": "项目ID，关联projects表"},
        {"name": "environment_id", "type": "INTEGER", "required": true, "description": "目标环境ID"},
        {"name": "version", "type": "VARCHAR(64)", "required": true, "description": "版本号"},
        {"name": "artifact_path", "type": "VARCHAR(512)", "required": true, "description": "可执行文件路径或下载URL"},
        {"name": "description", "type": "VARCHAR(1024)", "required": false, "description": "部署说明，可选"},
        {"name": "status", "type": "ENUM('pending','running','success','failed')", "required": true, "description": "部署状态"},
        {"name": "progress", "type": "INTEGER DEFAULT 0", "required": true, "description": "进度百分比 0-100"},
        {"name": "created_at", "type": "DATETIME", "required": true, "description": "创建时间"},
        {"name": "started_at", "type": "DATETIME", "required": false, "description": "开始部署时间"},
        {"name": "finished_at", "type": "DATETIME", "required": false, "description": "部署完成时间"}
      ]
    },
    {
      "name": "deployment_logs",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployment_logs"
      },
      "description": "部署日志表，记录部署过程中产生的详细操作日志",
      "fields": [
        {"name": "id", "type": "INTEGER AUTO_INCREMENT", "required": true, "description": "日志ID，自增主键"},
        {"name": "deployment_id", "type": "INTEGER", "required": true, "description": "部署任务ID，关联deployments表"},
        {"name": "message", "type": "TEXT", "required": true, "description": "日志内容"},
        {"name": "level", "type": "ENUM('info','warn','error')", "required": true, "description": "日志级别"},
        {"name": "created_at", "type": "DATETIME", "required": true, "description": "日志记录时间"}
      ]
    },
    {
      "name": "deployment_execution_context",
      "type": "struct",
      "ownership": "owned",
      "description": "部署执行上下文，在创建部署任务时从Environment Management Service和Key Management Service获取并组装，用于构建MQ消息体",
      "fields": [
        {"name": "deployment_id", "type": "Integer", "required": true, "description": "部署任务ID"},
        {"name": "host", "type": "String", "required": true, "description": "目标服务器主机地址"},
        {"name": "port", "type": "Integer", "required": true, "description": "SSH端口号"},
        {"name": "username", "type": "String", "required": true, "description": "SSH登录用户名"},
        {"name": "key_id", "type": "Integer", "required": true, "description": "密钥ID，用于从Key Management Service获取加密解密密钥"},
        {"name": "version", "type": "String", "required": true, "description": "版本号"},
        {"name": "artifact_path", "type": "String", "required": true, "description": "可执行文件路径或下载URL"},
        {"name": "commands", "type": "Array[String]", "required": true, "description": "要执行的部署命令列表"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "Trigger Deployment API",
      "method": "POST",
      "endpoint": "/api/projects/{project_id}/deployments",
      "description": "触发一键部署任务。校验项目和环境有效性后，创建部署记录并投递MQ消息到SSH Execution Service",
      "parameters": [
        {"name": "project_id", "type": "Integer", "description": "项目ID，路径参数"},
        {"name": "environment_id", "type": "Integer", "description": "目标环境ID，请求体参数"},
        {"name": "version", "type": "String", "description": "版本号，如 v1.2.3，请求体参数"},
        {"name": "artifact_path", "type": "String", "description": "可执行文件路径或下载URL，请求体参数"},
        {"name": "description", "type": "String", "description": "部署说明，可选，请求体参数"}
      ],
      "response": {
        "status": 201,
        "body": {
          "deployment_id": "Integer",
          "status": "String",
          "version": "String",
          "created_at": "Datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数缺失或格式无效（如version格式不正确）"},
        {"code": 404, "message": "项目或环境未找到"},
        {"code": 409, "message": "目标环境当前已有进行中的部署任务，不允许并发部署"},
        {"code": 500, "message": "部署记录创建失败或MQ消息投递失败"}
      ]
    },
    {
      "name": "Deployment Status API",
      "method": "GET",
      "endpoint": "/api/deployments/{deployment_id}",
      "description": "查询部署任务的详细状态、进度和日志",
      "parameters": [
        {"name": "deployment_id", "type": "Integer", "description": "部署任务ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "Integer",
          "project_id": "Integer",
          "environment_id": "Integer",
          "version": "String",
          "status": "enum (pending|running|success|failed)",
          "progress": "Integer",
          "logs": "array[string]",
          "started_at": "Datetime",
          "finished_at": "Datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "部署任务不存在"},
        {"code": 500, "message": "数据库查询失败"}
      ]
    },
    {
      "name": "Deployment Progress WebSocket",
      "method": "WS",
      "endpoint": "/ws/deployments/{deployment_id}",
      "description": "WebSocket实时推送部署进度和日志到Web Console。连接建立后，服务端持续推送progress/log/complete/error类型消息，部署完成后自动关闭连接",
      "parameters": [
        {"name": "deployment_id", "type": "Integer", "description": "部署任务ID，路径参数"}
      ],
      "response": {
        "status": 101,
        "body": {
          "message_type": "enum (progress|log|complete|error)",
          "data": "object (消息数据体)"
        }
      },
      "error_codes": [
        {"code": 404, "message": "部署任务不存在，拒绝建立WebSocket连接"},
        {"code": 500, "message": "WebSocket内部错误"}
      ]
    },
    {
      "name": "Send Deployment Task",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.execute (producer)",
      "description": "将部署任务以JSON消息格式投递到RabbitMQ的deployment.execute队列，由SSH Execution Service异步消费执行。消息体组装时从Environment Management Service获取目标服务器连接信息，从Key Management Service获取解密后的SSH私钥",
      "parameters": [
        {"name": "deployment_id", "type": "Integer", "description": "部署任务ID"},
        {"name": "env_config", "type": "Object", "description": "目标服务器连接配置 {host: String, port: Integer, username: String}"},
        {"name": "key_content", "type": "String", "description": "SSH私钥内容（从Key Management Service获取，解密后的明文）"},
        {"name": "version", "type": "String", "description": "版本号"},
        {"name": "artifact_path", "type": "String", "description": "可执行文件路径或下载URL"},
        {"name": "commands", "type": "Array[String]", "description": "要执行的部署命令列表"}
      ],
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "Integer",
          "success": "Boolean",
          "exit_code": "Integer",
          "stdout": "String",
          "stderr": "String",
          "error_message": "String"
        }
      },
      "error_codes": [
        {"code": 500, "message": "MQ连接失败、消息序列化失败或消息投递超时"}
      ]
    },
    {
      "name": "Receive SSH Execution Result",
      "method": "INTERNAL",
      "endpoint": "RabbitMQ Queue: deployment.execute (consumer callback)",
      "description": "异步消费SSH Execution Service执行完成后回传的结果消息，更新部署状态、进度和日志到数据库，并通过WebSocket推送最终结果到前端",
      "parameters": [
        {"name": "deployment_id", "type": "Integer", "description": "部署任务ID"},
        {"name": "success", "type": "Boolean", "description": "SSH执行是否成功"},
        {"name": "exit_code", "type": "Integer", "description": "SSH命令退出码"},
        {"name": "stdout", "type": "String", "description": "标准输出内容"},
        {"name": "stderr", "type": "String", "description": "标准错误输出"},
        {"name": "error_message", "type": "String", "description": "执行错误信息，success=false时有效"}
      ],
      "response": {
        "status": 200,
        "body": {
          "acknowledged": "Boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "消息反序列化失败、部署记录更新失败或WebSocket推送失败"}
      ]
    }
  ],
  "error_handling": "部署编排服务的错误处理分为四个层面：\n(1) 请求校验层 — 使用FastAPI Pydantic模型自动校验请求参数格式和枚举值范围，校验失败统一返回400；\n(2) 业务逻辑层 — 创建部署时通过查询数据库校验项目和环境是否存在，并通过status字段检查目标环境是否已有running状态的部署任务（防止并发冲突），校验失败返回409；\n(3) MQ调度层 — 消息队列投递失败时启用重试机制（最多3次，间隔指数退避），仍失败则将部署状态标记为failed并记录错误原因到deployment_logs表；\n(4) SSH执行超时兜底 — 启动定时任务周期性扫描status=running且started_at超过30分钟阈值且无heartbeat更新的部署记录，自动标记为failed并清理，防止僵尸任务堆积。所有异常信息统一记录到deployment_logs表中，并通过WebSocket实时推送error类型消息到Web Console。"
}
