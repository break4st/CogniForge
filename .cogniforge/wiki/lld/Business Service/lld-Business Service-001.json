            "ssh_key": "string (必填，将被加密存储)",
            "deploy_path": "string (必填)"
          },
          "response": {
            "id": "int",
            "project_id": "int",
            "name": "string",
            "ssh_host": "string",
            "ssh_port": "int",
            "ssh_user": "string",
            "deploy_path": "string",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        {
          "name": "get_environment",
          "description": "获取单个环境",
          "signature": "get_environment(environment_id: int, user_id: int) -> EnvironmentDTO",
          "precondition": "用户已认证，环境存在且所属项目属于该用户",
          "postcondition": "返回环境详情（不含密钥）",
          "errors": ["404 环境未找到", "403 无权限"],
          "request": {},
          "response": {
            "id": "int",
            "project_id": "int",
            "name": "string",
            "ssh_host": "string",
            "ssh_port": "int",
            "ssh_user": "string",
            "deploy_path": "string",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        {
          "name": "list_environments",
          "description": "列出项目下的所有环境",
          "signature": "list_environments(project_id: int, user_id: int) -> List[EnvironmentDTO]",
          "precondition": "用户已认证，项目存在且属于该用户",
          "postcondition": "返回环境列表",
          "errors": ["404 项目未找到", "403 无权限"],
          "request": {},
          "response": "[{id: int, project_id: int, name: string, ssh_host: string, ssh_port: int, ssh_user: string, deploy_path: string, created_at: datetime, updated_at: datetime}]"
        },
        {
          "name": "update_environment",
          "description": "更新环境",
          "signature": "update_environment(environment_id: int, request: UpdateEnvironmentRequest, user_id: int) -> EnvironmentDTO",
          "precondition": "用户已认证，环境存在且所属项目属于该用户",
          "postcondition": "环境更新成功",
          "errors": ["404 环境未找到", "403 无权限", "409 环境名称重复"],
          "request": {
            "name": "string (可选)",
            "ssh_host": "string (可选)",
            "ssh_port": "int (可选)",
            "ssh_user": "string (可选)",
            "ssh_key": "string (可选，若提供则重新加密)",
            "deploy_path": "string (可选)"
          },
          "response": {
            "id": "int",
            "project_id": "int",
            "name": "string",
            "ssh_host": "string",
            "ssh_port": "int",
            "ssh_user": "string",
            "deploy_path": "string",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        {
          "name": "delete_environment",
          "description": "删除环境",
          "signature": "delete_environment(environment_id: int, user_id: int) -> None",
          "precondition": "用户已认证，环境存在且所属项目属于该用户，且无进行中的部署",
          "postcondition": "环境被删除",
          "errors": ["404 环境未找到", "403 无权限", "409 存在进行中的部署"],
          "request": {},
          "response": {}
        },
        {
          "name": "test_connection",
          "description": "测试环境连接",
          "signature": "test_connection(environment_id: int, user_id: int) -> dict[str, bool]",
          "precondition": "用户已认证，环境存在且所属项目属于该用户",
          "postcondition": "返回连接测试结果",
          "errors": ["404 环境未找到", "403 无权限"],
          "request": {},
          "response": {
            "success": "bool"
          }
        }
      ]
    },
    {
      "id": "CTR-004",
      "name": "DeploymentService",
      "description": "部署管理服务",
      "methods": [
        {
          "name": "trigger_deployment",
          "description": "触发部署",
          "signature": "trigger_deployment(project_id: int, environment_id: int, file: UploadFile, commit_message: str, user_id: int) -> TriggerDeploymentResponse",
          "precondition": "用户已认证，项目和存在且属于该用户，文件大小不超过50MB",
          "postcondition": "文件上传并暂存，部署记录创建，消息发送到队列",
          "errors": ["404 项目或环境未找到", "403 无权限", "400 文件大小超限"],
          "request": {
            "project_id": "int (路径参数)",
            "environment_id": "int (路径参数)",
            "file": "file (表单上传，压缩包)",
            "commit_message": "string (可选)"
          },
          "response": {
            "deployment_id": "int",
            "status": "string (pending)"
          }
        },
        {
          "name": "list_deployments",
          "description": "列出项目下的部署记录",
          "signature": "list_deployments(project_id: int, user_id: int, page: int = 1, size: int = 20) -> List[DeploymentDTO]",
          "precondition": "用户已认证，项目存在且属于该用户",
          "postcondition": "返回分页部署记录列表",
          "errors": ["404 项目未找到", "403 无权限"],
          "request": {
            "page": "int (可选, 默认1)",
