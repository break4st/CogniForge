  "module_boundary": {
    "in_scope": [
      "项目CRUD操作",
      "环境CRUD操作，包括密钥加密存储",
      "接收用户上传的文件压缩包并暂存",
      "创建部署历史记录并发送部署任务到消息队列",
      "提供部署历史查询与详情",
      "测试环境连接（可选）"
    ],
    "out_of_scope": [
      "用户认证与授权（由Auth Service负责）",
      "实际SSH执行与文件分发（由Deploy Engine负责）",
      "前端路由与页面渲染（Web App负责）",
      "WebSocket日志推送实现（由Deploy Engine推送）"
    ],
    "owned_components": ["CMP-004"],
    "owned_contracts": ["CTR-002", "CTR-003", "CTR-004", "CTR-005", "CTR-006"],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": ["DM-001", "DM-002", "DM-003"]
  },
  "overview": {
    "description": "核心业务服务，处理项目管理、环境配置、部署任务创建、历史记录查询以及文件上传接收。",
    "dependencies": ["Auth Service", "Deploy Engine", "MySQL", "RabbitMQ", "MinIO"],
    "tech_stack": ["Python 3.11", "FastAPI", "MySQL 8.0", "Redis 7", "RabbitMQ 3.12", "MinIO (或本地文件系统)"]
  },
  "business_rules": {
    "invariants": [
      "项目名称在同一用户下必须唯一",
      "环境名称在同一项目下必须唯一",
      "删除项目前必须确保无关联环境和进行中的部署",
      "部署历史记录不可删除，只能标记为已取消"
    ]
  },
