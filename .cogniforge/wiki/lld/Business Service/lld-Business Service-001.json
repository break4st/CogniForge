  "service_contracts": [
    {
      "id": "CTR-002",
      "name": "ProjectService",
      "description": "项目管理服务",
      "methods": [
        {
          "name": "create_project",
          "description": "创建项目",
          "signature": "create_project(request: CreateProjectRequest, user_id: int) -> ProjectDTO",
          "precondition": "用户已认证，项目名称在同一用户下不重复",
          "postcondition": "项目创建成功，返回项目DTO",
          "errors": ["409 项目名称已存在"],
          "request": {
            "name": "string (必填)",
            "description": "string (可选)"
          },
          "response": {
            "id": "int",
            "name": "string",
            "description": "string",
            "created_by": "int",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        {
          "name": "get_project",
          "description": "获取单个项目",
          "signature": "get_project(project_id: int, user_id: int) -> ProjectDTO",
          "precondition": "用户已认证，项目存在且属于该用户",
          "postcondition": "返回项目详情",
          "errors": ["404 项目未找到", "403 无权限访问"],
          "request": {},
          "response": {
            "id": "int",
            "name": "string",
            "description": "string",
            "created_by": "int",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        {
          "name": "list_projects",
          "description": "列出用户的所有项目",
          "signature": "list_projects(user_id: int, page: int = 1, size: int = 20) -> List[ProjectDTO]",
          "precondition": "用户已认证",
          "postcondition": "返回分页项目列表",
          "errors": [],
          "request": {
            "page": "int (可选, 默认1)",
            "size": "int (可选, 默认20)"
          },
          "response": "[{id: int, name: string, description: string, created_by: int, created_at: datetime, updated_at: datetime}]"
        },
        {
          "name": "update_project",
          "description": "更新项目",
          "signature": "update_project(project_id: int, request: UpdateProjectRequest, user_id: int) -> ProjectDTO",
          "precondition": "用户已认证，项目存在且属于该用户",
          "postcondition": "项目更新成功，返回更新后的项目DTO",
          "errors": ["404 项目未找到", "403 无权限", "409 项目名称重复"],
          "request": {
            "name": "string (可选)",
            "description": "string (可选)"
          },
          "response": {
            "id": "int",
            "name": "string",
            "description": "string",
            "created_by": "int",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        {
          "name": "delete_project",
          "description": "删除项目",
          "signature": "delete_project(project_id: int, user_id: int) -> None",
          "precondition": "用户已认证，项目存在且属于该用户，且无关联环境和进行中的部署",
          "postcondition": "项目被删除",
          "errors": ["404 项目未找到", "403 无权限", "409 存在关联环境或部署"],
          "request": {},
          "response": {}
        }
      ]
    },
    {
      "id": "CTR-003",
      "name": "EnvironmentService",
      "description": "环境管理服务",
      "methods": [
        {
          "name": "create_environment",
          "description": "创建环境",
          "signature": "create_environment(project_id: int, request: CreateEnvironmentRequest, user_id: int) -> EnvironmentDTO",
