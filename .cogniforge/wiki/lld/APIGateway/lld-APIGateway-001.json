  "overview": {
    "description": "作为系统接入层，APIGateway 是所有前端请求的唯一入口，负责将不同业务域请求路由至对应的服务模块，并利用 FastAPI 进行自动参数校验和统一的错误响应处理。",
    "dependencies": [
      "ProjectService",
      "EnvironmentService",
      "KeyManagementService",
      "DeploymentService",
      "VersionService",
      "ScriptTemplateService",
      "SSHService"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "FastAPI WebSocket"
    ]
  },
