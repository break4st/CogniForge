  "business_rules": [
    {
      "id": "BR-001",
      "name": "路由分发规则",
      "description": "API 网关根据请求路径前缀将请求分发到对应的服务模块路由器",
      "invariants": [
        "所有 /api/projects/* 请求必须转发至 ProjectService 路由器",
        "所有 /api/environments/* 请求必须转发至 EnvironmentService 路由器",
        "所有 /api/keys/* 请求必须转发至 KeyManagementService 路由器",
        "所有 /api/deployments/* 请求必须转发至 DeploymentService 路由器",
        "所有 /api/versions/* 请求必须转发至 VersionService 路由器",
        "所有 /api/scripts/* 请求必须转发至 ScriptTemplateService 路由器",
        "所有 /api/ssh/* 请求必须转发至 SSHService 路由器"
      ]
    },
    {
      "id": "BR-002",
      "name": "请求验证规则",
      "description": "FastAPI 自动对请求参数进行类型和必填校验",
      "invariants": [
        "所有路径参数、查询参数和请求体必须符合定义的类型和约束",
        "校验失败时必须返回 422 状态码和标准错误格式"
      ]
    },
    {
      "id": "BR-003",
      "name": "错误处理规则",
      "description": "统一错误响应格式",
      "invariants": [
        "所有错误响应必须包含 code、error、detail 字段",
        "系统内部错误不应暴露堆栈信息到客户端",
        "HTTPException 的 detail 应直接透传至客户端"
      ]
    },
    {
      "id": "BR-004",
      "name": "WebSocket 连接规则",
      "description": "WebSocket 连接管理和消息转发",
      "invariants": [
        "WebSocket 客户端必须通过 deployment_id 标识订阅特定部署日志流",
        "网关应保持与后端日志源的连接并转发消息",
        "客户端断开时需清理相关资源"
      ]
    }
  ],
  "error_handling": {
    "strategy": "利用 FastAPI 异常处理器统一捕获校验错误、HTTP 业务异常及其他未处理异常，转换为标准 JSON 格式。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "422",
        "name": "请求参数校验失败",
        "description": "FastAPI RequestValidationError，由自定义处理器返回 422，error 设为 VALIDATION_ERROR，detail 包含校验详情。"
      },
      {
        "code": "4xx/5xx",
        "name": "业务异常",
        "description": "各服务层抛出的 HTTPException，由全局处理器捕获，按原始状态码和 detail 返回。"
      },
      {
        "code": "500",
        "name": "未捕获的系统异常",
        "description": "除上述两类以外的所有未被捕获异常，统一返回 500，error 设为 INTERNAL_SERVER_ERROR，detail 返回通用提示。"
      }
    ]
  },
  "workflow": {
    "name": "APIGateway 启动流程",
    "description": "定义从创建 FastAPI 实例到启动 uvicorn 服务器的标准化步骤",
    "steps": [
      {
        "order": 1,
        "name": "创建应用实例",
        "action": "app = FastAPI(title='CogniForge', docs_url='/api/docs')",
        "timeout_seconds": 1,
        "on_failure": "进程退出，无自动重试"
      },
      {
        "order": 2,
        "name": "注册全局中间件",
        "action": "添加 CORS 中间件、请求日志中间件、可选的认证中间件占位符",
        "timeout_seconds": 1,
        "on_failure": "进程退出"
      },
      {
        "order": 3,
        "name": "注册异常处理器",
        "action": "绑定 RequestValidationError、HTTPException 及通用 Exception 的自定义处理器到 app",
        "timeout_seconds": 1,
        "on_failure": "进程退出"
      },
      {
        "order": 4,
        "name": "挂载业务路由",
        "action": "依次导入并包含 ProjectRouter、EnvironmentRouter 等各模块的路由对象",
        "timeout_seconds": 2,
        "on_failure": "记录错误并终止启动"
      },
      {
        "order": 5,
        "name": "启动 uvicorn 服务",
        "action": "uvicorn.run(app, host='0.0.0.0', port=8000)",
        "timeout_seconds": 5,
        "on_failure": "进程退出，由外部进程管理工具重启"
      }
    ]
  }
}