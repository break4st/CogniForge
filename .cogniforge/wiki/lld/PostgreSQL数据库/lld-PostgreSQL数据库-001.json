{
  "meta": {
    "doc_id": "lld-PostgreSQL数据库-001",
    "type": "lld",
    "module_type": "database",
    "module": "PostgreSQL数据库",
    "title": "自动化部署系统 - 数据库详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "关系型数据库，集中存储所有业务数据，包括项目信息、环境配置、SSH密钥密文、部署记录和审计日志。作为系统的数据核心层，所有微服务通过SQL协议访问持久化存储。",
    "dependencies": [],
    "tech_stack": [
      "PostgreSQL 15"
    ]
  },
  "data_models": [
    {
      "name": "users",
      "type": "table",
      "ownership": "canonical",
      "description": "系统用户表，存储所有登录用户信息，支持角色权限控制",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "用户唯一标识，默认 gen_random_uuid()"},
        {"name": "username", "type": "VARCHAR(64)", "required": true, "description": "登录用户名，唯一约束"},
        {"name": "password_hash", "type": "VARCHAR(256)", "required": true, "description": "密码哈希值（bcrypt）"},
        {"name": "display_name", "type": "VARCHAR(128)", "required": false, "description": "用户显示名称"},
        {"name": "role", "type": "VARCHAR(32)", "required": true, "description": "角色：admin/operator/developer/manager"},
        {"name": "email", "type": "VARCHAR(128)", "required": false, "description": "电子邮箱"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "状态：active/disabled，默认 active"},
        {"name": "last_login_at", "type": "TIMESTAMPTZ", "required": false, "description": "最后登录时间"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "创建时间，默认 now()"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "更新时间，默认 now()"}
      ],
      "indexes": [
        {"name": "pk_users", "unique": true, "columns": ["id"]},
        {"name": "uq_users_username", "unique": true, "columns": ["username"]},
        {"name": "idx_users_role", "unique": false, "columns": ["role"]},
        {"name": "idx_users_status", "unique": false, "columns": ["status"]}
      ]
    },
    {
      "name": "projects",
      "type": "table",
      "ownership": "canonical",
      "description": "项目表，存储项目管理信息",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "项目唯一标识"},
        {"name": "name", "type": "VARCHAR(128)", "required": true, "description": "项目名称"},
        {"name": "description", "type": "TEXT", "required": false, "description": "项目描述"},
        {"name": "created_by", "type": "VARCHAR(64)", "required": true, "description": "创建人用户名"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "更新时间"},
        {"name": "deleted_at", "type": "TIMESTAMPTZ", "required": false, "description": "软删除时间，非空表示已删除"}
      ],
      "indexes": [
        {"name": "pk_projects", "unique": true, "columns": ["id"]},
        {"name": "idx_projects_name", "unique": false, "columns": ["name"]},
        {"name": "idx_projects_created_by", "unique": false, "columns": ["created_by"]},
        {"name": "idx_projects_deleted_at", "unique": false, "columns": ["deleted_at"]}
      ]
    },
    {
      "name": "environments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署环境表，存储每套部署环境的连接配置信息",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "环境唯一标识"},
        {"name": "project_id", "type": "UUID", "required": true, "description": "所属项目ID，外键 references projects(id)"},
        {"name": "name", "type": "VARCHAR(128)", "required": true, "description": "环境名称"},
        {"name": "type", "type": "VARCHAR(32)", "required": true, "description": "环境类型：test/staging/production"},
        {"name": "host", "type": "VARCHAR(256)", "required": true, "description": "远程服务器主机地址（IP或域名）"},
        {"name": "port", "type": "INTEGER", "required": true, "description": "SSH端口号，默认22"},
        {"name": "username", "type": "VARCHAR(64)", "required": true, "description": "SSH登录用户名"},
        {"name": "key_id", "type": "UUID", "required": false, "description": "关联的SSH密钥ID，外键 references ssh_keys(id)"},
        {"name": "status", "type": "VARCHAR(32)", "required": true, "description": "连接状态：untested/available/unavailable，默认 untested"},
        {"name": "created_by", "type": "VARCHAR(64)", "required": true, "description": "创建人用户名"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "更新时间"},
        {"name": "deleted_at", "type": "TIMESTAMPTZ", "required": false, "description": "软删除时间"}
      ],
      "indexes": [
        {"name": "pk_environments", "unique": true, "columns": ["id"]},
        {"name": "idx_environments_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "idx_environments_type", "unique": false, "columns": ["type"]},
        {"name": "idx_environments_status", "unique": false, "columns": ["status"]},
        {"name": "idx_environments_key_id", "unique": false, "columns": ["key_id"]},
        {"name": "idx_environments_deleted_at", "unique": false, "columns": ["deleted_at"]}
      ]
    },
    {
      "name": "ssh_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "SSH密钥表，存储加密后的SSH密钥信息，私钥以AES密文形式存储",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "密钥唯一标识"},
        {"name": "name", "type": "VARCHAR(128)", "required": true, "description": "密钥名称，便于识别"},
        {"name": "public_key", "type": "TEXT", "required": true, "description": "SSH公钥内容"},
        {"name": "encrypted_private_key", "type": "TEXT", "required": true, "description": "AES加密后的SSH私钥内容"},
        {"name": "encryption_iv", "type": "VARCHAR(64)", "required": true, "description": "AES加密使用的初始向量"},
        {"name": "encryption_salt", "type": "VARCHAR(64)", "required": true, "description": "密钥派生使用的盐值"},
        {"name": "fingerprint", "type": "VARCHAR(128)", "required": true, "description": "密钥指纹（SHA256）"},
        {"name": "passphrase_hash", "type": "VARCHAR(256)", "required": false, "description": "私钥密码的哈希值（如设置了passphrase）"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "状态：active/revoked，默认 active"},
        {"name": "created_by", "type": "VARCHAR(64)", "required": true, "description": "创建人用户名"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "创建时间"},
        {"name": "revoked_at", "type": "TIMESTAMPTZ", "required": false, "description": "吊销时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "更新时间"}
      ],
      "indexes": [
        {"name": "pk_ssh_keys", "unique": true, "columns": ["id"]},
        {"name": "uq_ssh_keys_fingerprint", "unique": true, "columns": ["fingerprint"]},
        {"name": "idx_ssh_keys_status", "unique": false, "columns": ["status"]},
        {"name": "idx_ssh_keys_created_by", "unique": false, "columns": ["created_by"]}
      ]
    },
    {
      "name": "deployments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署任务表，记录每次部署请求的完整信息",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "部署任务唯一标识"},
        {"name": "project_id", "type": "UUID", "required": true, "description": "目标项目ID，外键 references projects(id)"},
        {"name": "environment_id", "type": "UUID", "required": true, "description": "目标环境ID，外键 references environments(id)"},
        {"name": "version", "type": "VARCHAR(64)", "required": true, "description": "部署版本号"},
        {"name": "artifact_path", "type": "TEXT", "required": true, "description": "可执行文件路径或上传文件标识"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "部署状态：pending/running/success/failed，默认 pending"},
        {"name": "logs", "type": "TEXT", "required": false, "description": "执行日志全文"},
        {"name": "error_message", "type": "TEXT", "required": false, "description": "失败时的错误信息"},
        {"name": "created_by", "type": "VARCHAR(64)", "required": true, "description": "触发部署的用户"},
        {"name": "started_at", "type": "TIMESTAMPTZ", "required": false, "description": "开始执行时间"},
        {"name": "completed_at", "type": "TIMESTAMPTZ", "required": false, "description": "完成时间"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "最后更新时间"}
      ],
      "indexes": [
        {"name": "pk_deployments", "unique": true, "columns": ["id"]},
        {"name": "idx_deployments_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "idx_deployments_environment_id", "unique": false, "columns": ["environment_id"]},
        {"name": "idx_deployments_status", "unique": false, "columns": ["status"]},
        {"name": "idx_deployments_created_at", "unique": false, "columns": ["created_at"]},
        {"name": "idx_deployments_project_env", "unique": false, "columns": ["project_id", "environment_id"]}
      ]
    },
    {
      "name": "deployment_steps",
      "type": "table",
      "ownership": "canonical",
      "description": "部署步骤表，记录每个部署任务的详细步骤执行情况",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "步骤记录唯一标识"},
        {"name": "deployment_id", "type": "UUID", "required": true, "description": "所属部署任务ID，外键 references deployments(id)"},
        {"name": "step_name", "type": "VARCHAR(128)", "required": true, "description": "步骤名称，如 create_directory/upload_file/generate_script"},
        {"name": "step_order", "type": "INTEGER", "required": true, "description": "步骤顺序号"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "步骤状态：pending/running/success/failed，默认 pending"},
        {"name": "output", "type": "TEXT", "required": false, "description": "步骤执行输出"},
        {"name": "error_message", "type": "TEXT", "required": false, "description": "步骤失败时的错误信息"},
        {"name": "started_at", "type": "TIMESTAMPTZ", "required": false, "description": "步骤开始执行时间"},
        {"name": "completed_at", "type": "TIMESTAMPTZ", "required": false, "description": "步骤完成时间"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "pk_deployment_steps", "unique": true, "columns": ["id"]},
        {"name": "idx_deployment_steps_deployment_id", "unique": false, "columns": ["deployment_id"]},
        {"name": "idx_deployment_steps_status", "unique": false, "columns": ["status"]},
        {"name": "idx_deployment_steps_deploy_status", "unique": false, "columns": ["deployment_id", "status"]}
      ]
    },
    {
      "name": "audit_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "审计日志表，记录所有关键操作的审计轨迹，支持按时间范围查询",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "审计日志唯一标识"},
        {"name": "action", "type": "VARCHAR(64)", "required": true, "description": "操作类型，如 deployment.create/project.create/key.revoke"},
        {"name": "operator_id", "type": "VARCHAR(64)", "required": true, "description": "操作人用户ID"},
        {"name": "operator_name", "type": "VARCHAR(128)", "required": true, "description": "操作人名称"},
        {"name": "resource_type", "type": "VARCHAR(32)", "required": true, "description": "资源类型：project/environment/deployment/key"},
        {"name": "resource_id", "type": "VARCHAR(64)", "required": false, "description": "被操作的资源ID"},
        {"name": "detail", "type": "JSONB", "required": false, "description": "操作详情JSON，包含请求参数和结果摘要"},
        {"name": "ip_address", "type": "VARCHAR(45)", "required": true, "description": "请求来源IP地址（支持IPv6）"},
        {"name": "result", "type": "VARCHAR(16)", "required": true, "description": "操作结果：success/failure，默认 success"},
        {"name": "timestamp", "type": "TIMESTAMPTZ", "required": true, "description": "操作发生时间"}
      ],
      "indexes": [
        {"name": "pk_audit_logs", "unique": true, "columns": ["id"]},
        {"name": "idx_audit_logs_action", "unique": false, "columns": ["action"]},
        {"name": "idx_audit_logs_operator_id", "unique": false, "columns": ["operator_id"]},
        {"name": "idx_audit_logs_resource", "unique": false, "columns": ["resource_type", "resource_id"]},
        {"name": "idx_audit_logs_timestamp", "unique": false, "columns": ["timestamp"]}
      ]
    }
  ],
  "interfaces": [],
  "error_handling": {
    "strategy": "数据库层采用连接池管理、自动重试、读写分离的策略。应用层捕获所有数据库异常并转换为结构化错误响应，连接失败时自动重试3次，约束违反返回明确的错误码和描述。",
    "response_format": {
      "body": {"code": "integer", "error": "string", "detail": "string"}
    },
    "categories": [
      {"code": 400, "name": "约束违反", "description": "唯一约束或外键约束失败，如重复用户名、引用不存在的项目ID"},
      {"code": 503, "name": "连接故障", "description": "数据库连接池耗尽、网络中断或主库不可用，应用层自动重试3次后返回"},
      {"code": 504, "name": "查询超时", "description": "SQL执行超过statement_timeout阈值（默认30s），通常为慢查询导致"},
      {"code": 422, "name": "数据校验失败", "description": "写入数据不满足字段约束（类型错误、长度超限、非空违反）"}
    ]
  },
  "index_strategy": [
