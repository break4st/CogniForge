        {"name": "idx_users_role", "columns": ["role"], "unique": false, "type": "B-tree", "purpose": "按角色筛选用户"},
        {"name": "idx_users_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "按状态筛选活跃/禁用用户"}
      ]
    },
    {
      "table": "projects",
      "indexes": [
        {"name": "idx_projects_name", "columns": ["name"], "unique": false, "type": "B-tree", "purpose": "支持项目名称模糊搜索"},
        {"name": "idx_projects_created_by", "columns": ["created_by"], "unique": false, "type": "B-tree", "purpose": "按创建人查询项目列表"},
        {"name": "idx_projects_deleted_at", "columns": ["deleted_at"], "unique": false, "type": "B-tree", "purpose": "过滤已删除项目的查询"}
      ]
    },
    {
      "table": "environments",
      "indexes": [
        {"name": "idx_environments_project_id", "columns": ["project_id"], "unique": false, "type": "B-tree", "purpose": "按项目查询关联的环境列表"},
        {"name": "idx_environments_type", "columns": ["type"], "unique": false, "type": "B-tree", "purpose": "按环境类型筛选（测试/灰度/正式）"},
        {"name": "idx_environments_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "按连接状态筛选"},
        {"name": "idx_environments_key_id", "columns": ["key_id"], "unique": false, "type": "B-tree", "purpose": "外键索引，支持密钥到环境的关联查询"},
        {"name": "idx_environments_deleted_at", "columns": ["deleted_at"], "unique": false, "type": "B-tree", "purpose": "过滤已删除环境的查询"}
      ]
    },
    {
      "table": "ssh_keys",
      "indexes": [
        {"name": "uq_ssh_keys_fingerprint", "columns": ["fingerprint"], "unique": true, "type": "B-tree", "purpose": "唯一约束，防止同一密钥重复存储"},
        {"name": "idx_ssh_keys_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "筛选活跃/已吊销的密钥"},
        {"name": "idx_ssh_keys_created_by", "columns": ["created_by"], "unique": false, "type": "B-tree", "purpose": "按创建人查询密钥"}
      ]
    },
    {
      "table": "deployments",
      "indexes": [
        {"name": "idx_deployments_project_id", "columns": ["project_id"], "unique": false, "type": "B-tree", "purpose": "按项目查询部署历史"},
        {"name": "idx_deployments_environment_id", "columns": ["environment_id"], "unique": false, "type": "B-tree", "purpose": "按环境查询部署记录"},
        {"name": "idx_deployments_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "按状态筛选部署任务"},
        {"name": "idx_deployments_created_at", "columns": ["created_at"], "unique": false, "type": "B-tree", "purpose": "按时间倒序查询最新部署"},
        {"name": "idx_deployments_project_env", "columns": ["project_id", "environment_id"], "unique": false, "type": "B-tree", "purpose": "复合查询：项目+环境的部署历史"}
      ]
    },
    {
      "table": "deployment_steps",
      "indexes": [
        {"name": "idx_deployment_steps_deployment_id", "columns": ["deployment_id"], "unique": false, "type": "B-tree", "purpose": "按部署任务查询所有步骤"},
        {"name": "idx_deployment_steps_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "按步骤状态筛选"},
        {"name": "idx_deployment_steps_deploy_status", "columns": ["deployment_id", "status"], "unique": false, "type": "B-tree", "purpose": "复合查询：部署任务的特定状态步骤"}
      ]
    },
    {
      "table": "audit_logs",
      "indexes": [
        {"name": "idx_audit_logs_action", "columns": ["action"], "unique": false, "type": "B-tree", "purpose": "按操作类型查询审计记录"},
        {"name": "idx_audit_logs_operator_id", "columns": ["operator_id"], "unique": false, "type": "B-tree", "purpose": "按操作人查询审计轨迹"},
        {"name": "idx_audit_logs_resource", "columns": ["resource_type", "resource_id"], "unique": false, "type": "B-tree", "purpose": "复合查询：指定资源类型+ID的所有操作记录"},
        {"name": "idx_audit_logs_timestamp", "columns": ["timestamp"], "unique": false, "type": "B-tree", "purpose": "时间范围查询，支持审计日志的分页和导出"}
      ]
    }
  ],
  "migration_strategy": {
    "tool": "Alembic",
    "naming": "V{序号}__{描述}.sql（如 V001__create_users_table.sql）",
    "rollback": "每个升级脚本提供对应的降级脚本（downgrade），命名格式为 V{序号}__{描述}.downgrade.sql。生产环境回滚时先执行降级脚本，确认数据一致性后再提交。关键表（deployments、audit_logs）的回滚需谨慎，保留数据快照以防止误操作。"
  },
  "capacity_estimation": {
    "estimated_rows_1y": "用户 100 行 / 项目 200 行 / 环境 600 行 / SSH密钥 200 行 / 部署任务 10,000 行 / 部署步骤 50,000 行 / 审计日志 100,000 行",
    "estimated_rows_3y": "用户 300 行 / 项目 600 行 / 环境 1,800 行 / SSH密钥 600 行 / 部署任务 30,000 行 / 部署步骤 150,000 行 / 审计日志 300,000 行",
    "hot_tables": ["deployments", "deployment_steps", "audit_logs"],
    "partition_strategy": "audit_logs 表按月份进行 LIST 分区（timestamp），保留最近12个月数据在线，历史数据归档至归档表。deployments 表按年份进行 RANGE 分区（created_at），保留最近3年数据在线。其余表数据量较小，无需分区。"
  },
  "connection_contracts": {
    "pool_size": "单服务最小5个连接，最大20个连接；总连接池上限100",
    "timeout": "连接超时5秒，查询超时30秒，事务空闲超时60秒",
    "service_accounts": [
      {"service": "项目管理服务", "db_user": "project_svc", "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"]},
      {"service": "环境管理服务", "db_user": "env_svc", "privileges": ["SELECT", "INSERT", "UPDATE", "DELETE"]},
      {"service": "部署执行服务", "db_user": "deploy_svc", "privileges": ["SELECT", "INSERT", "UPDATE"]},
      {"service": "密钥管理服务", "db_user": "key_svc", "privileges": ["SELECT", "INSERT", "UPDATE"]},
      {"service": "审计日志服务", "db_user": "audit_svc", "privileges": ["INSERT", "SELECT"]},
      {"service": "API网关", "db_user": "api_gw", "privileges": ["SELECT"]}
    ]
  }
}
