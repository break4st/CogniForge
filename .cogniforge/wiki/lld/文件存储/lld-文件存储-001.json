{
  "meta": {
    "doc_id": "lld-文件存储-001",
    "type": "lld",
    "module_type": "infrastructure",
    "module": "文件存储",
    "title": "文件存储模块详细设计",
    "author": "design_agent",
    "created": "2026-05-22T00:00:00Z"
  },
  "overview": {
    "description": "管理部署所需的可执行文件的存储和版本化，提供文件上传、下载、版本管理和完整性校验功能",
    "dependencies": [],
    "tech_stack": ["Python", "FastAPI", "SHA256"]
  },
  "data_models": [
    {
      "name": "FileMetadata",
      "type": "reference",
      "ownership": "owned",
      "description": "已存储文件的元数据记录，用于跟踪文件版本和关联信息",
      "fields": [
        {"name": "file_id", "type": "UUID", "required": true, "description": "文件唯一标识"},
        {"name": "project_id", "type": "UUID", "required": true, "description": "所属项目ID"},
        {"name": "file_name", "type": "string", "required": true, "description": "原始文件名"},
        {"name": "version", "type": "string", "required": true, "description": "语义化版本号"},
        {"name": "checksum_sha256", "type": "string", "required": true, "description": "SHA256 校验值"},
        {"name": "size_bytes", "type": "integer", "required": true, "description": "文件大小（字节）"},
        {"name": "storage_path", "type": "string", "required": true, "description": "对象存储中的完整路径"},
        {"name": "created_at", "type": "string (ISO datetime)", "required": true, "description": "上传时间"},
        {"name": "updated_at", "type": "string (ISO datetime)", "required": false, "description": "最后更新时间"}
      ]
    },
    {
      "name": "StorageConfig",
      "type": "config",
      "ownership": "owned",
      "description": "文件存储服务的全局配置",
      "fields": [
        {"name": "max_file_size_mb", "type": "integer", "required": true, "description": "单个文件最大大小（MB）"},
        {"name": "allowed_extensions", "type": "array<string>", "required": true, "description": "允许的文件扩展名列表"},
        {"name": "checksum_algorithm", "type": "string", "required": true, "description": "校验算法，默认 SHA256"},
        {"name": "storage_provider", "type": "string", "required": true, "description": "存储后端类型（local/minio/s3）"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "FileService.Upload",
      "method": "POST",
      "endpoint": "/api/v1/files/upload",
      "description": "上传可执行文件并关联到指定项目，支持版本化管理和完整性校验",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "所属项目ID（multipart/form-data 字段）"},
        {"name": "file", "type": "binary", "description": "可执行文件内容（multipart/form-data 文件字段）"},
        {"name": "version", "type": "string", "description": "版本号，可选，不指定则自动生成"}
      ],
      "response": {
        "status": 201,
        "body": {
          "file_id": "string (UUID)",
          "file_name": "string",
          "version": "string",
          "checksum": "string (SHA256)",
          "size_bytes": "integer",
          "created_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数无效，如 project_id 格式错误或缺少文件"},
        {"code": 409, "message": "版本号冲突，指定版本已存在"},
        {"code": 413, "message": "文件大小超过上限"},
        {"code": 422, "message": "文件完整性校验失败"}
      ]
    },
    {
      "name": "FileService.Download",
      "method": "GET",
      "endpoint": "/api/v1/files/download/{file_id}",
      "description": "根据文件ID下载已存储的可执行文件（二进制流）",
      "parameters": [
        {"name": "file_id", "type": "string (UUID)", "description": "文件唯一标识（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "Content-Type": "application/octet-stream",
          "Content-Disposition": "string",
          "Content-Length": "integer",
          "body": "binary"
        }
      },
      "error_codes": [
        {"code": 404, "message": "文件不存在或已被删除"}
      ]
    },
    {
      "name": "FileService.ListVersions",
      "method": "GET",
      "endpoint": "/api/v1/files/versions",
      "description": "查询指定项目的所有已上传文件版本列表（分页）",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "项目ID（查询参数）"},
        {"name": "page", "type": "integer", "description": "页码，默认 1"},
        {"name": "page_size", "type": "integer", "description": "每页条数，默认 20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "total": "integer",
          "page": "integer",
          "page_size": "integer",
          "items": "array<object>"
        }
      },
      "error_codes": [
        {"code": 400, "message": "参数无效"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "校验优先：上传时立即进行 SHA256 完整性校验，校验通过后持久化存储；所有操作错误以统一 JSON 格式返回，HTTP 状态码区分错误类型",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {"code": 400, "name": "参数校验错误", "description": "请求参数格式或内容不符合要求"},
      {"code": 404, "name": "文件不存在", "description": "指定的 file_id 对应的文件在存储中不存在"},
      {"code": 409, "name": "版本冲突", "description": "指定版本号已存在且不允许覆盖"},
      {"code": 413, "name": "文件过大", "description": "上传文件超过系统设定的最大大小限制"},
      {"code": 422, "name": "校验失败", "description": "文件完整性校验（SHA256）不通过"},
      {"code": 500, "name": "存储后端错误", "description": "后端对象存储写入或读取异常"}
    ]
  },
  "topology": {
    "buckets": [
      {
        "name": "deploy-artifacts",
        "description": "主存储桶，存放所有项目的可执行部署文件",
        "versioning_enabled": true,
        "encryption": "AES-256",
        "public_access": false
      }
    ],
    "path_conventions": "{project_id}/{version}/{file_name}  示例: a1b2c3d4-e5f6-7890-abcd-ef1234567890/1.0.0/app-server.bin"
  },
  "connection_contracts": {
    "endpoint": "文件存储服务内部地址（如 http://minio:9000 或本地文件系统 /data/deploy-artifacts）",
    "auth_method": "预共享密钥（Access Key / Secret Key）",
    "secure": true,
    "tls_enabled": true,
    "timeout": {
      "connect_seconds": 10,
      "read_seconds": 60,
      "write_seconds": 60
    },
    "max_file_size_mb": 500,
    "allowed_content_types": [
      "application/octet-stream",
      "application/x-executable",
      "application/gzip",
      "application/x-tar"
    ]
  }
}
