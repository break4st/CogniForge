  "module_boundary": {
    "in_scope": [
      "用户会话管理：存储会话信息，支持TTL自动过期与刷新",
      "JWT黑名单：记录被吊销的令牌JTI，配合TTL自动清理",
      "部署日志实时转发：通过Redis Pub/Sub将部署执行日志推送给订阅方",
      "通用热点缓存：提供任意Key-Value缓存，提升查询性能"
    ],
    "out_of_scope": [
      "数据的持久化到磁盘（由MySQL负责）",
      "业务消息队列或任务调度（由RabbitMQ负责）",
      "用户认证与授权逻辑（由Auth Service实现）",
      "网络通信协议转换（HTTP/WebSocket由Gateway/服务层处理）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "缓存与临时数据存储，用于存储用户会话、JWT黑名单以及部署日志流的临时转发。",
    "dependencies": [],
    "tech_stack": [
      "Redis 7",
      "redis-py",
      "Python 3.11"
    ]
  },
