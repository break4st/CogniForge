{
  "meta": {
    "doc_id": "lld-Redis-001",
    "type": "lld",
    "module_type": "ModuleType.SERVICE",
    "module": "Redis",
    "title": "LLD - Redis",
    "author": "design_agent",
    "created": "2026-05-21 10:20"
  },
  "overview": {
    "description": "缓存和会话存储，用于提升系统响应速度和维护实时状态。提供用户会话存储、部署实时状态缓存、WebSocket 连接管理信息、分布式锁（防止部署冲突）等能力。",
    "dependencies": [],
    "tech_stack": ["Redis 7"]
  },
  "data_models": [
    {
      "name": "user_session",
      "type": "store",
      "ownership": "owned",
      "description": "用户会话数据存储，记录用户登录态和会话信息。使用 Redis String/Hash 结构，Key 格式：session:{session_id}",
      "fields": [
        {"name": "session_id", "type": "string", "required": true, "description": "会话唯一标识（UUID）"},
        {"name": "user_id", "type": "string", "required": true, "description": "用户 ID"},
        {"name": "username", "type": "string", "required": true, "description": "用户名"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色"},
        {"name": "token", "type": "string", "required": true, "description": "JWT token"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "会话创建时间"},
        {"name": "expires_at", "type": "datetime", "required": true, "description": "会话过期时间"},
        {"name": "last_access_at", "type": "datetime", "required": false, "description": "最后访问时间，用于会话续期判断"}
      ]
    },
    {
      "name": "deployment_status_cache",
      "type": "store",
      "ownership": "owned",
      "description": "部署实时状态缓存，用于 Deployment Orchestrator 通过 WebSocket 向 Web Console 推送实时部署进度。Key 格式：deployment:{deployment_id}:status",
      "fields": [
        {"name": "deployment_id", "type": "string", "required": true, "description": "部署记录 ID"},
        {"name": "project_id", "type": "string", "required": true, "description": "项目 ID"},
        {"name": "environment_id", "type": "string", "required": true, "description": "环境 ID"},
        {"name": "status", "type": "string", "required": true, "description": "部署状态，枚举值：pending/running/success/failed"},
        {"name": "progress", "type": "integer", "required": true, "description": "部署进度百分比（0-100）"},
        {"name": "log", "type": "string", "required": false, "description": "实时日志内容（追加写入）"},
        {"name": "started_at", "type": "datetime", "required": true, "description": "部署开始时间"},
        {"name": "finished_at", "type": "datetime", "required": false, "description": "部署完成时间，running 状态下为空"}
      ]
    },
    {
      "name": "websocket_connection_info",
      "type": "store",
      "ownership": "owned",
      "description": "WebSocket 连接管理信息，记录 WebSocket 连接与部署任务的关联关系，支持按 deployment_id 或 user_id 查找活跃连接。Key 格式：ws:conn:{connection_id}",
      "fields": [
        {"name": "connection_id", "type": "string", "required": true, "description": "WebSocket 连接唯一标识"},
        {"name": "user_id", "type": "string", "required": true, "description": "用户 ID"},
        {"name": "deployment_id", "type": "string", "required": false, "description": "关联的部署记录 ID，可能为空（初始连接时）"},
        {"name": "channel", "type": "string", "required": true, "description": "订阅频道，格式：deployment:{deployment_id}"},
        {"name": "connected_at", "type": "datetime", "required": true, "description": "连接建立时间"},
        {"name": "last_heartbeat_at", "type": "datetime", "required": false, "description": "最后心跳时间，用于超时断开检测"}
      ]
    },
    {
      "name": "distributed_lock",
      "type": "config",
      "ownership": "owned",
      "description": "分布式锁配置，防止同一项目/环境同时触发多个部署导致冲突。利用 Redis SET NX EX 原子指令实现，Key 格式：lock:{project_id}:{environment_id}",
      "fields": [
        {"name": "lock_key", "type": "string", "required": true, "description": "锁键（格式：lock:{project_id}:{environment_id}）"},
        {"name": "owner", "type": "string", "required": true, "description": "持有者标识，值为部署任务 ID"},
        {"name": "ttl_seconds", "type": "integer", "required": true, "description": "锁自动过期时间（默认 30 秒），防止死锁"},
        {"name": "acquired_at", "type": "datetime", "required": true, "description": "锁获取时间"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "用户会话 - 获取会话",
      "method": "INTERNAL",
      "endpoint": "sessions/{session_id}",
      "description": "根据 session_id 获取用户会话信息，用于 API Gateway 和认证中间件验证用户登录态",
      "parameters": [
        {"name": "session_id", "type": "string", "description": "会话 ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "session_id": "string",
          "user_id": "string",
          "username": "string",
          "role": "string",
          "token": "string",
          "created_at": "datetime",
          "expires_at": "datetime",
          "last_access_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "会话不存在或已过期"},
        {"code": 500, "message": "Redis 连接失败"}
      ]
    },
    {
      "name": "用户会话 - 设置/创建会话",
      "method": "INTERNAL",
      "endpoint": "sessions",
      "description": "创建或更新用户会话信息，登录成功后调用",
      "parameters": [
        {"name": "session_id", "type": "string", "description": "会话 ID"},
        {"name": "session_data", "type": "object", "description": "会话数据（包含 user_id, username, role, token 等）"},
        {"name": "ttl_seconds", "type": "integer", "description": "过期时间（秒），默认 3600"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "缓存写入失败"}
      ]
    },
    {
      "name": "用户会话 - 删除会话",
      "method": "INTERNAL",
      "endpoint": "sessions/{session_id}",
      "description": "删除指定的用户会话，用户登出时调用",
      "parameters": [
        {"name": "session_id", "type": "string", "description": "会话 ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis 操作失败"}
      ]
    },
    {
      "name": "部署状态 - 获取部署状态",
      "method": "INTERNAL",
      "endpoint": "deployments/{deployment_id}/status",
      "description": "获取部署实时状态，用于 Web Console 页面初始加载和 Deployment Orchestrator 状态查询",
      "parameters": [
        {"name": "deployment_id", "type": "string", "description": "部署记录 ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string",
          "project_id": "string",
          "environment_id": "string",
          "status": "string",
          "progress": "integer",
          "log": "string",
          "started_at": "datetime",
          "finished_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "部署状态不存在或已过期"},
        {"code": 500, "message": "Redis 连接失败"}
      ]
    },
    {
      "name": "部署状态 - 更新部署状态",
      "method": "INTERNAL",
      "endpoint": "deployments/{deployment_id}/status",
      "description": "更新部署实时状态，SSH Execution Service 在执行过程中持续调用以推送日志和进度",
      "parameters": [
        {"name": "deployment_id", "type": "string", "description": "部署记录 ID"},
        {"name": "status", "type": "string", "description": "部署状态"},
        {"name": "progress", "type": "integer", "description": "进度百分比"},
        {"name": "log", "type": "string", "description": "追加的日志内容"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "状态更新失败"}
      ]
    },
    {
      "name": "实时推送 - 发布消息",
      "method": "INTERNAL",
      "endpoint": "pubsub/channels/{channel}/messages",
      "description": "通过 Redis Pub/Sub 发布状态消息到指定频道，Deployment Orchestrator 在各阶段状态变更时调用以实现实时推送",
      "parameters": [
        {"name": "channel", "type": "string", "description": "频道名称，格式：deployment:{deployment_id}"},
        {"name": "message", "type": "string", "description": "消息内容（JSON 字符串，包含状态、进度、日志等）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "subscribers": "integer"
        }
      },
      "error_codes": [
        {"code": 500, "message": "消息发布失败"}
      ]
    },
    {
      "name": "实时推送 - 订阅频道",
      "method": "INTERNAL",
      "endpoint": "pubsub/channels/{channel}/subscriptions",
      "description": "订阅指定频道的状态更新消息，Deployment Orchestrator 的 WebSocket 管理模块在客户端连接时调用",
      "parameters": [
        {"name": "channel", "type": "string", "description": "频道名称"},
        {"name": "connection_id", "type": "string", "description": "WebSocket 连接 ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "订阅失败"}
      ]
    },
    {
      "name": "分布式锁 - 获取锁",
      "method": "INTERNAL",
      "endpoint": "locks",
      "description": "获取分布式锁，Deployment Orchestrator 在开始部署前调用，防止同一环境同时触发多个部署",
      "parameters": [
        {"name": "lock_key", "type": "string", "description": "锁键，格式：lock:{project_id}:{environment_id}"},
        {"name": "owner", "type": "string", "description": "持有者标识，值为部署任务 ID"},
        {"name": "ttl_seconds", "type": "integer", "description": "锁过期时间（秒），默认 30"}
      ],
      "response": {
        "status": 200,
        "body": {
          "acquired": "boolean",
          "lock_owner": "string"
        }
      },
      "error_codes": [
        {"code": 409, "message": "锁已被其他部署任务持有"},
        {"code": 500, "message": "Redis 操作失败"}
      ]
    },
    {
      "name": "分布式锁 - 释放锁",
      "method": "INTERNAL",
      "endpoint": "locks/{lock_key}",
      "description": "释放指定的分布式锁，部署完成或取消时调用，需校验 owner 以防止误释放",
      "parameters": [
        {"name": "lock_key", "type": "string", "description": "锁键"},
        {"name": "owner", "type": "string", "description": "持有者标识（用于校验，只有持有者才能释放）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "released": "boolean"
        }
      },
      "error_codes": [
        {"code": 403, "message": "非锁持有者无权释放"},
        {"code": 500, "message": "Redis 操作失败"}
      ]
    },
    {
      "name": "通用缓存 - 获取缓存",
      "method": "INTERNAL",
      "endpoint": "cache/{key}",
      "description": "根据键获取通用缓存数据，供各服务缓存数据库查询结果以减轻 PostgreSQL 压力",
      "parameters": [
        {"name": "key", "type": "string", "description": "缓存键"}
      ],
      "response": {
        "status": 200,
        "body": {
          "value": "string",
          "ttl_remaining": "integer"
        }
      },
      "error_codes": [
        {"code": 404, "message": "缓存键不存在或已过期"},
        {"code": 500, "message": "Redis 连接失败"}
      ]
    },
    {
      "name": "通用缓存 - 设置缓存",
      "method": "INTERNAL",
      "endpoint": "cache",
      "description": "设置通用缓存数据，支持自定义过期时间",
      "parameters": [
        {"name": "key", "type": "string", "description": "缓存键"},
        {"name": "value", "type": "string", "description": "缓存值（JSON 序列化字符串）"},
        {"name": "ttl_seconds", "type": "integer", "description": "过期时间（秒），0 表示永不过期"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "缓存写入失败"}
      ]
    },
    {
      "name": "通用缓存 - 删除缓存",
      "method": "INTERNAL",
      "endpoint": "cache/{key}",
      "description": "删除指定的缓存键，数据变更时调用以保持缓存一致性",
      "parameters": [
        {"name": "key", "type": "string", "description": "缓存键"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis 操作失败"}
      ]
    },
    {
      "name": "WebSocket - 注册连接",
      "method": "INTERNAL",
      "endpoint": "websocket/connections",
      "description": "注册 WebSocket 连接信息，客户端建立 WebSocket 连接时调用",
      "parameters": [
        {"name": "connection_id", "type": "string", "description": "连接 ID"},
        {"name": "user_id", "type": "string", "description": "用户 ID"},
        {"name": "deployment_id", "type": "string", "description": "关联的部署记录 ID"},
        {"name": "channel", "type": "string", "description": "订阅频道"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "连接信息注册失败"}
      ]
    },
    {
      "name": "WebSocket - 移除连接",
      "method": "INTERNAL",
      "endpoint": "websocket/connections/{connection_id}",
      "description": "移除已关闭的 WebSocket 连接信息，客户端断开连接时调用以清理资源",
      "parameters": [
        {"name": "connection_id", "type": "string", "description": "连接 ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "result": "boolean"
        }
      },
      "error_codes": [
        {"code": 500, "message": "连接信息移除失败"}
      ]
    }
  ],
  "error_handling": "Redis 缓存层采用降级而非熔断策略。当 Redis 连接失败或超时时，各调用方服务应自动降级：会话校验降级为拒绝请求（安全性要求），通用缓存降级为直接查询 PostgreSQL，部署状态降级为数据库轮询。分布式锁获取失败（锁已被持有）返回 409 冲突，由 Deployment Orchestrator 决定重试或终止。所有 SET 操作（尤其分布式锁）必须使用 NX+EX 原子指令，确保并发安全。缓存键统一设置合理 TTL，防止内存泄漏。Redis 连接池配置最大连接数 100、连接超时 2s、读取超时 3s，异常时自动重连（最多 3 次），重连间隔 1s。"
}
