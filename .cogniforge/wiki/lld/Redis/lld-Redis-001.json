  "data_models": [
    {
      "id": "DM-001",
      "name": "会话令牌存储",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "存储用户会话令牌及关联信息，支持快速验证与续期。",
      "fields": [
        {
          "name": "user_id",
          "type": "string",
          "required": true,
          "description": "用户唯一标识"
        },
        {
          "name": "exp",
          "type": "int64",
          "required": true,
          "description": "过期时间戳"
        },
        {
          "name": "roles",
          "type": "[]string",
          "required": true,
          "description": "用户角色列表"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [
        "键模式为 session:{token}，TTL 24小时，每次访问自动续期"
      ],
      "lifecycle": {
        "create": "用户登录时创建",
        "update": "每次访问时续期",
        "delete": "主动登出或TTL过期",
        "retention": "24小时"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "部署日志消息",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "实时日志发布的消息体结构，用于 Pub/Sub 频道 deployment:logs。",
      "fields": [
        {
          "name": "deployment_id",
          "type": "string",
          "required": true,
          "description": "部署任务唯一标识"
        },
        {
          "name": "step",
          "type": "string",
          "required": true,
          "description": "当前步骤名称"
        },
        {
          "name": "level",
          "type": "string",
          "required": true,
          "description": "日志级别(info/warn/error)"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "日志内容"
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "ISO8601格式时间戳"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "部署执行步骤产生",
        "update": "",
        "delete": "",
        "retention": "不持久化，实时推送"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "部署任务消息",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "部署任务队列的消息体，入队到 deploy:tasks:incoming 队列。",
      "fields": [
        {
          "name": "task_id",
          "type": "string",
          "required": true,
          "description": "任务UUID"
        },
        {
          "name": "project_id",
          "type": "string",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "environment_id",
          "type": "string",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "file_id",
          "type": "string",
          "required": true,
          "description": "MinIO文件引用"
        }
      ],
      "source_requirements": [
        "REQ-002"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "部署请求入队",
        "update": "",
        "delete": "消费后确认删除",
        "retention": "持久化直到消费"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "topology": {
    "exchanges": [
      {
        "name": "deployment:logs",
        "type": "channel",
        "durable": false,
        "description": "Pub/Sub频道，用于发布部署实时日志",
        "bindings": []
      }
    ],
    "queues": [
      {
        "name": "deploy:tasks:incoming",
        "durable": true,
        "description": "部署任务队列，支持可靠消费",
        "bindings": []
      }
    ],
    "namespaces": [
      {
        "name": "session",
        "description": "会话令牌存储命名空间",
        "ttl": 86400
      }
    ]
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "发布部署日志",
      "type": "pubsub",
      "technology": "Redis Pub/Sub",
      "method": "PUBLISH",
      "description": "向 deployment:logs 频道发布部署日志消息",
      "endpoint": "deployment:logs",
      "request": {
        "body": "$ref:DM-002"
      },
      "response": {
        "body": {
          "description": "发布成功返回订阅者数量",
          "schema": {
            "type": "integer"
          }
        }
      },
      "business_rules": {
        "invariants": [
          "日志级别必须为 info/warn/error 之一",
          "timestamp 必须为 ISO8601 格式"
        ],
        "preconditions": [
          "频道存在且可用"
        ],
        "postconditions": [
          "消息已发布到频道，订阅者收到消息"
        ],
        "side_effects": []
      },
      "consumer_component_ids": [
        "CMP-001"
      ],
      "contract_id": "",
      "source_requirements": [
        "REQ-001"
      ],
      "error_handling": {
        "strategy": "重试3次，间隔1s",
        "circuit_breaker": {
          "enabled": false
        },
        "fallback": "记录错误日志并返回错误"
      },
      "change_history": []
    },
    {
      "id": "IF-002",
      "name": "订阅部署日志",
      "type": "pubsub",
      "technology": "Redis Pub/Sub",
      "method": "SUBSCRIBE",
      "description": "订阅 deployment:logs 频道以接收部署日志消息",
      "endpoint": "deployment:logs",
      "request": {
        "body": {
          "description": "无请求体，订阅为持续连接",
          "schema": {}
        }
      },
      "response": {
        "body": {
          "description": "异步推送 DM-002 消息",
          "schema": {
            "$ref": "DM-002"
          }
        }
      },
      "business_rules": {
        "invariants": [],
        "preconditions": [
          "频道存在"
        ],
        "postconditions": [
          "持续接收日志消息"
        ],
        "side_effects": []
      },
      "consumer_component_ids": [
        "CMP-001"
      ],
      "contract_id": "",
      "source_requirements": [
        "REQ-001"
      ],
      "error_handling": {
        "strategy": "重连机制，退避重试",
        "circuit_breaker": {
          "enabled": false
        },
        "fallback": "记录错误并通知监控"
      },
      "change_history": []
    },
    {
      "id": "IF-003",
      "name": "入队部署任务",
      "type": "queue",
      "technology": "Redis List (LPUSH)",
      "method": "LPUSH",
      "description": "将部署任务消息推入 deploy:tasks:incoming 队列",
      "endpoint": "deploy:tasks:incoming",
      "request": {
        "body": "$ref:DM-003"
      },
      "response": {
        "body": {
          "description": "返回队列长度",
          "schema": {
            "type": "integer"
          }
        }
      },
      "business_rules": {
        "invariants": [
          "所有字段必须非空"
        ],
        "preconditions": [
          "队列存在"
        ],
        "postconditions": [
          "消息已入队，长度+1"
        ],
        "side_effects": []
      },
      "consumer_component_ids": [
        "CMP-001"
      ],
      "contract_id": "",
      "source_requirements": [
        "REQ-002"
      ],
      "error_handling": {
        "strategy": "重试3次后记录失败",
        "circuit_breaker": {
          "enabled": false
        },
        "fallback": "返回错误信息"
      },
      "change_history": []
    }
  ],
  "error_handling": {
    "strategy": "统一重试3次，指数退避，失败后记录日志并通知监控"
  },
  "dependencies": [],
  "configuration": {
    "connection_pool": {
      "size": 10,
      "timeout": 5000
    }
  }
}