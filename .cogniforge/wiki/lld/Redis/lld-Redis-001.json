      "coverage": "full",
      "notes": "REQ-001 覆盖系统对用户会话缓存与JWT吊销的支持，所有数据模型和接口均为此设计"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "Session Store",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "用户会话存储。以session:{session_id}为键，存储Hash结构，包含用户ID、用户名、令牌、角色、创建时间和最后访问时间。设置TTL并可在访问时刷新。",
      "fields": [
        {
          "name": "user_id",
          "type": "string",
          "required": true,
          "description": "用户唯一标识"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "用户名"
        },
        {
          "name": "access_token",
          "type": "string",
          "required": true,
          "description": "访问令牌"
        },
        {
          "name": "refresh_token",
          "type": "string",
          "required": true,
          "description": "刷新令牌"
        },
        {
          "name": "roles",
          "type": "string",
          "required": true,
          "description": "用户角色，以JSON数组字符串存储"
        },
        {
          "name": "created_at",
          "type": "string",
          "required": true,
          "description": "会话创建时间，ISO8601格式"
        },
        {
          "name": "last_access",
          "type": "string",
          "required": true,
          "description": "最后访问时间，ISO8601格式"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "用户登录时创建session:{session_id}键，写入Hash字段，设置TTL默认1800秒",
        "update": "每次令牌验证时更新last_access字段并重置TTL",
        "delete": "用户主动登出时删除键；TTL到期自动销毁",
        "retention": "无额外保留策略，完全依赖TTL"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "JWT Blacklist",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "JWT黑名单。以blacklist:{jti}为键，值为固定字符串\"1\"，利用键的存在性判断令牌是否被吊销。设置TTL等于JWT剩余有效时间。",
      "fields": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "固定值\"1\"，仅用于标记"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "管理员吊销令牌或用户登出时添加，SET键并设EXPIRE为令牌剩余有效期",
        "update": "无",
        "delete": "TTL到期自动删除",
        "retention": "不额外保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "Deploy Log Channel",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "部署日志发布/订阅频道。频道模式为deploy_logs:{deployment_id}，消息为包含部署ID、时间戳、日志级别、消息和步骤索引的JSON对象。",
      "fields": [
        {
          "name": "deployment_id",
          "type": "string",
          "required": true,
          "description": "部署任务ID"
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "日志时间戳，ISO8601格式"
        },
        {
          "name": "log_level",
          "type": "string",
          "required": true,
          "description": "日志级别，如INFO、ERROR"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "日志内容"
        },
        {
          "name": "step_index",
          "type": "integer",
          "required": false,
          "description": "当前步骤序号，可选"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "部署开始时由Deploy Engine发布第一条消息，频道自动创建",
        "update": "持续发布消息直至部署结束",
        "delete": "无消息时频道自动消失，无主动删除",
        "retention": "无，消息不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "DM-004",
      "name": "Generic Cache",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "通用缓存。以cache:{namespace}:{key}或调用方自定义模式为键，存储字符串值。调用方指定TTL，未指定时默认3600秒。",
      "fields": [
        {
          "name": "value",
          "type": "string",
          "required": true,
          "description": "序列化后的缓存数据，通常为JSON字符串"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "调用方通过cache.set写入键值并指定TTL",
        "update": "调用方可通过set覆盖更新",
        "delete": "调用方主动删除或TTL到期自动删除",
        "retention": "依赖TTL，无额外保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
