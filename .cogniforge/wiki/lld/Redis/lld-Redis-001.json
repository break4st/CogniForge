      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "500",
        "name": "REDIS_CONNECTION_ERROR",
        "description": "无法建立连接、连接池耗尽或超时；触发告警，调用方重试或返回服务不可用"
      },
      {
        "code": "500",
        "name": "REDIS_TIMEOUT",
        "description": "命令执行超过socket_timeout；重试一次，仍失败则返回TIMEOUT错误给客户端"
      },
      {
        "code": "404",
        "name": "NOT_FOUND",
        "description": "get/check未命中对应键；返回None/false，不视为异常"
      },
      {
        "code": "400",
        "name": "SERIALIZATION_ERROR",
        "description": "写入缓存时数据无法序列化为JSON；记录错误，返回参数无效"
      },
      {
        "code": "500",
        "name": "UNKNOWN_ERROR",
        "description": "其他未预料的Redis响应；记录完整异常堆栈，返回500"
      }
    ]
