      "id": "DM-001",
      "name": "projects",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "projects"
      },
      "description": "项目实体表，作为部署的顶级隔离单元。存储项目基本信息，包括名称、描述和时间戳。",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "required": true,
          "description": "项目唯一标识符"
        },
        {
          "name": "name",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "项目名称，必须唯一"
        },
        {
          "name": "description",
          "type": "TEXT",
          "required": false,
          "description": "项目描述信息"
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP WITH TIME ZONE",
          "required": true,
          "description": "创建时间戳"
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMP WITH TIME ZONE",
          "required": true,
          "description": "最后更新时间戳"
        }
      ],
      "indexes": [
        {
          "name": "idx_projects_name",
          "unique": true,
          "columns": ["name"]
        }
      ],
      "constraints": [
        "PRIMARY KEY (id)",
        "UNIQUE (name)"
      ],
      "lifecycle": {
        "create": "项目创建时插入新记录",
        "update": "项目更新时修改 name, description, updated_at",
        "delete": "项目删除时删除记录，可能级联删除关联数据（需根据业务逻辑确定）",
        "retention": "无明确数据保留策略，默认永久保留"
      },
