  "error_handling": {
    "strategy": "服务层捕获所有异常，FastAPI异常处理器统一转换为标准错误响应格式，区分客户端错误和服务器错误。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "404",
        "name": "资源未找到",
        "description": "请求的项目ID不存在，返回404错误，detail包含项目ID。"
      },
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "请求体缺少必填字段或字段格式不正确，返回400错误，detail包含具体校验失败信息。"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "项目名称重复等唯一性约束冲突，返回409错误，detail指明冲突字段。"
      },
      {
        "code": "500",
        "name": "服务器内部错误",
        "description": "数据库连接失败、查询异常等未预期错误，返回500错误，detail为通用错误描述，避免泄露内部细节。"
      }
    ]
  },
