    },
    {
      "id": "IF-004",
      "name": "绑定/解绑环境",
      "endpoint": "POST /api/projects/{project_id}/environments",
      "method": "POST",
      "description": "根据请求中的 action 字段绑定或解绑环境",
      "path": "/api/projects/{project_id}/environments",
      "request": {
        "path": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "integer"
            }
          },
          "required": [
            "project_id"
          ]
        },
        "body": {
          "type": "object",
          "properties": {
            "environment_id": {
              "type": "integer"
            },
            "action": {
              "type": "string",
              "enum": [
                "bind",
                "unbind"
              ]
            }
          },
          "required": [
            "environment_id",
            "action"
          ]
        }
      },
      "response": {
        "body": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "project_id": {
              "type": "integer"
            },
            "environment_id": {
              "type": "integer"
            },
            "action": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "description": "请求参数错误"
        },
        {
          "status": 404,
          "description": "项目或环境不存在"
        },
        {
          "status": 409,
          "description": "绑定冲突或解绑时关系不存在"
