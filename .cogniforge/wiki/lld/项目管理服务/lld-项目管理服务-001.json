  "module_boundary": {
    "in_scope": [
      "项目的创建、唯一性校验",
      "项目列表查询与模糊搜索",
      "项目删除（自动解除所有环境绑定）",
      "项目与环境的绑定/解绑（toggle 模式）",
      "提供 REST API 供前端调用"
    ],
    "out_of_scope": [
      "环境本身的创建、配置或删除",
      "部署任务执行或远程文件管理",
      "用户认证与授权",
      "前端页面渲染"
    ],
