  "data_models": [
    {
      "id": "DM-001",
      "name": "Project",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "projects"
      },
      "description": "项目基本信息表，存放项目名称与描述。",
      "fields": [
        {
          "name": "id",
          "type": "TEXT/UUID",
          "required": true,
          "description": "主键，唯一标识"
        },
        {
          "name": "name",
          "type": "TEXT",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "TEXT",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_projects_name",
          "unique": false,
          "columns": [
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-300"
      ],
      "source_contracts": [],
      "constraints": [
        "name 长度不超过 255 字符",
        "id 遵循 UUID4 格式"
      ],
      "lifecycle": {
        "create": "创建项目时插入",
        "update": "name 或 description 变化时更新",
        "delete": "项目删除时级联删除",
        "retention": "永久保存"
      }
    },
    {
      "id": "DM-002",
      "name": "ActiveProjectConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "存储当前激活的项目 ID，全局唯一。",
      "fields": [
        {
          "name": "project_id",
          "type": "TEXT",
          "required": false,
          "description": "当前激活的项目 ID，外键引用 projects.id"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-300"
      ],
      "source_contracts": [],
      "constraints": [
        "全局仅一条记录",
        "可为空值"
      ],
      "lifecycle": {
        "create": "服务初始化时创建",
        "update": "设置激活项目时更新",
        "delete": "不允许删除",
        "retention": "永久保存"
      }
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "创建项目",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-300",
      "method": "POST",
      "endpoint": "/api/projects",
      "description": "新建一个项目，返回项目信息",
      "parameters": [],
      "request_body": {
        "name": "string",
        "description": "string"
      },
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "name": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "请求参数校验失败"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "获取项目列表",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-002",
      "provider_component_id": "CMP-300",
      "method": "GET",
      "endpoint": "/api/projects",
      "description": "获取所有项目列表，支持搜索和分页",
      "parameters": [
        {
          "name": "search",
          "type": "string",
          "required": false,
          "description": "搜索关键词",
          "location": "query"
        },
        {
          "name": "limit",
          "type": "integer",
          "required": false,
          "description": "每页数量",
          "location": "query"
        },
        {
          "name": "offset",
          "type": "integer",
          "required": false,
          "description": "偏移量",
          "location": "query"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "projects": "array",
          "total": "integer",
          "limit": "integer",
          "offset": "integer"
        }
      },
      "error_codes": []
    },
    {
      "id": "IF-003",
      "name": "获取单个项目",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-300",
      "method": "GET",
      "endpoint": "/api/projects/{project_id}",
      "description": "获取指定项目的详细信息",
      "parameters": [
        {
          "name": "project_id",
          "type": "string",
          "required": true,
          "description": "项目ID",
          "location": "path"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "name": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "项目不存在"
        }
      ]
    },
    {
      "id": "IF-004",
      "name": "修改项目",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-004",
      "provider_component_id": "CMP-300",
      "method": "PUT",
      "endpoint": "/api/projects/{project_id}",
      "description": "修改项目名称或描述",
      "parameters": [
        {
          "name": "project_id",
          "type": "string",
          "required": true,
          "description": "项目ID",
          "location": "path"
        }
      ],
      "request_body": {
        "name": "string",
        "description": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "name": "string",
          "description": "string",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "项目不存在"
        },
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "请求参数校验失败"
        }
      ]
    },
    {
      "id": "IF-005",
      "name": "删除项目",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-005",
      "provider_component_id": "CMP-300",
      "method": "DELETE",
      "endpoint": "/api/projects/{project_id}",
      "description": "删除项目，并触发关联环境配置清理",
      "parameters": [
        {
          "name": "project_id",
          "type": "string",
          "required": true,
          "description": "项目ID",
          "location": "path"
        }
      ],
      "response": {
        "status": 204
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "项目不存在"
        }
      ]
    },
    {
      "id": "IF-006",
      "name": "获取当前激活项目",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-006",
      "provider_component_id": "CMP-300",
      "method": "GET",
      "endpoint": "/api/projects/active",
      "description": "获取当前激活的项目",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "project_id": "string"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "未设置激活项目"
        }
      ]
    },
    {
      "id": "IF-007",
      "name": "设置当前激活项目",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-007",
      "provider_component_id": "CMP-300",
      "method": "PUT",
      "endpoint": "/api/projects/active",
      "description": "设置当前激活的项目",
      "parameters": [],
      "request_body": {
        "project_id": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "project_id": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "无效的项目ID"
        }
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "Project",
      "description": "项目实体",
      "responsibilities": [
        "封装项目数据",
        "提供业务校验（如名称非空）"
      ],
      "interfaces": [],
      "business_rules": [
        "名称不能为空",
        "名称长度不超过255字符"
      ]
    },
    {
      "id": "DO-002",
      "name": "ProjectService",
      "description": "项目业务逻辑服务",
      "responsibilities": [
        "协调项目CRUD操作",
        "删除项目时通知环境配置服务"
      ],
      "interfaces": [
        "IF-001",
        "IF-002",
        "IF-003",
        "IF-004",
        "IF-005"
      ],
      "business_rules": [
        "删除项目前需确认没有关联的关键数据",
        "项目名称在同级下应唯一（暂不强制）"
      ]
    },
    {
      "id": "DO-003",
      "name": "ActiveProjectManager",
      "description": "管理当前激活项目的服务",
      "responsibilities": [
        "读取和更新激活项目标识",
        "确保激活项目ID存在（若设置）"
      ],
      "interfaces": [
        "IF-006",
        "IF-007"
      ],
      "business_rules": [
        "只能设置一个激活项目",
        "设置的ID必须存在于projects表"
      ]
    },
    {
      "id": "DO-004",
      "name": "ValidationUtils",
      "description": "请求参数校验工具",
      "responsibilities": [
        "校验项目名称、描述长度等",
        "提供统一的错误格式"
      ],
      "interfaces": [],
      "business_rules": [
        "名称不能为纯空格",
        "描述允许空字符串"
      ]
    },
    {
      "id": "DO-005",
      "name": "ErrorHandler",
      "description": "统一错误处理",
      "responsibilities": [
        "捕获异常并转换为标准错误响应",
        "记录错误日志"
      ],
      "interfaces": [],
      "business_rules": [
        "不泄露敏感信息"
      ]
    },
    {
      "id": "DO-006",
      "name": "ProjectRepository",
      "description": "项目数据访问对象",
      "responsibilities": [
        "封装数据库CRUD",
        "提供搜索和分页"
      ],
      "interfaces": [],
      "business_rules": [
        "使用参数化查询防止注入"
      ]
    },
    {
      "id": "DO-007",
      "name": "EnvironmentClient",
      "description": "环境配置服务客户端",
      "responsibilities": [
        "调用环境配置服务删除项目下的配置"
      ],
      "interfaces": [],
      "business_rules": [
        "处理远程调用失败"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "项目管理服务契约",
      "description": "定义项目管理服务的内部接口契约和调用方式",
      "provider": "项目管理服务",
      "consumers": [
        "前端",
        "环境配置服务（消费删除事件）"
      ],
      "interfaces": [
        "IF-001",
        "IF-002",
        "IF-003",
        "IF-004",
        "IF-005",
        "IF-006",
        "IF-007"
      ],
      "error_handling": {
        "strategy": "统一使用FastAPI异常处理，返回JSON格式错误",
        "error_codes": [
          {
            "status": 400,
            "code": "VALIDATION_ERROR",
            "description": "请求参数校验失败"
          },
          {
            "status": 404,
            "code": "NOT_FOUND",
            "description": "资源未找到"
          },
          {
            "status": 500,
            "code": "INTERNAL_ERROR",
            "description": "服务器内部错误"
          }
        ]
      },
      "policies": {
        "rate_limit": "每IP 100次/分钟",
        "authentication": "不需要（后续扩展）",
        "authorization": "无"
      }
    }
  ],
  "business_rules": {
    "invariants": [
      "项目名称不能为空且长度不超过255字符",
      "激活项目ID必须存在或为空",
      "删除项目时级联删除环境配置（通过服务间调用）"
    ],
    "constraints": [
      "项目ID格式为UUID4",
      "全局只有一个激活项目"
    ],
    "validation_rules": [
      "名称去除首尾空格后不为空",
      "搜索关键词支持项目名称和描述的模糊匹配"
    ]
  },
  "error_handling": {
    "strategy": "使用FastAPI的异常处理中间件，所有未捕获异常返回500，业务异常返回对应HTTP状态码和JSON消息，确保不泄露系统敏感信息。",
    "error_mapping": {
      "400": "请求参数校验失败",
      "404": "项目不存在",
      "500": "服务器内部错误"
    },
    "logging_policy": "所有错误记录至日志文件，包含请求ID、时间戳和错误堆栈（仅调试模式）"
  }
}