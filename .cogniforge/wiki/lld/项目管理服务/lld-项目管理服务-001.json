    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001",
      "DM-002"
    ]
  },
  "overview": {
    "description": "项目管理服务负责项目实体的生命周期管理，以及项目与环境的多对多绑定关系维护。通过 FastAPI 暴露 RESTful 接口，直接访问 PostgreSQL 数据库。",
    "dependencies": [
      "环境管理服务（验证环境 ID 是否存在）"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "PostgreSQL 15"
    ]
  },
