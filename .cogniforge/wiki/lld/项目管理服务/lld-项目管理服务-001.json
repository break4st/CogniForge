  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ProjectService",
      "description": "项目管理服务对外契约",
      "preconditions": [
        "数据库连接正常"
      ],
      "postconditions": [
        "所有操作完成后数据库状态一致"
      ],
      "methods": [
        {
          "name": "create_project",
          "signature": "create_project(request: ProjectCreate) -> Project",
          "description": "创建新项目",
          "precondition": "项目名称在系统中不存在",
          "postcondition": "系统中新增一个激活状态的项目",
          "parameters": [
            {
              "name": "request",
              "type": "ProjectCreate"
            }
          ],
          "return_type": "Project",
          "exceptions": [
            "DuplicateProjectNameException",
            "ValidationException"
          ]
        },
        {
          "name": "list_projects",
          "signature": "list_projects(filters: Optional[ProjectFilter] = None, pagination: Pagination) -> PaginatedResult[Project]",
          "description": "分页列出所有项目",
          "precondition": "无",
          "postcondition": "返回符合筛选条件的分页项目列表",
          "parameters": [
            {
              "name": "filters",
              "type": "Optional[ProjectFilter]"
            },
            {
              "name": "pagination",
              "type": "Pagination"
            }
          ],
          "return_type": "PaginatedResult[Project]",
          "exceptions": []
        },
        {
          "name": "get_project",
          "signature": "get_project(project_id: int) -> Optional[Project]",
          "description": "根据ID获取项目",
          "precondition": "项目ID存在",
          "postcondition": "返回项目对象或None",
          "parameters": [
            {
              "name": "project_id",
              "type": "int"
            }
          ],
          "return_type": "Optional[Project]",
          "exceptions": []
        },
        {
          "name": "update_project",
          "signature": "update_project(project_id: int, request: ProjectUpdate) -> Project",
          "description": "更新项目信息",
          "precondition": "项目存在且新名称不与其他项目冲突",
          "postcondition": "项目信息更新",
          "parameters": [
            {
              "name": "project_id",
              "type": "int"
            },
            {
              "name": "request",
              "type": "ProjectUpdate"
            }
          ],
          "return_type": "Project",
          "exceptions": [
            "ProjectNotFoundException",
            "DuplicateProjectNameException",
            "ValidationException"
          ]
        },
        {
          "name": "archive_project",
          "signature": "archive_project(project_id: int) -> None",
