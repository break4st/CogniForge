  "business_rules": [
    {
      "rule_id": "BR-001",
      "description": "项目名称全局唯一",
      "type": "invariant",
      "conditions": "在创建项目时检查名称是否已存在",
      "actions": "若重复则返回 400 错误",
      "source_requirements": [
        "REQ-003"
      ]
    },
    {
      "rule_id": "BR-002",
      "description": "项目名称不能为空且长度不超过255",
      "type": "invariant",
      "conditions": "创建项目时校验",
      "actions": "不符合则返回 400 错误",
      "source_requirements": [
        "REQ-003"
      ]
    },
    {
      "rule_id": "BR-003",
      "description": "删除项目时级联删除其所有环境绑定",
      "type": "invariant",
      "conditions": "执行删除项目操作",
      "actions": "在事务中先删除 project_environments 中相关记录，再删除项目",
      "source_requirements": [
        "REQ-003"
      ]
    },
    {
      "rule_id": "BR-004",
      "description": "绑定环境前验证环境存在",
      "type": "invariant",
      "conditions": "action='bind' 且目标关系不存在",
      "actions": "调用环境管理服务验证环境 ID，若不存在则返回 404",
      "source_requirements": [
        "REQ-007"
      ]
    },
    {
      "rule_id": "BR-005",
      "description": "解绑环境前验证关系存在",
      "type": "invariant",
      "conditions": "action='unbind'",
      "actions": "检查 project_environments 表中是否存在对应记录，若不存在则返回 404",
      "source_requirements": [
        "REQ-007"
      ]
    },
    {
      "rule_id": "BR-006",
      "description": "不允许重复绑定同一环境",
      "type": "invariant",
      "conditions": "action='bind' 且目标关系已存在",
      "actions": "返回 409 冲突错误",
      "source_requirements": [
        "REQ-007"
      ]
    }
