  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ProjectService",
      "type": "internal",
      "description": "项目管理服务核心业务逻辑接口",
      "dependencies": [],
      "methods": [
        {
          "name": "create_project",
          "description": "创建新项目",
          "parameters": [
            {
              "name": "data",
              "type": "ProjectCreate",
              "required": true,
              "description": "项目数据"
            }
          ],
          "return_type": "ProjectResponse",
          "exceptions": [
            "ProjectNameDuplicateError",
            "ValidationError"
          ],
          "source_contracts": [
            "CTR-006"
          ],
          "preconditions": [
            "name 非空且在全局唯一"
          ],
          "postconditions": [
            "数据库中存在新项目记录",
            "返回完整项目信息"
          ]
        },
        {
          "name": "list_projects",
          "description": "分页查询项目列表，支持名称模糊搜索",
          "parameters": [
            {
              "name": "page",
              "type": "int",
              "required": true,
              "description": "页码"
            },
            {
              "name": "size",
              "type": "int",
              "required": true,
              "description": "每页大小"
            },
            {
              "name": "search",
              "type": "str | None",
              "required": false,
              "description": "名称搜索关键词"
            }
          ],
          "return_type": "ProjectListResponse",
          "exceptions": [
            "ValidationError"
          ],
          "source_contracts": [
            "CTR-007"
          ],
          "preconditions": [],
          "postconditions": [
            "返回符合条件的分页项目列表"
          ]
        },
        {
          "name": "delete_project",
          "description": "删除指定项目及其所有环境绑定",
          "parameters": [
            {
              "name": "project_id",
              "type": "int",
              "required": true,
              "description": "项目 ID"
            }
          ],
          "return_type": "DeleteProjectResponse",
          "exceptions": [
            "ProjectNotFoundError"
          ],
          "source_contracts": [
            "CTR-008"
          ],
          "preconditions": [
            "project_id 对应的项目必须存在"
          ],
          "postconditions": [
            "项目及其所有环境绑定已被删除",
            "数据库不再包含该项目相关记录"
          ]
        },
        {
          "name": "toggle_environment_binding",
          "description": "根据 action 绑定或解绑环境（toggle 模式）",
          "parameters": [
            {
              "name": "project_id",
              "type": "int",
              "required": true,
              "description": "项目 ID"
            },
            {
              "name": "data",
              "type": "EnvironmentBindRequest",
              "required": true,
              "description": "绑定/解绑请求数据"
            }
          ],
          "return_type": "EnvironmentBindResponse",
          "exceptions": [
            "ProjectNotFoundError",
            "EnvironmentNotFoundError",
            "EnvironmentBindingConflictError",
            "EnvironmentBindingNotFoundError",
            "ValidationError"
          ],
          "source_contracts": [
            "CTR-009"
          ],
          "preconditions": [
            "project_id 对应的项目存在",
            "environment_id 对应的环境存在"
          ],
          "postconditions": [
            "若 action='bind'，则 project_environments 中存在相应记录；若 action='unbind'，则相应记录被删除"
          ]
        }
      ]
    }
  ],
  "workflow": {
    "project_lifecycle": {
      "steps": [
        "1. 接收创建请求",
        "2. 校验项目名唯一性",
        "3. 写入数据库",
        "4. 返回创建结果"
      ],
      "states": [
        "active",
        "deleted"
      ],
      "transitions": [
        {
          "from": "active",
          "to": "deleted",
          "trigger": "delete_project",
          "actions": [
            "级联删除绑定关系",
            "删除项目记录"
          ]
        }
      ]
    },
    "bind_toggle": {
      "description": "环境绑定/解绑通过同一接口，根据 action 字段决定操作。若绑定已存在则忽略或报错（根据业务决定），解绑时若关系不存在则报错。",
      "steps": [
        "1. 验证项目和环境存在",
        "2. 根据 action 执行插入或删除",
        "3. 返回操作结果"
      ]
    },
    "project_deletion": {
      "description": "删除项目时，先删除所有相关的 project_environments 记录，再删除项目本身。在一个事务内完成，保证原子性。"
    }
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "创建项目",
      "endpoint": "POST /api/projects",
      "method": "POST",
      "description": "创建一个新的项目",
      "path": "/api/projects",
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "项目名称"
            },
            "description": {
              "type": "string",
              "description": "项目描述（可选）"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "response": {
        "body": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string",
              "nullable": true
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          }
        }
      },
      "errors": [
        {
          "status": 400,
          "description": "请求参数校验失败或项目名重复"
        }
      ],
      "source_contracts": [
        "CTR-006"
      ]
    },
    {
      "id": "IF-002",
      "name": "查询项目列表",
      "endpoint": "GET /api/projects",
      "method": "GET",
      "description": "分页查询项目列表，支持名称模糊搜索",
      "path": "/api/projects",
      "request": {
        "query": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "default": 1
            },
            "size": {
              "type": "integer",
              "default": 20
            },
            "search": {
              "type": "string",
              "description": "名称搜索关键词"
            }
          }
        }
      },
      "response": {
        "body": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updated_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  }
                }
              }
            },
            "total": {
              "type": "integer"
            },
            "page": {
              "type": "integer"
            },
            "size": {
              "type": "integer"
            }
          }
        }
      },
      "errors": [],
      "source_contracts": [
        "CTR-007"
      ]
    },
    {
      "id": "IF-003",
      "name": "删除项目",
      "endpoint": "DELETE /api/projects/{project_id}",
      "method": "DELETE",
      "description": "删除指定项目及其所有环境绑定",
      "path": "/api/projects/{project_id}",
      "request": {
        "path": {
          "type": "object",
          "properties": {
