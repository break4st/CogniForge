    "module_type": "service",
    "module": "项目管理服务",
    "title": "项目管理服务 详细设计文档",
    "author": "design_agent",
    "created": "2025-03-27T10:00:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-001"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": [
        "CMP-003"
      ],
      "contracts": [
        "CTR-001",
        "CTR-002",
        "CTR-003",
        "CTR-004",
        "CTR-005"
      ],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "项目 CRUD 操作（创建、查询列表、查询详情、更新、删除）",
      "项目名称唯一性校验",
      "维护当前活跃项目上下文（设置/获取活跃项目 ID）"
    ],
    "out_of_scope": [
      "数据库表结构的实际定义与迁移",
      "前端界面的交互逻辑",
      "部署执行、环境管理等业务",
      "用户认证与授权"
    ],
    "owned_components": [
      "CMP-003"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "项目管理服务负责项目实体的完整生命周期管理，包括创建、编辑、删除、查询，以及维护当前活跃项目的上下文信息。对外提供 RESTful API，内部通过数据访问层与 SQLite 交互。",
    "dependencies": [
      "数据访问层"
    ],
    "tech_stack": [
      "TypeScript",
      "Node.js",
      "Express",
      "SQLite 3",
      "winston"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-003"
      ],
      "sad_contract_ids": [
        "CTR-001",
        "CTR-002",
        "CTR-003",
        "CTR-004",
        "CTR-005"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002"
        ],
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003",
          "IF-004",
          "IF-005",
          "IF-006",
          "IF-007"
        ],
        "domain_objects": [
          "DO-001",
          "DO-002",
          "DO-003",
          "DO-004",
          "DO-005"
        ],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": "新增内部接口 IF-006, IF-007 用于活跃项目上下文管理"
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "object_type": "entity",
      "name": "Project",
      "description": "项目实体对象，映射数据库 projects 表",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "description": "项目唯一标识"
        },
        {
          "name": "name",
          "type": "string",
          "description": "项目名称，全局唯一"
        },
        {
          "name": "build_directory",
          "type": "string",
          "description": "构建产物输出目录"
        },
        {
          "name": "description",
          "type": "string",
          "description": "项目描述"
        },
        {
          "name": "template_id",
          "type": "string",
          "description": "关联的模板 ID"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "description": "最后更新时间"
        }
      ]
    },
    {
      "id": "DO-002",
      "object_type": "dto",
      "name": "CreateProjectDTO",
      "description": "创建项目数据传输对象",
      "attributes": [
        {
          "name": "name",
          "type": "string",
          "description": "项目名称（必填，全局唯一）"
        },
        {
          "name": "build_directory",
          "type": "string",
          "description": "构建目录（可选）"
        },
        {
          "name": "description",
          "type": "string",
          "description": "项目描述（可选）"
        },
        {
          "name": "template_id",
          "type": "string",
          "description": "模板 ID（可选）"
        }
      ]
    },
    {
      "id": "DO-003",
      "object_type": "dto",
      "name": "UpdateProjectDTO",
      "description": "更新项目数据传输对象",
      "attributes": [
        {
          "name": "name",
          "type": "string",
          "description": "项目名称（必填，全局唯一）"
        },
        {
          "name": "build_directory",
          "type": "string",
          "description": "构建目录（可选）"
        },
        {
          "name": "description",
          "type": "string",
          "description": "项目描述（可选）"
        },
        {
          "name": "template_id",
          "type": "string",
          "description": "模板 ID（可选）"
        }
      ]
    },
    {
      "id": "DO-004",
      "object_type": "dto",
      "name": "ProjectSummaryDTO",
      "description": "项目摘要数据传输对象，用于列表展示",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "description": "项目 ID"
        },
        {
          "name": "name",
          "type": "string",
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "string",
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "description": "创建时间"
        }
      ]
    },
    {
      "id": "DO-005",
      "object_type": "dto",
      "name": "ActiveProject",
      "description": "活跃项目上下文对象，存储当前选中的项目 ID",
      "attributes": [
        {
          "name": "projectId",
          "type": "string",
          "description": "当前活跃的项目标识"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "创建项目",
      "description": "创建一个新项目，校验名称唯一性",
      "method": "POST",
      "path": "/api/projects",
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "$ref": "#/domain_objects/DO-002"
        },
        "required": true
      },
      "responses": {
        "201": {
          "description": "创建成功",
          "body": {
            "content_type": "application/json",
            "schema": {
              "$ref": "#/domain_objects/DO-001"
            }
          }
        }
      }
    },
    {
      "id": "IF-002",
      "name": "查询项目列表",
      "description": "获取所有项目的摘要列表",
      "method": "GET",
      "path": "/api/projects",
      "request_body": null,
      "responses": {
        "200": {
          "description": "成功返回项目摘要列表",
          "body": {
            "content_type": "application/json",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/domain_objects/DO-004"
              }
            }
          }
        }
      }
    },
    {
      "id": "IF-003",
      "name": "查询项目详情",
      "description": "根据 ID 查询单个项目详情",
      "method": "GET",
      "path": "/api/projects/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "项目 ID"
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "成功返回项目详情",
          "body": {
            "content_type": "application/json",
            "schema": {
              "$ref": "#/domain_objects/DO-001"
            }
          }
        }
      }
    },
    {
      "id": "IF-004",
      "name": "更新项目",
      "description": "更新指定项目的信息，需校验名称唯一性",
      "method": "PUT",
      "path": "/api/projects/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "项目 ID"
        }
      ],
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "$ref": "#/domain_objects/DO-003"
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "更新成功",
          "body": {
            "content_type": "application/json",
            "schema": {
              "$ref": "#/domain_objects/DO-001"
            }
          }
        }
      }
    },
    {
      "id": "IF-005",
      "name": "删除项目",
      "description": "删除指定项目",
      "method": "DELETE",
      "path": "/api/projects/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "项目 ID"
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "删除成功",
          "body": {
            "content_type": "application/json",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "IF-006",
      "name": "设置活跃项目",
      "description": "设置当前活跃的项目上下文",
      "method": "POST",
      "path": "/api/context/active-project",
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "$ref": "#/domain_objects/DO-005"
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "设置成功",
          "body": {
            "content_type": "application/json",
            "schema": {
              "$ref": "#/domain_objects/DO-005"
            }
          }
        }
      }
    },
    {
      "id": "IF-007",
      "name": "获取活跃项目",
      "description": "获取当前活跃项目上下文",
      "method": "GET",
      "path": "/api/context/active-project",
      "request_body": null,
      "responses": {
        "200": {
          "description": "成功返回活跃项目信息",
          "body": {
            "content_type": "application/json",
            "schema": {
              "$ref": "#/domain_objects/DO-005"
            }
          }
        }
      }
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ProjectService",
      "description": "项目服务接口，定义项目管理相关操作契约",
      "methods": [
        {
          "name": "createProject",
          "description": "创建项目",
          "signature": "createProject(dto: CreateProjectDTO): Promise<Project>",
          "precondition": "项目名称全局唯一，所有必填字段满足约束",
          "postcondition": "数据库新增一条项目记录，返回完整项目对象"
        },
        {
          "name": "listProjects",
          "description": "查询项目列表",
          "signature": "listProjects(): Promise<ProjectSummaryDTO[]>",
          "precondition": "无",
          "postcondition": "返回所有项目的摘要列表"
        },
        {
          "name": "getProject",
          "description": "查询项目详情",
          "signature": "getProject(id: string): Promise<Project>",
          "precondition": "提供的 ID 对应的项目存在",
          "postcondition": "返回完整的项目对象"
        },
        {
          "name": "updateProject",
          "description": "更新项目",
          "signature": "updateProject(id: string, dto: UpdateProjectDTO): Promise<Project>",
          "precondition": "提供的 ID 对应的项目存在，且更新后的名称全局唯一",
          "postcondition": "更新数据库中对应项目记录，返回更新后的完整项目对象"
        },
        {
          "name": "deleteProject",
          "description": "删除项目",
          "signature": "deleteProject(id: string): Promise<void>",
          "precondition": "提供的 ID 对应的项目存在",
          "postcondition": "从数据库中删除对应项目记录"
        },
        {
          "name": "setActiveProject",
          "description": "设置活跃项目",
          "signature": "setActiveProject(projectId: string): Promise<ActiveProject>",
          "precondition": "提供的 projectId 对应的项目存在",
          "postcondition": "活跃项目上下文被更新为指定项目 ID"
        },
        {
          "name": "getActiveProject",
          "description": "获取活跃项目",
          "signature": "getActiveProject(): Promise<ActiveProject>",
          "precondition": "无",
          "postcondition": "返回当前活跃项目上下文，如果未设置则返回空或默认值"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "项目名称全局唯一",
      "type": "invariant",
      "expression": "在创建或更新项目时，项目名称不能与已存在的项目名称重复（不区分大小写）"
    },
    {
      "id": "BR-002",
      "description": "项目名称必填",
      "type": "constraint",
      "expression": "项目名称字段不能为空"
    },
    {
      "id": "BR-003",
      "description": "删除项目前的关联检查",
      "type": "precondition",
      "expression": "删除项目时，需确保没有活跃的构建或部署关联到该项目（当前版本暂不考虑，但预留扩展）"
    }
  ],
  "error_handling": {
    "strategy": "统一错误处理中间件捕获异常，将错误映射为适当的 HTTP 状态码和错误响应体。错误响应体包含错误码、错误信息。",
    "errors": {
      "NotFoundError": {
        "http_status": 404,
        "message": "请求的资源不存在"
      },
      "ConflictError": {
        "http_status": 409,
        "message": "资源冲突，如项目名称重复"
      },
      "ValidationError": {
        "http_status": 400,
        "message": "输入数据验证失败"
      },
      "InternalError": {
        "http_status": 500,
        "message": "服务器内部错误"
      }
    }
  }
}