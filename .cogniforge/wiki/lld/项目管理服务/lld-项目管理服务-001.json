  "data_models": [
    {
      "id": "DM-001",
      "name": "projects",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "projects"
      },
      "description": "项目主表，存储项目基本信息",
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键，自动生成"
        },
        {
          "name": "name",
          "type": "String(255)",
          "required": true,
          "description": "项目名称，全局唯一"
        },
        {
          "name": "description",
          "type": "String(1000)",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间，自动记录"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": false,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_projects_name",
          "unique": true,
          "columns": [
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-006",
        "CTR-007",
        "CTR-008"
      ],
      "constraints": [
        "名称不允许为空",
        "长度不超过255",
        "全局唯一"
      ],
      "lifecycle": {
        "create": "POST /api/projects",
        "update": "无（暂不提供更新接口）",
        "delete": "DELETE /api/projects/{id}，物理删除并级联删除绑定记录",
        "retention": "删除后数据不再保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "project_environments",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "project_environments"
      },
      "description": "项目与环境的多对多绑定关系表",
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键，自动生成"
        },
        {
          "name": "project_id",
          "type": "Integer",
          "required": true,
          "description": "外键 -> projects.id"
        },
        {
          "name": "environment_id",
          "type": "Integer",
          "required": true,
          "description": "外键 -> environments.id"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "绑定创建时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_project_env",
          "unique": true,
          "columns": [
            "project_id",
            "environment_id"
          ]
        }
      ],
      "source_requirements": [
        "REQ-003",
        "REQ-007"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-009"
      ],
      "constraints": [
        "project_id 和 environment_id 的组合唯一",
        "外键约束：project_id 引用 projects(id)，environment_id 引用 environments(id)",
        "级联删除：删除项目时，相关记录自动删除"
      ],
      "lifecycle": {
        "create": "POST /api/projects/{id}/environments (绑定) 或 DELETE (解绑)",
        "update": "无更新操作，仅插入或删除",
        "delete": "DELETE /api/projects/{id}/environments/{env_id} 或跟随项目删除",
        "retention": "删除后即移除绑定"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
