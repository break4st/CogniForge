  "overview": {
    "description": "持久化存储所有业务数据，涵盖项目信息、部署环境配置、加密SSH密钥、部署版本历史、审计日志及用户权限信息。作为系统的核心数据层，为项目管理服务、环境管理服务、部署编排服务、密钥管理服务、版本管理服务、审计日志服务及认证中间件提供统一、可靠、高性能的数据存取能力。",
    "dependencies": [],
    "tech_stack": ["PostgreSQL 15+"]
  },
  "data_models": [
    {
      "name": "users",
      "type": "table",
      "ownership": "canonical",
      "description": "系统用户账号信息，用于身份认证和权限管理",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "用户标识，主键"},
        {"name": "username", "type": "VARCHAR(64)", "required": true, "description": "用户名，唯一标识"},
        {"name": "password_hash", "type": "VARCHAR(256)", "required": true, "description": "密码bcrypt哈希值"},
        {"name": "display_name", "type": "VARCHAR(128)", "required": false, "description": "用户显示名称"},
        {"name": "role", "type": "VARCHAR(32)", "required": true, "description": "角色：admin/manager/operator/developer/tester"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "状态：active/disabled"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录更新时间"}
      ],
      "indexes": [
        {"name": "idx_users_username", "unique": true, "columns": ["username"]},
        {"name": "idx_users_role", "unique": false, "columns": ["role"]},
        {"name": "idx_users_status", "unique": false, "columns": ["status"]}
      ]
    },
    {
      "name": "projects",
      "type": "table",
      "ownership": "canonical",
      "description": "项目定义信息，每个项目包含独立的部署环境和配置",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "项目标识，主键"},
        {"name": "name", "type": "VARCHAR(256)", "required": true, "description": "项目名称"},
        {"name": "description", "type": "TEXT", "required": false, "description": "项目描述"},
        {"name": "created_by", "type": "UUID", "required": true, "description": "创建者用户ID，外键关联users"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "状态：active/archived"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录更新时间"}
      ],
      "indexes": [
        {"name": "idx_projects_name", "unique": false, "columns": ["name"]},
        {"name": "idx_projects_created_by", "unique": false, "columns": ["created_by"]}
      ]
    },
    {
      "name": "project_members",
      "type": "table",
      "ownership": "canonical",
      "description": "项目成员关联表，记录用户与项目的多对多关系及角色权限",
      "fields": [
        {"name": "project_id", "type": "UUID", "required": true, "description": "项目标识，复合主键，外键关联projects"},
        {"name": "user_id", "type": "UUID", "required": true, "description": "用户标识，复合主键，外键关联users"},
        {"name": "role", "type": "VARCHAR(32)", "required": true, "description": "成员角色：admin/maintainer/developer/viewer"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "idx_project_members_user_id", "unique": false, "columns": ["user_id"]}
      ]
    },
    {
      "name": "ssh_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "加密存储的SSH密钥信息，密钥内容使用AES-256加密后保存",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "密钥标识，主键"},
        {"name": "name", "type": "VARCHAR(256)", "required": true, "description": "密钥名称"},
        {"name": "encrypted_content", "type": "TEXT", "required": true, "description": "AES-256加密后的密钥内容（Base64编码）"},
        {"name": "key_type", "type": "VARCHAR(16)", "required": true, "description": "密钥类型：rsa/ecdsa/ed25519"},
        {"name": "fingerprint", "type": "VARCHAR(128)", "required": true, "description": "密钥指纹（SHA256摘要）"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录更新时间"}
      ],
      "indexes": [
        {"name": "idx_ssh_keys_fingerprint", "unique": true, "columns": ["fingerprint"]}
      ]
    },
    {
      "name": "environments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署环境配置信息，关联项目和SSH密钥，定义目标服务器的连接参数",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "环境标识，主键"},
        {"name": "project_id", "type": "UUID", "required": true, "description": "所属项目ID，外键关联projects"},
        {"name": "name", "type": "VARCHAR(64)", "required": true, "description": "环境名称，如「测试线」「灰度线」「正式线」"},
        {"name": "host", "type": "VARCHAR(256)", "required": true, "description": "目标服务器地址（IP或域名）"},
        {"name": "port", "type": "INTEGER", "required": true, "description": "SSH端口号，默认22"},
        {"name": "key_id", "type": "UUID", "required": false, "description": "绑定的SSH密钥ID，外键关联ssh_keys"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "连接健康状态：online/offline/unknown"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录更新时间"}
      ],
      "indexes": [
        {"name": "idx_environments_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "idx_environments_key_id", "unique": false, "columns": ["key_id"]}
      ]
    },
    {
      "name": "deployment_tasks",
      "type": "table",
      "ownership": "canonical",
      "description": "部署任务记录，跟踪每次部署或回滚操作的执行状态和进度",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "任务标识，主键"},
        {"name": "project_id", "type": "UUID", "required": true, "description": "所属项目ID，外键关联projects"},
        {"name": "environment_id", "type": "UUID", "required": true, "description": "目标环境ID，外键关联environments"},
        {"name": "type", "type": "VARCHAR(16)", "required": true, "description": "任务类型：deploy/rollback"},
        {"name": "file_path", "type": "VARCHAR(1024)", "required": false, "description": "部署文件路径或文件标识"},
        {"name": "version", "type": "VARCHAR(64)", "required": false, "description": "部署版本号"},
        {"name": "description", "type": "TEXT", "required": false, "description": "任务描述或备注"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "任务状态：pending/running/success/failed/rolled_back"},
        {"name": "progress", "type": "INTEGER", "required": true, "description": "进度百分比0-100"},
        {"name": "current_step", "type": "VARCHAR(256)", "required": false, "description": "当前执行步骤描述"},
        {"name": "error_message", "type": "TEXT", "required": false, "description": "错误信息（任务失败时填写）"},
        {"name": "started_by", "type": "UUID", "required": true, "description": "发起人用户ID，外键关联users"},
        {"name": "started_at", "type": "TIMESTAMPTZ", "required": false, "description": "任务开始执行时间"},
        {"name": "completed_at", "type": "TIMESTAMPTZ", "required": false, "description": "任务完成时间"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "idx_deployment_tasks_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "idx_deployment_tasks_environment_id", "unique": false, "columns": ["environment_id"]},
        {"name": "idx_deployment_tasks_status", "unique": false, "columns": ["status"]},
        {"name": "idx_deployment_tasks_started_by", "unique": false, "columns": ["started_by"]},
        {"name": "idx_deployment_tasks_created_at", "unique": false, "columns": ["created_at"]}
      ]
    },
    {
      "name": "deployment_task_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "部署任务执行日志行，通过WebSocket实时推送到前端看板",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "日志行标识，自增主键"},
        {"name": "task_id", "type": "UUID", "required": true, "description": "所属任务ID，外键关联deployment_tasks"},
        {"name": "sequence", "type": "INTEGER", "required": true, "description": "日志行序号，用于保持顺序"},
        {"name": "message", "type": "TEXT", "required": true, "description": "日志消息内容"},
        {"name": "level", "type": "VARCHAR(8)", "required": true, "description": "日志级别：info/warn/error"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "idx_task_logs_task_sequence", "unique": false, "columns": ["task_id", "sequence"]},
        {"name": "idx_task_logs_created_at", "unique": false, "columns": ["created_at"]}
      ]
    },
    {
      "name": "deployment_versions",
      "type": "table",
      "ownership": "canonical",
      "description": "部署版本历史记录，追踪每次成功部署的版本信息和远程目录位置",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "版本记录标识，主键"},
        {"name": "project_id", "type": "UUID", "required": true, "description": "所属项目ID，外键关联projects"},
        {"name": "environment_id", "type": "UUID", "required": true, "description": "目标环境ID，外键关联environments"},
        {"name": "task_id", "type": "UUID", "required": true, "description": "关联部署任务ID，外键关联deployment_tasks"},
        {"name": "version", "type": "VARCHAR(64)", "required": true, "description": "版本号（自动生成或用户指定）"},
        {"name": "deploy_path", "type": "VARCHAR(1024)", "required": true, "description": "远程服务器上的部署目录路径"},
        {"name": "file_path", "type": "VARCHAR(1024)", "required": false, "description": "部署使用的文件路径，用于回滚时重新传输"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "版本状态：active/inactive/rolled_back"},
        {"name": "deployed_by", "type": "UUID", "required": true, "description": "部署人用户ID，外键关联users"},
        {"name": "description", "type": "TEXT", "required": false, "description": "部署说明"},
        {"name": "deployed_at", "type": "TIMESTAMPTZ", "required": true, "description": "部署完成时间"},
        {"name": "rolled_back_at", "type": "TIMESTAMPTZ", "required": false, "description": "回滚时间"},
        {"name": "rolled_back_to", "type": "UUID", "required": false, "description": "回滚目标版本ID，自关联deployment_versions"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "idx_versions_project_env", "unique": false, "columns": ["project_id", "environment_id"]},
        {"name": "idx_versions_version", "unique": false, "columns": ["version"]},
        {"name": "idx_versions_task_id", "unique": true, "columns": ["task_id"]},
        {"name": "idx_versions_status", "unique": false, "columns": ["status"]},
        {"name": "idx_versions_deployed_at", "unique": false, "columns": ["deployed_at"]}
      ]
    },
    {
      "name": "audit_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "审计日志记录，捕获所有操作行为以满足可审核性要求，按月份分区存储",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "日志标识，主键"},
        {"name": "timestamp", "type": "TIMESTAMPTZ", "required": true, "description": "操作发生时间"},
        {"name": "operator", "type": "VARCHAR(64)", "required": true, "description": "操作人用户名"},
        {"name": "operator_id", "type": "UUID", "required": false, "description": "操作人用户ID，外键关联users"},
        {"name": "action", "type": "VARCHAR(256)", "required": true, "description": "操作描述，如「一键部署」「创建项目」「回滚版本」"},
        {"name": "action_type", "type": "VARCHAR(64)", "required": true, "description": "操作类型分类：deploy/project/environment/key/rollback/auth"},
        {"name": "target", "type": "VARCHAR(256)", "required": true, "description": "操作对象标识，如项目名/环境名/版本号"},
        {"name": "target_type", "type": "VARCHAR(64)", "required": true, "description": "操作对象类型：project/environment/key/version/task"},
        {"name": "result", "type": "VARCHAR(16)", "required": true, "description": "操作结果：success/failure"},
        {"name": "detail", "type": "TEXT", "required": false, "description": "操作详情JSON"},
        {"name": "ip_address", "type": "VARCHAR(45)", "required": true, "description": "来源IP地址（支持IPv6）"},
        {"name": "request_id", "type": "VARCHAR(64)", "required": false, "description": "请求追踪ID"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "idx_audit_logs_timestamp", "unique": false, "columns": ["timestamp"]},
        {"name": "idx_audit_logs_operator", "unique": false, "columns": ["operator"]},
        {"name": "idx_audit_logs_operator_id", "unique": false, "columns": ["operator_id"]},
        {"name": "idx_audit_logs_action_type", "unique": false, "columns": ["action_type"]},
        {"name": "idx_audit_logs_result", "unique": false, "columns": ["result"]}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "PostgreSQLConnection",
      "method": "INTERNAL",
      "endpoint": "postgresql://[host]:5432/cogniforge",
      "description": "PostgreSQL数据库连接接口。所有业务服务通过连接池建立TCP连接，使用SQL语句进行数据存取操作。连接参数由连接池管理，服务层不直接处理连接生命周期。",
      "parameters": [
        {"name": "host", "type": "string", "description": "数据库服务器地址，默认为localhost"},
        {"name": "port", "type": "integer", "description": "数据库端口，默认5432"},
        {"name": "dbname", "type": "string", "description": "数据库名称：cogniforge"},
        {"name": "sslmode", "type": "string", "description": "SSL连接模式：require/verify-full/disable"}
      ],
      "response": {
        "status": 200,
        "body": {
          "connection": "pgx.Conn（Go驱动连接句柄）",
          "max_pool_size": "integer（最大连接数）",
          "idle_connections": "integer（空闲连接数）"
        }
      },
      "error_codes": [
        {"code": "28P01", "message": "密码认证失败，用户名或密码错误"},
        {"code": "3D000", "message": "数据库不存在"},
        {"code": "08001", "message": "无法连接到服务器，请检查网络和地址配置"},
        {"code": "08006", "message": "数据库连接中断，正在重连"},
        {"code": "53300", "message": "连接数超限，已达到max_connections上限"}
      ]
    },
    {
      "name": "TransactionSupport",
      "method": "INTERNAL",
      "endpoint": "BEGIN/COMMIT/ROLLBACK",
      "description": "数据库事务接口，保证多个数据表操作之间的原子性和一致性。部署流程中的多步骤写入操作必须使用事务。",
      "parameters": [
        {"name": "isolation_level", "type": "string", "description": "隔离级别：Read Committed（默认）/ Repeatable Read / Serializable"},
        {"name": "timeout", "type": "integer", "description": "事务超时时间（秒），默认30s"}
      ],
      "response": {
        "status": 200,
        "body": {
          "transaction_id": "string（内部事务句柄）",
          "status": "string（committed/rolled_back）"
        }
      },
      "error_codes": [
        {"code": "40001", "message": "序列化冲突，事务无法提交，需重试"},
        {"code": "40P01", "message": "检测到死锁，事务被终止，需重试"},
        {"code": "25P02", "message": "当前事务已中止，命令被忽略直到事务块结束"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "所有数据库操作统一使用连接池管理，上层业务服务层捕获数据库驱动返回的错误码（SQLSTATE），按分类转换为业务错误响应。连接中断时启用自动重试机制（最多3次，指数退避），数据完整性冲突时向上返回精确的错误描述以支持用户快速定位问题。",
    "response_format": {
      "body": {
        "code": "integer（HTTP状态码或自定义业务码）",
        "error": "string（错误分类标识）",
        "detail": "string（详细错误描述，包含SQLSTATE码）"
      }
    },
    "categories": [
      {
        "code": "08000-08007",
        "name": "连接异常",
        "description": "数据库连接失败、中断或拒绝。触发条件包括：网络故障、数据库服务重启、防火墙拦截、连接数超限。处理方式：连接池自动重试（指数退避），重试3次仍失败则返回503给前端。"
      },
      {
        "code": "23505",
        "name": "唯一约束冲突",
        "description": "INSERT或UPDATE违反UNIQUE约束。触发条件：创建同名项目、重复用户名、重复密钥指纹。处理方式：返回409 Conflict，detail字段注明冲突字段和已存在的值。"
      },
      {
        "code": "23503",
        "name": "外键约束冲突",
        "description": "INSERT或UPDATE违反FOREIGN KEY约束。触发条件：引用的项目/环境/密钥不存在时执行操作。处理方式：返回409 Conflict，指示被引用的记录不存在，引导用户检查关联数据。"
      },
      {
        "code": "40P01",
        "name": "死锁检测",
        "description": "并发事务发生死锁，PostgreSQL自动终止其中一个事务。处理方式：捕获后自动重试（最多2次），重试仍失败则返回500，提示用户稍后重试。"
      },
      {
        "code": "55P03",
        "name": "锁等待超时",
        "description": "语句在锁等待时间内未能获取锁。处理方式：返回503，引导用户减少并发操作或稍后重试。"
      },
      {
        "code": "57014",
        "name": "查询取消/超时",
        "description": "查询执行时间超过statement_timeout或锁等待超过lock_timeout。触发条件：审计日志大范围查询未加索引、复杂聚合查询。处理方式：优化查询计划，确保走索引，返回504并提示添加筛选条件。"
      }
    ]
  },
  "index_strategy": [
    {
      "table": "users",
      "indexes": [
        {"name": "idx_users_username", "columns": ["username"], "unique": true, "type": "B-tree", "purpose": "用户登录时按用户名精确查找，唯一索引防止用户名重复"},
        {"name": "idx_users_role", "columns": ["role"], "unique": false, "type": "B-tree", "purpose": "按角色筛选用户列表，用于管理员界面"},
        {"name": "idx_users_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "按状态过滤用户（active/disabled），支持账号管理场景"}
      ]
    },
    {
      "table": "projects",
      "indexes": [
        {"name": "idx_projects_name", "columns": ["name"], "unique": false, "type": "B-tree", "purpose": "项目列表按名称排序和模糊搜索"},
        {"name": "idx_projects_created_by", "columns": ["created_by"], "unique": false, "type": "B-tree", "purpose": "按创建者查询项目列表，用于用户个人项目视图"}
      ]
    },
    {
      "table": "project_members",
      "indexes": [
        {"name": "idx_project_members_user_id", "columns": ["user_id"], "unique": false, "type": "B-tree", "purpose": "按用户查询其加入的所有项目，支持项目切换功能"}
      ]
    },
    {
      "table": "ssh_keys",
      "indexes": [
        {"name": "idx_ssh_keys_fingerprint", "columns": ["fingerprint"], "unique": true, "type": "B-tree", "purpose": "按指纹精确查找密钥，唯一索引防止同一密钥重复录入"}
      ]
    },
    {
      "table": "environments",
      "indexes": [
        {"name": "idx_environments_project_id", "columns": ["project_id"], "unique": false, "type": "B-tree", "purpose": "查询指定项目的所有环境配置，环境配置界面核心查询"},
        {"name": "idx_environments_key_id", "columns": ["key_id"], "unique": false, "type": "B-tree", "purpose": "按绑定的密钥ID反向查询环境，用于密钥被删除时的级联检查"}
      ]
    },
    {
      "table": "deployment_tasks",
      "indexes": [
