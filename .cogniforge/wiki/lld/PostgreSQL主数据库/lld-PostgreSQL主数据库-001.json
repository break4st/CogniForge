        {"name": "idx_audit_logs_action_type", "columns": ["action_type"], "unique": false, "type": "B-tree", "purpose": "按操作类型分组统计和筛选（deploy/project/environment/key等）"},
        {"name": "idx_audit_logs_result", "columns": ["result"], "unique": false, "type": "B-tree", "purpose": "按操作结果过滤（success/failure），支持异常操作告警查询"}
      ]
    }
  ],
  "migration_strategy": {
    "tool": "golang-migrate/migrate",
    "naming": "{timestamp}_{描述}.up.sql / {timestamp}_{描述}.down.sql",
    "rollback": "每个迁移版本必须提供对应的 .down.sql 回滚脚本。回滚时使用 golang-migrate down 命令按版本逆序回退。正式环境的回滚操作必须经过审批流程，禁止直接在生产环境执行 down 回退。紧急回滚场景：先执行 down 脚本回退至上一版本，再通过部署系统的版本回滚功能恢复服务状态。"
  },
  "capacity_estimation": {
    "estimated_rows_1y": "约150万行。其中：audit_logs约100万行（日均2740条操作日志），deployment_task_logs约36.5万行（日均1000条部署日志行），deployment_tasks约3.65万行（日均100次部署），deployment_versions约3.65万行，其余配置类表（users/projects/environments/ssh_keys/project_members）合计约5000行。",
    "estimated_rows_3y": "约450万行。配置类表增长趋于平缓，日志类表（audit_logs + deployment_task_logs）随业务量线性增长，占总量的90%以上。考虑历史数据归档策略，核心审计日志保留3年，超过3年的按季度归档到离线存储。",
    "hot_tables": ["audit_logs", "deployment_versions", "deployment_tasks", "deployment_task_logs"],
    "partition_strategy": "audit_logs 表按月份范围分区（PARTITION BY RANGE (created_at)），每月一个独立分区。分区命名格式：audit_logs_2026_01、audit_logs_2026_02。过期分区通过 DETACH 后归档存储，不直接 DELETE 以防止 VACUUM 膨胀。其他表暂不分区，若 deployment_task_logs 单表超1000万行时参考 audit_logs 方案按月份分区。"
  },
