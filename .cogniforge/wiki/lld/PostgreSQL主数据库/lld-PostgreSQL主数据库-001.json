{
  "meta": {
    "doc_id": "lld-PostgreSQL主数据库-001",
    "type": "lld",
    "module_type": "database",
    "module": "PostgreSQL主数据库",
    "title": "PostgreSQL主数据库详细设计",
    "author": "design_agent",
