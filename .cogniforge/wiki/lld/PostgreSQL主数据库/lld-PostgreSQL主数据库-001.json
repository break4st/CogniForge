      ]
    },
    {
      "table": "deployment_task_logs",
      "indexes": [
        {"name": "idx_task_logs_task_sequence", "columns": ["task_id", "sequence"], "unique": false, "type": "B-tree", "purpose": "按任务ID查询有序日志行，支持WebSocket实时推送和断线重连时的日志补发"},
        {"name": "idx_task_logs_created_at", "columns": ["created_at"], "unique": false, "type": "B-tree", "purpose": "日志按时间清理时的范围删除条件，用于定期归档"}
      ]
    },
