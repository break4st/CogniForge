        {"name": "idx_versions_version", "columns": ["version"], "unique": false, "type": "B-tree", "purpose": "按版本号精确查找，用于回滚时的版本确认"},
        {"name": "idx_versions_task_id", "columns": ["task_id"], "unique": true, "type": "B-tree", "purpose": "版本记录与部署任务一对一关联，唯一索引保证引用完整性"},
        {"name": "idx_versions_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "按状态筛选版本（active/inactive/rolled_back），获取当前运行版本"},
        {"name": "idx_versions_deployed_at", "columns": ["deployed_at"], "unique": false, "type": "B-tree", "purpose": "按部署时间排序版本历史，支持时间范围查询"}
      ]
    },
