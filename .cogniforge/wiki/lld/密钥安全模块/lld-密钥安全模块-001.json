  "module_boundary": {
    "in_scope": [
      "生成新的 SSH 密钥对（RSA / Ed25519），返回私钥 PEM、公钥 PEM 及指纹",
      "使用 AES-256-GCM 对私钥进行加密，主密钥由调用方传入",
      "解密经 AES-256-GCM 加密的私钥，返回原始 PEM",
      "计算公钥的 SHA-256 指纹（OpenSSH 格式）"
    ],
    "out_of_scope": [
      "用户口令输入与验证",
      "私钥的持久化存储、删除或查询",
      "SSH 连接的建立与管理",
      "主密钥的生成与派生（仅接受已派生的密钥）"
    ],
    "owned_components": [
      "CMP-010"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "作为基础设施层模块，为上层服务提供密钥生成、AES-256-GCM 加解密及指纹计算能力。所有接口均为同步内部函数，不直接暴露 HTTP 端点。",
    "dependencies": [],
    "tech_stack": [
      "Python 3.11+",
      "cryptography (AES-GCM, key generation)"
    ]
  },
