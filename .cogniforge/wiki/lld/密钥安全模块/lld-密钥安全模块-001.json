      },
      "coverage": "full",
      "notes": "覆盖密钥安全模块所有核心功能"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "KeyGenerationResult",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "密钥对生成结果，包含私钥、公钥及其指纹",
      "fields": [
        {
          "name": "private_key_pem",
          "type": "string",
          "required": true,
          "description": "私钥 PEM 格式字符串"
        },
        {
          "name": "public_key_pem",
          "type": "string",
          "required": true,
          "description": "公钥 PEM 格式字符串"
        },
        {
          "name": "fingerprint",
          "type": "string",
          "required": true,
          "description": "公钥 SHA-256 指纹，格式为 SHA256:base64(hash)"
        },
        {
          "name": "key_type",
          "type": "string",
          "required": true,
          "description": "密钥类型，如 rsa 或 ed25519"
        },
        {
          "name": "bits",
          "type": "integer",
          "required": false,
          "description": "密钥长度（RSA 时使用，Ed25519 可省略）"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "由 generate_key_pair 接口创建",
        "update": "不可变对象",
        "delete": "随作用域自动释放",
        "retention": "仅内存存在"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "EncryptedKeyData",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "使用 AES-256-GCM 加密后的私钥数据，包含密文和认证信息",
      "fields": [
        {
          "name": "cipher_data",
          "type": "bytes",
          "required": true,
          "description": "加密后的私钥字节串"
        },
        {
          "name": "nonce",
          "type": "bytes",
          "required": true,
          "description": "12 字节随机数"
        },
        {
          "name": "tag",
          "type": "bytes",
          "required": true,
          "description": "16 字节认证标签"
        },
        {
          "name": "algorithm",
          "type": "string",
          "required": true,
          "description": "加密算法标识，固定为 AES-256-GCM"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
