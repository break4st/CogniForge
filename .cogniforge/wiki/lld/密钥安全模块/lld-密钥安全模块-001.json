      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "MasterKeyConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "主密钥派生参数配置，用于从用户口令生成加密密钥",
      "fields": [
        {
          "name": "derivation_method",
          "type": "string",
          "required": true,
          "description": "派生方法：pbkdf2 或 os_keychain"
        },
        {
          "name": "salt",
          "type": "bytes",
          "required": false,
          "description": "PBKDF2 所需的盐值（16 字节）"
        },
        {
          "name": "iterations",
          "type": "integer",
          "required": false,
          "description": "PBKDF2 迭代次数，推荐 ≥ 600,000"
        },
        {
          "name": "hash_algorithm",
          "type": "string",
          "required": false,
          "description": "哈希算法，固定为 sha256"
        }
      ],
