  "interfaces": [
    {
      "id": "IF-001",
      "name": "generate_key_pair",
      "type": "internal",
      "method": "FUNCTION",
      "endpoint": "internal",
      "description": "生成新的 SSH 密钥对，支持 RSA 和 Ed25519 算法",
      "request": {
        "parameters": [
          {
            "name": "key_type",
            "type": "string",
            "required": true,
            "description": "密钥类型：rsa 或 ed25519"
          },
          {
            "name": "bits",
            "type": "integer",
            "required": false,
            "description": "密钥长度（RSA 时使用，默认 4096）"
          }
        ]
      },
      "response": {
        "status_code": 200,
        "body": {
          "type": "KeyGenerationResult",
          "description": "生成的密钥对和指纹信息"
        }
      },
      "error_handling": {
        "strategy": "fail_fast",
        "errors": [
          {
            "code": "INVALID_KEY_TYPE",
            "message": "不支持的密钥类型",
            "trigger": "key_type 不是 rsa 或 ed25519"
          },
          {
            "code": "GENERATION_FAILED",
            "message": "密钥生成失败",
            "trigger": "底层加密库操作失败"
          }
        ],
        "retry": false
      },
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": []
    },
    {
      "id": "IF-002",
      "name": "encrypt_private_key",
      "type": "internal",
      "method": "FUNCTION",
      "endpoint": "internal",
      "description": "使用 AES-256-GCM 加密私钥 PEM 字符串",
      "request": {
        "parameters": [
          {
            "name": "private_key_pem",
            "type": "string",
            "required": true,
            "description": "待加密的私钥 PEM"
          },
          {
            "name": "master_key",
            "type": "bytes",
            "required": true,
            "description": "256 位 AES 密钥"
          }
        ]
      },
      "response": {
        "status_code": 200,
        "body": {
          "type": "EncryptedKeyData",
          "description": "加密后的数据，包含 cipher_data、nonce、tag 和 algorithm"
        }
      },
      "error_handling": {
        "strategy": "fail_fast",
        "errors": [
          {
            "code": "ENCRYPTION_FAILED",
            "message": "加密操作失败",
            "trigger": "加密过程中异常"
          }
        ],
        "retry": false
      },
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": []
    },
    {
      "id": "IF-003",
      "name": "decrypt_private_key",
      "type": "internal",
      "method": "FUNCTION",
      "endpoint": "internal",
      "description": "解密使用 AES-256-GCM 加密的私钥数据，返回原始 PEM",
      "request": {
        "parameters": [
          {
            "name": "encrypted_data",
            "type": "EncryptedKeyData",
            "required": true,
            "description": "加密数据，包含 cipher_data、nonce、tag"
          },
          {
            "name": "master_key",
            "type": "bytes",
            "required": true,
            "description": "256 位 AES 密钥"
          }
        ]
      },
      "response": {
        "status_code": 200,
        "body": {
          "type": "string",
          "description": "解密后的私钥 PEM 字符串"
        }
      },
      "error_handling": {
        "strategy": "fail_fast",
        "errors": [
          {
            "code": "DECRYPTION_FAILED",
            "message": "解密失败，密钥错误或数据损坏",
            "trigger": "认证标签不匹配或解密异常"
          }
        ],
        "retry": false
      },
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": []
    },
    {
      "id": "IF-004",
      "name": "compute_fingerprint",
      "type": "internal",
      "method": "FUNCTION",
      "endpoint": "internal",
      "description": "计算 SSH 公钥的 SHA-256 指纹（OpenSSH 格式）",
      "request": {
        "parameters": [
          {
            "name": "public_key_pem",
            "type": "string",
            "required": true,
            "description": "公钥 PEM 字符串"
          }
        ]
      },
      "response": {
        "status_code": 200,
        "body": {
          "type": "string",
          "description": "指纹字符串，如 SHA256:base64(hash)"
        }
      },
      "error_handling": {
        "strategy": "fail_fast",
        "errors": [
          {
            "code": "FINGERPRINT_FAILED",
            "message": "指纹计算失败",
            "trigger": "公钥解析或哈希计算异常"
          }
        ],
        "retry": false
      },
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": []
    }
  ],
  "topology": {
    "exchanges": []
  },
  "error_handling": {
    "strategy": "fail_fast"
  }
}