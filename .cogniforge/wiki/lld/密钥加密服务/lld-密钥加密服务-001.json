{
  "meta": {
    "doc_id": "lld-密钥加密服务-001",
    "type": "lld",
    "module": "密钥加密服务",
    "module_type": "infrastructure",
    "version": 1,
    "author": "System",
    "title": "密钥加密服务 LLD",
    "created": "2025-03-20"
  },
  "overview": {
    "description": "密钥加密服务提供对称加密功能，使用 AES-256 算法加密和解密 SSH 私钥。服务从安全配置中获取主密钥，执行加密和解密操作，并定义加密数据的存储格式，支持密钥轮换。",
    "ownership": "基础设施团队",
    "trigger": "外部服务调用加密/解密接口",
    "constraints": [
      "加密算法固定为 AES-256-CBC",
      "主密钥从环境变量或安全配置获取",
      "IV 必须是随机生成且 Base64 编码"
    ]
  },
  "module_boundary": {
    "in_scope": [
      "使用AES-256加密SSH私钥内容",
      "解密已加密的SSH私钥内容",
      "从环境变量或安全配置获取主密钥",
      "加密后的数据格式定义（包含算法、IV等元数据）",
      "与数据库交互，存储和读取加密后的私钥数据"
    ],
    "out_of_scope": [
      "SSH私钥的生成",
      "SSH连接管理",
      "用户界面和API接口",
      "主密钥的生成与轮换（由系统安全配置管理）",
      "业务数据库表的创建（本模块不定义数据库结构）"
    ],
    "owned_components": [
      "CMP-006"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001"
    ],
    "consumed_data_models": []
  },
  "topology": {
    "exchanges": [
      "direct:密钥加密服务"
    ],
    "namespaces": [
      "密钥加密服务"
    ],
    "buckets": []
  },
  "interfaces": [
    {
      "id": "CTR-001",
      "name": "密钥加密服务内部接口",
      "description": "加密和解密操作的内部接口契约。",
      "type": "sync",
      "method": "POST",
      "endpoint": "internal/aes/process",
      "schema": {
        "request": {
          "body": {
            "operation": "string (encrypt | decrypt)",
            "data": "object (EncryptedPrivateKey or plaintext)"
          }
        },
        "response": {
          "body": {
            "result": "object (EncryptedPrivateKey or plaintext)"
          }
        }
      }
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "EncryptedPrivateKey",
      "type": "struct",
      "status": "active",
      "version": 1,
      "fields": [
        {
          "name": "algorithm",
          "type": "string",
          "required": true
        },
        {
          "name": "iv",
          "type": "string",
          "required": true
        },
        {
          "name": "ciphertext",
          "type": "string",
          "required": true
        },
        {
          "name": "key_id",
          "type": "string",
          "required": false
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-006"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "algorithm 字段必须为 'AES-256-CBC'",
        "iv 必须是 Base64 编码的 16 字节随机数",
        "ciphertext 必须是 Base64 编码的密文",
        "key_id 可选，用于支持密钥轮换"
      ],
      "lifecycle": {
        "create": "加密操作时创建，存入数据库",
        "update": "密钥轮换时重新加密并更新",
        "delete": "随私钥记录删除而删除",
        "retention": "与私钥记录生命周期一致"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "所有错误通过异常抛出，调用方统一处理",
    "reliability_strategy": {
      "retry_policy": []
    }
  },
  "message_contracts": []
}