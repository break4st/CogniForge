  "error_handling": {
    "strategy": "axios 拦截器捕获 HTTP 错误，统一展示 message.error；WebSocket 异常在输出面板提示并尝试重连。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "用户操作错误（如模板不存在、参数非法），提示具体原因。"
      },
      {
        "code": "5xx",
        "name": "服务器错误",
        "description": "服务器内部错误，提示「服务暂时不可用，请稍后重试」。"
      },
      {
        "code": "Network Error",
        "name": "网络错误",
        "description": "网络连接异常，提示「网络连接异常，请检查网络」，WebSocket 连接失败自动重试最多 3 次。"
      }
    ]
  },
  "workflow": {
    "name": "脚本执行前端流程",
    "description": "用户选择模板和目标主机，发起执行并通过 WebSocket 接收实时输出",
    "steps": [
      {
        "order": 1,
        "name": "进入执行页",
        "action": "从列表页跳转至 /scripts/:id/execute，获取模板详情和主机列表",
        "timeout_seconds": 0,
        "on_failure": "获取失败提示错误，禁用执行操作"
      },
      {
        "order": 2,
        "name": "发起执行",
        "action": "用户选择主机并点击执行按钮，调用 POST /api/execute-script",
        "timeout_seconds": 10,
        "on_failure": "展示错误信息，重置按钮状态"
      },
      {
        "order": 3,
        "name": "建立 WebSocket",
        "action": "获取 sessionId 后连接 ws://<gateway>/ws/script-output/{sessionId}",
        "timeout_seconds": 5,
        "on_failure": "重试 3 次，每次间隔 2 秒，全部失败则提示用户手动刷新"
      },
      {
        "order": 4,
        "name": "接收输出",
        "action": "WebSocket onmessage 事件追加输出文本，onclose 判断结束状态",
        "timeout_seconds": 0,
        "on_failure": "连接异常关闭时若会话状态仍为 running，则自动重试连接"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 2,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  },
  "component_tree": [
    {
      "name": "ScriptManagerApp",
      "path": "/scripts/*",
      "description": "脚本管理模块根路由容器，渲染子路由组件",
      "props": [],
      "events": [],
      "state": [
        {
          "name": "authToken",
          "type": "string",
          "description": "用户认证令牌，从全局 AuthProvider 获取"
        }
      ],
      "behavior": [
        "嵌套路由组件 <Outlet />，根据当前路径渲染对应子页面"
      ],
      "edge_cases": [
        "权限校验由全局路由守卫完成，模块内不做二次校验"
      ],
      "children": [
        {
          "name": "ScriptListPage",
          "path": "/scripts",
          "description": "脚本模板列表页，支持删除、跳转编辑/执行",
          "props": [],
          "events": [],
          "state": [
            {
              "name": "templates",
              "type": "ScriptTemplate[]",
              "description": "脚本模板列表"
            },
            {
              "name": "loading",
              "type": "boolean",
              "description": "列表加载状态"
            }
          ],
          "behavior": [
            "挂载时调用 GET /api/script-templates 获取列表",
            "点击「新建」跳转至 /scripts/new",
            "点击「编辑」跳转至 /scripts/:id/edit",
            "点击「执行」跳转至 /scripts/:id/execute",
            "点击「删除」弹出确认框，确认后调用 DELETE /api/script-templates/:id，成功后刷新列表"
          ],
          "edge_cases": [
            "列表为空时显示 Ant Design Empty 组件，并提供「创建第一个脚本」引导",
            "删除操作返回错误时，提示用户「删除失败：xxx」",
            "网络请求异常时展示错误提示"
          ],
          "children": [
            {
              "name": "ScriptTable",
              "path": "列表页内部组件",
              "description": "使用 Ant Design Table 渲染脚本模板列表",
              "props": [
                {
                  "name": "templates",
                  "type": "ScriptTemplate[]",
                  "required": true,
                  "description": "模板数据"
                },
                {
                  "name": "loading",
                  "type": "boolean",
                  "required": true,
                  "description": "加载状态"
                },
                {
                  "name": "onEdit",
                  "type": "(id: string) => void",
                  "required": true,
                  "description": "编辑回调"
                },
                {
                  "name": "onExecute",
                  "type": "(id: string) => void",
                  "required": true,
                  "description": "执行回调"
                },
                {
                  "name": "onDelete",
                  "type": "(id: string) => void",
                  "required": true,
                  "description": "删除回调"
                }
              ],
              "events": [],
              "state": [],
              "behavior": [
                "展示列：名称、类型、更新时间、操作（编辑、执行、删除）"
              ],
              "edge_cases": [
                "无数据时呈现 Table 的 emptyText"
              ]
            }
          ]
        },
        {
          "name": "ScriptForm",
          "path": [
            "/scripts/new",
            "/scripts/:id/edit"
          ],
          "description": "脚本模板新增/编辑表单",
          "props": [
            {
              "name": "mode",
              "type": "'create' | 'edit'",
              "required": true,
              "description": "表单模式"
            },
            {
              "name": "templateId",
              "type": "string",
              "required": false,
              "description": "编辑模式下的模板 ID"
            }
          ],
          "events": [],
          "state": [
            {
              "name": "formData",
              "type": "{ name: string, type: 'start' | 'stop', content: string }",
              "description": "表单数据"
            },
            {
              "name": "loading",
              "type": "boolean",
              "description": "提交加载状态"
            },
            {
              "name": "originalData",
              "type": "ScriptTemplate | null",
              "description": "编辑模式下的原始数据"
            }
          ],
          "behavior": [
            "创建模式：直接渲染空表单",
            "编辑模式：挂载时通过 templateId 调用 GET /api/script-templates/:id 填充表单",
            "提交时调用 POST /api/script-templates（创建）或 PUT /api/script-templates/:id（更新）",
            "保存成功后跳转回列表页，失败则显示错误提示"
          ],
          "edge_cases": [
            "表单校验：名称必填，脚本内容必填",
            "编辑时若模板不存在（404），显示错误并跳转回列表页",
            "保存按钮设置 loading 状态防止重复提交"
          ]
        },
        {
          "name": "ScriptExecutePage",
          "path": "/scripts/:id/execute",
          "description": "选择目标主机并执行脚本，实时查看输出",
          "props": [],
          "events": [],
          "state": [
            {
              "name": "template",
              "type": "ScriptTemplate | null",
              "description": "当前模板信息"
            },
            {
              "name": "hosts",
              "type": "HostInfo[]",
              "description": "可用主机列表"
            },
            {
              "name": "selectedHostId",
              "type": "string | null",
              "description": "选中的主机 ID"
            },
            {
              "name": "session",
              "type": "ExecutionSession | null",
              "description": "执行会话"
            },
            {
              "name": "output",
              "type": "string",
              "description": "累积的输出文本"
            },
            {
              "name": "executing",
              "type": "boolean",
              "description": "是否正在执行"
            }
          ],
          "behavior": [
            "挂载时获取模板详情 GET /api/script-templates/:id",
            "获取主机列表 GET /api/hosts",
            "用户选择主机后点击执行按钮，调用 POST /api/execute-script",
            "获取 sessionId 后建立 WebSocket 连接 ws://<gateway>/ws/script-output/{sessionId}",
            "接收 onmessage 事件追加输出文本",
            "提供「中止执行」按钮，调用 POST /api/abort-execution"
          ],
          "edge_cases": [
            "模板不存在（404）时提示并禁用执行",
            "主机列表加载失败时提示用户检查环境模块",
            "WebSocket 连接失败时重试 3 次，均失败则提示用户手动刷新",
            "用户离开页面时弹出确认框「执行仍在进行，离开将断开连接」",
            "输出过大时采用虚拟滚动渲染"
          ],
          "children": [
            {
              "name": "HostSelector",
              "path": "执行页内部组件",
              "description": "主机选择器，下拉或表格单选",
              "props": [
                {
                  "name": "hosts",
                  "type": "HostInfo[]",
                  "required": true,
                  "description": "主机列表"
                },
                {
                  "name": "selectedHostId",
                  "type": "string | null",
                  "required": false,
                  "description": "当前选中主机 ID"
                },
                {
                  "name": "onSelect",
                  "type": "(hostId: string) => void",
                  "required": true,
                  "description": "选择回调"
                }
              ],
              "events": [
                {
                  "name": "onSelect",
                  "payload_type": "string (hostId)"
                }
              ],
              "state": [],
              "behavior": [
                "渲染 Ant Design Select 或 Radio.Group 展示主机名称和地址"
              ],
              "edge_cases": [
                "主机列表为空时提示「无可用主机」",
                "加载失败时在组件内显示错误信息"
              ]
            },
            {
              "name": "OutputPanel",
              "path": "执行页内部组件",
              "description": "实时显示脚本输出，支持中止操作",
              "props": [
                {
                  "name": "output",
                  "type": "string",
                  "required": true,
                  "description": "输出文本"
                },
                {
                  "name": "status",
                  "type": "string",
                  "required": true,
                  "description": "执行状态"
                },
                {
                  "name": "onAbort",
                  "type": "() => void",
                  "required": true,
                  "description": "中止回调"
                }
              ],
              "events": [
                {
                  "name": "onAbort",
                  "payload_type": "void"
                }
              ],
              "state": [
                {
                  "name": "containerRef",
                  "type": "React.RefObject<HTMLDivElement>",
                  "description": "输出容器引用，用于自动滚动到底部"
                }
              ],
              "behavior": [
                "接收 output 变化后更新显示，并自动滚动到底部",
                "根据 status 显示不同状态标签",
                "点击「中止执行」调用 onAbort"
              ],
              "edge_cases": [
                "输出包含 ANSI 颜色码时进行简单解析并着色",
                "输出行数过多时启用虚拟滚动"
              ]
            }
          ]
        }
      ]
    }
  ],
  "state_design": {
    "global": [
      {
        "name": "authToken",
        "type": "string",
        "description": "用户认证令牌，由全局 AuthProvider 提供",
        "consumers": [
          "ScriptManagerApp"
        ]
      },
      {
        "name": "environments (hosts)",
        "type": "HostInfo[]",
        "description": "可用主机列表，由 EnvironmentManager 维护，ScriptManager 消费",
        "consumers": [
          "ScriptExecutePage"
        ]
      }
    ],
    "caching_strategy": "脚本模板列表在页面切换时保持（通过路由嵌套或状态提升），主机列表每次进入执行页都重新请求以保证最新；输出数据仅保存在执行页内，卸载时丢弃。"
  },
  "route_design": [
    {
      "path": "/scripts",
      "page": "ScriptListPage",
      "title": "脚本管理",
      "auth": "all",
      "layout": "default"
    },
    {
      "path": "/scripts/new",
      "page": "ScriptForm (mode=create)",
      "title": "新建脚本模板",
      "auth": "all",
      "layout": "default"
    },
    {
      "path": "/scripts/:id/edit",
      "page": "ScriptForm (mode=edit)",
      "title": "编辑脚本模板",
      "auth": "all",
      "layout": "default"
    },
    {
      "path": "/scripts/:id/execute",
      "page": "ScriptExecutePage",
      "title": "执行脚本",
      "auth": "all",
      "layout": "default"
    }
  ],
  "interaction_flows": [
    {
      "name": "创建并执行一个启动脚本",
      "description": "用户新建一个启动脚本模板，然后立即执行",
      "steps": [
        "步骤1: 用户从导航进入「脚本管理」路径 /scripts，列表为空",
        "步骤2: 点击「新建脚本」跳转至 /scripts/new",
        "步骤3: 输入名称「启动 Tomcat」，选择类型「启动」，填写脚本内容，保存",
        "步骤4: 返回列表页 /scripts，新脚本出现，点击其「执行」按钮",
        "步骤5: 页面跳转至 /scripts/:id/execute，显示模板详情和主机选择器",
        "步骤6: 用户选择一个主机，点击「执行启动」，页面显示「连接中...」",
        "步骤7: 输出面板开始滚动显示远程脚本的输出",
        "步骤8: 脚本执行完毕，面板底部显示「执行成功」，用户可重新执行或返回列表"
      ]
    },
    {
      "name": "编辑现有脚本并测试",
      "description": "用户修改已有停止脚本并执行测试",
      "steps": [
        "步骤1: 在列表页点击某个停止脚本的「编辑」，跳转至 /scripts/:id/edit",
        "步骤2: 表单预填充原有内容，用户修改脚本内容后保存",
        "步骤3: 返回列表页后点击同一脚本的「执行」",
        "步骤4: 选择主机，执行修改后的脚本，观察输出"
      ]
    }
  ],
