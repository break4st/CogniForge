  "module_boundary": {
    "in_scope": [
      "脚本模板的创建、查看、编辑、删除",
      "将模板与主机关联并远程执行启动/停止脚本",
      "实时展示脚本执行标准输出/错误输出",
      "提供执行过程中的状态指示"
