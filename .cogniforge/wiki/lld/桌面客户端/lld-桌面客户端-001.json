  "component_tree": {
    "routes": [
      {
        "path": "/",
        "component": "Dashboard",
        "description": "仪表盘页面，总览项目与部署状态"
      },
      {
        "path": "/projects",
        "component": "ProjectList",
        "description": "项目列表页面"
      },
      {
        "path": "/projects/:id",
        "component": "ProjectDetail",
        "description": "项目详情页面，包括环境、部署等子页面"
      },
      {
        "path": "/projects/:id/environments/:envId",
        "component": "EnvironmentDetail",
        "description": "环境详情与编辑页面"
      },
      {
        "path": "/projects/:id/deployments",
        "component": "DeploymentList",
        "description": "部署历史列表页面"
      },
      {
        "path": "/projects/:id/deployments/:deployId",
        "component": "DeploymentLogView",
        "description": "实时部署日志查看页面"
      },
      {
        "path": "/secrets",
        "component": "SecretKeyList",
        "description": "密钥管理页面"
      },
      {
        "path": "/projects/:id/versions",
        "component": "VersionHistoryList",
        "description": "版本历史列表页面"
      }
    ],
    "navigation_guard": {
      "before_unload": "如果有进行中的部署，提示用户确认离开"
    }
  },
  "route_design": [
    {
      "path": "/",
