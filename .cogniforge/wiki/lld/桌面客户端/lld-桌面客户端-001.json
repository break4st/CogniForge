  "state_design": {
    "global_state": {
      "current_project_id": "string | null",
      "current_deployment_status": "string | null",
      "notifications": "string[]"
    },
    "local_state": {
      "list_data": "any[]",
      "modal_visible": "boolean",
      "form_data": "any",
      "loading": "boolean"
    },
    "state_transitions": [
      {
        "event": "SWITCH_PROJECT",
        "from": "any",
        "to": "new project context",
        "description": "切换当前项目，刷新关联数据"
      },
      {
        "event": "DEPLOYMENT_STATUS_CHANGE",
        "from": "running",
        "to": "success or failed",
        "description": "部署完成后更新状态"
      }
    ]
  },
  "interaction_flows": [
    {
      "name": "创建项目",
      "description": "用户在任意页面创建新项目",
      "steps": [
        "用户: 在仪表盘或项目列表点击“新建项目”按钮",
        "系统: 显示项目创建表单模态框",
        "用户: 填写项目名称、描述，点击确定",
        "系统: 调用API创建项目，成功后刷新项目列表并关闭模态框，切换到新项目详情"
      ],
      "post_conditions": [
        "新项目出现在项目列表中",
        "界面跳转到新项目详情页"
      ],
      "alternative_flows": [
        {
          "condition": "创建失败",
          "steps": [
            "系统显示错误提示，保留表单数据"
          ]
        }
      ]
    },
    {
      "name": "一键部署",
      "description": "用户在项目详情页触发一键部署到指定环境",
      "steps": [
        "用户: 在项目详情页选择环境和版本，点击“一键部署”按钮",
        "系统: 调用API触发部署，并跳转到部署日志页面，建立WebSocket连接",
        "系统: 实时接收渲染日志消息，更新日志区域",
        "系统: 当接收到部署完成/失败状态时，更新部署状态，关闭WebSocket连接"
      ],
      "post_conditions": [
        "部署任务已启动",
        "界面展示实时日志",
        "部署完成后显示最终状态"
      ],
      "alternative_flows": [
        {
          "condition": "WebSocket连接失败",
          "steps": [
            "系统显示错误提示，提供手动刷新或重试按钮"
          ]
        },
        {
          "condition": "部署失败",
          "steps": [
            "系统显示失败状态和错误日志"
          ]
        }
      ]
    }
  ],
