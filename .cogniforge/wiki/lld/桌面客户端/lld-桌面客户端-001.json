  "overview": {
    "description": "基于Electron的桌面客户端，使用React + TypeScript + Ant Design构建用户界面，提供项目管理、环境配置、密钥管理、一键部署、实时部署日志、版本历史与回滚等功能。通过HTTP请求调用后端API，通过WebSocket接收实时日志推送。",
    "dependencies": [
      "API 网关服务 (CMP-002)"
    ],
    "tech_stack": [
      "React",
      "TypeScript",
      "Ant Design",
      "Electron"
    ]
  },
