  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ConnectivityTestService",
      "status": "active",
      "version": 1,
      "description": "连通性测试服务契约，定义服务内部组件实现的方法签名。",
      "methods": [
        {
          "name": "test_connectivity",
          "description": "执行连通性测试的主方法，组合TCP、SSH、写权限三项检测",
          "parameters": [
            {
              "name": "env_id",
              "type": "integer",
              "description": "环境ID"
            }
          ],
          "return_type": "ConnectivityTestResult",
          "exceptions": [
            "EnvironmentNotFoundError",
            "DecryptionError",
            "ConnectivityTestError"
          ]
        }
      ],
      "source_requirements": [
        "REQ-002"
      ],
      "source_components": [
        "CMP-002"
      ],
      "source_contracts": [
        "CTR-005"
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "rule": "三项检测必须全部执行，不能因单项检测失败而跳过后续检测",
      "type": "invariant",
      "rationale": "为了提供完整的诊断信息，即使TCP连接失败，也应尝试SSH和写权限检测，结果中记录实际状态"
    },
    {
      "id": "BR-002",
      "rule": "私钥解密必须在每次测试时实时进行，不得缓存私钥明文",
      "type": "invariant",
      "rationale": "安全要求，避免内存中长期存在明文私钥"
    },
    {
      "id": "BR-003",
      "rule": "TCP连接超时应设置为5秒，SSH认证超时10秒",
      "type": "invariant",
      "rationale": "平衡用户体验与网络延迟容忍度"
    }
  ],
  "error_handling": [
    {
      "scenario": "数据库连接失败或环境ID不存在",
      "strategy": "返回404 NOT_FOUND，错误码NOT_FOUND",
      "recovery": "无自动恢复，需用户确认环境ID有效"
    },
    {
      "scenario": "私钥解密失败",
      "strategy": "返回500，错误码DECRYPTION_FAILED，记录详细错误日志",
      "recovery": "需管理员检查密钥存储与加密配置"
    },
    {
      "scenario": "TCP连接超时",
      "strategy": "标记TCP测试失败，继续执行后续检测，不中断整个流程",
      "recovery": "记录超时事件，返回部分成功结果"
    },
    {
      "scenario": "SSH认证失败（如密钥无效）",
      "strategy": "标记SSH测试失败，继续写权限检测（可能因无法登录而无法检测），结果中注明失败原因",
      "recovery": "无自动恢复，需用户更新环境凭证"
    },
    {
      "scenario": "远程路径写权限检测失败（无权限或目录不存在）",
      "strategy": "标记写权限失败，返回具体错误描述（如Permission denied）",
      "recovery": "无自动恢复，需用户检查远程路径权限"
    }
  ]
}