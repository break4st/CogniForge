  "module_boundary": {
    "in_scope": [
      "TCP连通性检测：探测目标主机的指定端口是否可达",
      "SSH认证测试：使用目标主机用户名及解密后的私钥尝试登录",
      "远程路径写权限检测：通过SSH在指定远程路径下创建临时文件验证写入能力",
      "生成结构化测试结果并返回（布尔状态+可读描述）"
    ],
    "out_of_scope": [
      "环境的生命周期管理（创建、更新、删除由环境管理服务负责）",
      "私钥的加密存储与轮转（由密钥管理组件KeyManager负责）",
      "部署文件上传、脚本执行、进度通知等其它部署步骤",
      "前端SSE进度展示（由进度通知器负责）"
    ],
    "owned_components": [
      "CMP-002"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "连通性测试服务是部署流水线中的独立微服务，负责验证目标环境的基础设施可达性与凭证有效性。每次调用执行实时探测，包含TCP连接、SSH认证、写权限检查，返回结构化结果。服务无状态，不存储业务数据。",
    "dependencies": [
      "环境管理服务（提供环境基础信息查询）",
      "密钥管理组件KeyManager（提供私钥解密）",
      "PostgreSQL数据库（直接读取environments表）"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "Paramiko",
      "socket（标准库）",
      "cryptography（通过KeyManager调用）"
    ]
  },
