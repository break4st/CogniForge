  "error_handling": {
    "strategy": "前端统一捕获网络和业务异常；网络错误提示重试，业务错误按状态码显示后端返回的error字段。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "参数错误或资源未找到，显示后端错误信息并允许用户修正输入"
      },
      {
        "code": "5xx",
        "name": "服务端错误",
        "description": "服务器内部错误，提示稍后重试"
      },
      {
        "code": "NETWORK_ERROR",
        "name": "网络错误",
        "description": "请求超时或无法连接，提示检查网络并提供重试按钮"
      }
    ]
  },
  "workflow": {
    "name": "部署历史查询与操作流程",
    "description": "用户进入页面后查看列表、过滤、查看日志或重新部署的端到端流程",
    "steps": [
      {
        "order": 1,
        "name": "页面初始化",
        "action": "Zustand store发起GET /api/deployments?page=1&size=10请求",
        "timeout_seconds": 30,
        "on_failure": "提示网络错误，显示重试按钮"
      },
      {
        "order": 2,
        "name": "过滤操作",
        "action": "FilterBar提交过滤条件，store更新filter并重新请求列表API",
        "timeout_seconds": 30,
        "on_failure": "提示请求失败，保留上次成功数据"
      },
      {
        "order": 3,
        "name": "查看日志",
        "action": "用户点击「查看日志」，store请求GET /api/deployments/{id}/log，成功后打开LogModal",
        "timeout_seconds": 30,
        "on_failure": "提示日志加载失败，关闭弹窗"
      },
      {
        "order": 4,
        "name": "重新部署",
        "action": "确认后store请求POST /api/deployments/{id}/redeploy，成功后刷新列表",
        "timeout_seconds": 60,
        "on_failure": "提示具体错误，解除按钮loading状态"
      }
    ],
    "retry_strategy": {
      "max_retries": 0,
      "retry_interval_seconds": 0,
      "retryable_errors": [],
      "non_retryable_errors": [],
      "notes": "不自动重试，由用户主动点击重试"
    }
  },
  "component_tree": [
    {
      "name": "DeploymentHistoryPage",
      "path": "/deployments/history",
      "description": "历史记录页面容器，负责初始化store并协调子组件",
      "props": [],
      "events": [],
      "state": [
        {
          "name": "globalStore",
          "type": "DeploymentHistoryStore",
          "description": "通过Zustand订阅的全局状态"
        }
      ],
      "behavior": [
        "挂载时调用store.fetchDeployments()",
        "提供fetchDeployments、openLog、handleRedeploy等方法给子组件"
      ],
      "edge_cases": [
        "组件卸载时取消未完成的请求",
        "路由离开时不清除store（允许多次进出）"
      ],
      "children": [
        {
          "name": "FilterBar",
          "path": "/deployments/history",
          "description": "提供项目ID和时间范围过滤，含搜索按钮",
          "props": [
            {
              "name": "currentFilter",
              "type": "DeploymentFilter",
              "required": true,
              "description": "当前过滤条件"
            },
            {
              "name": "onFilterChange",
              "type": "(filter: DeploymentFilter) => void",
              "required": true,
              "description": "提交有效过滤条件时回调，自动重置页码为1"
            }
          ],
          "events": [],
          "state": [
            {
              "name": "localFilter",
              "type": "DeploymentFilter",
              "description": "组件内部维护的临时过滤条件，点击搜索时校验后提交"
            }
          ],
          "behavior": [
            "输入变化更新localFilter",
            "点击「搜索」校验项目ID为数字、时间范围合法，通过后调用onFilterChange"
          ],
          "edge_cases": [
            "非法输入时使用Ant Design Form校验并阻止提交",
            "结束时间早于开始时间时显示错误提示"
          ],
          "children": []
        },
        {
          "name": "DeploymentTable",
          "path": "/deployments/history",
          "description": "以Ant Design Table展示部署记录列表",
          "props": [
            {
              "name": "deployments",
              "type": "Deployment[]",
              "required": true,
              "description": "部署记录数组"
            },
            {
              "name": "loading",
              "type": "boolean",
              "required": true,
              "description": "表格加载状态"
            },
            {
              "name": "total",
              "type": "number",
              "required": true,
              "description": "总记录数"
            },
            {
              "name": "pagination",
              "type": "{ current: number; pageSize: number; onChange: (page, size) => void }",
              "required": true,
              "description": "分页配置与回调"
            },
            {
              "name": "onViewLog",
              "type": "(id: string) => void",
              "required": true,
              "description": "查看日志按钮点击回调"
            },
            {
              "name": "onRedeploy",
              "type": "(id: string) => void",
              "required": true,
              "description": "重新部署按钮点击回调"
            },
            {
              "name": "redeployLoading",
              "type": "Record<string, boolean>",
              "required": true,
              "description": "记录按钮加载状态"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "使用Ant Design Table渲染数据，列包括ID、项目ID、环境ID、部署时间、状态、操作",
            "操作列包含「查看日志」和「重新部署」按钮",
            "重新部署按钮在loading时显示loading图标并禁用"
          ],
          "edge_cases": [
            "loading=true时表格显示加载遮罩",
            "deployments为空时显示Empty组件"
          ],
          "children": []
        },
        {
          "name": "LogModal",
          "path": "/deployments/history",
          "description": "模态弹窗，展示完整部署日志文本",
          "props": [
            {
              "name": "visible",
              "type": "boolean",
              "required": true,
              "description": "弹窗是否可见"
            },
            {
              "name": "logContent",
              "type": "string",
              "required": true,
              "description": "要展示的日志文本"
            },
            {
              "name": "onClose",
              "type": "() => void",
              "required": true,
              "description": "关闭弹窗回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "打开时自动滚动到顶部",
            "日志内容用<pre>标签或white-space:pre-wrap样式保留格式"
          ],
          "edge_cases": [
            "logContent为空时显示「暂无日志」",
            "日志超长时设置max-height并提供垂直滚动"
          ],
          "children": []
        }
      ]
    }
  ],
  "state_design": {
    "global": [
      {
        "name": "deployments",
        "type": "Deployment[]",
        "description": "当前页面部署列表",
        "consumers": [
