          "LogModal"
        ]
      },
      {
        "name": "logDeploymentId",
        "type": "string | null",
        "description": "当前日志所属部署ID",
        "consumers": [
          "DeploymentHistoryPage"
        ]
      },
      {
        "name": "logModalVisible",
        "type": "boolean",
        "description": "日志弹窗可见性",
        "consumers": [
          "LogModal"
        ]
      },
      {
        "name": "redeployLoading",
        "type": "Record<string, boolean>",
        "description": "重新部署按钮loading状态",
        "consumers": [
          "DeploymentTable"
        ]
