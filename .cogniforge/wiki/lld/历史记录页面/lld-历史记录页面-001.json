  "overview": {
    "description": "历史记录页面向用户展示所有部署历史，支持项目和时间范围过滤，并可查看详细日志或发起重新部署。模块通过消费部署历史与日志服务提供的REST接口获取数据。",
    "dependencies": [
      "部署历史与日志服务"
    ],
    "tech_stack": [
      "React 18 + TypeScript",
      "Ant Design 5",
      "Zustand"
    ]
  },
