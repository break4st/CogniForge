  "data_models": [
    {
      "id": "DM-001",
      "name": "ConnectionConfig",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "SSH连接所需的配置参数，包括主机、端口、用户名、认证信息等",
      "fields": [
        {"name": "host", "type": "string", "required": true, "description": "远程主机地址"},
        {"name": "port", "type": "number", "required": true, "description": "SSH端口，默认22"},
        {"name": "username", "type": "string", "required": true, "description": "登录用户名"},
        {"name": "privateKey", "type": "string", "required": false, "description": "解密后的私钥内容"},
        {"name": "passphrase", "type": "string", "required": false, "description": "私钥密码短语（如有）"},
        {"name": "password", "type": "string", "required": false, "description": "密码认证（备选）"},
        {"name": "timeout", "type": "number", "required": false, "description": "连接超时时间（毫秒）"}
      ],
      "indexes": [],
      "source_requirements": ["REQ-001"],
      "source_components": ["CMP-001"],
      "source_contracts": ["CTR-001"],
      "constraints": [
        "必须提供host和username",
        "认证方式至少提供一种（私钥或密码）",
        "私钥需由加密模块解密后传入"
      ],
      "lifecycle": {
        "create": "由上层模块构造并传入",
        "update": "连接过程中配置不可变",
        "delete": "连接关闭后丢弃",
        "retention": "仅在连接期间有效"
      },
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成LLD"}
      ]
    },
    {
      "id": "DM-002",
      "name": "SSHExecutionResult",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "远程命令执行的结果，含标准输出、标准错误和退出码",
      "fields": [
        {"name": "stdout", "type": "string", "required": true, "description": "命令的标准输出"},
        {"name": "stderr", "type": "string", "required": true, "description": "命令的标准错误输出"},
        {"name": "exitCode", "type": "number", "required": true, "description": "命令退出码，0表示成功"}
      ],
      "indexes": [],
      "source_requirements": ["REQ-001"],
      "source_components": ["CMP-001"],
      "source_contracts": ["CTR-001"],
      "constraints": [
        "exitCode为整数",
        "stdout和stderr为字符串，可能为空"
      ],
      "lifecycle": {
        "create": "命令执行完成后生成",
        "update": "不可变",
        "delete": "调用方使用后释放",
        "retention": "无持久化需求"
      },
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成LLD"}
      ]
    },
    {
      "id": "DM-003",
      "name": "SFTPTransferOptions",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "SFTP传输配置，如本地路径、远程路径、传输模式等",
      "fields": [
        {"name": "localPath", "type": "string", "required": true, "description": "本地文件路径"},
        {"name": "remotePath", "type": "string", "required": true, "description": "远程文件路径"},
        {"name": "mode", "type": "string", "required": false, "description": "传输模式，如'auto'、'binary'、'text'"}
      ],
      "indexes": [],
      "source_requirements": ["REQ-003"],
      "source_components": ["CMP-001"],
      "source_contracts": ["CTR-001"],
      "constraints": [
        "路径必须为有效字符串",
        "mode为可选，默认自动检测"
      ],
      "lifecycle": {
        "create": "调用传输方法时构造",
        "update": "不可变",
        "delete": "传输完成后丢弃",
        "retention": "无持久化"
      },
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成LLD"}
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "connect",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "connect",
      "description": "建立SSH连接，传入连接配置对象返回连接实例",
      "parameters": [
        {"name": "config", "type": "ConnectionConfig", "in": "body", "required": true, "description": "SSH连接所需的配置参数，包括主机、端口、用户名、解密后私钥等"}
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {"connection": "SSH连接实例（ssh2 Client对象）"}
      },
      "error_codes": [
        {"status": 400, "code": "INVALID_CONFIG", "message": "连接配置无效，缺少必要参数或私钥格式错误"},
        {"status": 500, "code": "CONNECTION_FAILED", "message": "SSH连接失败，如主机不可达、认证失败、超时等"}
      ],
      "auth": {"required": false, "policy": ""},
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-001"],
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD"}
      ]
    },
    {
      "id": "IF-002",
      "name": "exec",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "exec",
      "description": "在已建立的SSH连接上执行远程命令，返回执行结果",
      "parameters": [
        {"name": "connection", "type": "SSH连接实例", "in": "body", "required": true, "description": "通过connect接口返回的活跃SSH连接实例"},
        {"name": "command", "type": "string", "in": "body", "required": true, "description": "待执行的远程命令字符串"}
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": "SSHExecutionResult"
      },
      "error_codes": [
        {"status": 400, "code": "INVALID_COMMAND", "message": "命令为空或包含非法字符"},
        {"status": 500, "code": "EXECUTION_ERROR", "message": "命令执行过程中发生错误，如连接已断开、执行超时"}
      ],
      "auth": {"required": false, "policy": ""},
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-001"],
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD"}
      ]
    },
    {
      "id": "IF-003",
      "name": "testConnection",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "testConnection",
      "description": "快速测试SSH连通性，内部调用connect后执行简单命令（如echo）",
      "parameters": [
        {"name": "config", "type": "ConnectionConfig", "in": "body", "required": true, "description": "SSH连接所需的配置参数"}
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {"success": "boolean", "message": "string（连通性测试结果描述）"}
      },
      "error_codes": [
        {"status": 400, "code": "INVALID_CONFIG", "message": "连接配置无效"},
        {"status": 500, "code": "TEST_FAILED", "message": "连通性测试失败，无法建立连接或执行测试命令"}
      ],
      "auth": {"required": false, "policy": ""},
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-001"],
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD"}
      ]
    },
    {
      "id": "IF-004",
      "name": "putFile",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "putFile",
      "description": "通过SFTP上传本地文件到远程主机指定路径",
      "parameters": [
        {"name": "connection", "type": "SSH连接实例", "in": "body", "required": true, "description": "通过connect接口返回的活跃SSH连接实例"},
        {"name": "localPath", "type": "string", "in": "body", "required": true, "description": "本地文件的完整路径"},
        {"name": "remotePath", "type": "string", "in": "body", "required": true, "description": "远程主机上的目标路径"},
        {"name": "options", "type": "SFTPTransferOptions", "in": "body", "required": false, "description": "额外的传输选项，如覆盖标志、权限设置等"}
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {"success": "boolean", "message": "string（上传结果描述）"}
      },
      "error_codes": [
        {"status": 400, "code": "INVALID_PATH", "message": "本地文件路径无效或远程路径不合法"},
        {"status": 500, "code": "UPLOAD_FAILED", "message": "文件上传失败，可能由于权限不足、磁盘空间不足或网络中断"}
      ],
      "auth": {"required": false, "policy": ""},
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-003"],
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD"}
      ]
    },
    {
      "id": "IF-005",
      "name": "getFile",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "getFile",
      "description": "通过SFTP从远程主机下载文件到本地",
      "parameters": [
        {"name": "connection", "type": "SSH连接实例", "in": "body", "required": true, "description": "通过connect接口返回的活跃SSH连接实例"},
        {"name": "remotePath", "type": "string", "in": "body", "required": true, "description": "远程主机上的文件路径"},
        {"name": "localPath", "type": "string", "in": "body", "required": true, "description": "本地保存文件的路径"},
        {"name": "options", "type": "SFTPTransferOptions", "in": "body", "required": false, "description": "额外的传输选项，如覆盖标志、保留时间戳等"}
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {"success": "boolean", "message": "string（下载结果描述）"}
      },
      "error_codes": [
        {"status": 400, "code": "INVALID_PATH", "message": "远程文件路径无效或本地路径不合法"},
        {"status": 500, "code": "DOWNLOAD_FAILED", "message": "文件下载失败，可能由于权限不足、文件不存在或网络中断"}
      ],
      "auth": {"required": false, "policy": ""},
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-003"],
      "change_history": [
        {"version": 1, "change_type": "created", "summary": "初始创建", "reason": "首次生成 LLD"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "统一错误处理，连接及执行错误均返回结构化错误对象，包含错误码和可读消息。",
    "response_format": {
      "body": {"code": "integer", "error": "string", "detail": "string"}
    },
    "categories": [
      {"code": "4xx", "name": "客户端错误", "description": "由于配置无效、参数缺失等原因导致的错误。"},
      {"code": "5xx", "name": "服务端错误", "description": "由于网络、认证或远程执行失败等原因导致的错误。"}
    ]
  },
  "topology": {
    "exchanges": [
      {
        "name": "ssh-client-exchange",
        "type": "direct",
        "durable": true,
        "bindings": [{"queue": "ssh-client-queue", "routing_key": "ssh.command"}]
      }
    ],
    "queues": [
      {"name": "ssh-client-queue", "durable": true, "ttl_seconds": 86400, "max_length": 10000}
    ],
    "producer_consumer_map": [
      {"producer": "部署引擎", "consumer": "SSH客户端模块", "exchange": "ssh-client-exchange"}
    ]
  },
  "message_contracts": [
    {
      "name": "SSHCommandMessage",
      "exchange": "ssh-client-exchange",
      "routing_key": "ssh.command",
      "schema": {
        "commandId": "string",
        "connectionConfig": "ConnectionConfig",
        "command": "string"
      },
      "required_fields": ["commandId", "connectionConfig", "command"],
      "max_size_bytes": 1048576
    }
  ],
  "reliability_strategy": {
    "ack_mode": "manual",
    "retry": {"max_retries": 3, "backoff": "exponential"},
    "dead_letter": "ssh-client-dlq",
    "idempotency": "基于命令唯一ID去重"
  },
  "security_design": {},
  "workflow": {
    "name": "SSH连接与命令执行流程",
    "description": "展示SSH客户端模块连接、执行命令、传输文件的核心流程",
    "steps": [
      {"order": 1, "name": "解密私钥", "action": "调用加密模块解密私钥，获取明文私钥", "timeout_seconds": 30, "on_failure": "中止连接，返回配置错误"},
      {"order": 2, "name": "建立SSH连接", "action": "使用ssh2库创建SSH连接", "timeout_seconds": 30, "on_failure": "重试或返回连接失败错误"},
      {"order": 3, "name": "执行远程命令", "action": "在连接上执行exec接口传入的命令", "timeout_seconds": 60, "on_failure": "返回执行错误，记录日志"}
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": ["NETWORK_ERROR", "TIMEOUT"],
      "non_retryable_errors": ["AUTH_ERROR", "CONFIG_ERROR"]
    }
  }
}