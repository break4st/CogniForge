  "module_boundary": {
    "in_scope": [
      "SSH连接建立与管理",
      "远程命令执行",
      "SFTP文件上传/下载",
      "连接测试",
      "私钥解密集成（调用加密模块）",
      "连接配置管理"
    ],
    "out_of_scope": [
      "私钥存储与加密（由密钥管理模块负责）",
      "解密算法实现（由加密模块提供）",
      "GUI交互逻辑（由表示层处理）",
      "部署流程编排（由部署引擎负责）"
    ],
    "owned_components": ["CMP-001"],
    "owned_contracts": ["CTR-001"],
    "consumed_contracts": ["CTR-009"],
    "owned_data_models": ["DM-001", "DM-002", "DM-003"],
    "consumed_data_models": []
  },
  "overview": {
    "description": "封装ssh2库，提供SSH连接、远程命令执行及SFTP文件传输能力。通过调用加密模块解密私钥后建立连接，为部署引擎、环境管理等上层模块提供基础设施支持。",
    "dependencies": [
      "ssh2 (Node.js SSH客户端库)",
      "加密模块 (CTR-009)"
    ],
    "tech_stack": [
      "Node.js",
      "ssh2",
      "Node.js crypto (间接依赖，解密由加密模块完成)"
    ]
  },
  "traceability": [
