    "title": "文件存储详细设计",
    "author": "design_agent",
    "created": "2025-03-21T10:00:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-001"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
