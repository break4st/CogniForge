  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeploymentOrchestrator",
      "object_type": "service",
      "description": "部署流程编排器，负责执行整个部署流水线：连接建立、文件上传、远程命令执行、符号链接更新、回滚等",
      "methods": [
        {
          "name": "execute_deploy",
          "visibility": "public",
          "parameters": [
            {
              "name": "message",
              "type": "DeployTaskMessage"
            }
          ],
          "returns": "None",
          "description": "执行完整部署流水线"
        }
      ],
      "dependencies": [
        "SSHService",
        "DeploymentRepository",
        "WebSocketService",
        "ConfigRepository"
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": []
    },
    {
      "id": "DO-002",
      "name": "SSHService",
      "object_type": "service",
      "description": "SSH 服务，封装 AsyncSSH 连接、文件上传、远程命令执行、输出捕获，支持自动重连",
      "methods": [
        {
          "name": "connect",
          "visibility": "public",
          "parameters": [
            {
              "name": "config",
              "type": "SSHConnectionConfig"
            }
          ],
          "returns": "None",
          "description": "建立 SSH 连接"
        },
        {
          "name": "upload_file",
          "visibility": "public",
          "parameters": [
            {
              "name": "local_path",
              "type": "string"
            },
            {
              "name": "remote_path",
              "type": "string"
            }
          ],
          "returns": "None",
          "description": "通过 SFTP 上传文件"
        },
        {
          "name": "execute_command",
          "visibility": "public",
          "parameters": [
            {
              "name": "command",
              "type": "string"
            }
          ],
          "returns": "CommandResult",
          "description": "执行远程命令并返回结果"
        },
        {
          "name": "disconnect",
          "visibility": "public",
          "parameters": [],
          "returns": "None",
          "description": "断开连接"
        }
      ],
      "dependencies": [],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": []
    },
