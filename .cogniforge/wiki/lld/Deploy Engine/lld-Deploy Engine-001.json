  "module_boundary": {
    "in_scope": [
      "从 RabbitMQ 消费部署任务消息",
      "通过 SFTP/SCP 传输部署文件到远程服务器",
      "远程执行 Shell 命令（创建目录、解压、生成脚本、赋予权限）",
      "原子更新 current 符号链接",
      "实时捕获命令输出并通过 WebSocket 推送日志",
      "部署失败时执行回滚操作",
      "更新部署记录状态"
    ],
    "out_of_scope": [
      "用户认证与鉴权",
      "部署记录创建、文件上传、任务入队",
      "WebSocket 的网关代理实现",
      "前端界面展示"
    ],
    "owned_components": [
      "CMP-005"
    ],
    "owned_contracts": [
      "CTR-007"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-002",
      "DM-003",
      "DM-004"
    ],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "部署执行引擎，消费 RabbitMQ 中的部署任务消息，通过 SSH 连接远程服务器执行文件上传、解压、脚本生成、符号链接更新等步骤，并实时推送日志。",
    "dependencies": [
      "Business Service",
      "API Gateway",
      "MySQL",
      "RabbitMQ"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "RabbitMQ 3.12",
      "MySQL 8.0",
      "AsyncSSH"
    ]
  },
