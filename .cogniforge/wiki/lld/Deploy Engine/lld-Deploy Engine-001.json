              "type": "string"
            }
          ],
          "returns": "None",
          "description": "更新部署记录状态"
        },
        {
          "name": "get_by_task_id",
          "visibility": "public",
          "parameters": [
            {
              "name": "task_id",
              "type": "string"
            }
          ],
          "returns": "Deployment",
          "description": "根据 task_id 查询部署记录"
        }
      ],
      "dependencies": [],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": []
    },
    {
      "id": "DO-004",
      "name": "WebSocketService",
      "object_type": "service",
      "description": "日志推送服务，封装向指定 task_id 的 WebSocket 连接发送结构化日志消息",
      "methods": [
        {
          "name": "send_log",
