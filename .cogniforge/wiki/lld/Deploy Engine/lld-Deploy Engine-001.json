      ],
      "source_contracts": []
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeployService",
      "methods": [
        {
          "name": "consume_deploy_message",
          "signature": "consume_deploy_message(message: DeployTaskMessage) -> None",
          "precondition": "消息格式有效，且部署记录存在",
          "postcondition": "部署流水线完成（成功或失败），部署记录状态更新，日志已推送",
          "parameters": [
            {
              "name": "message",
              "type": "DeployTaskMessage",
              "required": true,
              "description": "消费到的部署任务消息"
            }
          ],
          "returns": {
            "type": "None"
          },
          "description": "处理从 RabbitMQ 消费的部署任务消息，执行完整部署流程",
          "errors": [
            "SSHConnectionError",
            "FileUploadError",
            "CommandExecutionError",
            "RollbackError"
          ]
        },
        {
          "name": "cancel_deployment",
          "signature": "cancel_deployment(task_id: str) -> bool",
          "precondition": "部署任务正在运行中 (status=RUNNING)",
          "postcondition": "部署任务被标记为取消，远程执行清理操作（如删除临时文件），状态置为 CANCELLED",
          "parameters": [
            {
              "name": "task_id",
              "type": "str",
              "required": true,
              "description": "要取消的部署任务 ID"
            }
          ],
          "returns": {
            "type": "bool",
            "description": "是否成功取消"
          },
          "description": "取消一个正在运行的部署任务",
          "errors": [
            "TaskNotFoundError",
            "CancelNotAllowedError"
          ]
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": []
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "部署任务消费",
      "endpoint": "RabbitMQ Queue: deploy.tasks",
      "type": "message_consumer",
      "description": "消费 RabbitMQ 中的部署任务消息，触发部署流水线",
      "protocol": "AMQP 0-9-1",
      "request": {
        "body": {
          "schema": "DeployTaskMessage",
          "example": {
            "task_id": "abc-123",
            "project_id": "proj-xyz",
            "version": "1.2.3",
            "environment": "production",
            "file_path": "/builds/package.tar.gz",
            "target_server_ip": "10.0.0.5",
            "target_server_user": "deployer",
            "target_auth_method": "key",
            "target_auth_secret_path": "/etc/secrets/deploy_key",
            "deploy_dir": "/var/www/app"
          }
        }
      },
      "response": {
        "ack": "basic_ack 或 basic_nack，成功则 ack，失败则 nack 加死信处理",
        "body": {
          "description": "无响应体，仅通过 RabbitMQ 的 ack/nack 机制反馈处理结果"
        }
      },
      "errors": [
        {
          "code": "MESSAGE_PARSE_ERROR",
          "message": "消息格式无效",
          "http_status": null,
          "description": "无法解析消息体"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": [
        "CTR-007"
      ]
    },
    {
      "id": "IF-002",
      "name": "推送部署日志",
      "endpoint": "WebSocket: /ws/logs/{task_id}",
      "type": "websocket",
      "description": "通过 WebSocket 向客户端推送部署过程的实时日志",
      "protocol": "WebSocket (RFC 6455)",
      "request": {
        "description": "客户端需连接至该路径，并通过 task_id 标识任务"
      },
      "response": {
        "body": {
          "schema": "DeployLogMessage",
          "example": {
            "task_id": "abc-123",
            "timestamp": "2025-03-27T10:30:00Z",
            "level": "INFO",
            "message": "Starting file upload..."
          }
        }
      },
      "errors": [
        {
          "code": "WS_CONNECTION_FAILED",
          "message": "WebSocket 连接失败",
          "http_status": null,
          "description": "无法建立连接，可能因认证或网络问题"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": [
        "CTR-007"
      ]
    }
  ],
  "business_rules": [
    {
