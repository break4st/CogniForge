  "module_boundary": {
    "in_scope": [
      "SSH 会话的建立、保持与销毁（基于密码或密钥认证）",
      "连接池的管理：包括最大连接数、空闲超时回收",
      "通过 SSH 执行远程 shell 命令并返回结果",
      "SFTP 文件上传/下载（支持流式或完整读写）",
      "连接连通性测试（专用于环境验证）",
      "敏感认证材料（密码/密钥）的密文传递与解密调度（依赖凭证加密服务）"
    ],
    "out_of_scope": [
      "凭证的持久化存储与主密码派生（由凭证加密存储服务负责）",
      "业务语义上的「部署流程编排」（由部署执行服务负责）",
      "环境定义（主机、端口、用户等元数据）的 CRUD（由环境配置服务负责）",
      "直接面向前端的 WebSocket 推送（由网关层 WebSocket 管理服务负责）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [
      "CTR-002",
      "CTR-003"
    ],
    "owned_data_models": [
      "DM-003",
      "DM-004"
    ],
    "consumed_data_models": [
      "DM-001",
      "DM-002"
    ]
  },
  "overview": {
    "description": "后端服务，统一管理远程SSH和SFTP连接，提供连接、命令执行、文件上传下载功能。",
    "dependencies": [
      "凭证加密存储服务",
      "环境配置服务"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "paramiko",
      "cryptography",
      "asyncio"
    ]
  },
