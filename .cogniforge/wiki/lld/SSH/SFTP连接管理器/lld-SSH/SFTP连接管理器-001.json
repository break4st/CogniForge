  "data_models": [
    {
      "id": "DM-001",
      "name": "环境连接信息",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environment"
      },
      "description": "来自环境配置服务的环境信息子集，包含SSH连接所需的主机、端口、用户名等",
      "fields": [
        {
          "name": "id",
          "type": "int",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "远程主机IP或域名"
        },
        {
          "name": "port",
          "type": "int",
          "required": true,
          "description": "SSH端口"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "SSH用户名"
        },
        {
          "name": "credential_id",
          "type": "int",
          "required": true,
          "description": "关联凭证ID"
        },
        {
          "name": "status",
          "type": "string",
          "required": false,
          "description": "环境状态"
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "由环境配置服务管理",
        "update": "由环境配置服务管理",
        "delete": "由环境配置服务管理",
        "retention": "永久"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "凭证密文",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "credentials"
      },
      "description": "用于SSH认证的凭证加密存储信息",
      "fields": [
        {
          "name": "id",
          "type": "int",
          "required": true,
          "description": "凭证ID"
        },
        {
          "name": "auth_type",
          "type": "string",
          "required": true,
          "description": "认证类型：password 或 private_key"
        },
        {
          "name": "encrypted_credential",
          "type": "binary",
          "required": true,
          "description": "加密后的凭证密文"
        },
        {
          "name": "salt",
          "type": "binary",
          "required": false,
          "description": "PBKDF2盐值"
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "由凭证服务管理",
        "update": "由凭证服务管理",
        "delete": "由凭证服务管理",
        "retention": "永久"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "连接池配置",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "SSH连接池的运行时配置参数",
      "fields": [
        {
          "name": "max_connections",
          "type": "int",
          "required": true,
          "description": "最大连接数"
        },
        {
          "name": "idle_timeout",
          "type": "int",
          "required": true,
          "description": "空闲超时时间（秒）"
        },
        {
          "name": "connection_timeout",
          "type": "int",
          "required": true,
          "description": "连接建立超时（秒）"
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "运行时加载",
        "update": "配置热更新",
        "delete": "服务关闭时清理",
        "retention": "内存"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-004",
      "name": "SSH连接对象",
      "type": "runtime",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "表示一个活跃的SSH连接及其元数据",
      "fields": [
        {
          "name": "connection_id",
          "type": "string",
          "required": true,
          "description": "连接唯一标识"
        },
        {
          "name": "environment_id",
          "type": "int",
          "required": true,
          "description": "关联环境ID"
        },
        {
          "name": "client",
          "type": "object",
          "required": true,
          "description": "paramiko SSHClient 实例"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "last_used",
          "type": "datetime",
          "required": true,
          "description": "最后使用时间"
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "连接建立时创建",
        "update": "每次使用更新last_used",
        "delete": "连接关闭或超时时销毁",
        "retention": "内存"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "建立连接",
      "type": "api",
      "endpoint": "/api/v1/connections",
      "method": "POST",
      "request": {
        "body": {
          "environment_id": "int",
          "credential_id": "int"
        }
      },
      "response": {
        "body": {
          "connection_id": "string",
          "status": "string"
        }
      },
      "errors": [
        "400 参数错误",
        "401 认证失败",
        "404 环境或凭证不存在",
        "503 连接超时"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "description": "建立新的SSH连接并返回连接ID"
    },
    {
      "id": "IF-002",
      "name": "执行命令",
      "type": "api",
      "endpoint": "/api/v1/connections/{connection_id}/exec",
      "method": "POST",
      "request": {
        "path": {
          "connection_id": "string"
        },
        "body": {
          "command": "string"
        }
      },
      "response": {
        "body": {
          "exit_code": "int",
          "stdout": "string",
          "stderr": "string"
        }
      },
      "errors": [
        "400 参数错误",
        "404 连接不存在",
        "408 命令执行超时",
        "500 执行失败"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "description": "在指定SSH连接上执行命令"
    },
    {
      "id": "IF-003",
      "name": "上传文件",
      "type": "api",
      "endpoint": "/api/v1/connections/{connection_id}/upload",
      "method": "POST",
      "request": {
        "path": {
          "connection_id": "string"
        },
        "body": {
          "remote_path": "string",
          "file": "binary"
        }
      },
      "response": {
        "body": {
          "status": "string",
          "bytes_transferred": "int"
        }
      },
      "errors": [
        "400 参数错误",
        "404 连接不存在",
        "413 文件过大",
        "500 上传失败"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "description": "通过SFTP上传文件到远程主机"
    },
    {
      "id": "IF-004",
      "name": "下载文件",
      "type": "api",
      "endpoint": "/api/v1/connections/{connection_id}/download",
      "method": "GET",
      "request": {
        "path": {
          "connection_id": "string"
        },
        "query": {
          "remote_path": "string"
        }
      },
      "response": {
        "body": {
          "file": "binary",
          "filename": "string"
        }
      },
      "errors": [
        "400 参数错误",
        "404 文件或连接不存在",
        "500 下载失败"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "description": "通过SFTP从远程主机下载文件"
    },
    {
      "id": "IF-005",
      "name": "测试连接",
      "type": "api",
      "endpoint": "/api/v1/connections/test",
      "method": "POST",
      "request": {
        "body": {
          "environment_id": "int",
          "credential_id": "int"
        }
      },
      "response": {
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "errors": [
        "400 参数错误",
        "401 认证失败",
        "404 环境或凭证不存在",
        "503 连接超时"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "description": "测试SSH连接是否可达"
    },
    {
      "id": "IF-006",
      "name": "关闭连接",
      "type": "api",
      "endpoint": "/api/v1/connections/{connection_id}",
      "method": "DELETE",
      "request": {
        "path": {
          "connection_id": "string"
        }
      },
      "response": {
        "body": {
          "status": "string"
        }
      },
      "errors": [
        "404 连接不存在",
        "500 关闭失败"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "description": "关闭并清理SSH连接"
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "ConnectionManager",
      "object_type": "service",
      "description": "核心服务，管理SSH连接池和生命周期",
      "methods": [
        "connect(environment_id, credential_id) -> connection_id",
        "disconnect(connection_id)",
        "get_connection(connection_id) -> SSHClient",
        "health_check()"
      ]
    },
    {
      "id": "DO-002",
      "name": "CommandExecutor",
      "object_type": "service",
      "description": "负责通过SSH执行命令并收集输出",
      "methods": [
        "execute(connection_id, command, timeout=30) -> (exit_code, stdout, stderr)"
      ]
    },
    {
      "id": "DO-003",
      "name": "FileTransfer",
      "object_type": "service",
      "description": "处理SFTP文件上传和下载",
      "methods": [
        "upload(connection_id, local_data, remote_path)",
        "download(connection_id, remote_path) -> data"
      ]
    },
    {
      "id": "DO-004",
      "name": "ConnectionTester",
      "object_type": "service",
      "description": "用于测试SSH连接是否成功",
      "methods": [
        "test(environment_id, credential_id) -> bool"
      ]
    },
    {
      "id": "DO-005",
      "name": "CredentialResolver",
      "object_type": "service",
      "description": "解密凭证，提供明文凭据",
      "methods": [
        "resolve_password(credential_id) -> str",
        "resolve_key(credential_id) -> PKey"
      ]
    },
    {
      "id": "DO-006",
      "name": "ConnectionPool",
      "object_type": "store",
      "description": "维护活跃连接的内存池",
      "methods": [
        "add(connection_id, client)",
        "remove(connection_id)",
        "get(connection_id) -> client",
        "reap_idle()"
      ]
    },
    {
      "id": "DO-007",
      "name": "SSHAdapter",
      "object_type": "service",
      "description": "封装paramiko库，处理认证和连接建立",
      "methods": [
        "create_client() -> SSHClient"
      ]
    },
    {
      "id": "DO-008",
      "name": "ConfigProvider",
      "object_type": "service",
      "description": "提供连接池配置参数",
      "methods": [
        "get_pool_config() -> ConnectionPoolConfig"
      ]
    },
    {
      "id": "DO-009",
      "name": "EventHandler",
      "object_type": "service",
      "description": "处理连接事件，如关闭、错误等",
      "methods": [
        "on_connection_lost(connection_id)",
        "on_error(connection_id, error)"
      ]
    },
    {
      "id": "DO-010",
      "name": "ApiMapper",
      "object_type": "service",
      "description": "负责API请求的验证和格式转换",
      "methods": [
        "validate_request(data)",
        "format_response(data)"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "SSH连接服务-部署执行服务契约",
      "description": "部署执行服务调用本服务进行远程命令执行和文件传输的约定",
      "provider": "SSH/SFTP连接管理器",
      "consumer": "部署执行服务",
      "interfaces": [
        "IF-002",
        "IF-003",
        "IF-004"
      ],
      "preconditions": [
        "调用方已获得有效的连接ID",
        "环境配置和凭证已就绪"
      ],
      "postconditions": [
        "命令执行完成并返回结果",
        "文件传输完成"
      ],
      "invariants": [
        "连接ID有效且未超时",
        "SFTP会话在文件传输期间保持打开"
      ],
      "error_scenarios": [
        {
          "error": "连接不存在",
          "handling": "返回404，调用方应重新建立连接"
        },
        {
          "error": "认证失败",
          "handling": "返回401，提示检查凭证"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "rule": "连接池最大连接数不可超过配置值",
      "type": "invariant",
      "enforcement": "连接建立前检查，超过时拒绝并返回503"
    },
    {
      "id": "BR-002",
      "rule": "空闲连接超过配置时间自动关闭",
      "type": "invariant",
      "enforcement": "后台任务定期扫描，关闭空闲连接"
    },
    {
      "id": "BR-003",
      "rule": "凭证解密失败时禁止建立连接",
      "type": "invariant",
      "enforcement": "在connect流程中，解密失败直接抛出异常"
    }
  ],
  "error_handling": {
    "strategy": "统一错误码返回，所有异常转换为HTTP状态码和JSON错误体",
    "categories": [
      {
        "type": "认证错误",
        "status_code": 401,
        "retry": "否",
        "log_level": "WARN"
      },
      {
        "type": "网络超时",
        "status_code": 503,
        "retry": "是",
        "log_level": "ERROR"
      },
      {
        "type": "资源不存在",
        "status_code": 404,
        "retry": "否",
        "log_level": "INFO"
      },
      {
        "type": "内部服务错误",
        "status_code": 500,
        "retry": "否",
        "log_level": "ERROR"
      }
    ]
  },
  "workflow": {
    "steps": [
      {
        "action": "接收API请求并校验参数",
        "description": "ApiMapper验证请求格式和必填字段",
        "input": "HTTP请求",
        "output": "结构化请求数据或错误"
      },
      {
        "action": "获取加密凭证",
        "description": "CredentialResolver调用凭证服务解密密码或私钥",
        "input": "credential_id",
        "output": "明文凭据"
      },
      {
        "action": "建立SSH连接",
        "description": "SSHAdapter使用paramiko创建连接，ConnectionPool管理连接对象",
        "input": "环境信息、凭据",
        "output": "connection_id"
      },
      {
        "action": "执行核心操作",
        "description": "根据接口类型调度CommandExecutor或FileTransfer",
        "input": "connection_id，操作参数",
        "output": "操作结果"
      }
    ],
    "trigger": "外部API调用",
    "description": "SSH连接和操作的标准流程"
  }
}