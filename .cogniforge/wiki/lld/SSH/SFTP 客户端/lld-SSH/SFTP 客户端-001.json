    {
      "id": "IF-003",
      "name": "ISftpClient",
      "type": "service",
      "description": "SFTP 文件传输接口",
      "method": "混合",
      "endpoint": {
        "uri": "",
        "protocol": "in-process",
        "authentication": "none",
        "rate_limiting": "none"
      },
      "request": {
        "headers": {},
        "parameters": {},
        "body": {}
      },
      "response": {
        "headers": {},
        "status_codes": {},
        "body": {
          "description": "方法返回 void 或 string",
          "schema": {},
          "examples": []
        }
      },
      "contract_id": "",
      "methods": [
        {
          "name": "uploadFile",
          "description": "上传文件到远程服务器",
          "parameters": [
            {
              "name": "localPath",
              "type": "string",
              "required": true,
              "description": "本地文件路径"
            },
            {
              "name": "remotePath",
              "type": "string",
              "required": true,
              "description": "远程目标路径"
            },
            {
              "name": "progressCallback",
              "type": "(event: ProgressEvent) => void",
              "required": false,
              "description": "进度回调函数"
            }
          ],
          "return_type": "Promise<void>",
          "throws": ["SFTPUploadError", "SSHConnectionError"],
          "async": true,
          "idempotency": false
        },
        {
          "name": "downloadFile",
          "description": "从远程服务器下载文件",
          "parameters": [
            {
              "name": "remotePath",
              "type": "string",
              "required": true,
              "description": "远程文件路径"
            },
            {
              "name": "localPath",
              "type": "string",
              "required": true,
              "description": "本地保存路径"
            },
            {
              "name": "progressCallback",
              "type": "(event: ProgressEvent) => void",
              "required": false,
              "description": "进度回调函数"
            }
          ],
          "return_type": "Promise<void>",
          "throws": ["SFTPDownloadError", "SSHConnectionError"],
          "async": true,
          "idempotency": false
        }
      ],
      "schema_version": "1.0",
      "status": "active",
      "version": 1,
      "source_components": ["CMP-001"],
      "source_contracts": ["CTR-001"],
      "constraints": [
        "必须在 SSH 连接建立后使用",
        "文件路径必须是绝对路径"
      ],
      "lifecycle": {
        "create": "通过 ISshClient 获取 SFTP 会话",
        "update": "无状态",
        "delete": "操作完成后释放"
      }
    },
