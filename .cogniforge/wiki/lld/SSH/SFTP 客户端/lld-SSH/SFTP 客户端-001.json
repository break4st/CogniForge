  "data_models": [
    {
      "id": "DM-001",
      "name": "SSHConnectionConfig",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "SSH 连接配置参数",
      "fields": [
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "远程主机 IP 或域名"
        },
        {
          "name": "port",
          "type": "number",
          "required": true,
          "description": "SSH 端口，默认 22"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "登录用户名"
        },
        {
          "name": "password",
          "type": "string",
          "required": false,
          "description": "密码认证时使用"
        },
        {
          "name": "privateKey",
          "type": "string",
          "required": false,
          "description": "私钥内容（PEM 格式），用于密钥认证"
        },
        {
          "name": "passphrase",
          "type": "string",
          "required": false,
          "description": "私钥密码"
        },
        {
          "name": "connectTimeout",
          "type": "number",
          "required": false,
          "description": "连接超时毫秒数，默认 10000"
        },
        {
          "name": "readyTimeout",
          "type": "number",
          "required": false,
          "description": "等待 SSH 协议就绪超时毫秒，默认 20000"
        },
        {
          "name": "keepaliveInterval",
          "type": "number",
          "required": false,
          "description": "心跳间隔毫秒，默认 0 表示不开启"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
