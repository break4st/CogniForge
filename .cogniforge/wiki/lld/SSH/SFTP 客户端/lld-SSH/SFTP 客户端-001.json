  "interfaces": [
    {
      "id": "IF-001",
      "name": "ISshClient",
      "type": "service",
      "description": "SSH 客户端主接口，提供连接、断开、命令执行",
      "method": "混合",
      "endpoint": {
        "uri": "",
        "protocol": "in-process",
        "authentication": "none",
        "rate_limiting": "none"
      },
      "request": {
        "headers": {},
        "parameters": {},
        "body": {}
      },
      "response": {
        "headers": {},
        "status_codes": {},
        "body": {
          "description": "返回 Promise<SSHCommandResult> 或 void",
          "schema": {
            "type": "object",
            "properties": {
              "stdout": {
                "type": "string"
              },
              "stderr": {
                "type": "string"
              },
              "exitCode": {
                "type": "number",
                "nullable": true
              },
              "signal": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "examples": []
        }
      },
      "contract_id": "",
      "methods": [
        {
          "name": "connect",
          "description": "建立 SSH 连接",
          "parameters": [
            {
              "name": "config",
              "type": "SSHConnectionConfig",
              "required": true,
              "description": "连接配置"
            }
          ],
          "return_type": "Promise<void>",
          "throws": ["SSHConnectionError", "SSHAuthenticationError"],
          "async": true,
          "idempotency": false
        },
        {
          "name": "disconnect",
          "description": "断开 SSH 连接",
          "parameters": [],
          "return_type": "Promise<void>",
          "throws": ["SSHDisconnectError"],
          "async": true,
          "idempotency": false
        },
        {
          "name": "exec",
          "description": "执行远程命令",
          "parameters": [
            {
              "name": "command",
              "type": "string",
              "required": true,
              "description": "要执行的命令"
            },
            {
              "name": "options",
              "type": "ExecOptions",
              "required": false,
              "description": "执行选项（超时等）"
            }
          ],
          "return_type": "Promise<SSHCommandResult>",
          "throws": ["SSHExecError", "SSHTimeoutError"],
          "async": true,
          "idempotency": false
        }
      ],
      "schema_version": "1.0",
      "status": "active",
      "version": 1,
      "source_components": ["CMP-001"],
      "source_contracts": ["CTR-001"],
      "constraints": [
        "仅支持密码和密钥认证",
        "必须调用 connect 后才能执行其他操作"
      ],
      "lifecycle": {
        "create": "通过 ISshClientFactory.createClient 创建",
        "update": "状态变更通过方法调用实现",
        "delete": "调用 disconnect 并释放资源"
      }
    },
