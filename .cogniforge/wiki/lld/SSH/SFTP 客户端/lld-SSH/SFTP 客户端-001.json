  "business_rules": [],
  "error_handling": {
    "strategy": "fail-fast",
    "exceptions": [
      {
        "name": "SSHConnectionError",
        "description": "无法建立 SSH 连接",
        "http_code": 502,
        "retryable": true,
        "message_template": "SSH connection failed: {reason}"
      },
      {
        "name": "SSHAuthenticationError",
        "description": "SSH 认证失败",
        "http_code": 401,
        "retryable": false,
        "message_template": "SSH authentication failed for user {username}"
      },
      {
        "name": "SSHExecError",
        "description": "远程命令执行失败",
        "http_code": 500,
        "retryable": true,
        "message_template": "Command execution failed: {command}"
      },
      {
        "name": "SSHTimeoutError",
        "description": "SSH 操作超时",
        "http_code": 504,
        "retryable": true,
        "message_template": "SSH operation timed out"
      },
      {
        "name": "SSHDisconnectError",
        "description": "断开连接时出错",
        "http_code": 500,
        "retryable": false,
        "message_template": "SSH disconnect error: {reason}"
      },
      {
        "name": "SFTPUploadError",
        "description": "SFTP 上传失败",
        "http_code": 500,
        "retryable": true,
        "message_template": "SFTP upload failed: {reason}"
      },
      {
        "name": "SFTPDownloadError",
        "description": "SFTP 下载失败",
        "http_code": 500,
        "retryable": true,
        "message_template": "SFTP download failed: {reason}"
      }
    ]
  }
