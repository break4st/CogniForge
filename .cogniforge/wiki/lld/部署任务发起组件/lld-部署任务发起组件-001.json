  "module_boundary": {
    "in_scope": [
      "提供部署任务发起页面",
      "文件/目录选择交互",
      "目标环境下拉选择（从全局环境数据获取）",
      "调用部署执行服务API（CTR-009）",
      "部署成功跳转至实时日志页面"
    ],
    "out_of_scope": [
      "环境列表的增删改管理",
      "部署任务的实际执行与调度",
      "实时日志的显示与控制台功能",
      "部署历史查询与回滚操作"
    ],
    "owned_components": [
      "CMP-101"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-009"
    ],
    "owned_data_models": [
      "DM-001"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "部署任务发起组件是一个React页面，整合文件选择器、环境选择器与部署按钮，用户可一键发起异步部署任务，成功后跳转至实时日志页面跟踪部署进度。",
    "dependencies": [
      "环境列表与配置组件（提供全局环境数据）",
      "API路由代理（转发部署请求）",
      "实时日志与控制台组件（接收跳转）"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design",
      "React Router v6"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": [
        "CMP-101"
      ],
      "sad_contract_ids": [
        "CTR-009"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001"
        ],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "DeployFormStore",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "部署表单页面局部状态",
      "fields": [
        {
          "name": "environment_id",
          "type": "string",
          "required": true,
          "description": "选中的环境ID"
        },
        {
          "name": "file_path",
          "type": "string",
          "required": true,
          "description": "选中的本地文件/目录路径"
        },
        {
          "name": "file_type",
          "type": "string (zip/tar.gz/directory)",
          "required": true,
          "description": "文件类型，自动判断"
        },
        {
          "name": "submitting",
          "type": "boolean",
          "required": true,
          "description": "是否正在提交部署请求"
        },
        {
          "name": "error",
          "type": "string|null",
          "required": false,
          "description": "提交失败时的错误信息"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-101"
      ],
      "source_contracts": [
        "CTR-009"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "页面挂载时初始化",
        "update": "用户交互或API调用中更新字段",
        "delete": "页面卸载时销毁",
        "retention": "无"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "部署任务发起页面",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-009",
      "provider_component_id": "CMP-101",
      "method": "frontend",
      "endpoint": "/deploy/new",
      "description": "提供发起部署任务的用户界面，包含文件选择、环境选择与提交按钮。",
      "parameters": [],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [],
      "auth": {
        "required": true,
        "policy": "operator"
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-003"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "name": "必填字段校验",
      "description": "环境ID和文件路径均为必填项，提交前进行前端校验，空值阻止提交并提示。",
      "condition": "environment_id为空或file_path为空",
      "action": "阻止表单提交，显示相应字段的错误提示信息"
    },
    {
      "id": "BR-002",
      "name": "文件类型自动判断",
      "description": "根据用户选择的文件路径判断文件类型（zip/tar.gz/directory），前端自动识别并附加到请求体中。",
      "condition": "用户选择文件后",
      "action": "根据文件扩展名或系统调用判断类型，更新到表单状态"
    },
    {
      "id": "BR-003",
      "name": "部署成功后跳转",
      "description": "部署请求成功返回后，从响应中提取deployment_id，跳转到实时日志页面。",
      "condition": "API返回200且包含deployment_id",
      "action": "调用React Router的navigate方法跳转到/deploy/logs/{deployment_id}"
    }
  ],
  "invariants": [
    {
      "id": "INV-001",
      "description": "表单提交中(submitting为true)时，提交按钮禁用，防止重复提交",
      "scope": "DeployInitiatorPage组件状态",
      "enforcement": "前端按钮disabled属性绑定submitting状态"
    },
    {
      "id": "INV-002",
      "description": "environment_id必须存在于全局环境列表中（由父组件传递的环境列表）",
      "scope": "DeployInitiatorPage接收的props",
      "enforcement": "该不变量由上游组件保证，前端仅做选项展示，不二次验证"
    }
  ],
  "state_design": {
    "description": "DeployInitiatorPage组件内部状态设计，使用React useState管理。",
    "states": [
      {
        "name": "deployForm",
        "type": "object",
        "description": "存放表单字段值：environment_id, file_path, file_type",
        "initial_value": "{ environment_id: '', file_path: '', file_type: '' }"
      },
      {
        "name": "submitting",
        "type": "boolean",
        "description": "是否正在提交部署请求",
        "initial_value": false
      },
      {
        "name": "error",
        "type": "string|null",
        "description": "提交失败时的错误信息",
        "initial_value": null
      }
    ],
    "transitions": [
      {
        "event": "环境选择变更",
        "from": "*",
        "to": "更新state.deployForm.environment_id",
        "guards": [],
        "actions": ["更新environment_id字段值"]
      },
      {
        "event": "文件选择变更",
        "from": "*",
        "to": "更新state.deployForm.file_path和file_type",
        "guards": [],
        "actions": ["更新file_path字段值", "根据文件路径判断file_type并更新"]
      },
      {
        "event": "发起部署提交",
        "from": "submitting为false",
        "to": "submitting变为true",
        "guards": ["表单必填字段非空"],
        "actions": ["调用部署API", "处理响应或错误"]
      },
      {
        "event": "部署成功",
        "from": "submitting为true",
        "to": "submitting变为false，跳转页面",
        "guards": [],
        "actions": ["清除错误", "执行跳转"]
      },
      {
        "event": "部署失败",
        "from": "submitting为true",
        "to": "submitting变为false，显示错误",
        "guards": [],
        "actions": ["更新error字段", "显示错误提示"]
      }
    ]
  },
  "route_design": {
    "base_path": "/deploy/new",
    "description": "部署任务发起页面的路由配置，由React Router管理。",
    "routes": [
      {
        "path": "/deploy/new",
        "component": "DeployInitiatorPage",
        "exact": true,
        "guards": ["authGuard"],
        "meta": {
          "title": "新建部署"
        }
      }
    ],
    "navigation": {
      "from": ["环境列表页面", "项目详情页面"],
      "to": ["/deploy/logs/:deploymentId"],
      "on_complete": "部署成功后，使用navigate(`/deploy/logs/${deploymentId}`)"
    }
  },
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "正常部署发起流程",
      "description": "用户进入页面，选择环境和文件，点击提交，成功跳转。",
      "steps": [
        {
          "step": 1,
          "actor": "user",
          "action": "访问/deploy/new"
        },
        {
          "step": 2,
          "actor": "system",
          "action": "渲染表单，环境列表通过props传入"
        },
        {
          "step": 3,
          "actor": "user",
          "action": "从下拉列表选择目标环境"
        },
        {
          "step": 4,
          "actor": "user",
          "action": "点击文件选择器，浏览并选择本地文件或目录"
        },
        {
          "step": 5,
          "actor": "system",
          "action": "自动识别文件类型并更新表单状态"
        },
        {
          "step": 6,
          "actor": "user",
          "action": "点击“开始部署”按钮"
        },
        {
          "step": 7,
          "actor": "system",
          "action": "前端校验非空，通过后调用部署API"
        },
        {
          "step": 8,
          "actor": "system",
          "action": "API返回200，获取deployment_id"
        },
        {
          "step": 9,
          "actor": "system",
          "action": "跳转到/deploy/logs/{deployment_id}"
        }
      ],
      "alternative_flows": [
        {
          "id": "ALT-001",
          "condition": "表单校验失败",
          "steps": [
            {
              "step": "7a",
              "action": "显示具体字段错误提示，不发起API调用"
            }
          ]
        },
        {
          "id": "ALT-002",
          "condition": "API调用失败",
          "steps": [
            {
              "step": "8a",
              "actor": "system",
              "action": "显示错误提示（网络错误或业务错误），停止loading状态"
            }
          ]
        }
      ]
    }
  ],
  "api_integration": {
    "consumed_apis": [
      {
        "contract_id": "CTR-009",
        "name": "Deploy Execution Service",
        "endpoint": "POST /api/deploy",
        "description": "提交部署任务",
        "request_mapping": "deployForm object, plus file_type",
        "response_mapping": "deployment_id for redirect",
        "error_handling": "根据HTTP状态码显示不同错误信息",
        "timeout_ms": 30000,
        "retry_policy": "no retry"
      }
    ],
    "provided_apis": []
  },
  "error_handling": {
    "strategy": "表单前端校验阻止空提交；API调用统一捕获网络错误与业务错误码，使用Ant Design Message全局提示用户。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "当环境ID或文件路径非法时，API返回400，前端提示具体字段错误。"
      },
      {
        "code": "500",
        "name": "服务器内部错误",
        "description": "服务器异常或部署服务不可用，提示用户稍后重试。"
      },
      {
        "code": "NETWORK",
        "name": "网络错误",
        "description": "客户端无法连接服务器，提示检查网络。"
      }
    ]
  },
  "workflow": {
    "name": "部署发起流程",
    "description": "用户填充部署参数后提交，前端校验并调用API，成功后跳转。",
    "steps": [
      {
        "order": 1,
        "name": "表单校验",
        "action": "校验 environment_id 与 file_path 非空",
        "timeout_seconds": 0,
        "on_failure": "提示用户完善必填项"
      },
      {
        "order": 2,
        "name": "发送部署请求",
        "action": "POST /api/deploy 携带 JSON 请求体",
        "timeout_seconds": 30,
        "on_failure": "根据错误码分类提示，恢复按钮可点击状态"
      },
      {
        "order": 3,
        "name": "跳转日志页",
        "action": "从响应中提取 deployment_id，使用React Router跳转到 /deploy/logs/{deployment_id}",
        "timeout_seconds": 0,
        "on_failure": "若跳转失败，回退到首页并提示"
      }
    ],
    "retry_strategy": {
      "max_retries": 0,
      "retry_interval_seconds": 0,
      "retryable_errors": [],
      "non_retryable_errors": []
    }
  },
  "component_tree": [
    {
      "name": "DeployInitiatorPage",
      "path": "/deploy/new",
      "description": "部署任务发起页面的根容器，管理表单状态和提交逻辑。",
      "props": [
        {
          "name": "environmentList",
          "type": "Array<{id: string, name: string}>",
          "required": true,
          "description": "全局环境列表，由父组件传入"
        }
      ],
      "events": [],
      "state": [
        {
          "name": "deployForm",
          "type": "object",
          "description": "{ environment_id: '', file_path: '', file_type: '' }"
        },
        {
          "name": "submitting",
          "type": "boolean"
        },
        {
          "name": "error",
          "type": "string|null"
        }
      ],
      "children": [
        {
          "name": "EnvironmentSelector",
          "description": "环境选择器，Ant Design Select组件",
          "props": [
            {
              "name": "options",
              "type": "Array<{value: string, label: string}>",
              "description": "环境列表选项"
            },
            {
              "name": "value",
              "type": "string",
              "description": "当前选中的环境ID"
            },
            {
              "name": "onChange",
              "type": "function",
              "description": "选中环境时的回调"
            }
          ]
        },
        {
          "name": "FilePicker",
          "description": "文件/目录选择组件，使用Ant Design Upload或自定义input file",
          "props": [
            {
              "name": "value",
              "type": "string",
              "description": "文件路径"
            },
            {
              "name": "onChange",
              "type": "function",
              "description": "文件选择变更回调，需提取路径和判断类型"
            }
          ]
        },
        {
          "name": "DeployButton",
          "description": "部署提交按钮，Ant Design Button",
          "props": [
            {
              "name": "disabled",
              "type": "boolean",
              "description": "提交中或校验未通过时禁用"
            },
            {
              "name": "loading",
              "type": "boolean",
              "description": "提交中显示loading状态"
            },
            {
              "name": "onClick",
              "type": "function",
              "description": "点击提交处理函数"
            }
          ]
        }
      ]
    }
  ]
}