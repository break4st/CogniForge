  "data_models": [
    {
      "id": "DM-001",
      "name": "DeploymentLogEntry",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "单条日志消息在内存中的结构，源自 WebSocket log/status 类型消息。",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "唯一标识，前端生成或后端提供 message_id"
        },
        {
          "name": "type",
          "type": "string",
          "required": true,
          "description": "枚举 \"log\"|\"status\""
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "日志正文或状态描述"
        },
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "ISO 时间戳字符串，用于显示"
        },
        {
          "name": "level",
          "type": "string",
          "required": false,
          "description": "日志级别 \"info\"|\"error\"|\"warn\"，默认为 info"
        }
      ],
      "source_requirements": [
        "REQ-003",
        "REQ-004"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-010"
      ],
      "constraints": [
        "内存对象，不持久化"
      ],
      "lifecycle": {
        "create": "WebSocket 消息到达时创建",
        "update": "不更新",
        "delete": "页面卸载时清空数组",
        "retention": "页面存活期间"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "LogSessionState",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "当前 WebSocket 连接与部署任务的状态元数据。",
      "fields": [
        {
          "name": "deployment_id",
          "type": "string",
          "required": true,
          "description": "部署任务ID"
        },
        {
          "name": "connection_status",
          "type": "string",
          "required": true,
          "description": "connecting|open|closed|error"
        },
        {
          "name": "deployment_status",
          "type": "string",
          "required": true,
          "description": "running|success|failed|timeout|unknown"
        },
        {
          "name": "error_message",
          "type": "string",
          "required": false,
          "description": "最近一次连接或业务错误描述"
        },
        {
          "name": "auto_scroll",
          "type": "boolean",
          "required": false,
          "description": "是否自动滚动到底部，默认 true"
        },
        {
          "name": "filter_level",
          "type": "string",
          "required": false,
          "description": "当前过滤的日志级别，为空表示不过滤"
        }
      ],
      "source_requirements": [
        "REQ-003",
        "REQ-004"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-010"
      ],
      "constraints": [
        "内存对象，页面级状态"
      ],
      "lifecycle": {
        "create": "部署控制台组件挂载时创建",
        "update": "连接状态或部署状态变化时更新",
        "delete": "组件卸载时清除",
        "retention": "页面存活期间"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
