  "module_boundary": {
    "in_scope": [
      "建立并维护 WebSocket 连接（自动重连、心跳保活）",
      "根据 deployment_id 从统一的 WebSocket 端点接收消息",
      "解析消息类型（log/status），将日志条目逐条追加到控制台视图",
      "支持日志的自动滚动到底部",
      "展示部署任务的整体状态（运行中、成功、失败、超时等）",
      "提供基础的操作：暂停/继续显示、清屏、复制单条日志、导出当前日志为文本文件",
      "部署结束后自动关闭 WebSocket，并显示最终状态卡片",
      "异常情况的 UI 处理：连接断开提示、消息格式错误、长时间无消息超时推测"
    ],
    "out_of_scope": [
      "部署任务的发起、参数配置、回滚操作",
      "日志的存储、检索、归档、持久化",
      "WebSocket 服务器端的权限校验、消息分发",
      "部署执行的具体调度逻辑",
      "其他项目的日志查看或跨部署会话的历史记录"
    ],
    "owned_components": [],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-010"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "前端展示层中的一个独立组件，负责通过 WebSocket 连接部署执行服务，实时接收并渲染部署日志及最终状态。组件只关心前端呈现与用户交互，不涉及后端业务逻辑、持久化或日志的持久存储。",
    "dependencies": [
      "部署执行服务 (CMP-302)"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design",
      "WebSocket API"
    ]
  },
