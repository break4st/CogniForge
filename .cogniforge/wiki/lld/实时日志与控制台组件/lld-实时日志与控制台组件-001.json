  "interfaces": [
    {
      "id": "IF-001",
      "name": "LogConsoleWebSocket",
      "type": "websocket",
      "method": "CONNECT",
      "endpoint": "/ws/deployments/{deployment_id}/log",
      "description": "建立 WebSocket 连接，用于接收部署日志和状态消息。",
      "protocol": "wss",
      "direction": "入站",
      "message_schema": {
        "incoming": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["log", "status"]
            },
            "message_id": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "level": {
              "type": "string",
              "enum": ["info", "warn", "error"]
            },
            "deployment_status": {
              "type": "string",
              "enum": ["running", "success", "failed", "timeout"]
            }
          },
          "required": ["type", "message", "timestamp"]
        }
      },
      "error_handling": {
        "reconnect": {
          "enabled": true,
          "max_attempts": 5,
          "interval_ms": 3000
        },
        "heartbeat": {
          "enabled": true,
          "ping_interval_ms": 30000,
          "pong_timeout_ms": 10000
        },
        "message_validation": {
          "invalid_message_action": "log_and_discard",
          "unknown_type_action": "ignore"
        }
      },
      "contract_version": "1.0",
      "address": "wss://api.example.com",
      "source_requirements": [
        "REQ-003",
        "REQ-004"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-010"
      ]
    },
    {
      "id": "IF-002",
      "name": "LogConsoleAPI",
      "type": "rest",
      "method": "GET",
      "endpoint": "/api/deployments/{deployment_id}/log/latest",
      "description": "获取部署的最新日志快照，用于初始化或离线查看。",
      "protocol": "https",
      "direction": "入站",
      "message_schema": {
        "response": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "timestamp": {
                "type": "string"
              },
              "level": {
                "type": "string"
              }
            }
          }
        }
      },
      "error_handling": {
        "error_responses": {
          "404": "deployment not found",
          "500": "internal server error"
        },
        "timeout_ms": 5000,
        "retry": {
          "max_attempts": 3,
          "interval_ms": 1000
        }
      },
      "contract_version": "1.0",
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-010"
      ]
    }
  ],
  "business_rules": {
    "constraints": [
      "通过 deployment_id 路由到唯一部署实例，确保日志来自正确的部署"
    ],
    "invariants": [
      "WebSocket 连接必须在组件挂载时建立，在组件卸载时关闭。实现：useEffect 返回清理函数中关闭 WebSocket。验证：代码审查 + 自动化测试。",
      "日志消息的 id 必须保持唯一性。实现：使用 UUID v4 生成，或依赖后端提供的 message_id。验证：代码审查。",
      "部署结束后，连接自动关闭，不再接收新消息。实现：收到 status 消息且 deployment_status != 'running' 后，主动关闭 WebSocket。验证：单元测试。",
      "用户操作（暂停、清屏、导出）只影响前端视图，不影响后端状态。实现：所有操作仅修改前端 state。验证：手动测试 + 代码审查。"
    ],
    "error_handling": {
      "strategy": "采用全局错误边界捕获渲染错误，WebSocket 层实现自动重连与心跳监测，API 调用层统一处理 HTTP 错误状态码，用户友好的错误提示，失败时提供重试或手动刷新选项。",
      "websocket_errors": {
        "connection_lost": "显示重连提示，自动重连，超过最大次数后转为错误状态并提示。",
        "message_parse_error": "丢弃错误消息，在控制台日志（浏览器 console）中记录，不影响界面展示。",
        "heartbeat_timeout": "关闭当前连接，自动发起重连。"
      },
      "api_errors": {
        "network_error": "显示网络错误提示，允许用户手动重试。",
        "http_4xx": "显示业务错误信息，引导用户检查权限或配置。",
        "http_5xx": "显示服务器错误提示，自动重试一次，失败后提示稍后再试。"
      }
    }
  },
  "component_tree": {
    "root_component": "LogConsolePage",
    "description": "页面根组件，组合工具栏、日志视图和状态卡片",
    "children": [
      {
        "name": "LogToolbar",
        "props": {
          "onPauseResume": "() => void",
          "onClear": "() => void",
          "onExport": "() => void",
          "autoScroll": "boolean",
          "filterLevel": "string",
          "onAutoScrollToggle": "() => void",
          "onFilterLevelChange": "(level: string) => void"
        }
      },
      {
        "name": "LogView",
        "props": {
          "logs": "DeploymentLogEntry[]",
          "autoScroll": "boolean",
          "onCopyEntry": "(entry: DeploymentLogEntry) => void"
        }
      },
      {
        "name": "DeploymentStatusCard",
        "props": {
          "status": "LogSessionState"
        }
      }
    ]
  },
  "state_design": {
    "component_state": {
      "LogConsolePage": {
        "useState": [
          {
            "name": "logs",
            "type": "DeploymentLogEntry[]",
            "initial": "[]"
          },
          {
            "name": "sessionState",
            "type": "LogSessionState",
            "initial": "{ connection_status: 'connecting', deployment_status: 'unknown', deployment_id: props.deploymentId }"
          },
          {
            "name": "isPaused",
            "type": "boolean",
            "initial": "false"
          },
          {
            "name": "autoScroll",
            "type": "boolean",
            "initial": "true"
          },
          {
            "name": "filterLevel",
            "type": "string | null",
            "initial": "null"
          }
        ],
        "useEffect": [
          {
            "dependency": "[props.deploymentId]",
            "action": "建立 WebSocket 连接，注册消息处理、错误处理、关闭事件；返回清理函数中关闭 WebSocket。"
          },
          {
            "dependency": "[isPaused]",
            "action": "暂停时缓存传入消息，继续时将缓存消息批量添加并清空缓存。"
          },
          {
            "dependency": "[sessionState.deployment_status]",
            "action": "当 deployment_status 为 success/failed/timeout 时，在下一个消息后主动关闭 WebSocket。"
          }
        ],
        "useCallback": [
          {
            "name": "handleMessage",
            "action": "解析消息，创建 DeploymentLogEntry 并追加到 logs（如果未暂停）或缓存（如果暂停）；更新 sessionState 中的连接状态和部署状态。"
          },
          {
            "name": "handleConnectionError",
            "action": "更新 sessionState.connection_status 为 'error'，记录错误信息，触发自动重连逻辑。"
          }
        ],
        "context": null,
        "refs": [
          {
            "name": "logEndRef",
            "type": "HTMLDivElement",
            "purpose": "用于自动滚动到底部"
          }
        ]
      }
    }
  },
  "route_design": {
    "routes": [
      {
        "path": "/deployments/:deploymentId/log",
        "component": "LogConsolePage",
        "exact": true,
        "auth_required": true,
        "roles": ["admin", "developer", "viewer"],
        "lazy_load": false,
        "description": "部署日志控制台页面路由"
      }
    ]
  },
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "日志实时接收与渲染",
      "trigger": "WebSocket 推送 log/status 消息",
      "steps": [
        "WebSocket onmessage 事件触发",
        "调用 handleMessage(messageEvent)",
        "解析 JSON 数据，获取 type, message, timestamp, message_id, level, deployment_status 等字段",
        "如果 isPaused 为 false，则创建 DeploymentLogEntry 对象，追加到 logs 数组末尾",
        "如果 isPaused 为 true，则将消息存入临时缓存队列",
        "如果 autoScroll 为 true，则触发滚动到底部",
        "如果消息中包含 deployment_status 且不等于 'running'，则更新 sessionState.deployment_status 并设置定时器准备关闭 WebSocket"
      ]
    },
    {
      "id": "FLOW-002",
      "name": "暂停/继续日志刷新",
      "trigger": "用户点击暂停/继续按钮",
      "steps": [
        "切换 isPaused 状态",
        "如果从暂停变为继续，将缓存队列中的所有消息解析并追加到 logs，清空缓存"
      ]
    },
    {
      "id": "FLOW-003",
      "name": "导出日志",
      "trigger": "用户点击导出按钮",
      "steps": [
        "将 logs 数组按照时间戳格式化为文本字符串",
        "创建 Blob 并生成下载链接",
        "模拟点击下载"
      ]
    },
    {
      "id": "FLOW-004",
      "name": "WebSocket 连接生命周期",
      "trigger": "组件挂载/卸载 或 连接异常",
      "steps": [
        "组件挂载时使用 wss 协议连接指定 endpoint",
        "连接成功时更新 connection_status 为 'open'",
        "连接断开或出错时更新 connection_status 为 'error' 或 'closed'，并在 UI 上提示",
        "执行自动重连策略（最多5次，间隔3秒）",
        "组件卸载时主动关闭 WebSocket"
      ]
    }
  ],
  "api_integration": {
    "web_socket": {
      "endpoint": "/ws/deployments/{deployment_id}/log",
      "connection": {
        "protocol": "wss",
        "parameters": {
          "deployment_id": "string (路径参数)"
        },
        "headers": {
          "Authorization": "Bearer {token}"
        }
      },
      "message_types": {
        "log": {
          "example": {
            "type": "log",
            "message_id": "uuid",
            "message": "Building image...",
            "timestamp": "2025-02-17T10:30:00Z",
            "level": "info"
          }
        },
        "status": {
          "example": {
            "type": "status",
            "message": "Deployment completed successfully",
            "timestamp": "2025-02-17T10:35:00Z",
            "deployment_status": "success"
          }
        }
      },
      "reconnection": {
        "enabled": true,
        "max_attempts": 5,
        "interval_ms": 3000,
        "backoff_multiplier": 1.5
      },
      "heartbeat": {
        "enabled": true,
        "ping_message": "ping",
        "ping_interval_ms": 30000,
        "pong_timeout_ms": 10000,
        "message_type": "text"
      }
    },
    "rest_api_fallback": {
      "endpoint": "/api/deployments/{deployment_id}/log/latest",
      "method": "GET",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "response": {
        "type": "array",
        "items": {
          "id": "string",
          "type": "string",
          "message": "string",
          "timestamp": "string",
          "level": "string"
        }
      },
      "usage": "WebSocket 连接失败或用户手动刷新时获取最新日志快照"
    }
  }
}