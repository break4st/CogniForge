  "interfaces": [
    {
      "id": "IF-001",
      "name": "encrypt",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-000",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "encrypt",
      "description": "使用 AES-256-CBC 加密明文字符串，返回包含随机 IV 的密文二进制数据",
      "parameters": [
        {
          "name": "plaintext",
          "type": "str",
          "in": "body",
          "required": true,
          "description": "待加密的原始字符串"
        },
        {
          "name": "key",
          "type": "bytes",
          "in": "body",
          "required": true,
          "description": "32 字节 AES 密钥"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "ciphertext": "bytes"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_INPUT",
          "message": "plaintext / key 参数非法"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "plaintext: 长度 > 0",
        "key: 长度 == 32"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
