  "module_boundary": {
    "in_scope": [
      "所有数据库表的定义、初始化、迁移",
      "提供数据层的 CRUD 操作",
      "确保数据加密存储（环境凭据）",
      "提供事务支持"
    ],
    "out_of_scope": [
      "业务规则校验（由应用服务层处理）",
      "加密/解密算法实现（依赖 SecurityService 提供的加密工具）",
      "UI 展示",
      "SSH 连接"
    ],
    "owned_components": ["CMP-001"],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": ["DM-001", "DM-002", "DM-003", "DM-004"],
    "consumed_data_models": []
  },
  "overview": {
    "description": "基于 better-sqlite3 的 SQLite 封装，提供项目、环境、部署记录、主密码等数据的持久化操作。",
    "dependencies": [],
    "tech_stack": ["SQLite", "better-sqlite3"]
  },
  "data_models": [
    {
      "id": "DM-001",
      "type": "table",
      "description": "存储项目信息",
      "fields": [
        {"name": "id", "type": "INTEGER", "constraints": "PRIMARY KEY AUTOINCREMENT"},
        {"name": "name", "type": "TEXT", "constraints": "NOT NULL UNIQUE"},
        {"name": "description", "type": "TEXT", "constraints": ""},
        {"name": "created_at", "type": "TEXT", "constraints": "DEFAULT (datetime('now'))"},
        {"name": "updated_at", "type": "TEXT", "constraints": "DEFAULT (datetime('now'))"}
      ]
    },
    {
      "id": "DM-002",
      "type": "table",
      "description": "存储环境配置信息",
      "fields": [
        {"name": "id", "type": "INTEGER", "constraints": "PRIMARY KEY AUTOINCREMENT"},
        {"name": "project_id", "type": "INTEGER", "constraints": "NOT NULL REFERENCES projects(id) ON DELETE CASCADE"},
        {"name": "name", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "host", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "port", "type": "INTEGER", "constraints": "NOT NULL DEFAULT 22"},
        {"name": "username", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "credential", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "created_at", "type": "TEXT", "constraints": "DEFAULT (datetime('now'))"},
        {"name": "updated_at", "type": "TEXT", "constraints": "DEFAULT (datetime('now'))"}
      ]
    },
    {
      "id": "DM-003",
      "type": "table",
      "description": "存储部署记录",
      "fields": [
        {"name": "id", "type": "INTEGER", "constraints": "PRIMARY KEY AUTOINCREMENT"},
        {"name": "project_id", "type": "INTEGER", "constraints": "NOT NULL REFERENCES projects(id) ON DELETE CASCADE"},
        {"name": "environment_id", "type": "INTEGER", "constraints": "NOT NULL REFERENCES environments(id) ON DELETE SET NULL"},
        {"name": "status", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "start_time", "type": "TEXT", "constraints": ""},
        {"name": "end_time", "type": "TEXT", "constraints": ""},
        {"name": "output", "type": "TEXT", "constraints": ""},
        {"name": "created_at", "type": "TEXT", "constraints": "DEFAULT (datetime('now'))"}
      ]
    },
    {
      "id": "DM-004",
      "type": "table",
      "description": "存储主密码哈希",
      "fields": [
        {"name": "id", "type": "INTEGER", "constraints": "PRIMARY KEY CHECK(id=1)"},
        {"name": "hash", "type": "TEXT", "constraints": "NOT NULL"},
        {"name": "created_at", "type": "TEXT", "constraints": "DEFAULT (datetime('now'))"},
        {"name": "updated_at", "type": "TEXT", "constraints": "DEFAULT (datetime('now'))"}
      ]
    }
  ],
  "connection_contracts": {},
  "interfaces": [
    {
      "name": "initializeDatabase",
      "type": "method",
      "description": "初始化数据库，创建表结构和索引，执行迁移",
      "parameters": [],
      "returns": "void",
      "exceptions": ["DatabaseError"]
    },
    {
      "name": "getProjects",
      "type": "method",
      "description": "获取所有项目列表",
      "parameters": [],
      "returns": "Array<Project>",
      "exceptions": ["DatabaseError"]
    },
    {
      "name": "createProject",
      "type": "method",
      "description": "创建新项目",
      "parameters": ["name", "description"],
      "returns": "Project",
      "exceptions": ["DatabaseError", "ValidationError"]
    },
    {
      "name": "updateProject",
      "type": "method",
      "description": "更新项目信息",
      "parameters": ["id", "name", "description"],
      "returns": "Project",
      "exceptions": ["DatabaseError", "NotFoundError"]
    },
    {
      "name": "deleteProject",
      "type": "method",
      "description": "删除项目及其关联的环境和部署记录",
      "parameters": ["id"],
      "returns": "void",
      "exceptions": ["DatabaseError", "NotFoundError"]
    },
    {
      "name": "getEnvironments",
      "type": "method",
      "description": "获取指定项目的环境列表",
      "parameters": ["projectId"],
      "returns": "Array<Environment>",
      "exceptions": ["DatabaseError"]
    },
    {
      "name": "createEnvironment",
      "type": "method",
      "description": "创建新环境",
      "parameters": ["projectId", "name", "host", "port", "username", "credential"],
      "returns": "Environment",
      "exceptions": ["DatabaseError", "ValidationError"]
    },
    {
      "name": "updateEnvironment",
      "type": "method",
      "description": "更新环境信息",
      "parameters": ["id", "name", "host", "port", "username", "credential"],
      "returns": "Environment",
      "exceptions": ["DatabaseError", "NotFoundError"]
    },
    {
      "name": "deleteEnvironment",
      "type": "method",
      "description": "删除环境",
      "parameters": ["id"],
      "returns": "void",
      "exceptions": ["DatabaseError", "NotFoundError"]
    },
    {
      "name": "getDeployRecords",
      "type": "method",
      "description": "获取部署记录列表，可按项目或环境过滤",
      "parameters": ["projectId", "environmentId"],
      "returns": "Array<DeployRecord>",
      "exceptions": ["DatabaseError"]
    },
    {
      "name": "createDeployRecord",
      "type": "method",
      "description": "创建部署记录",
      "parameters": ["projectId", "environmentId", "status", "startTime", "endTime", "output"],
      "returns": "DeployRecord",
      "exceptions": ["DatabaseError", "ValidationError"]
    },
    {
      "name": "setMasterPassword",
      "type": "method",
      "description": "设置或更新主密码哈希",
      "parameters": ["hash"],
      "returns": "void",
      "exceptions": ["DatabaseError"]
    },
    {
      "name": "verifyMasterPassword",
      "type": "method",
      "description": "验证主密码哈希",
      "parameters": ["hash"],
      "returns": "boolean",
      "exceptions": ["DatabaseError"]
    }
  ],
  "error_handling": {
    "strategy": "定义 DatabaseError、ValidationError、NotFoundError 等自定义错误类型，上层调用根据错误类型处理。"
  },
  "index_strategy": [
    {
      "table": "projects",
      "indexes": [
        {"columns": ["name"], "unique": true}
      ]
    },
    {
      "table": "environments",
      "indexes": [
        {"columns": ["project_id"], "unique": false},
        {"columns": ["name", "project_id"], "unique": true}
      ]
    },
    {
      "table": "deploy_records",
      "indexes": [
        {"columns": ["project_id"], "unique": false},
        {"columns": ["environment_id"], "unique": false}
      ]
    }
  ],
  "migration_strategy": {
    "versioning": "基于版本号递增",
    "tooling": "手工 SQL 脚本管理",
    "approach": "初始化时执行迁移",
    "risks": ["迁移失败可能导致数据丢失"],
    "tests": ["迁移脚本单元测试"],
    "seed_data": ["默认管理员密码哈希"]
  },
  "capacity_estimation": {
    "max_rows_estimate": "projects: <1000, environments: <5000, deploy_records: <100000",
    "storage_estimate": "预计最大 10MB",
    "growth_rate": "每月新增 1000 条部署记录，增长缓慢",
    "backup_strategy": "定期复制数据库文件"
  },
