  "interfaces": [
    {
      "id": "IF-001",
      "name": "generate_and_setup_remote",
      "type": "rest",
      "method": "POST",
      "endpoint": "/api/v1/generate-and-setup-remote",
      "description": "主接口：根据部署任务和环境配置，在远程服务器上生成版本文件夹和启动脚本",
      "source_requirements": [
        "REQ-001"
      ],
      "input": {
        "body": {
          "task_id": "UUID",
          "environment_id": "UUID"
        }
      },
      "output": {
        "success": {
          "http_code": 200,
          "body": {
            "folder_name": "String",
            "remote_path": "String",
            "message": "String"
          }
        },
        "error_codes": [
          {
            "code": "TASK_NOT_FOUND",
            "message": "部署任务不存在"
          },
          {
            "code": "INVALID_TASK_STATUS",
            "message": "部署任务状态不允许执行此操作"
          },
          {
            "code": "ENVIRONMENT_NOT_FOUND",
            "message": "环境配置不存在"
          },
          {
            "code": "INVALID_NAMING_MASK",
            "message": "命名模板无效或缺少必要占位符"
          },
          {
            "code": "REMOTE_SETUP_FAILED",
            "message": "远程服务器操作失败（SSH连接错误、权限不足等）"
          }
        ]
      }
    },
    {
      "id": "IF-002",
      "name": "validate_deployment_task",
      "type": "rest",
      "method": "GET",
      "endpoint": "/api/v1/validate-deployment-task",
      "description": "校验接口：检查给定的部署任务是否具备生成脚本的条件（状态、命名模板有效性等）",
      "source_requirements": [
        "REQ-001"
      ],
      "input": {
        "query_params": {
          "task_id": "UUID"
        }
      },
      "output": {
        "success": {
          "http_code": 200,
          "body": {
            "valid": "Boolean",
            "folder_name_preview": "String?",
            "warnings": ["String"]
          }
        },
        "error_codes": [
          {
            "code": "TASK_NOT_FOUND",
            "message": "部署任务不存在"
          },
          {
            "code": "INVALID_NAMING_MASK",
            "message": "命名模板无效"
          }
        ]
      }
    },
    {
      "id": "IF-003",
      "name": "health_check",
      "type": "rest",
      "method": "GET",
      "endpoint": "/api/v1/health",
      "description": "服务健康检查",
      "source_requirements": [
        "REQ-001"
      ],
      "input": {},
      "output": {
        "success": {
          "http_code": 200,
          "body": {
            "status": "String",
            "timestamp": "Timestamp"
          }
        },
        "error_codes": []
      }
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "RemoteVersionScriptGeneratorService",
      "description": "远程版本与脚本生成器服务契约",
      "methods": [
        {
          "name": "generate_and_setup",
          "description": "执行生成与远程设置",
          "input": {
            "task_id": "UUID",
            "environment_id": "UUID"
          },
          "output": {
            "folder_name": "String",
            "remote_path": "String"
          },
          "exceptions": [
            "TaskNotFoundError",
            "InvalidTaskStatusError",
            "EnvironmentNotFoundError",
            "InvalidNamingMaskError",
            "RemoteSetupError"
          ]
        },
        {
          "name": "validate_task",
          "description": "验证部署任务是否具备生成脚本的条件",
          "input": {
            "task_id": "UUID"
          },
          "output": {
            "valid": "Boolean",
            "folder_name_preview": "String?"
          },
          "exceptions": [
            "TaskNotFoundError",
            "InvalidNamingMaskError"
          ]
        }
      ]
    }
  ],
  "business_rules": {
    "BR-001": {
      "description": "如果 deployment_task 的 naming_mask 为空，则使用默认命名格式 {project_name}_{timestamp}（精确到秒）"
    },
    "BR-002": {
      "description": "如果 naming_mask 非空，则必须包含占位符 {project_name} 和 {timestamp}，否则报错 INVALID_NAMING_MASK"
    },
    "BR-003": {
      "description": "脚本内容必须包含基本的错误处理（set -e），并导出环境变量 JAVA_OPTS（从 DB 环境配置读取）"
    },
    "BR-004": {
      "description": "部署脚本文件统一命名为 start.sh，放置于版本目录下"
    }
  },
  "error_handling": {
    "strategy": "全局异常处理中间件捕获所有异常，并转换为统一的错误响应格式。可重试的异常（如远程连接超时）将返回503，不可重试的（如资源不存在）返回4xx。",
    "error_codes": [
      {
        "code": "TASK_NOT_FOUND",
        "description": "指定的部署任务ID不存在",
        "http_code": 404
      },
      {
        "code": "INVALID_TASK_STATUS",
        "description": "部署任务状态不允许执行此操作",
        "http_code": 400
      },
      {
        "code": "ENVIRONMENT_NOT_FOUND",
        "description": "指定的环境ID不存在",
        "http_code": 404
      },
      {
        "code": "INVALID_NAMING_MASK",
        "description": "命名模板无效或缺少必要占位符",
        "http_code": 400
      },
      {
        "code": "REMOTE_SETUP_FAILED",
        "description": "远程服务器操作失败",
        "http_code": 500
      },
      {
        "code": "INTERNAL_ERROR",
        "description": "未预期的内部错误",
        "http_code": 500
      }
    ]
  }
}