  "module_boundary": {
    "in_scope": [
      "生成部署文件夹名称（支持默认和自定义格式）",
      "通过SSH在远程服务器创建部署目录",
      "生成标准的应用启动脚本（bash）",
      "通过SSH设置启动脚本的可执行权限",
      "记录生成的脚本内容和远程路径"
    ],
    "out_of_scope": [
      "文件上传/传输",
      "部署流程编排",
      "环境配置信息的获取与管理",
      "SSH连接的建立、认证和密钥管理",
      "部署进度的实时通知",
      "部署任务的数据库状态更新和日志记录"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-004"
    ],
    "consumed_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ]
  },
  "overview": {
    "description": "本模块是部署流水线中的原子服务，负责在远程目标服务器上为每次部署创建版本化目录、生成应用启动脚本并设置其可执行权限。它只关心文件系统的组织和脚本内容的标准化，不负责文件传输或部署流程控制。",
    "dependencies": [
      "项目管理服务",
      "环境管理服务",
      "密钥管理组件",
      "部署编排器"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "Paramiko",
      "Celery (被调用方)"
    ]
  },
