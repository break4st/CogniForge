  },
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "EnvironmentService",
      "ownership": "canonical",
      "description": "环境管理服务",
      "methods": [
        {
          "name": "listEnvironments",
          "signature": "listEnvironments(projectId: string, current?: integer, pageSize?: integer): Promise<{ data: Environment[], total: integer, current: integer, pageSize: integer }>",
          "description": "获取环境列表",
          "precondition": "projectId 必须存在且属于当前用户",
          "postcondition": "返回该项目的环境列表及分页信息，data 包含 Environment 对象数组"
        },
        {
          "name": "createEnvironment",
          "signature": "createEnvironment(projectId: string, body: { name: string, host: string, port: integer, username: string, authType: string, password?: string, identityFile?: string }): Promise<{ id: string }>",
          "description": "创建环境",
          "precondition": "projectId 必须存在；body 中 name, host, port, username, authType 不能为空",
          "postcondition": "创建成功返回新环境的 ID；若连接信息无效，应返回错误"
        },
        {
          "name": "updateEnvironment",
          "signature": "updateEnvironment(projectId: string, envId: string, body: { name?: string, host?: string, port?: integer, username?: string, authType?: string, password?: string, identityFile?: string }): Promise<void>",
          "description": "更新环境",
          "precondition": "projectId 和 envId 必须存在且属于当前用户",
          "postcondition": "环境信息更新成功；若设置为默认环境，原默认环境被取消"
        }
      ]
    }
  ],
