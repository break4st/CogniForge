{
  "meta": {
    "doc_id": "lld-前端 Web 应用-001",
    "type": "lld",
    "module_type": "service",
    "module": "前端 Web 应用",
    "title": "前端 Web 应用 LLD",
    "author": "Design Agent",
    "created": "2025-04-07T12:00:00Z",
    "version": 1
  },
  "overview": {
    "description": "基于 Vue 3 和 Element Plus 构建的单页应用，提供项目管理、环境配置、密钥管理、部署触发与实时日志展示、部署历史与回滚操作的界面。",
    "dependencies": [
      "后端 API 服务 (CMP-002)"
    ],
    "tech_stack": [
      "Vue 3",
      "Element Plus",
      "Vue Router",
      "Pinia (状态管理)",
      "Axios (HTTP 客户端)"
    ]
  },
  "module_boundary": {
    "in_scope": [
      "项目管理界面：项目列表、创建/编辑表单、删除确认",
      "环境管理界面：环境列表、创建/编辑表单、删除确认、测试连接按钮",
      "密钥管理界面：密钥列表、添加上传表单、删除确认",
      "部署触发界面：选择项目和环境的表单、文件上传、触发按钮",
      "实时日志展示：基于 WebSocket 的日志流展示，支持滚动和清空",
      "部署历史界面：分页列表、筛选、回滚按钮",
      "回滚操作：确认对话框、调用回滚 API",
      "取消部署：正在部署中的取消操作",
      "全局布局和导航：侧边栏/顶部导航，路由切换",
      "全局状态管理：用户上下文、项目/环境列表缓存",
      "API 集成层：封装 HTTP 请求和 WebSocket 连接，错误处理"
    ],
    "out_of_scope": [
      "后端 API 逻辑",
      "数据库设计",
      "用户认证与授权（假设由反向代理或后端处理，前端仅展示登陆页面占位）",
      "CI/CD 流程",
      "监控与告警"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-001",
      "CTR-002",
      "CTR-003",
      "CTR-004",
      "CTR-005",
      "CTR-006",
      "CTR-007",
      "CTR-008",
      "CTR-009"
    ],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003",
      "DM-004",
      "DM-005"
    ],
    "consumed_data_models": []
  },
  "data_models": [
    {
      "id": "DM-001",
      "type": "struct",
      "ownership": "canonical",
      "name": "Project",
      "description": "项目信息",
      "fields": [
        { "name": "id", "type": "number", "required": true, "description": "项目唯一标识" },
        { "name": "name", "type": "string", "required": true, "description": "项目名称" },
        { "name": "repoUrl", "type": "string", "required": true, "description": "仓库 URL" },
        { "name": "description", "type": "string", "required": false, "description": "项目描述" },
        { "name": "createdAt", "type": "string", "required": true, "description": "创建时间" }
      ]
    },
    {
      "id": "DM-002",
      "type": "struct",
      "ownership": "canonical",
      "name": "Environment",
      "description": "环境信息",
      "fields": [
        { "name": "id", "type": "number", "required": true, "description": "环境唯一标识" },
        { "name": "name", "type": "string", "required": true, "description": "环境名称" },
        { "name": "projectId", "type": "number", "required": true, "description": "所属项目 ID" },
        { "name": "host", "type": "string", "required": true, "description": "主机地址" },
        { "name": "port", "type": "number", "required": true, "description": "SSH 端口" },
        { "name": "username", "type": "string", "required": true, "description": "用户名" },
        { "name": "sshKeyId", "type": "number", "required": true, "description": "关联 SSH 密钥 ID" },
        { "name": "createdAt", "type": "string", "required": true, "description": "创建时间" }
      ]
    },
    {
      "id": "DM-003",
      "type": "struct",
      "ownership": "canonical",
      "name": "SSHKey",
      "description": "SSH 密钥信息",
      "fields": [
        { "name": "id", "type": "number", "required": true, "description": "密钥唯一标识" },
        { "name": "name", "type": "string", "required": true, "description": "密钥名称" },
        { "name": "keyType", "type": "string", "required": true, "description": "密钥类型（如 RSA）" },
        { "name": "fingerprint", "type": "string", "required": true, "description": "密钥指纹" },
        { "name": "createdAt", "type": "string", "required": true, "description": "创建时间" }
      ]
    },
    {
      "id": "DM-004",
      "type": "struct",
      "ownership": "canonical",
      "name": "Deployment",
      "description": "部署记录",
      "fields": [
        { "name": "id", "type": "string", "required": true, "description": "部署唯一标识" },
        { "name": "projectId", "type": "number", "required": true, "description": "项目 ID" },
        { "name": "environmentId", "type": "number", "required": true, "description": "环境 ID" },
        { "name": "status", "type": "string", "required": true, "description": "部署状态" },
        { "name": "createdAt", "type": "string", "required": true, "description": "创建时间" },
        { "name": "finishedAt", "type": "string", "required": false, "description": "完成时间" }
      ]
    },
    {
      "id": "DM-005",
      "type": "struct",
      "ownership": "canonical",
      "name": "LogMessage",
      "description": "实时日志消息",
      "fields": [
        { "name": "timestamp", "type": "string", "required": true, "description": "时间戳" },
        { "name": "message", "type": "string", "required": true, "description": "日志内容" },
        { "name": "level", "type": "string", "required": true, "description": "日志级别" }
      ]
    }
  ],
  "domain_objects": [],
  "service_contracts": [],
  "business_rules": {
    "invariants": [
      "项目名称不能为空且唯一",
      "环境名称在同一项目内唯一",
      "SSH 密钥名称唯一",
      "部署前必须选择项目和目标环境",
      "文件上传大小不超过 100MB",
      "WebSocket 连接在部署期间保持存活，断开后自动重连"
    ],
    "actions": [],
    "validations": []
  },
  "error_handling": {
    "strategy": "前端通过 Axios 拦截器统一处理 HTTP 错误，显示用户友好的错误消息；WebSocket 监听错误事件进行重连和提示。"
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "获取项目列表",
      "description": "获取所有项目",
      "method": "GET",
      "endpoint": "/api/projects",
      "response": {
        "statusCode": 200,
        "body": {
          "type": "array",
          "items": {
            "$ref": "DM-001"
          }
        }
      }
    },
    {
      "id": "IF-002",
      "name": "创建项目",
      "description": "创建新项目",
      "method": "POST",
      "endpoint": "/api/projects",
      "response": {
        "statusCode": 201,
        "body": {
          "$ref": "DM-001"
        }
      }
    },
    {
      "id": "IF-003",
      "name": "获取项目详情",
      "description": "获取单个项目信息",
      "method": "GET",
      "endpoint": "/api/projects/{id}",
      "response": {
        "statusCode": 200,
        "body": {
          "$ref": "DM-001"
        }
      }
    },
    {
      "id": "IF-004",
      "name": "更新项目",
      "description": "更新项目信息",
      "method": "PUT",
      "endpoint": "/api/projects/{id}",
      "response": {
        "statusCode": 200,
        "body": {
          "$ref": "DM-001"
        }
      }
    },
    {
      "id": "IF-005",
      "name": "删除项目",
      "description": "删除项目",
      "method": "DELETE",
      "endpoint": "/api/projects/{id}",
      "response": {
        "statusCode": 204,
        "body": {}
      }
    },
    {
      "id": "IF-006",
      "name": "获取环境列表",
      "description": "获取所有环境或按项目过滤",
      "method": "GET",
      "endpoint": "/api/environments",
      "response": {
        "statusCode": 200,
        "body": {
          "type": "array",
          "items": {
            "$ref": "DM-002"
          }
        }
      }
    },
    {
      "id": "IF-007",
      "name": "创建环境",
      "description": "创建新环境",
      "method": "POST",
      "endpoint": "/api/environments",
      "response": {
        "statusCode": 201,
        "body": {
          "$ref": "DM-002"
        }
      }
    },
    {
      "id": "IF-008",
      "name": "更新环境",
      "description": "更新环境信息",
      "method": "PUT",
      "endpoint": "/api/environments/{id}",
      "response": {
        "statusCode": 200,
        "body": {
          "$ref": "DM-002"
        }
      }
    },
    {
      "id": "IF-009",
      "name": "删除环境",
      "description": "删除环境",
      "method": "DELETE",
      "endpoint": "/api/environments/{id}",
      "response": {
        "statusCode": 204,
        "body": {}
      }
    },
    {
      "id": "IF-010",
      "name": "测试连接",
      "description": "测试环境连接",
      "method": "POST",
      "endpoint": "/api/environments/{id}/test",
      "response": {
        "statusCode": 200,
        "body": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" },
            "message": { "type": "string" }
          }
        }
      }
    },
    {
      "id": "IF-011",
      "name": "获取 SSH 密钥列表",
      "description": "获取所有 SSH 密钥",
      "method": "GET",
      "endpoint": "/api/ssh-keys",
      "response": {
        "statusCode": 200,
        "body": {
          "type": "array",
          "items": {
            "$ref": "DM-003"
          }
        }
      }
    },
    {
      "id": "IF-012",
      "name": "上传 SSH 密钥",
      "description": "上传新的 SSH 密钥",
      "method": "POST",
      "endpoint": "/api/ssh-keys",
      "response": {
        "statusCode": 201,
        "body": {
          "$ref": "DM-003"
        }
      }
    },
    {
      "id": "IF-013",
      "name": "删除 SSH 密钥",
      "description": "删除 SSH 密钥",
      "method": "DELETE",
      "endpoint": "/api/ssh-keys/{id}",
      "response": {
        "statusCode": 204,
        "body": {}
      }
    },
    {
      "id": "IF-014",
      "name": "触发部署",
      "description": "触发一次部署",
      "method": "POST",
      "endpoint": "/api/deployments",
      "response": {
        "statusCode": 202,
        "body": {
          "$ref": "DM-004"
        }
      }
    },
    {
      "id": "IF-015",
      "name": "获取部署历史",
      "description": "获取部署记录列表",
      "method": "GET",
      "endpoint": "/api/deployments",
      "response": {
        "statusCode": 200,
        "body": {
          "type": "array",
          "items": {
            "$ref": "DM-004"
          }
        }
      }
    },
    {
      "id": "IF-016",
      "name": "获取部署详情",
      "description": "获取单个部署记录",
      "method": "GET",
      "endpoint": "/api/deployments/{id}",
      "response": {
        "statusCode": 200,
        "body": {
          "$ref": "DM-004"
        }
      }
    },
    {
      "id": "IF-017",
      "name": "取消部署",
      "description": "取消正在进行的部署",
      "method": "POST",
      "endpoint": "/api/deployments/{id}/cancel",
      "response": {
        "statusCode": 200,
        "body": {
          "type": "object",
          "properties": {
            "success": { "type": "boolean" }
          }
        }
      }
    },
    {
      "id": "IF-018",
      "name": "回滚部署",
      "description": "回滚到指定的部署",
      "method": "POST",
      "endpoint": "/api/deployments/{id}/rollback",
      "response": {
        "statusCode": 202,
        "body": {
          "$ref": "DM-004"
        }
      }
    },
    {
      "id": "IF-019",
      "name": "WebSocket 日志",
      "description": "实时日志流",
      "method": "WS",
      "endpoint": "/ws/logs/{deploymentId}",
      "response": {
        "statusCode": 0,
        "body": {
          "$ref": "DM-005"
        }
      }
    }
  ]
}