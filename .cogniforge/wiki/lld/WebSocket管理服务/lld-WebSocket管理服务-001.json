  "module_boundary": {
    "in_scope": [
      "建立、保持和销毁WebSocket连接",
      "从客户端WebSocket升级请求中提取并验证JWT Token",
      "将客户端按deploymentId加入订阅频道",
      "接收后端服务推送的日志事件并广播给相关客户端",
      "连接异常、超时、断开处理与心跳管理",
      "速率限制（全局、每用户、特殊端点）",
      "连接状态与关键事件日志记录"
    ],
    "out_of_scope": [
      "部署任务的实际执行逻辑",
      "日志持久化存储",
      "前端UI组件渲染",
      "HTTP REST API的代理路由",
      "用户管理与细粒度权限定义",
      "日志数据的后期分析与聚合"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001",
      "CTR-002"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "WebSocket管理服务是网关层的一个独立组件，负责管理与前端客户端的WebSocket长连接，验证客户端身份，并将后端部署执行服务产生的实时日志推送给对应订阅的客户端。该模块不负责日志持久化，也不参与HTTP路由代理。",
    "dependencies": [
      "部署执行服务"
    ],
    "tech_stack": [
      "Node.js",
      "Express",
      "ws",
      "jsonwebtoken"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001",
        "CTR-002"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003"
        ],
        "interfaces": [
          "IF-001",
          "IF-002"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "实时日志推送功能通过WebSocket连接和内网日志事件接收端点实现，覆盖了需求中的实时性要求。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "ConnectionSession",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "描述一个已建立的WebSocket连接及其关联的订阅信息和用户上下文，仅存在于内存中。",
      "fields": [
        {
          "name": "connectionId",
          "type": "string (UUIDv4)",
          "required": true,
          "description": "连接的唯一标识符。"
        },
        {
          "name": "userId",
          "type": "string",
          "required": true,
          "description": "从JWT中提取的用户标识。"
        },
        {
          "name": "roles",
          "type": "array[string]",
          "required": true,
          "description": "用户角色列表，用于权限校验。"
        },
        {
          "name": "deploymentId",
          "type": "string (UUID)",
          "required": true,
          "description": "该连接订阅的部署任务ID。"
        },
        {
          "name": "status",
          "type": "enum: active | closing | closed",
          "required": true,
          "description": "连接的生命周期状态。"
        },
        {
          "name": "connectedAt",
          "type": "string (ISO8601)",
          "required": true,
          "description": "连接建立的时间戳。"
        },
        {
          "name": "lastActivity",
          "type": "string (ISO8601)",
          "required": false,
          "description": "最后一次心跳或消息活动的时间，用于超时检测。"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "每个deploymentId可对应多个ConnectionSession（多客户端订阅同一部署）。"
      ],
      "lifecycle": {
        "create": "WebSocket升级握手成功后创建。",
        "update": "心跳/消息活动时更新lastActivity；状态可能变为closing。",
        "delete": "连接断开、超时或主动关闭时从内存中移除。",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD，定义WebSocket连接会话模型。"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "LogEvent",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "部署执行服务通过内部接口推送的日志事件结构体。本模块解析后用于广播。",
      "fields": [
        {
          "name": "deploymentId",
          "type": "string (UUID)",
          "required": true,
          "description": "关联的部署任务ID。"
        },
        {
          "name": "log",
          "type": "string",
          "required": true,
          "description": "单行或多行日志文本。"
        },
        {
          "name": "level",
          "type": "enum: info | warning | error",
          "required": true,
          "description": "日志级别。"
        },
        {
          "name": "timestamp",
          "type": "string (ISO8601)",
          "required": true,
          "description": "事件产生时的服务器时间戳。"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-002"
      ],
      "constraints": [
        "由调用方保证字段完整性，本模块仅做存在性校验。"
      ],
      "lifecycle": {
        "create": "部署执行服务发送时构造。",
        "update": "",
        "delete": "",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD，定义日志事件模型。"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "LogMessageToClient",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "推送给前端客户端的WebSocket消息格式，当前与LogEvent字段一致，保留扩展性。",
      "fields": [
        {
          "name": "deploymentId",
          "type": "string (UUID)",
          "required": true,
          "description": "关联的部署任务ID。"
        },
        {
          "name": "log",
          "type": "string",
          "required": true,
          "description": "单行或多行日志文本。"
        },
        {
          "name": "level",
          "type": "enum: info | warning | error",
          "required": true,
          "description": "日志级别。"
        },
        {
          "name": "timestamp",
          "type": "string (ISO8601)",
          "required": true,
          "description": "事件产生时的服务器时间戳。"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "每条WebSocket消息均为单个完整的JSON对象，不做分片。"
      ],
      "lifecycle": {
        "create": "广播前由LogEvent实时构造。",
        "update": "",
        "delete": "",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD，定义客户端消息模型。"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "WebSocket Log Stream",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "WS",
      "endpoint": "/ws/logs/{deploymentId}",
      "description": "客户端通过此端点建立WebSocket连接，以接收指定部署任务的实时日志流。",
      "parameters": [
        {
          "name": "deploymentId",
          "type": "string (UUID)",
          "in": "path",
          "required": true,
          "description": "要订阅的部署任务ID。"
        },
        {
          "name": "token",
          "type": "string (JWT)",
          "in": "query",
          "required": true,
          "description": "JWT access token，由于WebSocket标准API不支持自定义头，通过查询参数传递。"
        }
      ],
      "request_body": {},
      "response": {
        "status": 101,
        "body": {
          "type": "WebSocket Messages (JSON)",
          "format": "每条消息为JSON对象，符合LogMessageToClient模型",
          "firstMessage": {
            "type": "connected",
            "deploymentId": "string (UUID)",
            "timestamp": "string (ISO8601)"
          },
          "logMessage": {
            "deploymentId": "string (UUID)",
            "log": "string",
            "level": "string (info|warning|error)",
            "timestamp": "string (ISO8601)"
          }
        }
      },
      "error_codes": [
        {
          "status": 1008,
          "code": "AUTH_FAILED",
          "message": "Token缺失、无效或过期。WebSocket关闭时附带JSON: {\"code\":4001,\"error\":\"AUTH_FAILED\",\"detail\":\"...\"}"
        },
        {
          "status": 1003,
          "code": "DEPLOYMENT_NOT_FOUND",
          "message": "指定的deploymentId不存在或无权访问。关闭附带JSON: {\"code\":4004,...}"
        },
        {
          "status": 1008,
          "code": "RATE_LIMITED",
          "message": "超过每用户每分钟最大连接数。关闭附带JSON: {\"code\":4009,...}"
        },
        {
          "status": 1011,
          "code": "INTERNAL_ERROR",
          "message": "服务端内部错误。关闭附带JSON: {\"code\":5001,...}"
        }
      ],
      "auth": {
        "required": true,
        "policy": "JWT验证，至少包含user或admin角色。"
      },
      "validation_rules": [
        "deploymentId 必须为有效UUID格式",
        "token 必须为合法的JWT，且未过期"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD，定义对外WebSocket日志流接口。"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "Internal Log Event Receiver",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-002",
      "provider_component_id": "CMP-001",
      "method": "POST",
      "endpoint": "/internal/log-events",
      "description": "部署执行服务调用此端点推送日志事件，服务端收到后按deploymentId广播给所有订阅的WebSocket客户端。",
      "parameters": [],
      "request_body": {
        "deploymentId": "string (UUID)",
        "log": "string",
        "level": "string (info|warning|error)",
        "timestamp": "string (ISO8601)"
      },
      "response": {
        "status": 204,
        "body": {}
      },
      "error_codes": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "请求体缺少必填字段或字段类型错误。"
        },
        {
          "status": 401,
          "code": "AUTH_FAILED",
          "message": "内部API Key缺失或无效。"
        },
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "广播过程中发生内部异常。"
        }
      ],
      "auth": {
        "required": true,
        "policy": "通过Header X-API-Key传递内部服务共享密钥。"
      },
      "validation_rules": [
        "deploymentId 非空且为有效UUID",
        "log 字符串非空",
        "level 为 info/warning/error 之一",
        "timestamp 符合ISO8601格式"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD，定义内部日志事件接收接口。"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "所有通过WebSocket或HTTP返回的错误均使用统一JSON格式：{\"code\":... ,\"error\":\"...\", \"detail\":\"...\"}；WebSocket错误通过关闭码和reason传递。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xxx",
        "name": "客户端错误",
        "description": "包括认证失败(4001)、资源未找到(4004)、速率限制(4009)等，WebSocket升级时返回相应关闭码和JSON reason，HTTP接口返回标准HTTP状态码。"
      },
      {
        "code": "5xxx",
        "name": "服务端错误",
        "description": "内部广播异常、内存操作失败等(5001)，WebSocket返回1011关闭码，HTTP返回500状态码。"
      }
    ]
  },
  "workflow": {
    "name": "实时日志转发流程",
    "description": "描述从前端建立WebSocket连接，到后端推送日志，最后广播给客户端的完整流程。",
    "steps": [
      {
        "order": 1,
        "name": "WebSocket升级握手",
        "action": "客户端GET /ws/logs/{deploymentId}?token=...；中间件链执行JWT认证、速率检查，通过后调用ws.handleUpgrade。",
        "timeout_seconds": 5,
        "on_failure": "返回HTTP 408或WebSocket错误码关闭连接。"
      },
      {
        "order": 2,
        "name": "连接建立与订阅",
        "action": "创建ConnectionSession对象，包含userId、deploymentId等信息，将连接加入deploymentId对应的连接池；发送连接成功消息。",
        "timeout_seconds": 10,
        "on_failure": "若入池失败，关闭WebSocket并返回5001。"
      },
      {
        "order": 3,
        "name": "接收日志事件",
        "action": "部署执行服务调用POST /internal/log-events，模块验证API Key，解析LogEvent，构造LogMessageToClient。",
        "timeout_seconds": 5,
        "on_failure": "返回HTTP 400/401/500错误。"
      },
      {
        "order": 4,
        "name": "广播消息",
        "action": "扫描deploymentId对应的连接池，对每个活跃连接发送JSON字符串；发送失败则清理对应连接。",
        "timeout_seconds": 2,
        "on_failure": "单连接失败记录日志并移除连接，不影响其他连接。"
      },
      {
        "order": 5,
        "name": "连接断开与清理",
        "action": "客户端主动关闭或心跳超时时，从连接池中删除ConnectionSession，WebSocket自动释放。",
        "timeout_seconds": 30,
        "on_failure": "无操作。"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  },
  "route_table": [
    {
      "path_pattern": "/ws/logs/**",
      "upstream": "WebSocket管理服务自身",
      "description": "WebSocket升级端点，实时日志流。"
    },
    {
      "path_pattern": "/internal/log-events",
      "upstream": "WebSocket管理服务自身",
      "description": "部署执行服务推送日志事件的内部HTTP接口。"
    },
    {
      "path_pattern": "/health",
      "upstream": "WebSocket管理服务自身",
      "description": "健康检查端点，直接返回状态，无需转发。"
    }
  ],
  "middleware_chain": [
    "Request → CORS Handler → Auth (JWT/API Key) → Rate Limiter → WebSocket Upgrade Handler (针对/ws/logs) → Connection Manager; 对于HTTP请求继续 → Router → Business Logic Handler"
  ],
  "auth_policy": {
    "public_endpoints": [
      "/health"
    ],
    "auth_method": "JWT Bearer Token (通过查询参数传递) 或内部API Key",
    "role_path_map": [
      {
        "path": "WS /ws/logs/**",
        "roles": [
          "user",
          "admin"
        ]
      },
      {
        "path": "POST /internal/log-events",
        "roles": [
          "internal_service"
        ]
      }
    ],
    "token_expiry": "access 2h, refresh 7d"
  },
  "rate_limiting": {
    "global": "每 IP 100 req/s",
    "per_user": "每 user 1000 req/min",
    "special_endpoints": [
      {
        "endpoint": "WS /ws/logs/**",
        "limit": "每 user 10 connections/min，超出后拒绝新WebSocket升级"
      }
    ]
  }
}