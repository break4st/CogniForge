  "interfaces": [
    {
      "name": "用户登录认证",
      "endpoint": "POST /api/auth/login",
      "description": "用户登录认证，提交用户名密码和角色，获取 JWT Token 和用户信息。前端将 token 存储于 localStorage/sessionStorage，后续请求在 Authorization Header 中携带 Bearer token。",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"},
        {"name": "role", "type": "string", "description": "角色: admin|teacher|student"}
      ],
      "contract_ref": "用户登录认证 (provider: API Gateway)"
    },
    {
      "name": "学生列表查询",
      "endpoint": "GET /api/students",
      "description": "按条件分页查询学生列表，支持姓名、学号、班级筛选，用于学生管理页面的列表展示",
      "parameters": [
        {"name": "name", "type": "string", "description": "按姓名筛选，选填"},
        {"name": "student_no", "type": "string", "description": "按学号筛选，选填"},
        {"name": "class_id", "type": "number", "description": "按班级筛选，选填"},
        {"name": "page", "type": "number", "description": "页码，默认 1，选填"},
        {"name": "page_size", "type": "number", "description": "每页条数，默认 20，选填"}
      ],
      "contract_ref": "学生列表查询 (provider: API Gateway)"
    },
    {
      "name": "学生详情查询",
      "endpoint": "GET /api/students/{id}",
      "description": "查看指定学生的详细信息，用于学生编辑页面的数据回填",
      "parameters": [
        {"name": "id", "type": "number", "description": "学生 ID，路径参数"}
      ],
      "contract_ref": "学生详情查询 (provider: API Gateway)"
    },
    {
      "name": "学生创建",
      "endpoint": "POST /api/students",
      "description": "创建新的学生信息，学号 student_no 全局唯一不可重复。表单提交前需前端校验必填字段及学号格式。",
      "parameters": [
        {"name": "name", "type": "string", "description": "学生姓名，必填"},
        {"name": "student_no", "type": "string", "description": "学号，全局唯一，必填"},
        {"name": "contact_phone", "type": "string", "description": "联系电话，必填"},
        {"name": "contact_email", "type": "string", "description": "联系邮箱，必填"},
        {"name": "class_id", "type": "number", "description": "所属班级 ID，选填"}
      ],
      "contract_ref": "学生创建 (provider: API Gateway)"
    },
    {
      "name": "学生更新",
      "endpoint": "PUT /api/students/{id}",
      "description": "更新指定学生的信息（不含学号），用于学生编辑页面的保存操作",
      "parameters": [
        {"name": "id", "type": "number", "description": "学生 ID，路径参数"},
        {"name": "name", "type": "string", "description": "学生姓名，选填"},
        {"name": "contact_phone", "type": "string", "description": "联系电话，选填"},
        {"name": "contact_email", "type": "string", "description": "联系邮箱，选填"},
        {"name": "class_id", "type": "number", "description": "所属班级 ID，选填"}
      ],
      "contract_ref": "学生更新 (provider: API Gateway)"
    },
    {
      "name": "学生删除",
      "endpoint": "DELETE /api/students/{id}",
      "description": "删除指定学生信息，删除操作需要管理员权限，操作前需弹窗确认",
      "parameters": [
        {"name": "id", "type": "number", "description": "学生 ID，路径参数"}
      ],
      "contract_ref": "学生删除 (provider: API Gateway)"
    },
    {
      "name": "学生分班",
      "endpoint": "PUT /api/students/{id}/class",
      "description": "将学生分配到指定班级，需校验班级存在性",
      "parameters": [
        {"name": "id", "type": "number", "description": "学生 ID，路径参数"},
        {"name": "class_id", "type": "number", "description": "目标班级 ID"}
      ],
      "contract_ref": "学生分班 (provider: API Gateway)"
    },
    {
      "name": "班级列表查询",
      "endpoint": "GET /api/classes",
      "description": "按条件分页查询班级列表，支持按年级筛选和名称模糊搜索",
      "parameters": [
        {"name": "grade_id", "type": "number", "description": "按年级筛选，选填"},
        {"name": "name", "type": "string", "description": "按名称模糊搜索，选填"},
        {"name": "page", "type": "number", "description": "页码，默认 1，选填"},
        {"name": "page_size", "type": "number", "description": "每页条数，默认 20，选填"}
      ],
      "contract_ref": "班级列表查询 (provider: API Gateway)"
    },
    {
      "name": "班级详情查询",
      "endpoint": "GET /api/classes/{id}",
      "description": "查询指定班级的详细信息",
      "parameters": [
        {"name": "id", "type": "number", "description": "班级 ID，路径参数"}
      ],
      "contract_ref": "班级详情查询 (provider: API Gateway)"
    },
    {
      "name": "班级创建",
      "endpoint": "POST /api/classes",
      "description": "创建新的班级信息",
      "parameters": [
        {"name": "name", "type": "string", "description": "班级名称，必填"},
        {"name": "grade_id", "type": "number", "description": "所属年级 ID，选填"},
        {"name": "description", "type": "string", "description": "班级描述，选填"}
      ],
      "contract_ref": "班级创建 (provider: API Gateway)"
    },
    {
      "name": "班级更新",
      "endpoint": "PUT /api/classes/{id}",
      "description": "更新指定班级的信息",
      "parameters": [
        {"name": "id", "type": "number", "description": "班级 ID，路径参数"},
        {"name": "name", "type": "string", "description": "班级名称，选填"},
        {"name": "grade_id", "type": "number", "description": "所属年级 ID，选填"},
        {"name": "description", "type": "string", "description": "班级描述，选填"}
      ],
      "contract_ref": "班级更新 (provider: API Gateway)"
    },
    {
      "name": "班级删除",
      "endpoint": "DELETE /api/classes/{id}",
      "description": "删除指定班级信息，需管理员权限",
      "parameters": [
        {"name": "id", "type": "number", "description": "班级 ID，路径参数"}
      ],
      "contract_ref": "班级删除 (provider: API Gateway)"
    },
    {
      "name": "班级学生名单查询",
      "endpoint": "GET /api/classes/{id}/students",
      "description": "查询指定班级下的学生名单，用于班级详情页面展示",
      "parameters": [
        {"name": "id", "type": "number", "description": "班级 ID，路径参数"},
        {"name": "page", "type": "number", "description": "页码，默认 1，选填"},
        {"name": "page_size", "type": "number", "description": "每页条数，默认 20，选填"}
      ],
      "contract_ref": "班级学生名单查询 (provider: API Gateway)"
    },
    {
      "name": "年级列表查询",
      "endpoint": "GET /api/grades",
      "description": "分页查询年级列表",
      "parameters": [
        {"name": "page", "type": "number", "description": "页码，默认 1，选填"},
        {"name": "page_size", "type": "number", "description": "每页条数，默认 20，选填"}
