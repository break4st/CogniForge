{
  "meta": {
    "doc_id": "lld-Web UI-001",
    "type": "lld",
    "module": "Web UI",
    "title": "LLD - Web UI",
    "author": "design_agent",
    "created": "2026-05-20 13:47"
  },
  "overview": "Web UI 是基于 SPA 架构的前端应用，面向管理员、老师、学生三类角色提供差异化视图与操作能力。所有业务请求均通过 API Gateway 统一接入，前端不直接访问后端微服务。应用包含六个主要功能模块：登录认证、学生管理、班级管理、年级管理、统计看板。页面路由基于角色进行权限控制，管理员拥有全部操作权限，老师拥有查看和数据录入权限（不含删除），学生仅拥有个人数据查看权限。前端框架建议采用 Vue 3 或 React，通过 HTTP 客户端（如 Axios）与 API Gateway 通信，请求时在 Authorization Header 携带 JWT Token 进行鉴权。",
  "data_models": [
    {
      "name": "LoginForm",
      "type": "form_model",
      "description": "用户登录表单，提交至 POST /api/auth/login",
      "fields": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"},
        {"name": "role", "type": "string", "description": "角色枚举: admin|teacher|student"}
      ]
    },
    {
      "name": "UserSession",
      "type": "view_model",
      "description": "登录成功后本地存储的会话信息，含 JWT Token 和用户信息",
      "fields": [
        {"name": "token", "type": "string", "description": "JWT Token，附加于 Authorization Header"},
        {"name": "expires_in", "type": "number", "description": "Token 过期时间（秒）"},
        {"name": "user_info", "type": "object", "description": "用户基本信息"},
        {"name": "user_info.id", "type": "number", "description": "用户 ID"},
        {"name": "user_info.username", "type": "string", "description": "用户名"},
        {"name": "user_info.role", "type": "string", "description": "用户角色: admin|teacher|student"},
        {"name": "user_info.name", "type": "string", "description": "用户显示名"}
      ]
    },
