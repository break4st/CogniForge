{
  "meta": {
    "doc_id": "lld-Web UI-001",
    "type": "lld",
    "module": "Web UI",
    "title": "LLD - Web UI",
    "author": "design_agent",
    "created": "2026-05-20 13:38"
  },
  "overview": "基于现代前端框架（如 Vue 3 / React）构建的单页应用（SPA），通过 API Gateway 与后端微服务通信。面向教务管理员、班主任、教师、校长及家长等不同角色提供差异化视图，包含学生管理、班级管理、年级管理、统计看板等核心功能模块。所有业务接口请求均经过 API Gateway 统一路由与鉴权，前端不直接访问后端微服务。",
  "data_models": [
    {
      "name": "LoginForm",
      "type": "view_model",
      "fields": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"}
      ]
    },
    {
      "name": "UserSession",
      "type": "view_model",
      "fields": [
        {"name": "token", "type": "string", "description": "JWT Token，请求时附加于 Authorization Header"},
        {"name": "role", "type": "string", "description": "用户角色，用于前端权限判断"}
      ]
    },
    {
      "name": "StudentViewModel",
      "type": "view_model",
      "fields": [
        {"name": "id", "type": "integer", "description": "学生 ID"},
        {"name": "name", "type": "string", "description": "学生姓名"},
        {"name": "student_no", "type": "string", "description": "学号"},
        {"name": "gender", "type": "string", "description": "性别"},
        {"name": "birth_date", "type": "string", "description": "出生日期"},
        {"name": "phone", "type": "string", "description": "联系方式"},
        {"name": "address", "type": "string", "description": "家庭住址"},
        {"name": "grade_id", "type": "integer", "description": "年级 ID"},
        {"name": "class_id", "type": "integer", "description": "班级 ID"},
        {"name": "enrollment_date", "type": "string", "description": "入学日期"}
      ]
    },
    {
      "name": "StudentFormData",
      "type": "form_model",
      "fields": [
        {"name": "name", "type": "string", "description": "学生姓名，必填"},
        {"name": "student_no", "type": "string", "description": "学号，系统唯一，必填"},
        {"name": "gender", "type": "string", "description": "性别，必填"},
        {"name": "birth_date", "type": "string", "description": "出生日期，必填"},
        {"name": "phone", "type": "string", "description": "联系方式，选填"},
        {"name": "address", "type": "string", "description": "家庭住址，选填"},
        {"name": "grade_id", "type": "integer", "description": "所属年级 ID，必填"},
        {"name": "class_id", "type": "integer", "description": "所属班级 ID，必填"}
      ]
    },
    {
      "name": "ClassViewModel",
      "type": "view_model",
      "fields": [
        {"name": "id", "type": "integer", "description": "班级 ID"},
        {"name": "name", "type": "string", "description": "班级名称"},
        {"name": "grade_id", "type": "integer", "description": "所属年级 ID"},
        {"name": "head_teacher", "type": "string", "description": "班主任姓名"},
        {"name": "student_count", "type": "integer", "description": "班级学生人数"},
        {"name": "capacity", "type": "integer", "description": "班级容量上限"}
      ]
    },
    {
      "name": "ClassFormData",
      "type": "form_model",
      "fields": [
        {"name": "name", "type": "string", "description": "班级名称，必填"},
        {"name": "grade_id", "type": "integer", "description": "所属年级 ID，必填"},
        {"name": "head_teacher", "type": "string", "description": "班主任姓名，选填"},
        {"name": "capacity", "type": "integer", "description": "班级容量上限，选填"}
      ]
    },
    {
      "name": "GradeViewModel",
      "type": "view_model",
      "fields": [
        {"name": "id", "type": "integer", "description": "年级 ID"},
        {"name": "name", "type": "string", "description": "年级名称"},
        {"name": "stage", "type": "string", "description": "学段（小学/初中/高中）"},
        {"name": "academic_year", "type": "string", "description": "所属学年"},
        {"name": "class_count", "type": "integer", "description": "年级下班级数量"}
      ]
    },
    {
      "name": "GradeFormData",
      "type": "form_model",
      "fields": [
        {"name": "name", "type": "string", "description": "年级名称，必填"},
        {"name": "stage", "type": "string", "description": "学段（小学/初中/高中），必填"},
        {"name": "academic_year", "type": "string", "description": "所属学年，必填"}
      ]
    },
    {
      "name": "StatisticsViewModel",
      "type": "view_model",
      "fields": [
        {"name": "scope", "type": "string", "description": "统计范围: student/class/grade"},
        {"name": "total_students", "type": "integer", "description": "学生总数"},
        {"name": "avg_score", "type": "number", "description": "平均分"},
        {"name": "pass_rate", "type": "number", "description": "及格率"},
        {"name": "attendance_rate", "type": "number", "description": "出勤率"},
        {"name": "score_distribution", "type": "object", "description": "成绩分布数据，用于前端图表渲染"},
        {"name": "trend", "type": "array", "description": "趋势数据，用于前端趋势图渲染"}
      ]
    },
    {
      "name": "PaginationParams",
      "type": "view_model",
      "fields": [
        {"name": "page", "type": "integer", "description": "当前页码，从 1 开始"},
        {"name": "page_size", "type": "integer", "description": "每页条数"},
        {"name": "total", "type": "integer", "description": "数据总条数"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "AuthVerifyAPI",
      "endpoint": "POST /api/v1/auth/login",
      "description": "用户登录认证，提交用户名与密码，获取 JWT Token 和角色信息",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名，必填"},
        {"name": "password", "type": "string", "description": "密码，必填"}
      ],
      "response": {
        "token": "JWT Token，存储于前端 localStorage/SessionStorage",
        "role": "用户角色，用于前端路由守卫与菜单权限控制"
      },
      "contract_ref": "AuthVerifyAPI (provider: API Gateway)"
    },
    {
      "name": "StudentInfoAPI",
      "endpoint": "GET /api/v1/students",
      "description": "分页查询学生列表，支持按姓名、学号、年级、班级等多条件组合筛选",
      "parameters": [
        {"name": "name", "type": "string", "description": "学生姓名模糊搜索，选填"},
        {"name": "student_no", "type": "string", "description": "学号精确匹配，选填"},
        {"name": "grade_id", "type": "integer", "description": "年级 ID 过滤，选填"},
        {"name": "class_id", "type": "integer", "description": "班级 ID 过滤，选填"},
        {"name": "page", "type": "integer", "description": "页码，选填"},
        {"name": "page_size", "type": "integer", "description": "每页条数，选填"}
      ],
      "contract_ref": "StudentInfoAPI (provider: Student Service)"
    },
    {
      "name": "StudentDetailAPI",
      "endpoint": "GET /api/v1/students/{id}",
      "description": "获取单个学生的完整详细信息",
      "parameters": [
        {"name": "id", "type": "integer", "description": "学生 ID，路径参数，必填"}
      ],
      "contract_ref": "StudentDetailAPI (provider: Student Service)"
    },
    {
      "name": "CreateStudentAPI",
      "endpoint": "POST /api/v1/students",
      "description": "创建新学生记录，学号必须唯一",
      "parameters": [
        {"name": "name", "type": "string", "description": "学生姓名，必填"},
        {"name": "student_no", "type": "string", "description": "学号，系统唯一，必填"},
        {"name": "gender", "type": "string", "description": "性别，必填"},
        {"name": "birth_date", "type": "string", "description": "出生日期，必填"},
        {"name": "phone", "type": "string", "description": "联系方式，选填"},
        {"name": "address", "type": "string", "description": "家庭住址，选填"},
        {"name": "grade_id", "type": "integer", "description": "所属年级 ID，必填"},
        {"name": "class_id", "type": "integer", "description": "所属班级 ID，必填"}
      ],
      "contract_ref": "CreateStudentAPI (provider: Student Service)"
    },
    {
      "name": "UpdateStudentAPI",
      "endpoint": "PUT /api/v1/students/{id}",
      "description": "更新学生信息，支持部分字段更新",
      "parameters": [
        {"name": "id", "type": "integer", "description": "学生 ID，路径参数，必填"},
        {"name": "name", "type": "string", "description": "学生姓名，选填"},
        {"name": "phone", "type": "string", "description": "联系方式，选填"},
        {"name": "address", "type": "string", "description": "家庭住址，选填"},
        {"name": "grade_id", "type": "integer", "description": "所属年级 ID，选填"},
        {"name": "class_id", "type": "integer", "description": "所属班级 ID，选填"}
      ],
      "contract_ref": "UpdateStudentAPI (provider: Student Service)"
    },
    {
      "name": "DeleteStudentAPI",
      "endpoint": "DELETE /api/v1/students/{id}",
      "description": "根据 ID 删除学生记录",
      "parameters": [
        {"name": "id", "type": "integer", "description": "学生 ID，路径参数，必填"}
      ],
      "contract_ref": "DeleteStudentAPI (provider: Student Service)"
    },
    {
      "name": "StudentImportAPI",
      "endpoint": "POST /api/v1/students/import",
      "description": "批量导入学生信息，支持 CSV/Excel 文件上传",
      "parameters": [
        {"name": "file", "type": "binary", "description": "学生信息导入文件（CSV/Excel），必填"}
      ],
      "contract_ref": "StudentImportAPI (provider: Student Service)"
    },
    {
      "name": "StudentExportAPI",
      "endpoint": "GET /api/v1/students/export",
      "description": "导出学生信息为 CSV/Excel 文件",
      "parameters": [
        {"name": "grade_id", "type": "integer", "description": "按年级筛选导出，选填"},
        {"name": "class_id", "type": "integer", "description": "按班级筛选导出，选填"}
      ],
      "contract_ref": "StudentExportAPI (provider: Student Service)"
    },
    {
      "name": "ClassInfoAPI",
      "endpoint": "GET /api/v1/classes",
      "description": "分页查询班级列表，支持按年级过滤",
      "parameters": [
        {"name": "grade_id", "type": "integer", "description": "按年级过滤班级，选填"},
        {"name": "page", "type": "integer", "description": "页码，选填"},
        {"name": "page_size", "type": "integer", "description": "每页条数，选填"}
      ],
      "contract_ref": "ClassInfoAPI (provider: Class Service)"
    },
    {
      "name": "ClassDetailAPI",
      "endpoint": "GET /api/v1/classes/{id}",
      "description": "获取班级详细信息，包括班主任和学生人数",
      "parameters": [
        {"name": "id", "type": "integer", "description": "班级 ID，路径参数，必填"}
      ],
      "contract_ref": "ClassDetailAPI (provider: Class Service)"
    },
    {
      "name": "CreateClassAPI",
      "endpoint": "POST /api/v1/classes",
      "description": "创建新班级",
      "parameters": [
        {"name": "name", "type": "string", "description": "班级名称，必填"},
        {"name": "grade_id", "type": "integer", "description": "所属年级 ID，必填"},
        {"name": "head_teacher", "type": "string", "description": "班主任姓名，选填"},
        {"name": "capacity", "type": "integer", "description": "班级容量上限，选填"}
      ],
      "contract_ref": "CreateClassAPI (provider: Class Service)"
    },
    {
      "name": "ClassStudentsAPI",
      "endpoint": "GET /api/v1/classes/{id}/students",
      "description": "查询指定班级的学生名单",
      "parameters": [
        {"name": "id", "type": "integer", "description": "班级 ID，路径参数，必填"}
      ],
      "contract_ref": "ClassStudentsAPI (provider: Class Service)"
    },
    {
      "name": "GradeInfoAPI",
      "endpoint": "GET /api/v1/grades",
      "description": "分页查询年级列表，支持按学年和学段过滤",
      "parameters": [
        {"name": "academic_year", "type": "string", "description": "按学年过滤，选填"},
        {"name": "stage", "type": "string", "description": "按学段过滤（小学/初中/高中），选填"},
        {"name": "page", "type": "integer", "description": "页码，选填"},
        {"name": "page_size", "type": "integer", "description": "每页条数，选填"}
      ],
      "contract_ref": "GradeInfoAPI (provider: Grade Service)"
    },
    {
      "name": "GradeDetailAPI",
      "endpoint": "GET /api/v1/grades/{id}",
      "description": "获取年级详细信息",
      "parameters": [
        {"name": "id", "type": "integer", "description": "年级 ID，路径参数，必填"}
      ],
      "contract_ref": "GradeDetailAPI (provider: Grade Service)"
    },
    {
      "name": "CreateGradeAPI",
      "endpoint": "POST /api/v1/grades",
      "description": "创建新年级",
      "parameters": [
        {"name": "name", "type": "string", "description": "年级名称，必填"},
        {"name": "stage", "type": "string", "description": "学段（小学/初中/高中），必填"},
        {"name": "academic_year", "type": "string", "description": "所属学年，必填"}
      ],
      "contract_ref": "CreateGradeAPI (provider: Grade Service)"
    },
    {
      "name": "StatisticsAPI",
      "endpoint": "GET /api/v1/statistics/overview",
      "description": "获取统计概览数据，支持按学生/班级/年级维度查看",
      "parameters": [
        {"name": "scope", "type": "string", "description": "统计范围: student/class/grade，必填"},
        {"name": "scope_id", "type": "integer", "description": "对应范围 ID，必填"},
        {"name": "start_date", "type": "string", "description": "统计开始日期，选填"},
        {"name": "end_date", "type": "string", "description": "统计结束日期，选填"}
      ],
      "contract_ref": "StatisticsAPI (provider: Statistics Service)"
    },
    {
      "name": "StatisticsExportAPI",
      "endpoint": "GET /api/v1/statistics/export",
      "description": "导出统计报表，支持 CSV/PDF 格式",
      "parameters": [
        {"name": "scope", "type": "string", "description": "统计范围，必填"},
        {"name": "scope_id", "type": "integer", "description": "对应范围 ID，必填"},
        {"name": "format", "type": "string", "description": "导出格式，csv/pdf，选填"}
      ],
      "contract_ref": "StatisticsExportAPI (provider: Statistics Service)"
    }
  ],
  "error_handling": "前端统一通过 HTTP 拦截器处理异常响应：4xx 类错误根据状态码和角色跳转登录页或提示权限不足；5xx 类错误展示全局错误提示并记录日志。请求超时阈值为 15 秒，超时后提示用户重试。表单提交时启用前端字段校验，如学号格式、必填项检查等，校验未通过不发起请求"
}
