{
  "meta": {
    "doc_id": "lld-Web UI-001",
    "type": "lld",
    "module": "Web UI",
    "title": "LLD - Web UI",
    "author": "design_agent",
    "created": "2026-05-20 11:22"
  },
  "overview": "基于 Vue.js 3 + Vite 的单页应用，采用 Composition API + <script setup> 模式开发。页面布局采用左侧导航栏 + 右侧内容区的经典管理后台结构。状态管理使用 Pinia，路由使用 Vue Router 4，HTTP 通信使用 Axios。图表展示使用 ECharts。项目以 views（页面级组件）→ components（可复用 UI 组件）→ api（接口封装层）→ stores（状态管理）→ router（路由配置）的目录结构组织代码。",
  "data_models": [
    {
      "name": "Student",
      "type": "frontend_store",
      "fields": [
        { "name": "id", "type": "number", "description": "学生 ID，唯一标识" },
        { "name": "name", "type": "string", "description": "学生姓名" },
        { "name": "studentNo", "type": "string", "description": "学号，全局唯一" },
        { "name": "gender", "type": "string", "description": "性别：male / female" },
        { "name": "phone", "type": "string", "description": "联系方式" },
        { "name": "classId", "type": "number | null", "description": "所属班级 ID，未分配时为 null" },
        { "name": "className", "type": "string", "description": "所属班级名称（展示用）" },
        { "name": "createdAt", "type": "string", "description": "创建时间，ISO 8601 格式" }
      ]
    },
    {
      "name": "Class",
      "type": "frontend_store",
      "fields": [
        { "name": "id", "type": "number", "description": "班级 ID，唯一标识" },
        { "name": "name", "type": "string", "description": "班级名称，如 '高一(3)班'" },
        { "name": "gradeId", "type": "number", "description": "所属年级 ID" },
        { "name": "gradeName", "type": "string", "description": "所属年级名称（展示用）" },
        { "name": "studentCount", "type": "number", "description": "班级人数" },
        { "name": "createdAt", "type": "string", "description": "创建时间" }
      ]
    },
    {
      "name": "Grade",
      "type": "frontend_store",
      "fields": [
        { "name": "id", "type": "number", "description": "年级 ID，唯一标识" },
        { "name": "name", "type": "string", "description": "年级名称，如 '高一'、'高二'、'高三'" },
        { "name": "classCount", "type": "number", "description": "下辖班级数量" },
        { "name": "createdAt", "type": "string", "description": "创建时间" }
      ]
    },
    {
      "name": "StudentStatistics",
      "type": "frontend_store",
      "fields": [
        { "name": "studentId", "type": "number", "description": "学生 ID" },
        { "name": "studentName", "type": "string", "description": "学生姓名" },
        { "name": "totalScore", "type": "number", "description": "总成绩" },
        { "name": "averageScore", "type": "number", "description": "平均成绩" },
        { "name": "attendanceRate", "type": "number", "description": "出勤率，百分比 0-100" },
        { "name": "subjectScores", "type": "array<{subject:string,score:number}>", "description": "各科目成绩列表" },
        { "name": "trend", "type": "array<{period:string,score:number}>", "description": "成绩趋势数据" }
      ]
    },
    {
      "name": "ClassStatistics",
      "type": "frontend_store",
      "fields": [
        { "name": "classId", "type": "number", "description": "班级 ID" },
        { "name": "className", "type": "string", "description": "班级名称" },
        { "name": "studentCount", "type": "number", "description": "班级人数" },
        { "name": "classAverage", "type": "number", "description": "班级平均成绩" },
        { "name": "passRate", "type": "number", "description": "及格率，百分比" },
        { "name": "topStudent", "type": "string", "description": "班级第一名姓名" },
        { "name": "scoreDistribution", "type": "array<{range:string,count:number}>", "description": "成绩分布区间数据" }
      ]
    },
    {
      "name": "GradeStatistics",
      "type": "frontend_store",
      "fields": [
        { "name": "gradeId", "type": "number", "description": "年级 ID" },
        { "name": "gradeName", "type": "string", "description": "年级名称" },
        { "name": "totalStudents", "type": "number", "description": "全年级学生总数" },
        { "name": "classCount", "type": "number", "description": "班级总数" },
        { "name": "gradeAverage", "type": "number", "description": "年级平均成绩" },
        { "name": "classRanking", "type": "array<{classId:number,className:string,averageScore:number}>", "description": "班级成绩排名列表" }
      ]
    },
    {
      "name": "PageQuery",
      "type": "frontend_store",
      "fields": [
        { "name": "page", "type": "number", "description": "当前页码，从 1 开始" },
        { "name": "pageSize", "type": "number", "description": "每页条数，默认 20" },
        { "name": "total", "type": "number", "description": "总记录数" },
        { "name": "keyword", "type": "string", "description": "搜索关键词" }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "学生列表查询",
      "endpoint": "GET /api/students",
      "description": "分页查询学生列表，支持按关键词搜索",
      "parameters": [
        { "name": "page", "type": "number", "description": "页码，默认 1" },
        { "name": "pageSize", "type": "number", "description": "每页条数，默认 20" },
        { "name": "keyword", "type": "string", "description": "搜索关键词（匹配学号或姓名），可选" },
        { "name": "classId", "type": "number", "description": "按班级筛选，可选" }
      ]
    },
    {
      "name": "学生详情查询",
      "endpoint": "GET /api/students/:id",
      "description": "根据 ID 获取单个学生的详细信息",
      "parameters": [
        { "name": "id", "type": "number", "description": "学生 ID（路径参数）" }
      ]
    },
    {
      "name": "创建学生",
      "endpoint": "POST /api/students",
      "description": "新增一条学生档案记录",
      "parameters": [
        { "name": "name", "type": "string", "description": "学生姓名" },
        { "name": "studentNo", "type": "string", "description": "学号" },
        { "name": "gender", "type": "string", "description": "性别，male/female" },
        { "name": "phone", "type": "string", "description": "联系方式" },
        { "name": "classId", "type": "number", "description": "所属班级 ID，可选" }
      ]
    },
    {
      "name": "更新学生",
      "endpoint": "PUT /api/students/:id",
      "description": "更新指定学生的基本信息",
      "parameters": [
        { "name": "id", "type": "number", "description": "学生 ID（路径参数）" },
        { "name": "name", "type": "string", "description": "学生姓名" },
        { "name": "gender", "type": "string", "description": "性别" },
        { "name": "phone", "type": "string", "description": "联系方式" },
        { "name": "classId", "type": "number", "description": "所属班级 ID" }
      ]
    },
    {
      "name": "删除学生",
      "endpoint": "DELETE /api/students/:id",
      "description": "删除指定学生的档案记录",
      "parameters": [
        { "name": "id", "type": "number", "description": "学生 ID（路径参数）" }
      ]
    },
    {
      "name": "班级列表查询",
      "endpoint": "GET /api/classes",
      "description": "分页查询班级列表，支持按年级筛选",
      "parameters": [
        { "name": "page", "type": "number", "description": "页码" },
        { "name": "pageSize", "type": "number", "description": "每页条数" },
        { "name": "gradeId", "type": "number", "description": "按年级筛选，可选" }
      ]
    },
    {
      "name": "班级详情查询",
      "endpoint": "GET /api/classes/:id",
      "description": "获取指定班级的详细信息",
      "parameters": [
        { "name": "id", "type": "number", "description": "班级 ID（路径参数）" }
      ]
    },
    {
      "name": "班级成员列表",
      "endpoint": "GET /api/classes/:id/students",
      "description": "获取指定班级的学生成员列表",
      "parameters": [
        { "name": "id", "type": "number", "description": "班级 ID（路径参数）" },
        { "name": "page", "type": "number", "description": "页码" },
        { "name": "pageSize", "type": "number", "description": "每页条数" }
      ]
    },
    {
      "name": "创建班级",
      "endpoint": "POST /api/classes",
      "description": "新建一个班级",
      "parameters": [
        { "name": "name", "type": "string", "description": "班级名称" },
        { "name": "gradeId", "type": "number", "description": "所属年级 ID" }
      ]
    },
    {
      "name": "更新班级",
      "endpoint": "PUT /api/classes/:id",
      "description": "更新班级信息",
      "parameters": [
        { "name": "id", "type": "number", "description": "班级 ID（路径参数）" },
        { "name": "name", "type": "string", "description": "班级名称" },
        { "name": "gradeId", "type": "number", "description": "所属年级 ID" }
      ]
    },
    {
      "name": "删除班级",
      "endpoint": "DELETE /api/classes/:id",
      "description": "删除指定班级",
      "parameters": [
        { "name": "id", "type": "number", "description": "班级 ID（路径参数）" }
      ]
    },
    {
      "name": "分配学生到班级",
      "endpoint": "POST /api/classes/:id/assign",
      "description": "将指定学生分配到班级",
      "parameters": [
        { "name": "id", "type": "number", "description": "班级 ID（路径参数）" },
        { "name": "studentIds", "type": "number[]", "description": "学生 ID 数组" }
      ]
    },
    {
      "name": "从班级移除学生",
      "endpoint": "POST /api/classes/:id/remove",
      "description": "将指定学生从班级中移除",
      "parameters": [
        { "name": "id", "type": "number", "description": "班级 ID（路径参数）" },
        { "name": "studentIds", "type": "number[]", "description": "学生 ID 数组" }
      ]
    },
    {
      "name": "年级列表查询",
      "endpoint": "GET /api/grades",
      "description": "获取全年级列表，按创建时间排序",
      "parameters": [
        { "name": "page", "type": "number", "description": "页码" },
        { "name": "pageSize", "type": "number", "description": "每页条数" }
      ]
    },
    {
      "name": "创建年级",
      "endpoint": "POST /api/grades",
      "description": "新建一个年级",
      "parameters": [
        { "name": "name", "type": "string", "description": "年级名称" }
      ]
    },
    {
      "name": "更新年级",
      "endpoint": "PUT /api/grades/:id",
      "description": "更新年级名称",
      "parameters": [
        { "name": "id", "type": "number", "description": "年级 ID（路径参数）" },
        { "name": "name", "type": "string", "description": "年级名称" }
      ]
    },
    {
      "name": "删除年级",
      "endpoint": "DELETE /api/grades/:id",
      "description": "删除指定年级",
      "parameters": [
        { "name": "id", "type": "number", "description": "年级 ID（路径参数）" }
      ]
    },
    {
      "name": "年级下班级列表",
      "endpoint": "GET /api/grades/:id/classes",
      "description": "获取指定年级下的所有班级",
      "parameters": [
        { "name": "id", "type": "number", "description": "年级 ID（路径参数）" }
      ]
    },
    {
      "name": "归属班级到年级",
      "endpoint": "POST /api/grades/:id/assign",
      "description": "将指定班级归属到该年级",
      "parameters": [
        { "name": "id", "type": "number", "description": "年级 ID（路径参数）" },
        { "name": "classIds", "type": "number[]", "description": "班级 ID 数组" }
      ]
    },
    {
      "name": "学生统计数据查询",
      "endpoint": "GET /api/statistics/students/:id",
      "description": "获取指定学生的学习统计数据",
      "parameters": [
        { "name": "id", "type": "number", "description": "学生 ID（路径参数）" }
      ]
    },
    {
      "name": "班级统计汇总",
      "endpoint": "GET /api/statistics/classes/:id",
      "description": "获取指定班级的统计数据汇总",
      "parameters": [
        { "name": "id", "type": "number", "description": "班级 ID（路径参数）" }
      ]
    },
    {
      "name": "年级统计汇总",
      "endpoint": "GET /api/statistics/grades/:id",
      "description": "获取指定年级的统计数据汇总",
      "parameters": [
        { "name": "id", "type": "number", "description": "年级 ID（路径参数）" }
      ]
    },
    {
      "name": "全年级班级排名",
      "endpoint": "GET /api/statistics/grades/:id/ranking",
      "description": "获取年级内各班级的成绩排名",
      "parameters": [
        { "name": "id", "type": "number", "description": "年级 ID（路径参数）" }
      ]
    }
  ],
  "error_handling": "HTTP 请求异常统一由 Axios 响应拦截器捕获，按 status code 分类处理：4xx 错误在页面顶部以黄色警告条展示后端返回的错误消息（如学号重复、资源不存在），5xx 错误展示红色错误提示并附带'系统繁忙，请稍后重试'文案。网络断开时展示全页遮罩层提示'网络连接已断开'。表单校验在前端做第一道防线（必填项、格式校验），提交后即使后端返回 400 也继续展示后端的具体校验提示，避免前后端校验不一致时用户困惑。所有列表页加载中展示骨架屏，查询失败时列表区域展示空状态插画+重试按钮。",
  "views": [
    {
      "name": "StudentListView",
      "description": "学生列表页，展示分页学生表格，支持关键词搜索、按班级筛选",
      "components": ["SearchBar", "DataTable", "Pagination", "DeleteConfirmDialog"],
      "route": "/students"
    },
    {
      "name": "StudentFormView",
      "description": "学生新增/编辑表单页，通过路由参数区分新增与编辑模式",
      "components": ["StudentForm"],
      "route": "/students/create | /students/:id/edit"
    },
    {
      "name": "ClassListView",
      "description": "班级列表页，展示分页班级表格，支持按年级筛选",
      "components": ["SearchBar", "DataTable", "Pagination", "DeleteConfirmDialog"],
      "route": "/classes"
    },
    {
      "name": "ClassDetailView",
      "description": "班级详情页，展示班级信息及成员列表，支持添加/移出学生",
      "components": ["ClassInfoCard", "StudentTable", "AssignStudentDialog"],
      "route": "/classes/:id"
    },
    {
      "name": "ClassFormView",
      "description": "班级新增/编辑表单页",
      "components": ["ClassForm"],
      "route": "/classes/create | /classes/:id/edit"
    },
    {
      "name": "GradeListView",
      "description": "年级列表页，展示年级卡片，每个卡片内展示所属班级列表",
      "components": ["GradeCard", "ClassListTable", "DeleteConfirmDialog"],
      "route": "/grades"
    },
    {
      "name": "GradeFormView",
      "description": "年级新增/编辑表单页",
      "components": ["GradeForm"],
      "route": "/grades/create | /grades/:id/edit"
    },
    {
      "name": "StatisticsDashboard",
      "description": "统计看板首页，提供按年级/班级/学生下钻的导航入口",
      "components": ["StatCardGroup", "QuickNavPanel"],
      "route": "/statistics"
    },
    {
      "name": "StudentStatView",
      "description": "学生个人统计详情页，展示成绩趋势图、各科目得分雷达图",
      "components": ["ScoreTrendChart", "SubjectRadarChart", "StatSummaryCard"],
      "route": "/statistics/students/:id"
    },
    {
      "name": "ClassStatView",
      "description": "班级统计页，展示班级平均分、及格率、成绩分布饼图",
      "components": ["ScoreDistributionChart", "ClassStatSummary", "TopStudentCard"],
      "route": "/statistics/classes/:id"
    },
    {
      "name": "GradeStatView",
      "description": "年级统计页，展示年级总览及班级排名柱状图",
      "components": ["GradeStatSummary", "ClassRankingBarChart", "GradeTrendChart"],
      "route": "/statistics/grades/:id"
    }
  ],
  "shared_components": [
    {
      "name": "AppLayout",
      "description": "应用主布局，左侧导航菜单 + 顶部面包屑 + 右侧内容区"
    },
    {
      "name": "SearchBar",
      "description": "通用搜索栏，包含关键词输入框和筛选下拉选框，emit search 事件"
    },
    {
      "name": "DataTable",
      "description": "通用数据表格，支持列配置、排序、行操作按钮插槽"
    },
    {
      "name": "Pagination",
      "description": "分页器组件，基于页码和总数渲染分页按钮"
    },
    {
      "name": "DeleteConfirmDialog",
      "description": "删除确认弹窗，提示不可恢复警告并要求二次确认"
    },
    {
      "name": "FormModal",
      "description": "通用表单模态框，包裹业务表单并提供保存/取消按钮"
    },
    {
      "name": "ChartContainer",
      "description": "图表容器组件，统一 ECharts 初始化、resize 监听和 loading 状态"
    },
    {
      "name": "StatSummaryCard",
      "description": "统计摘要卡片，展示单个数值指标（如平均分、出勤率）"
    }
  ]
}
