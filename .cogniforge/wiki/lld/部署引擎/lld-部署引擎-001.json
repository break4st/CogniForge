        }
      ]
    },
    {
      "name": "ConnectionConfig",
      "object_type": "value_object",
      "description": "SSH连接所需参数集合，聚合自EnvironmentInfo和SSHKeyMaterial",
      "attributes": [
        {
          "name": "host",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "远程主机"
        },
        {
          "name": "port",
          "type": "number",
          "required": true,
          "source": "derived",
          "description": "SSH端口"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "登录用户名"
        },
        {
          "name": "privateKey",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "PEM格式私钥"
