        {
          "name": "id",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "记录唯一标识，UUID"
        },
        {
          "name": "envId",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "关联的环境ID"
        },
        {
          "name": "localFilePath",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "本地文件路径"
        },
        {
          "name": "remoteDeployPath",
          "type": "string",
          "required": true,
