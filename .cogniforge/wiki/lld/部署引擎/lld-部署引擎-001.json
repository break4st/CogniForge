  ],
  "service_contracts": [
    {
      "name": "DeployEngineService",
      "description": "负责接收部署请求，协调环境管理、密钥管理、SSH客户端等模块，执行文件上传、脚本生成、符号链接更新等部署步骤，并实时推送部署进度。",
      "methods": [
        {
          "name": "startDeploy",
          "signature": "(deployRequest: DeployRequest) -> Observable<DeployProgress>",
          "precondition": "传入的 deployRequest 必须包含有效的 envId, localFilePath, remoteDeployPath；环境及关联密钥必须存在且可用。",
          "postcondition": "部署成功：文件已上传至远程新版本目录，启动脚本已生成，current 符号链接已更新，部署记录已持久化；部署失败：远程已部分创建的文件和目录被清理，部署记录标记为失败。进度事件流正常结束。",
          "description": "启动部署的主流程。返回一个可观察对象，实时推送部署进度。",
          "exceptions": [
            {
              "name": "EnvironmentNotFoundException",
              "trigger": "根据 envId 无法找到对应的环境",
              "http_status": 404
            },
            {
              "name": "KeyRetrievalException",
              "trigger": "无法获取关联密钥或私钥解密失败",
              "http_status": 500
            },
            {
              "name": "ConnectionFailedException",
              "trigger": "SSH 连接建立失败",
              "http_status": 502
            },
            {
              "name": "FileUploadFailedException",
              "trigger": "文件上传过程中出错",
              "http_status": 500
            },
            {
              "name": "RemoteExecutionException",
              "trigger": "远程命令执行失败",
              "http_status": 500
            }
          ]
        },
        {
          "name": "cancelDeploy",
          "signature": "(deployId: string) -> void",
          "precondition": "部署正在进行中，存在对应的部署ID。",
          "postcondition": "部署流程被标记为取消，正在进行的操作将被中断或回滚，进度事件流发送取消状态。",
          "description": "取消正在进行的部署（保留，暂不实现）。",
          "exceptions": [
            {
              "name": "DeployNotFoundException",
              "trigger": "未找到进行中的部署",
              "http_status": 404
            }
          ]
        },
        {
          "name": "onProgress",
          "signature": "(event: DeployProgress) -> void",
          "precondition": "部署流程已启动，存在有效的 IPC 通道。",
          "postcondition": "进度事件通过 IPC 发送到 GUI 渲染进程。",
          "description": "用于推送部署进度事件的内部方法，通过调用 IPC 模块实现。",
          "exceptions": []
        }
      ],
      "repository_dependencies": [
        "findEnvironmentById(envId: string) -> EnvironmentInfo?",
        "findKeyMaterialById(keyId: string) -> SSHKeyMaterial?",
        "saveDeployRecord(record: DeployRecord) -> void",
        "updateDeployRecordStatus(deployId: string, status: string) -> void"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "部署前必须验证本地文件存在，否则拒绝部署",
      "远程部署路径必须以 '/' 开头且不为根目录 '/'",
      "同一环境同一时间只能有一个部署任务在执行",
      "版本目录名必须唯一，格式为 'v_YYYYMMDD_HHmmss_SSS' 避免冲突",
      "current符号链接必须始终指向一个已成功部署的版本目录",
      "部署过程中任何一步失败都应清理已创建的远程版本目录（如果有）",
      "部署记录必须在部署结束（成功或失败）后立即持久化到数据库"
    ],
    "state_machines": [
      {
        "entity": "Deployment",
        "states": [
          "PENDING",
          "PREPARING",
          "CONNECTING",
          "UPLOADING",
          "GENERATING_SCRIPT",
          "UPDATING_SYMLINK",
          "RECORDING",
          "SUCCEEDED",
          "FAILED",
          "CANCELLED"
        ],
        "transitions": [
          {
            "from": "PENDING",
            "to": "PREPARING",
            "trigger": "startDeploy()调用",
            "actor": "用户"
          },
          {
            "from": "PREPARING",
            "to": "CONNECTING",
            "trigger": "环境信息与密钥获取成功",
            "actor": "系统"
          },
          {
            "from": "PREPARING",
            "to": "FAILED",
            "trigger": "环境或密钥获取失败",
            "actor": "系统"
          },
          {
            "from": "CONNECTING",
            "to": "UPLOADING",
            "trigger": "SSH连接建立成功",
            "actor": "系统"
          },
          {
            "from": "CONNECTING",
            "to": "FAILED",
            "trigger": "SSH连接失败",
            "actor": "系统"
          },
          {
            "from": "UPLOADING",
            "to": "GENERATING_SCRIPT",
            "trigger": "文件上传全部完成",
            "actor": "系统"
          },
          {
            "from": "UPLOADING",
            "to": "FAILED",
            "trigger": "文件上传过程中出错",
            "actor": "系统"
          },
          {
            "from": "GENERATING_SCRIPT",
            "to": "UPDATING_SYMLINK",
            "trigger": "启动脚本生成并上传成功",
            "actor": "系统"
          },
          {
            "from": "GENERATING_SCRIPT",
            "to": "FAILED",
            "trigger": "脚本生成或上传失败",
            "actor": "系统"
          },
          {
            "from": "UPDATING_SYMLINK",
            "to": "RECORDING",
            "trigger": "符号链接更新成功",
            "actor": "系统"
          },
          {
            "from": "UPDATING_SYMLINK",
            "to": "FAILED",
            "trigger": "符号链接更新失败，且无法回滚",
            "actor": "系统"
          },
          {
            "from": "RECORDING",
            "to": "SUCCEEDED",
            "trigger": "部署记录保存成功",
            "actor": "系统"
          },
          {
            "from": "RECORDING",
            "to": "FAILED",
            "trigger": "部署记录保存失败",
            "actor": "系统"
          }
        ],
        "irreversible_rules": [
          "一旦状态变为FAILED或SUCCEEDED，不能回退到其他状态",
          "进入UPLOADING后不能回退到PREPARING或CONNECTING",
          "取消操作仅在PENDING、PREPARING或CONNECTING状态下可能执行（暂不实现接口，规则预留）"
        ],
        "concurrency": "通过环境级别的互斥锁保证同一环境同一时刻只有一个活动部署；若新请求到达时已有部署处于非终态（FAILED/SUCCEEDED），则拒绝新请求并返回错误。"
      }
    ],
    "cross_service_rules": [
      "部署引擎必须通过环境管理模块（CTR-007）获取环境详情，不得直接访问环境数据库",
      "解密后的私钥必须通过密钥管理模块（CTR-008）获取，部署引擎不得缓存或存储私钥",
      "SSH连接配置（DO-007）由部署引擎组装，但连接建立与命令执行必须通过SSH客户端模块进行",
      "部署进度事件（DO-002）必须通过IPC主动推送到GUI（IF-003），频率至少在每个状态变更时推送",
      "部署记录持久化使用本地数据库，但表结构由本地数据库模块维护，部署引擎仅通过数据访问层操作"
    ]
  },
  "workflow": {
    "name": "部署执行主流程",
    "description": "部署引擎的主流程，按顺序执行环境准备、密钥获取、连接建立、文件上传、脚本生成、符号链接更新及记录持久化。",
    "steps": [
      {
        "order": 1,
        "name": "验证请求参数",
        "action": "检查 envId, localFilePath, remoteDeployPath 的存在性和有效性",
        "timeout_seconds": 5,
        "on_failure": "返回参数错误，部署终止"
      },
      {
        "order": 2,
        "name": "获取环境信息",
        "action": "调用环境管理模块获取环境详情及关联的密钥ID",
        "timeout_seconds": 10,
        "on_failure": "返回环境不存在错误，部署终止"
      },
      {
        "order": 3,
        "name": "获取SSH密钥",
        "action": "调用密钥管理模块获取解密后的私钥",
        "timeout_seconds": 10,
        "on_failure": "返回密钥获取失败错误，部署终止"
      },
      {
        "order": 4,
        "name": "建立SSH连接",
        "action": "使用环境信息和私钥建立SFTP连接",
        "timeout_seconds": 15,
        "on_failure": "返回连接失败错误，部署终止"
      },
      {
        "order": 5,
        "name": "创建远程版本目录",
        "action": "在远程部署路径下创建基于时间戳的版本目录",
        "timeout_seconds": 10,
        "on_failure": "返回远程文件操作失败错误，部署终止"
      },
      {
        "order": 6,
        "name": "上传文件",
        "action": "将本地文件递归上传到远程版本目录",
        "timeout_seconds": 300,
        "on_failure": "清理已创建的版本目录，返回上传失败错误，部署终止"
      },
      {
        "order": 7,
        "name": "生成启动脚本",
        "action": "在版本目录中生成标准启动脚本",
        "timeout_seconds": 10,
        "on_failure": "清理已上传的内容，返回远程执行失败错误，部署终止"
      },
      {
        "order": 8,
        "name": "更新符号链接",
        "action": "将 current 符号链接指向新版本目录",
        "timeout_seconds": 10,
        "on_failure": "返回符号链接更新失败错误，部署终止（不清理，避免影响现有版本）"
      },
      {
        "order": 9,
        "name": "保存部署记录",
        "action": "将部署结果写入数据库",
        "timeout_seconds": 5,
        "on_failure": "记录日志但不影响部署成功状态（最终一致性）"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": ["NETWORK_ERROR", "TIMEOUT"],
      "non_retryable_errors": ["AUTH_ERROR", "CONFIG_ERROR"]
    }
  }
}