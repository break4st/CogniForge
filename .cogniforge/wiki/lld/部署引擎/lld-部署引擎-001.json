  "module_boundary": {
    "in_scope": [
      "接收部署请求（envId, localFilePath, remoteDeployPath）",
      "通过环境管理模块获取环境详情及关联密钥",
      "通过密钥管理模块获取解密私钥",
      "建立SFTP连接并上传文件至远程新建版本目录",
      "生成启动脚本",
      "更新current符号链接",
      "部署过程中实时推送进度事件",
      "部署失败清理不完整文件",
      "部署成功后保存部署记录"
    ],
    "out_of_scope": [
      "环境配置的增删改查（由环境管理模块负责）",
      "密钥的导入、加密存储和检索（由密钥管理模块负责）",
      "历史记录的查询与回滚（由历史管理模块负责）",
      "SSH底层连接管理（由SSH客户端模块负责）",
      "数据库表的定义与维护（由本地数据库负责）"
    ],
    "owned_components": ["CMP-005"],
    "owned_contracts": ["CTR-005"],
    "consumed_contracts": ["CTR-007", "CTR-008"],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "部署引擎负责解析部署请求，协调环境管理、密钥管理、SSH客户端等模块，执行文件上传、脚本生成、符号链接更新等部署步骤，并实时推送部署进度。",
    "dependencies": [
      "环境管理模块（获取环境及关联密钥信息）",
      "密钥管理模块（获取解密后的SSH私钥）",
      "SSH客户端模块（建立连接、上传文件、执行远程命令）",
      "本地数据库（保存部署记录）"
    ],
    "tech_stack": [
      "Node.js (主进程)",
      "Electron",
      "ssh2",
      "SQLite"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": ["CMP-005"],
      "sad_contract_ids": ["CTR-005", "CTR-007", "CTR-008"],
      "lld_objects": {
        "data_models": ["DM-001"],
        "interfaces": ["IF-001", "IF-003"],
        "domain_objects": [
          "DO-001",
          "DO-002",
          "DO-003",
          "DO-004",
          "DO-005",
          "DO-006",
          "DO-007",
          "DO-008",
          "DO-009"
        ],
        "service_contracts": ["SC-001"]
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "部署记录视图",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployment_records"
      },
      "description": "映射到部署记录数据库表，用于持久化部署结果。由本地数据库维护，本服务负责写入。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "env_id",
          "type": "TEXT",
          "required": true,
          "description": "部署的目标环境ID"
        },
        {
          "name": "local_file_path",
          "type": "TEXT",
          "required": true,
          "description": "本地待部署文件的路径"
        },
        {
          "name": "remote_deploy_path",
          "type": "TEXT",
          "required": true,
          "description": "远程目标部署根路径"
        },
        {
          "name": "version",
          "type": "TEXT",
          "required": true,
          "description": "部署生成的版本号（时间戳格式）"
        },
        {
          "name": "status",
          "type": "TEXT",
          "required": true,
          "description": "部署状态：'success', 'failed', 'cancelled'"
        },
        {
          "name": "started_at",
          "type": "TEXT",
          "required": true,
          "description": "部署开始时间（ISO 8601格式）"
        },
        {
          "name": "finished_at",
          "type": "TEXT",
          "required": false,
          "description": "部署结束时间（ISO 8601格式），失败或取消时仍有值"
        },
        {
          "name": "error_message",
          "type": "TEXT",
          "required": false,
          "description": "失败或取消时的错误信息"
        },
        {
          "name": "file_manifest",
          "type": "TEXT",
          "required": false,
          "description": "JSON格式的上传文件清单，包含文件名、大小和远程路径"
        }
      ],
      "indexes": [
        {
          "name": "idx_deployment_records_env_id",
          "unique": false,
          "columns": [
            "env_id"
          ]
        },
        {
          "name": "idx_deployment_records_started_at",
          "unique": false,
          "columns": [
            "started_at"
          ]
        }
      ],
      "source_requirements": ["REQ-003"],
      "source_components": ["CMP-005"],
      "source_contracts": ["CTR-005"],
      "constraints": [
        "file_manifest字段存储JSON字符串，应用层负责序列化和反序列化"
      ],
      "lifecycle": {
        "create": "部署成功后由部署引擎写入，部署失败时也写入（含错误信息）",
        "update": "通常只创建，不更新。如需更新状态，在部署取消时可能更新status和finished_at",
        "delete": "由历史管理模块或手动清理，本服务不负责删除",
        "retention": "长期保留，具体清理策略由历史管理模块定义"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建部署记录视图",
          "reason": "首次生成部署引擎LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "部署开始接口",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-005",
      "provider_component_id": "CMP-005",
      "method": "POST",
      "endpoint": "/api/deploy/start",
      "description": "启动部署流程，接收环境ID、本地文件路径、远程部署路径等参数，异步执行部署，并实时推送进度。",
      "parameters": [],
      "request_body": {
        "envId": "string (UUID)",
        "localFilePath": "string (绝对路径)",
        "remoteDeployPath": "string (基础路径)"
      },
      "response": {
        "status": 202,
        "body": {
          "deployId": "string (UUID)",
          "status": "string (accepted)"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_PARAMS",
          "message": "请求参数缺失或格式错误"
        },
        {
          "status": 404,
          "code": "ENV_NOT_FOUND",
          "message": "指定的环境不存在"
        },
        {
          "status": 500,
          "code": "DEPLOY_FAILED",
          "message": "部署过程中发生异常"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "envId 必须为非空UUID",
        "localFilePath 必须为存在的文件或目录路径",
        "remoteDeployPath 必须为非空字符串"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-003"],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "部署取消接口",
      "status": "changed",
      "version": 1,
      "source_contract_id": "CTR-005",
      "provider_component_id": "CMP-005",
      "method": "POST",
      "endpoint": "/api/deploy/cancel",
      "description": "取消正在进行的部署（暂未实现，保留）。",
      "parameters": [],
      "request_body": {
        "deployId": "string (UUID)"
      },
      "response": {
        "status": 501,
        "body": {
          "message": "功能未实现"
        }
      },
      "error_codes": [],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "保留接口，暂不实现",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "进度事件推送接口",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-005",
      "provider_component_id": "CMP-005",
      "method": "INTERNAL",
      "endpoint": "ipc://deploy-progress",
      "description": "通过 Electron IPC 向渲染进程推送部署进度事件，包含当前步骤、总体百分比、消息等。",
      "parameters": [],
      "request_body": {
        "deployId": "string (UUID)",
        "step": "string (UPLOADING|SYMLINKING|等)",
        "progress": "number (0-100)",
        "message": "string"
      },
      "response": {
        "status": 0,
        "body": "void (无响应)"
      },
      "error_codes": [],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-003"],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "所有部署错误统一通过 try-catch 捕获，转换为标准错误响应体（DeployError），包含业务错误码与详细信息，并通过进度事件推送错误状态。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "参数错误",
        "description": "缺少必要参数（envId, localFilePath, remoteDeployPath）或格式无效，返回错误码 4001。"
      },
      {
        "code": "4xx",
        "name": "环境不存在",
        "description": "通过环境管理模块查询环境信息时，若环境不存在或已删除，返回错误码 4002。"
      },
      {
        "code": "4xx",
        "name": "密钥获取失败",
        "description": "关联密钥不存在或密钥管理模块无法解密，返回错误码 4003。"
      },
      {
        "code": "4xx",
        "name": "本地文件不存在",
        "description": "指定的 localFilePath 在本地文件系统中不存在，返回错误码 4004。"
      },
      {
        "code": "5xx",
        "name": "SFTP连接或认证失败",
        "description": "SSH客户端无法建立连接或认证失败（主机不可达、端口错误、密钥不匹配等），返回错误码 5001。"
      },
      {
        "code": "5xx",
        "name": "远程文件操作失败",
        "description": "上传文件、创建目录、更新符号链接等远程操作失败，或远程磁盘空间不足，返回错误码 5002。"
      },
      {
        "code": "5xx",
        "name": "部署过程异常中断",
        "description": "部署过程中发生未预期错误（如网络中断、进程崩溃），已上传内容将被清理，返回错误码 5003。"
      },
      {
        "code": "5xx",
        "name": "进度推送失败",
        "description": "向GUI推送进度事件时IPC通道异常，不影响部署主流程，但会记录日志，返回错误码 5004。"
      }
    ]
  },
  "domain_objects": [
    {
      "name": "DeployRequest",
      "object_type": "dto",
      "description": "部署请求参数实体，由GUI层传入",
      "attributes": [
        {
          "name": "envId",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "目标环境唯一标识"
        },
        {
          "name": "localFilePath",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "本地待部署文件的完整路径"
        },
        {
          "name": "remoteDeployPath",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "远程服务器上的部署根路径"
        }
      ]
    },
    {
      "name": "DeployProgress",
      "object_type": "dto",
      "description": "部署进度事件数据结构，通过IPC推送给GUI",
      "attributes": [
        {
          "name": "step",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "当前部署步骤标识，如'connecting', 'uploading', 'linking'"
        },
        {
          "name": "percent",
          "type": "number",
          "required": true,
          "source": "derived",
          "description": "整体进度百分比，0-100"
        },
        {
          "name": "message",
          "type": "string",
          "required": false,
          "source": "derived",
          "description": "可选的进度描述信息"
        }
      ]
    },
    {
      "name": "DeployResult",
      "object_type": "dto",
      "description": "部署成功后的响应体",
      "attributes": [
        {
          "name": "success",
          "type": "boolean",
          "required": true,
          "source": "derived",
          "description": "固定为true"
        },
        {
          "name": "recordId",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "新创建的部署记录ID"
        },
        {
          "name": "remoteVersionDir",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "本次部署在远程创建的版本目录路径"
        }
      ]
    },
    {
      "name": "DeployError",
      "object_type": "dto",
      "description": "部署失败的响应体",
      "attributes": [
        {
          "name": "success",
          "type": "boolean",
          "required": true,
          "source": "derived",
          "description": "固定为false"
        },
        {
          "name": "errorCode",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "错误码，如'CONNECTION_FAILED', 'UPLOAD_FAILED'"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "人类可读的错误描述"
        }
      ]
    },
    {
      "name": "EnvironmentInfo",
      "object_type": "dto",
      "description": "环境详情，由环境管理模块返回",
      "attributes": [
        {
          "name": "envId",
          "type": "string",
          "required": true,
