{
  "meta": {
    "doc_id": "lld-加密密钥存储-001",
    "type": "lld",
    "module_type": "database",
    "module": "加密密钥存储",
    "title": "LLD - 加密密钥存储",
    "author": "design_agent",
    "created": "2026-05-22 15:00"
  },
  "overview": {
    "description": "专用于SSH私钥的安全存储模块，数据经AES-256加密后落盘，与主数据库隔离，仅允许密钥管理服务通过内部网络访问",
    "dependencies": [],
    "tech_stack": [
      "PostgreSQL 15"
    ]
  },
  "data_models": [
    {
      "name": "encrypted_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "加密SSH私钥主表，存储经AES-256-GCM加密后的私钥密文及元数据，支持密钥生命周期管理（active/revoked/compromised）",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "description": "主键，UUID v4自动生成"
        },
        {
          "name": "name",
          "type": "varchar(128)",
          "required": true,
          "description": "密钥名称/标签，用于人工辨识"
        },
        {
          "name": "encrypted_private_key",
          "type": "text",
          "required": true,
          "description": "AES-256-GCM加密后的SSH私钥密文（Base64编码）"
        },
        {
          "name": "public_key",
          "type": "text",
          "required": false,
          "description": "公钥内容（OpenSSH格式），用于指纹校验和身份确认"
        },
        {
          "name": "fingerprint",
          "type": "varchar(64)",
          "required": true,
          "description": "SSH密钥指纹（MD5格式），用于密钥唯一标识和快速检索"
        },
        {
          "name": "algorithm",
          "type": "varchar(32)",
          "required": true,
          "description": "密钥算法，如 RSA、Ed25519、ECDSA 等"
        },
        {
          "name": "encryption_key_version",
          "type": "varchar(32)",
          "required": true,
          "description": "加密时使用的主密钥版本号，用于密钥轮转时识别解密密钥"
        },
        {
          "name": "key_checksum",
          "type": "varchar(128)",
          "required": false,
          "description": "原始私钥的SHA256校验和，解密后用于完整性验证"
        },
        {
          "name": "status",
          "type": "varchar(20)",
          "required": true,
          "description": "密钥状态：active=可用，revoked=已吊销，compromised=已泄露"
        },
        {
          "name": "description",
          "type": "text",
          "required": false,
          "description": "密钥备注说明"
        },
        {
          "name": "metadata",
          "type": "jsonb",
          "required": false,
          "description": "扩展属性，如密钥来源、标签、自定义字段等"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "description": "记录创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "required": true,
          "description": "记录最后更新时间"
        },
        {
          "name": "deleted_at",
          "type": "timestamptz",
          "required": false,
          "description": "软删除时间戳，非NULL表示已删除"
        }
      ],
      "indexes": [
        {
          "name": "pk_encrypted_keys",
          "unique": true,
          "columns": ["id"]
        },
        {
          "name": "idx_encrypted_keys_fingerprint",
          "unique": true,
          "columns": ["fingerprint"]
        },
        {
          "name": "idx_encrypted_keys_status",
          "unique": false,
          "columns": ["status"]
        },
        {
          "name": "idx_encrypted_keys_created_at",
          "unique": false,
          "columns": ["created_at"]
        },
        {
          "name": "idx_encrypted_keys_name",
          "unique": false,
          "columns": ["name"]
        }
      ]
    },
    {
      "name": "key_access_audit",
      "type": "table",
      "ownership": "canonical",
      "description": "密钥访问审计表，记录所有密钥解密、读取、删除等敏感操作的审计轨迹，满足安全合规要求",
      "fields": [
        {
          "name": "id",
          "type": "bigserial",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "key_id",
          "type": "uuid",
          "required": true,
          "description": "被访问的密钥ID，关联encrypted_keys.id"
        },
        {
          "name": "requester_service",
          "type": "varchar(64)",
          "required": true,
          "description": "请求方服务名称，如 key_management_service、ssh_connection_pool"
        },
        {
          "name": "requester_identity",
          "type": "varchar(128)",
          "required": false,
          "description": "请求方内部身份标识，如用户ID或实例ID"
        },
        {
          "name": "action",
          "type": "varchar(32)",
          "required": true,
          "description": "操作类型：decrypt=解密，read=读取密文，delete=删除，list=列举"
        },
        {
          "name": "result",
          "type": "varchar(16)",
          "required": true,
          "description": "操作结果：success=成功，failure=失败，denied=拒绝"
        },
        {
          "name": "failure_reason",
          "type": "varchar(256)",
          "required": false,
          "description": "失败或拒绝原因描述"
        },
        {
          "name": "client_ip",
          "type": "varchar(45)",
          "required": false,
          "description": "请求来源IP地址（支持IPv4/IPv6）"
        },
        {
          "name": "detail",
          "type": "text",
          "required": false,
          "description": "操作详情附加信息"
        },
        {
          "name": "accessed_at",
          "type": "timestamptz",
          "required": true,
          "description": "操作发生时间"
        }
      ],
      "indexes": [
        {
          "name": "pk_key_access_audit",
          "unique": true,
          "columns": ["id"]
        },
        {
          "name": "idx_key_access_audit_key_id",
          "unique": false,
          "columns": ["key_id"]
        },
        {
          "name": "idx_key_access_audit_accessed_at",
          "unique": false,
          "columns": ["accessed_at"]
        },
        {
          "name": "idx_key_access_audit_result",
          "unique": false,
          "columns": ["result"]
        },
        {
          "name": "idx_key_access_audit_action",
          "unique": false,
          "columns": ["action"]
        }
      ]
    },
    {
      "name": "master_encryption_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "主加密密钥版本管理表，存储用于加密SSH私钥的AES-256主密钥材料（自身加密存储），支持密钥轮转",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "description": "主键，UUID v4自动生成"
        },
        {
          "name": "key_version",
          "type": "varchar(32)",
          "required": true,
          "description": "密钥版本标识符，如 v1、v2、v20260501，全局唯一"
        },
        {
          "name": "encrypted_key_data",
          "type": "text",
          "required": true,
          "description": "经KMS或passphrase加密后的主密钥材料（Base64编码）"
        },
        {
          "name": "algorithm",
          "type": "varchar(32)",
          "required": true,
          "description": "加密算法，默认 AES-256-GCM"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "required": true,
          "description": "是否为当前激活的主密钥（只有一条记录为true），新增密钥使用此版本加密"
        },
        {
          "name": "activated_at",
          "type": "timestamptz",
          "required": false,
          "description": "密钥激活时间"
        },
        {
          "name": "deactivated_at",
          "type": "timestamptz",
          "required": false,
          "description": "密钥停用时间（轮转时记录）"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "description": "记录创建时间"
        },
        {
          "name": "notes",
          "type": "text",
          "required": false,
          "description": "密钥轮转备注，如轮转原因、旧版本兼容说明等"
        }
      ],
      "indexes": [
        {
          "name": "pk_master_encryption_keys",
          "unique": true,
          "columns": ["id"]
        },
        {
          "name": "uq_master_encryption_keys_version",
          "unique": true,
          "columns": ["key_version"]
        },
        {
          "name": "uq_master_encryption_keys_active",
          "unique": true,
          "columns": ["is_active"],
          "condition": "WHERE is_active = true"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "写入加密密钥",
      "method": "INTERNAL",
      "endpoint": "/internal/keys/store",
      "description": "密钥管理服务经内部网络调用，将AES-256加密后的SSH私钥密文写入encrypted_keys表，返回新记录的唯一标识",
      "parameters": [
        {
          "name": "name",
          "type": "varchar(128)",
          "description": "密钥名称"
        },
        {
          "name": "encrypted_private_key",
          "type": "text",
          "description": "AES-256-GCM加密后的私钥密文"
        },
        {
          "name": "public_key",
          "type": "text",
          "description": "公钥内容（可选）"
        },
        {
          "name": "fingerprint",
          "type": "varchar(64)",
          "description": "密钥指纹"
        },
        {
          "name": "algorithm",
          "type": "varchar(32)",
          "description": "密钥算法"
        },
        {
          "name": "encryption_key_version",
          "type": "varchar(32)",
          "description": "主密钥版本"
        },
        {
          "name": "key_checksum",
          "type": "varchar(128)",
          "description": "原始私钥SHA256校验和（可选）"
        },
        {
          "name": "description",
          "type": "text",
          "description": "备注（可选）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "uuid",
          "created_at": "timestamptz"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "参数校验失败，如fingerprint重复或缺少必填字段"
        },
        {
          "code": 500,
          "message": "数据库写入失败，请联系管理员"
        }
      ]
    },
    {
      "name": "读取密钥密文",
      "method": "INTERNAL",
      "endpoint": "/internal/keys/{id}/ciphertext",
      "description": "密钥管理服务通过密钥ID查询加密私钥密文及加密元数据，用于后续解密操作",
      "parameters": [
        {
          "name": "id",
          "type": "uuid",
          "description": "密钥唯一标识"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "uuid",
          "name": "string",
          "encrypted_private_key": "text",
          "encryption_key_version": "varchar(32)",
          "algorithm": "varchar(32)",
          "key_checksum": "varchar(128)",
          "status": "varchar(20)",
          "created_at": "timestamptz"
        }
      },
      "error_codes": [
        {
          "code": 404,
          "message": "密钥ID不存在或已被删除"
        },
        {
          "code": 403,
          "message": "密钥状态为 revoked 或 compromised，拒绝访问"
        }
      ]
    },
    {
      "name": "列举密钥列表",
      "method": "INTERNAL",
      "endpoint": "/internal/keys",
      "description": "列举所有密钥的元数据信息（不含私钥密文），支持按状态筛选和分页",
      "parameters": [
        {
          "name": "status",
          "type": "varchar(20)",
          "description": "按状态筛选（可选）"
        },
        {
          "name": "page",
          "type": "int",
          "description": "页码，默认1"
        },
        {
          "name": "page_size",
          "type": "int",
          "description": "每页条数，默认20"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "total": "int",
          "items": [
            {
              "id": "uuid",
              "name": "string",
              "fingerprint": "string",
              "algorithm": "string",
              "status": "string",
              "created_at": "timestamptz"
            }
          ]
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "分页参数不合法"
        }
      ]
    },
    {
      "name": "删除密钥",
      "method": "INTERNAL",
      "endpoint": "/internal/keys/{id}/delete",
      "description": "将指定密钥标记为删除（软删除），设置deleted_at时间戳并更新status为revoked",
      "parameters": [
        {
          "name": "id",
          "type": "uuid",
          "description": "密钥唯一标识"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "uuid",
          "deleted_at": "timestamptz"
        }
      },
      "error_codes": [
        {
          "code": 404,
          "message": "密钥ID不存在"
        }
      ]
    },
    {
      "name": "记录密钥访问审计",
      "method": "INTERNAL",
      "endpoint": "/internal/audit/access",
      "description": "记录密钥解密/读取等敏感操作到key_access_audit表，用于安全审计和异常检测",
      "parameters": [
        {
          "name": "key_id",
          "type": "uuid",
          "description": "被访问的密钥ID"
        },
        {
          "name": "requester_service",
          "type": "varchar(64)",
          "description": "请求方服务名称"
        },
        {
          "name": "action",
          "type": "varchar(32)",
          "description": "操作类型"
        },
        {
          "name": "result",
          "type": "varchar(16)",
          "description": "操作结果"
        },
        {
          "name": "client_ip",
          "type": "varchar(45)",
          "description": "请求来源IP（可选）"
        },
        {
          "name": "detail",
          "type": "text",
          "description": "附加详情（可选）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "bigint",
          "accessed_at": "timestamptz"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "审计记录参数不完整"
        }
      ]
    },
    {
      "name": "轮转主加密密钥",
      "method": "INTERNAL",
      "endpoint": "/internal/master-key/rotate",
      "description": "生成新的主加密密钥版本，更新活跃标记，旧密钥保留用于解密已有数据",
      "parameters": [
        {
          "name": "encrypted_key_data",
          "type": "text",
          "description": "新主密钥的加密材料"
        },
        {
          "name": "algorithm",
          "type": "varchar(32)",
          "description": "加密算法"
        },
        {
          "name": "notes",
          "type": "text",
          "description": "轮转备注（可选）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "uuid",
          "key_version": "string",
          "is_active": "boolean"
        }
      },
      "error_codes": [
        {
          "code": 500,
          "message": "主密钥轮转事务失败"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "数据库层采用事务保障一致性，所有写操作在事务内完成；密钥访问审计记录独立于业务事务，采用异步写入确保不阻塞主流程；加密/解密异常由上层密钥管理服务捕获并记录，数据库层不处理加解密逻辑",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "参数错误",
        "description": "请求参数校验失败，如字段类型不匹配、必填项缺失、指纹重复等，需调用方修正后重试"
      },
      {
        "code": "403",
        "name": "访问拒绝",
        "description": "密钥状态异常（revoked/compromised）或无权访问，记录审计日志后拒绝操作"
      },
      {
        "code": "404",
        "name": "记录不存在",
        "description": "查询的密钥ID在主表中不存在，或已被软删除不可见"
      },
      {
        "code": "500",
        "name": "数据库异常",
        "description": "数据库连接中断、写入超时、约束冲突等内部错误，由连接池重试机制处理，重试3次后上报告警"
      }
    ]
  },
  "index_strategy": [
    {
      "table": "encrypted_keys",
      "indexes": [
        {
          "name": "pk_encrypted_keys",
          "columns": ["id"],
          "unique": true,
          "type": "B-tree",
          "purpose": "主键索引，支持按ID的O(1)级别单行查询"
        },
        {
          "name": "idx_encrypted_keys_fingerprint",
          "columns": ["fingerprint"],
          "unique": true,
          "type": "B-tree",
          "purpose": "指纹唯一索引，确保密钥指纹不重复，支持密钥查重和快速检索"
        },
        {
          "name": "idx_encrypted_keys_status",
          "columns": ["status"],
          "unique": false,
          "type": "B-tree",
          "purpose": "状态索引，支持按状态筛选活跃/吊销密钥列表"
        },
        {
          "name": "idx_encrypted_keys_created_at",
          "columns": ["created_at"],
          "unique": false,
          "type": "B-tree",
          "purpose": "创建时间索引，支持按时间范围查询和排序"
        },
        {
          "name": "idx_encrypted_keys_name",
          "columns": ["name"],
          "unique": false,
          "type": "B-tree",
          "purpose": "名称索引，支持按名称模糊搜索"
        }
      ]
    },
    {
      "table": "key_access_audit",
      "indexes": [
        {
          "name": "pk_key_access_audit",
          "columns": ["id"],
          "unique": true,
          "type": "B-tree",
          "purpose": "主键索引"
        },
        {
          "name": "idx_key_access_audit_key_id",
          "columns": ["key_id"],
          "unique": false,
          "type": "B-tree",
          "purpose": "密钥ID索引，支持查询指定密钥的所有访问记录"
        },
        {
          "name": "idx_key_access_audit_accessed_at",
          "columns": ["accessed_at"],
          "unique": false,
          "type": "B-tree",
          "purpose": "时间索引，支持按时间范围查询审计记录，配合分区表使用"
        },
        {
          "name": "idx_key_access_audit_result",
          "columns": ["result"],
          "unique": false,
          "type": "B-tree",
          "purpose": "结果索引，支持按成功/失败状态筛选异常访问"
        },
        {
          "name": "idx_key_access_audit_action",
          "columns": ["action"],
          "unique": false,
          "type": "B-tree",
          "purpose": "操作类型索引，支持按decrypt/delete等操作分类查询"
        }
      ]
    },
    {
      "table": "master_encryption_keys",
      "indexes": [
        {
          "name": "pk_master_encryption_keys",
          "columns": ["id"],
          "unique": true,
          "type": "B-tree",
          "purpose": "主键索引"
        },
        {
          "name": "uq_master_encryption_keys_version",
          "columns": ["key_version"],
          "unique": true,
          "type": "B-tree",
          "purpose": "版本号唯一索引，确保每个主密钥版本号全局唯一"
        },
        {
          "name": "uq_master_encryption_keys_active",
          "columns": ["is_active"],
          "unique": true,
          "type": "B-tree",
          "purpose": "活跃密钥唯一索引（条件索引WHERE is_active=true），确保同时最多只有一个活跃主密钥"
        }
      ]
    }
  ],
  "migration_strategy": {
    "tool": "Alembic",
    "naming": "V{序号}__{描述}.sql",
    "rollback": "每个迁移版本必须提供对应的降级脚本（downgrade），支持版本回退至任意历史版本；生产环境回滚前需在预发环境完整验证"
  },
  "capacity_estimation": {
