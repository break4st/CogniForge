  "index_strategy": {
    "purpose": "优化查询性能，保证数据完整性，支持高频查询字段。",
    "indexes_summary": [
      "projects.name 唯一索引，防止重名并加速按名查询",
      "projects.created_at 索引加速按创建时间排序或分页",
      "environments.project_id 索引加速获取项目下环境列表",
      "environments.project_id+name 联合唯一索引保证环境名唯一",
      "deploy_records.project_id 索引加速按项目查询部署记录",
      "deploy_records.environment_id 索引加速按环境查询部署记录",
      "deploy_records.status 索引加速按状态过滤",
      "deploy_records.created_at 索引加速按时间排序",
      "deploy_steps.deploy_record_id 索引加速获取部署记录的所有步骤",
      "deploy_steps.deploy_record_id+order 联合唯一索引保证顺序唯一且支持按顺序加载",
      "configurations.project_id+key 联合唯一索引保证配置唯一",
      "configurations.environment_id+key 联合唯一索引保证配置唯一",
      "外键字段均建立索引以优化 JOIN 操作"
    ]
  },
