    }
  },
  "connection_contracts": {
    "engine_creation": "使用 SQLAlchemy create_engine 创建 SQLite 连接",
    "connection_string": "sqlite:///./deploy_tool.db",
    "pooling": "默认连接池（NullPool for SQLite）",
    "isolation_level": "SERIALIZABLE（默认）",
    "thread_safety": "单线程访问，通过 SQLAlchemy 的 check_same_thread=False 在必要时允许多线程",
    "context_manager": "所有数据库操作通过上下文管理器或依赖注入获取 session"
  },
  "error_handling": {
    "strategy": "捕获数据库异常并转换为领域错误，记录日志后向上传播",
    "common_errors": [
      {
        "exception": "sqlalchemy.exc.IntegrityError",
        "cause": "违反唯一或外键约束",
        "handling": "转换为自定义 DuplicateEntryError 或 ForeignKeyError，提示用户具体字段"
      },
      {
        "exception": "sqlalchemy.exc.OperationalError",
        "cause": "数据库锁或文件访问错误",
        "handling": "重试有限次数，失败后抛出 DatabaseLockedError"
      },
      {
        "exception": "sqlalchemy.exc.DataError",
        "cause": "数据格式错误（如字段超长）",
        "handling": "转换为 ValidationError，指明无效字段"
      }
    ],
    "logging": "使用 logging 记录异常详情，包含操作上下文",
    "graceful_degradation": "数据库不可用时，提示用户检查磁盘空间和权限，并禁止写操作"
  },
  "schema": {
    "dialect": "SQLite",
    "entities": [
      "projects",
      "environments",
      "deploy_records",
      "deploy_steps",
      "configurations"
    ],
    "relationships": [
      "projects 1──N environments",
      "projects 1──N deploy_records",
      "environments 1──N deploy_records",
      "deploy_records 1──N deploy_steps",
      "projects 1──N configurations (可空)",
      "environments 1──N configurations (可空)"
    ],
    "constraints_global": [
      "所有主键为自增整数",
      "时间字段使用 UTC 时间",
      "外键约束由业务代码或 SQLite PRAGMA foreign_keys=ON 保证"
    ]
  }
