        },
        {
          "name": "newName",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "新的项目名称"
        }
      ],
      "maps_to_entity": "DO-001"
    },
    {
      "name": "DO-004",
      "object_type": "dto",
