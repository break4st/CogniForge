          "type": "string",
          "required": true,
          "source": "input",
          "description": "新项目名称"
        },
        {
          "name": "isDefault",
          "type": "boolean",
          "required": false,
          "source": "input",
          "description": "是否设为默认项目（可选）"
        }
      ],
      "maps_to_entity": "DO-001"
    },
    {
      "name": "DO-003",
