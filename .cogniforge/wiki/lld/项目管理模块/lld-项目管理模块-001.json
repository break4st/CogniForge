  "error_handling": {
    "strategy": "所有公开服务契约通过IPC返回统一格式的错误响应，内部异常由服务层捕获并转换为分类错误码，数据库和业务校验错误分别映射为特定5xx/4xx错误。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "无效请求",
        "description": "参数缺失、无效或格式错误，例如项目名称为空、项目ID无效、切换项目时项目不存在等。由服务层校验触发，返回详细描述。"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "创建或重命名项目时，项目名称已存在（唯一性约束）。由数据库唯一约束冲突或预先检查触发。"
      },
      {
        "code": "500",
        "name": "内部数据库错误",
        "description": "数据库操作失败（如连接丢失、写入异常）。由仓储层捕获SQLite错误，转换为统一格式。"
      },
      {
        "code": "500",
        "name": "内部服务错误",
        "description": "未预期的运行时错误或依赖服务故障。由全局异常处理捕获，记录日志并返回通用错误信息。"
      }
    ]
  },
  "domain_objects": [
    {
      "name": "DO-001",
      "object_type": "entity",
      "description": "项目实体，对应数据库中的项目记录",
      "attributes": [
        {
          "name": "id",
          "type": "string (UUID)",
          "required": true,
          "source": "db",
          "description": "项目唯一标识符"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "项目名称，需唯一"
        },
        {
          "name": "isDefault",
          "type": "boolean",
          "required": false,
          "source": "db",
          "description": "是否为默认项目，每个用户只能有一个默认项目"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "required": true,
          "source": "db",
          "description": "创建时间"
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "required": false,
          "source": "db",
          "description": "最后更新时间"
        }
      ]
    },
    {
      "name": "DO-002",
      "object_type": "dto",
      "description": "创建项目的请求数据传输对象",
