      "attributes": [
        {
          "name": "project",
          "type": "DO-001",
          "required": false,
          "source": "derived",
          "description": "当前活动项目实体，若无则null"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "name": "SC-001",
      "description": "实现项目管理核心业务逻辑，处理项目 CRUD 和当前项目切换",
      "methods": [
        {
          "name": "createProject",
          "signature": "(request: DO-002) -> DO-007",
          "precondition": "请求的 name 非空且长度在允许范围内；当前用户已登录（但权限控制不在本模块范围）",
          "postcondition": "数据库中新增一个项目记录；返回新创建的项目信息；若名称重复则拒绝",
          "description": "创建一个新项目，名称在同一用户下唯一",
          "exceptions": [
            {
              "name": "DuplicateProjectNameException",
              "trigger": "项目名称在同一用户下已存在",
              "http_status": 409
            },
            {
              "name": "InvalidProjectNameException",
              "trigger": "项目名称为空或格式不合法",
              "http_status": 400
            }
          ]
        },
        {
          "name": "renameProject",
          "signature": "(request: DO-003) -> DO-007",
          "precondition": "项目 ID 存在；新名称非空且不同于当前名称",
          "postcondition": "数据库中项目名称更新；返回更新后的项目信息；若新名称重复则拒绝",
          "description": "重命名指定项目，新名称同一用户下唯一",
          "exceptions": [
            {
              "name": "ProjectNotFoundException",
              "trigger": "指定的项目 ID 不存在",
              "http_status": 404
            },
            {
              "name": "DuplicateProjectNameException",
              "trigger": "新名称在同一用户下已存在",
              "http_status": 409
            }
          ]
        },
        {
          "name": "deleteProject",
          "signature": "(request: DO-004) -> DO-007",
          "precondition": "项目 ID 存在；项目不是当前活动项目；没有活动的部署关联",
          "postcondition": "数据库中项目记录删除；返回删除确认信息",
          "description": "删除指定项目及其关联数据（若有）",
          "exceptions": [
            {
              "name": "ProjectNotFoundException",
              "trigger": "指定的项目 ID 不存在",
              "http_status": 404
            },
            {
              "name": "ProjectIsActiveException",
              "trigger": "尝试删除当前活动项目",
              "http_status": 400
            },
            {
              "name": "ProjectHasActiveDeploymentException",
              "trigger": "项目存在活跃部署无法删除",
              "http_status": 409
            }
          ]
        },
        {
          "name": "listProjects",
          "signature": "() -> DO-006",
          "precondition": "无",
          "postcondition": "返回当前用户所有项目列表，包含基础信息；若无项目则返回空列表",
          "description": "获取当前用户的所有项目列表",
          "exceptions": []
        },
        {
          "name": "switchProject",
          "signature": "(request: DO-005) -> DO-008",
          "precondition": "项目 ID 存在",
          "postcondition": "系统当前活动项目切换为指定的项目；后续操作均在该项目上下文下；返回当前项目信息",
          "description": "切换当前活动项目",
          "exceptions": [
            {
              "name": "ProjectNotFoundException",
              "trigger": "指定的项目 ID 不存在",
              "http_status": 404
            }
          ]
        }
      ],
      "repository_dependencies": [
        "findByNameAndCreatedBy(name, userId) -> DO-001?",
        "findById(id) -> DO-001?",
        "existsActiveDeployment(projectId) -> boolean",
        "save(project) -> DO-001",
        "delete(id) -> void",
        "findAllByCreatedBy(userId) -> DO-001[]"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "项目名称在同一用户下必须唯一",
      "每个用户启动时必须存在至少一个默认项目",
      "当前项目上下文中必须始终存在一个有效项目ID",
      "已删除项目的关联数据必须被正确清理或标记无效"
    ],
    "state_machines": [
      {
        "entity": "DO-001",
        "states": [
          "Active",
          "Deleted"
        ],
        "transitions": [
          {
            "from": "Active",
            "to": "Deleted",
            "trigger": "SC-001 deleteProject",
            "actor": "用户"
          },
          {
            "from": "Deleted",
            "to": "Deleted",
            "trigger": "任何操作",
            "actor": "无，不可逆"
          }
        ],
        "irreversible_rules": [
          "从Active到Deleted的转换不可逆，删除后项目不可恢复"
        ],
        "concurrency": "使用数据库事务和行级锁保证状态一致性，在删除前检查项目是否已为当前项目，若是则切换至默认项目后删除"
      }
    ],
    "cross_service_rules": [
      "项目名称唯一性校验依赖本地数据库（CTR-007）的Projects表唯一索引",
      "删除项目时需通知文件系统服务清理关联的项目目录（未来实现）",
      "默认项目初始化由模块自身负责，但需确保本地数据库已就绪"
    ]
  }
}