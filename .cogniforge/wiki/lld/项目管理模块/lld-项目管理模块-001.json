        {
          "name": "id",
          "type": "string (UUID)",
          "required": true,
          "source": "input",
          "description": "要切换到的项目ID"
        }
      ],
      "maps_to_entity": "DO-001"
    },
    {
      "name": "DO-006",
      "object_type": "dto",
