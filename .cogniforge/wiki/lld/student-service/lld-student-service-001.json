{
  "meta": {
    "doc_id": "lld-student-service-001",
    "type": "lld",
    "module": "student-service",
    "title": "学生服务 - 详细设计",
    "author": "design_agent",
    "created": "2026-05-20 09:23"
  },
  "overview": "学生服务负责学生基本信息的增删改查管理。作为系统的核心基础服务，它为其他模块（班级服务、学习统计服务）提供学生数据支撑。服务采用 RESTful API 设计，数据存储使用关系型数据库，提供标准的 CRUD 接口及按条件检索能力。",

  "data_models": [
    {
      "name": "Student",
      "type": "entity",
      "description": "学生核心档案信息",
      "fields": [
        { "name": "id", "type": "bigint", "description": "唯一主键，自增ID" },
        { "name": "student_no", "type": "varchar(32)", "description": "学号，全局唯一，业务标识" },
        { "name": "name", "type": "varchar(64)", "description": "学生姓名" },
        { "name": "gender", "type": "tinyint", "description": "性别：0-未知 1-男 2-女" },
        { "name": "birth_date", "type": "date", "description": "出生日期" },
        { "name": "phone", "type": "varchar(20)", "description": "联系电话" },
        { "name": "email", "type": "varchar(128)", "description": "电子邮箱" },
        { "name": "address", "type": "varchar(256)", "description": "家庭住址" },
        { "name": "id_card", "type": "varchar(18)", "description": "身份证号，加密存储" },
        { "name": "enrollment_date", "type": "date", "description": "入学日期" },
        { "name": "status", "type": "tinyint", "description": "状态：1-在读 2-休学 3-毕业 4-退学" },
        { "name": "created_at", "type": "datetime", "description": "记录创建时间" },
        { "name": "updated_at", "type": "datetime", "description": "记录最后更新时间" }
      ]
    },
    {
      "name": "StudentContact",
      "type": "entity",
      "description": "学生联系人信息（家长/监护人）",
      "fields": [
        { "name": "id", "type": "bigint", "description": "唯一主键" },
        { "name": "student_id", "type": "bigint", "description": "关联学生ID" },
        { "name": "name", "type": "varchar(64)", "description": "联系人姓名" },
        { "name": "relation", "type": "varchar(32)", "description": "关系：父亲/母亲/其他" },
        { "name": "phone", "type": "varchar(20)", "description": "联系人电话" },
        { "name": "is_primary", "type": "tinyint", "description": "是否主要联系人：0-否 1-是" },
        { "name": "created_at", "type": "datetime", "description": "创建时间" }
      ]
    },
    {
      "name": "StudentQuery",
      "type": "dto",
      "description": "学生查询参数对象",
      "fields": [
        { "name": "keyword", "type": "varchar(64)", "description": "关键词搜索（姓名/学号模糊匹配）" },
        { "name": "status", "type": "tinyint", "description": "按状态筛选" },
        { "name": "gender", "type": "tinyint", "description": "按性别筛选" },
        { "name": "enrollment_date_start", "type": "date", "description": "入学日期范围-开始" },
        { "name": "enrollment_date_end", "type": "date", "description": "入学日期范围-结束" },
        { "name": "page", "type": "int", "description": "页码，从1开始" },
        { "name": "page_size", "type": "int", "description": "每页条数，默认20，最大100" }
      ]
    },
    {
      "name": "PageResult",
      "type": "dto",
      "description": "分页结果包装",
      "fields": [
        { "name": "total", "type": "long", "description": "总记录数" },
        { "name": "page", "type": "int", "description": "当前页码" },
        { "name": "page_size", "type": "int", "description": "每页条数" },
        { "name": "items", "type": "list<Student>", "description": "当前页数据列表" }
      ]
    }
  ],

  "interfaces": [
    {
      "name": "CreateStudent",
      "endpoint": "POST /api/v1/students",
      "description": "创建新学生档案",
      "parameters": [
        { "name": "body", "type": "Student", "description": "学生信息（不含 id, created_at, updated_at）" }
      ]
    },
    {
      "name": "GetStudent",
      "endpoint": "GET /api/v1/students/{id}",
      "description": "根据ID查询学生详情",
      "parameters": [
        { "name": "id", "type": "long", "description": "学生ID" }
      ]
    },
    {
      "name": "UpdateStudent",
      "endpoint": "PUT /api/v1/students/{id}",
      "description": "更新学生基本信息",
      "parameters": [
        { "name": "id", "type": "long", "description": "学生ID" },
        { "name": "body", "type": "Student", "description": "更新的学生信息字段" }
      ]
    },
    {
      "name": "DeleteStudent",
      "endpoint": "DELETE /api/v1/students/{id}",
      "description": "删除学生记录（逻辑删除：将状态标记为退学）",
      "parameters": [
        { "name": "id", "type": "long", "description": "学生ID" }
      ]
    },
    {
      "name": "SearchStudents",
      "endpoint": "GET /api/v1/students",
      "description": "分页条件查询学生列表",
      "parameters": [
        { "name": "keyword", "type": "string", "description": "搜索关键词（姓名/学号）" },
        { "name": "status", "type": "int", "description": "状态筛选" },
        { "name": "gender", "type": "int", "description": "性别筛选" },
        { "name": "enrollment_date_start", "type": "string", "description": "入学起始日期" },
        { "name": "enrollment_date_end", "type": "string", "description": "入学截止日期" },
        { "name": "page", "type": "int", "description": "页码" },
        { "name": "page_size", "type": "int", "description": "每页条数" }
      ]
    },
    {
      "name": "BatchGetStudents",
      "endpoint": "POST /api/v1/students/batch",
      "description": "批量查询学生信息（供内部服务调用）",
      "parameters": [
        { "name": "body", "type": "list<long>", "description": "学生ID列表" }
      ]
    },
    {
      "name": "CreateContact",
      "endpoint": "POST /api/v1/students/{student_id}/contacts",
      "description": "添加学生联系人",
      "parameters": [
        { "name": "student_id", "type": "long", "description": "学生ID" },
        { "name": "body", "type": "StudentContact", "description": "联系人信息" }
      ]
    },
    {
      "name": "ListContacts",
      "endpoint": "GET /api/v1/students/{student_id}/contacts",
      "description": "查询学生联系人列表",
      "parameters": [
        { "name": "student_id", "type": "long", "description": "学生ID" }
      ]
    },
    {
      "name": "UpdateStudentStatus",
      "endpoint": "PATCH /api/v1/students/{id}/status",
      "description": "更新学生状态（在读/休学/毕业/退学）",
      "parameters": [
        { "name": "id", "type": "long", "description": "学生ID" },
        { "name": "status", "type": "int", "description": "目标状态" }
      ]
    }
  ],

  "error_handling": "统一错误响应格式，使用 HTTP 状态码标识错误类型。所有错误响应遵循标准 JSON 结构：{\"code\": \"错误码\", \"message\": \"错误描述\", \"details\": {}}。服务内部异常会被全局异常处理器捕获并转换为友好错误信息。\n\n错误码定义：\n- STUDENT_NOT_FOUND (404)：学生记录不存在，按ID查询/更新/删除不存在的学生时触发\n- STUDENT_NO_DUPLICATE (409)：学号已存在，创建学生时学号与现有记录冲突时触发\n- INVALID_STUDENT_STATUS (400)：非法的学生状态值，传入的状态值不在允许范围内时触发\n- STUDENT_HAS_ACTIVE_CLASS (409)：学生有未结束的班级关联无法删除，删除仍在班级中的学生时触发\n- INVALID_PARAMETER (400)：请求参数校验失败，必填字段缺失或格式错误时触发\n- INTERNAL_ERROR (500)：服务器内部错误，数据库异常或其他未预期错误时触发"
}
