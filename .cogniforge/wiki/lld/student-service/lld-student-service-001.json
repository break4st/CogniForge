{
  "meta": {
    "doc_id": "lld-student-service-001",
    "type": "lld",
    "module": "student-service",
    "title": "学生管理服务详细设计",
    "author": "design_agent",
    "created": "2026-05-19 20:26"
  },
  "overview": "学生管理服务是学生管理系统的基础核心模块，负责学生基本信息的全生命周期管理。本服务提供学生信息的增删改查、批量导入导出、多维度检索筛选等功能，保障学生数据的唯一性与完整性，并支持数据变更的历史追溯。本服务遵循分层架构设计，向上通过 RESTful API 为前端和网关层提供统一接口，向下通过数据持久层与关系型数据库交互，并通过缓存层加速高频读取。",
  "data_models": [
    {
      "name": "Student",
      "type": "entity",
      "fields": [
        { "name": "id", "type": "string (UUID)", "description": "学生唯一标识，系统自动生成" },
        { "name": "student_no", "type": "string (20)", "description": "学号，全局唯一，用于登录和检索" },
        { "name": "name", "type": "string (50)", "description": "学生姓名" },
        { "name": "gender", "type": "enum (MALE/FEMALE)", "description": "性别" },
        { "name": "birth_date", "type": "date", "description": "出生日期" },
        { "name": "phone", "type": "string (20)", "description": "联系电话" },
        { "name": "email", "type": "string (100)", "description": "电子邮箱" },
        { "name": "address", "type": "string (200)", "description": "家庭住址" },
        { "name": "id_card_no", "type": "string (18)", "description": "身份证号，全局唯一" },
        { "name": "enrollment_date", "type": "date", "description": "入学日期" },
        { "name": "status", "type": "enum (ACTIVE/GRADUATED/SUSPENDED/TRANSFERRED/DROPPED)", "description": "在校状态，默认为 ACTIVE" },
        { "name": "grade_id", "type": "string (UUID)", "description": "所属年级 ID，关联年级管理服务" },
        { "name": "class_id", "type": "string (UUID)", "description": "所属班级 ID，关联班级管理服务" },
        { "name": "guardian_name", "type": "string (50)", "description": "监护人姓名" },
        { "name": "guardian_phone", "type": "string (20)", "description": "监护人联系电话" },
        { "name": "created_at", "type": "datetime", "description": "记录创建时间" },
        { "name": "updated_at", "type": "datetime", "description": "记录最后更新时间" },
        { "name": "version", "type": "int", "description": "乐观锁版本号，用于并发控制" }
      ]
    },
    {
      "name": "StudentImportRecord",
      "type": "entity",
      "fields": [
        { "name": "id", "type": "string (UUID)", "description": "导入记录唯一标识" },
        { "name": "file_name", "type": "string (200)", "description": "导入文件名" },
        { "name": "file_format", "type": "enum (CSV/EXCEL)", "description": "文件格式" },
        { "name": "total_rows", "type": "int", "description": "总行数" },
        { "name": "success_rows", "type": "int", "description": "成功导入行数" },
        { "name": "failed_rows", "type": "int", "description": "失败行数" },
        { "name": "status", "type": "enum (PROCESSING/COMPLETED/PARTIALLY_FAILED/FAILED)", "description": "导入状态" },
        { "name": "errors", "type": "json", "description": "导入错误详情列表，每项包含行号和错误原因" },
        { "name": "operator_id", "type": "string (UUID)", "description": "操作人用户 ID" },
        { "name": "created_at", "type": "datetime", "description": "导入时间" }
      ]
    },
    {
      "name": "StudentSearchCriteria",
      "type": "value_object",
      "fields": [
        { "name": "keyword", "type": "string (100)", "description": "关键词，模糊匹配姓名/学号" },
        { "name": "grade_id", "type": "string (UUID)", "description": "按年级筛选" },
        { "name": "class_id", "type": "string (UUID)", "description": "按班级筛选" },
        { "name": "status", "type": "enum", "description": "按在校状态筛选" },
        { "name": "gender", "type": "enum", "description": "按性别筛选" },
        { "name": "enrollment_date_start", "type": "date", "description": "入学日期范围起始" },
        { "name": "enrollment_date_end", "type": "date", "description": "入学日期范围结束" },
        { "name": "page", "type": "int", "description": "页码，从 1 开始" },
        { "name": "page_size", "type": "int", "description": "每页条数，默认 20，最大 100" },
        { "name": "sort_by", "type": "string", "description": "排序字段" },
        { "name": "sort_order", "type": "enum (ASC/DESC)", "description": "排序方向" }
      ]
    },
    {
      "name": "StudentExportRequest",
      "type": "value_object",
      "fields": [
        { "name": "format", "type": "enum (CSV/EXCEL)", "description": "导出格式" },
        { "name": "criteria", "type": "StudentSearchCriteria", "description": "导出筛选条件" },
        { "name": "fields", "type": "string[]", "description": "导出字段列表，为空则导出全部字段" }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "CreateStudent",
      "endpoint": "POST /api/v1/students",
      "description": "创建学生记录。校验学号和身份证号的唯一性，校验关联的年级和班级存在。",
      "parameters": [
        { "name": "student_no", "type": "string", "description": "学号（必填）" },
        { "name": "name", "type": "string", "description": "姓名（必填）" },
        { "name": "gender", "type": "string", "description": "性别（必填）" },
        { "name": "birth_date", "type": "string", "description": "出生日期（必填，YYYY-MM-DD）" },
        { "name": "phone", "type": "string", "description": "联系电话" },
        { "name": "email", "type": "string", "description": "电子邮箱" },
        { "name": "address", "type": "string", "description": "家庭住址" },
        { "name": "id_card_no", "type": "string", "description": "身份证号" },
        { "name": "enrollment_date", "type": "string", "description": "入学日期" },
        { "name": "grade_id", "type": "string", "description": "年级 ID" },
        { "name": "class_id", "type": "string", "description": "班级 ID" },
        { "name": "guardian_name", "type": "string", "description": "监护人姓名" },
        { "name": "guardian_phone", "type": "string", "description": "监护人电话" }
      ]
    },
    {
      "name": "UpdateStudent",
      "endpoint": "PUT /api/v1/students/{id}",
      "description": "更新学生记录。使用乐观锁（version 字段）防止并发写覆盖。",
      "parameters": [
        { "name": "id", "type": "string", "description": "学生 ID（路径参数）" },
        { "name": "...fields", "type": "object", "description": "同 CreateStudent 的可更新字段" },
        { "name": "version", "type": "int", "description": "当前版本号（必填，用于乐观锁校验）" }
      ]
    },
    {
      "name": "DeleteStudent",
      "endpoint": "DELETE /api/v1/students/{id}",
      "description": "逻辑删除学生记录（标记 status=TRANSFERRED/DROPPED，不做物理删除），保留历史数据完整性。",
      "parameters": [
        { "name": "id", "type": "string", "description": "学生 ID（路径参数）" }
      ]
    },
    {
      "name": "GetStudent",
      "endpoint": "GET /api/v1/students/{id}",
      "description": "根据 ID 查询单个学生详细信息，优先查缓存。",
      "parameters": [
        { "name": "id", "type": "string", "description": "学生 ID（路径参数）" }
      ]
    },
    {
      "name": "GetStudentByNo",
      "endpoint": "GET /api/v1/students/by-no/{student_no}",
      "description": "根据学号查询学生信息，用于学号唯一性校验和快速检索。",
      "parameters": [
        { "name": "student_no", "type": "string", "description": "学号（路径参数）" }
      ]
    },
    {
      "name": "SearchStudents",
      "endpoint": "GET /api/v1/students",
      "description": "多维度分页检索学生信息。支持关键词模糊搜索、组合条件筛选、排序和分页。缓存命中的分页结果，缓存键包含完整查询条件。",
      "parameters": [
        { "name": "keyword", "type": "string", "description": "搜索关键词" },
        { "name": "grade_id", "type": "string", "description": "年级筛选" },
        { "name": "class_id", "type": "string", "description": "班级筛选" },
        { "name": "status", "type": "string", "description": "状态筛选" },
        { "name": "gender", "type": "string", "description": "性别筛选" },
        { "name": "enrollment_date_start", "type": "string", "description": "入学起始日期" },
        { "name": "enrollment_date_end", "type": "string", "description": "入学截止日期" },
        { "name": "page", "type": "int", "description": "页码，默认 1" },
        { "name": "page_size", "type": "int", "description": "每页条数，默认 20" },
        { "name": "sort_by", "type": "string", "description": "排序字段" },
        { "name": "sort_order", "type": "string", "description": "排序方向" }
      ]
    },
    {
      "name": "BatchImportStudents",
      "endpoint": "POST /api/v1/students/import",
      "description": "批量导入学生信息。支持 CSV 和 Excel 格式。采用两阶段处理：先全量校验再批量写入。使用分布式锁防止并发导入。生成导入结果报告。",
      "parameters": [
        { "name": "file", "type": "file (multipart)", "description": "CSV 或 Excel 文件" },
        { "name": "format", "type": "string", "description": "文件格式（CSV/EXCEL）" },
        { "name": "duplicate_strategy", "type": "string", "description": "重复数据处理策略：SKIP（跳过）/UPDATE（覆盖）" }
      ]
    },
    {
      "name": "ExportStudents",
      "endpoint": "GET /api/v1/students/export",
      "description": "按筛选条件导出学生信息为 CSV 或 Excel 文件。大数据量时异步生成并提供下载链接。",
      "parameters": [
        { "name": "format", "type": "string", "description": "导出格式（CSV/EXCEL）" },
        { "name": "keyword", "type": "string", "description": "搜索关键词" },
        { "name": "grade_id", "type": "string", "description": "年级筛选" },
        { "name": "class_id", "type": "string", "description": "班级筛选" },
        { "name": "status", "type": "string", "description": "状态筛选" },
        { "name": "fields", "type": "string", "description": "导出字段列表，逗号分隔" }
      ]
    },
    {
      "name": "GetStudentHistory",
      "endpoint": "GET /api/v1/students/{id}/history",
      "description": "查询学生信息变更历史记录，用于数据追溯和审计。",
      "parameters": [
        { "name": "id", "type": "string", "description": "学生 ID（路径参数）" },
        { "name": "start_time", "type": "string", "description": "查询起始时间" },
        { "name": "end_time", "type": "string", "description": "查询结束时间" },
        { "name": "page", "type": "int", "description": "页码" },
        { "name": "page_size", "type": "int", "description": "每页条数" }
      ]
    }
  ],
  "error_handling": "本模块采用统一的错误处理策略，所有异常返回标准错误响应体 { code: string, message: string, details: object }。\n\n1. 参数校验错误 (400 BAD_REQUEST)：请求参数缺失、格式错误或超出长度限制时返回，包含具体字段级别的错误详情。\n2. 业务唯一性冲突 (409 CONFLICT)：学号或身份证号与已有记录重复时返回，提示具体冲突字段。\n3. 并发冲突 (409 CONFLICT)：乐观锁版本号不匹配时返回，提示客户端刷新数据后重试。\n4. 资源不存在 (404 NOT_FOUND)：指定 ID 的学生记录不存在时返回。\n5. 关联引用错误 (422 UNPROCESSABLE_ENTITY)：引用的年级或班级 ID 不存在时返回。\n6. 导入格式错误 (400 BAD_REQUEST)：上传文件格式不支持、文件内容解析失败时返回。\n7. 导入部分失败 (200 OK with partial_failure flag)：批量导入中部分行校验失败时返回成功导入数、失败数及详细错误列表。\n8. 缓存降级（静默处理）：缓存服务不可用时自动降级直查数据库，不中断业务流程。\n9. 内部错误 (500 INTERNAL_SERVER_ERROR)：未预期的系统异常，记录审计日志并返回通用错误信息。"
}
