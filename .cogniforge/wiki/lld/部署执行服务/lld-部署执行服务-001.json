  "data_models": [
    {
      "id": "DM-001",
      "name": "deployments",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployments"
      },
      "description": "部署任务记录表（派生引用），存储每次部署的信息与状态",
      "fields": [
        {
          "name": "id",
          "type": "String",
          "required": true,
          "description": "UUID 唯一部署标识"
        },
        {
          "name": "environment_id",
          "type": "String",
          "required": true,
          "description": "关联的环境ID"
        },
        {
          "name": "file_type",
          "type": "String",
          "required": true,
          "description": "部署包类型：zip/tar.gz/directory"
        },
        {
          "name": "file_path",
          "type": "String",
          "required": true,
          "description": "包在本地的文件路径"
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "description": "当前状态：PENDING/RUNNING/SUCCESS/FAILED/ROLLBACKED"
        },
        {
          "name": "version_label",
          "type": "String",
          "required": false,
          "description": "自动生成的时间戳版本号"
        },
        {
          "name": "result_message",
          "type": "String",
          "required": false,
          "description": "成功或失败描述"
        },
        {
          "name": "started_at",
          "type": "DateTime",
          "required": false,
          "description": "执行开始时间"
        },
        {
          "name": "completed_at",
          "type": "DateTime",
          "required": false,
          "description": "执行完成或失败时间"
        },
        {
          "name": "created_by",
          "type": "String",
          "required": true,
          "description": "操作人ID"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "记录创建时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_deployments_env_status",
          "unique": false,
          "columns": [
            "environment_id",
            "status"
          ]
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-009"
      ],
      "constraints": [
        "同一环境最多一个 RUNNING 状态的任务"
      ],
      "lifecycle": {
        "create": "部署请求到达时创建，状态 PENDING",
        "update": "异步流程中更新状态、时间戳与消息",
        "delete": "长期保留，按需配合版本清理软删除",
        "retention": "已完成的记录保留至少一周或按策略归档"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "DeploymentConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "部署配置结构体，从环境配置服务获取并缓存",
      "fields": [
        {
          "name": "environment_id",
          "type": "String",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "host",
          "type": "String",
          "required": true,
          "description": "远程主机IP或域名"
        },
        {
          "name": "port",
          "type": "Integer",
          "required": true,
          "description": "SSH端口"
        },
        {
          "name": "username",
          "type": "String",
          "required": true,
          "description": "SSH用户名"
        },
        {
          "name": "credential_id",
          "type": "String",
          "required": true,
          "description": "凭证ID，用于获取解密后的密码"
        },
        {
          "name": "remote_base_path",
          "type": "String",
          "required": true,
          "description": "远程部署根目录"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-101"
      ],
      "constraints": [
        "SFTP和SSH使用相同凭证",
        "敏感信息不落盘，仅在内存中使用解密后的密码"
      ],
      "lifecycle": {
        "create": "部署请求时，通过环境配置服务接口获取并组装",
        "update": "不修改，每次需重新获取",
        "delete": "部署任务完成后从内存废弃"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "WebSocketPayload",
      "type": "message",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "通过WebSocket推送的消息结构，包含部署日志和状态",
      "fields": [
        {
          "name": "type",
          "type": "String",
          "required": true,
          "description": "消息类型：log, status, error"
        },
        {
          "name": "deployment_id",
          "type": "String",
          "required": true,
          "description": "关联的部署ID"
        },
        {
          "name": "data",
          "type": "String",
          "required": true,
          "description": "消息内容：日志行、状态值或错误信息"
        },
        {
          "name": "timestamp",
          "type": "DateTime",
          "required": true,
          "description": "消息生成时间戳"
        }
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-010"
      ],
      "constraints": [
        "仅通过WebSocket连接发送，不持久化"
      ],
      "lifecycle": {
        "create": "执行步骤产生输出时创建消息",
        "update": "不修改",
        "delete": "发送后丢弃"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeploymentTask",
      "description": "表示一个部署任务实例，封装任务状态及执行所需的关键信息",
      "properties": [
        {
          "name": "id",
          "type": "UUID",
          "description": "任务唯一标识"
        },
        {
          "name": "config",
          "type": "DeploymentConfig",
          "description": "关联的部署配置"
        },
        {
          "name": "status",
          "type": "Enum",
          "description": "PENDING, RUNNING, SUCCESS, FAILED, ROLLBACKED"
        },
        {
          "name": "file_path",
          "type": "String",
          "description": "部署包本地路径"
        },
        {
          "name": "version_label",
          "type": "String",
          "description": "时间戳版本号"
        }
      ],
      "methods": [
        {
          "name": "start_async_deployment()",
          "return": "void",
          "description": "异步启动部署流程"
        },
        {
          "name": "rollback()",
          "return": "void",
          "description": "启动回滚流程"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ]
    },
    {
      "id": "DO-002",
      "name": "DeploymentOrchestrator",
      "description": "编排部署步骤的服务对象，管理远程交互及脚本执行",
      "properties": [
        {
          "name": "ssh_client",
          "type": "SSHClient",
          "description": "封装的SSH/SCP客户端"
        }
      ],
      "methods": [
        {
          "name": "execute(task)",
          "return": "void",
          "description": "执行主要部署步骤"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ]
    },
    {
      "id": "DO-003",
      "name": "RollbackManager",
      "description": "管理回滚逻辑，维护历史版本列表",
      "properties": [],
      "methods": [
        {
          "name": "rollback_to_version(env_id, version_label)",
          "return": "void",
          "description": "切换到指定历史版本"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ]
    },
    {
      "id": "DO-004",
      "name": "ScriptGenerator",
      "description": "根据环境信息生成远程启停脚本",
      "properties": [],
      "methods": [
        {
          "name": "generate_start_script(config)",
          "return": "String",
          "description": "生成启动脚本内容"
        },
        {
          "name": "generate_stop_script(config)",
          "return": "String",
          "description": "生成停止脚本内容"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ]
    },
    {
      "id": "DO-005",
      "name": "SftpUploader",
      "description": "处理文件上传到远程服务器的组件",
      "properties": [
        {
          "name": "sftp_client",
          "type": "SFTPClient",
          "description": "SFTP连接对象"
        }
      ],
      "methods": [
        {
          "name": "upload_file(local_path, remote_path)",
          "return": "void",
          "description": "上传单个文件或目录"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ]
    },
    {
      "id": "DO-006",
      "name": "LogPublisher",
      "description": "向WebSocket频道发布日志和状态更新的对象",
      "properties": [
        {
          "name": "channel",
          "type": "WebSocketChannel",
          "description": "WebSocket频道连接"
        }
      ],
      "methods": [
        {
          "name": "publish(payload)",
          "return": "void",
          "description": "发送序列化的WebSocketPayload消息"
        }
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-302"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "POST /api/deployments",
      "type": "REST",
      "description": "接收外部部署请求，创建部署任务记录，返回任务ID",
      "request": {
        "method": "POST",
        "path": "/api/deployments",
        "body": {
          "type": "object",
          "properties": {
            "environment_id": {
              "type": "string"
            },
            "file_path": {
              "type": "string"
            },
            "file_type": {
              "type": "string"
            }
          },
          "required": [
            "environment_id",
            "file_path",
            "file_type"
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "type": "object",
          "properties": {
            "deployment_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "status": 422,
          "description": "请求参数校验失败"
        },
        {
          "status": 409,
          "description": "同一环境已有运行中的部署"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-009"
      ],
      "invariants": [
        "请求体必须包含有效的 environment_id, file_path, file_type",
        "同一环境不允许并发运行部署"
      ]
    },
    {
      "id": "SC-002",
      "name": "GET /api/deployments/{id}",
      "type": "REST",
      "description": "获取指定部署任务的当前详情",
      "request": {
        "method": "GET",
        "path": "/api/deployments/{id}",
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "in": "path",
            "required": true,
            "description": "部署任务ID"
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "version_label": {
              "type": "string"
            },
            "result_message": {
              "type": "string"
            },
            "started_at": {
              "type": "string"
            },
            "completed_at": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "status": 404,
          "description": "部署任务不存在"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-009"
      ],
      "invariants": [
        "id 必须是有效的 UUID"
      ]
    },
    {
      "id": "SC-003",
      "name": "WS /ws/deployments/{id}",
      "type": "WebSocket",
      "description": "订阅指定部署任务的实时日志和状态更新",
      "request": {
        "protocol": "WebSocket",
        "path": "/ws/deployments/{id}",
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "in": "path",
            "required": true,
            "description": "部署任务ID"
          }
        ]
      },
      "response": {
        "type": "stream",
        "message_schema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "deployment_id": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          }
        }
      },
      "errors": [
        {
          "status": 404,
          "description": "部署任务不存在"
        }
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-302"
      ],
      "source_contracts": [
        "CTR-010"
      ],
      "invariants": [
        "连接必须通过认证",
        "仅允许查看自己有权限的部署任务"
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "rule": "同一时间，一个环境只能有一个部署任务处于 RUNNING 状态",
      "scope": "部署任务创建",
      "invariants": [
        "在任务状态变更为 RUNNING 之前，检查该环境是否已有 RUNNING 任务，若有则拒绝启动",
        "任务状态变更为终态（SUCCESS/FAILED/ROLLBACKED）时，该环境方可启动新任务"
      ],
      "source_requirements": [
        "REQ-003"
      ]
    },
    {
      "id": "BR-002",
      "rule": "版本目录命名规则为 {version_label}，current 软链接指向当前活跃版本",
      "scope": "部署执行、回滚",
      "invariants": [
        "新部署创建版本目录必须使用新的 version_label，不覆盖已有版本",
        "current 软链接必须总是指向一个存在的、完整的版本目录"
      ],
      "source_requirements": [
        "REQ-003"
      ]
    },
    {
      "id": "BR-003",
      "rule": "回滚操作只能切换到历史成功部署的版本",
      "scope": "回滚",
      "invariants": [
        "回滚目标版本目录必须存在且完整",
        "回滚执行应调用该版本对应的启停脚本"
      ],
      "source_requirements": [
        "REQ-003"
      ]
    },
    {
      "id": "BR-004",
      "rule": "WebSocket 推送必须实时，且仅推送与订阅 deployment_id 相关的消息",
      "scope": "实时日志",
      "invariants": [
        "每个 WebSocket 连接只能接收授权部署 ID 的消息",
        "日志消息必须保证顺序"
      ],
      "source_requirements": [
        "REQ-004"
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "DeploymentService",
      "type": "internal",
      "description": "内部服务接口，定义部署执行的核心方法",
      "methods": [
        {
          "name": "create_and_start_deployment",
          "parameters": [
            {
              "name": "environment_id",
              "type": "string"
            },
            {
              "name": "file_path",
              "type": "string"
            },
            {
              "name": "file_type",
              "type": "string"
            }
          ],
          "return": "DeploymentTask",
          "description": "创建部署任务并异步启动部署流程"
        },
        {
          "name": "get_deployment",
          "parameters": [
            {
              "name": "deployment_id",
              "type": "string"
            }
          ],
          "return": "DeploymentTask",
          "description": "获取部署任务详情"
        },
        {
          "name": "rollback_deployment",
          "parameters": [
            {
              "name": "deployment_id",
              "type": "string"
            },
            {
              "name": "version_label",
              "type": "string"
            }
