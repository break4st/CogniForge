  "module_boundary": {
    "in_scope": [
      "接收部署请求，创建部署任务记录并持久化",
      "编排异步部署流程：SFTP上传、远程创建版本目录、解压部署包、生成启停脚本、执行停服启服、更新current软链接",
      "实时推送部署日志与状态更新",
      "支持回滚：将current软链接指向历史版本并执行对应脚本",
      "管理部署版本并存与清理"
    ],
    "out_of_scope": [
      "项目管理、环境配置数据的创建与编辑",
      "用户界面展示与交互",
      "API路由代理和WebSocket管理基础设施",
      "主密码存储与派生密钥管理",
      "部署包构建与版本号生成策略"
    ],
    "owned_components": [
      "CMP-302"
    ],
    "owned_contracts": [
      "CTR-009",
      "CTR-010"
    ],
    "consumed_contracts": [
      "CTR-101",
      "CTR-102"
    ],
    "owned_data_models": [
      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "后端服务，负责核心部署流程的执行：接收部署任务、异步执行SFTP上传、远程目录操作、脚本生成、软链接切换及回滚，并通过WebSocket实时推送日志。",
    "dependencies": [
      "环境配置服务",
      "凭证加密存储服务"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "SQLAlchemy",
      "paramiko",
      "SQLite",
      "asyncio"
    ]
  },
