  "interfaces": [
    {
      "id": "IF-001",
      "interface_type": "REST",
      "endpoint": "/api/deployments",
      "method": "POST",
      "name": "createDeployment",
      "description": "接收部署请求，创建部署任务并异步执行。",
      "request": {
        "headers": {
          "Authorization": "string"
        },
        "body": {
          "project_id": "string",
          "environment_id": "string",
          "file_id": "string",
          "version_tag": "string",
          "notes": "string (optional)"
        }
      },
      "response": {
        "status_codes": {
          "201": {
            "description": "部署任务已创建",
            "body": {
              "deployment_id": "string",
              "status": "string"
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "401": {
            "description": "未授权"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      },
      "authentication": {
        "type": "JWT",
        "required": true
      },
      "rate_limiting": {
        "requests_per_second": 5
      },
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": [
        "CTR-006"
      ],
      "errors": [
        {
          "code": "INVALID_REQUEST",
          "message": "请求参数不合法"
        },
        {
          "code": "ENVIRONMENT_NOT_FOUND",
          "message": "环境不存在"
        },
        {
          "code": "FILE_NOT_FOUND",
