  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentService",
      "description": "部署执行服务对外提供的服务契约。",
      "type": "service",
      "version": 1,
      "status": "active",
      "methods": [
        {
          "name": "CreateDeployment",
          "description": "创建并启动部署任务",
          "signature": "CreateDeployment(ctx context.Context, req CreateDeploymentRequest) (CreateDeploymentResponse, error)",
          "precondition": "请求参数合法，用户已认证，项目/环境/文件存在且有效",
          "postcondition": "部署记录已创建，状态为 pending 并立即转为 running，部署步骤开始异步执行",
          "parameters": [
            {
              "name": "req",
              "type": "CreateDeploymentRequest",
              "required": true,
              "description": "创建部署请求参数"
            }
          ],
          "returns": {
            "type": "CreateDeploymentResponse",
            "description": "包含部署 ID 和初始状态"
          },
          "errors": [
            {
              "code": "INVALID_REQUEST",
              "message": "请求参数不合法"
            },
            {
              "code": "ENVIRONMENT_NOT_FOUND",
              "message": "环境不存在"
            },
            {
              "code": "FILE_NOT_FOUND",
              "message": "文件不存在"
            },
            {
              "code": "SSH_CONNECTION_FAILED",
              "message": "SSH 连接失败"
            }
          ]
        },
        {
          "name": "CancelDeployment",
          "description": "取消正在进行的部署",
          "signature": "CancelDeployment(ctx context.Context, deploymentID string) error",
          "precondition": "部署存在且状态为 pending 或 running",
          "postcondition": "部署状态更新为 cancelled，中断执行并记录日志",
          "parameters": [
            {
              "name": "deploymentID",
              "type": "string",
              "required": true,
              "description": "部署 ID"
            }
          ],
          "returns": {
            "type": "void",
            "description": "无返回值"
          },
          "errors": [
            {
              "code": "DEPLOYMENT_NOT_FOUND",
              "message": "部署任务不存在"
            },
            {
              "code": "CANCEL_NOT_ALLOWED",
              "message": "不允许取消当前状态的部署"
            }
          ]
        }
      ],
      "dependencies": [
        "EnvironmentService",
        "SecurityService",
        "DeploymentRepository",
        "DeploymentLogger"
      ],
      "sla": {
        "response_time_ms": 2000,
        "availability": "99.9%"
      },
      "source_components": [
        "CMP-005"
      ],
      "source_requirements": [
        "REQ-004"
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "rule": "部署任务状态机规则",
      "description": "部署状态只能由 pending 变为 running，再由 running 变为 success/failed/cancelled。取消操作只能针对 pending 或 running 状态。",
      "type": "invariant",
      "enforcement": "在 Deployment 实体的状态变更方法中校验"
    },
    {
      "id": "BR-002",
      "rule": "部署步骤顺序执行",
      "description": "部署步骤必须按照预定义的顺序执行：创建目录 -> 上传文件 -> 生成脚本 -> 执行脚本。前一步骤失败则立即终止。",
      "type": "action_rule",
      "enforcement": "由 DeploymentExecutor 领域服务控制流程"
    },
    {
      "id": "BR-003",
      "rule": "SSH 连接参数校验",
      "description": "主机名非空，端口号 1-65535，用户名非空，私钥非空且格式有效。",
      "type": "invariant",
      "enforcement": "在 SSHConnection 值对象构造时校验"
    }
  ],
  "error_handling": {
    "strategy": "集中式错误处理",
    "categories": [
      {
        "category": "Business",
        "description": "业务逻辑错误，如状态不可取消",
        "http_code": 409,
        "retry_policy": "不可重试"
      },
      {
        "category": "Validation",
        "description": "输入参数校验失败",
        "http_code": 400,
        "retry_policy": "不可重试"
      },
      {
        "category": "External",
        "description": "依赖服务或 SSH 连接错误",
        "http_code": 502,
        "retry_policy": "可重试 3 次，指数退避"
      },
      {
        "category": "Internal",
        "description": "服务器内部错误",
        "http_code": 500,
        "retry_policy": "不可重试"
      }
    ],
    "logging": {
      "level": "error",
      "details": "记录完整错误堆栈和上下文信息到日志收集系统"
    }
  }
