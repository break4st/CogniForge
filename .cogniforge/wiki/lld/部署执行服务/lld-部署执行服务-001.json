  "module_boundary": {
    "in_scope": [
      "接收前端发起的部署请求，生成部署任务记录",
      "从环境服务获取SSH连接信息，从安全服务解密私钥",
      "建立SSH连接，按固定流程执行部署步骤（创建目录、上传文件、生成脚本、执行脚本）",
      "将部署过程中每一步的详细日志实时推送到Redis Pub/Sub",
      "通过WebSocket向前端实时推送日志",
      "支持取消正在执行的部署任务",
      "部署结束后更新任务状态，并通知部署历史与日志服务记录最终结果"
    ],
    "out_of_scope": [
      "用户身份认证与授权（由API网关或用户权限服务处理）",
      "文件的上传与元数据管理（由文件管理服务负责）",
      "项目、环境、SSH密钥等配置信息的增删改查",
      "部署记录的长期存储与查询界面"
    ],
    "owned_components": [
      "CMP-005"
    ],
    "owned_contracts": [
      "CTR-006",
      "CTR-007"
    ],
    "consumed_contracts": [
      "CTR-001",
      "CTR-002",
      "CTR-003",
      "CTR-004"
    ],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001",
      "DM-002"
    ]
  },
  "overview": {
    "description": "核心部署执行组件，接收前端发起的部署请求并异步执行，包括建立SSH连接、远程命令执行、文件上传、脚本生成与执行，并通过Redis和WebSocket提供实时日志推送。",
    "dependencies": [
      "项目与环境服务",
      "安全与密钥服务",
      "文件管理服务",
      "部署历史与日志服务"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "PostgreSQL",
      "Redis",
      "SSH/SFTP (golang.org/x/crypto/ssh)",
      "MinIO (间接)"
    ]
  },
