      "coverage": "full",
      "notes": "数据访问层封装了所有与SQLite的交互，通过INTERNAL接口向上层服务提供所需数据的CRUD操作，覆盖REQ-001的所有数据持久化需求。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "schema_versions",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "记录已应用的数据库迁移脚本，确保幂等初始化。仅供本模块内部使用。",
      "fields": [
        {
          "name": "version",
          "type": "INTEGER",
          "required": true,
          "description": "迁移版本号（主键）"
        },
        {
          "name": "name",
          "type": "TEXT",
          "required": true,
          "description": "迁移脚本描述性名称"
        },
        {
          "name": "applied_at",
          "type": "TEXT",
          "required": true,
          "description": "应用时间戳（ISO8601格式）"
        },
        {
          "name": "checksum",
          "type": "TEXT",
          "required": false,
          "description": "脚本内容的哈希值，用于检测更改"
        }
      ],
      "indexes": [
        {
          "name": "pk_version",
          "unique": true,
          "columns": [
            "version"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "version字段为主键，必须唯一",
        "applied_at字段不能为空"
      ],
      "lifecycle": {
        "create": "在执行数据库初始化时由迁移流程创建（如果表不存在）",
        "update": "每次执行新的迁移脚本时插入一行记录",
        "delete": "通常不删除记录，但可通过特定重置流程清空",
        "retention": "永久保留，用于审计迁移历史"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
