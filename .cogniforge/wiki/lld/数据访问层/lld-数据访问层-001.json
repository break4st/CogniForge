    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "管理SQLite数据库连接的生命周期（打开、关闭、健康检查）",
      "执行数据库模式（schema）的版本化迁移",
      "封装所有SQL执行操作（查询、插入、更新、删除）并转为Promise接口",
      "向上层服务提供针对核心业务实体（项目、环境、部署历史、模板）的类型化CRUD方法"
    ],
    "out_of_scope": [
      "业务校验逻辑（例如项目名称是否重复）由调用方服务负责",
      "具体业务流的编排（如部署执行流程）不属于本层",
      "跨进程通信（HTTP API、MQ）的暴露，本层仅作为内部Node.js模块被函数调用"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "封装 SQLite 数据库操作，提供异步的 DAO 接口，负责表结构初始化及项目、环境、历史、模板等数据的持久化。",
    "dependencies": [],
    "tech_stack": [
      "Node.js",
      "TypeScript",
      "better-sqlite3",
      "winston"
    ]
  },
  "topology": {
    "exchanges": [],
    "namespaces": [
      {
        "name": "sqlite-db",
        "type": "database",
        "description": "用于持久化所有业务数据的SQLite数据库文件",
        "buckets": [
          {
            "name": "projects",
            "type": "table",
            "description": "存储项目信息"
          },
          {
            "name": "environments",
            "type": "table",
            "description": "存储环境信息"
          },
          {
            "name": "deployment_histories",
            "type": "table",
            "description": "存储部署历史记录"
          },
          {
            "name": "templates",
            "type": "table",
            "description": "存储模板信息"
          },
          {
            "name": "schema_versions",
            "type": "table",
            "description": "存储已应用的数据库迁移版本"
          }
        ]
      }
    ],
    "buckets": []
  },
  "business_rules": {
    "invariants": [
      "数据库连接始终为打开状态，除非显式调用close()",
      "所有写操作必须在事务内执行，保证原子性",
      "数据迁移必须按版本顺序执行，且不可跳过",
      "已成功的迁移版本不可回滚"
    ]
  },
