  "module_boundary": {
    "in_scope": [
      "展示指定项目的环境卡片列表（名称、IP、端口、认证类型、密钥指纹、最后测试状态）",
      "提供新建环境表单（含密钥上传/密码输入）",
      "提供编辑环境功能（复用表单，支持密钥更新）",
      "提供测试连接功能（弹窗展示OS信息和状态）",
      "提供删除环境功能（二次确认）",
      "支持拖拽/点击选择私钥文件上传并展示指纹"
    ],
    "out_of_scope": [
      "后端SSH连接测试逻辑",
      "私钥加密存储细节",
      "部署执行流程",
      "项目管理、脚本管理等其他模块功能"
    ],
    "owned_components": [],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-005",
      "CTR-006",
      "CTR-007",
      "CTR-008"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "环境管理界面，展示项目下的所有环境卡片，提供增删改查、测试连接功能。用户可通过表单配置环境连接信息并上传私钥。",
    "dependencies": [
      "EnvironmentService（CMP-012）提供环境CRUD接口",
      "KeyManagementService（CMP-013）提供密钥上传接口",
      "更新接口（PUT /api/environments/{id}）和删除接口（DELETE /api/environments/{id}）待后端补充"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design"
    ]
  },
