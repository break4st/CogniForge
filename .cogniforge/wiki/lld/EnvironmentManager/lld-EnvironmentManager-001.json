  "error_handling": {
    "strategy": "封装统一的请求函数，自动解析后端规范错误格式 { code, error, detail }，网络错误提示通用消息，业务错误根据场景使用 message.error 或表单字段错误提示。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "参数校验错误",
        "description": "表单字段格式校验失败，在对应字段下方显示错误消息，不关闭弹窗。"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "项目或环境ID不存在，弹出全局提示并可能重定向。"
      },
      {
        "code": "502",
        "name": "连接测试失败",
        "description": "在测试结果弹窗中展示具体原因，如认证失败、超时等。"
      },
      {
        "code": "500",
        "name": "服务器错误",
        "description": "全局提示「服务器繁忙」，保留当前状态让用户重试。"
      },
      {
        "code": "NETWORK",
        "name": "网络异常",
        "description": "提示「网络连接失败，请检查网络」，不阻塞功能。"
      }
    ]
  },
  "workflow": {},
  "component_tree": [
    {
      "name": "EnvironmentManagerPage",
      "path": "/projects/:projectId/environments",
      "description": "环境管理主页面，负责加载列表、管理弹窗状态、分发操作",
      "props": [],
      "events": [],
      "state": [
        {
          "name": "environments",
          "type": "Environment[]",
          "description": "环境列表"
        },
        {
          "name": "loading",
          "type": "boolean",
          "description": "列表加载状态"
        },
        {
          "name": "error",
          "type": "string | null",
          "description": "加载错误信息"
        },
        {
          "name": "formVisible",
          "type": "boolean",
          "description": "新建/编辑弹窗可见性"
        },
        {
          "name": "editingEnv",
          "type": "Environment | null",
          "description": "当前编辑的环境对象，null表示新建"
        },
        {
          "name": "testResultModal",
          "type": "{ visible: boolean, envId: number, result: TestResult | null, error: string | null }",
          "description": "测试连接结果弹窗状态"
        }
      ],
      "behavior": [
        "挂载时调用 GET /api/projects/{projectId}/environments 获取列表",
        "新建按钮点击：设置 formVisible=true，editingEnv=null",
        "编辑按钮点击：设置 formVisible=true，editingEnv=当前环境",
        "删除按钮点击：弹出 Popconfirm 确认后调用 DELETE /api/environments/{id}（待后端实现），成功刷新列表",
        "测试按钮点击：设置 testResultModal.visible=true，envId 为环境ID，调用 POST /api/environments/{id}/test-connection，根据结果更新 result 或 error",
        "表单提交回调：调用创建或更新接口（更新接口待后端实现），成功后关闭弹窗并刷新列表"
      ],
      "edge_cases": [
        "列表加载失败：显示错误信息和重试按钮",
        "空列表：显示 Ant Design Empty 组件和新建按钮",
        "删除失败：弹出错误提示，列表保持不变",
        "测试连接超时：显示连接超时提示"
      ],
      "children": [
        {
          "name": "EnvironmentCard",
          "path": "页面内渲染列表",
          "description": "展示单个环境信息及操作按钮",
          "props": [
            {
              "name": "env",
              "type": "Environment",
              "required": true,
              "description": "环境对象"
            },
            {
              "name": "onEdit",
              "type": "(env: Environment) => void",
              "required": true,
              "description": "编辑回调"
            },
            {
              "name": "onDelete",
              "type": "(envId: number) => void",
              "required": true,
              "description": "删除回调，传入环境ID"
            },
            {
              "name": "onTest",
              "type": "(envId: number) => void",
              "required": true,
              "description": "测试连接回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "展示环境名称、IP:Port、认证类型、密钥指纹（如有）、上次测试状态",
            "提供编辑、删除、测试按钮",
            "删除时弹出 Popconfirm 二次确认"
          ],
          "edge_cases": [
            "指纹为空时显示「未设置」",
            "测试状态异常时显示警告样式"
          ]
        },
        {
          "name": "EnvironmentFormModal",
          "path": "页面内条件渲染",
          "description": "新建或编辑环境的表单弹窗",
          "props": [
            {
              "name": "visible",
              "type": "boolean",
              "required": true,
              "description": "弹窗可见性"
            },
            {
              "name": "editingEnv",
              "type": "Environment | null",
              "required": true,
              "description": "编辑的环境对象，null表示新建"
            },
            {
              "name": "onClose",
              "type": "() => void",
              "required": true,
              "description": "关闭回调"
            },
            {
              "name": "onSubmit",
              "type": "(values: FormData) => void",
              "required": true,
              "description": "提交回调，传递表单数据"
            }
          ],
          "events": [],
          "state": [
            {
              "name": "uploadingKey",
              "type": "boolean",
              "description": "密钥上传中"
            },
            {
              "name": "keyFingerprint",
              "type": "string | null",
              "description": "已上传的密钥指纹"
            },
            {
              "name": "selectedFile",
              "type": "File | null",
              "description": "选择的私钥文件，用于新建时随表单提交"
            }
          ],
          "behavior": [
            "根据 editingEnv 设置标题和表单初始值",
            "表单包含：name, ip, port（默认22）, authType（Select：password/key）, deployRootPath",
            "authType 为 key 时显示 KeyUploader 子组件，否则显示 password 输入框",
            "编辑模式下显示已有指纹并提供「更新密钥」按钮",
            "提交时校验所有必填项，组装 FormData（包含文件）调用 onSubmit"
          ],
          "edge_cases": [
            "端口号范围校验（1-65535），IP 格式校验",
            "密钥上传失败时提示错误，不阻塞表单提交（可改用密码）",
            "编辑环境下更新密钥成功后更新本地指纹显示"
          ],
          "children": [
            {
              "name": "KeyUploader",
              "path": "EnvironmentFormModal 的子组件",
              "description": "拖拽/点击上传私钥文件，返回指纹",
              "props": [
                {
                  "name": "environmentId",
                  "type": "number | null",
                  "required": false,
                  "description": "编辑环境时已存在的环境ID，用于直接上传；新建时为 null，仅收集文件"
                },
                {
                  "name": "onFileSelected",
                  "type": "(file: File) => void",
                  "required": false,
                  "description": "新建时选择文件回调，传递 File 对象"
                },
                {
                  "name": "onUploadSuccess",
                  "type": "(fingerprint: string) => void",
                  "required": false,
                  "description": "上传成功回调（仅编辑模式）"
                },
                {
                  "name": "onUploadError",
                  "type": "(error: string) => void",
                  "required": false,
                  "description": "上传失败回调"
                }
              ],
              "events": [],
              "state": [
                {
                  "name": "uploading",
                  "type": "boolean",
                  "description": "上传进行中"
                },
                {
                  "name": "error",
                  "type": "string | null",
                  "description": "上传错误信息"
                }
              ],
              "behavior": [
                "使用 Ant Design 的 Upload.Dragger 组件，限制文件类型为 .pem/.key 等",
                "编辑模式下选择文件后自动调用 POST /api/environments/{environmentId}/key 上传，成功后回调 onUploadSuccess",
                "新建模式下选择文件后调用 onFileSelected 将 File 对象传给父组件，由父组件在表单提交时一并处理"
              ],
              "edge_cases": [
                "文件大小限制 16KB，格式校验",
                "上传超时：显示超时提示，允许重试"
              ]
            }
          ]
        },
        {
          "name": "ConnectionTestResult",
          "path": "页面内 Modal 组件",
          "description": "展示连接测试结果或错误",
          "props": [
            {
              "name": "visible",
              "type": "boolean",
              "required": true,
              "description": "弹窗可见性"
            },
            {
              "name": "loading",
              "type": "boolean",
              "required": true,
              "description": "测试进行中"
            },
            {
              "name": "result",
              "type": "TestResult | null",
              "required": false,
              "description": "成功结果"
            },
            {
              "name": "error",
              "type": "string | null",
              "required": false,
              "description": "错误信息"
            },
            {
              "name": "onClose",
              "type": "() => void",
              "required": true,
              "description": "关闭回调"
            },
            {
              "name": "onRetry",
              "type": "() => void",
              "required": false,
              "description": "重试回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "显示 loading 时用 Spin 组件",
            "成功时展示 os_info 和 status",
            "失败时展示错误信息并提供重试按钮"
          ],
          "edge_cases": [
            "连接超时无响应：显示超时错误",
            "服务器返回非预期格式：显示通用错误"
          ]
        }
      ]
    }
  ],
  "state_design": {
    "global": [],
    "caching_strategy": "环境列表在页面挂载时强制重新请求，不主动缓存；可在未来引入 SWR 策略实现短时间内复用数据。"
  },
  "route_design": [
    {
      "path": "/projects/:projectId/environments",
      "page": "EnvironmentManagerPage",
      "title": "环境管理",
      "auth": "all",
      "layout": "default"
    }
  ],
  "interaction_flows": [
    {
      "name": "环境列表加载流程",
      "description": "进入页面后自动加载指定项目的环境列表",
      "steps": [
        "用户通过导航或路由进入 /projects/:projectId/environments",
        "页面组件挂载，useEffect 调用 GET /api/projects/{projectId}/environments",
        "显示 loading 状态",
        "成功：渲染 EnvironmentCard 列表",
        "失败：显示错误信息与重试按钮"
      ]
    },
    {
      "name": "新建环境流程（含密钥）",
      "description": "用户打开新建弹窗填写信息并可能上传私钥",
      "steps": [
        "点击「新建环境」按钮，打开空白表单弹窗",
        "用户填写名称、IP、端口、认证方式、部署根路径；若选密钥认证则通过 KeyUploader 选择私钥文件",
        "点击确定",
        "前端组装 FormData（含文件），调用 POST /api/projects/{projectId}/environments",
        "成功：获得新环境 id，关闭弹窗，提示成功，刷新列表",
        "失败：显示错误信息，保留弹窗，用户可重试"
      ]
    },
    {
      "name": "编辑环境流程",
      "description": "用户编辑已有环境信息，可能更新密钥",
      "steps": [
        "在卡片上点击「编辑」按钮，传入环境对象",
        "打开表单弹窗，预填现有数据",
        "用户修改信息；如需更新密钥，点击「更新密钥」激活上传组件选择文件",
