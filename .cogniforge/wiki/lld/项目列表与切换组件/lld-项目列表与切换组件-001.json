{
  "meta": {
    "doc_id": "lld-project-list",
    "type": "lld",
    "module_type": "frontend",
    "module": "项目列表与切换组件",
    "title": "项目列表与切换组件 详细设计文档",
    "author": "design_agent",
    "created": "2025-04-16T10:00:00Z",
    "version": 2,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-001"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": [
        "CMP-001"
      ],
      "contracts": [
        "CTR-001",
        "CTR-003"
      ],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "展示所有项目的列表（名称、描述、创建时间）",
      "搜索过滤项目名称和描述",
      "高亮当前激活项目",
      "点击项目行切换当前项目并触发环境列表刷新",
      "提供新建项目按钮（触发项目编辑对话框组件）",
      "提供编辑项目按钮（触发项目编辑对话框组件并传入项目数据）",
      "提供删除项目按钮（含确认弹窗，直接调用删除接口）",
      "项目列表数据加载状态、空状态、错误状态处理"
    ],
    "out_of_scope": [
      "项目新建/编辑表单的详细 UI 和表单提交逻辑（由项目编辑对话框组件承担）",
      "项目删除确认对话框的样式定制（使用 Ant Design Popconfirm 内置样式）",
      "项目列表分页/无限滚动（当前假设项目数量较小）",
      "环境列表的获取与展示"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-001",
      "CTR-003"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "前端 React 组件，提供项目列表的查看、搜索、切换和操作入口。是项目管理功能在用户界面的核心交互组件，与全局状态联动，确保当前项目切换时通知其他模块更新。",
    "dependencies": [
      "项目编辑对话框组件",
      "全局状态管理（React Context）"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design",
      "react-router-dom v6",
      "axios",
      "TypeScript"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001",
        "CTR-003"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001"
        ],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "所有需求点均已覆盖，列表展示、搜索、切换、新建/编辑/删除入口全部实现。"
    }
  ],
  "business_rules": {
    "invariants": [
      "当前激活项目必须在项目列表中可见（除非列表为空）",
      "项目列表数据源自 GET /api/projects，不得缓存或本地持久化",
      "删除项目时必须进行二次确认，防止误操作",
      "切换项目时必须清空上个项目的环境列表并触发重新加载"
    ]
  },
  "component_tree": {
    "root": {
      "name": "ProjectListPage",
      "type": "Page",
      "description": "项目列表页面容器，负责管理路由、提供上下文、组合子组件",
      "props": {},
      "state": {
        "projects": "Project[]",
        "loading": "boolean",
        "error": "string | null",
        "searchText": "string",
        "activeProjectId": "string | null",
        "deleteLoading": "string | null (projectId)"
      },
      "children": [
        {
          "name": "ProjectListHeader",
          "type": "Composite",
          "description": "包含搜索框和新建按钮的头部区域",
          "props": {
            "searchText": "string",
            "onSearchChange": "(text: string) => void",
            "onNewProject": "() => void"
          },
          "state": {},
          "children": [
            {
              "name": "SearchInput",
              "type": "AntInput",
              "description": "搜索输入框",
              "props": {
                "placeholder": "Search projects...",
                "value": "searchText",
                "onChange": "onSearchChange"
              }
            },
            {
              "name": "NewProjectButton",
              "type": "AntButton",
              "description": "新建项目按钮",
              "props": {
                "type": "primary",
                "icon": "<PlusOutlined />",
                "onClick": "onNewProject"
              }
            }
          ]
        },
        {
          "name": "ProjectList",
          "type": "AntList",
          "description": "项目列表展示，处理加载、空、错误状态",
          "props": {
            "dataSource": "filteredProjects",
            "loading": "loading",
            "error": "error",
            "activeProjectId": "activeProjectId",
            "onSelectProject": "(projectId: string) => void",
            "onEditProject": "(project: Project) => void",
            "onDeleteProject": "(projectId: string) => void",
            "deleteLoading": "deleteLoading (projectId)"
          },
          "state": {},
          "children": [
            {
              "name": "ProjectListItem",
              "type": "AntList.Item",
              "description": "单个项目行，含操作按钮",
              "props": {
                "project": "Project",
                "isActive": "boolean",
                "onSelect": "() => void",
                "onEdit": "() => void",
                "onDelete": "() => void",
                "isDeleteLoading": "boolean"
              },
              "children": [
                {
                  "name": "ProjectMeta",
                  "type": "AntList.Item.Meta",
                  "description": "项目信息展示",
                  "props": {
                    "title": "project.name",
                    "description": "project.description"
                  }
                },
                {
                  "name": "ActionButtons",
                  "type": "Space",
                  "description": "编辑和删除按钮组",
                  "children": [
                    {
                      "name": "EditButton",
                      "type": "AntButton",
                      "props": {
                        "icon": "<EditOutlined />",
                        "onClick": "onEdit"
                      }
                    },
                    {
                      "name": "DeleteButton",
                      "type": "AntPopconfirm",
                      "props": {
                        "title": "确定要删除此项目吗？",
                        "onConfirm": "onDelete",
                        "okButtonProps": { "loading": "isDeleteLoading" }
                      },
                      "children": [
                        {
                          "name": "DeleteIconButton",
                          "type": "AntButton",
                          "props": {
                            "icon": "<DeleteOutlined />",
                            "danger": true
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "state_design": {
    "component_name": "ProjectListPage",
    "state_schema": {
      "projects": {
        "type": "array<Project>",
        "default": [],
        "description": "从后端获取的项目列表"
      },
      "loading": {
        "type": "boolean",
        "default": true,
        "description": "列表数据加载状态"
      },
      "error": {
        "type": "string | null",
        "default": null,
        "description": "加载错误信息"
      },
      "searchText": {
        "type": "string",
        "default": "",
        "description": "搜索文本"
      },
      "activeProjectId": {
        "type": "string | null",
        "default": null,
        "description": "当前选中的项目ID，null表示无选中"
      },
      "deleteLoading": {
        "type": "string | null",
        "default": null,
        "description": "正在删除的项目ID，null表示无删除操作"
      }
    },
    "derived_state": {
      "filteredProjects": {
        "description": "根据searchText过滤projects后的列表",
        "computation": "projects.filter(p => p.name.includes(searchText) || p.description.includes(searchText))"
      }
    },
    "state_transitions": [
      {
        "event": "fetchProjects",
        "precondition": "loading === false",
        "transition": "loading = true; error = null",
        "side_effects": "调用GET /api/projects",
        "postcondition": "若成功: loading = false; projects = data; 若失败: loading = false; error = message"
      },
      {
        "event": "setSearchText",
        "payload": "text",
        "transition": "searchText = text"
      },
      {
        "event": "selectProject",
        "payload": "projectId",
        "transition": "activeProjectId = projectId",
        "side_effects": "触发全局上下文更新，通知环境列表刷新"
      },
      {
        "event": "deleteProject",
        "payload": "projectId",
        "precondition": "deleteLoading === null",
        "transition": "deleteLoading = projectId",
        "side_effects": "调用DELETE /api/projects/{projectId}",
        "postcondition": "若成功: projects移除对应项; activeProjectId若为被删项则置null; deleteLoading = null; 若失败: deleteLoading = null; 显示错误"
      },
      {
        "event": "openNewProjectDialog",
        "side_effects": "打开项目编辑对话框组件（新建模式）"
      },
      {
        "event": "openEditProjectDialog",
        "payload": "project",
        "side_effects": "打开项目编辑对话框组件（编辑模式，传入项目数据）"
      }
    ]
  },
  "route_design": {
    "routes": [
      {
        "path": "/projects",
        "component": "ProjectListPage",
        "exact": false,
        "meta": {
          "title": "项目列表",
          "requiresAuth": true
        },
        "children": []
      }
    ],
    "navigation_flow": "侧边栏菜单项「项目」链接至 /projects",
    "route_guards": [
      "登录状态守卫：未登录重定向至 /login"
    ]
  },
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "项目列表加载",
      "trigger": "页面组件挂载",
      "steps": [
        "1. 状态 loading: true, error: null",
        "2. 调用 GET /api/projects",
        "3. 成功：更新 projects，loading: false",
        "4. 失败：设置 error 信息，loading: false",
        "5. 渲染列表或错误状态（含重试按钮）"
      ]
    },
    {
      "id": "FLOW-002",
      "name": "项目搜索过滤",
      "trigger": "搜索输入框 onChange",
      "steps": [
        "1. 更新 searchText 状态",
        "2. 计算 filteredProjects",
        "3. 自动重新渲染列表"
      ]
    },
    {
      "id": "FLOW-003",
      "name": "切换活动项目",
      "trigger": "点击项目行（选中区域）",
      "steps": [
        "1. 调用 selectProject(projectId)",
        "2. 更新 activeProjectId",
        "3. 高亮该行",
        "4. 触发 Context 动作：设置当前项目ID，清空环境列表，重新加载环境"
      ]
    },
    {
      "id": "FLOW-004",
      "name": "新建项目",
      "trigger": "点击新建按钮",
      "steps": [
        "1. 调用 openNewProjectDialog()",
        "2. 弹出项目编辑对话框（空白表单）",
        "3. 提交成功后：对话框关闭，重新 fetchProjects()"
      ]
    },
    {
      "id": "FLOW-005",
      "name": "编辑项目",
      "trigger": "点击编辑按钮",
      "steps": [
        "1. 调用 openEditProjectDialog(project)",
        "2. 弹出项目编辑对话框（预填表单）",
        "3. 提交成功后：对话框关闭，重新 fetchProjects()"
      ]
    },
    {
      "id": "FLOW-006",
      "name": "删除项目",
      "trigger": "点击删除按钮并确认",
      "steps": [
        "1. Popconfirm 显示",
        "2. 用户确认",
        "3. 状态 deleteLoading = projectId",
        "4. 调用 DELETE /api/projects/{projectId}",
        "5. 成功：从 projects 移除，若 activeProjectId 等于该 id 则置 null，deleteLoading = null",
        "6. 失败：保持列表不变，deleteLoading = null，显示错误"
      ]
    }
  ],
  "api_integration": {
    "base_url": "环境变量 REACT_APP_API_BASE_URL",
    "default_headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <token> (从上下文中获取)"
    },
    "apis": [
      {
        "id": "API-001",
        "name": "获取项目列表",
        "method": "GET",
        "endpoint": "/api/projects",
        "description": "获取所有项目",
        "headers": {},
        "params": {},
        "body": null,
        "response": {
          "type": "json",
          "schema": {
            "projects": "Project[]"
          }
        },
        "error_handling": "显示全局错误提示，可重试"
      },
      {
        "id": "API-002",
        "name": "删除项目",
        "method": "DELETE",
        "endpoint": "/api/projects/{projectId}",
        "description": "删除指定项目",
        "headers": {},
        "params": {
          "projectId": "string"
        },
        "body": null,
        "response": {
          "type": "json",
          "schema": {
            "message": "string"
          }
        },
        "error_handling": "显示错误提示，撤销 loading 状态"
      }
    ],
    "shared_services": [
      "全局项目上下文 (ProjectContext) 用于获取和设置 activeProjectId",
      "Axios 拦截器统一处理认证和基础错误"
    ]
  },
  "data_models": [
    {
      "id": "DM-001",
      "name": "Project",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "前端组件内部使用的项目数据结构，对应后端返回的 JSON 对象",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "项目唯一标识符"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "string (datetime)",
          "required": true,
          "description": "创建时间，ISO 8601 格式"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "从 GET /api/projects 响应中创建",
        "update": "新建或编辑操作成功后，通过重新获取列表更新",
        "delete": "删除操作成功后，从本地列表移除对应项",
        "retention": "仅存在于组件生命周期内，不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "获取项目列表",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "frontend",
      "endpoint": "/api/projects",
      "description": "组件挂载时调用以获取所有项目。该接口由项目管理服务提供，虽未在 SAD 契约中列出，但为必要依赖。",
      "parameters": [],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "projects": "Project[]"
        }
      },
      "error_codes": [
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "服务器内部错误"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "使用 axios 响应拦截器统一捕获 HTTP 错误，提取后端统一错误结构 { code, error, detail }，通过 Ant Design message.error() 显示用户友好提示；网络错误单独提示「网络连接失败」；列表加载失败提供重试按钮。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "请求参数错误或资源不存在，直接显示 detail 信息，如 404 时提示「项目不存在或已被删除」。"
      },
      {
        "code": "5xx",
        "name": "服务器错误",
        "description": "后端内部异常，提示「服务器繁忙，请稍后重试」并提供重试机会。"
      },
      {
        "code": "NETWORK_ERROR",
        "name": "网络错误",
        "description": "请求超时、无网络连接等，提示「网络连接失败，请检查网络」。"
      }
    ]
  },
  "workflow": {
    "name": "删除项目操作流程",
    "description": "用户确认删除项目到项目列表刷新的完整序列",
    "steps": [
      {
        "order": 1,
        "name": "点击删除按钮",
        "action": "显示 Ant Design Popconfirm 确认框",
        "timeout_seconds": 0,
        "on_failure": "无"
      },
      {
        "order": 2,
        "name": "确认删除",
        "action": "发送 DELETE /api/projects/{projectId} 请求，按钮进入 loading 状态",
        "timeout_seconds": 10,
        "on_failure": "显示错误提示，恢复按钮状态"
      },
      {
        "order": 3,
        "name": "更新UI",
        "action": "从列表中移除该项目，若为当前活动项目则清空活动项目",
        "timeout_seconds": 0,
        "on_failure": "无"
      }
    ]
  }
}