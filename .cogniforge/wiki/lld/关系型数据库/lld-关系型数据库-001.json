        { "name": "idx_audit_logs_project_id", "columns": ["project_id"], "unique": false, "type": "B-tree", "purpose": "支持按项目维度查询所有操作记录" },
        { "name": "idx_audit_logs_created_at", "columns": ["created_at"], "unique": false, "type": "B-tree", "purpose": "支持按时间范围查询审计日志，便于分页和报表" }
      ]
    }
