{
  "meta": {
    "doc_id": "lld-关系型数据库-001",
    "type": "lld",
    "module_type": "database",
    "module": "关系型数据库",
    "title": "关系型数据库详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "存储项目、环境、部署记录等结构化数据。本模块作为整个系统的数据持久化层，通过 PostgreSQL 15+ 提供项目、环境、SSH密钥、部署记录和审计日志的可靠存储与高效查询能力。所有后端服务通过 SQLAlchemy ORM 统一访问数据库，确保数据一致性、完整性和安全性。",
    "dependencies": [],
    "tech_stack": [
      "PostgreSQL 15+",
      "SQLAlchemy",
      "SQL"
    ]
  },
  "data_models": [
    {
      "name": "users",
      "type": "table",
      "ownership": "canonical",
      "description": "系统用户账号表，存储认证和授权所需的用户信息。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增用户ID" },
        { "name": "username", "type": "VARCHAR(100)", "required": true, "description": "用户名，唯一标识" },
        { "name": "password_hash", "type": "VARCHAR(255)", "required": true, "description": "密码的 bcrypt 哈希值" },
        { "name": "role", "type": "VARCHAR(50)", "required": true, "description": "用户角色：admin（管理员）/ operator（运维人员）/ manager（项目经理）" },
        { "name": "created_at", "type": "TIMESTAMP", "required": true, "description": "记录创建时间" },
        { "name": "updated_at", "type": "TIMESTAMP", "required": false, "description": "记录最后更新时间" }
      ],
      "indexes": [
        { "name": "idx_users_username", "unique": true, "columns": ["username"] }
      ]
    },
    {
      "name": "projects",
      "type": "table",
      "ownership": "canonical",
      "description": "项目信息表，存储项目的名称、描述等基本信息。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增项目ID" },
        { "name": "name", "type": "VARCHAR(200)", "required": true, "description": "项目名称" },
        { "name": "description", "type": "TEXT", "required": false, "description": "项目描述" },
        { "name": "created_at", "type": "TIMESTAMP", "required": true, "description": "记录创建时间" },
        { "name": "updated_at", "type": "TIMESTAMP", "required": false, "description": "记录最后更新时间" }
      ],
      "indexes": [
        { "name": "idx_projects_name", "unique": false, "columns": ["name"] }
      ]
    },
    {
      "name": "environments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署环境配置表，存储服务器连接参数、环境类型和关联的SSH密钥。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增环境ID" },
        { "name": "name", "type": "VARCHAR(200)", "required": true, "description": "环境名称" },
        { "name": "type", "type": "VARCHAR(20)", "required": true, "description": "环境类型：test（测试线）/ gray（灰度线）/ production（正式线）" },
        { "name": "host", "type": "VARCHAR(255)", "required": true, "description": "远程服务器地址（IP或域名）" },
        { "name": "port", "type": "INTEGER", "required": true, "description": "SSH连接端口号" },
        { "name": "key_id", "type": "BIGINT", "required": false, "description": "关联的SSH密钥ID，外键关联 ssh_keys 表" },
        { "name": "status", "type": "VARCHAR(20)", "required": true, "description": "环境连接状态：active/ inactive/ unknown" },
        { "name": "created_at", "type": "TIMESTAMP", "required": true, "description": "记录创建时间" },
        { "name": "updated_at", "type": "TIMESTAMP", "required": false, "description": "记录最后更新时间" }
      ],
      "indexes": [
        { "name": "idx_environments_key_id", "unique": false, "columns": ["key_id"] },
        { "name": "idx_environments_type", "unique": false, "columns": ["type"] }
      ]
    },
    {
      "name": "project_environments",
      "type": "table",
      "ownership": "canonical",
      "description": "项目与环境的关联关系表，支持多对多的项目-环境映射。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增ID" },
        { "name": "project_id", "type": "BIGINT", "required": true, "description": "项目ID，外键关联 projects 表" },
        { "name": "environment_id", "type": "BIGINT", "required": true, "description": "环境ID，外键关联 environments 表" }
      ],
      "indexes": [
        { "name": "idx_pe_project_id", "unique": false, "columns": ["project_id"] },
        { "name": "idx_pe_environment_id", "unique": false, "columns": ["environment_id"] },
        { "name": "uniq_pe_project_environment", "unique": true, "columns": ["project_id", "environment_id"] }
      ]
    },
    {
      "name": "ssh_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "SSH密钥存储表，密钥内容经过加密后存储，确保敏感信息安全。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增密钥ID" },
        { "name": "name", "type": "VARCHAR(200)", "required": true, "description": "密钥名称，用于识别和标记" },
        { "name": "encrypted_key_content", "type": "TEXT", "required": true, "description": "使用服务端加密密钥加密后的密钥明文" },
        { "name": "fingerprint", "type": "VARCHAR(100)", "required": false, "description": "密钥指纹（SHA256摘要），用于验证密钥唯一性" },
        { "name": "description", "type": "TEXT", "required": false, "description": "密钥备注说明" },
        { "name": "created_at", "type": "TIMESTAMP", "required": true, "description": "记录创建时间" },
        { "name": "updated_at", "type": "TIMESTAMP", "required": false, "description": "记录最后更新时间" }
      ],
      "indexes": [
        { "name": "idx_ssh_keys_fingerprint", "unique": true, "columns": ["fingerprint"] }
      ]
    },
    {
      "name": "deployments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署任务记录表，存储每次部署操作的完整信息，包括状态、版本、进度等。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增内部ID" },
        { "name": "deploy_id", "type": "VARCHAR(36)", "required": true, "description": "对外暴露的部署任务唯一标识（UUID格式），前端轮询时使用" },
        { "name": "project_id", "type": "BIGINT", "required": true, "description": "目标项目ID，外键关联 projects 表" },
        { "name": "env_id", "type": "BIGINT", "required": true, "description": "目标环境ID，外键关联 environments 表" },
        { "name": "version", "type": "VARCHAR(100)", "required": true, "description": "部署版本号，系统自动生成或用户自定义" },
        { "name": "artifact_path", "type": "VARCHAR(500)", "required": true, "description": "可执行文件路径" },
        { "name": "config_path", "type": "VARCHAR(500)", "required": false, "description": "配置文件路径（可选）" },
        { "name": "status", "type": "VARCHAR(20)", "required": true, "description": "部署状态：pending/ running/ success/ failed" },
        { "name": "progress", "type": "INTEGER", "required": true, "description": "部署进度百分比（0-100）" },
        { "name": "started_at", "type": "TIMESTAMP", "required": false, "description": "部署任务开始执行时间" },
        { "name": "finished_at", "type": "TIMESTAMP", "required": false, "description": "部署任务完成时间" },
        { "name": "created_at", "type": "TIMESTAMP", "required": true, "description": "记录创建时间" }
      ],
      "indexes": [
        { "name": "idx_deployments_deploy_id", "unique": true, "columns": ["deploy_id"] },
        { "name": "idx_deployments_project_id", "unique": false, "columns": ["project_id"] },
        { "name": "idx_deployments_env_id", "unique": false, "columns": ["env_id"] },
        { "name": "idx_deployments_status", "unique": false, "columns": ["status"] },
        { "name": "idx_deployments_created_at", "unique": false, "columns": ["created_at"] }
      ]
    },
    {
      "name": "deployment_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "部署任务执行日志表，存储部署过程中产生的详细日志条目。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增ID" },
        { "name": "deployment_id", "type": "BIGINT", "required": true, "description": "关联的部署任务ID，外键关联 deployments 表的 id" },
        { "name": "log_content", "type": "TEXT", "required": true, "description": "日志内容文本" },
        { "name": "log_level", "type": "VARCHAR(20)", "required": true, "description": "日志级别：INFO/ WARN/ ERROR/ DEBUG" },
        { "name": "created_at", "type": "TIMESTAMP", "required": true, "description": "日志记录时间" }
      ],
      "indexes": [
        { "name": "idx_deployment_logs_deployment_id", "unique": false, "columns": ["deployment_id"] },
        { "name": "idx_deployment_logs_created_at", "unique": false, "columns": ["created_at"] }
      ]
    },
    {
      "name": "audit_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "审计日志表，记录所有用户操作和系统事件，满足可审计和可追溯需求。",
      "fields": [
        { "name": "id", "type": "BIGSERIAL", "required": true, "description": "主键，自增ID" },
        { "name": "action", "type": "VARCHAR(100)", "required": true, "description": "操作类型标识，如 create_project/ trigger_deploy/ update_key 等" },
        { "name": "operator", "type": "VARCHAR(100)", "required": true, "description": "操作人用户名" },
        { "name": "target_type", "type": "VARCHAR(50)", "required": true, "description": "操作目标类型：project/ environment/ key/ deployment" },
        { "name": "target_id", "type": "BIGINT", "required": false, "description": "操作目标ID" },
        { "name": "target", "type": "VARCHAR(255)", "required": false, "description": "操作目标的可读描述（用于API响应中的 target 字段）" },
        { "name": "detail", "type": "TEXT", "required": false, "description": "操作详情或变更内容" },
        { "name": "project_id", "type": "BIGINT", "required": false, "description": "归属项目ID，用于按项目过滤查询" },
        { "name": "created_at", "type": "TIMESTAMP", "required": true, "description": "操作发生时间" }
      ],
      "indexes": [
        { "name": "idx_audit_logs_action", "unique": false, "columns": ["action"] },
        { "name": "idx_audit_logs_operator", "unique": false, "columns": ["operator"] },
        { "name": "idx_audit_logs_project_id", "unique": false, "columns": ["project_id"] },
        { "name": "idx_audit_logs_created_at", "unique": false, "columns": ["created_at"] }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "项目数据查询",
      "method": "INTERNAL",
      "endpoint": "projects/query",
      "description": "按分页参数查询项目列表，支持按项目ID查询单个项目详情。",
      "parameters": [
        { "name": "id", "type": "integer", "description": "项目ID（可选，指定时返回单个项目）" },
        { "name": "page", "type": "integer", "description": "分页页码（默认1）" },
        { "name": "size", "type": "integer", "description": "每页数量（默认20）" }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "description": "string",
          "environments": "array"
        }
      },
      "error_codes": [
        { "code": 404, "message": "项目不存在" }
      ]
    },
    {
      "name": "环境数据查询",
      "method": "INTERNAL",
      "endpoint": "environments/query",
      "description": "按项目ID或环境ID查询部署环境列表，支持按环境类型过滤。",
      "parameters": [
        { "name": "id", "type": "integer", "description": "环境ID（可选）" },
        { "name": "project_id", "type": "integer", "description": "项目ID（可选，按项目过滤）" },
        { "name": "type", "type": "string", "description": "环境类型过滤（test/ gray/ production）" }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "integer",
          "status": "string"
        }
      },
      "error_codes": [
        { "code": 404, "message": "环境不存在" }
      ]
    },
    {
      "name": "SSH密钥数据查询",
      "method": "INTERNAL",
      "endpoint": "keys/query",
      "description": "查询SSH密钥信息，返回密钥元数据（不包含密文内容）。",
      "parameters": [
        { "name": "id", "type": "integer", "description": "密钥ID（可选）" }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "fingerprint": "string"
        }
      },
      "error_codes": [
        { "code": 404, "message": "密钥不存在" }
      ]
    },
    {
      "name": "部署记录查询",
      "method": "INTERNAL",
      "endpoint": "deployments/query",
      "description": "按部署ID查询单条部署记录详情，或按项目/环境过滤部署历史列表。",
      "parameters": [
        { "name": "deploy_id", "type": "string", "description": "部署任务唯一标识" },
        { "name": "project_id", "type": "integer", "description": "按项目过滤" },
        { "name": "env_id", "type": "integer", "description": "按环境过滤" },
        { "name": "page", "type": "integer", "description": "分页页码" },
        { "name": "size", "type": "integer", "description": "每页数量" }
      ],
      "response": {
        "status": 200,
        "body": {
          "deploy_id": "string",
          "status": "string",
          "progress": "integer",
          "logs": "array",
          "started_at": "string",
          "finished_at": "string"
        }
      },
      "error_codes": [
        { "code": 404, "message": "部署记录不存在" }
      ]
    },
    {
      "name": "部署记录写入",
      "method": "INTERNAL",
      "endpoint": "deployments/create",
      "description": "创建新的部署任务记录并写入数据库。",
      "parameters": [
        { "name": "project_id", "type": "integer", "description": "目标项目ID" },
        { "name": "env_id", "type": "integer", "description": "目标环境ID" },
        { "name": "version", "type": "string", "description": "部署版本号" },
        { "name": "artifact_path", "type": "string", "description": "可执行文件路径" },
        { "name": "config_path", "type": "string", "description": "配置文件路径（可选）" }
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "deploy_id": "string",
          "status": "string",
          "version": "string",
          "created_at": "string"
        }
      },
      "error_codes": [
        { "code": 400, "message": "参数校验失败，必填字段缺失" },
        { "code": 409, "message": "版本号冲突" }
      ]
    },
    {
      "name": "部署状态更新",
      "method": "INTERNAL",
      "endpoint": "deployments/update-status",
      "description": "更新部署任务的执行状态、进度和时间信息。",
      "parameters": [
        { "name": "deploy_id", "type": "string", "description": "部署任务唯一标识" },
        { "name": "status", "type": "string", "description": "更新后的状态" },
        { "name": "progress", "type": "integer", "description": "当前进度百分比" },
        { "name": "log_entry", "type": "string", "description": "新增日志内容（可选）" },
        { "name": "log_level", "type": "string", "description": "日志级别（可选）" }
      ],
      "response": {
        "status": 200,
        "body": {
          "deploy_id": "string",
          "status": "string",
          "progress": "integer",
          "updated_at": "string"
        }
      },
      "error_codes": [
        { "code": 404, "message": "部署记录不存在" }
      ]
    },
    {
      "name": "审计日志查询",
      "method": "INTERNAL",
      "endpoint": "audit-logs/query",
      "description": "按多种条件分页查询审计日志记录。",
      "parameters": [
        { "name": "page", "type": "integer", "description": "分页页码" },
        { "name": "size", "type": "integer", "description": "每页数量" },
        { "name": "action_type", "type": "string", "description": "操作类型过滤" },
        { "name": "project_id", "type": "integer", "description": "按项目过滤" },
        { "name": "start_time", "type": "string", "description": "开始时间" },
        { "name": "end_time", "type": "string", "description": "结束时间" }
      ],
      "response": {
        "status": 200,
        "body": {
          "total": "integer",
          "items": "array"
        }
      },
      "error_codes": []
    },
    {
      "name": "审计日志写入",
      "method": "INTERNAL",
      "endpoint": "audit-logs/insert",
      "description": "记录一条审计日志条目，确保所有关键操作可追溯。",
      "parameters": [
        { "name": "action", "type": "string", "description": "操作类型" },
        { "name": "operator", "type": "string", "description": "操作人" },
        { "name": "target_type", "type": "string", "description": "目标类型" },
        { "name": "target_id", "type": "integer", "description": "目标ID" },
        { "name": "target", "type": "string", "description": "目标可读描述" },
        { "name": "detail", "type": "string", "description": "操作详情" },
        { "name": "project_id", "type": "integer", "description": "归属项目ID" }
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "created_at": "string"
        }
      },
      "error_codes": [
        { "code": 400, "message": "必填字段缺失" }
      ]
    }
  ],
  "error_handling": {
    "strategy": "采用 ORM 级异常捕获 + 连接重试机制。连接级错误（超时、断开）自动重试并释放连接回池；约束违反错误（唯一冲突、外键缺失）向上层服务返回明确错误码和描述；事务级错误（死锁、序列化冲突）自动回滚重试。所有数据库异常统一封装为 DataAccessException，由上层服务决定后续处理。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "参数校验失败、唯一约束冲突、外键引用不存在等由请求导致的问题。需由调用方修正请求后重试。"
      },
      {
        "code": "5xx",
        "name": "服务端错误",
        "description": "连接超时、连接池耗尽、服务器内部异常等。自动重试机制生效，重试超过阈值后向上层抛出异常。"
      },
      {
        "code": "5xx",
        "name": "事务错误",
        "description": "死锁检测、序列化冲突等并发事务冲突。自动回滚当前事务并重试最多3次，仍失败则向上报错。"
      }
    ]
  },
  "index_strategy": [
    {
      "table": "users",
      "indexes": [
        { "name": "idx_users_username", "columns": ["username"], "unique": true, "type": "B-tree", "purpose": "支持用户名唯一约束和登录时的精确查询" }
      ]
    },
    {
      "table": "projects",
      "indexes": [
        { "name": "idx_projects_name", "columns": ["name"], "unique": false, "type": "B-tree", "purpose": "支持按项目名称排序和模糊搜索" }
      ]
    },
    {
      "table": "environments",
      "indexes": [
        { "name": "idx_environments_key_id", "columns": ["key_id"], "unique": false, "type": "B-tree", "purpose": "加速按关联密钥查找环境的查询" },
        { "name": "idx_environments_type", "columns": ["type"], "unique": false, "type": "B-tree", "purpose": "支持按环境类型过滤查询" }
      ]
    },
    {
      "table": "project_environments",
      "indexes": [
        { "name": "idx_pe_project_id", "columns": ["project_id"], "unique": false, "type": "B-tree", "purpose": "加速按项目查询关联环境的操作" },
        { "name": "idx_pe_environment_id", "columns": ["environment_id"], "unique": false, "type": "B-tree", "purpose": "加速按环境反向查询关联项目的操作" },
        { "name": "uniq_pe_project_environment", "columns": ["project_id", "environment_id"], "unique": true, "type": "B-tree", "purpose": "防止同个项目重复关联同个环境" }
      ]
    },
    {
      "table": "ssh_keys",
      "indexes": [
        { "name": "idx_ssh_keys_fingerprint", "columns": ["fingerprint"], "unique": true, "type": "B-tree", "purpose": "保证密钥指纹唯一性，防止重复导入相同密钥" }
