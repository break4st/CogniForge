        { "name": "idx_deployments_status", "columns": ["status"], "unique": false, "type": "B-tree", "purpose": "支持按状态过滤查询部署任务" },
        { "name": "idx_deployments_created_at", "columns": ["created_at"], "unique": false, "type": "B-tree", "purpose": "支持按时间范围排序和分页查询部署记录" }
      ]
    },
    {
      "table": "deployment_logs",
      "indexes": [
        { "name": "idx_deployment_logs_deployment_id", "columns": ["deployment_id"], "unique": false, "type": "B-tree", "purpose": "加速按部署任务ID查询所有关联日志" },
        { "name": "idx_deployment_logs_created_at", "columns": ["created_at"], "unique": false, "type": "B-tree", "purpose": "支持日志按时间排序和清理过期日志" }
      ]
    },
    {
      "table": "audit_logs",
      "indexes": [
        { "name": "idx_audit_logs_action", "columns": ["action"], "unique": false, "type": "B-tree", "purpose": "支持按操作类型过滤审计日志" },
