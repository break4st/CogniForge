  "module_boundary": {
    "in_scope": [
      "所有前端请求的路由转发（HTTP 反向代理）",
      "WebSocket 连接管理：建立连接、按 deployment_id 订阅日志、实时推送日志流给客户端",
      "用户认证（JWT 签发与验证）和基于角色的路径授权",
      "统一限流、请求/响应日志、错误处理"
    ],
    "out_of_scope": [
      "业务逻辑（项目管理、部署执行、密钥加解密等）",
      "数据持久化（除网关自身认证配置外，不存储业务数据）"
    ],
    "owned_components": ["CMP-002"],
    "owned_contracts": ["SC-001", "SC-002"],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "基于 FastAPI 构建的轻量级 API 网关，是桌面客户端与后端微服务之间的唯一入口。它负责将 HTTPS 请求路由到指定的业务服务，并通过 WSS 管理部署日志的实时推送。所有请求须先通过 JWT 鉴权和角色权限检查。",
    "dependencies": [
      "项目管理服务 (CMP-003)",
      "环境管理服务 (CMP-004)",
      "密钥管理服务 (CMP-005)",
      "部署引擎 (CMP-006)",
      "日志服务 (CMP-007)",
      "版本历史服务 (CMP-008)"
    ],
    "tech_stack": ["Python 3.11+", "FastAPI"]
  },
