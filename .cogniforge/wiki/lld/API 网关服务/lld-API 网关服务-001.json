  "route_table": {
    "routes": [
      {
        "path_pattern": "/auth/*",
        "upstream": "localhost:8001",
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "auth_required": true,
        "roles_allowed": ["admin"],
        "description": "认证相关接口路由到网关本地处理"
      },
      {
        "path_pattern": "/api/projects/*",
        "upstream": "project-service:8000",
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "auth_required": true,
        "roles_allowed": ["admin", "developer", "viewer"],
        "description": "项目资源路由到项目管理服务"
      },
      {
        "path_pattern": "/api/deployments/*",
        "upstream": "deployment-engine:8000",
        "methods": ["GET", "POST"],
        "auth_required": true,
        "roles_allowed": ["admin", "developer"],
        "description": "部署资源路由到部署引擎"
      },
      {
        "path_pattern": "/api/environments/*",
        "upstream": "environment-service:8000",
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "auth_required": true,
        "roles_allowed": ["admin", "developer"],
        "description": "环境资源路由到环境管理服务"
      },
      {
        "path_pattern": "/api/secrets/*",
        "upstream": "secret-service:8000",
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "auth_required": true,
        "roles_allowed": ["admin"],
        "description": "密钥资源路由到密钥管理服务"
      },
      {
        "path_pattern": "/api/versions/*",
        "upstream": "version-service:8000",
        "methods": ["GET", "POST"],
        "auth_required": true,
        "roles_allowed": ["admin", "developer", "viewer"],
        "description": "版本历史资源路由到版本历史服务"
      },
      {
        "path_pattern": "/ws/deployments/*",
        "upstream": "log-service:8000",
        "methods": ["WEBSOCKET"],
        "auth_required": true,
        "roles_allowed": ["admin", "developer", "viewer"],
        "description": "WebSocket 代理到日志服务"
      }
    ],
    "strategy": "longest_prefix_match",
    "fallback": {
      "status": 404,
      "message": "No matching route"
    }
  },
  "middleware_chain": {
    "chain": [
      {
        "name": "RequestIDMiddleware",
        "type": "builtin",
        "config": {},
        "order": 0,
        "description": "为每个请求生成唯一 Request ID 并附加到响应头"
      },
      {
        "name": "CORSMiddleware",
        "type": "builtin",
        "config": {
          "allow_origins": ["*"],
          "allow_methods": ["*"],
          "allow_headers": ["*"]
        },
        "order": 1,
        "description": "处理跨域请求"
      },
      {
        "name": "AuthMiddleware",
        "type": "custom",
        "config": {},
        "order": 2,
        "description": "验证 JWT 令牌，提取用户身份和角色"
      },
      {
        "name": "AuthorizationMiddleware",
        "type": "custom",
        "config": {},
        "order": 3,
        "description": "根据路由规则检查角色权限"
      },
      {
        "name": "RateLimitMiddleware",
        "type": "custom",
        "config": {
          "max_requests": 100,
          "window_seconds": 60
        },
        "order": 4,
        "description": "基于 IP 的全局请求速率限制"
      },
      {
        "name": "RequestLoggingMiddleware",
        "type": "custom",
        "config": {},
        "order": 5,
        "description": "记录请求方法、路径、状态码和处理时间"
      },
      {
        "name": "ProxyMiddleware",
        "type": "custom",
        "config": {},
        "order": 6,
        "description": "按路由表将请求转发到上游服务"
      }
    ]
  },
  "auth_policy": {
    "scheme": "JWT Bearer Token",
    "token_lifetime": 3600,
    "refresh_token_lifetime": 86400,
    "role_path_map": {
      "admin": {
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "paths": ["/auth/*", "/api/*", "/ws/*"]
      },
      "developer": {
        "methods": ["GET", "POST", "PUT"],
        "paths": ["/api/projects/*", "/api/deployments/*", "/api/environments/*", "/api/versions/*", "/ws/deployments/*"]
      },
      "viewer": {
        "methods": ["GET"],
        "paths": ["/api/projects/*", "/api/versions/*", "/ws/deployments/*"]
      }
    }
  },
  "rate_limiting": {
    "default_policy": {
      "max_requests": 100,
      "window_seconds": 60,
      "strategy": "fixed_window",
      "identifier": "ip"
    },
    "route_overrides": [
      {
        "path_pattern": "/auth/login",
        "max_requests": 10,
        "window_seconds": 60
      },
      {
        "path_pattern": "/auth/refresh",
        "max_requests": 10,
        "window_seconds": 60
      }
    ],
    "storage_backend": "memory"
  },
  "error_handling": {
    "strategy": "全局异常处理中间件捕获所有未处理异常，返回统一 JSON 错误响应",
    "error_codes": {
      "401": "未认证或令牌无效",
      "403": "权限不足",
      "429": "请求过于频繁",
      "502": "上游服务不可用",
      "504": "上游服务超时"
    },
    "retry": {
      "enabled": true,
      "max_retries": 2,
      "backoff": "exponential"
    },
    "circuit_breaker": {
      "enabled": true,
      "failure_threshold": 5,
      "recovery_timeout": 30,
      "half_open_requests": 3
    },
    "logging": {
      "level": "error",
      "format": "json"
    }
  }
}