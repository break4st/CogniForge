      "type": "inbound/http",
      "status": "active",
      "endpoint": {
        "path": "/api/{path:path}",
        "method": "ALL",
        "description": "捕获所有以 /api 开头的请求，按路由规则转发到相应的后端服务"
      },
      "auth": {
        "type": "bearer",
        "required": true,
        "roles_allowed": ["admin", "developer", "viewer"]
      },
      "request": {
        "headers": [
          {
            "name": "Authorization",
            "type": "string",
            "required": true,
            "description": "Bearer <token>"
          }
        ],
        "path_params": [
          {
            "name": "path",
            "type": "string",
            "required": true,
            "description": "剩余路径，例如 projects/123"
          }
        ],
        "query_params": [],
        "body": {
          "type": "object",
          "description": "转发原请求体，不解析",
          "required": false
