  "module_boundary": {
    "in_scope": [
      "存储每次部署的元数据（项目标识、环境标识、版本标签、状态、开始/结束时间、耗时）",
      "存储结构化部署日志（时间戳、级别、步骤、消息）",
      "提供分页、按项目/环境/状态过滤的部署历史查询REST API",
      "提供单次部署详情及关联日志的内部查询能力",
      "提供历史记录中的版本标签、文件引用等字段供回滚预填充"
    ],
    "out_of_scope": [
      "实际的部署执行、SSH连接、文件传输、启停脚本",
      "文件存储与管理（由文件管理服务和MinIO负责）",
      "环境变量和服务器配置管理（由项目与环境服务负责）",
      "用户认证与授权实现（仅校验令牌并依赖用户权限服务）",
      "实时日志WebSocket推送（由网关或日志频道服务负责）"
    ],
    "owned_components": [
      "CMP-007"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "记录每次部署的元数据和完整日志，提供查询、过滤、回滚入口。内部接收日志事件并持久化。",
    "dependencies": [
      "用户与权限服务",
      "项目与环境服务",
      "文件管理服务"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "PostgreSQL",
      "Redis"
    ]
  },
