  "interfaces": [
    {
      "id": "IF-001",
      "name": "获取部署历史列表",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-012",
      "provider_component_id": "CMP-006",
      "method": "GET",
      "endpoint": "/api/deployments",
      "description": "分页查询部署记录，支持按项目 ID、时间范围过滤。",
      "parameters": [
        {
          "name": "project_id",
          "type": "integer",
          "in": "query",
          "required": false,
          "description": "按项目ID过滤"
        },
        {
          "name": "start_time",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "开始时间 (ISO 8601格式)"
        },
        {
          "name": "end_time",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "结束时间 (ISO 8601格式)"
        },
        {
          "name": "page",
          "type": "integer",
          "in": "query",
          "required": false,
          "default": 1,
          "description": "页码"
        },
        {
          "name": "page_size",
          "type": "integer",
          "in": "query",
          "required": false,
          "default": 20,
          "description": "每页大小"
        }
      ],
      "requestBody": null,
      "responses": [
        {
          "status_code": 200,
          "description": "成功返回部署历史列表",
          "body": {
            "type": "object",
            "properties": {
              "deployments": {
                "type": "array",
                "items": {
                  "$ref": "#/domain_objects/DO-001"
                }
              },
              "total": {
                "type": "integer"
              },
              "page": {
                "type": "integer"
              },
              "page_size": {
                "type": "integer"
              }
            }
          }
        },
        {
          "status_code": 400,
          "description": "请求参数错误",
          "body": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "获取部署日志",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-013",
      "provider_component_id": "CMP-006",
      "method": "GET",
      "endpoint": "/api/deployments/{deployment_id}/log",
      "description": "获取指定部署的完整日志。",
      "parameters": [
        {
          "name": "deployment_id",
          "type": "string",
          "in": "path",
          "required": true,
          "description": "部署ID"
        }
      ],
      "requestBody": null,
      "responses": [
        {
          "status_code": 200,
          "description": "成功返回部署日志",
          "body": {
            "type": "object",
            "properties": {
              "deployment_id": {
                "type": "string"
              },
              "log": {
                "type": "string"
              }
            }
          }
        },
        {
          "status_code": 404,
          "description": "部署不存在",
          "body": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "重新部署",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-014",
      "provider_component_id": "CMP-006",
      "method": "POST",
      "endpoint": "/api/deployments/redeploy",
      "description": "基于历史部署记录重新触发部署。",
      "parameters": [],
      "requestBody": {
        "type": "object",
        "properties": {
          "deployment_id": {
            "type": "string",
            "description": "要重新部署的历史部署ID"
          }
        },
        "required": ["deployment_id"]
      },
      "responses": [
        {
          "status_code": 202,
          "description": "重新部署请求已接受",
          "body": {
            "type": "object",
            "properties": {
              "deployment_id": {
                "type": "string",
                "description": "新创建的部署ID"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        {
          "status_code": 404,
          "description": "原部署不存在",
          "body": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "object_type": "entity",
      "name": "DeploymentRecord",
      "description": "部署记录实体",
      "properties": [
        {
          "name": "id",
          "type": "String",
          "required": true,
          "description": "部署唯一标识"
        },
        {
          "name": "project_id",
          "type": "Integer",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "environment_id",
          "type": "Integer",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "description": "部署状态"
        },
        {
          "name": "deployed_at",
          "type": "DateTime",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "duration",
          "type": "Integer",
          "required": false,
          "description": "执行耗时"
        },
        {
          "name": "version_folder",
          "type": "String",
          "required": true,
          "description": "版本目录"
        }
      ]
    },
    {
      "id": "DO-002",
      "object_type": "entity",
      "name": "DeploymentLog",
      "description": "部署日志实体",
      "properties": [
        {
          "name": "deployment_id",
          "type": "String",
          "required": true,
          "description": "关联的部署ID"
        },
        {
          "name": "log",
          "type": "Text",
          "required": false,
          "description": "完整日志文本"
        }
      ]
    },
    {
      "id": "DO-003",
      "object_type": "value_object",
      "name": "PaginationParams",
      "description": "分页参数",
      "properties": [
        {
          "name": "page",
          "type": "Integer",
          "required": false,
          "description": "页码",
          "default": 1
        },
        {
          "name": "page_size",
          "type": "Integer",
          "required": false,
          "description": "每页大小",
          "default": 20
        }
      ]
    },
    {
      "id": "DO-004",
      "object_type": "value_object",
      "name": "TimeRangeFilter",
      "description": "时间范围过滤条件",
      "properties": [
        {
          "name": "start_time",
          "type": "DateTime",
          "required": false,
          "description": "开始时间"
        },
        {
          "name": "end_time",
          "type": "DateTime",
          "required": false,
          "description": "结束时间"
        }
      ]
    },
    {
      "id": "DO-005",
      "object_type": "value_object",
      "name": "ProjectFilter",
      "description": "项目过滤条件",
      "properties": [
        {
          "name": "project_id",
          "type": "Integer",
          "required": false,
          "description": "项目ID"
        }
      ]
    },
    {
      "id": "DO-006",
      "object_type": "enum",
      "name": "DeploymentStatus",
      "description": "部署状态枚举",
      "enum_values": [
        {
          "name": "PENDING",
          "value": "pending",
          "description": "等待中"
        },
        {
          "name": "IN_PROGRESS",
          "value": "in_progress",
          "description": "进行中"
        },
        {
          "name": "SUCCESS",
          "value": "success",
          "description": "成功"
        },
        {
          "name": "FAILED",
          "value": "failed",
          "description": "失败"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentHistoryService",
      "description": "部署历史与日志服务契约",
      "methods": [
        {
          "name": "get_deployment_history",
          "signature": "get_deployment_history(project_id: Optional[int], start_time: Optional[datetime], end_time: Optional[datetime], page: int = 1, page_size: int = 20) -> Tuple[List[DeploymentRecord], int]",
          "description": "获取部署历史列表",
          "precondition": "无",
          "postcondition": "返回符合条件的部署记录列表及总数",
          "parameters": [
            {
              "name": "project_id",
              "type": "Optional[int]",
              "description": "项目ID"
            },
            {
              "name": "start_time",
              "type": "Optional[datetime]",
              "description": "开始时间"
            },
            {
              "name": "end_time",
              "type": "Optional[datetime]",
              "description": "结束时间"
            },
            {
              "name": "page",
              "type": "int",
              "description": "页码"
            },
            {
              "name": "page_size",
              "type": "int",
              "description": "每页大小"
            }
          ],
          "return_type": "Tuple[List[DeploymentRecord], int]"
        },
        {
          "name": "get_deployment_log",
          "signature": "get_deployment_log(deployment_id: str) -> DeploymentLog",
          "description": "获取部署日志",
          "precondition": "deployment_id 对应的部署记录必须存在",
          "postcondition": "返回部署日志对象",
          "parameters": [
            {
              "name": "deployment_id",
              "type": "str",
              "description": "部署ID"
            }
          ],
          "return_type": "DeploymentLog"
        },
        {
          "name": "redeploy",
          "signature": "redeploy(deployment_id: str) -> str",
          "description": "重新部署",
          "precondition": "deployment_id 对应的部署记录必须存在",
          "postcondition": "创建新的部署记录，返回新部署ID",
          "parameters": [
            {
              "name": "deployment_id",
              "type": "str",
              "description": "要重新部署的部署ID"
            }
          ],
          "return_type": "str"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "分页参数校验",
      "invariants": [
        "page 必须大于等于1",
        "page_size 必须在 1 到 max_page_size 之间"
      ]
    },
    {
      "id": "BR-002",
      "description": "时间范围过滤校验",
      "invariants": [
        "如果同时提供 start_time 和 end_time，则 start_time 必须早于 end_time"
      ]
    },
    {
      "id": "BR-003",
      "description": "重新部署规则",
      "invariants": [
        "只能基于已存在的部署记录发起重新部署",
        "重新部署时，使用原部署的 project_id, environment_id, version_folder 创建新的部署"
      ]
    }
  ],
  "error_handling": {
    "strategy": "统一异常处理，返回适当的 HTTP 状态码和错误信息。",
    "errors": [
      {
        "code": "DEPLOYMENT_NOT_FOUND",
        "http_status": 404,
        "message": "部署记录不存在"
      },
      {
        "code": "INVALID_PAGINATION",
        "http_status": 400,
        "message": "分页参数无效"
      },
      {
        "code": "INVALID_TIME_RANGE",
        "http_status": 400,
        "message": "时间范围无效"
      },
      {
        "code": "INTERNAL_ERROR",
        "http_status": 500,
        "message": "内部服务器错误"
      }
    ]
  }
}