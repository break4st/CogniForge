          "type": "bigint",
          "required": true,
          "description": "主键"
        },
        {
          "name": "project_id",
          "type": "bigint",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "environment_id",
          "type": "bigint",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "version_tag",
          "type": "varchar(100)",
          "required": true,
          "description": "部署版本标签"
        },
        {
          "name": "status",
          "type": "varchar(30)",
          "required": true,
          "description": "部署状态，取值：pending/running/success/failed/cancelled"
        },
        {
          "name": "start_time",
          "type": "timestamp",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "end_time",
          "type": "timestamp",
          "required": false,
          "description": "部署结束时间，未完成时为null"
        },
        {
          "name": "duration_seconds",
          "type": "integer",
          "required": false,
          "description": "执行耗时（秒），部署结束后计算"
        },
        {
          "name": "project_name",
          "type": "varchar(200)",
          "required": true,
          "description": "部署时的项目名称快照"
        },
        {
          "name": "environment_name",
          "type": "varchar(200)",
          "required": true,
          "description": "部署时的环境名称快照"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": true,
          "description": "记录创建时间"
        }
