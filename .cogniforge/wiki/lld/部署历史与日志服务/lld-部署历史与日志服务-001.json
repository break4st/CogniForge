  "module_boundary": {
    "in_scope": [
      "持久化存储部署执行记录",
      "提供部署历史列表的分页查询，支持按项目 ID、时间范围过滤",
      "提供单次部署完整日志的查询",
      "基于历史记录参数触发一次新的部署"
    ],
    "out_of_scope": [
      "部署任务的执行逻辑",
      "环境配置与项目管理",
      "进度实时推送",
      "前端页面渲染"
    ],
    "owned_components": [
      "CMP-006"
    ],
    "owned_contracts": [
      "CTR-012",
      "CTR-013",
      "CTR-014"
    ],
    "consumed_contracts": [
      "CTR-015"
    ],
    "owned_data_models": [
      "DM-002"
    ],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "部署历史与日志服务负责管理所有部署操作的持久化记录，提供灵活的查询能力，并支持从历史记录中快速发起「重新部署」。",
    "dependencies": [
      "部署编排器",
      "Primary Database"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "PostgreSQL 15"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-006",
      "sad_component_ids": [
        "CMP-006"
