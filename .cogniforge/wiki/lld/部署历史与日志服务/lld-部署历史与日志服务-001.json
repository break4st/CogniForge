          "DO-004",
          "DO-005",
          "DO-006"
        ],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "deployment_records",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployments"
      },
      "description": "部署记录视图，引用自 Primary Database。列出本服务所需的字段。",
      "fields": [
        {
          "name": "id",
          "type": "String",
          "required": true,
          "description": "部署唯一标识 (UUID)"
        },
        {
          "name": "project_id",
          "type": "Integer",
          "required": true,
          "description": "关联项目ID"
        },
        {
          "name": "environment_id",
          "type": "Integer",
          "required": true,
          "description": "关联环境ID"
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "description": "当前状态 (pending/in_progress/success/failed)"
        },
        {
          "name": "deployed_at",
          "type": "DateTime",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "duration",
          "type": "Integer",
          "required": false,
          "description": "执行耗时 (秒)"
        },
        {
          "name": "version_folder",
          "type": "String",
          "required": true,
          "description": "部署使用的文件版本目录"
        },
        {
          "name": "log",
          "type": "Text",
          "required": false,
          "description": "完整执行日志"
        }
      ],
