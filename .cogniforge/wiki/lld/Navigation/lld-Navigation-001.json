      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "记录当前搜索和排序的筛选条件，主要用于发送 API 请求",
      "fields": [
        {
          "name": "search",
          "type": "string",
          "required": false,
          "description": "搜索关键词，对应契约查询参数 search"
        },
        {
          "name": "sort",
