          "type": "string",
          "required": true,
          "description": "项目名"
        },
        {
          "name": "description",
          "type": "string",
          "required": true,
          "description": "项目描述"
        },
        {
          "name": "last_deploy_status",
          "type": "string",
          "required": true,
          "description": "最近部署状态"
        },
        {
          "name": "last_deploy_time",
          "type": "string",
          "required": true,
          "description": "最近部署时间（ISO 字符串）"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "由 GET /api/projects 响应生成",
        "update": "重新请求后整体替换",
        "delete": "不适用",
        "retention": "内存中缓存 5 分钟"
      },
      "change_history": [
        {
          "version": 1,
