{
  "meta": {
    "doc_id": "lld-Navigation-001",
    "type": "lld",
    "module_type": "frontend",
    "module": "Navigation",
    "title": "全局搜索条和左侧固定项目导航栏 - 详细设计",
    "author": "design_agent",
    "created": "2025-03-21T15:30:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-001"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": [
        "CMP-001"
      ],
      "contracts": [
        "CTR-001"
      ],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "呈现全局搜索框，支持按项目名称模糊匹配",
      "左侧固定侧边栏展示项目列表，支持按字母排序、按最近部署时间排序以及用户手动拖拽的自定义排序",
      "高亮当前选中项目",
      "项目列表数据的获取、定期刷新与错误处理",
      "侧边栏的折叠/展开",
      "作为应用主布局，接纳子模块的路由组件"
    ],
    "out_of_scope": [
      "具体的项目详情页面（由 ProjectManager 模块负责）",
      "部署操作、环境管理、密钥管理等业务逻辑",
      "用户登录/权限校验的完整逻辑"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-001"
    ],
    "owned_data_models": [
      "DM-001",
      "DM-002"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "Navigation 是整个 CogniForge 前端应用的全局布局组件和导航中心，提供统一的用户工作台入口。它不承担任何业务逻辑，只负责展示、搜索和排序项目，并指导用户进入对应的详情页。",
    "dependencies": [
      "ProjectService (通过 API 网关)"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design",
      "React Context + useReducer",
      "react-sortable-hoc (或 Ant Design Dragger)"
    ]
  },
  "component_tree": {
    "root_component": "NavigationLayout",
    "description": "应用的主布局组件，包含可折叠侧边栏和内容区。",
    "components": [
      {
        "name": "SearchBar",
        "parent": "NavigationLayout",
        "props": [
          {
            "name": "onSearch",
            "type": "(value: string) => void",
            "description": "搜索回调"
          }
        ],
        "state": [],
        "description": "全局搜索输入框"
      },
      {
        "name": "ProjectList",
        "parent": "NavigationLayout",
        "props": [
          {
            "name": "projects",
            "type": "ProjectItem[]",
            "description": "项目列表数据"
          },
          {
            "name": "selectedProjectId",
            "type": "number | null",
            "description": "当前选中的项目ID"
          },
          {
            "name": "onSelect",
            "type": "(id: number) => void",
            "description": "项目选中回调"
          },
          {
            "name": "sortMode",
            "type": "'name' | 'time' | 'custom'",
            "description": "当前排序模式"
          },
          {
            "name": "onSortChange",
            "type": "(mode: 'name' | 'time' | 'custom') => void",
            "description": "排序模式变更回调"
          },
          {
            "name": "onListOrderChange",
            "type": "(newOrder: number[]) => void",
            "description": "自定义排序顺序变更回调"
          }
        ],
        "state": [],
        "description": "左侧可拖拽排序的项目列表"
      },
      {
        "name": "SiderToggle",
        "parent": "NavigationLayout",
        "props": [
          {
            "name": "collapsed",
            "type": "boolean",
            "description": "侧边栏是否折叠"
          },
          {
            "name": "onToggle",
            "type": "() => void",
            "description": "折叠切换回调"
          }
        ],
        "state": [],
        "description": "侧边栏折叠/展开按钮"
      }
    ]
  },
  "state_design": {
    "global_state": {
      "navigation": {
        "collapsed": {
          "type": "boolean",
          "default": false,
          "description": "侧边栏是否折叠"
        },
        "selectedProjectId": {
          "type": "number | null",
          "default": null,
          "description": "当前选中项目ID，用于高亮和路由跳转"
        },
        "projectsList": {
          "type": "ProjectItem[]",
          "default": "[]",
          "description": "项目列表数据"
        },
        "isLoading": {
          "type": "boolean",
          "default": true,
          "description": "是否正在加载数据"
        },
        "error": {
          "type": "string | null",
          "default": null,
          "description": "错误信息"
        }
      }
    },
    "local_state": {
      "SearchBar": {
        "inputValue": {
          "type": "string",
          "default": "",
          "description": "搜索框输入内容"
        }
      },
      "ProjectList": {
        "sortMode": {
          "type": "'name' | 'time' | 'custom'",
          "default": "name",
          "description": "当前排序方式"
        },
        "customOrder": {
          "type": "number[]",
          "default": "[]",
          "description": "自定义排序时的项目ID顺序"
        }
      }
    },
    "state_transitions": [
      {
        "trigger": "SearchBar.onSearch",
        "target": "navigation.projectsList",
        "effect": "根据搜索关键词过滤列表"
      },
      {
        "trigger": "ProjectList.sortMode change",
        "target": "navigation.projectsList",
        "effect": "重新排序列表"
      },
      {
        "trigger": "Data fetch success",
        "target": "navigation.projectsList, isLoading, error",
        "effect": "更新项目列表，设置isLoading为false，清除error"
      },
      {
        "trigger": "Data fetch failure",
        "target": "navigation.isLoading, navigation.error",
        "effect": "设置isLoading为false，设置错误信息"
      },
      {
        "trigger": "SiderToggle.onToggle",
        "target": "navigation.collapsed",
        "effect": "切换折叠状态"
      }
    ]
  },
  "route_design": {
    "routes": [
      {
        "path": "/",
        "component": "NavigationLayout",
        "children": [
          {
            "path": "projects/:id",
            "component": "ProjectDetail",
            "description": "项目详情页（属于ProjectManager模块）"
          }
        ],
        "description": "应用根路径，渲染全局布局，子路由在内容区渲染"
      }
    ],
    "navigation_guards": {
      "beforeProjectEnter": "可选：检查用户权限（后续实现）"
    }
  },
  "interaction_flows": {
    "flows": [
      {
        "id": "FLOW-001",
        "name": "用户搜索项目",
        "steps": [
          "用户在SearchBar输入文字",
          "SearchBar发出onSearch事件",
          "上层处理函数根据关键词过滤projectsList中的数据（前端过滤）",
          "更新列表显示过滤后的项目"
        ]
      },
      {
        "id": "FLOW-002",
        "name": "用户切换排序方式",
        "steps": [
          "用户点击排序按钮",
          "ProjectList组件内部切换sortMode状态",
          "列表根据sortMode重新排序（name按名称排序，time按部署时间排序，custom按自定义顺序）",
          "如果切换到custom模式，启用拖拽功能，用户拖拽改变顺序后更新customOrder"
        ]
      },
      {
        "id": "FLOW-003",
        "name": "项目数据获取与刷新",
        "steps": [
          "页面加载时，触发GET /api/projects请求，带上当前搜索和排序参数",
          "请求成功：更新projectsList，isLoading设为false，清除error",
          "请求失败：设置error信息，isLoading设为false",
          "设置定时器每30秒重新请求一次"
        ]
      },
      {
        "id": "FLOW-004",
        "name": "侧边栏折叠/展开",
        "steps": [
          "用户点击SiderToggle按钮",
          "切换navigation.collapsed状态",
          "侧边栏根据collapsed调整宽度和可见性"
        ]
      },
      {
        "id": "FLOW-005",
        "name": "选中项目并导航",
        "steps": [
          "用户点击项目列表中的某一项",
          "更新selectedProjectId",
          "通过React Router跳转到/projects/:id"
        ]
      }
    ]
  },
  "api_integration": {
    "endpoints": [
      {
        "id": "API-001",
        "contract_id": "CTR-001",
        "method": "GET",
        "path": "/api/projects",
        "description": "获取项目列表，支持搜索和排序参数",
        "request_mapping": {
          "search": "从SearchBar输入值获取",
          "sort": "根据当前sortMode映射：name -> 'name', time -> 'time', custom时发送name或前端自定义排序"
        },
        "response_mapping": {
          "projects": "映射到 navigation.projectsList"
        },
        "error_handling": {
          "network_error": "显示'网络连接失败，请稍后重试'",
          "server_error": "显示'服务器开小差了，请稍后重试'",
          "retry": "点击重试按钮或30秒自动重试"
        },
        "refresh_strategy": {
          "interval": 30000,
          "triggered_by": "页面挂载和定时器",
          "stale_policy": "直接替换数据"
        }
      }
    ]
  },
  "error_handling": {
    "strategy": "捕获API请求错误，显示用户友好的错误提示（如'加载项目列表失败，请稍后重试'），并提供重试按钮。网络请求超时设置为10秒。组件内使用ErrorBoundary包裹内容区，捕获React渲染错误并显示回退UI。",
    "error_states": {
      "loading": "显示Spin加载指示器",
      "empty": "显示'暂无项目'的空状态提示",
      "error": "显示Alert错误信息，包含重试按钮"
    },
    "fallback_components": {
      "content_area": "当子模块渲染出错时，显示通用错误提示，不影响全局导航"
    }
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001"
