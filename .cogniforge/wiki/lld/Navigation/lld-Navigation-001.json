        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "在搜索或排序变化时创建",
        "update": "直接修改属性",
        "delete": "不适用",
        "retention": "暂存于组件状态"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "获取项目列表",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-011",
      "method": "GET",
      "endpoint": "/api/projects",
      "description": "获取所有项目列表，支持按名称模糊搜索和按时间/名称排序",
      "parameters": [
        {
          "name": "search",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "搜索关键词"
        },
        {
          "name": "sort",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "排序方式，可选 name 或 time"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "projects": [
            {
              "id": "integer",
              "name": "string",
              "description": "string",
              "last_deploy_status": "string",
              "last_deploy_time": "string"
            }
          ]
        }
      },
      "error_codes": [
        {
          "status": 500,
          "code": "SERVER_ERROR",
          "message": "服务器内部错误"
        }
