  "module_boundary": {
    "in_scope": [
      "接收部署请求（文件列表、目标环境、版本号）",
      "逐步执行部署步骤并推送进度状态",
      "生成版本文件夹名称（项目名_环境名_版本号_时间戳）",
      "创建 deploy.sh 脚本并设置执行权限",
      "部署失败时清理临时文件，返回错误信息",
      "成功时调用 History Service 记录部署"
    ],
    "out_of_scope": [
      "SSH 连接的建立、执行、文件上传、断开（委托给 SSH Service）",
      "环境私钥的解密（委托给 Security Module）",
      "历史记录的持久化存储（委托给 History & Rollback Service）",
      "部署历史列表查询与回滚逻辑（由 History & Rollback Service 负责）"
    ],
    "owned_components": [
      "CMP-004"
    ],
    "owned_contracts": [
      "CTR-005"
    ],
    "consumed_contracts": [
      "CTR-004",
      "CTR-006"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "Deployment Engine 是 Electron 桌面应用主进程中的一个协调服务，负责编排一键部署流程。它接收前端 UI 发起的部署指令，按照固定步骤（连接、上传、创建目录、移动文件、生成脚本、清理）通过调用 SSH Service 和 Security Module 等基础服务来执行远程部署任务，并通过 IPC 事件向 UI 推送实时进度。部署成功后触发 History Service 记录部署历史。",
    "dependencies": [
      "Security Module (解密环境私钥)",
      "SSH Service (执行远程命令和文件传输)",
      "Environment Manager (验证环境连通性)",
      "History & Rollback Service (记录部署历史)"
    ],
    "tech_stack": [
      "TypeScript / Node.js",
      "Electron 主进程",
      "Electron ipcMain (用于与 UI 通信，暴露 deploy:start 处理)",
      "SSH2 / ssh2-sftp-client (通过 SSH Service 间接使用)"
    ]
  },
