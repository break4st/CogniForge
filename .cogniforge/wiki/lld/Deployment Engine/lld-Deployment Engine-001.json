  "error_handling": {
    "strategy": "采用一致的错误响应结构，区分客户端错误（4xx）和服务器错误（5xx），所有错误均通过 IPC 事件返回结构化 JSON，确保前端可解析并展示友好提示。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求格式错误",
        "description": "当部署请求参数缺失或格式不正确时触发，如文件列表为空、目标环境未指定。返回具体缺失字段的提示信息。"
      },
      {
        "code": "401",
        "name": "认证失败",
        "description": "当环境私钥解密失败或 SSH 认证信息错误时触发，提示检查密钥或认证配置。"
      },
      {
        "code": "404",
        "name": "环境不可达",
