          "type": "string[]",
          "in": "body",
          "required": true,
          "description": "待部署文件路径列表"
        }
      ],
      "request_body": {
        "projectName": "string",
        "environmentName": "string",
        "version": "string",
        "files": "string[]"
      },
      "response": {
        "status": 200,
        "body": {
          "deploymentId": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_REQUEST",
          "message": "请求参数无效"
        },
        {
          "status": 500,
          "code": "DEPLOYMENT_FAILED",
          "message": "部署失败，查看错误详情"
        }
      ],
      "auth": {
