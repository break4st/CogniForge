  "interfaces": [
    {
      "id": "IF-001",
      "name": "Deployment IPC",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-005",
      "provider_component_id": "CMP-004",
      "method": "frontend",
      "endpoint": "deploy:start",
      "description": "接收前端 UI 发起的部署请求，返回 deploymentId，并通过事件推送部署进度。",
      "parameters": [
        {
          "name": "projectName",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "environmentName",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "目标环境名称"
        },
        {
