  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentExecutor",
      "description": "部署执行器核心服务契约，定义部署任务的执行、状态查询等操作。",
      "dependencies": [
        "SSHConnector",
        "ScriptGenerator"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "methods": [
        {
          "name": "executeDeployment",
          "signature": "executeDeployment(deployment_id: int) -> DeploymentResult",
          "description": "执行一个部署任务。",
          "precondition": "deployment_id 对应的部署记录存在且状态为 QUEUED，环境配置有效。",
          "postcondition": "部署记录状态变更为 SUCCESS 或 FAILED，远程主机版本目录创建并填充文件。",
          "input": {
            "deployment_id": "int"
          },
          "output": {
            "status": "string",
            "message": "string"
          },
          "exceptions": [
            {
              "name": "SSHConnectionException",
              "description": "SSH 连接失败时抛出",
              "handling": "记录日志，标记部署失败"
            },
            {
              "name": "DeploymentFailedException",
              "description": "部署流程中任一步骤失败时抛出",
              "handling": "记录错误信息，更新状态为 FAILED"
            }
          ],
          "pseudocode": "load deployment record; validate preconditions; update status to DEPLOYING; try: connect SSH; upload package; extract; generate scripts; if auto_start: start app; update status to SUCCESS; catch SSHConnectionException as e: set status FAILED; log e; raise; catch DeploymentFailedException as e: set status FAILED; log e;",
          "change_history": [
            {
              "version": 1,
              "change_type": "created",
              "summary": "初始创建",
              "reason": "首次生成 LLD"
            }
          ]
        },
        {
          "name": "getDeploymentStatus",
          "signature": "getDeploymentStatus(deployment_id: int) -> DeploymentStatus",
          "description": "查询部署任务状态。",
          "precondition": "deployment_id 对应的部署记录存在。",
          "postcondition": "返回最新状态。",
          "input": {
            "deployment_id": "int"
          },
          "output": {
            "status": "string",
            "progress": "int",
            "error_message": "string"
          },
          "exceptions": [
            {
              "name": "TaskNotFoundException",
              "description": "部署任务不存在时抛出",
              "handling": "返回错误信息"
            }
          ],
          "pseudocode": "find deployment by id; if not found: raise TaskNotFoundException; return status, progress, error_message;",
          "change_history": [
            {
              "version": 1,
              "change_type": "created",
              "summary": "初始创建",
              "reason": "首次生成 LLD"
            }
          ]
        }
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
