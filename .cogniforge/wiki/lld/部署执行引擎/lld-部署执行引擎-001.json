  "module_boundary": {
    "in_scope": [
      "接收部署任务ID，根据该ID查询部署记录与关联的项目、环境信息",
      "校验部署所需的前置条件（项目存在、环境配置有效、版本标签不冲突等）",
      "通过 SSH 连接模块与远程主机交互：上传压缩包、创建版本目录、解压",
      "调用脚本模板管理器生成启动/停止脚本并上传至远程版本目录",
      "根据部署记录的 auto_start 字段决定是否远程执行启动脚本",
      "管理部署任务的状态流转（queued → deploying → success/failed）",
      "更新任务进度（0% ~ 100%）到持久化存储，供前端轮询或 WebSocket 推送",
      "捕获并处理每一步的异常，统一写入错误信息和状态"
    ],
    "out_of_scope": [
      "直接处理 HTTP 请求（由 Flask API 核心服务负责）",
      "用户身份认证与权限校验（由 API 层完成）",
      "前端 WebSocket 连接的建立与管理（由 API 层或网关负责）",
      "项目、环境的 CRUD 管理",
      "脚本模板的编辑与版本管理（由脚本模板管理器负责）",
      "SSH 连接池的低层实现（由 SSH 连接模块提供）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [
      "CTR-002",
      "CTR-003"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "核心业务组件，负责编排完整的部署流程：接收部署请求后，依次执行上传文件、创建版本目录、解压、生成脚本、（可选）启动应用，并将进度反馈给前端。流程原子化，失败时不影响已有版本。",
    "dependencies": [
      "Flask API 核心服务",
      "SSH 连接模块",
      "脚本模板管理器"
    ],
    "tech_stack": [
      "Python 3.10+",
      "Flask",
      "SQLAlchemy",
      "paramiko"
    ]
  },
