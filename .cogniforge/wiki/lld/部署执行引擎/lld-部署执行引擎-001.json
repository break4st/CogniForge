  "interfaces": [
    {
      "id": "IF-001",
      "name": "部署任务执行接口",
      "type": "internal",
      "endpoint": "execute_deployment",
      "description": "触发部署任务执行的入口，由队列消费者调用。",
      "provider_component_id": "CMP-001",
      "consumer_component_ids": [
        "QueueConsumer"
