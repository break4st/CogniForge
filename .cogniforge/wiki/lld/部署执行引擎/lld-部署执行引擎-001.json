      },
      "response": {
        "success": {
          "type": "object",
          "properties": {
            "status": "string",
            "message": "string"
          }
        }
      },
      "errors": [
        {
          "code": "TASK_NOT_FOUND",
          "message": "指定的部署任务不存在",
          "description": "deployment_id 无效"
        },
        {
          "code": "DEPLOYMENT_FAILED",
          "message": "部署执行失败",
          "description": "部署流程中发生异常"
        }
      ],
      "pseudocode": "function execute_deployment(deployment_id): load deployment record; validate preconditions; update status to DEPLOYING; try: upload package; extract package; generate scripts; if auto_start: start application; update status to SUCCESS; catch exception: update status to FAILED; record error;",
