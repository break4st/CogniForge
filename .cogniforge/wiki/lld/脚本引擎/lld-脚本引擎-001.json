  "overview": {
    "description": "脚本引擎是一个应用服务层组件，为核心部署流程提供动态脚本生成能力。基于调用方传入的模板文本、环境变量映射及目标操作系统类型，执行模板解析、变量注入和平台适配，输出可直接运行的启动脚本内容和对应文件名。",
    "dependencies": [],
    "tech_stack": [
      "TypeScript",
      "Node.js",
      "winston"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [],
      "lld_objects": {
        "data_models": [],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "domain_objects": {
    "DO-001": {
      "id": "DO-001",
      "name": "GenerateScriptRequest",
      "description": "脚本生成请求的输入对象",
      "fields": {
        "template": {
          "type": "string",
          "required": true,
          "description": "包含 {{变量名}} 的模板字符串"
        },
        "variables": {
          "type": "object",
          "required": true,
          "description": "变量名与替换值的映射"
        },
        "os": {
          "type": "OSType",
          "required": true,
          "description": "目标操作系统枚举"
        }
      }
    },
    "DO-002": {
      "id": "DO-002",
      "name": "GenerateScriptResponse",
      "description": "脚本生成成功后的响应对象",
      "fields": {
        "scriptContent": {
          "type": "string",
          "required": true,
          "description": "完成变量替换后的脚本内容"
        },
        "fileName": {
          "type": "string",
          "required": true,
          "description": "根据操作系统适配后的推荐文件名"
        }
      }
    }
  },
  "business_rules": {
    "invariants": [
      "template 字段不能为空字符串",
      "variables 字段不能为 null",
      "os 字段必须为 'LINUX' 或 'WINDOWS'",
      "模板中的占位符必须在 variables 中找到对应的键"
    ],
    "validations": [
      "输入校验：非空、类型正确、枚举范围",
      "模板解析校验：模板中的占位符格式正确，变量完整性检查"
    ],
    "calculations": [],
    "transitions": []
  },
  "data_models": [
    {
      "id": "DM-001",
      "name": "request_store",
      "type": "store",
      "ownership": "internal",
      "description": "存储脚本生成请求的临时数据",
      "fields": [
        {
          "name": "template",
          "type": "string",
          "required": true,
          "description": "原始模板字符串"
        },
        {
          "name": "variables",
          "type": "object",
          "required": true,
          "description": "变量映射对象"
        },
        {
          "name": "os",
          "type": "string",
          "required": true,
          "constraints": [
            "enum: LINUX, WINDOWS"
          ],
          "description": "操作系统类型"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "response_store",
      "type": "store",
      "ownership": "internal",
      "description": "存储脚本生成响应的临时数据",
      "fields": [
        {
          "name": "scriptContent",
          "type": "string",
          "required": true,
          "description": "生成的脚本内容"
        },
        {
          "name": "fileName",
          "type": "string",
          "required": true,
          "description": "推荐的文件名"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "os_enum",
      "type": "config",
      "ownership": "internal",
      "description": "操作系统枚举配置",
      "fields": [],
      "values": {
        "LINUX": "linux",
        "WINDOWS": "windows"
      }
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "生成脚本",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "ScriptGenerationService.generateScript",
      "description": "接收模板、变量映射和目标操作系统，返回替换后的脚本内容及文件名。",
      "parameters": [],
      "request_body": {
        "type": "GenerateScriptRequest",
        "ref": "DM-001",
        "fields": [
          {
            "name": "template",
            "type": "string",
            "required": true,
            "description": "包含 {{变量名}} 占位符的模板文本"
          },
          {
            "name": "variables",
            "type": "object",
            "required": true,
            "description": "变量名到替换字符串的键值对映射"
          },
          {
            "name": "os",
            "type": "OSType",
            "required": true,
            "description": "目标操作系统枚举值 LINUX 或 WINDOWS"
          }
        ]
      },
      "response": {
        "status": 200,
        "body": {
          "ref": "DM-002"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_ARGUMENT",
          "message": "参数缺失或格式错误"
        },
        {
          "status": 422,
          "code": "TEMPLATE_PARSE_ERROR",
          "message": "模板解析失败"
        },
        {
          "status": 422,
          "code": "MISSING_VARIABLES",
          "message": "变量映射不完整"
        },
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "内部处理异常"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "template 非空字符串",
        "variables 非null对象",
        "os 必须为 LINUX 或 WINDOWS"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "函数内部对输入进行严格校验，任何校验失败立即抛出带有明确错误码和描述的异常，调用方负责捕获处理。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "参数错误",
        "description": "入参缺失、类型错误、操作系统值不在枚举范围内，即时拒绝并返回详细信息。"
      },
      {
        "code": "422",
        "name": "业务逻辑错误",
        "description": "模板包含未被变量映射覆盖的占位符，或模板语法无效（如 {{ 未闭合），返回缺失变量列表。"
      },
      {
        "code": "500",
        "name": "系统错误",
        "description": "非预见性运行时错误，记录日志后返回通用内部错误。"
      }
    ]
  },
  "workflow": {
    "name": "脚本生成主流程",
    "description": "从验证输入到返回脚本文件的完整处理步骤。",
    "steps": [
      {
        "order": 1,
        "name": "输入校验",
        "actor": "ScriptEngine",
        "action": "检查 template 非空、variables 非 null、os 为有效枚举",
        "transition": "如果校验失败 → 抛出 INVALID_ARGUMENT (400)"
      },
      {
        "order": 2,
        "name": "模板解析与变量提取",
        "actor": "ScriptEngine",
        "action": "解析模板中所有 {{变量名}} 占位符，提取变量列表",
        "transition": "如果解析失败 → 抛出 TEMPLATE_PARSE_ERROR (422)"
      },
      {
        "order": 3,
        "name": "变量完整性检查",
        "actor": "ScriptEngine",
        "action": "比较占位符列表与 variables 键，确保全部匹配",
        "transition": "如果缺失变量 → 抛出 MISSING_VARIABLES (422) 并列出缺失变量"
      },
      {
        "order": 4,
        "name": "变量替换",
        "actor": "ScriptEngine",
        "action": "执行字符串替换，填充模板所有占位符",
        "transition": "无"
      },
      {
        "order": 5,
        "name": "操作系统适配",
        "actor": "ScriptEngine",
        "action": "根据 os 选择扩展名（.sh 或 .ps1）、调整路径分隔符",
        "transition": "无"
      },
      {
        "order": 6,
        "name": "构建响应",
        "actor": "ScriptEngine",
        "action": "封装 scriptContent 和 fileName 返回",
        "transition": "成功 (200)"
      }
    ]
  },
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ScriptGenerationService",
      "contract_type": "internal",
      "description": "提供脚本生成的服务合约",
      "provided_interface": "IF-001",
      "methods": [
        {
          "name": "generateScript",
          "description": "生成脚本的核心方法",
          "interface_id": "IF-001",
          "input": "GenerateScriptRequest",
          "output": "GenerateScriptResponse",
          "errors": [
            "INVALID_ARGUMENT",
            "TEMPLATE_PARSE_ERROR",
            "MISSING_VARIABLES",
            "INTERNAL_ERROR"
          ]
        }
      ],
      "sla": {},
      "circuit_breaker": false,
      "interface_id": "IF-001"
    }
  ]
}