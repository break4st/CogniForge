  "module_boundary": {
    "in_scope": [
      "接收模板字符串、变量映射和目标操作系统类型",
      "解析模板中的占位符语法 {{变量名}}",
      "校验变量完整性，进行变量替换",
      "根据操作系统自动选择脚本文件扩展名",
      "根据操作系统调整路径分隔符",
      "返回最终脚本内容和推荐文件名"
    ],
    "out_of_scope": [
