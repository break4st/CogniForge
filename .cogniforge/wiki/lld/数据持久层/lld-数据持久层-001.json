  "module_boundary": {
    "in_scope": [
      "定义并维护 Project, Environment, SSHKey, Deployment, DeploymentLog, Version 等实体",
      "基于 SQLAlchemy ORM 提供数据的增删改查操作",
      "管理数据库迁移，使用 Alembic 工具",
      "定义并维护所有表结构的索引、约束和关联关系",
      "为上层业务服务提供一致的内部数据操作接口"
    ],
    "out_of_scope": [
      "不参与业务逻辑编排，仅提供数据持久化能力",
      "不直接处理 SSH 连接、文件上传、脚本执行等基础设施操作",
      "不负责前端展示或 API 网关层的请求路由",
      "不管理其他外部数据源（如缓存、消息队列）"
    ],
    "owned_components": [
      "CMP-011"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "数据持久层是整个系统的基础设施模块，负责所有业务状态的结构化存储与检索。它采用 SQLAlchemy 作为 ORM 框架，与 SQLite 数据库交互，为上层服务提供一致的数据访问层。内部接口采用 Python 函数调用形式，通过 Alembic 进行数据库模式版本管理。",
    "dependencies": [
      "无外部模块依赖，被所有业务服务模块消费"
    ],
    "tech_stack": [
      "Python 3.11+",
      "SQLAlchemy",
      "SQLite",
      "Alembic"
    ]
  },
