  "index_strategy": {
    "description": "索引设计旨在优化高频查询场景，包括按名称查找项目、按项目ID和环境名查找环境、按部署状态筛选部署任务等。所有主键自动生成索引，外键字段建立非唯一索引以加速连接查询。",
    "indexes": [
      {
        "table": "projects",
        "name": "idx_project_name_unique",
        "type": "UNIQUE",
        "columns": ["name"],
        "reason": "确保项目名唯一，并加速按名称查询"
      },
      {
        "table": "projects",
        "name": "idx_project_created",
        "type": "BTREE",
        "columns": ["created_at"],
        "reason": "加速按时间排序或范围查询"
      },
      {
        "table": "ssh_keys",
        "name": "idx_sshkey_name_unique",
        "type": "UNIQUE",
        "columns": ["name"],
        "reason": "确保密钥名唯一，加速查询"
      },
      {
        "table": "ssh_keys",
        "name": "idx_sshkey_fingerprint",
        "type": "BTREE",
        "columns": ["fingerprint"],
        "reason": "通过指纹查找密钥"
      },
      {
        "table": "environments",
        "name": "idx_env_project_id_name_unique",
        "type": "UNIQUE",
        "columns": ["project_id", "name"],
        "reason": "项目内环境名唯一，并加速组合查询"
      },
      {
        "table": "environments",
        "name": "idx_env_project_id",
        "type": "BTREE",
        "columns": ["project_id"],
        "reason": "加速按项目ID查询所有环境"
      },
      {
        "table": "deployments",
        "name": "idx_deploy_env_id",
        "type": "BTREE",
        "columns": ["environment_id"],
        "reason": "加速按环境查询部署"
      },
      {
        "table": "deployments",
        "name": "idx_deploy_project_id",
        "type": "BTREE",
        "columns": ["project_id"],
        "reason": "加速按项目查询部署"
      },
      {
        "table": "deployments",
        "name": "idx_deploy_status",
        "type": "BTREE",
        "columns": ["status"],
        "reason": "快速筛选特定状态的部署"
      },
      {
        "table": "deployment_logs",
        "name": "idx_log_deploy_id",
        "type": "BTREE",
        "columns": ["deployment_id"],
        "reason": "查询特定部署的所有日志"
      },
      {
        "table": "deployment_logs",
        "name": "idx_log_timestamp",
        "type": "BTREE",
        "columns": ["timestamp"],
        "reason": "按时间范围查询日志"
      },
      {
        "table": "versions",
        "name": "idx_version_project_tag_unique",
        "type": "UNIQUE",
        "columns": ["project_id", "tag"],
        "reason": "确保项目内版本标签唯一，加速查询"
      }
    ],
    "performance_expectations": {
      "point_query_latency_ms": "< 5",
      "range_query_latency_ms": "< 20",
      "write_throughput_per_second": 100
    }
  },
  "migration_strategy": {
    "tool": "Alembic",
    "description": "使用 Alembic 管理数据库 schema 变更，自动生成迁移脚本。迁移脚本按时间顺序命名，存储在 migrations/ 目录下。每次模型变更需执行 alembic revision --autogenerate 生成新版本，升级运行 alembic upgrade head，降级用 alembic downgrade -1。",
    "migration_directory": "migrations/",
    "version_table": "alembic_version",
    "process": {
      "develop": "修改 SQLAlchemy 模型后，运行 `alembic revision --autogenerate -m '描述'` 生成脚本，审查后提交。",
      "test": "使用 `alembic upgrade head` 将测试数据库升级至最新表结构。",
      "production": "部署前备份数据库，再执行 `alembic upgrade head`，确保无错误。回滚时使用 `alembic downgrade <target_revision>`。"
    },
    "backward_compatibility": {
