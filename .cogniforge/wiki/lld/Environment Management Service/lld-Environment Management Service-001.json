{
  "meta": {
    "doc_id": "lld-Environment Management Service-001",
    "type": "lld",
    "module_type": "ModuleType.SERVICE",
    "module": "Environment Management Service",
    "title": "LLD - Environment Management Service",
    "author": "design_agent",
    "created": "2026-05-21 09:45"
  },
  "overview": {
    "description": "环境管理微服务，负责部署环境的创建、编辑、删除和查询，维护环境连接参数（主机地址、端口、用户名等），管理环境类型（测试线、灰度线、正式线），处理环境与项目的关联绑定，并对环境配置进行完整性校验。",
    "dependencies": ["Primary Database"],
    "tech_stack": ["Python 3.11+", "FastAPI", "MySQL 8.0"]
  },
  "data_models": [
    {
      "name": "environments",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environments"
      },
      "description": "部署环境表，继承自主数据库。存储每个环境的连接参数和类型信息，通过project_id与项目关联，本服务负责该表的全部读写操作。",
      "fields": [
        {"name": "id", "type": "bigint", "required": true, "description": "环境ID，自增主键"},
        {"name": "project_id", "type": "bigint", "required": true, "description": "所属项目ID，外键关联projects表"},
        {"name": "name", "type": "varchar(255)", "required": true, "description": "环境名称，同一项目内唯一"},
        {"name": "type", "type": "enum('test','gray','production')", "required": true, "description": "环境类型：test-测试线，gray-灰度线，production-正式线"},
        {"name": "host", "type": "varchar(255)", "required": true, "description": "远程主机地址（IP或域名）"},
        {"name": "port", "type": "int", "required": true, "description": "SSH端口号，默认22"},
        {"name": "username", "type": "varchar(128)", "required": true, "description": "SSH登录用户名"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "datetime", "required": true, "description": "更新时间"}
      ]
    },
    {
      "name": "EnvironmentValidationRule",
      "type": "config",
      "ownership": "owned",
      "description": "环境配置校验规则，从配置文件加载",
      "fields": [
        {"name": "name_pattern", "type": "string", "required": true, "description": "环境名称正则模式，允许字母、数字、中划线、下划线，默认 ^[a-zA-Z0-9_-]+$"},
        {"name": "name_max_length", "type": "integer", "required": true, "description": "环境名称最大长度，默认64"},
        {"name": "port_range_min", "type": "integer", "required": true, "description": "SSH端口最小值，默认1"},
        {"name": "port_range_max", "type": "integer", "required": true, "description": "SSH端口最大值，默认65535"},
        {"name": "host_pattern", "type": "string", "required": true, "description": "主机地址格式校验模式，支持IP或域名"}
      ]
    },
    {
      "name": "EnvironmentTypeSpec",
      "type": "config",
      "ownership": "owned",
      "description": "环境类型规格定义，描述各类型环境的约束和行为特性",
      "fields": [
        {"name": "type", "type": "enum('test','gray','production')", "required": true, "description": "环境类型标识"},
        {"name": "display_name", "type": "string", "required": true, "description": "环境类型展示名称，如'测试线'"},
        {"name": "max_count_per_project", "type": "integer", "required": true, "description": "每个项目允许的最大数量，production类型限制为1"},
        {"name": "allow_deploy", "type": "boolean", "required": true, "description": "是否允许触发部署"},
        {"name": "description", "type": "string", "required": false, "description": "类型说明"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "Create Environment",
      "method": "POST",
      "endpoint": "/api/projects/{project_id}/environments",
      "description": "为指定项目创建部署环境。校验环境名称在项目内唯一性、环境类型合法性、连接参数格式，校验通过后写入数据库并返回创建结果。",
      "parameters": [
        {"name": "project_id", "type": "integer", "description": "项目ID（路径参数）"},
        {"name": "name", "type": "string", "description": "环境名称，同一项目内唯一"},
        {"name": "type", "type": "enum", "description": "环境类型：test|gray|production"},
        {"name": "host", "type": "string", "description": "远程主机地址（IP或域名）"},
        {"name": "port", "type": "integer", "description": "SSH端口，默认22"},
        {"name": "username", "type": "string", "description": "SSH登录用户名"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：环境名称格式不合法（长度1-64，只允许字母、数字、中划线、下划线）、端口不在有效范围（1-65535）、主机地址格式无效、环境类型不在允许范围内"},
        {"code": 404, "message": "项目不存在，指定的project_id未找到对应项目"},
        {"code": 409, "message": "环境名称已存在，同一项目内环境名称唯一性冲突"}
      ]
    },
    {
      "name": "List Environments",
      "method": "GET",
      "endpoint": "/api/projects/{project_id}/environments",
      "description": "获取指定项目的所有部署环境列表。按创建时间倒序排列，返回环境摘要信息。",
      "parameters": [
        {"name": "project_id", "type": "integer", "description": "项目ID（路径参数）"},
        {"name": "page", "type": "integer", "description": "页码，默认1"},
        {"name": "page_size", "type": "integer", "description": "每页条数，默认20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array[object]",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "分页参数不合法（page或page_size小于1）"},
        {"code": 404, "message": "项目不存在"}
      ]
    },
    {
      "name": "Get Environment",
      "method": "GET",
      "endpoint": "/api/environments/{env_id}",
      "description": "获取指定环境的详细信息，包括所有连接参数和元数据。",
      "parameters": [
        {"name": "env_id", "type": "integer", "description": "环境ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "环境不存在，指定的env_id未找到对应环境"}
      ]
    },
    {
      "name": "Update Environment",
      "method": "PUT",
      "endpoint": "/api/environments/{env_id}",
      "description": "更新指定环境的配置参数。支持更新环境名称、类型、主机地址、端口、用户名。环境名称变更时需校验项目内唯一性。",
      "parameters": [
        {"name": "env_id", "type": "integer", "description": "环境ID（路径参数）"},
        {"name": "name", "type": "string", "description": "环境名称，可选"},
        {"name": "type", "type": "enum", "description": "环境类型：test|gray|production，可选"},
        {"name": "host", "type": "string", "description": "远程主机地址，可选"},
        {"name": "port", "type": "integer", "description": "SSH端口，可选"},
        {"name": "username", "type": "string", "description": "SSH用户名，可选"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：环境名称格式不合法、端口不在有效范围、主机地址格式无效"},
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "环境名称已存在，同一项目内环境名称唯一性冲突"}
      ]
    },
    {
      "name": "Delete Environment",
      "method": "DELETE",
      "endpoint": "/api/environments/{env_id}",
      "description": "删除指定环境及其所有关联配置。删除前检查环境是否有关联的部署记录或密钥，有关联时拒绝删除。",
      "parameters": [
        {"name": "env_id", "type": "integer", "description": "环境ID（路径参数）"}
      ],
      "response": {
        "status": 204,
        "body": {}
      },
      "error_codes": [
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "环境存在关联的部署记录或密钥，无法删除"}
      ]
    }
  ],
  "error_handling": "1）参数校验错误（400）：请求体缺少必填字段、环境名称格式不合法（长度1-64字符，只允许字母/数字/中划线/下划线）、SSH端口不在1-65535范围、主机地址非合法IP或域名格式时返回400，响应体包含具体错误字段名和校验失败原因。2）资源不存在（404）：project_id或env_id引用的资源在数据库中不存在时返回404。3）唯一性冲突（409）：同一项目内创建或更新环境时检测到环境名称冲突，返回409 Conflict，响应体包含冲突字段名称和当前冲突值。4）删除冲突（409）：删除环境时检测到有关联的部署记录或SSH密钥，返回409并给出关联类型和数量，提示先清理关联资源。5）数据库错误：数据库连接失败或查询超时（默认5秒超时），记录错误日志后返回500，不暴露数据库内部细节。6）内部错误（500）：所有未捕获异常统一返回500，响应体包含请求ID以便链路追踪。"
}
