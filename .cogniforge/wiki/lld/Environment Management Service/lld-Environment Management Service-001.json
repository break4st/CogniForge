{
  "meta": {
    "doc_id": "lld-Environment Management Service-001",
    "type": "lld",
    "module_type": "ModuleType.SERVICE",
    "module": "Environment Management Service",
    "title": "LLD - Environment Management Service",
    "author": "design_agent",
    "created": "2026-05-21 10:13"
  },
  "overview": {
    "description": "管理部署环境的配置，包括服务器连接参数、环境标识等。提供部署环境的完整 CRUD 操作，维护环境与项目的绑定关系，验证连接配置参数的有效性，并通过委托 SSH Execution Service 执行连接测试。",
    "dependencies": [
      "API Gateway",
      "Key Management Service",
      "SSH Execution Service",
      "Audit Service"
    ],
    "tech_stack": [
      "Python",
      "FastAPI",
      "PostgreSQL 15"
    ]
  },
  "data_models": [
    {
      "name": "environments",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environments"
      },
      "description": "部署环境配置表，记录每个项目的远程服务器部署环境信息，包括 SSH 连接参数和部署路径。一个项目可关联多个环境（如测试线、灰度线、正式线）。",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "description": "环境唯一标识，主键"
        },
        {
          "name": "project_id",
          "type": "uuid",
          "required": true,
          "description": "所属项目 ID，外键关联 projects 表"
        },
        {
          "name": "name",
          "type": "varchar(100)",
          "required": true,
          "description": "环境名称（如 测试线、灰度线、正式线）"
        },
        {
          "name": "label",
          "type": "varchar(50)",
          "required": true,
          "description": "环境标识（如 test / staging / prod），同一项目内不可重复"
        },
        {
          "name": "host",
          "type": "varchar(255)",
          "required": true,
          "description": "远程服务器主机地址（IP 或域名）"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "SSH 连接端口，默认 22"
        },
        {
          "name": "username",
          "type": "varchar(100)",
          "required": true,
          "description": "SSH 登录用户名"
        },
        {
          "name": "key_id",
          "type": "uuid",
          "required": true,
          "description": "关联的 SSH 密钥 ID，外键关联 keys 表"
        },
        {
          "name": "deploy_path",
          "type": "varchar(500)",
          "required": true,
          "description": "远程部署根路径（如 /data/deploy/{project}/{env}）"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "required": true,
          "description": "环境创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "required": true,
          "description": "环境信息最后更新时间"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "name": "CreateEnvironment",
      "method": "POST",
      "endpoint": "/api/projects/{project_id}/environments",
      "description": "为指定项目创建一个新的部署环境。校验请求参数的合法性（名称唯一性、主机地址格式、端口范围等），将环境配置持久化到数据库，并委托 Audit Service 记录环境创建操作。",
      "parameters": [
        {
          "name": "project_id",
          "type": "string",
          "description": "路径参数，项目 ID"
        }
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "name": "string",
          "label": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "deploy_path": "string",
          "created_at": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数不合法（如名称为空、主机地址格式错误、端口超出范围 1-65535）"},
        {"code": 404, "message": "项目不存在"},
        {"code": 409, "message": "环境标识 label 在该项目中已存在"}
      ]
    },
    {
      "name": "ListEnvironments",
      "method": "GET",
      "endpoint": "/api/projects/{project_id}/environments",
      "description": "获取指定项目的所有部署环境列表，返回环境概要信息，不包含敏感字段（如 username、host）。",
      "parameters": [
        {
          "name": "project_id",
          "type": "string",
          "description": "路径参数，项目 ID"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "total": "integer",
          "items": "array"
        }
      },
      "error_codes": [
        {"code": 404, "message": "项目不存在"}
      ]
    },
    {
      "name": "GetEnvironment",
      "method": "GET",
      "endpoint": "/api/environments/{env_id}",
      "description": "获取指定环境的详细配置信息，包含完整的 SSH 连接参数。",
      "parameters": [
        {
          "name": "env_id",
          "type": "string",
          "description": "路径参数，环境 ID"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "project_id": "string",
          "name": "string",
          "label": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_id": "string",
          "deploy_path": "string",
          "created_at": "string",
          "updated_at": "string"
        }
      },
      "error_codes": [
        {"code": 404, "message": "环境不存在"}
      ]
    },
    {
      "name": "UpdateEnvironment",
      "method": "PUT",
      "endpoint": "/api/environments/{env_id}",
      "description": "更新指定环境的配置信息。请求体中仅需包含要修改的字段，未提供的字段保持不变。不允许修改已关联部署记录的环境 label。",
      "parameters": [
        {
          "name": "env_id",
          "type": "string",
          "description": "路径参数，环境 ID"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "project_id": "string",
          "name": "string",
          "label": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_id": "string",
          "deploy_path": "string",
          "created_at": "string",
          "updated_at": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数不合法"},
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "环境标识 label 在该项目中已存在或不允许修改已关联部署记录的环境 label"}
      ]
    },
    {
      "name": "DeleteEnvironment",
      "method": "DELETE",
      "endpoint": "/api/environments/{env_id}",
      "description": "删除指定环境。如果该环境存在关联的部署记录则拒绝删除，返回 409 Conflict。删除后委托 Audit Service 记录操作。",
      "parameters": [
        {
          "name": "env_id",
          "type": "string",
          "description": "路径参数，环境 ID"
        }
      ],
      "response": {
        "status": 204,
        "body": {}
      },
      "error_codes": [
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "该环境存在关联的部署记录，无法删除"}
      ]
    },
    {
      "name": "TestConnection",
      "method": "POST",
      "endpoint": "/api/environments/{env_id}/test",
      "description": "测试指定环境的 SSH 连接是否可用。从数据库读取环境配置，从 Key Management Service 获取解密后的 SSH 私钥，委托 SSH Execution Service 执行连接测试，返回测试结果。",
      "parameters": [
        {
          "name": "env_id",
          "type": "string",
          "description": "路径参数，环境 ID"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 404, "message": "环境不存在"},
        {"code": 502, "message": "密钥获取失败或 SSH 连接测试服务不可用"}
      ]
    }
  ],
  "error_handling": "Environment Management Service 对各类异常进行统一处理：(1) 参数校验异常 — 请求体 JSON 解析失败、必填字段缺失、字段格式非法（如 host 非有效 IP/域名、port 超范围 1-65535）返回 400 Bad Request，附带具体校验错误详情；(2) 资源不存在 — 项目 ID 或环境 ID 在数据库中不存在时返回 404 Not Found；(3) 业务冲突 — 同项目内环境标识 label 重复返回 409 Conflict，有关联部署记录的环境删除或 label 修改同样返回 409 Conflict；(4) 外部服务异常 — 调用 Key Management Service 获取密钥失败时记录错误并返回 502 Bad Gateway，委托 SSH Execution Service 执行连接测试超时或连接失败时向上层透传错误消息；(5) 数据库异常 — 数据库连接失败或写入冲突时记录完整错误栈，返回 500 Internal Server Error；(6) 未捕获异常 — 统一返回 500 Internal Server Error 并在审计日志中记录上下文。所有错误响应体统一格式为: { code: integer, error: string, detail: string }。"
}
