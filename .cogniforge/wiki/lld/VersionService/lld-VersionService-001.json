  "module_boundary": {
    "in_scope": [
      "部署版本记录的创建（由部署成功事件触发或API手动创建）",
      "版本列表查询（按项目、环境、部署筛选）",
      "单个版本详情查询",
      "回滚执行：将目标版本设为活跃版本，实现软链接切换",
      "旧版本清理：按保留策略删除远程服务器上的版本文件及数据库记录",
      "版本生命周期状态管理（active/inactive/archived/rolling_back）"
    ],
    "out_of_scope": [
      "部署过程的执行（由DeploymentService负责）",
      "SSH连接的建立与管理（由SSHService负责）",
      "服务器文件系统的基础操作（由FileManager提供抽象）",
      "前端UI渲染与交互（由Dashboard、DeployHistory等前端模块负责）",
      "用户认证与授权（由APIGateway统一处理）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [
      "CTR-002",
      "CTR-003",
      "CTR-004"
    ],
    "owned_data_models": [
      "DM-002",
      "DM-004"
    ],
    "consumed_data_models": [
      "DM-001",
      "DM-003"
    ]
  },
  "overview": {
    "description": "VersionService负责管理部署过程中生成的版本记录，支持按部署、项目、环境进行历史版本查询，提供回滚功能（将指定版本切换为活跃版本），并能根据保留策略清理远程服务器上的旧版本文件及对应数据库记录。",
    "dependencies": [
      "SSHService",
      "FileManager",
      "DeploymentService",
      "APIGateway"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "SQLite",
      "SQLAlchemy",
      "paramiko（通过SSHService）"
    ]
  },
