  "data_models": [
    {
      "id": "DM-001",
      "name": "deployment_versions",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployment_versions"
      },
      "description": "存储每次部署产生的版本快照记录",
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "deployment_id",
          "type": "Integer",
          "required": true,
          "description": "外键关联deployments.id"
        },
        {
          "name": "version_path",
          "type": "String",
          "required": true,
          "description": "服务器上的版本文件/目录路径"
        },
        {
          "name": "version_label",
          "type": "String",
          "required": false,
          "description": "用户自定义标签或自动生成"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "description": "状态（active/inactive/archived/rolling_back），默认inactive"
        },
        {
          "name": "active_since",
          "type": "DateTime",
          "required": false,
          "description": "成为活跃版本的时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_dv_deployment_status",
          "unique": true,
          "columns": [
            "deployment_id",
            "status"
          ]
        },
        {
          "name": "idx_dv_deployment_id",
          "unique": false,
          "columns": [
            "deployment_id"
          ]
        },
        {
          "name": "idx_dv_created_at",
          "unique": false,
