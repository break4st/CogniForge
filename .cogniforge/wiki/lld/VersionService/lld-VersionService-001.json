      ],
      "constraints": [
        "同一个deployment_id下只能有一条status=active的记录",
        "回滚操作必须原子切换状态"
      ],
      "lifecycle": {
        "create": "部署成功后由DeploymentService触发VersionService创建记录",
        "update": "回滚或手动状态变更时修改status/active_since",
        "delete": "清理策略触发时物理删除记录",
        "retention": "不活跃版本可保留至管理员设定的天数后删除"
      },
