          "method_name": "list_versions",
          "input": {
            "$ref": "DO-004"
          },
          "output": {
            "type": "array",
            "items": {
              "$ref": "DO-001"
            }
          },
          "description": "查询版本列表",
          "behaviour": "根据可选的筛选参数查询部署版本列表，返回Version对象数组",
          "errors": [
