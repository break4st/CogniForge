        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "description": "清理服务契约"
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "同一部署下只能有一个活跃版本",
      "rule_type": "invariant",
      "expression": "部署版本表中，deployment_id 和 status='active' 的组合必须唯一"
    },
    {
      "id": "BR-002",
      "description": "回滚操作需原子切换版本状态",
      "rule_type": "invariant",
      "expression": "回滚过程中，先将当前活跃版本设为inactive，再将目标版本设为active，整个过程在同一事务中完成"
    },
    {
      "id": "BR-003",
      "description": "版本状态流转规则",
      "rule_type": "state_machine",
      "states": [
        "inactive",
        "active",
        "rolling_back",
        "archived"
      ],
      "transitions": [
        {
          "from": "inactive",
          "to": "active",
          "trigger": "回滚至该版本或首次部署"
        },
        {
          "from": "active",
          "to": "inactive",
          "trigger": "被回滚操作替换"
        },
        {
          "from": "active",
          "to": "rolling_back",
          "trigger": "启动回滚流程（临时状态）"
        },
        {
          "from": "rolling_back",
          "to": "active",
          "trigger": "回滚完成（目标版本）"
        },
        {
          "from": "any",
          "to": "archived",
          "trigger": "管理员手动归档或自动清理"
        }
      ]
    },
    {
      "id": "BR-004",
      "description": "版本清理前必须检查远程文件是否存在，若不存在则仅删除数据库记录",
      "rule_type": "constraint"
    }
  ],
  "error_handling": {
    "strategy": "集中错误处理中间件捕获未处理异常并返回标准错误响应，业务异常抛出特定异常类由全局异常处理器转换为HTTP错误响应",
    "errors": [
      {
        "code": "VERSION_NOT_FOUND",
        "http_status": 404,
        "message": "指定版本ID不存在"
      },
      {
        "code": "INVALID_DEPLOYMENT",
        "http_status": 400,
        "message": "关联的部署ID无效"
      },
      {
        "code": "VERSION_ALREADY_ACTIVE",
        "http_status": 409,
        "message": "目标版本已是活跃版本，无需回滚"
      },
      {
        "code": "ROLLBACK_FAILED",
        "http_status": 500,
        "message": "回滚操作在远程服务器上执行失败"
      },
      {
        "code": "CLEANUP_FAILED",
        "http_status": 500,
        "message": "清理操作失败"
      },
      {
        "code": "VERSION_SERVICE_ERROR",
        "http_status": 500,
        "message": "版本服务内部错误"
      }
    ]
  }
}