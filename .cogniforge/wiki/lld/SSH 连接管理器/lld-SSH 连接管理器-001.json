  "interfaces": [
    {
      "id": "IF-001",
      "name": "SSHConnectionManager",
      "method": "POST",
      "endpoint": "/ssh/connection/execute",
      "description": "建立SSH连接并执行远程命令，返回结构化结果",
      "parameters": {
        "path": [],
        "query": [],
        "header": [],
        "body": [
          {
            "name": "connection_params",
            "type": "SSHConnectionParams",
            "required": true,
            "description": "连接参数对象"
          },
          {
            "name": "command",
            "type": "string",
            "required": true,
            "description": "待执行的远程命令"
          }
        ]
      },
      "response": {
        "status_codes": [200],
        "body": {
          "type": "CommandResult",
          "description": "命令执行结果"
        }
      },
      "source_components": [
        "CMP-009"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "errors": [],
      "notes": ""
    },
    {
      "id": "IF-002",
      "name": "ConnectionPool",
      "method": "POST",
      "endpoint": "/ssh/pool/manage",
      "description": "管理SSH连接池，包括创建、获取、释放和销毁连接",
      "parameters": {
        "path": [],
        "query": [],
        "header": [],
        "body": [
          {
            "name": "action",
