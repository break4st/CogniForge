            "required": true,
            "description": "操作类型：create, get, release, destroy"
          },
          {
            "name": "connection_params",
            "type": "SSHConnectionParams",
            "required": true,
            "description": "连接参数"
          }
        ]
      },
      "response": {
        "status_codes": [200],
        "body": {
          "type": "object",
          "description": "操作结果，包含连接状态或错误信息"
        }
      },
      "source_components": [
        "CMP-009"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "errors": [],
      "notes": ""
    },
    {
      "id": "IF-003",
      "name": "SessionManager",
      "method": "POST",
      "endpoint": "/ssh/session/manage",
      "description": "管理SSH会话，包括测试连接有效性和维持心跳",
      "parameters": {
        "path": [],
        "query": [],
        "header": [],
        "body": [
          {
            "name": "action",
            "type": "string",
            "required": true,
            "description": "操作类型：test_connection, heartbeat"
          },
          {
            "name": "connection_params",
            "type": "SSHConnectionParams",
