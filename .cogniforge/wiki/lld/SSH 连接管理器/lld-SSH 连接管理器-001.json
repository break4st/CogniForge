  "module_boundary": {
    "in_scope": [
      "SSH 会话的连接池管理（连接创建、复用、心跳保活、销毁）",
      "远程命令执行（支持阻塞与非阻塞模式，捕获stdout/stderr，实时流式输出）",
      "SFTP 文件上传与下载",
      "连接测试（验证 SSH 凭据与网络可达性）",
      "连接与命令执行的超时控制",
      "连接状态监控与统计"
    ],
    "out_of_scope": [
      "SSH 密钥/密码的存储与加密管理（由密钥安全模块CMP-010负责）",
      "部署流程的编排逻辑（由部署引擎CMP-006负责）",
      "日志持久化与推送（由日志服务CMP-007负责）"
    ],
    "owned_components": [
      "CMP-009"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "本模块作为基础设施层组件，为上层业务服务（部署引擎、环境管理服务等）提供稳定、可复用的SSH连接能力。它封装了Paramiko库，实现了一个异步兼容的连接池，支持多主机、多凭证的灵活管理。主要功能包括：连接生命周期管理、远程命令执行（实时流式输出）、SFTP文件传输以及连接健康检查。所有操作均为无状态的函数调用，由调用方负责会话标识的传递。",
    "dependencies": [
      "密钥安全模块 (CMP-010)"
    ],
    "tech_stack": [
      "Python 3.11+",
      "Paramiko",
      "asyncio"
    ]
  },
  "topology": {
    "exchanges": [
      {
        "name": "SSH 连接与命令执行",
        "description": "调用方与SSH连接管理器之间的交互",
        "participants": [
          "Caller",
          "SSHConnectionManager"
        ],
        "messages": [
          {
            "from": "Caller",
            "to": "SSHConnectionManager",
            "contract": "CTR-001",
            "description": "执行远程命令",
            "data_model": "DM-001"
          },
          {
            "from": "SSHConnectionManager",
            "to": "Caller",
            "contract": "CTR-001",
            "description": "返回命令执行结果",
            "data_model": "DM-002"
          }
        ]
      },
      {
        "name": "SFTP 文件传输",
        "description": "调用方通过SSH连接管理器进行文件传输",
        "participants": [
          "Caller",
          "SSHConnectionManager"
        ],
        "messages": [
          {
            "from": "Caller",
            "to": "SSHConnectionManager",
            "contract": "CTR-001",
            "description": "上传/下载文件",
            "data_model": "DM-001"
          },
          {
            "from": "SSHConnectionManager",
            "to": "Caller",
            "contract": "CTR-001",
            "description": "返回传输结果",
            "data_model": "DM-003"
          }
        ]
      }
    ],
    "namespaces": [],
    "buckets": []
  },
