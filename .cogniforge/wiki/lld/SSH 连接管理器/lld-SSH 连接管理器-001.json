    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "SSHConnectionParams",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "发起SSH连接所需的全部参数，由调用方传入，不包含实际凭证明文（凭证由密钥安全模块动态提供）。",
      "fields": [
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "目标主机IP或域名"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "默认22"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "登录用户名"
        },
        {
          "name": "auth_type",
          "type": "string",
          "required": true,
          "description": "认证类型，enum: password, key"
        },
        {
          "name": "password",
          "type": "string",
          "required": false,
          "description": "当auth_type=password时必需"
        },
        {
          "name": "private_key",
          "type": "string",
          "required": false,
          "description": "当auth_type=key时必需（PEM格式私钥内容）"
        },
        {
          "name": "connection_timeout",
          "type": "integer",
          "required": false,
          "description": "连接超时秒数，默认10"
        },
        {
          "name": "keepalive_interval",
          "type": "integer",
          "required": false,
          "description": "保活间隔秒数，默认60"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-009"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "auth_type与password/private_key必须匹配",
        "host必需符合IP或FQDN格式"
      ],
      "lifecycle": {
        "create": "调用方创建并传入",
        "update": "不可变",
        "delete": "调用结束后释放",
        "retention": "内存中短期存在"
      },
      "change_history": [
