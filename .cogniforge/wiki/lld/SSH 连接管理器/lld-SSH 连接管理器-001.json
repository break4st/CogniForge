        }
      },
      "source_components": [
        "CMP-009"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "errors": [],
      "notes": ""
    }
  ],
  "message_contracts": {
    "queue": "infra.ssh.commands",
    "message_types": [
      {
        "name": "ExecuteCommand",
        "schema": {
          "type": "object",
          "properties": {
            "connection_params": {
              "$ref": "DM-001"
            },
            "command": {
              "type": "string"
            }
          },
          "required": ["connection_params", "command"]
        }
      }
    ]
  },
  "reliability_strategy": {
    "retry_policy": {
      "max_retries": 3,
      "backoff": "exponential",
      "initial_interval_ms": 100,
      "max_interval_ms": 5000
    },
    "circuit_breaker": {
      "failure_threshold": 5,
      "timeout_seconds": 30
    },
    "fallback": "返回错误响应，断开无效连接"
  },
  "error_handling": {
    "expected_errors": [
      {
        "error_name": "ConnectionTimeout",
        "description": "SSH连接超时",
        "handling": "重试最多3次，如仍失败则抛出异常"
      },
      {
        "error_name": "AuthenticationFailed",
        "description": "认证失败",
        "handling": "立即失败，不重试，返回明确错误信息"
      },
      {
        "error_name": "CommandExecutionError",
        "description": "命令执行失败",
        "handling": "捕获异常，封装为CommandResult并记录错误信息"
      }
    ],
    "strategy": "所有异常在模块内捕获，转换为标准错误结构返回给上层，避免泄露底层库细节。"
  },
  "security": {},
  "dependencies": {
    "internal_modules": [
      {
        "module_name": "密钥安全模块",
        "purpose": "提供解密后的凭据",
        "contract_id": "CTR-002"
      }
    ],
    "external_libraries": [
      {
        "name": "paramiko",
        "version": "3.2.0",
        "purpose": "SSH协议实现"
      },
      {
        "name": "asyncio",
        "version": ">=3.11",
        "purpose": "异步并发管理"
      }
    ]
  },
  "configurations": {
    "connection_pool": {
      "max_connections": 10,
      "idle_timeout_seconds": 300,
      "health_check_interval": 60
    }
  },
  "deployment": {
    "notes": "作为库嵌入在需要SSH连接的微服务中，无独立部署。"
  }
