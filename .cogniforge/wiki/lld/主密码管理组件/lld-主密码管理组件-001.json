  "module_boundary": {
    "in_scope": [
      "提供主密码输入界面（React组件+路由）",
      "会话超时监听，超时后自动锁定并弹出重新验证界面",
      "向后端凭证加密存储服务提交主密码验证",
      "解锁成功后将令牌缓存至全局状态，失败则给出明确错误提示"
    ],
    "out_of_scope": [
      "主密码的存储与加密算法实现（由后端的凭证加密存储服务负责）",
      "令牌过期后的续期逻辑（由全局会话管理器统一处理）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-001"
    ],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "前端组件，应用启动时或会话超时后要求输入主密码以解锁加密凭证，使用React 18 + Ant Design构建。",
    "dependencies": [
      "凭证加密存储服务（后端API）",
      "全局路由守卫与状态管理模块"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003"
        ],
        "interfaces": [
          "IF-001",
          "IF-002"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "本模块实现主密码验证相关的完整前端交互流程"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "MasterPasswordFormData",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "主密码表单中用户输入的数据结构",
      "fields": [
        {
          "name": "password",
          "type": "string",
          "required": true,
          "description": "用户输入的主密码"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "用户在解锁表单中输入密码时创建，提交后即清理",
        "update": "",
        "delete": "提交成功后清理该结构",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "AuthState",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "全局认证状态，由unlock流程产生并被路由守卫等消费",
      "fields": [
        {
          "name": "isUnlocked",
          "type": "boolean",
          "required": true,
          "description": "当前是否已解锁"
        },
        {
          "name": "sessionToken",
          "type": "string",
          "required": true,
          "description": "验证成功后返回的临时令牌"
        },
        {
          "name": "lastActiveTime",
          "type": "number",
          "required": true,
          "description": "最后一次用户交互时间戳，用于超时判定"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "应用初始化时创建默认值",
        "update": "解锁成功/超时锁定时更新字段",
        "delete": "应用卸载或重置时清除",
        "retention": ""
      },
      "change_history": [
        {
