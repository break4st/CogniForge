        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "component_tree": {
    "description": "主密码管理组件由两个主要部分构成：解锁页面组件和认证状态管理。解锁页面组件通过路由加载，包含表单组件和提交逻辑。状态管理部分包含认证状态存储和超时监听器。",
    "components": [
      {
        "id": "unlock-page",
        "name": "UnlockPage",
        "type": "page",
        "description": "全屏解锁页面，包含主密码输入表单和提交按钮",
        "children": []
      }
    ]
  },
  "state_design": {
    "stores": [
      {
        "id": "auth-store",
        "name": "AuthStore",
        "type": "store",
        "description": "管理认证状态，包括解锁状态、令牌和最后活跃时间",
        "initial_state": {
          "isUnlocked": false,
          "sessionToken": "",
          "lastActiveTime": 0
        },
        "actions": [
          {
            "name": "unlock",
            "description": "设置解锁状态，保存令牌和当前时间",
            "payload": {
              "sessionToken": "string"
            }
          },
          {
            "name": "lock",
            "description": "重置为锁定状态，清除令牌"
          }
        ]
      }
    ],
    "local_states": [
      {
        "id": "form-state",
        "name": "formState",
        "component": "UnlockPage",
        "description": "管理表单输入值、加载状态和错误信息"
      }
    ]
  },
  "route_design": {
    "routes": [
      {
        "path": "/unlock",
        "component": "UnlockPage",
        "auth_required": false,
        "description": "解锁页面，用于输入主密码",
        "meta": {
          "title": "解锁"
        }
      }
    ],
    "guards": [
      {
        "type": "redirect",
        "from": "*",
        "to": "/unlock",
        "condition": "当AuthStore.isUnlocked为false时，所有非/unlock路径重定向到/unlock"
      }
    ]
  },
  "interaction_flows": [
    {
      "id": "flow-unlock",
      "name": "解锁主流程",
      "description": "用户输入主密码并提交验证，成功后跳转，失败提示错误",
      "steps": [
        {
          "order": 1,
          "actor": "user",
          "action": "在/unlock页面输入密码，点击提交",
          "system_response": "表单验证非空，发起API请求"
        },
        {
          "order": 2,
          "actor": "system",
          "action": "调用POST /api/verify-master-password",
          "system_response": "等待后端响应"
        },
        {
          "order": 3,
          "actor": "system",
          "action": "收到200响应，提取sessionToken",
          "system_response": "调用AuthStore.unlock(token)，然后路由跳转到主页"
        },
        {
          "order": 4,
          "actor": "system",
          "action": "收到401响应",
          "system_response": "显示错误信息“密码错误”，清空输入框"
        },
        {
          "order": 5,
          "actor": "system",
          "action": "收到其他错误",
          "system_response": "显示通用错误提示"
        }
      ]
    },
    {
      "id": "flow-timeout",
      "name": "会话超时锁定流程",
      "description": "定时检测用户不活动时间，超时后自动锁定",
      "steps": [
        {
          "order": 1,
          "actor": "system",
          "action": "监听用户交互事件，更新lastActiveTime",
          "system_response": ""
        },
        {
          "order": 2,
          "actor": "system",
          "action": "定时检查当前时间与lastActiveTime的差值",
          "system_response": "若超过timeoutMinutes，调用AuthStore.lock()"
        },
        {
          "order": 3,
          "actor": "system",
          "action": "锁定后，路由守卫检测到isUnlocked=false",
          "system_response": "重定向到/unlock页面"
        }
      ]
    }
  ],
  "api_integration": {
    "client": "axios",
    "base_url": "/api",
    "endpoints": [
      {
        "id": "api-verify-master-password",
        "method": "POST",
        "path": "/verify-master-password",
        "description": "验证主密码",
        "request": {
          "body": {
            "password": "string"
          }
        },
        "response": {
          "status": 200,
          "body": {
            "sessionToken": "string"
          }
        },
        "error_handling": {
          "401": "密码错误，提示用户重新输入",
          "500": "服务器错误，显示通用错误提示",
          "default": "显示网络或未知错误提示"
        }
      }
    ]
  },
  "error_handling": {
    "strategy": "全局错误边界捕获React组件错误，展示错误页面或可恢复提示。API请求错误在组件内捕获，根据状态码展示对应错误信息。表单验证错误即时反馈。",
    "fallback_ui": {
      "type": "component",
      "id": "ErrorFallback",
      "description": "用于显示意外错误，提供重试选项"
    }
  }
}