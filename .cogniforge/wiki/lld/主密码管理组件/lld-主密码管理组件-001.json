      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "主密码验证API",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-002",
      "method": "POST",
      "endpoint": "/api/verify-master-password",
      "description": "向后端发送主密码进行验证",
      "parameters": [],
      "request_body": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "主密码"
          }
        },
        "required": ["password"]
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "sessionToken": {
              "type": "string"
            }
          }
        }
      },
      "error_codes": [
        {
          "code": 401,
          "description": "密码错误",
          "type": "object",
          "message": "密码错误，请重试"
        },
        {
          "code": 500,
          "description": "服务器内部错误",
          "type": "object",
