        }
      ]
    },
    {
      "id": "DM-003",
      "name": "SessionConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "会话超时配置",
      "fields": [
        {
          "name": "timeoutMinutes",
          "type": "number",
          "required": true,
          "description": "会话超时分钟数，默认从环境变量或系统配置获取"
        }
      ],
      "source_requirements": [
