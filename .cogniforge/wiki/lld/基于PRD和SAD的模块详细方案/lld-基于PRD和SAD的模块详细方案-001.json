  "module_boundary": {
    "in_scope": [
      "接收来自前端的生成请求（含 PRD ID、SAD ID）",
      "从数据访问层获取对应的 PRD、SAD 完整数据及关联组件、契约",
      "利用设计规则推导出数据模型、接口定义、领域对象、服务契约等",
      "组装 LLD JSON 并持久化到数据库",
      "返回生成结果状态"
    ],
    "out_of_scope": [
      "PRD、SAD 的创建与编辑",
      "前端 UI 展示 LLD",
      "实际的代码生成",
      "与外部系统的集成测试接口"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-005"
    ],
    "consumed_data_models": [
      "DM-001",
      "DM-002",
      "DM-003",
      "DM-004"
    ]
  },
  "overview": {
    "description": "DesignService 模块负责根据已批准的 PRD 和 SAD 自动生成详细设计文档（LLD）。它运行于 Electron 主进程，通过 IPC 与前端通信，结合数据库中的 PRD 与 SAD 数据，以及内置的设计规则引擎，推导出完整的数据模型、接口定义、领域对象和服务契约，最终以 JSON 格式持久化并返回结果。",
    "dependencies": [
      "DatabaseManager"
    ],
    "tech_stack": [
      "Node.js",
      "Electron (主进程)",
      "better-sqlite3",
      "ejs",
      "Node.js 内置模块 (fs, path)"
    ]
  },
