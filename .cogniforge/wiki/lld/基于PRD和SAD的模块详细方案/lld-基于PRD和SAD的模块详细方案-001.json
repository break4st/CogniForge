  "interfaces": [
    {
      "id": "IF-001",
      "name": "DesignService Interface",
      "type": "ipc",
      "method": "invoke",
      "endpoint": "design:generate-lld",
      "description": "前端通过 IPC 调用生成 LLD 的接口",
      "request": {
        "params": [
          {
            "name": "prdId",
            "type": "string",
            "required": true,
            "description": "要处理的 PRD ID"
          },
          {
            "name": "sadId",
            "type": "string",
            "required": true,
            "description": "要处理的 SAD ID"
          }
        ]
      },
      "response": {
        "body": {
          "lldId": "string",
          "status": "string",
          "message": "string"
        }
      },
      "errors": [
        {
          "code": "PRD_NOT_FOUND",
          "description": "PRD 不存在或状态非 approved"
        },
        {
          "code": "SAD_NOT_FOUND",
          "description": "SAD 不存在或状态非 approved"
        },
        {
          "code": "GENERATION_FAILED",
          "description": "LLD 生成过程出错"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DesignService IPC Contract",
      "description": "DesignService 的 IPC 契约",
      "methods": [
        {
          "name": "generateLld",
          "description": "生成 LLD",
          "request": {
            "params": [
              {
                "name": "prdId",
                "type": "string",
                "description": "PRD ID"
              },
              {
                "name": "sadId",
                "type": "string",
                "description": "SAD ID"
              }
            ]
          },
          "response": {
            "type": "object",
            "properties": {
              "lldId": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "errors": [
            {
              "code": "PRD_NOT_FOUND",
              "description": "PRD 未找到"
            },
            {
              "code": "SAD_NOT_FOUND",
              "description": "SAD 未找到"
            }
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "rule": "PRD 状态必须为 'approved' 才可生成 LLD",
      "type": "constraint",
      "scope": "LLD 生成",
      "source": "REQ-001"
    },
    {
      "id": "BR-002",
      "rule": "SAD 必须关联正确的 PRD 且状态为 'approved'",
      "type": "constraint",
      "scope": "LLD 生成",
      "source": "REQ-001"
    },
    {
      "id": "BR-003",
      "rule": "生成的 LLD 必须包含所有 SAD 中定义的组件和契约",
      "type": "guarantee",
      "scope": "LLD 输出",
      "source": "REQ-001"
    },
    {
      "id": "BR-004",
      "rule": "LLD 生成过程必须将结果持久化到 LLDs 表",
      "type": "invariant",
      "scope": "数据持久化",
      "source": "REQ-001"
    }
  ],
  "error_handling": {
    "strategy": "graceful_degradation",
    "fallback": "返回错误响应并记录日志",
    "error_types": [
      {
        "type": "PRD_NOT_FOUND",
        "handling": "返回错误码和消息，不进行生成",
        "retry": false
      },
      {
        "type": "SAD_NOT_FOUND",
        "handling": "返回错误码和消息，不进行生成",
        "retry": false
      },
      {
        "type": "GENERATION_FAILED",
        "handling": "记录详细错误日志，更新状态为 failed，返回失败响应",
        "retry": true,
        "max_retries": 3
      }
    ]
  }
