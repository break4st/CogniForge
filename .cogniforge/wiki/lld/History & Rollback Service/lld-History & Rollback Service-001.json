  "data_models": [
    {
      "id": "DM-001",
      "name": "DeploymentHistoryTable",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "DeploymentHistoryTable"
      },
      "description": "存储每次部署及回滚操作的元数据，包含项目、环境、部署类型、时间、文件清单和远程路径等信息。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "主键，自增唯一标识"
        },
        {
          "name": "projectId",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "项目标识符"
        },
        {
          "name": "environmentId",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "环境标识符"
        },
        {
          "name": "deployType",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "部署类型：deploy（常规部署）或 rollback（回滚）"
        },
        {
          "name": "timestamp",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "部署/回滚发生的时间戳（ISO 8601 格式）"
        },
        {
          "name": "fileList",
          "type": "TEXT",
          "required": false,
          "description": "部署的文件清单，JSON 数组格式的文本"
        },
        {
          "name": "remotePath",
          "type": "TEXT",
          "required": false,
          "description": "部署目标远程路径"
        },
        {
          "name": "isActive",
          "type": "INTEGER NOT NULL DEFAULT 0",
          "required": true,
          "description": "是否当前活跃版本标记，1 表示活跃，0 表示非活跃"
        }
      ],
      "indexes": [
        {
          "name": "idx_project_env",
          "unique": false,
          "columns": [
            "projectId",
            "environmentId"
          ]
        },
        {
          "name": "idx_timestamp",
          "unique": false,
          "columns": [
            "timestamp"
          ]
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "每次部署或回滚操作时插入新记录",
        "update": "仅在需要修改活跃版本标记时更新 isActive 字段（例如将旧记录设为非活跃）",
        "delete": "通常不删除记录，仅通过逻辑删除或归档处理（保留历史）",
        "retention": "永久保留，或根据管理策略设定保留期限（例如 90 天后归档）"
      },
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-006"
      ],
      "source_contracts": [
        "CTR-006"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
