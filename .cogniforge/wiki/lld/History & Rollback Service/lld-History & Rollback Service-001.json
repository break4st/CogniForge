  "error_handling": {
    "strategy": "统一捕获所有IPC处理函数中的异常，通过ErrorResponse返回标准化错误体，包含错误码和详细描述，确保前端可一致处理成功与失败场景。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "参数错误",
        "description": "当查询历史时的projectId、environmentId或分页参数缺失/无效，或回滚请求缺少historyRecordId时触发；提示参数缺失或格式错误。"
      },
      {
        "code": "404",
        "name": "资源未找到",
        "description": "回滚请求指定的历史记录ID在数据库中不存在时触发；提示未找到对应部署历史。"
      },
      {
        "code": "409",
        "name": "状态冲突",
        "description": "尝试对已标记为回滚操作的历史记录再次执行回滚时触发；提示回滚操作不可重复执行。"
      },
      {
        "code": "500",
        "name": "服务端内部错误",
        "description": "数据库查询失败、SSH服务调用异常、远程脚本执行失败等非预期错误；记录详细错误日志，返回通用错误消息，隐藏内部实现细节。"
      }
    ]
  },
