  "service_contracts": [
    {
      "name": "HistoryRollbackService",
      "description": "管理部署历史记录的查询与回滚操作",
      "methods": [
        {
          "name": "getHistory",
          "signature": "(params: HistoryQueryParams) -> HistoryListResponse",
          "precondition": "params.projectId 存在",
          "postcondition": "返回指定项目、可选环境的部署历史列表，支持分页",
          "description": "按项目和环境（可选）分页查询部署历史记录",
          "exceptions": [
            {
              "name": "ValidationException",
              "trigger": "projectId 为空",
              "http_status": 400
            }
          ]
        },
        {
          "name": "rollback",
          "signature": "(request: RollbackRequest) -> RollbackResponse",
          "precondition": "request.historyEntryId 对应的部署历史记录存在且包含有效的 deploy.sh 路径",
          "postcondition": "SSH Service 远程执行回滚脚本，生成新的回滚类型历史记录条目，返回新条目 ID",
          "description": "执行回滚操作：通过 SSH Service 远程执行指定历史记录的 deploy.sh，并将此次操作记录为特殊历史条目",
          "exceptions": [
            {
              "name": "NotFoundException",
              "trigger": "historyEntryId 对应的记录不存在",
              "http_status": 404
            },
            {
              "name": "RollbackException",
              "trigger": "SSH 执行失败或脚本返回非零退出码",
              "http_status": 500
            },
            {
              "name": "ConflictException",
              "trigger": "目标环境当前有正在进行的部署操作",
              "http_status": 409
            }
          ]
        },
        {
          "name": "markAsActive",
          "signature": "(historyEntryId: string) -> void",
          "precondition": "historyEntryId 对应的历史记录存在且其项目/环境一致",
          "postcondition": "将指定条目标记为活跃版本，同时取消同环境其他条目的活跃状态",
          "description": "将指定的历史条目设为对应环境下的活跃版本",
          "exceptions": [
            {
              "name": "NotFoundException",
              "trigger": "historyEntryId 对应的记录不存在",
              "http_status": 404
            }
          ]
        }
      ],
      "repository_dependencies": [
        "findByProjectIdAndEnvironmentId(projectId: string, environmentId?: string, page: number, pageSize: number) -> { items: DeploymentHistoryEntry[], total: number }",
        "findById(id: string) -> DeploymentHistoryEntry | null",
        "createRollbackEntry(originalEntryId: string, operator: string, status: string, result: object) -> DeploymentHistoryEntry",
        "setActiveVersion(entryId: string, environmentId: string) -> void"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "每条部署历史记录必须包含唯一的ID、项目ID、环境ID、部署时间戳、部署文件清单、远程部署路径",
      "回滚操作生成的记录必须标记为回滚类型，且必须关联原始部署历史记录ID",
      "对于同一项目和环境，在同一时间点只能有一个活跃部署版本（活跃版本标记在每次新部署或回滚后更新）",
      "查询部署历史时必须按部署时间倒序排列",
      "回滚操作只能针对已完成（成功或失败）的部署记录，不能对回滚记录再次回滚"
    ],
    "state_machines": [
      {
        "entity": "DeploymentHistoryEntry",
        "states": [
          "deploying",
          "success",
          "failed",
          "rollback_in_progress",
          "rolled_back",
          "active"
        ],
        "transitions": [
          {
            "from": "(新记录)",
            "to": "deploying",
            "trigger": "部署任务开始",
            "actor": "Deployment Engine"
          },
          {
            "from": "deploying",
            "to": "success",
            "trigger": "部署完成且远程校验通过",
            "actor": "Deployment Engine"
          },
          {
            "from": "deploying",
            "to": "failed",
            "trigger": "部署失败或校验不通过",
            "actor": "Deployment Engine"
          },
          {
            "from": "success",
            "to": "rollback_in_progress",
            "trigger": "用户发起回滚到当前版本",
            "actor": "用户"
          },
          {
            "from": "failed",
            "to": "rollback_in_progress",
            "trigger": "用户发起回滚到当前版本",
            "actor": "用户"
          },
          {
            "from": "rollback_in_progress",
            "to": "rolled_back",
            "trigger": "回滚脚本执行成功",
            "actor": "SSH Service"
          },
          {
            "from": "rollback_in_progress",
            "to": "failed",
            "trigger": "回滚脚本执行失败",
            "actor": "SSH Service"
          },
          {
            "from": "success",
            "to": "active",
            "trigger": "被标记为活跃版本",
            "actor": "系统"
          },
          {
            "from": "active",
            "to": "rolled_back",
            "trigger": "更高版本的部署变为活跃或手动切换",
            "actor": "系统"
          }
        ],
        "irreversible_rules": [
          "一旦状态进入'rolled_back'，不能再变更为'deploying'或'active'",
          "'failed'状态不能直接变更为'success'",
          "'active'状态的记录不能直接删除，需先通过回滚或新部署取消其活跃标记"
        ],
        "concurrency": "使用数据库行级锁或乐观锁（版本号）防止同一历史记录被多个回滚操作同时执行；同一项目环境同时只允许一个回滚操作进行"
      }
    ],
    "cross_service_rules": [
      "回滚操作执行前，必须通过SSH Service验证目标环境连通性（超时时间10秒）",
      "部署历史写入后，若部署状态为成功，需通知Environment Manager更新环境的当前部署版本引用",
      "回滚执行前，需从Security Module获取解密后的远程认证凭据，不得在历史服务中存储明文凭据",
      "跨服务调用失败时，必须将错误信息记录到部署历史记录的状态信息中，并将状态置为失败"
    ]
  },
  "workflow": {
    "name": "回滚执行主流程",
    "description": "用户触发回滚，系统验证历史记录，通过SSH远程执行脚本，生成回滚记录",
    "steps": [
      {
        "order": 1,
        "name": "验证历史记录",
        "action": "根据historyEntryId查询部署历史，确认记录存在且非回滚记录",
        "timeout_seconds": 5,
        "on_failure": "返回404或400错误"
      },
      {
        "order": 2,
        "name": "获取远程凭据",
        "action": "调用Security Module获取解密后的SSH凭据",
        "timeout_seconds": 10,
        "on_failure": "返回500错误，终止回滚"
      },
      {
        "order": 3,
        "name": "远程执行deploy.sh",
        "action": "通过SSH Service在目标服务器执行历史记录中的deploy.sh",
        "timeout_seconds": 120,
        "on_failure": "返回500错误，记录失败状态"
      },
      {
        "order": 4,
        "name": "生成回滚记录",
        "action": "在数据库中插入一条deployType为rollback的新历史记录，关联原始记录ID",
        "timeout_seconds": 5,
        "on_failure": "记录错误，但回滚已生效"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  }
}