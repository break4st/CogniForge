  "module_boundary": {
    "in_scope": [
      "部署历史记录的保存、查询（按项目、环境、分页）",
      "回滚操作的触发与执行（通过SSH Service远程执行deploy.sh）",
      "回滚操作记录为特殊部署历史条目",
      "活跃版本标记"
    ],
    "out_of_scope": [
      "SSH连接管理与密钥解密（由SSH Service和Security Module负责）",
      "环境连通性测试（由Environment Manager负责）",
      "文件上传与部署脚本生成（由Deployment Engine负责）",
      "UI渲染与用户交互逻辑"
    ],
    "owned_components": [
      "CMP-006"
    ],
    "owned_contracts": [
      "CTR-006"
    ],
    "consumed_contracts": [
      "CTR-004"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "负责记录每次部署的元数据，包括时间戳、项目标识、环境标识、部署文件清单、远程路径等。提供按项目和环境查询部署历史的能力，支持分页。通过调用SSH Service远程执行指定历史记录的deploy.sh实现回滚，并将回滚操作生成新的历史记录条目，标记为回滚类型。",
    "dependencies": [
      "SSH Service (CMP-005)",
      "Security Module (CMP-007)",
      "Primary Database (Data Access Layer)"
    ],
    "tech_stack": [
      "TypeScript / Node.js",
      "Electron ipcMain",
      "SQLite (via better-sqlite3)"
    ]
  },
