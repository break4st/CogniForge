  "interfaces": [
    {
      "id": "IF-001",
      "name": "获取连接 / 创建连接",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "SSHConnectionManager.get_connection(host, port, username, key_path, timeout)",
      "description": "从连接池获取一个指定目标服务器的 SSH 连接；若池空且未达上限则新建连接并认证。",
      "parameters": [
        {
          "name": "host",
          "type": "str",
          "in": "body",
          "required": true,
          "description": "目标主机 IP 或域名"
        },
        {
          "name": "port",
          "type": "int",
          "in": "body",
          "required": false,
          "description": "SSH 端口，默认 22"
        },
        {
          "name": "username",
          "type": "str",
          "in": "body",
          "required": true,
          "description": "SSH 用户名"
        },
        {
          "name": "key_path",
          "type": "str",
          "in": "body",
          "required": true,
          "description": "私钥文件的本地绝对路径"
        },
        {
          "name": "timeout",
          "type": "float",
          "in": "body",
          "required": false,
          "description": "超时秒数，默认 10"
        }
      ],
      "request_body": {},
      "response": {
        "status": 0,
        "body": {
          "success": "bool",
          "data": "object (session_id: str)",
          "error": "string",
          "message": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "POOL_EXHAUSTED",
          "message": "无可用连接且达到最大容量"
        },
        {
          "status": 400,
          "code": "SSH_CONNECTION_TIMEOUT",
          "message": "TCP 连接超时"
        },
        {
          "status": 400,
          "code": "SSH_CONNECTION_REFUSED",
          "message": "端口不可达"
        },
        {
          "status": 400,
          "code": "SSH_AUTHENTICATION_FAILED",
          "message": "密钥无效、权限被拒绝"
        },
        {
          "status": 400,
          "code": "SSH_KEY_FILE_INVALID",
          "message": "私钥文件格式错误或不可读"
        },
        {
          "status": 400,
          "code": "SSH_UNEXPECTED_ERROR",
          "message": "其他未预期的异常"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "idempotent",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
