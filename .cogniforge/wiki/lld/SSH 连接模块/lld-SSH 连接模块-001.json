    "in_scope": [
      "SSH 连接的创建、认证、会话保持与销毁",
      "基于连接池的生命期管理",
      "SFTP 文件上传（支持进度回调）",
      "远程命令执行",
      "连接可用性探测（连通性测试）"
    ],
    "out_of_scope": [
      "业务部署流程的编排",
      "文件解压逻辑",
      "远程脚本生成",
      "前端界面展示",
      "数据库交互"
