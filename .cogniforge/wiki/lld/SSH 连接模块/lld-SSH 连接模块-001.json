  "business_rules": {
    "invariants": [
      "连接池最大容量为 10",
      "已建立连接的目标主机（host:port 唯一键）在池中同时最多存在一条",
      "释放连接时如果发现连接已断开，自动关闭并从池移除"
    ]
  },
  "error_handling": {
    "strategy": "统一返回结构，每类错误映射一个错误码；所有公共方法返回包含 success 字段的字典，调用方检查 success 并依据 error 字段处理。"
  },
  "topology": {
    "exchanges": [
      {
        "name": "ssh_events",
        "type": "topic",
        "durable": true,
        "description": "SSH 连接相关事件，如连接建立、关闭、错误"
      }
    ],
    "queues": [
      {
        "name": "ssh_log_queue",
        "durable": true,
        "description": "SSH 操作日志队列"
      }
    ],
    "bindings": [
      {
        "exchange": "ssh_events",
        "queue": "ssh_log_queue",
        "routing_key": "ssh.*",
        "description": "将所有 SSH 事件路由到日志队列"
      }
    ]
  }
}