    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "SSH 连接模块是基础设施层的一员，封装 paramiko 库，提供密钥认证 SSH 连接、SFTP 文件上传、远程命令执行及连通性测试，并引入连接池以减少开销。",
    "dependencies": [],
    "tech_stack": [
      "Python 3.10+",
      "paramiko"
    ]
  },
