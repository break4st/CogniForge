        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [
        "user_id 外键到用户表（由上游服务管理）"
      ],
      "lifecycle": {
        "create": "用户登录成功时创建",
        "update": "令牌刷新或吊销时更新 is_revoked",
        "delete": "定期清理过期令牌",
        "retention": "保留至过期后 7 天"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "rate_limit_config",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "速率限制的配置表，定义了不同层级（全局、用户、端点）的限流策略。",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "level",
          "type": "string",
          "required": true,
          "description": "限流层级: global, user, endpoint"
        },
        {
          "name": "key",
          "type": "string",
          "required": true,
          "description": "限流依据: 对于user级为用户ID，endpoint为路径模式，global为固定GLOBAL"
        },
        {
          "name": "window_ms",
          "type": "integer",
          "required": true,
          "description": "时间窗口大小（毫秒）"
        },
        {
          "name": "max_requests",
          "type": "integer",
          "required": true,
          "description": "窗口内允许的最大请求数"
        },
        {
          "name": "enabled",
          "type": "boolean",
          "required": true,
          "description": "是否启用"
        }
      ],
      "indexes": [
        {
          "name": "idx_level_key",
          "unique": true,
          "columns": [
            "level",
            "key"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [
        "level 和 key 联合唯一"
      ],
      "lifecycle": {
        "create": "管理员配置限流策略时创建",
        "update": "调整限流参数时更新",
        "delete": "策略废弃时删除",
        "retention": "永久保存"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-004",
      "name": "request_logs",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "记录所有经过网关的请求日志，用于监控和审计。",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "timestamp",
          "type": "datetime",
          "required": true,
          "description": "请求时间"
        },
        {
          "name": "method",
          "type": "string",
          "required": true,
          "description": "HTTP方法"
        },
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "请求路径"
        },
        {
          "name": "status_code",
          "type": "integer",
          "required": true,
          "description": "响应状态码"
        },
        {
          "name": "response_time_ms",
          "type": "integer",
          "required": true,
          "description": "响应时间（毫秒）"
        },
        {
          "name": "user_id",
          "type": "string",
          "required": false,
          "description": "请求用户ID（若已认证）"
        },
        {
          "name": "ip",
          "type": "string",
          "required": true,
          "description": "客户端IP"
        }
      ],
      "indexes": [
        {
          "name": "idx_timestamp",
          "columns": [
            "timestamp"
          ],
          "unique": false
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "每个请求经过时创建",
        "update": "通常不更新",
        "delete": "定期归档后删除",
        "retention": "保留30天"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "HTTP Proxy Routes",
      "type": "API",
      "description": "代理所有非白名单 API 请求到相应的上游微服务。",
      "method": "ANY",
      "endpoint": "/api/**",
      "source_contract_id": "CTR-001",
      "request": {
        "headers": {
          "Authorization": "Bearer JWT token",
          "Content-Type": "application/json"
        },
        "query_params": {},
        "path_params": {},
        "body": "代理的原始请求体"
      },
      "response": {
        "status_codes": [
          200,
          400,
          401,
          403,
          404,
          500,
          502,
          503
        ],
        "body": "代理的上游服务响应体，可能是JSON或流"
      },
      "error_handling": {
        "upstream_unavailable": "返回 502 Bad Gateway",
        "timeout": "返回 504 Gateway Timeout"
      },
      "dependencies": {},
      "notes": "根据路由表动态匹配。",
      "version": 1,
      "change_history": []
    },
    {
      "id": "IF-002",
      "name": "Health Check",
      "type": "API",
      "description": "提供网关自身的健康检查端点。",
      "method": "GET",
      "endpoint": "/health",
      "source_contract_id": "CTR-002",
      "request": {
        "headers": {},
        "query_params": {},
        "path_params": {},
        "body": null
      },
      "response": {
        "status_codes": [
          200
        ],
        "body": {
          "status": "UP",
          "timestamp": "2025-03-31T10:00:00Z"
        }
      },
      "error_handling": {},
      "dependencies": {},
      "notes": "白名单路径，无需认证。",
      "version": 1,
      "change_history": []
    },
    {
      "id": "IF-003",
      "name": "Token Management",
      "type": "API",
      "description": "处理登录、令牌刷新和吊销操作。",
      "method": "POST",
      "endpoint": "/auth/**",
      "source_contract_id": "CTR-003",
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "query_params": {},
        "path_params": {},
        "body": {
          "username": "string",
          "password": "string",
          "refresh_token": "string (for refresh)"
        }
      },
      "response": {
        "status_codes": [
          200,
          400,
          401
        ],
        "body": {
          "access_token": "string",
          "refresh_token": "string",
          "expires_in": 3600
        }
      },
      "error_handling": {
        "invalid_credentials": "返回 401 Unauthorized"
      },
      "dependencies": {},
      "notes": "白名单路径，/auth/login, /auth/refresh, /auth/revoke",
      "version": 1,
      "change_history": []
    },
    {
      "id": "IF-004",
      "name": "Static File Serving",
      "type": "API",
      "description": "在生产模式下托管前端静态资源。",
      "method": "GET",
      "endpoint": "/* (excluding /api/**, /auth/**, /health)",
      "source_contract_id": "CTR-004",
      "request": {
        "headers": {},
        "query_params": {},
        "path_params": {},
        "body": null
      },
      "response": {
        "status_codes": [
          200,
          404
        ],
        "body": "静态文件内容，如HTML, CSS, JS"
      },
      "error_handling": {
        "file_not_found": "返回 404 Not Found"
      },
      "dependencies": {},
      "notes": "仅在生产模式(NODE_ENV=production)启用。",
      "version": 1,
      "change_history": []
    },
    {
      "id": "IF-005",
      "name": "Rate Limit Headers",
      "type": "internal",
      "description": "在超过速率限制时，返回标准的限流响应和头部信息。",
      "method": "ANY",
      "endpoint": "ALL (when rate limited)",
      "source_contract_id": "CTR-005",
      "request": {},
      "response": {
        "status_codes": [
          429
        ],
        "headers": {
          "X-RateLimit-Limit": "number",
          "X-RateLimit-Remaining": "number",
          "X-RateLimit-Reset": "number",
          "Retry-After": "number"
        },
        "body": {
          "error": "Too Many Requests"
        }
      },
      "error_handling": {},
      "dependencies": {},
      "notes": "由速率限制中间件触发。",
      "version": 1,
      "change_history": []
    }
  ],
  "route_table": {
    "description": "网关路由映射表，定义如何将请求代理到上游服务。",
    "routes": [
      {
        "id": "RT-001",
        "path_pattern": "/auth/**",
        "methods": [
          "POST",
          "GET"
        ],
        "upstream": "http://auth-service:8000",
        "auth_required": false,
        "roles": [],
        "rate_limit": "default_auth"
      },
      {
        "id": "RT-002",
        "path_pattern": "/api/projects/**",
        "methods": [
          "GET",
          "POST",
          "PUT",
          "DELETE"
        ],
        "upstream": "http://project-service:8000",
        "auth_required": true,
        "roles": [
          "admin",
          "user"
        ],
        "rate_limit": "project_endpoint"
      },
      {
        "id": "RT-003",
        "path_pattern": "/api/environments/**",
        "methods": [
          "GET",
          "POST",
          "PUT",
          "DELETE"
        ],
        "upstream": "http://environment-service:8000",
        "auth_required": true,
        "roles": [
          "admin",
          "user"
        ],
        "rate_limit": "env_endpoint"
      },
      {
        "id": "RT-004",
        "path_pattern": "/api/deployments/**",
        "methods": [
          "POST",
          "GET"
        ],
        "upstream": "http://deployment-service:8000",
        "auth_required": true,
        "roles": [
          "admin"
        ],
        "rate_limit": "deploy_endpoint"
      },
      {
        "id": "RT-005",
        "path_pattern": "/health",
        "methods": [
          "GET"
        ],
        "upstream": null,
        "auth_required": false,
        "roles": [],
        "rate_limit": "global"
      },
      {
        "id": "RT-006",
        "path_pattern": "/*",
        "methods": [
          "GET"
        ],
        "upstream": null,
        "auth_required": false,
        "roles": [],
        "rate_limit": "global"
      }
    ]
  },
  "middleware_chain": {
    "description": "请求经过的中间件执行顺序。",
    "middlewares": [
      {
        "name": "RequestLogger",
        "type": "global",
        "description": "记录每个请求的基本信息，如方法、路径、时间戳。",
        "enabled": true
      },
      {
        "name": "StaticFiles",
        "type": "conditional",
        "condition": "NODE_ENV === 'production'",
        "description": "在为生产环境时，提供静态文件服务",
        "enabled": true
      },
      {
        "name": "RateLimiter",
        "type": "per_route",
        "description": "根据路由表配置应用速率限制",
        "enabled": true
      },
      {
        "name": "AuthMiddleware",
        "type": "per_route",
        "description": "验证JWT令牌并检查角色授权",
        "enabled": true
      },
      {
        "name": "ProxyRouter",
        "type": "global",
        "description": "将请求代理到对应的上游服务或处理静态文件",
        "enabled": true
      },
      {
        "name": "ErrorHandler",
        "type": "global",
        "description": "捕获所有未处理的错误并返回统一格式响应",
        "enabled": true
      }
    ]
  },
  "auth_policy": {
    "provider": "JWT",
    "token_location": "Authorization header (Bearer scheme)",
    "white_list": [
      "/health",
      "/auth/**",
      "/*"
    ],
    "role_path_map": {
      "admin": [
        "/api/**"
      ],
      "user": [
        "/api/projects/**",
        "/api/environments/**"
      ]
    },
    "token_management": {
      "access_token_ttl": "3600",
      "refresh_token_ttl": "604800",
      "signing_algorithm": "RS256",
      "issuer": "cogniforge-gateway"
    }
  },
  "rate_limiting": {
    "strategy": "fixed_window",
    "layers": [
      {
        "name": "global",
        "window_ms": 60000,
        "max_requests": 1000,
        "enabled": true
      },
      {
        "name": "user_identifier",
        "per_user": true,
        "window_ms": 60000,
        "max_requests": 200,
        "enabled": true
      },
      {
        "name": "endpoint_specific",
        "rules": [
          {
            "path_pattern": "/api/deployments/**",
            "window_ms": 60000,
            "max_requests": 5,
            "enabled": true
          }
        ]
      }
    ],
    "headers": true,
    "message": "Too Many Requests"
  },
  "error_handling": {
    "strategy": "centralized",
    "error_response": {
      "format": "JSON",
      "include_stack": false,
      "standard_codes": {
        "400": "Bad Request",
        "401": "Unauthorized",
        "403": "Forbidden",
        "404": "Not Found",
        "429": "Too Many Requests",
        "500": "Internal Server Error",
        "502": "Bad Gateway",
        "503": "Service Unavailable",
        "504": "Gateway Timeout"
      }
    }
  }
}