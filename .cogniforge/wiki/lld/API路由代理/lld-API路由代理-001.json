    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "作为系统唯一的入口网关，基于Express构建",
      "将前端请求透明代理至后端FastAPI微服务集群",
      "实现JWT Bearer Token的签发、验证和角色授权",
      "提供全局、用户级和端点级三级速率限制",
      "托管前端静态资源（生产模式）",
      "提供健康检查接口",
      "实现请求日志记录和结构化输出",
      "处理上游服务的故障转移和超时"
    ],
    "out_of_scope": [
      "业务逻辑处理（由上游微服务负责）",
      "数据库ORM操作（通过代理转发）",
      "复杂的事件驱动架构（如消息总线）",
      "前端页面的动态渲染（由SPA自行处理）",
      "密钥的加密存储（仅作透明代理）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003",
      "DM-004"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "本模块是 CogniForge 系统的统一 API 网关，基于 Node.js 和 Express 构建。它充当了前端 SPA 与后端微服务集群之间的反向代理，核心职责是透明地路由 HTTP 请求，同时提供认证、授权、速率限制、日志记录和静态文件托管等横切关注点。所有前端发起的 API 调用都需经过此网关。",
    "dependencies": [
      "项目管理服务",
      "环境配置服务",
      "部署执行服务",
      "版本历史服务",
      "凭证加密存储服务"
    ],
    "tech_stack": [
      "Node.js + Express",
      "jsonwebtoken",
      "express-rate-limit",
      "winston"
    ]
  },
  "business_rules": {
    "invariants": [
      "所有请求必须经过认证和授权检查（除白名单路径外）",
      "速率限制必须全局、用户级和端点级三级应用",
      "代理转发必须保持请求的幂等性"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003",
          "DM-004"
        ],
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003",
          "IF-004",
          "IF-005"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "所有系统外部 API 访问均通过此网关实现，网关自身不产生业务数据，但完整覆盖了认证、路由、限流等横切需求。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "api_routes",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "核心路由配置表，定义了请求路径、HTTP 方法与目标上游服务的映射关系。这是网关执行动态路由决策的唯一依据。",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "path_pattern",
          "type": "string",
          "required": true,
          "description": "匹配的路径模式，如 /api/projects/**"
        },
        {
          "name": "upstream_host",
          "type": "string",
          "required": true,
          "description": "上游服务的主机地址，如 http://project-service:8000"
        },
        {
          "name": "methods",
          "type": "string",
          "required": true,
          "description": "支持的 HTTP 方法列表，以逗号分隔"
        },
        {
          "name": "auth_required",
          "type": "boolean",
          "required": true,
          "description": "是否需要认证"
        },
        {
          "name": "roles",
          "type": "string",
          "required": false,
          "description": "允许访问的角色列表，以逗号分隔。若为空则所有认证用户均可访问。"
        }
      ],
      "indexes": [
        {
          "name": "idx_path_method",
          "unique": true,
          "columns": [
            "path_pattern",
            "methods"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [
        "path_pattern 和 methods 必须联合唯一"
      ],
      "lifecycle": {
        "create": "系统初始化或管理员动态添加路由时创建",
        "update": "后端服务扩展或变更时更新",
        "delete": "服务下线时删除",
        "retention": "永久保存，与系统生命周期一致"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "auth_tokens",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "存储签发的刷新令牌信息，用于令牌生命周期管理与吊销检查。",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "user_id",
          "type": "string",
          "required": true,
          "description": "关联的用户 ID"
        },
        {
          "name": "refresh_token_hash",
          "type": "string",
          "required": true,
          "description": "刷新令牌的哈希值，用于安全存储"
        },
        {
          "name": "expires_at",
          "type": "datetime",
          "required": true,
          "description": "令牌过期时间"
        },
        {
          "name": "is_revoked",
          "type": "boolean",
          "required": true,
          "description": "令牌是否已被吊销"
        }
      ],
      "indexes": [],
