  "interfaces": [
    {
      "id": "IF-001",
      "name": "文件上传",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "POST",
      "endpoint": "/api/v1/files/upload",
      "description": "接收 Business Service 上传的部署包文件，保存到存储后端，返回文件元数据。",
      "parameters": [
        {
          "name": "project_id",
          "type": "string",
          "in": "query",
          "required": true,
          "description": "关联项目 ID"
        },
        {
          "name": "environment_id",
          "type": "string",
          "in": "query",
          "required": true,
          "description": "关联环境 ID"
        },
        {
          "name": "file",
          "type": "binary",
          "in": "body",
          "required": true,
          "description": "文件内容（multipart/form-data）"
        }
      ],
      "request_body": {
        "file": "binary"
      },
      "response": {
        "status": 200,
        "body": {
          "file_id": "string",
          "original_name": "string",
          "stored_path": "string",
          "size_bytes": "integer",
          "sha256_hash": "string",
          "uploaded_at": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "FILE_EMPTY",
          "message": "上传文件为空"
        },
        {
          "status": 400,
          "code": "FILE_TOO_LARGE",
          "message": "文件超过大小限制（500MB）"
        },
        {
          "status": 400,
          "code": "INVALID_FILE_TYPE",
          "message": "文件类型不允许，仅支持 .zip, .tar.gz, .tgz"
        },
        {
          "status": 500,
          "code": "STORAGE_WRITE_ERROR",
          "message": "存储后端写入失败"
        },
        {
          "status": 503,
          "code": "STORAGE_UNAVAILABLE",
          "message": "存储服务不可用"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-001"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
