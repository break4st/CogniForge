  "module_boundary": {
    "in_scope": [
      "文件的上传/存储操作",
      "文件的下载/读取操作",
      "文件元数据管理（文件名、大小、类型、上传时间、关联的项目/环境）",
      "文件清理策略（基于时间或版本的自动清理）",
      "存储后端的抽象（支持本地文件系统或 MinIO 对象存储）",
      "文件完整性校验（哈希校验）"
    ],
    "out_of_scope": [
      "用户权限鉴权（由 Auth Service 负责）",
      "部署包的业务逻辑验证（由 Business Service 负责）",
      "文件解压与部署执行（由 Deploy Engine 负责）",
      "文件上传的前端界面（由 Web App 负责）",
      "文件传输协议（SCP）的使用（由 Deploy Engine 负责）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "文件存储服务，负责接收并存储用户上传的部署包，为部署引擎提供文件读取能力，并支持文件清理策略。提供统一的存储后端抽象，可切换本地文件系统或 MinIO 对象存储。",
    "dependencies": [
      "Business Service",
      "Deploy Engine"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "MinIO (或本地文件系统)",
      "Docker + Docker Compose"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003"
        ],
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003",
          "IF-004"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "StorageConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "存储后端配置参数，支持本地文件系统或 MinIO 对象存储切换。",
      "fields": [
        {
          "name": "backend",
          "type": "string",
          "required": true,
          "description": "存储后端类型，取值 local 或 minio"
        },
        {
          "name": "local_path",
          "type": "string",
          "required": false,
          "description": "本地文件系统存储根路径，backend=local 时必填"
        },
        {
          "name": "minio_endpoint",
          "type": "string",
          "required": false,
          "description": "MinIO 服务端点，backend=minio 时必填"
        },
        {
          "name": "minio_access_key",
          "type": "string",
          "required": false,
          "description": "MinIO 访问密钥"
        },
        {
          "name": "minio_secret_key",
          "type": "string",
          "required": false,
          "description": "MinIO 密钥"
        },
        {
          "name": "minio_bucket",
          "type": "string",
          "required": false,
          "description": "MinIO 桶名称"
        },
        {
          "name": "minio_secure",
          "type": "boolean",
          "required": false,
          "description": "是否使用 HTTPS 连接 MinIO"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "首次部署时通过环境变量或配置文件注入",
        "update": "修改配置文件后重启服务生效",
        "delete": "服务下线时删除配置",
        "retention": "与部署生命周期一致"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "FileMeta",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "文件元数据结构，用于文件上传后返回及查询时使用。",
      "fields": [
        {
          "name": "file_id",
          "type": "string",
          "required": true,
          "description": "文件唯一标识（UUID）"
        },
        {
          "name": "original_name",
          "type": "string",
          "required": true,
          "description": "文件原始名称"
        },
        {
          "name": "stored_path",
          "type": "string",
          "required": true,
          "description": "存储路径（本地路径或 MinIO object key）"
        },
        {
          "name": "size_bytes",
          "type": "integer",
          "required": true,
          "description": "文件大小（字节）"
        },
        {
          "name": "content_type",
          "type": "string",
          "required": false,
          "description": "MIME 类型"
        },
        {
          "name": "sha256_hash",
          "type": "string",
          "required": true,
          "description": "文件的 SHA-256 哈希值"
