  "error_handling": {
    "strategy": "采用分层错误处理：接口层统一捕获异常并转换为标准 JSON 错误响应，存储层抛出明确的业务异常，由接口层映射为对应的 HTTP 状态码和错误码。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "CLIENT_ERROR",
        "description": "客户端请求错误（文件为空、类型无效、大小超限等），返回明确错误信息并记录请求日志"
      },
      {
        "code": "404",
        "name": "NOT_FOUND",
        "description": "请求的文件不存在，可能是 file_id 无效或文件已被清理"
      },
      {
        "code": "5xx",
        "name": "SERVER_ERROR",
        "description": "服务器内部错误（存储读写失败、哈希计算失败等），记录详细错误日志并向客户端返回通用错误信息"
      },
      {
        "code": "503",
        "name": "SERVICE_UNAVAILABLE",
        "description": "存储后端不可用（MinIO 连接失败、磁盘满等），触发告警并返回服务不可用"
      }
    ]
  },
  "topology": {
    "buckets": [
      {
        "name": "deploy-packages",
        "region": "us-east-1",
        "access": "private",
        "versioning": false
      }
    ],
    "path_conventions": "{project_id}/{environment_id}/{file_id}_{original_name}"
  },
  "connection_contracts": {
    "minio": {
      "endpoint": "${MINIO_ENDPOINT:minio:9000}",
      "access_key": "${MINIO_ACCESS_KEY}",
      "secret_key": "${MINIO_SECRET_KEY}",
      "secure": false,
      "pool_size": 10,
      "connect_timeout_seconds": 30,
      "read_timeout_seconds": 300,
      "write_timeout_seconds": 300
    },
    "local": {
      "root_path": "/data/deploy-packages/",
      "dir_permission": "0755",
      "file_permission": "0644"
    }
  }
}