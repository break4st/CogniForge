  "module_boundary": {
    "in_scope": [
      "HTTP 请求路由与反向代理",
      "请求/响应转换与透传",
      "JWT 令牌验证及用户信息注入请求头",
      "基于 IP 和用户粒度的多级限流",
      "WebSocket 代理（长连接转发）",
      "统一错误响应格式",
      "访问日志记录"
    ],
    "out_of_scope": [
      "用户身份认证的业务逻辑（由 Auth Service 实现）",
      "业务数据管理（由 Business Service 实现）",
      "部署任务执行与文件传输（由 Deploy Engine 实现）",
      "数据持久化（不直接操作 MySQL）",
      "前端页面渲染"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-001"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "系统统一入口，负责路由请求到后端服务，提供限流、认证预处理、WebSocket代理等功能。",
    "dependencies": [
      "Auth Service",
      "Business Service",
      "Deploy Engine",
      "Redis"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "Redis 7",
      "Docker + Docker Compose"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003"
        ],
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003",
          "IF-004",
          "IF-005",
          "IF-006",
          "IF-007",
          "IF-008",
          "IF-009"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "路由规则",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "source": {
        "prd_requirements": [
          "REQ-001"
        ],
        "sad_components": [
          "CMP-001"
        ],
        "sad_contracts": [
          "CTR-001"
        ]
      },
      "description": "定义一条 HTTP 路由的匹配模式、上游服务地址与关联角色。",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "唯一标识"
        },
        {
          "name": "path_pattern",
          "type": "string",
          "required": true,
          "description": "路径模式，支持 /** 通配"
        },
        {
          "name": "upstream_service",
          "type": "string",
          "required": true,
          "description": "上游服务名，如 auth-service"
        },
        {
          "name": "upstream_url",
          "type": "string",
          "required": true,
          "description": "实际转发地址，如 http://auth-service:8000"
        },
        {
          "name": "method",
          "type": "string",
          "required": true,
          "description": "HTTP 方法"
        },
        {
          "name": "is_public",
          "type": "boolean",
          "required": true,
          "description": "是否公开端点无需认证"
        },
        {
          "name": "required_roles",
          "type": "array[string]",
          "required": false,
          "description": "访问所需角色列表"
        },
        {
          "name": "rate_limit_rule_id",
          "type": "string",
          "required": false,
          "description": "关联的限流规则ID，可选"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "",
        "update": "",
        "delete": "",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "限流规则",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "source": {
        "prd_requirements": [],
        "sad_components": [
          "CMP-001"
        ],
        "sad_contracts": []
      },
      "description": "定义限流策略的配置参数。",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "唯一标识"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "规则名称"
        },
        {
          "name": "scope",
          "type": "string",
          "required": true,
          "description": "枚举: global|per_user|endpoint"
        },
        {
          "name": "limit",
          "type": "integer",
          "required": true,
          "description": "时间窗口内最大请求数"
        },
        {
          "name": "window_seconds",
          "type": "integer",
          "required": true,
          "description": "时间窗口长度，秒"
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "说明"
        }
      ],
      "indexes": [],
      "source_requirements": [],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "",
        "update": "",
        "delete": "",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "访问日志记录",
      "type": "log",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "source": {
        "prd_requirements": [],
        "sad_components": [
          "CMP-001"
        ],
        "sad_contracts": []
      },
      "description": "记录网关处理的每次请求的关键信息。",
      "fields": [
        {
          "name": "timestamp",
          "type": "datetime",
          "required": true,
          "description": "请求时间"
        },
        {
          "name": "method",
          "type": "string",
          "required": true,
          "description": "HTTP 方法"
        },
        {
          "name": "path",
          "type": "string",
          "required": true,
          "description": "请求路径"
        },
        {
          "name": "status_code",
          "type": "integer",
          "required": true,
          "description": "响应状态码"
        },
        {
          "name": "client_ip",
          "type": "string",
          "required": true,
          "description": "客户端 IP"
        },
        {
          "name": "user_id",
          "type": "string",
          "required": false,
          "description": "用户ID（如果已认证）"
        },
        {
          "name": "duration_ms",
          "type": "number",
          "required": true,
          "description": "处理耗时（毫秒）"
        },
        {
          "name": "error_message",
