        {"name": "name", "type": "string", "description": "环境名称"},
        {"name": "ssh_host", "type": "string", "description": "SSH 主机地址"},
        {"name": "ssh_port", "type": "integer", "description": "SSH 端口"},
        {"name": "ssh_user", "type": "string", "description": "SSH 用户名"},
        {"name": "key_id", "type": "string", "description": "关联的 SSH 密钥ID"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "项目不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Delete Environment",
      "method": "DELETE",
      "endpoint": "/api/environments/:id",
      "description": "删除部署环境，路由到 Environment Management Service。契约源自 Environment CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "id", "type": "string", "description": "环境ID"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "环境不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Update Environment",
      "method": "PUT",
      "endpoint": "/api/environments/:id",
      "description": "更新部署环境配置，路由到 Environment Management Service。契约源自 Environment CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "id", "type": "string", "description": "环境ID"},
        {"name": "name", "type": "string", "description": "环境名称"},
        {"name": "ssh_host", "type": "string", "description": "SSH 主机地址"},
        {"name": "ssh_port", "type": "integer", "description": "SSH 端口"},
        {"name": "ssh_user", "type": "string", "description": "SSH 用户名"},
        {"name": "key_id", "type": "string", "description": "关联的 SSH 密钥ID"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "环境不存在"},
        {"code": 502, "message": "后端服务不可达"}
