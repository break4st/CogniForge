    },
    {
      "name": "Trigger Deployment",
      "method": "POST",
      "endpoint": "/api/deployments",
      "description": "触发一键部署，路由到 Deployment Orchestrator。契约源自 Trigger Deployment API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "project_id", "type": "string", "description": "项目ID"},
        {"name": "environment_id", "type": "string", "description": "部署环境ID"},
        {"name": "version", "type": "string", "description": "部署版本号"},
        {"name": "file_path", "type": "string", "description": "可执行文件路径"}
      ],
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "string",
          "status": "string",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Get Deployment Status",
      "method": "GET",
      "endpoint": "/api/deployments/:id",
      "description": "查询部署任务执行状态和进度，路由到 Deployment Orchestrator。契约源自 Deployment Status API",
