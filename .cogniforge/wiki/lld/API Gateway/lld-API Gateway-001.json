{
  "meta": {
    "doc_id": "lld-API Gateway-001",
    "type": "lld",
    "module_type": "ModuleType.GATEWAY",
    "module": "API Gateway",
    "title": "LLD - API Gateway",
    "author": "design_agent",
    "created": "2026-05-21 10:33"
  },
  "overview": {
    "description": "系统统一API入口，基于FastAPI实现，负责请求路由分发、用户身份认证、接口权限校验、请求限流与防护。前端所有API请求经由API Gateway路由到下游服务，Gateway承担认证拦截与路由转发职责。认证令牌使用JWT签发，黑名单与限流计数器基于Redis实现。",
    "dependencies": [
      "Project Management Service",
      "Environment Management Service",
      "Deployment Orchestrator",
      "Key Management Service",
      "Audit Service",
      "File Storage"
    ],
    "tech_stack": ["Python", "FastAPI", "Redis"]
  },
  "data_models": [
    {
      "name": "auth_token",
      "type": "store",
      "ownership": "owned",
      "description": "用户认证令牌（JWT）。用户登录后签发，后续请求在Authorization头携带Bearer token。令牌中编码用户身份（user_id）与角色（role）。Redis缓存黑名单令牌用于登出失效，Redis设置过期时间与令牌自身exp一致。",
      "fields": [
        {"name": "token", "type": "string", "required": true, "description": "JWT令牌字符串"},
        {"name": "user_id", "type": "string", "required": true, "description": "用户唯一标识"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色：developer/ops/manager"},
        {"name": "expires_at", "type": "datetime", "required": true, "description": "令牌过期时间"}
      ]
    },
    {
      "name": "route_rule",
      "type": "config",
      "ownership": "owned",
      "description": "路由规则配置表。定义前端请求路径到下游目标服务的映射关系，同时配置该路由是否需要认证及允许访问的角色。Gateway启动时加载到内存。",
      "fields": [
        {"name": "route_id", "type": "string", "required": true, "description": "路由规则唯一标识"},
        {"name": "path_pattern", "type": "string", "required": true, "description": "匹配路径模式，如/api/projects/*"},
        {"name": "method", "type": "string", "required": true, "description": "HTTP方法(GET/POST/PUT/DELETE)或ANY"},
        {"name": "target_service", "type": "string", "required": true, "description": "下游目标服务名称"},
        {"name": "require_auth", "type": "boolean", "required": true, "description": "是否要求认证"},
        {"name": "allowed_roles", "type": "array[string]", "required": false, "description": "允许访问的角色列表，为空表示所有已认证用户均可访问"}
      ]
    },
    {
      "name": "rate_limit_rule",
      "type": "config",
      "ownership": "owned",
      "description": "限流规则配置。基于Redis计数器实现滑动窗口算法，支持按接口维度和用户维度分别限流。Gateway启动时加载到内存。",
      "fields": [
        {"name": "rule_id", "type": "string", "required": true, "description": "限流规则唯一标识"},
        {"name": "path_pattern", "type": "string", "required": true, "description": "匹配路径模式"},
        {"name": "method", "type": "string", "required": true, "description": "HTTP方法"},
        {"name": "limit", "type": "integer", "required": true, "description": "时间窗口内允许的最大请求数"},
        {"name": "window_seconds", "type": "integer", "required": true, "description": "时间窗口长度（秒）"},
        {"name": "scope", "type": "string", "required": true, "description": "限流维度：global（全局）或 per_user（按用户）"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "健康检查",
      "method": "GET",
      "endpoint": "/api/health",
      "description": "系统健康检查接口。返回网关本身状态及下游各服务的连通状态。routes_to: API Gateway自身处理",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "status": "string",
          "services": "object",
          "timestamp": "datetime"
        }
      },
      "error_codes": []
    },
    {
      "name": "用户登录",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "description": "用户登录认证。校验用户名密码，验证通过后签发JWT访问令牌。后续请求须在Authorization头部携带Bearer token。routes_to: API Gateway自身处理",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"}
      ],
      "response": {
        "status": 200,
        "body": {
          "token": "string",
