        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "pid", "type": "string", "description": "项目ID"},
        {"name": "page", "type": "integer", "description": "页码，从 1 开始"},
        {"name": "page_size", "type": "integer", "description": "每页条数"},
        {"name": "status", "type": "string", "description": "按部署状态过滤"}
      ],
      "response": {
        "status": 200,
        "body": {
          "total": "integer",
          "items": [
            {
              "deployment_id": "string",
              "version": "string",
              "environment_name": "string",
              "status": "string",
              "started_at": "datetime",
              "completed_at": "datetime",
              "triggered_by": "string"
            }
          ]
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "项目不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
