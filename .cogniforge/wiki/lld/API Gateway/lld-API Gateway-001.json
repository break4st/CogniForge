{
  "meta": {
    "doc_id": "lld-API Gateway-001",
    "type": "lld",
    "module": "API Gateway",
    "title": "LLD - API Gateway",
    "author": "design_agent",
    "created": "2026-05-20 17:05"
  },
  "overview": {
    "description": "系统统一入口网关，负责请求路由、身份认证、限流和日志记录",
    "dependencies": [
      "Project Management Service",
      "Environment Management Service",
      "Deployment Orchestrator",
      "Key Management Service",
      "Audit Service"
    ],
    "tech_stack": [
      "Go",
      "Gin / Go-Zero",
      "Redis 7+"
    ]
  },
  "data_models": [
    {
      "name": "UserAccount",
      "type": "config",
      "description": "用户账号配置，用于网关层身份认证",
      "fields": [
        {"name": "id", "type": "string", "required": true, "description": "用户唯一标识"},
        {"name": "username", "type": "string", "required": true, "description": "用户名"},
        {"name": "password_hash", "type": "string", "required": true, "description": "密码哈希值"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色：admin/operator/viewer"}
      ]
    },
    {
      "name": "AuthToken",
      "type": "store",
      "description": "JWT Token 载荷，存储在 Redis 中用于快速校验和黑名单管理",
      "fields": [
        {"name": "user_id", "type": "string", "required": true, "description": "用户ID"},
        {"name": "username", "type": "string", "required": true, "description": "用户名"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色"},
        {"name": "expires_at", "type": "datetime", "required": true, "description": "令牌过期时间"},
        {"name": "token_hash", "type": "string", "required": true, "description": "JWT Token 哈希值，用于黑名单校验"}
      ]
    },
    {
      "name": "RouteRule",
      "type": "config",
      "description": "路由规则配置，定义请求路径到后端服务的映射关系",
      "fields": [
        {"name": "path_pattern", "type": "string", "required": true, "description": "路径匹配模式，如 /api/projects/*"},
        {"name": "methods", "type": "[]string", "required": true, "description": "允许的 HTTP 方法列表"},
        {"name": "target_service", "type": "string", "required": true, "description": "目标服务名称"},
        {"name": "target_path", "type": "string", "required": true, "description": "目标服务路径模板"},
        {"name": "require_auth", "type": "boolean", "required": true, "description": "是否需要认证"},
        {"name": "rate_limit", "type": "integer", "required": false, "description": "每秒最大请求数，0 表示不限"}
      ]
    },
    {
      "name": "RateLimitRule",
      "type": "config",
      "description": "限流规则配置，支持基于用户和 IP 的请求限流",
      "fields": [
        {"name": "key", "type": "string", "required": true, "description": "限流键，格式为 user:{user_id} 或 ip:{client_ip}"},
        {"name": "max_requests", "type": "integer", "required": true, "description": "时间窗口内最大请求数"},
        {"name": "window_seconds", "type": "integer", "required": true, "description": "时间窗口大小（秒）"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "User Login",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "description": "用户登录，验证用户名密码并返回 JWT Token",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"}
      ],
      "response": {
        "status": 200,
        "body": {
          "token": "string",
          "expires_at": "datetime",
          "user": {
            "user_id": "string",
            "username": "string",
            "role": "string"
          }
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数缺失"},
        {"code": 401, "message": "用户名或密码错误"}
      ]
    },
    {
      "name": "Get Current User",
      "method": "GET",
      "endpoint": "/api/auth/me",
      "description": "获取当前登录用户信息",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"}
      ],
      "response": {
        "status": 200,
        "body": {
          "user_id": "string",
          "username": "string",
          "role": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "令牌无效或已过期"}
      ]
    },
    {
      "name": "Refresh Token",
      "method": "POST",
      "endpoint": "/api/auth/refresh",
      "description": "刷新 JWT Token，延长会话有效期",
      "parameters": [
        {"name": "token", "type": "string", "description": "当前有效的 JWT Token"}
      ],
      "response": {
        "status": 200,
        "body": {
          "token": "string",
          "expires_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数缺失"},
        {"code": 401, "message": "令牌无效或已过期"}
      ]
    },
    {
      "name": "Create Project",
      "method": "POST",
      "endpoint": "/api/projects",
      "description": "创建项目，路由到 Project Management Service。契约源自 Project CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "name", "type": "string", "description": "项目名称"},
        {"name": "description", "type": "string", "description": "项目描述"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Delete Project",
      "method": "DELETE",
      "endpoint": "/api/projects/:id",
      "description": "删除项目，路由到 Project Management Service。契约源自 Project CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "id", "type": "string", "description": "项目ID"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "项目不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Update Project",
      "method": "PUT",
      "endpoint": "/api/projects/:id",
      "description": "更新项目信息，路由到 Project Management Service。契约源自 Project CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "id", "type": "string", "description": "项目ID"},
        {"name": "name", "type": "string", "description": "项目名称"},
        {"name": "description", "type": "string", "description": "项目描述"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "项目不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "List Projects",
      "method": "GET",
      "endpoint": "/api/projects",
      "description": "获取项目列表，路由到 Project Management Service。契约源自 Project CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Get Project Detail",
      "method": "GET",
      "endpoint": "/api/projects/:id",
      "description": "获取项目详情，路由到 Project Management Service。契约源自 Project CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "id", "type": "string", "description": "项目ID"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "项目不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Create Environment",
      "method": "POST",
      "endpoint": "/api/projects/:pid/environments",
      "description": "为项目创建部署环境，路由到 Environment Management Service。契约源自 Environment CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
