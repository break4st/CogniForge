        {"code": 404, "message": "项目不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Test Environment Connection",
      "method": "POST",
      "endpoint": "/api/environments/:id/test",
      "description": "测试目标环境的 SSH 连接可用性，路由到 Environment Management Service。契约源自 Environment CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "id", "type": "string", "description": "环境ID"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "环境不存在"},
