        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
        {"name": "id", "type": "string", "description": "部署任务ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string",
          "status": "string",
          "progress": "integer",
          "started_at": "datetime",
          "completed_at": "datetime",
          "log_summary": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "部署任务不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "Deployment Log WebSocket",
      "method": "GET",
      "endpoint": "/ws/deployments/:id/logs",
      "description": "WebSocket 连接端点，实时推送部署执行日志。契约源自 Deployment Log WebSocket",
      "parameters": [
        {"name": "token", "type": "string", "description": "JWT Token，通过查询参数 ?token= 传递"},
        {"name": "id", "type": "string", "description": "部署任务ID"}
      ],
      "response": {
        "status": 101,
        "body": {}
      },
      "error_codes": [
        {"code": 401, "message": "认证失败"},
        {"code": 404, "message": "部署任务不存在"}
      ]
    },
    {
      "name": "Get Deployment History",
