  "error_handling": {
    "strategy": "API Gateway作为统一入口，采用中间件管道（Middleware Pipeline）模式对请求进行认证、限流、路由三层处理，每层失败即返回不转发下游。下游服务返回的错误码原样透传，同时统一注入trace_id便于链路追踪。网关自身接口（登录/登出/健康检查）的错误由网关直接处理。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "请求体校验失败、缺少必填字段、参数格式错误或枚举值不合法。Gateway在AuthMiddleware之后、路由转发之前进行基础参数格式校验，校验不通过直接返回400，不转发到下游服务。"
      },
      {
        "code": "401",
        "name": "未认证",
        "description": "请求未携带Authorization头、Token格式错误、Token已过期或Token已被加入黑名单（登出后）。Gateway在AuthMiddleware中统一拦截，不满足认证条件的请求直接拒绝，detail字段说明具体原因。"
      },
      {
        "code": "403",
        "name": "权限不足",
        "description": "用户已认证通过但当前角色（developer/ops/manager）不满足接口在route_rule中配置的allowed_roles要求。Gateway在AuthMiddleware中完成角色校验，不满足时直接返回403。"
      },
      {
        "code": "404",
        "name": "路由不存在",
        "description": "请求的HTTP方法+路径组合未匹配到任何route_rule。Gateway返回标准404响应，附带当前请求路径信息，避免无效请求到达下游服务。"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "下游服务返回的资源冲突错误（如创建项目时名称已存在、重复创建环境配置等）。Gateway原样透传409状态码及下游返回的error与detail信息。"
      },
      {
        "code": "413",
        "name": "请求体过大",
        "description": "上传文件或请求体超出Gateway配置的最大限制（默认100MB）。Gateway在请求体读取阶段直接拒绝并返回413，不转发到下游。响应头中的detail字段提示当前限制值。"
      },
      {
        "code": "429",
        "name": "请求限流",
        "description": "请求频率超过rate_limit_rule配置的限制。Gateway基于Redis自增计数器实现滑动窗口算法，超出阈值时返回429状态码，并在响应头中携带Retry-After字段（秒数）告知客户端何时可以重试。登录接口（/api/auth/login）有独立的严格限流规则，防止暴力破解。"
      },
      {
        "code": "502",
        "name": "下游服务不可达",
        "description": "Gateway转发请求到下游服务时发生连接拒绝、DNS解析失败或请求超时（默认5秒）。返回502状态码，记录完整错误日志及trace_id便于排查。不包含下游内部网络拓扑信息在响应体中。"
      },
      {
        "code": "504",
        "name": "下游服务响应超时",
        "description": "Gateway成功连接到下游服务但在超时时间（默认30秒）内未收到完整响应。返回504状态码，detail中注明超时时间，响应中携带trace_id。"
      },
      {
        "code": "500",
        "name": "网关内部错误",
        "description": "Gateway自身在请求处理过程中发生未捕获异常（如JSON解析失败、中间件执行异常等）。返回统一错误格式，记录完整异常堆栈到服务器日志并关联trace_id。"
      }
    ]
  }
}
