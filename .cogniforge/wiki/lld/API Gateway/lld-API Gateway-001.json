          "expires_in": "integer",
          "user": "object"
        }
      },
      "error_codes": [
        {"code": 401, "message": "用户名或密码错误"},
        {"code": 429, "message": "登录尝试过于频繁，请稍后再试"}
      ]
    },
    {
      "name": "用户登出",
      "method": "POST",
      "endpoint": "/api/auth/logout",
      "description": "用户登出。将当前JWT令牌加入Redis黑名单，后续请求携带该令牌将被拒绝认证。routes_to: API Gateway自身处理",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或令牌无效"}
      ]
    },
