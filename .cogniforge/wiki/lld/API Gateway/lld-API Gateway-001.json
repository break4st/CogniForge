{
  "meta": {
    "doc_id": "lld-API Gateway-001",
    "type": "lld",
    "module_type": "ModuleType.GATEWAY",
    "module": "API Gateway",
    "title": "LLD - API Gateway",
    "author": "design_agent",
    "created": "2026-05-21 09:43"
  },
  "overview": {
    "description": "统一API入口网关，基于FastAPI构建，负责请求路由、JWT认证鉴权、请求转发和限流。作为系统唯一外部接入点，所有前端请求必须经过API Gateway才能到达后端微服务。",
    "dependencies": [
      "Project Management Service",
      "Environment Management Service",
      "Key Management Service",
      "Deployment Orchestrator"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "JWT Token"
    ]
  },
  "data_models": [
    {
      "name": "JWTConfig",
      "type": "config",
      "ownership": "owned",
      "description": "JWT Token签发与验证配置，从环境变量加载",
      "fields": [
        {"name": "secret_key", "type": "string", "required": true, "description": "JWT签名密钥"},
        {"name": "algorithm", "type": "string", "required": true, "description": "签名算法，固定HS256"},
        {"name": "access_token_expire_minutes", "type": "integer", "required": true, "description": "访问令牌过期时间（分钟），默认30"}
      ]
    },
    {
      "name": "RateLimitRule",
      "type": "config",
      "ownership": "owned",
      "description": "接口速率限制规则配置",
      "fields": [
        {"name": "route_pattern", "type": "string", "required": true, "description": "匹配的路由模式，如 /api/projects"},
        {"name": "max_requests", "type": "integer", "required": true, "description": "时间窗口内最大请求数"},
        {"name": "window_seconds", "type": "integer", "required": true, "description": "时间窗口（秒）"}
      ]
    },
    {
      "name": "RouteRule",
      "type": "config",
      "ownership": "owned",
      "description": "路由转发规则，定义外部请求路径到下游微服务的映射关系",
      "fields": [
        {"name": "path_prefix", "type": "string", "required": true, "description": "请求路径前缀，如 /api/projects"},
        {"name": "target_service", "type": "string", "required": true, "description": "目标微服务名称"},
        {"name": "target_base_url", "type": "string", "required": true, "description": "目标微服务内部URL"},
        {"name": "requires_auth", "type": "boolean", "required": true, "description": "是否需要JWT认证"},
        {"name": "allowed_methods", "type": "array[string]", "required": true, "description": "允许转发的HTTP方法列表"}
      ]
    },
    {
      "name": "LoginRequest",
      "type": "struct",
      "ownership": "owned",
      "description": "用户登录请求体",
      "fields": [
        {"name": "username", "type": "string", "required": true, "description": "用户名"},
        {"name": "password", "type": "string", "required": true, "description": "密码"}
      ]
    },
    {
      "name": "LoginResponse",
      "type": "struct",
      "ownership": "owned",
      "description": "用户登录成功响应体，包含JWT令牌",
      "fields": [
        {"name": "access_token", "type": "string", "required": true, "description": "JWT访问令牌"},
        {"name": "token_type", "type": "string", "required": true, "description": "令牌类型，固定为bearer"},
        {"name": "expires_in", "type": "integer", "required": true, "description": "令牌过期时间（秒）"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "User Login",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "description": "用户登录，验证用户名密码后签发JWT Token。网关自身处理，不转发下游。",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string",
          "token_type": "string",
          "expires_in": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "用户名或密码错误"}
      ]
    },
    {
      "name": "Create Project",
      "method": "POST",
      "endpoint": "/api/projects",
      "description": "创建新项目。网关验证JWT Token后转发请求到Project Management Service。routes_to: Project Management Service",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer JWT令牌（HTTP Header）"},
        {"name": "name", "type": "string", "description": "项目名称，唯一"},
        {"name": "description", "type": "string", "description": "项目描述，可选"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "name": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 409, "message": "项目名已存在"},
        {"code": 429, "message": "请求频率超限"}
      ]
    },
    {
      "name": "List Projects",
      "method": "GET",
      "endpoint": "/api/projects",
      "description": "获取项目列表，支持分页。网关验证JWT Token后转发请求到Project Management Service。routes_to: Project Management Service",
      "parameters": [
        {"name": "page", "type": "integer", "description": "页码，默认1"},
        {"name": "page_size", "type": "integer", "description": "每页条数，默认20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array[object]",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 429, "message": "请求频率超限"}
      ]
    },
    {
      "name": "Create Environment",
      "method": "POST",
      "endpoint": "/api/projects/{project_id}/environments",
      "description": "为指定项目创建部署环境。网关验证JWT Token后转发请求到Environment Management Service。routes_to: Environment Management Service",
      "parameters": [
        {"name": "project_id", "type": "integer", "description": "项目ID（路径参数）"},
        {"name": "name", "type": "string", "description": "环境名称"},
        {"name": "type", "type": "enum", "description": "环境类型：test|gray|production"},
        {"name": "host", "type": "string", "description": "远程主机地址"},
        {"name": "port", "type": "integer", "description": "SSH端口，默认22"},
        {"name": "username", "type": "string", "description": "SSH用户名"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 404, "message": "项目不存在"},
        {"code": 409, "message": "环境名称已存在"},
        {"code": 429, "message": "请求频率超限"}
      ]
    },
    {
      "name": "Upload SSH Key",
      "method": "POST",
      "endpoint": "/api/environments/{env_id}/keys",
      "description": "为指定环境上传SSH密钥。网关验证JWT Token后转发请求到Key Management Service。routes_to: Key Management Service",
      "parameters": [
        {"name": "env_id", "type": "integer", "description": "环境ID（路径参数）"},
        {"name": "key_type", "type": "enum", "description": "密钥类型：rsa|ed25519"},
        {"name": "key_content", "type": "string", "description": "SSH私钥文本内容"},
        {"name": "passphrase", "type": "string", "description": "密钥口令，可选"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "env_id": "integer",
          "key_type": "string",
          "fingerprint": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 404, "message": "环境不存在"},
        {"code": 400, "message": "密钥格式无效"},
        {"code": 429, "message": "请求频率超限"}
      ]
    },
    {
      "name": "Test SSH Connection",
      "method": "POST",
      "endpoint": "/api/environments/{env_id}/keys/test",
      "description": "测试指定环境的SSH连接连通性。网关验证JWT Token后转发请求到Key Management Service。routes_to: Key Management Service",
      "parameters": [
        {"name": "env_id", "type": "integer", "description": "环境ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string",
          "latency_ms": "integer",
          "server_info": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 404, "message": "环境或密钥不存在"},
        {"code": 502, "message": "SSH连接失败"},
        {"code": 429, "message": "请求频率超限"}
      ]
    },
    {
      "name": "Trigger Deployment",
      "method": "POST",
      "endpoint": "/api/projects/{project_id}/deployments",
      "description": "触发一键部署任务。网关验证JWT Token后转发请求到Deployment Orchestrator。routes_to: Deployment Orchestrator",
      "parameters": [
        {"name": "project_id", "type": "integer", "description": "项目ID（路径参数）"},
        {"name": "environment_id", "type": "integer", "description": "目标环境ID"},
        {"name": "version", "type": "string", "description": "版本号，如 v1.2.3"},
        {"name": "artifact_path", "type": "string", "description": "可执行文件路径或下载URL"},
        {"name": "description", "type": "string", "description": "部署说明，可选"}
      ],
      "response": {
        "status": 201,
        "body": {
          "deployment_id": "integer",
          "status": "string",
          "version": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 404, "message": "项目或环境不存在"},
        {"code": 400, "message": "版本号格式无效"},
        {"code": 429, "message": "请求频率超限"}
      ]
    },
    {
      "name": "Get Deployment Status",
      "method": "GET",
      "endpoint": "/api/deployments/{deployment_id}",
      "description": "查询部署任务的详细状态和日志。网关验证JWT Token后转发请求到Deployment Orchestrator。routes_to: Deployment Orchestrator",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "environment_id": "integer",
          "version": "string",
          "status": "enum",
          "progress": "integer",
          "logs": "array[string]",
          "started_at": "datetime",
          "finished_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 404, "message": "部署任务不存在"},
        {"code": 429, "message": "请求频率超限"}
      ]
    },
    {
      "name": "Deployment WebSocket",
      "method": "WS",
      "endpoint": "/ws/deployments/{deployment_id}",
      "description": "建立WebSocket连接，实时接收部署进度和日志推送。网关验证JWT Token后代理WebSocket连接到Deployment Orchestrator。routes_to: Deployment Orchestrator",
      "parameters": [
        {"name": "deployment_id", "type": "integer", "description": "部署任务ID（路径参数）"},
        {"name": "token", "type": "string", "description": "JWT令牌（查询参数）"}
      ],
      "response": {
        "status": 101,
        "body": {}
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 404, "message": "部署任务不存在"}
      ]
    }
  ],
  "error_handling": "网关层统一错误处理。1）认证失败（401）：JWT Token缺失、无效或已过期，返回标准化JSON错误响应体{'code':401,'message':'...','request_id':'...'}。2）限流（429）：请求超出速率限制，返回Retry-After响应头指示重试等待秒数。3）上游服务错误（502）：下游微服务返回非预期响应或服务不可达时返回502。4）网关超时（504）：上游服务响应超时（默认30秒超时阈值）时返回504。5）全局异常兜底：所有未捕获异常统一返回500，响应体包含请求唯一ID以便链路追踪。6）CORS拒绝：跨域请求不满足CORS策略时返回403。"
}
