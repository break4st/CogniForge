    },
    {
      "name": "List Environments",
      "method": "GET",
      "endpoint": "/api/projects/:pid/environments",
      "description": "获取指定项目下的环境列表，路由到 Environment Management Service。契约源自 Environment CRUD API",
      "parameters": [
        {"name": "Authorization", "type": "string", "description": "Bearer {token}"},
