        {"name": "private_key", "type": "string", "description": "导入时提供的私钥内容"}
      ],
      "response": {
        "status": 200,
        "body": {}
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
