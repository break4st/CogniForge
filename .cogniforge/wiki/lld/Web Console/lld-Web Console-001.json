{
  "meta": {
    "doc_id": "lld-Web Console-001",
    "type": "lld",
    "module_type": "ModuleType.FRONTEND",
    "module": "Web Console",
    "title": "LLD - Web Console",
    "author": "design_agent",
    "created": "2026-05-21 10:31"
  },
  "overview": {
    "description": "用户交互界面，提供项目管理、环境管理、部署操作的可视化操作界面。基于 Vue 3 + Element Plus 实现前端 UI，Pinia 管理全局状态，Axios 发起 HTTP 请求通过 API Gateway 与后端服务通信。",
    "dependencies": [
      "API Gateway",
      "Project Management Service",
      "Environment Management Service",
      "Deployment Orchestrator",
      "Key Management Service",
      "Audit Service",
      "File Storage"
    ],
    "tech_stack": ["Vue 3", "Element Plus"]
  },
  "data_models": [
    {
      "name": "projectStore",
      "type": "store",
      "ownership": "owned",
      "description": "项目管理 Pinia store，维护项目列表与当前项目详情状态。actions: fetchProjects(params), fetchProject(id), createProject(data), deleteProject(id)",
      "fields": [
        {"name": "items", "type": "Project[]", "required": true, "description": "项目列表数据"},
        {"name": "current", "type": "Project | null", "required": false, "description": "当前查看的项目详情"},
        {"name": "total", "type": "number", "required": true, "description": "项目总数（分页）"},
        {"name": "page", "type": "number", "required": true, "description": "当前页码"},
        {"name": "pageSize", "type": "number", "required": true, "description": "每页条数"},
        {"name": "loading", "type": "boolean", "required": true, "description": "加载状态"},
        {"name": "searchKeyword", "type": "string", "required": false, "description": "搜索关键字"}
      ]
    },
    {
      "name": "environmentStore",
      "type": "store",
      "ownership": "owned",
      "description": "环境管理 Pinia store，维护当前项目下的环境列表与连接测试结果。actions: fetchEnvironments(projectId), createEnvironment(data), testConnection(id)",
      "fields": [
        {"name": "items", "type": "Environment[]", "required": true, "description": "环境列表数据"},
        {"name": "currentProjectId", "type": "string", "required": false, "description": "当前选中的项目ID"},
        {"name": "total", "type": "number", "required": true, "description": "环境总数"},
        {"name": "loading", "type": "boolean", "required": true, "description": "加载状态"},
        {"name": "testResult", "type": "ConnectionTestResult | null", "required": false, "description": "连接测试结果"}
      ]
    },
    {
      "name": "deploymentStore",
      "type": "store",
      "ownership": "owned",
      "description": "部署管理 Pinia store，维护部署记录列表与当前部署详情。actions: fetchDeployment(id), createDeployment(data)",
      "fields": [
        {"name": "current", "type": "Deployment | null", "required": false, "description": "当前查看的部署详情"},
        {"name": "loading", "type": "boolean", "required": true, "description": "加载状态"},
        {"name": "pollingInterval", "type": "number | null", "required": false, "description": "轮询定时器ID"}
      ]
    },
    {
      "name": "keyStore",
      "type": "store",
      "ownership": "owned",
      "description": "SSH密钥管理 Pinia store，维护密钥列表与导入状态。actions: fetchKeys(params), createKey(data)",
      "fields": [
        {"name": "items", "type": "Key[]", "required": true, "description": "密钥列表"},
        {"name": "total", "type": "number", "required": true, "description": "密钥总数"},
        {"name": "loading", "type": "boolean", "required": true, "description": "加载状态"}
      ]
    },
    {
      "name": "auditStore",
      "type": "store",
      "ownership": "owned",
      "description": "审计日志 Pinia store，维护审计日志查询结果与过滤条件。actions: fetchLogs(filters)",
      "fields": [
        {"name": "items", "type": "AuditLog[]", "required": true, "description": "审计日志条目"},
        {"name": "total", "type": "number", "required": true, "description": "日志总数"},
        {"name": "page", "type": "number", "required": true, "description": "当前页码"},
        {"name": "pageSize", "type": "number", "required": true, "description": "每页条数"},
        {"name": "filters", "type": "AuditFilter", "required": false, "description": "当前过滤条件"},
        {"name": "loading", "type": "boolean", "required": true, "description": "加载状态"}
      ]
    },
    {
      "name": "fileStore",
      "type": "store",
      "ownership": "owned",
      "description": "文件上传 Pinia store，维护文件上传状态与结果。actions: uploadFile(formData)",
      "fields": [
        {"name": "uploadResult", "type": "UploadResult | null", "required": false, "description": "上传结果"},
        {"name": "uploading", "type": "boolean", "required": true, "description": "上传中状态"},
        {"name": "uploadProgress", "type": "number", "required": false, "description": "上传进度百分比"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "项目列表页",
      "method": "frontend",
      "endpoint": "/projects",
      "description": "展示所有项目列表，支持分页与搜索。页面初始化时调用 Project API 获取项目列表，每项可点击进入详情。",
      "parameters": [
        {"name": "page", "type": "number", "description": "页码，默认1"},
        {"name": "pageSize", "type": "number", "description": "每页条数，默认20"},
        {"name": "search", "type": "string", "description": "搜索关键词（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "Project[]",
          "total": "number",
          "page": "number",
          "page_size": "number"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数错误"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "创建项目页",
      "method": "frontend",
      "endpoint": "/projects/new",
      "description": "创建新项目表单页面。提交表单后调用 Project API (POST /api/projects) 创建项目，创建成功后跳转至项目详情页。",
      "parameters": [
        {"name": "name", "type": "string", "description": "项目名称"},
        {"name": "description", "type": "string", "description": "项目描述"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "name": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "表单验证失败或参数错误"},
        {"code": 409, "message": "项目名称已存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "项目详情页",
      "method": "frontend",
      "endpoint": "/projects/:id",
      "description": "展示单个项目的详细信息及关联的环境列表。页面加载时调用 Project API (GET /api/projects/{id}) 获取项目详情，支持删除项目操作(DELETE /api/projects/{id})。",
      "parameters": [
        {"name": "id", "type": "string", "description": "项目ID（路由参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "name": "string",
          "description": "string",
          "environments": "array",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "项目不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "环境管理页",
      "method": "frontend",
      "endpoint": "/projects/:id/environments",
      "description": "展示指定项目下的所有部署环境列表。页面加载时调用 Environment API (GET /api/environments?project_id=:id) 获取环境列表。每项支持连接测试操作(POST /api/environments/{envId}/test-connection)。",
      "parameters": [
        {"name": "id", "type": "string", "description": "项目ID（路由参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array",
          "total": "integer"
        }
      },
      "error_codes": [
        {"code": 404, "message": "项目不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "创建环境页",
      "method": "frontend",
      "endpoint": "/projects/:id/environments/new",
      "description": "创建新部署环境表单页面。支持选择密码认证或密钥认证方式，密钥认证时可关联已导入的SSH密钥。提交后调用 Environment API (POST /api/environments) 创建环境配置。",
      "parameters": [
        {"name": "id", "type": "string", "description": "项目ID（路由参数）"},
        {"name": "name", "type": "string", "description": "环境名称"},
        {"name": "host", "type": "string", "description": "服务器地址"},
        {"name": "port", "type": "integer", "description": "SSH端口"},
        {"name": "username", "type": "string", "description": "登录用户名"},
        {"name": "auth_type", "type": "string", "description": "认证方式：密钥或密码"},
        {"name": "key_id", "type": "string", "description": "密钥ID（密钥认证时必填）"},
        {"name": "password", "type": "string", "description": "密码（密码认证时必填）"},
        {"name": "tags", "type": "array", "description": "环境标签（可选）"},
        {"name": "description", "type": "string", "description": "环境描述（可选）"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "name": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "auth_type": "string",
          "tags": "array",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "表单验证失败或参数错误"},
        {"code": 404, "message": "关联项目不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "发起部署页",
      "method": "frontend",
      "endpoint": "/deployments/new",
      "description": "一键部署操作页面。用户选择目标项目、部署环境和已上传的部署包文件，填写版本备注后提交。调用 Deployment API (POST /api/deployments) 发起部署请求，成功后跳转至部署详情页。",
      "parameters": [
        {"name": "project_id", "type": "string", "description": "目标项目ID"},
        {"name": "environment_id", "type": "string", "description": "目标环境ID"},
        {"name": "file_id", "type": "string", "description": "部署文件ID"},
        {"name": "version", "type": "string", "description": "版本号（可选，不填自动生成）"},
        {"name": "notes", "type": "string", "description": "部署备注（可选）"}
      ],
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "string",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数错误"},
        {"code": 404, "message": "项目/环境/文件不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "部署详情页",
      "method": "frontend",
      "endpoint": "/deployments/:id",
      "description": "展示单个部署的详细状态和执行日志。页面加载时调用 Deployment API (GET /api/deployments/{id}) 获取部署详情。部署进行中时启用轮询机制自动刷新状态和日志。",
      "parameters": [
        {"name": "id", "type": "string", "description": "部署ID（路由参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "project_id": "string",
          "environment_id": "string",
          "status": "string",
          "version": "string",
          "logs": "array",
          "started_at": "datetime",
          "completed_at": "datetime (optional)"
        }
      },
      "error_codes": [
        {"code": 404, "message": "部署记录不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "密钥管理页",
      "method": "frontend",
      "endpoint": "/keys",
      "description": "SSH密钥管理页面。展示已导入的密钥列表（名称、类型、指纹），支持导入新密钥操作。列表数据通过 Key Management API (GET /api/keys) 获取，导入密钥通过 (POST /api/keys) 提交。",
      "parameters": [
        {"name": "page", "type": "number", "description": "页码，默认1"},
        {"name": "pageSize", "type": "number", "description": "每页条数，默认20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array",
          "total": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "参数错误"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "审计日志页",
      "method": "frontend",
      "endpoint": "/audit-logs",
      "description": "审计日志查询页面。支持按项目、操作类型、操作人、时间范围等多维度过滤。数据通过 Audit API (GET /api/audit-logs) 获取，支持分页展示。",
      "parameters": [
        {"name": "project_id", "type": "string", "description": "按项目过滤（可选）"},
        {"name": "action_type", "type": "string", "description": "按操作类型过滤（可选）"},
        {"name": "operator", "type": "string", "description": "按操作人过滤（可选）"},
        {"name": "start_time", "type": "datetime", "description": "开始时间（可选）"},
        {"name": "end_time", "type": "datetime", "description": "结束时间（可选）"},
        {"name": "page", "type": "number", "description": "页码，默认1"},
        {"name": "pageSize", "type": "number", "description": "每页条数，默认20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "过滤参数错误"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "文件上传页",
      "method": "frontend",
      "endpoint": "/files/upload",
      "description": "部署包文件上传页面。用户选择文件并关联到目标项目，支持显示上传进度。上传通过 File Upload API (POST /api/files/upload multipart/form-data) 提交。",
      "parameters": [
        {"name": "project_id", "type": "string", "description": "关联项目ID"},
        {"name": "file", "type": "binary", "description": "部署包文件"},
        {"name": "notes", "type": "string", "description": "文件备注（可选）"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "file_name": "string",
          "file_size": "integer",
          "project_id": "string",
          "version": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "文件格式或大小不符合要求"},
        {"code": 404, "message": "关联项目不存在"},
        {"code": 413, "message": "文件大小超出限制"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "全局 Axios 拦截器捕获 HTTP 异常，统一转换为 Element Plus 通知（ElNotification/ElMessage）展示给用户。表单校验由 Element Plus Form 组件配合 rules 规则实现前端即时验证。网络超时和断网场景以独立告警提示，避免页面白屏。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "表单提交或接口参数校验失败。前端表单校验未通过的字段高亮提示具体错误信息，API 返回的业务校验错误通过 ElMessage.error 展示 detail 内容。"
      },
      {
        "code": "401",
        "name": "未认证",
        "description": "用户未登录或 Token 已过期。Axios 拦截器检测到 401 时自动清除用户状态并跳转至登录页。"
      },
      {
        "code": "403",
        "name": "无权限",
        "description": "当前用户无权限执行该操作。通过 ElNotification 展示"权限不足"提示，记录操作来源以便排查。"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "请求的项目、环境、部署记录或密钥不存在。页面展示空状态提示组件(ElEmpty)并给出返回列表的导航链接。"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "创建项目时名称已存在等冲突场景。表单对应字段标红并提示重名信息。"
      },
      {
        "code": "413",
        "name": "文件大小超限",
        "description": "上传的部署包文件超出服务端限制。上传前通过前端校验文件大小，超限时由 ElUpload 组件内置校验拦截并提示。"
      },
      {
        "code": "500",
        "name": "服务器内部错误",
        "description": "后端服务异常。全局 Axios 拦截器捕获后通过 ElNotification 展示"系统异常，请稍后重试"，并将错误详情输出到浏览器控制台便于调试。"
      },
      {
        "code": "NETWORK_ERROR",
        "name": "网络异常",
        "description": "请求超时或断网。Axios 拦截器检测到网络错误时展示"网络连接异常"提示，并提供重试按钮。部署详情页的轮询在连续 3 次失败后自动停止并提示用户手动刷新。"
      }
    ]
  }
}
