  "module_boundary": {
    "in_scope": [
      "项目列表的展示与交互（加载、排序、高亮当前项目）",
      "创建新项目（提供名称、描述，调用后端创建）",
      "编辑现有项目（修改名称、描述）",
      "删除项目（确认后移除）",
      "切换活动项目（更新全局会话及高亮状态）",
      "与主进程通过 IPC 进行项目数据的获取和操作"
    ],
    "out_of_scope": [
      "项目级别的环境配置管理",
      "部署或回滚操作",
      "项目成员与权限管理",
      "主密码设置与验证",
      "日志查看与分析"
    ],
