  "overview": {
    "description": "项目管理页面是用户进行项目创建、编辑、删除及切换的核心入口。页面以列表形式展示所有项目，支持高亮当前活动项目，并通过模态框完成增改操作。交互结果通过 Electron IPC 调用后端 ProjectService 实现。",
    "dependencies": [
      "ProjectService (CMP-101)",
      "全局状态管理（activeProjectId）"
    ],
    "tech_stack": [
      "React",
      "Ant Design",
      "Vite",
      "TypeScript"
    ]
  },
