  "module_boundary": {
    "in_scope": [
      "展示项目列表，支持模糊搜索",
      "创建新项目（名称、可选描述）",
      "删除项目（二次确认，解除环境绑定）",
      "为项目绑定/解绑环境",
      "切换当前活动项目（全局上下文）"
    ],
    "out_of_scope": [
      "环境本身的增删改查",
      "部署发起、进度、日志",
      "用户权限管理、登录鉴权",
      "项目详情中的高级配置（如成员、配额）"
    ],
    "owned_components": [
      "CMP-003"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-006",
      "CTR-007",
      "CTR-008",
      "CTR-009"
    ],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": [
      "DM-004"
    ]
  },
  "overview": {
    "description": "项目管理页面是用户进行项目全生命周期管理的中心入口，提供项目列表、搜索、创建、删除以及环境绑定/解绑功能，并控制全局当前活动项目。",
    "dependencies": [
      "环境管理模块（提供全局环境列表）",
      "项目管理服务（后端）"
    ],
    "tech_stack": [
      "React 18 + TypeScript",
      "Ant Design 5",
      "Zustand",
      "@tanstack/react-query",
      "Axios"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-003"
      ],
      "sad_contract_ids": [
        "CTR-006",
        "CTR-007",
        "CTR-008",
        "CTR-009"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003"
        ],
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003",
          "IF-004",
          "IF-005"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "所有项目管理相关需求已覆盖"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "ProjectItem",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "单个项目的数据结构",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "项目唯一标识"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "创建时间"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-007"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "创建项目时生成",
        "update": "项目名称和描述可更新（当前页面未实现更新，但数据模型预留）",
        "delete": "删除项目时移除",
        "retention": "无特殊保留策略"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "ProjectListState",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "项目列表页面的局部 UI 状态",
      "fields": [
        {
          "name": "projects",
          "type": "ProjectItem[]",
          "required": true,
          "description": "当前展示的项目列表"
        },
        {
          "name": "selectedProjectId",
          "type": "number | null",
          "required": false,
          "description": "当前选中的项目 ID（用于行操作高亮）"
        },
        {
          "name": "isSearching",
          "type": "boolean",
          "required": true,
          "description": "是否正在搜索（loading 状态）"
        },
        {
          "name": "searchKeyword",
          "type": "string",
          "required": true,
          "description": "当前搜索关键词"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-007"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "页面挂载时初始化",
        "update": "搜索或数据刷新时更新",
        "delete": "页面卸载时清除",
        "retention": "不保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "ActiveProjectState",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "全局当前活动项目的 Zustand store",
      "fields": [
        {
          "name": "activeProjectId",
          "type": "number | null",
          "required": false,
          "description": "当前活动项目 ID"
        },
        {
          "name": "activeProjectName",
          "type": "string | null",
          "required": false,
          "description": "当前活动项目名称"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-007"
      ],
      "constraints": [
        "需持久化至 localStorage，页面刷新后恢复"
      ],
      "lifecycle": {
        "create": "应用初始化时从 localStorage 加载",
        "update": "用户切换活动项目时更新",
        "delete": "不主动删除",
        "retention": "持久化存储"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "component_tree": {
    "ProjectManagementPage": {
      "component_id": "CMP-003",
      "description": "项目管理页面根组件，负责布局、状态管理、数据获取和路由",
      "children": [
        {
          "component_id": "SearchBar",
          "description": "搜索栏组件，输入关键词触发模糊搜索",
          "props": {
            "onSearch": "function(keyword: string): void",
            "loading": "boolean"
          }
        },
        {
          "component_id": "ProjectTable",
          "description": "项目列表表格，展示项目信息并提供操作按钮",
          "props": {
            "projects": "ProjectItem[]",
            "loading": "boolean",
            "onDelete": "function(id: number): void",
            "onBindEnv": "function(projectId: number): void",
            "onSetActive": "function(id: number): void",
            "activeProjectId": "number | null"
          }
        },
        {
          "component_id": "CreateProjectModal",
          "description": "创建项目的模态框，包含表单",
          "props": {
            "visible": "boolean",
            "onCreate": "function(values: {name: string, description?: string}): void",
            "onCancel": "function(): void",
            "loading": "boolean"
          }
        },
        {
          "component_id": "DeleteProjectConfirmModal",
          "description": "删除项目的确认模态框",
          "props": {
            "visible": "boolean",
            "projectName": "string",
            "onConfirm": "function(): void",
            "onCancel": "function(): void",
            "loading": "boolean"
          }
        }
      ]
    }
  },
  "state_design": {
    "stores": [
      {
        "id": "DM-002",
        "name": "ProjectListState",
        "type": "local",
        "scope": "page",
        "description": "管理项目列表页面的 UI 状态，包括项目列表、搜索和选中项",
        "initialState": {
          "projects": [],
          "selectedProjectId": null,
          "isSearching": false,
          "searchKeyword": ""
        },
        "actions": [
          {
            "name": "setProjects",
            "parameters": "ProjectItem[]",
            "description": "更新项目列表"
          },
          {
            "name": "setSearchKeyword",
            "parameters": "string",
            "description": "更新搜索关键词"
          },
          {
            "name": "setIsSearching",
            "parameters": "boolean",
            "description": "设置搜索加载状态"
          },
          {
            "name": "setSelectedProjectId",
            "parameters": "number | null",
            "description": "设置当前选中项目 ID"
          }
        ],
        "effects": [
          {
            "trigger": "searchKeyword change",
            "action": "debounced API call to fetch projects filtered by keyword",
            "debounce": 300
          }
        ]
      },
      {
        "id": "DM-003",
        "name": "ActiveProjectState",
        "type": "global",
        "scope": "app",
        "description": "全局活动项目状态，持久化到 localStorage",
        "initialState": {
          "activeProjectId": null,
          "activeProjectName": null
        },
        "actions": [
          {
            "name": "setActiveProject",
            "parameters": "{id: number, name: string}",
            "description": "设置当前活动项目"
          },
          {
            "name": "clearActiveProject",
            "parameters": "",
            "description": "清除活动项目"
          }
        ],
        "persistence": {
          "storage": "localStorage",
          "key": "activeProject"
        }
      }
    ]
  },
  "route_design": {
    "routes": [
      {
        "path": "/projects",
        "component": "ProjectManagementPage",
        "exact": true,
        "meta": {
          "title": "项目管理",
          "auth": false,
          "breadcrumb": ["首页", "项目管理"]
        }
      }
    ]
  },
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "搜索项目",
      "trigger": "用户在搜索框输入关键词",
      "steps": [
        "用户输入关键词",
        "前端 300ms 防抖后发起 GET /projects?keyword=xxx 请求",
        "后端返回匹配的项目列表",
        "ProjectListState 更新 projects 和 isSearching 状态",
        "ProjectTable 重新渲染列表"
      ],
      "error_handling": {
        "network_error": "显示错误提示'搜索失败，请重试'",
        "empty_result": "显示空状态提示'未找到匹配的项目'"
      }
    },
    {
      "id": "FLOW-002",
      "name": "创建项目",
      "trigger": "用户点击'新建项目'按钮并提交表单",
      "steps": [
        "用户点击'新建项目'按钮",
        "CreateProjectModal 显示",
        "用户填写项目名称（必填）和描述（选填）后点击确认",
        "前端发起 POST /projects 请求",
        "后端创建成功返回新项目数据",
        "前端关闭模态框，刷新项目列表，并显示成功提示"
      ],
      "error_handling": {
        "validation": "表单校验：名称为必填且长度 2-50",
        "network_error": "显示错误提示'创建失败，请重试'，模态框保持打开"
      }
    },
    {
      "id": "FLOW-003",
      "name": "删除项目",
      "trigger": "用户点击某项目的删除按钮",
      "steps": [
        "用户点击删除按钮",
        "DeleteProjectConfirmModal 显示，提示项目名称",
        "用户确认删除",
        "前端发起 DELETE /projects/:id 请求",
        "后端删除成功",
        "前端关闭模态框，刷新项目列表，如果删除的是活动项目则清除活动项目状态，显示成功提示"
      ],
      "error_handling": {
        "network_error": "显示错误提示'删除失败，请重试'"
      }
    },
    {
      "id": "FLOW-004",
      "name": "切换活动项目",
      "trigger": "用户点击某项目的'设为活动'按钮",
      "steps": [
        "用户点击'设为活动'按钮",
        "前端调用 ActiveProjectState.setActiveProject 更新全局状态和 localStorage",
        "页面顶部或其他组件响应状态变化，显示当前活动项目"
      ],
      "error_handling": {}
    }
  ],
  "api_integration": {
    "consumes": [
      {
        "contract_id": "CTR-007",
        "endpoint": "GET /projects",
        "method": "GET",
        "description": "获取项目列表，支持模糊搜索",
        "parameters": {
          "query": {
            "keyword": "string (optional)",
            "page": "number (optional)",
            "pageSize": "number (optional)"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "data": "ProjectItem[]",
            "total": "number"
          }
        },
        "error_responses": [
          {
            "status": 500,
            "message": "服务器错误"
          }
        ]
      },
      {
        "contract_id": "CTR-006",
        "endpoint": "POST /projects",
        "method": "POST",
        "description": "创建新项目",
        "request_body": {
          "type": "object",
          "properties": {
            "name": "string (required)",
            "description": "string"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "data": "ProjectItem"
          }
        },
        "error_responses": [
          {
            "status": 400,
            "message": "参数校验失败"
          },
          {
            "status": 500,
            "message": "服务器错误"
          }
        ]
      },
      {
        "contract_id": "CTR-008",
        "endpoint": "DELETE /projects/:id",
        "method": "DELETE",
        "description": "删除指定项目",
        "parameters": {
          "path": {
            "id": "number (required)"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "success": "boolean"
          }
        },
        "error_responses": [
          {
            "status": 404,
            "message": "项目不存在"
          },
          {
            "status": 500,
            "message": "服务器错误"
          }
        ]
      },
      {
        "contract_id": "CTR-009",
        "endpoint": "POST /projects/:id/bind-env",
        "method": "POST",
        "description": "为项目绑定环境",
        "parameters": {
          "path": {
            "id": "number (required)"
          },
          "body": {
            "envId": "number (required)"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "success": "boolean"
          }
        },
        "error_responses": [
          {
            "status": 404,
            "message": "项目或环境不存在"
          },
          {
            "status": 500,
            "message": "服务器错误"
          }
        ]
      }
    ]
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "ProjectListPage",
      "type": "component",
      "description": "项目管理页面组件",
      "method": "GET",
      "endpoint": "/projects",
      "props": {
        "projects": "ProjectItem[]",
        "loading": "boolean",
        "onDelete": "(id: number) => void",
        "onCreate": "() => void"
      },
      "state": {
        "searchKeyword": "string",
        "isSearching": "boolean"
      },
      "events": {
        "onSearch": "(keyword: string) => void",
        "onCreateClick": "() => void"
      }
    },
    {
      "id": "IF-002",
      "name": "ProjectTable",
      "type": "component",
      "description": "项目列表表格组件",
      "method": "GET",
      "endpoint": "/projects",
      "props": {
        "projects": "ProjectItem[]",
        "loading": "boolean",
        "onDelete": "(id: number) => void",
        "onBindEnv": "(id: number) => void",
        "onSetActive": "(id: number) => void",
        "activeProjectId": "number | null"
      },
      "state": {},
      "events": {}
    },
    {
      "id": "IF-003",
      "name": "SearchBar",
      "type": "component",
      "description": "搜索栏组件",
      "method": "GET",
      "endpoint": "/projects",
      "props": {
        "onSearch": "(keyword: string) => void",
        "loading": "boolean"
      },
      "state": {
        "keyword": "string"
      },
      "events": {}
    },
    {
      "id": "IF-004",
      "name": "CreateProjectModal",
      "type": "component",
      "description": "创建项目模态框",
      "method": "POST",
      "endpoint": "/projects",
      "props": {
        "visible": "boolean",
        "onCreate": "(values: {name: string, description?: string}) => void",
        "onCancel": "() => void",
        "loading": "boolean"
      },
      "state": {
        "formData": "{name: string, description?: string}"
      },
      "events": {
        "onSubmit": "() => void"
      }
    },
    {
      "id": "IF-005",
      "name": "DeleteProjectConfirmModal",
      "type": "component",
      "description": "删除项目确认模态框",
      "method": "DELETE",
      "endpoint": "/projects/:id",
      "props": {
        "visible": "boolean",
        "projectName": "string",
        "onConfirm": "() => void",
        "onCancel": "() => void",
        "loading": "boolean"
      },
      "state": {},
      "events": {}
    }
  ],
  "business_rules": {
    "validations": [
      {
        "rule_id": "BR-001",
        "description": "项目名称不能为空，长度 2-50 字符",
        "applies_to": "DM-001.name"
      },
      {
        "rule_id": "BR-002",
        "description": "删除项目前必须二次确认",
        "applies_to": "删除操作"
      },
      {
        "rule_id": "BR-003",
        "description": "活动项目全局唯一，切换时更新所有相关组件",
        "applies_to": "DM-003"
      }
    ],
    "error_handling": {
      "strategy": "统一错误处理，使用 antd message 或 notification 提示用户",
      "timeout": 60000,
      "retry": {
        "max_retries": 1,
        "backoff": "fixed"
      }
    }
  }
}