  "interaction_flows": [
    {
      "id": "FLW-001",
      "name": "加载项目列表",
      "description": "页面加载时通过 IPC 获取项目列表并渲染",
      "steps": [
        "页面加载/刷新",
        "更新 state 中的 projects 数组",
        "接收 projects 和 activeProjectId，渲染列表并高亮活动项"
      ]
    },
    {
      "id": "FLW-002",
      "name": "创建项目",
      "description": "用户点击创建按钮，填写表单并提交",
      "steps": [
        "用户点击“创建”按钮",
        "打开 ProjectModal",
        "用户填写表单并提交",
        "调用 IPC 方法 project:create，传入表单数据",
        "成功后关闭模态框，刷新列表"
      ]
    },
    {
      "id": "FLW-003",
      "name": "编辑项目",
      "description": "用户点击编辑按钮，修改项目信息并提交",
      "steps": [
        "用户点击某项目的“编辑”按钮",
        "打开 ProjectModal，预填选中项目数据",
        "用户修改表单并提交",
        "调用 IPC 方法 project:update，传入修改数据",
        "成功后关闭模态框，刷新列表"
      ]
    },
    {
      "id": "FLW-004",
      "name": "删除项目",
      "description": "用户点击删除按钮，确认后删除",
      "steps": [
        "用户点击某项目的“删除”按钮",
        "打开 DeleteConfirmModal",
        "用户确认删除",
        "调用 IPC 方法 project:delete，传入项目 ID",
        "成功后刷新列表，若删除的活动项目则清除全局活动项目状态"
      ]
    },
    {
      "id": "FLW-005",
      "name": "切换活动项目",
      "description": "用户点击项目项，切换全局活动项目",
      "steps": [
        "用户点击项目列表中的某一项",
        "更新全局状态 activeProjectId 为目标项目 ID",
        "高亮切换，通过 IPC 通知主进程更新活动项目"
      ]
    }
  ],
