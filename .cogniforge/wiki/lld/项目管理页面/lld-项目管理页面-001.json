      },
      {
        "id": "step-008",
        "name": "打开模态框并预填",
        "description": "打开模态框，预填表单",
        "next": "step-009"
      },
      {
        "id": "step-009",
        "name": "提交更新",
        "description": "修改后提交，调用IPC更新项目",
        "next": "step-010"
      },
      {
        "id": "step-010",
        "name": "更新成功",
        "description": "更新成功，关闭模态框，刷新列表",
        "next": "step-002"
      },
      {
        "id": "step-011",
        "name": "用户点击删除按钮",
