  "module_boundary": {
    "in_scope": [
      "项目的创建、更新、删除、查询",
      "为新建项目自动生成一个示例环境",
      "管理当前活跃项目上下文，供其他模块过滤使用",
      "项目名称同一用户下唯一性验证"
    ],
    "out_of_scope": [
      "环境的具体连接测试与凭据管理",
      "部署的执行、版本管理、SFTP上传",
      "用户认证与全局可用环境的管理"
    ],
    "owned_components": [
      "CMP-006"
    ],
    "owned_contracts": [
      "CTR-006"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "提供项目管理功能，包括CRUD接口和当前项目上下文维护，通过自动添加示例环境让用户快速上手。所有操作通过Electron IPC通道与渲染进程通信，数据持久化于SQLite数据库。",
    "dependencies": [
      "CMP-002 Main Router",
      "CMP-009 SQLite Database"
    ],
    "tech_stack": [
      "Node.js (Electron 主进程)",
      "better-sqlite3",
      "TypeScript",
      "Electron IPC"
    ]
  },
