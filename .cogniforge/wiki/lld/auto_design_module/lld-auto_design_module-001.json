  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ProjectService",
      "description": "项目管理服务契约",
      "interface_id": "IF-001",
      "methods": [
        {
          "name": "create",
          "description": "创建新项目，自动创建示例环境",
          "parameters": [
            {
              "name": "name",
              "type": "string"
            }
          ],
          "return_type": "Project"
        },
        {
          "name": "update",
          "description": "更新项目名称",
          "parameters": [
            {
              "name": "id",
              "type": "number"
            },
            {
              "name": "name",
              "type": "string"
            }
          ],
          "return_type": "Project"
        },
        {
          "name": "delete",
          "description": "删除项目及其关联环境",
          "parameters": [
            {
              "name": "id",
              "type": "number"
            }
          ],
          "return_type": "void"
        },
        {
          "name": "list",
          "description": "获取当前用户的所有项目",
          "parameters": [],
          "return_type": "Project[]"
        },
        {
          "name": "get",
          "description": "获取单个项目详情",
          "parameters": [
            {
              "name": "id",
              "type": "number"
            }
          ],
          "return_type": "Project"
        },
        {
          "name": "setActive",
          "description": "设置当前活跃项目",
          "parameters": [
            {
              "name": "id",
              "type": "number"
            }
          ],
          "return_type": "void"
        }
      ],
      "source_requirements": [
        "REQ-001",
        "REQ-002"
      ],
      "source_components": [
        "CMP-006"
      ],
      "source_contracts": [
        "CTR-006"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "项目名称唯一性",
      "rule": "同一 created_by 下项目名称必须唯一",
      "type": "invariant",
      "scope": "Project.create, Project.update",
      "enforcement": "数据库唯一约束 + 应用层检查"
    },
    {
      "id": "BR-002",
      "description": "活跃项目上下文",
      "rule": "系统维护一个当前活跃项目 ID，其他模块可以依赖此 ID 进行过滤",
      "type": "invariant",
      "scope": "Project.setActive",
      "enforcement": "应用层状态管理"
    },
    {
      "id": "BR-003",
      "description": "创建项目时自动创建示例环境",
      "rule": "每次创建项目时，系统自动创建一个示例环境，主机为 localhost，端口 22，用户名为当前系统用户名",
      "type": "action",
      "scope": "Project.create",
      "enforcement": "在 create 方法内实现"
    },
    {
      "id": "BR-004",
      "description": "级联删除环境",
      "rule": "删除项目时，必须同时删除其所有关联的环境",
      "type": "invariant",
      "scope": "Project.delete",
      "enforcement": "数据库外键级联删除或应用层处理"
    }
  ],
  "error_handling": {
    "strategy": "所有 IPC 处理函数统一捕获异常，返回标准格式 {success: false, error: string}。对于已知的业务错误，返回相应的 HTTP 状态码，如 409 Conflict 表示名称重复，404 Not Found 表示项目不存在。",
    "error_codes": [
      {
        "code": "PROJECT_NAME_DUPLICATE",
        "message": "项目名称已存在",
        "http_status": 409
      },
      {
        "code": "PROJECT_NOT_FOUND",
        "message": "项目未找到",
        "http_status": 404
      },
      {
        "code": "INVALID_PARAMETER",
        "message": "参数无效",
        "http_status": 400
      },
      {
