  "interfaces": [
    {
      "id": "IF-001",
      "name": "部署日志推送",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-008",
      "provider_component_id": "CMP-006",
      "method": "WS",
      "endpoint": "/deployments/{deployment_id}/log",
      "description": "前端通过 WebSocket 与服务建立长连接，订阅部署日志，服务端实时推送日志消息。",
      "parameters": [
        {
          "name": "deployment_id",
          "type": "string",
          "in": "path",
          "required": true,
          "description": "部署任务 ID，用于过滤日志"
        }
      ],
      "request_body": {},
      "response": {
        "status": 101,
        "body": {
          "message_type": "log",
          "content": "string",
          "timestamp": "datetime"
        },
        "description": "WebSocket 协议升级成功，后续帧携带 JSON 格式日志消息"
      },
      "errors": [],
      "source_requirements": [
        "REQ-003"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "WebSocketHandler",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-008",
      "description": "WebSocket 服务核心契约，定义连接生命周期和消息推送的标准方法。",
      "methods": [
        {
          "name": "connect",
          "description": "处理 WebSocket 连接建立请求，验证用户权限，注册连接，并启动 RabbitMQ 订阅。",
          "signature": "connect(deployment_id: string, user_id: string) -> WebSocket",
          "parameters": [
            {
              "name": "deployment_id",
              "type": "string",
              "required": true,
              "description": "路径中的部署 ID"
            },
            {
              "name": "user_id",
              "type": "string",
              "required": true,
              "description": "从请求头获取的用户 ID"
            }
          ],
          "returns": {
            "type": "WebSocket",
            "description": "建立的 WebSocket 连接对象"
          },
          "precondition": "用户已通过 API Gateway 认证，deployment_id 有效且用户有权限访问",
          "postcondition": "连接注册到 ConnectionManager，RabbitMQ 订阅该 deployment_id 的日志队列",
          "source_requirements": [
            "REQ-003",
            "REQ-005"
          ]
        },
        {
          "name": "disconnect",
          "description": "处理 WebSocket 连接断开，清理连接资源，取消 RabbitMQ 订阅。",
          "signature": "disconnect(connection: WebSocket) -> void",
          "parameters": [
            {
              "name": "connection",
              "type": "WebSocket",
              "required": true,
              "description": "要断开的 WebSocket 连接"
            }
          ],
          "returns": {
            "type": "void",
            "description": "无返回值"
          },
          "precondition": "连接在 ConnectionManager 中已存在",
          "postcondition": "连接从 ConnectionManager 移除，RabbitMQ 订阅取消",
          "source_requirements": [
            "REQ-003"
          ]
        },
        {
          "name": "push_log",
          "description": "向指定连接推送日志消息。",
          "signature": "push_log(connection: WebSocket, message: LogMessage) -> void",
          "parameters": [
            {
              "name": "connection",
              "type": "WebSocket",
              "required": true,
              "description": "目标 WebSocket 连接"
            },
            {
              "name": "message",
              "type": "LogMessage",
              "required": true,
              "description": "要推送的日志消息"
            }
          ],
          "returns": {
            "type": "void",
            "description": "无返回值"
          },
          "precondition": "连接处于打开状态",
          "postcondition": "消息以 JSON 格式通过 WebSocket 发送给客户端",
          "source_requirements": [
            "REQ-003"
          ]
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-006"
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "一个用户同时只能有一个 WebSocket 连接订阅同一部署日志。",
      "type": "invariant",
      "scope": "连接管理",
      "rule": "同一 user_id 和 deployment_id 组合在 ConnectionManager 中唯一",
      "source_requirements": [
        "REQ-005"
      ]
    }
  ],
  "error_handling": {
    "strategy": "全局异常捕获，分类返回标准错误码",
    "errors": [
      {
        "code": 4001,
        "name": "InvalidDeploymentID",
        "description": "deployment_id 格式无效或不存在",
        "handling": "连接建立阶段拒绝连接，返回 400 状态码并附带错误消息",
        "source_requirements": [
          "REQ-005"
        ]
      },
      {
        "code": 4003,
        "name": "Forbidden",
        "description": "用户无权访问该部署日志",
        "handling": "连接建立阶段拒绝连接，返回 403 状态码",
        "source_requirements": [
          "REQ-005"
        ]
      },
      {
        "code": 5001,
        "name": "RabbitMQConnectionError",
        "description": "无法连接到 RabbitMQ 或订阅失败",
        "handling": "连接建立阶段拒绝连接，返回 503 状态码；运行中推送失败则记录日志并尝试重连",
        "source_requirements": [
          "REQ-005"
        ]
      }
    ]
  }
}