  "module_boundary": {
    "in_scope": [
      "管理 WebSocket 长连接（建立、维持、断开）",
      "根据 deployment_id 订阅 RabbitMQ 中的部署日志消息",
      "将订阅到的日志消息实时推送给对应的 WebSocket 客户端",
      "处理连接时的简单授权（依赖网关传递的用户上下文）"
    ],
    "out_of_scope": [
      "生成部署日志（由部署执行服务负责）",
      "日志持久化存储（由关系型数据库或文件存储负责）",
      "用户认证与 token 签发（由 API Gateway 处理）",
      "部署任务调度与状态管理"
    ],
    "owned_components": [
      "CMP-006"
    ],
    "owned_contracts": [
      "CTR-008"
    ],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "WebSocket 服务作为系统中实时日志推送的枢纽，通过 FastAPI 建立 WebSocket 终端，并作为 RabbitMQ 消费者订阅特定 deployment_id 的日志消息。当部署执行服务在远程执行命令时产生的日志发送到 RabbitMQ，本服务接收后立即转发给已建立连接的前端客户端，实现用户实时查看部署过程的效果。",
    "dependencies": [
      "RabbitMQ",
      "API Gateway",
      "部署执行服务（约定消息格式）"
    ],
    "tech_stack": [
      "Python",
      "FastAPI",
      "aio-pika",
      "Docker"
    ]
  },
