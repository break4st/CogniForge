{
  "meta": {
    "doc_id": "LLD-LoggerService-001",
    "type": "lld",
    "module_type": "service",
    "module": "LoggerService",
    "title": "LoggerService 详细设计文档",
    "author": "design_agent",
    "created": "2025-03-17T00:00:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-003"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": [
        "CMP-107"
      ],
      "contracts": [
        "CTR-006"
      ],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "接收部署流程中产生的日志内容，并附上时间戳、级别等元数据",
      "以事件流形式通过 Electron IPC 向指定频道（deployment:log）推送日志条目",
      "将日志持久化到 SQLite 数据库，供历史查询",
      "管理日志推送的生命周期（开始、进行中、结束）"
    ],
    "out_of_scope": [
      "日志的展示与解析（属于前端部署页面）",
      "部署流程本身的执行（属于 DeploymentService）",
      "数据库表的物理创建与迁移（属于 DatabaseService）"
    ],
    "owned_components": [
      "CMP-107"
    ],
    "owned_contracts": [
      "CTR-006"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "生成并推送部署实时日志到渲染进程，支持日志持久化。作为 Electron 主进程服务，接收 DeploymentService 传来的日志，通过 IPC 推送到前端，并写入数据库。",
    "dependencies": [
      "DatabaseService"
    ],
    "tech_stack": [
      "TypeScript",
      "Electron IPC",
      "better-sqlite3"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": [
        "CMP-107"
      ],
      "sad_contract_ids": [
        "CTR-006"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001"
        ],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [
          "DO-001",
          "DO-002",
          "DO-003"
        ],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": "LoggerService 实现了 REQ-003 要求的实时日志推送与持久化能力"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "deployment_logs",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployment_logs"
      },
      "description": "部署日志持久化表，由 Primary Database 模块定义，LoggerService 通过 DatabaseService 访问",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "deployment_id",
          "type": "TEXT",
          "required": true,
          "description": "关联的部署记录 ID（外键）"
        },
        {
          "name": "timestamp",
          "type": "TEXT",
          "required": true,
          "description": "日志生成时间，ISO 8601 格式"
        },
        {
          "name": "level",
          "type": "TEXT",
          "required": true,
          "description": "日志级别：INFO, WARN, ERROR, SUCCESS"
        },
        {
          "name": "message",
          "type": "TEXT",
          "required": true,
          "description": "日志消息正文"
        },
        {
          "name": "metadata",
          "type": "TEXT",
          "required": false,
          "description": "附加结构化信息（JSON 字符串）"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "required": true,
          "description": "记录创建时间，ISO 8601 格式"
        }
      ],
      "indexes": [
        {
          "name": "idx_deployment_logs_deployment",
          "unique": false,
          "columns": [
            "deployment_id"
          ]
        },
        {
          "name": "idx_deployment_logs_timestamp",
          "unique": false,
          "columns": [
            "timestamp"
          ]
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "constraints": [
        "deployment_id 必须有值",
        "level 必须是 'INFO'、'WARN'、'ERROR'、'SUCCESS' 之一"
      ],
      "lifecycle": {
        "create": "当部署产生日志时插入",
        "update": "通常不更新",
        "delete": "在部署记录被删除时级联删除（由 DatabaseService 管理）",
        "retention": "长期保留，用于历史查询"
      }
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "deployment.logStream",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-006",
      "provider_component_id": "CMP-107",
      "method": "SSE",
      "endpoint": "IPC: deployment:log",
      "description": "实时推送部署日志，部署结束后发送完成事件。前端通过 Electron IPC 监听 deployment:log 频道接收。",
      "parameters": [
        {
          "name": "deploymentId",
          "type": "string",
          "in": "query",
          "required": true,
          "description": "需要监听日志的部署 ID，作为 IPC 附加参数传递"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "type": "event-stream",
          "data": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_PARAMS",
          "message": "deploymentId 不能为空或无效"
        },
        {
          "status": 409,
          "code": "DUPLICATE_STREAM",
          "message": "该部署已存在活跃日志流"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "deploymentId 必须为非空字符串"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-003"
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "LogEntry",
      "description": "可持久化日志条目值对象",
      "object_type": "entity",
      "attributes": [
        {
          "name": "timestamp",
          "type": "string",
          "required": true,
          "description": "ISO 8601 格式时间戳",
          "source": "input"
        },
        {
          "name": "level",
          "type": "string",
          "required": true,
          "description": "日志级别",
          "source": "input"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "description": "日志消息正文",
          "source": "input"
        },
        {
          "name": "metadata",
          "type": "object",
          "required": false,
          "description": "附加元数据",
          "source": "input"
        },
        {
          "name": "deploymentId",
          "type": "string",
          "required": true,
          "description": "关联的部署 ID",
          "source": "input"
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "LogStreamSession",
      "description": "管理单个部署的日志推送会话",
      "object_type": "entity",
      "attributes": [
        {
          "name": "deploymentId",
          "type": "string",
          "required": true,
          "description": "部署 ID",
          "source": "input"
        },
        {
          "name": "startedAt",
          "type": "string",
          "required": true,
          "description": "会话开始时间",
          "source": "computed"
        },
        {
          "name": "endedAt",
          "type": "string",
          "required": false,
          "description": "会话结束时间",
          "source": "computed"
        }
      ]
    },
    {
      "id": "DO-003",
      "name": "LogPersistencePayload",
      "description": "持久化日志所需数据",
      "object_type": "value_object",
      "attributes": [
        {
          "name": "deploymentId",
          "type": "string",
          "required": true,
          "description": "部署 ID",
          "source": "input"
        },
        {
          "name": "logEntry",
          "type": "LogEntry",
          "required": true,
          "description": "日志条目",
          "source": "input"
        },
        {
          "name": "persistedAt",
          "type": "string",
          "required": true,
          "description": "持久化时间",
          "source": "computed"
        }
      ]
    }
  ],
  "error_handling": [
    {
      "error_code": "INVALID_PARAMS",
      "message": "deploymentId 不能为空或无效",
      "http_status": 400
    },
    {
      "error_code": "DUPLICATE_STREAM",
      "message": "该部署已存在活跃日志流",
      "http_status": 409
    },
    {
      "error_code": "PERSISTENCE_FAILURE",
      "message": "日志持久化失败，数据库写入错误",
      "http_status": 500
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "每个部署同一时间只能有一个活跃的日志流会话",
      "expression": "LogStreamSession.deploymentId 唯一且状态为 active",
      "type": "invariant"
    },
    {
      "id": "BR-002",
      "description": "所有日志条目必须携带有效的级别（INFO, WARN, ERROR, SUCCESS）",
      "expression": "LogEntry.level in {'INFO','WARN','ERROR','SUCCESS'}",
      "type": "validation"
    },
    {
      "id": "BR-003",
      "description": "日志必须先推送再持久化，确保实时性",
      "expression": "pushLog 中 push 先于 save",
      "type": "process"
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "LoggerService",
      "interface_id": "IF-001",
      "methods": [
        {
          "name": "startLogStream",
          "signature": "startLogStream(deploymentId: string): void",
          "precondition": "deploymentId 非空且无活跃流",
          "postcondition": "新 LogStreamSession 创建并开始推送",
          "description": "开始指定部署的日志流",
          "errors": [
            "INVALID_PARAMS",
            "DUPLICATE_STREAM"
          ],
          "parameters": [
            {
              "name": "deploymentId",
              "type": "string",
              "required": true,
              "description": "部署 ID"
            }
          ],
          "return_type": {
            "type": "void"
          }
        },
        {
          "name": "pushLog",
          "signature": "pushLog(deploymentId: string, level: string, message: string, metadata?: object): void",
          "precondition": "对应 deploymentId 的日志流已启动",
          "postcondition": "日志条目推送至 IPC 并持久化",
          "description": "推送一条部署日志",
          "errors": [
            "INVALID_PARAMS",
            "PERSISTENCE_FAILURE"
          ],
          "parameters": [
            {
              "name": "deploymentId",
              "type": "string",
              "required": true,
              "description": "部署 ID"
            },
            {
              "name": "level",
              "type": "string",
              "required": true,
              "description": "日志级别"
            },
            {
              "name": "message",
              "type": "string",
              "required": true,
              "description": "日志消息"
            },
            {
              "name": "metadata",
              "type": "object",
              "required": false,
              "description": "附加元数据"
            }
          ],
          "return_type": {
            "type": "void"
          }
        },
        {
          "name": "endLogStream",
          "signature": "endLogStream(deploymentId: string): void",
          "precondition": "对应 deploymentId 的日志流已启动且未结束",
          "postcondition": "日志流结束，会话记录更新",
          "description": "结束指定部署的日志流",
          "errors": [
            "INVALID_PARAMS"
          ],
          "parameters": [
            {
              "name": "deploymentId",
              "type": "string",
              "required": true,
              "description": "部署 ID"
            }
          ],
          "return_type": {
            "type": "void"
          }
        }
      ]
    }
  ],
  "workflow": {
    "name": "LogStreamLifecycle",
    "steps": [
      {
        "id": "step-1",
        "name": "开始日志流",
        "description": "调用 startLogStream，校验并创建 LogStreamSession，通知前端流开始",
        "trigger": "DeploymentService 触发"
      },
      {
        "id": "step-2",
        "name": "推送日志",
        "description": "循环调用 pushLog，创建 LogEntry，通过 IPC 推送，然后持久化",
        "trigger": "DeploymentService 调用"
      },
      {
        "id": "step-3",
        "name": "结束日志流",
        "description": "调用 endLogStream，发送完成事件，更新会话结束时间",
        "trigger": "DeploymentService 通知部署完成"
      }
    ]
  }
}