  "interfaces": [
    {
      "id": "IF-001",
      "name": "创建环境",
      "type": "REST",
      "endpoint": "/api/projects/{project_id}/environments",
      "method": "POST",
      "request": {
        "body": {
          "type": "object",
          "schema_ref": "DO-004",
          "description": "环境创建请求数据"
        }
      },
      "response": {
        "body": {
          "type": "object",
          "schema_ref": "DO-001",
          "description": "创建成功的环境实体"
        }
      },
      "errors": [
        {
          "code": "400",
          "description": "请求参数无效"
        },
        {
          "code": "409",
          "description": "环境名称已存在"
        }
      ],
      "security": {
        "authentication": "Bearer Token",
        "authorization": "需要项目写权限"
      }
    },
    {
      "id": "IF-002",
      "name": "查询环境列表",
      "type": "REST",
      "endpoint": "/api/projects/{project_id}/environments",
      "method": "GET",
      "request": {
        "query": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "description": "页码"
            },
            "size": {
              "type": "integer",
              "description": "每页大小"
            }
          }
        }
      },
      "response": {
        "body": {
          "type": "array",
          "items": {
            "schema_ref": "DO-001"
          },
          "description": "环境列表，可能分页"
        }
      },
      "errors": [],
      "security": {
        "authentication": "Bearer Token",
        "authorization": "需要项目读权限"
      }
    },
    {
      "id": "IF-003",
      "name": "查询单个环境",
      "type": "REST",
      "endpoint": "/api/environments/{env_id}",
      "method": "GET",
      "request": {
        "path": {
          "type": "object",
          "properties": {
            "env_id": {
              "type": "string",
              "format": "uuid",
              "description": "环境ID"
            }
          }
        }
      },
      "response": {
        "body": {
          "type": "object",
          "schema_ref": "DO-001",
          "description": "环境详情"
        }
      },
      "errors": [
        {
          "code": "404",
          "description": "环境不存在"
        }
      ],
      "security": {
        "authentication": "Bearer Token",
        "authorization": "需要项目读权限"
      }
    },
    {
      "id": "IF-004",
      "name": "更新环境",
      "type": "REST",
      "endpoint": "/api/environments/{env_id}",
      "method": "PATCH",
      "request": {
        "path": {
          "type": "object",
          "properties": {
            "env_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "body": {
          "type": "object",
          "schema_ref": "DO-005",
          "description": "需更新的字段"
        }
      },
      "response": {
        "body": {
          "type": "object",
          "schema_ref": "DO-001",
          "description": "更新后的环境"
        }
      },
      "errors": [
        {
          "code": "400",
          "description": "参数无效"
        },
        {
          "code": "404",
          "description": "环境不存在"
        },
        {
          "code": "409",
          "description": "名称冲突"
        }
      ],
      "security": {
        "authentication": "Bearer Token",
        "authorization": "需要项目写权限"
      }
    },
    {
      "id": "IF-005",
      "name": "删除环境",
      "type": "REST",
      "endpoint": "/api/environments/{env_id}",
