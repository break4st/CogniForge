  "domain_objects": [
    {
      "id": "DO-001",
      "name": "环境实体",
      "object_type": "entity",
      "description": "代表一个部署环境的核心实体，包含连接目标、认证方式、部署路径等配置。",
      "attributes": [
        {
          "name": "id",
          "type": "UUID",
          "description": "唯一标识",
          "constraints": [
            "主键",
            "自动生成"
          ],
          "required": true
        },
        {
          "name": "project_id",
          "type": "UUID",
          "description": "所属项目ID",
          "constraints": [
            "外键引用 Project.id"
          ],
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "description": "环境名称",
          "constraints": [
            "项目内唯一"
          ],
          "required": true
        },
        {
          "name": "host",
          "type": "string",
          "description": "目标主机IP或域名",
          "constraints": [],
          "required": true
        },
        {
          "name": "port",
          "type": "integer",
          "description": "SSH端口",
          "constraints": [
            "1-65535"
          ],
          "required": true
        },
        {
          "name": "auth_type",
          "type": "enum",
          "description": "认证方式",
          "constraints": [
            "取值: password, private_key"
          ],
          "required": true
        },
        {
          "name": "private_key_encrypted",
          "type": "string",
          "description": "加密后的私钥，auth_type为private_key时必填",
          "constraints": [],
          "required": false
        },
        {
          "name": "deploy_root_path",
          "type": "string",
          "description": "部署根目录",
          "constraints": [],
          "required": true
        },
        {
          "name": "max_releases",
          "type": "integer",
          "description": "最大保留版本数",
          "constraints": [
            ">0"
          ],
          "required": true
        },
        {
          "name": "post_deploy_script",
          "type": "string",
          "description": "部署后执行的脚本命令",
          "constraints": [],
          "required": false
        },
        {
          "name": "created_at",
          "type": "datetime",
          "description": "创建时间",
          "constraints": [
            "自动设置为当前时间"
          ],
          "required": true
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "description": "最后更新时间",
          "constraints": [
            "每次修改时自动更新"
          ],
          "required": true
        }
      ],
      "invariants": [
        "auth_type 必须为 'password' 或 'private_key'",
        "若 auth_type='private_key'，private_key_encrypted 不能为空",
        "max_releases >= 1",
        "项目内 name 唯一"
      ],
      "relationships": [
        {
          "target": "DO-002",
          "type": "belongs_to",
          "description": "环境属于一个项目"
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "项目实体（引用）",
      "object_type": "reference",
      "description": "引用项目管理域的 Project 实体，环境必须关联一个项目。",
      "attributes": [
        {
          "name": "project_id",
          "type": "UUID",
          "description": "项目标识",
          "constraints": [],
          "required": true
        }
      ],
      "invariants": [],
      "relationships": []
    },
