  "overview": {
    "description": "管理项目下的部署环境配置，提供环境的增删改查及克隆，并触发基于SSH的连接可达性测试。依赖凭证加密存储服务处理私钥的加解密，通过SSH/SFTP连接管理器执行实际连接检测。",
    "dependencies": [
      "凭证加密存储服务",
      "SSH/SFTP连接管理器"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "SQLAlchemy",
      "paramiko(间接)",
      "cryptography(间接)"
    ]
  },
