            }
          }
        }
      },
      "response": {
        "body": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "description": "删除结果"
            }
          }
        }
      },
      "errors": [
        {
          "code": "404",
          "description": "环境不存在"
        }
      ],
      "security": {
        "authentication": "Bearer Token",
        "authorization": "需要项目写权限"
      }
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "EnvironmentService",
      "methods": [
        {
          "name": "create_environment",
          "input": "DO-004",
          "output": "DO-001",
          "description": "创建一个新环境，处理私钥加密存储，校验名称唯一。"
        },
        {
          "name": "list_environments",
          "input": "project_id: UUID, page: int, size: int",
          "output": "List[DO-001]",
          "description": "分页查询项目下的环境列表。"
        },
        {
          "name": "get_environment",
          "input": "env_id: UUID",
          "output": "DO-001",
          "description": "获取单个环境详情。"
        },
        {
          "name": "update_environment",
          "input": "env_id: UUID, DO-005",
          "output": "DO-001",
          "description": "部分更新环境信息，若修改认证相关字段需重新加密私钥。"
        },
        {
          "name": "delete_environment",
          "input": "env_id: UUID",
          "output": "void",
          "description": "删除环境记录。"
        },
        {
          "name": "test_connection",
          "input": "env_id: UUID",
          "output": "DO-006",
          "description": "使用环境配置发起SSH连接测试。"
        },
        {
          "name": "clone_environment",
          "input": "DO-007",
          "output": "DO-001",
          "description": "基于源环境克隆一个新的环境。"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "rule_id": "BR-001",
      "description": "环境名称在所属项目内必须唯一",
      "invariants": [
        "DO-001.name 在同一个 project_id 下唯一"
      ]
    },
    {
      "rule_id": "BR-002",
      "description": "私钥在存储前必须加密",
      "invariants": [
        "当 auth_type=private_key 时，private_key 必须通过凭证加密服务加密后存入 private_key_encrypted"
      ]
    },
    {
      "rule_id": "BR-003",
      "description": "连接测试时须使用解密后的凭据",
      "invariants": [
        "调用测试前，先调用凭证加密服务解密 private_key_encrypted（如有）"
      ]
    },
    {
      "rule_id": "BR-004",
      "description": "max_releases 必须大于0",
      "invariants": [
        "DO-001.max_releases >= 1"
      ]
    }
  ],
  "error_handling": [
    {
      "error_code": "ENV_DUPLICATE_NAME",
      "description": "环境名称已存在",
      "http_status": 409,
      "strategy": "返回冲突错误，前端提示更换名称"
    },
    {
      "error_code": "ENV_NOT_FOUND",
      "description": "环境不存在",
      "http_status": 404,
      "strategy": "返回未找到错误"
    },
    {
      "error_code": "ENV_INVALID_AUTH",
      "description": "认证方式无效或凭据缺失",
      "http_status": 400,
      "strategy": "返回参数校验错误信息"
    },
    {
      "error_code": "ENV_CONNECTION_TEST_FAILED",
      "description": "SSH连接测试失败",
      "http_status": 200,
      "strategy": "在测试结果中返回失败详情，不影响环境本身状态"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "环境表",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environments"
      },
      "description": "存储部署环境的完整配置信息，包括连接目标、认证方式、部署路径等。",
      "fields": [
        {
          "name": "id",
          "type": "TEXT",
          "required": true,
          "description": "UUID主键"
        },
        {
          "name": "project_id",
          "type": "TEXT",
          "required": true,
          "description": "外键，关联project.id"
        },
        {
          "name": "name",
