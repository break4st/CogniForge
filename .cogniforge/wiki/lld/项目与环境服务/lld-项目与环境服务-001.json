            "required": true,
            "description": "Bearer JWT令牌"
          }
        ],
        "path_params": [
          {
            "name": "project_id",
            "type": "string",
            "format": "uuid",
            "required": true,
            "description": "项目ID"
          }
        ],
        "query_params": [],
        "body_schema": {
          "type": "object",
          "required": [
            "name",
            "host",
            "ssh_user",
            "private_key_id",
            "script_template"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "description": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "default": 22
            },
            "ssh_user": {
              "type": "string"
            },
            "private_key_id": {
              "type": "string"
            },
            "script_template": {
              "type": "string"
            }
          }
        }
      },
      "response": {
        "status_codes": [
          201,
          400,
          401,
          404,
          409
        ],
        "body_schema": {
          "$ref": "#/domain_objects/DO-003"
        }
      },
      "errors": [
        {
          "code": "VALIDATION_ERROR",
          "status": 400,
          "message": "输入校验失败"
        },
        {
          "code": "UNAUTHORIZED",
          "status": 401,
          "message": "无效或过期的令牌"
        },
        {
          "code": "NOT_FOUND",
          "status": 404,
          "message": "项目不存在"
        },
        {
          "code": "CONFLICT",
          "status": 409,
          "message": "环境名称在同一项目下已存在"
        }
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-003"
      ]
    },
    {
      "id": "IF-004",
      "name": "TestEnvironmentConnection",
