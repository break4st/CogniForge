  "business_rules": [
    {
      "id": "BR-001",
      "name": "UniqueProjectNamePerUser",
      "description": "同一用户下的项目名称必须唯一",
      "type": "invariant",
      "context": "CreateProject",
      "expression": "NOT EXISTS (SELECT 1 FROM projects WHERE created_by = :userId AND name = :projectName)",
      "enforcement": "database",
      "error_code": "CONFLICT",
      "message": "项目名称在当前用户下已存在"
    },
    {
      "id": "BR-002",
      "name": "UniqueEnvironmentNamePerProject",
      "description": "同一项目下的环境名称必须唯一",
      "type": "invariant",
      "context": "AddEnvironment",
      "expression": "NOT EXISTS (SELECT 1 FROM environments WHERE project_id = :projectId AND name = :envName)",
      "enforcement": "database",
      "error_code": "CONFLICT",
