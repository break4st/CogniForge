        "path_params": [
          {
            "name": "environment_id",
            "type": "string",
            "format": "uuid",
            "required": true,
            "description": "环境ID"
          }
        ],
        "query_params": [],
        "body_schema": null
      },
      "response": {
        "status_codes": [
          200,
          401,
          404,
          502
        ],
        "body_schema": {
          "type": "object",
          "properties": {
            "success": {
              "type": "boolean"
