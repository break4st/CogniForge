  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ListProjectsContract",
      "description": "获取项目列表的业务逻辑",
      "methods": [
        {
          "name": "ListProjects",
          "parameters": [
            {
              "name": "userId",
              "type": "string",
              "required": true,
              "description": "从JWT中提取的用户ID"
            }
          ],
          "return_type": "[]ProjectSummary",
          "description": "根据用户ID查询其所有项目，返回项目摘要列表",
          "exceptions": [
            "DatabaseError"
          ]
        }
