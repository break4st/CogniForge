        "CMP-003"
      ],
      "source_contracts": [
        "CTR-001"
      ]
    },
    {
      "id": "SC-002",
      "name": "CreateProjectContract",
      "description": "创建项目的业务逻辑",
      "methods": [
        {
          "name": "CreateProject",
          "parameters": [
            {
              "name": "input",
              "type": "CreateProjectInput",
              "required": true,
              "description": "项目创建输入，包含name和可选的description"
            },
            {
              "name": "userId",
              "type": "string",
              "required": true,
              "description": "创建者用户ID"
            }
          ],
          "return_type": "ProjectFull",
          "description": "创建新项目，检查用户下的名称唯一性，返回完整项目信息",
          "exceptions": [
            "ValidationError",
            "DuplicateNameError",
            "DatabaseError"
          ]
        }
      ],
      "interface_id": "IF-002",
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-002"
      ]
    },
