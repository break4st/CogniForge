  "module_boundary": {
    "in_scope": [
      "项目的创建与列表查询",
      "项目名称在同一用户下的唯一性校验",
      "环境的创建与关联管理",
      "环境名称在同一项目下的唯一性校验",
      "为项目清单提供脚本模板占位符管理（版本标识替换）",
      "通过SSH测试目标环境的连通性，需消费安全服务的私钥解密能力"
    ],
    "out_of_scope": [
      "项目的编辑与删除（SAD未定义对应契约）",
      "环境的修改与删除",
      "用户身份创建与认证（依赖Gateway传递的JWT声明）",
      "SSH私钥的生成、存储、轮换（属于安全与密钥服务）",
      "实际部署任务的分发与执行",
      "文件上传与管理"
    ],
    "owned_components": [
      "CMP-003"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-005"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "项目与环境服务是部署平台的核心配置管理模块，提供项目和环境两个核心资源的CRUD子集。它保证名称唯一性约束，关联环境到项目，并代理SSH连通性测试，测试过程中依赖安全服务获取解密私钥。所有持久化数据存储在PostgreSQL中。",
    "dependencies": [
      "安全与密钥服务（获取解密私钥）",
      "PostgreSQL（主数据库）"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "PostgreSQL"
    ]
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "ListProjects",
      "endpoint": "GET /api/v1/projects",
      "description": "获取当前用户的项目列表",
      "request": {
        "headers": [
          {
            "name": "Authorization",
            "required": true,
            "description": "Bearer JWT令牌"
          }
        ],
        "query_params": [],
        "body_schema": null
      },
      "response": {
        "status_codes": [
          200,
          401
        ],
        "body_schema": {
          "type": "object",
          "properties": {
            "projects": {
              "type": "array",
              "items": {
                "$ref": "#/domain_objects/DO-001"
              }
            }
          }
        }
      },
      "errors": [
        {
          "code": "UNAUTHORIZED",
          "status": 401,
          "message": "无效或过期的令牌"
        }
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-001"
      ]
    },
    {
      "id": "IF-002",
      "name": "CreateProject",
