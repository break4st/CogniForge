  "module_boundary": {
    "in_scope": [
      "部署模态框的显示与关闭控制",
      "文件选择/拖拽交互",
      "部署 API 调用(上传文件并获取 deploy_id)",
      "WebSocket 连接建立与进度消息解析",
      "进度步骤的界面渲染",
      "错误信息的格式化与高亮显示",
      "部署过程中的用户操作(取消、重试等)"
    ],
    "out_of_scope": [
      "环境管理页面的其他功能(如环境配置、监控)",
      "部署任务的真实执行逻辑(由 DeploymentService 处理)",
      "部署历史记录的管理",
      "项目管理、密钥管理等功能"
    ],
    "owned_components": [
      "CMP-012"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-009"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "部署入口的模态框组件，作为环境管理页面的一部分，为用户提供文件选择/拖拽、部署触发及实时进度展示功能。",
    "dependencies": [
      "DeploymentService"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-004",
      "sad_component_ids": [
        "CMP-012"
