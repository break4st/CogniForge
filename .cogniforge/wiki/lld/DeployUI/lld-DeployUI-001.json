          "IF-001",
          "IF-002"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "部署入口 UI 实现"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "DeployProgress",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "描述从 WebSocket 接收的进度快照",
      "fields": [
        {
          "name": "deploy_id",
          "type": "number",
          "required": true,
          "description": "部署任务 ID"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "部署状态,如 running, completed, failed"
        },
        {
          "name": "current_step",
          "type": "number",
          "required": true,
          "description": "当前步骤序号"
        },
        {
          "name": "total_steps",
          "type": "number",
          "required": true,
          "description": "总步骤数"
        },
        {
          "name": "message",
          "type": "string",
          "required": false,
          "description": "步骤描述消息"
        },
        {
          "name": "error",
          "type": "ErrorInfo",
          "required": false,
          "description": "错误信息,仅当 status 为 failed 时存在"
        }
      ],
      "indexes": [],
      "source_requirements": [
