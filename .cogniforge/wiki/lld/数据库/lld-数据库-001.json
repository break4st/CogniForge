  "module_boundary": {
    "in_scope": [
      "定义并维护所有核心业务实体的物理表、索引、约束：projects, environments, credentials, deployments, audit_logs, configurations, websocket_sessions",
      "数据库版本化迁移脚本管理",
      "连接账号与权限矩阵管理",
      "数据备份与恢复策略",
      "性能监控与调优"
    ],
    "out_of_scope": [
      "应用层业务逻辑",
      "数据校验（由服务层负责）",
      "数据缓存策略（由缓存模块负责）",
      "文件存储（由文件服务负责）",
      "API接口设计"
    ],
    "owned_components": ["CMP-001"],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": ["DM-001", "DM-002", "DM-003", "DM-004", "DM-005", "DM-006", "DM-007"],
    "consumed_data_models": []
  },
  "overview": {
    "id": "lld-Database-001-overview",
    "description": "本数据库模块负责所有核心业务数据的持久化存储，提供数据一致性、完整性和高性能访问。涵盖项目、环境、凭证、部署等核心实体，支持审计日志和配置管理。采用PostgreSQL作为数据库引擎，通过版本化迁移管理表结构演进。",
    "purpose": "为上层服务提供可靠、高效的数据存取基础，确保业务数据的正确性和安全性。"
  },
  "interfaces": [],
  "data_models": [
    {
      "id": "DM-001",
      "ownership": "canonical",
      "table": "projects",
      "columns": [
        {"name": "id", "type": "uuid", "nullable": false, "default": "gen_random_uuid()", "description": "项目唯一标识"},
        {"name": "name", "type": "varchar(255)", "nullable": false, "description": "项目名称，全局唯一"},
        {"name": "description", "type": "text", "nullable": true, "description": "项目描述"},
        {"name": "status", "type": "varchar(20)", "nullable": false, "default": "active", "description": "状态：active， inactive， archived"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间"},
        {"name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间"}
      ],
      "primary_key": ["id"],
      "constraints": [
        {"name": "projects_name_key", "type": "UNIQUE", "columns": ["name"]},
        {"name": "projects_status_check", "type": "CHECK", "definition": "status IN ('active', 'inactive', 'archived')"}
      ],
      "description": "存储项目基本信息"
    },
    {
      "id": "DM-002",
      "ownership": "canonical",
      "table": "environments",
      "columns": [
        {"name": "id", "type": "serial", "nullable": false, "description": "环境自增ID"},
        {"name": "project_id", "type": "uuid", "nullable": false, "description": "所属项目ID，外键"},
        {"name": "name", "type": "varchar(100)", "nullable": false, "description": "环境名称"},
        {"name": "type", "type": "varchar(20)", "nullable": false, "description": "环境类型：development， staging， production"},
        {"name": "config", "type": "jsonb", "nullable": true, "description": "环境配置JSON"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间"},
        {"name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间"}
      ],
      "primary_key": ["id"],
      "constraints": [
        {"name": "environments_project_id_fkey", "type": "FOREIGN KEY", "columns": ["project_id"], "references": {"table": "projects", "columns": ["id"]}, "on_delete": "CASCADE"},
        {"name": "environments_name_project_unique", "type": "UNIQUE", "columns": ["project_id", "name"]},
        {"name": "environments_type_check", "type": "CHECK", "definition": "type IN ('development', 'staging', 'production')"}
      ],
      "description": "存储项目下的环境定义"
    },
    {
      "id": "DM-003",
      "ownership": "canonical",
      "table": "credentials",
      "columns": [
        {"name": "id", "type": "serial", "nullable": false, "description": "凭据自增ID"},
        {"name": "environment_id", "type": "integer", "nullable": false, "description": "所属环境ID，外键"},
        {"name": "key", "type": "varchar(255)", "nullable": false, "description": "凭据键名"},
        {"name": "value", "type": "text", "nullable": false, "description": "凭据值，加密存储"},
        {"name": "encrypted", "type": "boolean", "nullable": false, "default": false, "description": "是否已加密"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间"},
        {"name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间"}
      ],
      "primary_key": ["id"],
      "constraints": [
        {"name": "credentials_environment_id_fkey", "type": "FOREIGN KEY", "columns": ["environment_id"], "references": {"table": "environments", "columns": ["id"]}, "on_delete": "CASCADE"},
        {"name": "credentials_key_environment_unique", "type": "UNIQUE", "columns": ["environment_id", "key"]}
      ],
      "description": "存储环境相关的敏感凭证"
    },
    {
      "id": "DM-004",
      "ownership": "canonical",
      "table": "deployments",
      "columns": [
        {"name": "id", "type": "serial", "nullable": false, "description": "部署自增ID"},
        {"name": "environment_id", "type": "integer", "nullable": false, "description": "目标环境ID，外键"},
        {"name": "version", "type": "varchar(100)", "nullable": false, "description": "部署版本号"},
        {"name": "status", "type": "varchar(20)", "nullable": false, "default": "pending", "description": "部署状态：pending， running， success， failed"},
        {"name": "log", "type": "text", "nullable": true, "description": "部署日志"},
        {"name": "started_at", "type": "timestamptz", "nullable": true, "description": "开始时间"},
        {"name": "finished_at", "type": "timestamptz", "nullable": true, "description": "结束时间"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间"},
        {"name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间"}
      ],
      "primary_key": ["id"],
      "constraints": [
        {"name": "deployments_environment_id_fkey", "type": "FOREIGN KEY", "columns": ["environment_id"], "references": {"table": "environments", "columns": ["id"]}, "on_delete": "CASCADE"},
        {"name": "deployments_status_check", "type": "CHECK", "definition": "status IN ('pending', 'running', 'success', 'failed')"}
      ],
      "description": "存储部署记录"
    },
    {
      "id": "DM-005",
      "ownership": "canonical",
      "table": "audit_logs",
      "columns": [
        {"name": "id", "type": "bigserial", "nullable": false, "description": "审计日志自增ID"},
        {"name": "table_name", "type": "varchar(100)", "nullable": false, "description": "操作的表名"},
        {"name": "record_id", "type": "uuid", "nullable": true, "description": "记录ID"},
        {"name": "action", "type": "varchar(10)", "nullable": false, "description": "操作类型：INSERT， UPDATE， DELETE"},
        {"name": "old_data", "type": "jsonb", "nullable": true, "description": "变更前数据"},
        {"name": "new_data", "type": "jsonb", "nullable": true, "description": "变更后数据"},
        {"name": "changed_by", "type": "varchar(100)", "nullable": true, "description": "操作者"},
        {"name": "changed_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "操作时间"}
      ],
      "primary_key": ["id"],
      "constraints": [
        {"name": "audit_logs_action_check", "type": "CHECK", "definition": "action IN ('INSERT', 'UPDATE', 'DELETE')"}
      ],
      "description": "存储数据变更审计日志"
    },
    {
      "id": "DM-006",
      "ownership": "canonical",
      "table": "configurations",
      "columns": [
        {"name": "id", "type": "serial", "nullable": false, "description": "配置自增ID"},
        {"name": "key", "type": "varchar(255)", "nullable": false, "description": "配置键名，全局唯一"},
        {"name": "value", "type": "text", "nullable": false, "description": "配置值"},
        {"name": "description", "type": "text", "nullable": true, "description": "配置说明"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间"},
        {"name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间"}
      ],
      "primary_key": ["id"],
      "constraints": [
        {"name": "configurations_key_key", "type": "UNIQUE", "columns": ["key"]}
      ],
      "description": "存储系统配置项"
    },
    {
      "id": "DM-007",
      "ownership": "canonical",
      "table": "websocket_sessions",
      "columns": [
        {"name": "id", "type": "serial", "nullable": false, "description": "会话自增ID"},
        {"name": "connection_id", "type": "varchar(255)", "nullable": false, "description": "WebSocket连接ID，唯一"},
        {"name": "user_id", "type": "uuid", "nullable": true, "description": "关联用户ID"},
        {"name": "data", "type": "jsonb", "nullable": true, "description": "会话数据"},
        {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "创建时间"},
        {"name": "updated_at", "type": "timestamptz", "nullable": false, "default": "now()", "description": "更新时间"}
      ],
      "primary_key": ["id"],
      "constraints": [
        {"name": "websocket_sessions_connection_id_key", "type": "UNIQUE", "columns": ["connection_id"]}
      ],
      "description": "存储WebSocket会话信息"
    }
  ],
  "schema": {
    "name": "public",
    "type": "PostgreSQL",
    "index_strategy": [],
    "fields": []
  },
  "error_handling": {
    "strategy": "数据库层错误统一通过PostgreSQL错误码分类，上层服务映射为业务异常。连接错误重试三次，间隔指数退避。死锁检测后自动重试事务。数据校验错误由CHECK约束在写入前阻止。"
  }
}