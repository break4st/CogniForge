  "overview": {
    "description": "关系型数据库，存储项目、环境、密钥、部署记录和审计日志等持久化数据",
    "dependencies": [],
    "tech_stack": ["PostgreSQL 15"]
  },
  "data_models": [
    {
      "name": "users",
      "type": "table",
      "ownership": "canonical",
      "description": "系统用户账号表，存储用户身份信息和角色权限",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "用户唯一标识"},
        {"name": "username", "type": "VARCHAR(64)", "required": true, "description": "用户名，唯一"},
        {"name": "password_hash", "type": "VARCHAR(255)", "required": true, "description": "密码哈希值（bcrypt 算法）"},
        {"name": "display_name", "type": "VARCHAR(128)", "required": false, "description": "显示名称"},
        {"name": "role", "type": "VARCHAR(32)", "required": true, "description": "角色：admin / developer / manager"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "最后更新时间"}
      ],
      "indexes": [
        {"name": "pk_users", "unique": true, "columns": ["id"]},
        {"name": "uq_users_username", "unique": true, "columns": ["username"]}
      ]
    },
    {
      "name": "projects",
      "type": "table",
      "ownership": "canonical",
      "description": "项目表，每个项目为独立的部署管理单元",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "项目唯一标识"},
        {"name": "name", "type": "VARCHAR(255)", "required": true, "description": "项目名称"},
        {"name": "identifier", "type": "VARCHAR(128)", "required": true, "description": "项目标识符，唯一，用于路由和关联"},
        {"name": "description", "type": "TEXT", "required": false, "description": "项目描述"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "最后更新时间"}
      ],
      "indexes": [
        {"name": "pk_projects", "unique": true, "columns": ["id"]},
        {"name": "uq_projects_identifier", "unique": true, "columns": ["identifier"]},
        {"name": "idx_projects_name", "unique": false, "columns": ["name"]}
      ]
    },
    {
      "name": "environments",
      "type": "table",
      "ownership": "canonical",
      "description": "部署环境表，每个项目包含多套环境（如测试线、灰度线、正式线）",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "环境唯一标识"},
        {"name": "project_id", "type": "BIGINT", "required": true, "description": "所属项目 ID，外键关联 projects.id"},
        {"name": "name", "type": "VARCHAR(255)", "required": true, "description": "环境名称"},
        {"name": "server_host", "type": "VARCHAR(255)", "required": true, "description": "远程服务器地址（IP 或域名）"},
        {"name": "server_port", "type": "INTEGER", "required": true, "description": "SSH 端口号，默认 22"},
        {"name": "description", "type": "TEXT", "required": false, "description": "环境描述"},
        {"name": "status", "type": "VARCHAR(32)", "required": true, "description": "环境状态：active / inactive"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "最后更新时间"}
      ],
      "indexes": [
        {"name": "pk_environments", "unique": true, "columns": ["id"]},
        {"name": "idx_environments_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "uq_environments_project_name", "unique": true, "columns": ["project_id", "name"]}
      ]
    },
    {
      "name": "ssh_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "SSH 密钥表，存储加密后的私钥信息并与环境绑定",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "密钥唯一标识"},
        {"name": "environment_id", "type": "BIGINT", "required": true, "description": "绑定环境 ID，外键关联 environments.id"},
        {"name": "key_name", "type": "VARCHAR(255)", "required": true, "description": "密钥名称"},
        {"name": "encrypted_private_key", "type": "TEXT", "required": true, "description": "AES-256 加密后的私钥内容"},
        {"name": "passphrase_salt", "type": "VARCHAR(64)", "required": false, "description": "加密使用的盐值（如有 passphrase）"},
        {"name": "fingerprint", "type": "VARCHAR(64)", "required": true, "description": "公钥指纹（SHA256）"},
        {"name": "bound_at", "type": "TIMESTAMPTZ", "required": true, "description": "绑定到环境的时间"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "最后更新时间"}
      ],
      "indexes": [
        {"name": "pk_ssh_keys", "unique": true, "columns": ["id"]},
        {"name": "idx_ssh_keys_environment_id", "unique": false, "columns": ["environment_id"]},
        {"name": "uq_ssh_keys_environment_key", "unique": true, "columns": ["environment_id", "key_name"]},
        {"name": "idx_ssh_keys_fingerprint", "unique": false, "columns": ["fingerprint"]}
      ]
    },
    {
      "name": "file_packages",
      "type": "table",
      "ownership": "canonical",
      "description": "文件包表，存储用户上传的可执行文件包元信息",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "文件包唯一标识"},
        {"name": "project_id", "type": "BIGINT", "required": true, "description": "所属项目 ID，外键关联 projects.id"},
        {"name": "file_name", "type": "VARCHAR(255)", "required": true, "description": "文件名"},
        {"name": "file_path", "type": "VARCHAR(512)", "required": true, "description": "文件存储路径"},
        {"name": "checksum", "type": "VARCHAR(64)", "required": true, "description": "文件校验和（SHA256）"},
        {"name": "size", "type": "BIGINT", "required": true, "description": "文件大小（字节）"},
        {"name": "version", "type": "VARCHAR(64)", "required": false, "description": "关联的版本号"},
        {"name": "uploaded_by", "type": "BIGINT", "required": true, "description": "上传用户 ID，外键关联 users.id"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "pk_file_packages", "unique": true, "columns": ["id"]},
        {"name": "idx_file_packages_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "idx_file_packages_uploaded_by", "unique": false, "columns": ["uploaded_by"]},
        {"name": "idx_file_packages_checksum", "unique": false, "columns": ["checksum"]}
      ]
    },
    {
      "name": "deploy_tasks",
      "type": "table",
      "ownership": "canonical",
      "description": "部署任务表，记录每次部署请求的完整信息和执行状态",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "部署任务唯一标识"},
        {"name": "project_id", "type": "BIGINT", "required": true, "description": "所属项目 ID，外键关联 projects.id"},
        {"name": "environment_id", "type": "BIGINT", "required": true, "description": "目标环境 ID，外键关联 environments.id"},
        {"name": "file_package_id", "type": "BIGINT", "required": true, "description": "部署文件包 ID，外键关联 file_packages.id"},
        {"name": "version", "type": "VARCHAR(64)", "required": true, "description": "部署版本号"},
        {"name": "description", "type": "TEXT", "required": false, "description": "部署描述"},
        {"name": "status", "type": "VARCHAR(32)", "required": true, "description": "任务状态：pending / running / success / failed / rolled_back"},
        {"name": "progress", "type": "INTEGER", "required": false, "description": "进度百分比（0-100）"},
        {"name": "current_step", "type": "VARCHAR(128)", "required": false, "description": "当前执行步骤描述"},
        {"name": "started_at", "type": "TIMESTAMPTZ", "required": false, "description": "开始执行时间"},
        {"name": "completed_at", "type": "TIMESTAMPTZ", "required": false, "description": "完成时间"},
        {"name": "error_message", "type": "TEXT", "required": false, "description": "错误信息（失败时填写）"},
        {"name": "created_by", "type": "BIGINT", "required": true, "description": "发起人用户 ID，外键关联 users.id"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "最后更新时间"}
      ],
      "indexes": [
        {"name": "pk_deploy_tasks", "unique": true, "columns": ["id"]},
        {"name": "idx_deploy_tasks_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "idx_deploy_tasks_environment_id", "unique": false, "columns": ["environment_id"]},
        {"name": "idx_deploy_tasks_status", "unique": false, "columns": ["status"]},
        {"name": "idx_deploy_tasks_created_by", "unique": false, "columns": ["created_by"]},
        {"name": "idx_deploy_tasks_created_at", "unique": false, "columns": ["created_at"]}
      ]
    },
    {
      "name": "deploy_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "部署日志表，记录部署过程中的步骤级日志信息",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "日志唯一标识"},
        {"name": "task_id", "type": "BIGINT", "required": true, "description": "所属部署任务 ID，外键关联 deploy_tasks.id"},
        {"name": "step", "type": "VARCHAR(128)", "required": true, "description": "步骤名称，如 upload / generate_script / start"},
        {"name": "level", "type": "VARCHAR(16)", "required": true, "description": "日志级别：info / warn / error"},
        {"name": "message", "type": "TEXT", "required": true, "description": "日志内容"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "pk_deploy_logs", "unique": true, "columns": ["id"]},
        {"name": "idx_deploy_logs_task_id", "unique": false, "columns": ["task_id"]},
        {"name": "idx_deploy_logs_step", "unique": false, "columns": ["step"]},
        {"name": "idx_deploy_logs_created_at", "unique": false, "columns": ["created_at"]}
      ]
    },
    {
      "name": "audit_logs",
      "type": "table",
      "ownership": "canonical",
      "description": "审计日志表，记录系统中所有关键操作的操作人、操作类型、资源对象和详情",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "日志唯一标识"},
        {"name": "action", "type": "VARCHAR(128)", "required": true, "description": "操作名称，如 project.create / deploy.start"},
        {"name": "actor", "type": "VARCHAR(64)", "required": true, "description": "操作人用户名"},
        {"name": "resource_type", "type": "VARCHAR(64)", "required": true, "description": "资源类型，如 project / environment / key / deploy"},
        {"name": "resource_id", "type": "BIGINT", "required": false, "description": "资源 ID"},
        {"name": "detail", "type": "JSONB", "required": false, "description": "操作详情，灵活存储结构化上下文数据"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"}
      ],
      "indexes": [
        {"name": "pk_audit_logs", "unique": true, "columns": ["id"]},
        {"name": "idx_audit_logs_action", "unique": false, "columns": ["action"]},
        {"name": "idx_audit_logs_actor", "unique": false, "columns": ["actor"]},
        {"name": "idx_audit_logs_resource", "unique": false, "columns": ["resource_type", "resource_id"]},
        {"name": "idx_audit_logs_created_at", "unique": false, "columns": ["created_at"]}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "用户认证查询",
      "method": "INTERNAL",
      "endpoint": "SQL: auth",
      "description": "认证中间件通过 SQL 查询用户凭据和角色信息",
      "parameters": [
        {"name": "username", "type": "VARCHAR(64)", "description": "登录用户名"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "BIGINT",
          "username": "VARCHAR(64)",
          "password_hash": "VARCHAR(255)",
          "role": "VARCHAR(32)"
        }
      },
      "error_codes": [
        {"code": "P0000", "message": "数据库查询异常"}
      ]
    },
    {
      "name": "项目数据读写",
      "method": "INTERNAL",
      "endpoint": "SQL: projects",
      "description": "项目管理服务对 projects 表的 CRUD 操作",
      "parameters": [
        {"name": "table", "type": "VARCHAR(64)", "description": "projects"},
        {"name": "operation", "type": "VARCHAR(16)", "description": "SELECT / INSERT / UPDATE / DELETE"}
      ],
      "response": {
        "status": 200,
        "body": {
          "rows_affected": "INTEGER",
          "data": "JSONB"
        }
      },
      "error_codes": [
        {"code": 23505, "message": "唯一约束冲突（identifier 重复）"},
        {"code": "P0000", "message": "数据库查询异常"}
      ]
    },
    {
      "name": "环境数据读写",
      "method": "INTERNAL",
      "endpoint": "SQL: environments",
      "description": "环境管理服务对 environments 表的 CRUD 操作",
      "parameters": [
        {"name": "table", "type": "VARCHAR(64)", "description": "environments"},
        {"name": "operation", "type": "VARCHAR(16)", "description": "SELECT / INSERT / UPDATE / DELETE"}
      ],
      "response": {
        "status": 200,
        "body": {
          "rows_affected": "INTEGER",
          "data": "JSONB"
        }
      },
      "error_codes": [
        {"code": 23503, "message": "外键约束失败（project_id 不存在）"},
        {"code": 23505, "message": "唯一约束冲突（环境名重复）"},
        {"code": "P0000", "message": "数据库查询异常"}
      ]
    },
    {
      "name": "密钥数据读写",
      "method": "INTERNAL",
      "endpoint": "SQL: ssh_keys",
      "description": "密钥管理服务对 ssh_keys 表的读写操作",
      "parameters": [
        {"name": "table", "type": "VARCHAR(64)", "description": "ssh_keys"},
        {"name": "operation", "type": "VARCHAR(16)", "description": "SELECT / INSERT / UPDATE / DELETE"}
      ],
      "response": {
        "status": 200,
        "body": {
          "rows_affected": "INTEGER",
          "data": "JSONB"
        }
      },
      "error_codes": [
        {"code": 23503, "message": "外键约束失败（environment_id 不存在）"},
        {"code": "P0000", "message": "数据库查询异常"}
      ]
    },
    {
      "name": "部署任务数据读写",
      "method": "INTERNAL",
      "endpoint": "SQL: deploy_tasks",
      "description": "部署引擎服务对 deploy_tasks 和 deploy_logs 表的读写操作",
      "parameters": [
        {"name": "tables", "type": "VARCHAR(64)", "description": "deploy_tasks, deploy_logs"},
        {"name": "operation", "type": "VARCHAR(16)", "description": "SELECT / INSERT / UPDATE"}
      ],
      "response": {
        "status": 200,
        "body": {
          "rows_affected": "INTEGER",
          "data": "JSONB"
        }
      },
      "error_codes": [
        {"code": 23503, "message": "外键约束失败（关联 ID 不存在）"},
        {"code": "P0000", "message": "数据库查询异常"}
      ]
    },
    {
      "name": "审计日志写入",
      "method": "INTERNAL",
      "endpoint": "SQL: audit_logs",
      "description": "审计日志服务对 audit_logs 表的写入和查询操作",
      "parameters": [
        {"name": "table", "type": "VARCHAR(64)", "description": "audit_logs"},
        {"name": "operation", "type": "VARCHAR(16)", "description": "INSERT / SELECT"}
      ],
      "response": {
        "status": 200,
        "body": {
          "rows_affected": "INTEGER",
          "data": "JSONB"
        }
      },
      "error_codes": [
        {"code": "P0000", "message": "数据库查询异常"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "采用 PostgreSQL 内置约束（NOT NULL、UNIQUE、FOREIGN KEY、CHECK）在数据库层保证数据完整性；应用层使用事务封装多表写入操作，遇错误整体回滚；唯一约束冲突（23505）、外键约束失败（23503）等常见错误由 ORM 层捕获并转为业务错误码返回调用方",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {"code": "23505", "name": "唯一约束冲突", "description": "INSERT 或 UPDATE 违反 UNIQUE 约束时触发，如重复的项目标识符或环境名。应用层捕获后返回 409 Conflict"},
      {"code": "23503", "name": "外键约束冲突", "description": "INSERT 或 UPDATE 引用了不存在的父记录时触发。应用层捕获后返回 400 Bad Request，指明关联资源不存在"},
      {"code": "23502", "name": "非空约束冲突", "description": "INSERT 时未提供 NOT NULL 字段值时触发。应用层捕获后返回 422 Unprocessable Entity"},
      {"code": "40P01", "name": "死锁检测", "description": "并发事务产生死锁时触发。pg 自动回滚当前语句，应用层应重试最多 3 次"},
      {"code": "55000", "name": "事务异常", "description": "事务执行过程中发生不可恢复错误时触发。应用层回滚整个事务并返回 500 Internal Server Error"}
    ]
  },
