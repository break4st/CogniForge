        {"name": "idx_file_packages_project_id", "columns": ["project_id"], "unique": false, "type": "B-tree", "purpose": "按项目 ID 查询所有文件包"},
        {"name": "idx_file_packages_uploaded_by", "columns": ["uploaded_by"], "unique": false, "type": "B-tree", "purpose": "按上传用户查询文件包"},
        {"name": "idx_file_packages_checksum", "columns": ["checksum"], "unique": false, "type": "B-tree", "purpose": "校验和索引，支持去重判断"}
      ]
    },
    {
      "table": "deploy_tasks",
      "indexes": [
        {"name": "pk_deploy_tasks", "columns": ["id"], "unique": true, "type": "B-tree", "purpose": "主键索引，快速定位部署任务"},
        {"name": "idx_deploy_tasks_project_id", "columns": ["project_id"], "unique": false, "type": "B-tree", "purpose": "按项目查询部署历史"},
