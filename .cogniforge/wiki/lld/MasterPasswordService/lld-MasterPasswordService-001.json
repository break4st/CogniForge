{
  "meta": {
    "doc_id": "lld-MasterPasswordService-001",
    "type": "lld",
    "module": "MasterPasswordService",
    "module_type": "service",
    "version": 1,
    "status": "draft",
    "title": "MasterPasswordService 详细设计文档",
    "author": "CogniForge",
    "created": "2025-01-28T12:00:00Z"
  },
  "source": {
    "prd": {
      "doc_id": "PRD-2025-001",
      "version": 1,
      "requirements": [
        "REQ-003"
      ]
    },
    "sad": {
      "doc_id": "SAD-001",
      "version": 1
    }
  },
  "overview": {
    "description": "MasterPasswordService 负责主密码的设定、验证、派生密钥生成以及相关生命周期管理。它提供前端接口，确保主密码的安全存储和验证，支持密码强度校验、缓存派生密钥、状态查询等功能。该服务是应用安全体系的核心组件，所有加密数据的访问均依赖于通过此服务验证主密码后获取的派生密钥。",
    "dependencies": [
      "ConfigStore（持久化存储主密码哈希记录）",
      "CryptoUtils（提供哈希和密钥派生底层实现）"
    ]
  },
  "domain_objects": [
    {
      "id": "MasterPassword",
      "type": "domain_object",
      "object_type": "entity",
      "name": "MasterPassword",
      "description": "用户设定的主密码实体，用于保护应用数据。密码本身不持久化，仅在设定和验证时短暂存在于内存。",
      "attributes": [
        {
          "name": "value",
          "type": "string",
          "description": "原始密码字符串，处理完立即从内存清除。",
          "required": true
        }
      ]
    },
    {
      "id": "DerivedKeyCache",
      "type": "domain_object",
      "object_type": "value_object",
      "name": "DerivedKeyCache",
      "description": "内存中的派生密钥缓存，用于避免频繁的密钥派生操作。缓存有生命周期限制，例如超时或主动清除。",
      "attributes": [
        {
          "name": "cachedKey",
          "type": "Buffer",
          "description": "当前缓存的派生密钥。",
          "required": false
        },
        {
          "name": "timestamp",
          "type": "number",
          "description": "缓存创建时间戳，用于超时判断。",
          "required": false
        }
      ]
    }
  ],
  "data_models": [
    {
      "id": "MasterPasswordHashRecord",
      "type": "data_model",
      "object_type": "data_model",
      "name": "MasterPasswordHashRecord",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "fields": [
        {
          "name": "hash",
          "type": "string",
          "description": "Base64 encoded hash",
          "required": true
        },
        {
          "name": "salt",
          "type": "string",
          "description": "Base64 encoded salt",
          "required": true
        },
        {
          "name": "iterations",
          "type": "number",
          "description": "PBKDF2 iterations",
          "required": true
        },
        {
          "name": "keyLength",
          "type": "number",
          "description": "Derived key length in bytes",
          "required": true
        },
        {
          "name": "digest",
          "type": "string",
          "description": "Hash algorithm",
          "required": true
        },
        {
          "name": "version",
          "type": "number",
          "description": "Record format version",
          "required": true
        }
      ],
      "source": {
        "doc_id": "sad-001",
        "model_name": "MasterPasswordHashRecord"
      },
      "description": "用于持久化存储的主密码哈希记录，由 ConfigStore 管理。",
      "constraints": []
    }
  ],
  "business_rules": {
    "invariants": [
      "主密码设定后不可更改，除非先重置整个应用。",
      "所有密码验证和派生操作必须通过恒定时间比较防止时序攻击。",
      "派生密钥缓存必须在用户退出、超时或发生关键事件时清除。"
    ]
  },
  "interfaces": [],
  "service_contracts": [
    {
      "id": "SC-001",
      "type": "service_contract",
      "object_type": "service_contract",
      "name": "setupMasterPassword",
      "methods": [
        {
          "name": "execute",
          "description": "设定新的主密码。如果主密码已存在则拒绝操作。",
          "signature": "public async execute(password: string): Promise<void>",
          "precondition": "主密码尚未设定；密码字符串非空且符合强度要求。",
          "postcondition": "主密码哈希记录持久化存储；服务状态变为已设置。"
        }
      ]
    },
    {
      "id": "SC-002",
      "type": "service_contract",
      "object_type": "service_contract",
      "name": "verifyMasterPassword",
      "methods": [
        {
          "name": "execute",
          "description": "验证输入的密码是否与存储的主密码匹配。",
          "signature": "public async execute(password: string): Promise<boolean>",
          "precondition": "主密码已设定。",
          "postcondition": "返回布尔值表示验证结果。"
        }
      ]
    },
    {
      "id": "SC-003",
      "type": "service_contract",
      "object_type": "service_contract",
      "name": "getDerivedKey",
      "methods": [
        {
          "name": "execute",
          "description": "获取基于主密码的派生密钥。如果未设置主密码或未通过验证，则抛出异常。优先返回缓存密钥。",
          "signature": "public async execute(): Promise<Buffer>",
          "precondition": "主密码已设定且用户已通过验证；派生密钥缓存有效或可重新派生。",
          "postcondition": "返回派生密钥；如果此前未缓存，则创建缓存。"
        }
      ]
    },
    {
      "id": "SC-004",
      "type": "service_contract",
      "object_type": "service_contract",
      "name": "clearCache",
      "methods": [
        {
          "name": "execute",
          "description": "清除派生密钥缓存，安全地从内存中移除。",
          "signature": "public execute(): void",
          "precondition": "无特定前置条件。",
          "postcondition": "派生密钥缓存被置空，时间戳重置。"
        }
      ]
    },
    {
      "id": "SC-005",
      "type": "service_contract",
      "object_type": "service_contract",
      "name": "isPasswordSet",
      "methods": [
        {
          "name": "execute",
          "description": "检查主密码是否已设定。",
          "signature": "public execute(): boolean",
          "precondition": "无。",
          "postcondition": "返回 true 如果主密码已设定，否则 false。"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "MasterPasswordService 采用分层错误处理策略。所有公共方法在执行过程中捕获底层异常，并将其转换为语义明确的领域异常。服务层不处理 UI 逻辑，仅抛出标准化异常，由上层调用者决定如何呈现。对于密码学操作中的异常（如算法不支持），包装为 InternalServiceError。对于用户输入错误，抛出参数无效或状态冲突类异常。所有异常均记录调试日志，但避免泄露敏感信息。"
  }
}