  "component_tree": {
    "name": "EnvironmentTestConnection",
    "type": "react_functional",
    "description": "主测试连接组件，封装按钮、状态管理、API调用逻辑",
    "props_interfaces": ["IF-002"],
    "children": [
      {
        "name": "TestButton",
        "type": "Ant Design Button",
        "description": "触发测试连接的按钮，根据状态显示不同文案和样式"
      },
      {
        "name": "ResultAlert",
        "type": "Ant Design Alert",
        "description": "显示测试结果的提示框，成功/失败/错误信息"
      }
    ],
    "root_selector": "jsx: <EnvironmentTestConnection ... />"
  },
  "state_design": {
    "scope": "component_internal",
    "definitions": [
      {
        "name": "loading",
        "type": "boolean",
        "initial_value": false,
        "description": "是否正在执行连接测试"
      },
      {
        "name": "testResult",
        "type": "{ success: boolean, message: string } | null",
        "initial_value": null,
        "description": "最近一次测试结果，或为空"
      },
      {
        "name": "errorDetail",
        "type": "{ type: 'network' | 'server' | 'client', message: string } | null",
        "initial_value": null,
        "description": "错误分类信息，用于细粒度展示"
      },
      {
        "name": "abortController",
        "type": "AbortController | null",
        "initial_value": null,
        "description": "用于取消进行中的请求"
      }
    ],
    "state_transitions": [
      {
        "trigger": "点击测试按钮",
        "from": "初始或结果/错误显示状态",
        "to": "loading=true, testResult=null, errorDetail=null, abortController=new AbortController()",
        "description": "开始测试"
      },
      {
        "trigger": "API调用成功",
        "from": "loading=true",
        "to": "loading=false, testResult={success, message}, errorDetail=null",
        "description": "展示成功/失败结果"
      },
      {
        "trigger": "API调用失败（网络/超时/服务器错误）",
        "from": "loading=true",
        "to": "loading=false, testResult=null, errorDetail={type, message}",
        "description": "展示错误信息"
      },
      {
        "trigger": "组件卸载",
        "from": "loading=true",
        "to": "调用abortController.abort()，清理状态",
        "description": "取消请求，防止内存泄漏"
      }
    ]
  },
  "route_design": {
    "routes": [],
    "note": "该组件不引入新路由，作为环境配置页面的一部分嵌入"
  },
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "测试连接正常流程",
      "trigger": "用户点击测试按钮",
      "steps": [
        "1. 检查disabled prop，若为true或loading=true则忽略点击",
        "2. 设置loading=true，重置testResult和errorDetail",
        "3. 创建AbortController，保存至状态",
        "4. 调用POST /api/environments/{envId}/test，设置signal和30秒超时",
        "5. 收到响应后更新testResult或errorDetail，设置loading=false",
        "6. 若存在onTestComplete回调，传入结果对象调用之"
      ],
      "alternative_flows": [
        {
          "condition": "envId无效或缺失",
          "steps": ["立即设置errorDetail为客户端错误，提示“环境ID无效”"]
        },
        {
          "condition": "请求被取消（组件卸载或手动取消）",
          "steps": ["静默忽略，不更新状态"]
        },
        {
          "condition": "网络超时",
          "steps": ["设置errorDetail为网络错误，提示“连接超时，请检查网络或服务器地址”"]
        }
      ]
    },
    {
      "id": "FLOW-002",
      "name": "重试流程",
      "trigger": "用户在错误状态下点击重试/再次点击按钮",
      "steps": [
        "1. 若当前仍有loading，忽略",
        "2. 清除errorDetail，重新发起测试（同FLOW-001步骤2-6）"
      ]
    }
  ],
  "api_integration": {
    "consumed_apis": [
      {
        "id": "API-001",
        "name": "Test Environment Connection",
        "source_contract_id": "CTR-008",
        "interface_id": "IF-001",
        "method": "POST",
        "url": "/api/environments/{envId}/test",
        "auth": "bearer_token",
        "timeout_ms": 30000,
        "retry_policy": "manual_only",
        "error_mapping": {
          "404": "client",
          "4xx": "client",
          "5xx": "server",
          "network": "network",
          "timeout": "network"
        },
        "request_preparation": "从props获取envId，填充路径参数，无请求体",
        "response_handling": "成功时解析success和message；失败时根据状态码/异常类型归类，生成用户友好消息"
      }
    ],
    "provided_apis": [],
    "state_sync": "组件内部状态通过回调onTestComplete向上通知父组件，无全局状态同步"
  },
  "business_rules": {
    "invariants": [
      "按钮在加载状态或disabled为true时不可点击",
      "同一时间只允许一个测试连接请求进行",
      "组件卸载时应取消进行中的请求",
      "错误信息必须对用户友好，避免暴露技术细节"
    ]
  },
  "error_handling": {
    "strategy": "前端统一捕获API错误和网络异常，根据状态码展示友好提示；提供手动重试和数据加载状态保护，避免重复提交。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "如404环境不存在，直接展示后端返回的detail信息；其他4xx类似处理。"
      },
      {
        "code": "5xx",
        "name": "服务端错误",
        "description": "显示服务器内部错误提示，并允许用户手动重试。"
      },
      {
        "code": "network",
        "name": "网络错误/超时",
        "description": "前端设置30秒超时，超时或网络不可用时显示连接超时提示，引导用户检查网络或服务器地址。"
      }
    ]
  },
  "workflow": {
    "name": "测试连接交互主流程",
    "description": "用户点击「测试连接」后，组件禁用按钮、显示加载状态，发送API请求，根据响应展示成功/失败结果或错误详情。",
    "steps": [
      {
        "order": 1,
        "name": "发起测试",
        "action": "用户点击按钮，禁用按钮并设置loading状态，清空上次结果",
        "timeout_seconds": 0,
        "on_failure": ""
      },
      {
        "order": 2,
        "name": "调用API",
        "action": "发送 POST /api/environments/{envId}/test，设置超时30秒",
        "timeout_seconds": 30,
        "on_failure": "触发错误分类处理，更新组件状态显示错误信息"
      },
      {
        "order": 3,
        "name": "处理响应",
        "action": "成功时解析body，保存success和message到testResult；失败时按错误分类保存到errorDetail",
        "timeout_seconds": 0,
        "on_failure": ""
      },
      {
        "order": 4,
        "name": "展示结果",
        "action": "根据testResult显示成功或失败Alert，或根据errorDetail显示错误Alert",
        "timeout_seconds": 0,
        "on_failure": ""
      }
    ]
  }
}