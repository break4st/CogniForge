  "overview": {
    "description": "嵌入环境配置页的前端组件，提供测试SSH连接的按钮，调用后端接口并显示成功/失败结果，内部维护加载、结果和错误状态，提供清晰的用户反馈。",
    "dependencies": [
      "环境配置服务",
      "网关"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design"
    ]
  },
