  "interfaces": [
    {
      "id": "IF-001",
      "name": "部署编排器同步 API",
      "description": "触发一键部署的同步 HTTP API",
      "endpoint": "/api/v1/deployments/",
      "method": "POST",
      "request": {
        "body": {
          "content_type": "multipart/form-data",
          "schema": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "integer",
                "description": "项目 ID"
              },
              "environment_id": {
                "type": "integer",
                "description": "环境 ID"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "binary"
                },
                "description": "上传的项目文件列表"
              }
            },
            "required": [
              "project_id",
              "environment_id",
              "files"
            ]
          }
        }
      },
      "response": {
        "200": {
          "description": "成功提交部署任务",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deployment_id": {
                    "type": "string",
