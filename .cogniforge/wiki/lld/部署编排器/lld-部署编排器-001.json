  "module_boundary": {
    "in_scope": [
      "接收部署请求并校验项目、环境绑定、本地文件",
      "生成部署标识并持久化部署记录",
      "提交异步部署任务到 Celery",
      "在 Celery Worker 中执行 SSH 远程部署步骤（解密私钥、建立连接、创建目录、上传文件、生成脚本）",
      "按步骤更新部署进度并通过进度通知器推送",
      "部署失败时标记部署记录为失败并记录错误信息"
    ],
    "out_of_scope": [
      "前端实时进度展示（由前端模块负责）",
      "项目 CRUD 管理（由项目管理服务负责）",
      "环境配置与私钥加密存储（由环境管理服务负责）",
      "连通性测试（由连通性测试服务负责）",
      "部署历史与日志存储查询（由部署历史与日志服务负责）",
      "SSE 推送通道的建立和维护（由进度通知器负责）"
    ],
    "owned_components": [
      "CMP-004"
    ],
    "owned_contracts": [
      "CTR-010"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001",
      "DM-002",
      "DM-003",
      "DM-004"
    ]
  },
  "overview": {
    "description": "部署编排器是一键部署流程的枢纽服务，负责接收部署请求，校验本地文件、项目存在性及环境绑定，生成唯一部署标识并提交到 Celery 异步任务队列；在 Worker 中通过 Paramiko 执行 SSH 远程部署步骤并实时更新进度。",
    "dependencies": [
      "项目管理服务",
      "环境管理服务",
      "进度通知器",
      "Celery + Redis",
      "PostgreSQL"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "Celery (Redis broker)",
      "Paramiko",
      "cryptography (AES-256-GCM)"
    ]
  },
