      "source_contracts": [
        "CTR-010"
      ],
      "methods": [
        {
          "name": "handle_deploy_request",
          "description": "处理同步部署请求，校验参数、项目存在、环境绑定及文件，生成部署标识并提交异步任务，返回部署 ID",
          "parameters": [
            {
              "name": "request",
              "type": "DeployRequest",
              "required": true,
              "description": "部署请求体"
            }
          ],
          "return": {
            "type": "DeployResponse",
            "required": true,
            "description": "包含 deployment_id 的响应"
          },
          "errors": [
            "ValidationError",
            "ProjectNotFoundError",
            "EnvironmentNotFoundError"
          ]
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "SSHDeployWorker",
      "object_type": "service",
      "description": "Celery Worker 中执行的部署任务，包含 SSH 连接、文件上传和部署步骤",
      "attributes": [
        {
          "name": "encryption_key",
          "type": "bytes",
          "required": true,
          "description": "用于解密私钥的对称密钥"
        },
        {
          "name": "progress_notifier",
          "type": "ProgressNotifier",
          "required": true,
          "description": "进度通知器"
        },
        {
          "name": "logger",
          "type": "Logger",
          "required": true,
          "description": "日志记录器"
        }
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-004"
      ],
      "source_contracts": [
        "CTR-010"
      ],
      "methods": [
        {
          "name": "execute_deployment",
          "description": "执行完整的部署流程：解密私钥、建立 SSH 连接、上传文件、执行部署脚本",
          "parameters": [
            {
              "name": "task_id",
              "type": "str",
              "required": true,
              "description": "部署任务 ID"
            }
          ],
          "return": {
            "type": "None",
            "required": false,
            "description": "无返回值，通过进度通知更新状态"
          },
          "errors": [
            "PrivateKeyDecryptionError",
            "SSHConnectionError",
            "FileUploadError",
            "ScriptExecutionError"
          ]
        }
      ]
    },
