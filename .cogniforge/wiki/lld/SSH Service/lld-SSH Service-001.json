  "module_boundary": {
    "in_scope": [
      "SSH 客户端连接管理（基于 ssh2 库）",
      "远程命令执行（execCommand）",
      "SFTP 文件上传（sftpUpload）",
      "连接建立前解密私钥（内存中）",
