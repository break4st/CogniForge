  "interfaces": [
    {
      "id": "IF-001",
      "name": "connect",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-004",
      "provider_component_id": "CMP-005",
      "method": "INTERNAL",
      "endpoint": "SSHService.connect",
      "description": "建立 SSH 连接到远程主机，接收主机地址、端口和解密后的私钥（内存中），返回连接句柄或错误信息。",
      "parameters": [
        {
          "name": "host",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "远程主机地址或 IP"
        },
        {
          "name": "port",
          "type": "number",
          "in": "body",
          "required": false,
          "description": "SSH 端口，默认 22"
        },
        {
          "name": "username",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "SSH 登录用户名"
        },
        {
          "name": "decryptedPrivateKey",
          "type": "string (Buffer)",
          "in": "body",
          "required": true,
          "description": "已在内存中解密的私钥内容，使用后由模块负责清理"
        },
        {
          "name": "passphrase",
          "type": "string",
          "in": "body",
          "required": false,
          "description": "私钥的密码短语（如果有）"
        }
      ],
      "request_body": {
        "host": "string",
        "port": "number",
        "username": "string",
        "decryptedPrivateKey": "string (Buffer)",
        "passphrase": "string"
      },
      "response": {
        "status": 200,
        "body": {
          "connectionId": "string",
          "status": "string"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_PARAMS",
          "message": "缺少必要的连接参数"
        },
        {
          "status": 401,
          "code": "AUTH_FAILED",
          "message": "SSH 认证失败"
        },
        {
          "status": 500,
          "code": "CONNECTION_ERROR",
          "message": "SSH 连接失败"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-002"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "execCommand",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-004",
      "provider_component_id": "CMP-005",
      "method": "INTERNAL",
      "endpoint": "SSHService.execCommand",
      "description": "在已建立的 SSH 连接上执行 shell 命令，返回命令的标准输出、标准错误和退出码。",
      "parameters": [
        {
          "name": "connectionId",
          "type": "string",
          "in": "body",
          "required": true,
          "description": "由 connect 返回的连接标识符"
        },
        {
          "name": "command",
