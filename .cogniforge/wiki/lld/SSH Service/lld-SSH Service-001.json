  "error_handling": {
    "strategy": "所有接口采用统一的错误响应格式，通过 try-catch 捕获底层 ssh2 库异常，归类为参数错误、认证错误、连接错误等，并返回明确的错误码和消息。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "参数无效、连接ID无效、认证失败等由调用方问题引起的错误"
      },
      {
        "code": "5xx",
        "name": "服务端错误",
        "description": "SSH连接失败、命令执行失败、文件上传失败等服务端异常"
      }
    ]
  },
  "topology": {
    "buckets": [
      {
        "name": "temp-uploads",
        "path": "/tmp/ssh-service/uploads",
        "permissions": "700",
        "description": "SFTP上传前的临时文件暂存目录，仅模块内部使用"
      }
    ],
    "path_conventions": "SSH 服务不直接持久化文件，所有私钥解密在内存中进行，连接日志和错误信息通过注入的日志接口输出。临时文件遵循 /tmp/ssh-service/ 层级。"
  },
  "message_contracts": [],
  "reliability_strategy": {
    "ack_mode": "manual",
    "retry": {
      "max_retries": 3,
      "backoff": "exponential"
    },
    "retry_policy": [
      {
        "scope": "connect",
        "condition": "连接超时或网络错误",
        "action": "重试连接，最多重试 3 次，间隔 1s/2s/4s"
      },
      {
        "scope": "execCommand",
        "condition": "命令执行超时或连接断开",
        "action": "尝试重新建立连接后重试命令，最多重试 1 次"
      },
      {
        "scope": "sftpUpload",
        "condition": "上传中断或失败",
        "action": "断点续传或重新上传，最多重试 3 次"
      }
    ],
    "timeout_policy": [
      {
        "scope": "connect",
        "timeout_ms": 10000,
        "fallback": "抛出超时错误，释放资源"
      },
      {
        "scope": "execCommand",
        "timeout_ms": 30000,
        "fallback": "抛出超时错误，命令取消"
      },
      {
        "scope": "sftpUpload",
        "timeout_ms": 120000,
        "fallback": "中止上传，后续可重试"
      }
    ],
    "cleanup_policy": [
      {
        "scope": "connection",
        "trigger": "连接关闭或发生致命错误",
        "action": "销毁解密私钥内存、关闭 SSH 通道、移除事件监听器"
      },
      {
        "scope": "sftpUpload",
        "trigger": "上传完成或失败",
        "action": "关闭 SFTP 通道和流"
      }
    ],
    "dead_letter": "无消息队列，直接调用，不涉及死信队列",
    "idempotency": "execCommand 与 sftpUpload 未保证幂等；调用方需根据业务场景自行处理重复执行问题",
    "failure_recovery": [
      {
        "scenario": "临时网络故障导致连接断开",
        "recovery": "自动重连（基于重试策略），不通知上层；若重试耗尽则抛出异常"
      },
      {
        "scenario": "私钥内存意外残留",
        "recovery": "节点进程终止时由操作系统回收内存；模块内部确保 finally 块清理"
      },
      {
        "scenario": "并发连接数过多",
        "recovery": "无内置连接池，由调用方控制并发；若资源不足抛出错误"
      }
    ]
  },
  "security_design": {
    "secret_storage": "私钥解密后仅存在于内存，不落盘。",
    "encryption": "传输层依赖 SSH 协议加密，应用层不额外加密。",
    "runtime_key_usage": "解密后的私钥通过 Buffer 传递，使用后立即调用 Buffer.fill(0) 擦除。",
    "audit": [
      "连接建立与断开事件",
      "命令执行请求",
      "文件上传请求"
    ]
  },
  "workflow": {
    "name": "SSH服务内部使用流程",
    "description": "上层模块调用SSH服务接口的典型流程：建立连接、执行命令、上传文件、断开连接。",
    "steps": [
      {
        "order": 1,
        "name": "解密私钥",
        "action": "调用Security Service获取解密后的私钥Buffer",
        "timeout_seconds": 10,
        "on_failure": "返回认证失败错误"
      },
      {
        "order": 2,
        "name": "建立SSH连接",
        "action": "调用SSHService.connect",
        "timeout_seconds": 30,
        "on_failure": "重试或返回连接错误"
      },
      {
        "order": 3,
        "name": "执行命令",
        "action": "调用SSHService.execCommand",
        "timeout_seconds": 60,
        "on_failure": "根据错误类型重试或返回错误"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  }
}