  "data_models": [
    {
      "id": "DM-001",
      "name": "ScriptTemplate",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "script_templates"
      },
      "description": "脚本模板表，存储项目相关的启动/停止脚本模板，包含变量占位符定义。",
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "project_id",
          "type": "Integer",
          "required": true,
          "description": "归属项目 ID"
        },
        {
          "name": "name",
          "type": "String",
          "required": true,
          "description": "模板名称"
        },
        {
          "name": "type",
          "type": "String",
          "required": true,
          "description": "模板类型: start 或 stop"
        },
        {
          "name": "content",
          "type": "Text",
          "required": true,
          "description": "脚本内容，包含变量占位符"
        },
        {
          "name": "variables",
          "type": "JSON",
          "required": false,
          "description": "变量定义列表，每项含 name 和 default"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_project_type",
          "unique": false,
          "columns": [
            "project_id",
            "type"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "同一 project_id 下 name 与 type 组合唯一"
      ],
      "lifecycle": {
        "create": "通过模板创建接口新增",
        "update": "通过模板更新接口修改",
        "delete": "检查无活跃执行后逻辑删除",
        "retention": "与项目生命周期绑定，项目删除后可逻辑删除"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
