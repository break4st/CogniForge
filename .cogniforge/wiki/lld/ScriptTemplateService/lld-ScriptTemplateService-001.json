  "business_rules": [
    {
      "id": "BR-001",
      "name": "TemplateUniqueConstraint",
      "description": "同一项目下，模板名称和类型组合必须唯一",
      "invariants": [
        "project_id + name + type 组合唯一"
      ],
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "BR-002",
      "name": "VariablePlaceholderValidation",
      "description": "模板内容中的占位符必须与声明的变量列表匹配",
      "invariants": [
        "content 中的 {{variable}} 必须存在于 variables 列表中"
      ],
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "BR-003",
      "name": "ExecutionAsync",
      "description": "脚本执行是异步操作，返回执行 ID 供后续查询",
      "invariants": [
        "executeScript 必须立即返回 202 Accepted"
      ],
      "source_requirements": [
        "REQ-002"
      ]
    }
  ],
  "error_handling": {
    "strategy": "全局异常处理中间件捕获所有异常，按类型映射 HTTP 状态码和标准错误响应体。业务异常返回 4xx，系统异常返回 5xx。每个接口可能抛出特定业务异常。",
    "errors": [
      {
        "code": "TEMPLATE_NOT_FOUND",
        "http_status": 404,
        "message": "模板不存在"
      },
      {
        "code": "EXECUTION_NOT_FOUND",
        "http_status": 404,
        "message": "执行记录不存在"
      },
      {
        "code": "INVALID_VARIABLES",
        "http_status": 400,
        "message": "提供的变量与模板变量不匹配"
      },
      {
        "code": "SSH_CONNECTION_ERROR",
        "http_status": 502,
        "message": "SSH 连接失败"
      },
      {
        "code": "TEMPLATE_TYPE_INVALID",
        "http_status": 400,
        "message": "模板类型无效"
      }
    ]
  }
}