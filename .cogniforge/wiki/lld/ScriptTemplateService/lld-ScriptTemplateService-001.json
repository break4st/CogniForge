  "interfaces": [
    {
      "id": "IF-001",
      "name": "createTemplate",
      "type": "REST",
      "description": "创建脚本模板",
      "endpoint": {
        "method": "POST",
        "path": "/templates",
        "summary": "创建模板"
      },
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "start",
                "stop"
              ]
            },
            "content": {
              "type": "string"
            },
            "variables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "default": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "project_id",
            "name",
            "type",
            "content"
          ]
        }
      },
      "response": {
        "200": {
          "description": "成功返回模板对象",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Template"
              }
            }
          }
        }
      }
    },
    {
      "id": "IF-002",
      "name": "getTemplate",
      "type": "REST",
      "description": "获取单个模板详情",
      "endpoint": {
        "method": "GET",
        "path": "/templates/{template_id}",
        "summary": "获取模板"
      },
      "request": {
        "parameters": [
          {
            "name": "template_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "response": {
        "200": {
          "description": "成功返回模板对象"
        }
      }
    },
    {
      "id": "IF-003",
      "name": "updateTemplate",
      "type": "REST",
      "description": "更新模板内容",
      "endpoint": {
        "method": "PUT",
        "path": "/templates/{template_id}",
        "summary": "更新模板"
      },
      "request": {
        "parameters": [
          {
            "name": "template_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "body": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "variables": {
              "type": "array"
            }
          }
        }
      },
      "response": {
        "200": {
          "description": "成功返回更新后的模板对象"
        }
      }
    },
    {
      "id": "IF-004",
      "name": "deleteTemplate",
      "type": "REST",
      "description": "删除模板（逻辑删除）",
      "endpoint": {
        "method": "DELETE",
        "path": "/templates/{template_id}",
        "summary": "删除模板"
      },
      "request": {
        "parameters": [
          {
            "name": "template_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "response": {
        "204": {
          "description": "无内容"
        }
      }
    },
    {
      "id": "IF-005",
      "name": "listTemplates",
      "type": "REST",
      "description": "按项目列出模板",
      "endpoint": {
        "method": "GET",
        "path": "/templates",
        "summary": "列出模板"
      },
      "request": {
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "start",
                "stop"
              ]
            }
          }
        ]
      },
      "response": {
        "200": {
          "description": "成功返回模板列表"
        }
      }
    },
    {
      "id": "IF-006",
      "name": "executeScript",
      "type": "REST",
      "description": "根据模板生成脚本并远程执行",
      "endpoint": {
        "method": "POST",
        "path": "/scripts/execute",
        "summary": "执行脚本"
      },
      "request": {
        "body": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "integer"
            },
            "environment_id": {
              "type": "integer"
            },
            "variables": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "template_id",
            "environment_id"
          ]
        }
      },
      "response": {
        "202": {
          "description": "执行已接受，返回执行 ID",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Execution"
              }
            }
          }
        }
      }
    },
    {
      "id": "IF-007",
      "name": "getExecutionStatus",
      "type": "REST",
      "description": "查询脚本执行状态和输出",
      "endpoint": {
        "method": "GET",
        "path": "/scripts/executions/{execution_id}",
        "summary": "获取执行状态"
      },
      "request": {
        "parameters": [
          {
            "name": "execution_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "response": {
        "200": {
          "description": "返回执行详情"
        }
      }
    }
  ],
