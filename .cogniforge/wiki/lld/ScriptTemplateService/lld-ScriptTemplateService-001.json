  "module_boundary": {
    "in_scope": [
      "脚本模板的创建、读取、更新、删除(CRUD)",
      "模板变量定义与动态填充",
      "根据环境上下文生成最终 start.sh/stop.sh 脚本",
      "通过 SSH 远程执行脚本并返回执行输出",
      "记录脚本执行历史"
    ],
    "out_of_scope": [
      "SSH 认证与密钥管理(由 KeyManagementService 负责)",
      "环境元数据管理(由 EnvironmentService 负责)",
      "部署流程编排决策(由 DeploymentService 负责)",
      "前端 UI 渲染(由 ScriptManager 组件负责)"
    ],
    "owned_components": [
      "CMP-001",
      "CMP-002",
      "CMP-003"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [
      "CTR-002",
      "CTR-003"
    ],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001",
      "DM-002"
    ]
  },
  "overview": {
    "description": "本服务负责管理环境的启停脚本模板，支持在部署时根据环境变量动态生成脚本，并通过 SSH 远程执行，返回执行结果，是部署流程中连接环境就绪与服务启动的关键环节。",
    "dependencies": [
      "SSHService",
      "EnvironmentService",
      "Primary Database"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "SQLite",
      "SQLAlchemy",
      "paramiko"
    ]
  },
