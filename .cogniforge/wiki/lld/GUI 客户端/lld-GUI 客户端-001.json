  "overview": {
    "description": "基于 React 的用户界面，运行于 Electron 渲染进程，负责呈现项目管理、环境配置、部署操作、部署状态及历史记录等视图，并通过 HTTP 调用后端 API。",
    "dependencies": [
      "API 网关与路由",
      "项目管理服务",
      "环境管理服务",
      "部署执行器"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design 5.x",
      "Electron"
    ]
  },
