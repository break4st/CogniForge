  "module_boundary": {
    "in_scope": [
      "项目管理 UI：列表、创建、编辑、删除项目",
      "环境管理 UI：为项目添加/编辑/删除环境，密钥验证，SSH 连接测试",
      "部署触发 UI：一键部署按钮及参数填写",
      "部署进度与日志实时展示（轮询）",
      "表单输入验证与错误处理",
      "侧边栏导航与页面路由"
    ],
    "out_of_scope": [
      "模板编辑页面（尚无 API 契约）",
      "直接访问数据库或管理持久化数据",
      "后台部署任务的实际调度与执行",
      "SSH 连接的底层实现",
      "用户认证与权限管理（暂无需求）"
