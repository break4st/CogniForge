  "interfaces": [
    {
      "id": "IF-001",
      "name": "API 服务层（项目管理）",
      "description": "提供项目管理相关的 HTTP API 调用方法",
      "method": "HTTP",
      "endpoint": "/projects",
      "spec": {
        "methods": [
          {
            "name": "getProjects",
            "http_method": "GET",
            "path": "/projects",
            "request": {},
            "response": "Project[]",
            "description": "获取项目列表"
          },
          {
            "name": "getProject",
            "http_method": "GET",
            "path": "/projects/:id",
            "request": {},
            "response": "Project",
            "description": "获取单个项目"
          },
          {
            "name": "createProject",
            "http_method": "POST",
            "path": "/projects",
            "request": "ProjectFormData",
            "response": "Project",
            "description": "创建项目"
          },
          {
            "name": "updateProject",
            "http_method": "PUT",
            "path": "/projects/:id",
            "request": "ProjectFormData",
            "response": "Project",
            "description": "更新项目"
          },
          {
            "name": "deleteProject",
            "http_method": "DELETE",
            "path": "/projects/:id",
            "request": {},
            "response": "void",
            "description": "删除项目"
          }
        ]
      },
      "type": "service"
    },
    {
      "id": "IF-002",
      "name": "API 服务层（环境管理）",
      "description": "提供环境管理相关的 HTTP API 调用方法",
      "method": "HTTP",
      "endpoint": "/projects/:projectId/environments",
      "spec": {
        "methods": [
          {
            "name": "getEnvironments",
            "http_method": "GET",
            "path": "/projects/:projectId/environments",
            "request": {},
            "response": "Environment[]",
            "description": "获取环境列表"
          },
          {
            "name": "createEnvironment",
            "http_method": "POST",
            "path": "/projects/:projectId/environments",
            "request": "EnvironmentFormData",
            "response": "Environment",
            "description": "创建环境"
          },
          {
            "name": "updateEnvironment",
            "http_method": "PUT",
            "path": "/projects/:projectId/environments/:id",
            "request": "EnvironmentFormData",
            "response": "Environment",
            "description": "更新环境"
          },
          {
            "name": "deleteEnvironment",
            "http_method": "DELETE",
            "path": "/projects/:projectId/environments/:id",
            "request": {},
            "response": "void",
            "description": "删除环境"
          },
          {
            "name": "testSshConnection",
            "http_method": "POST",
            "path": "/projects/:projectId/environments/:id/test-ssh",
            "request": {},
            "response": "{ success: boolean, message: string }",
            "description": "测试 SSH 连接"
          },
          {
            "name": "validateKey",
            "http_method": "POST",
            "path": "/projects/:projectId/environments/:id/validate-key",
            "request": "{ private_key?: string, password?: string }",
            "response": "{ valid: boolean }",
            "description": "验证密钥"
          }
        ]
      },
      "type": "service"
    },
    {
      "id": "IF-003",
      "name": "API 服务层（部署管理）",
      "description": "提供部署管理相关的 HTTP API 调用方法",
      "method": "HTTP",
      "endpoint": "/projects/:projectId/deployments",
      "spec": {
        "methods": [
          {
            "name": "triggerDeployment",
            "http_method": "POST",
            "path": "/projects/:projectId/deployments",
            "request": "DeploymentFormData",
            "response": "Deployment",
            "description": "触发部署"
          },
          {
            "name": "getDeploymentStatus",
            "http_method": "GET",
            "path": "/projects/:projectId/deployments/:id",
            "request": {},
            "response": "Deployment",
            "description": "获取部署状态"
          },
          {
            "name": "getDeploymentLogs",
            "http_method": "GET",
            "path": "/projects/:projectId/deployments/:id/logs",
            "request": {},
            "response": "{ logs: string[] }",
            "description": "获取部署日志"
          }
        ]
      },
      "type": "service"
    },
    {
      "id": "IF-004",
      "name": "组件接口（项目选择器）",
      "description": "Projects 选择器组件的 props 接口",
      "method": "Props",
      "endpoint": "N/A",
      "spec": {
        "props": {
          "projects": "Project[]",
          "selectedProjectId": "string | null",
          "onSelect": "(projectId: string) => void"
        }
      },
      "type": "component"
    },
    {
      "id": "IF-005",
      "name": "组件接口（部署表单）",
      "description": "DeploymentForm 组件的 props 接口",
      "method": "Props",
      "endpoint": "N/A",
      "spec": {
        "props": {
          "projectId": "string",
          "environments": "Environment[]",
          "onDeploy": "(data: DeploymentFormData) => void"
        }
      },
      "type": "component"
    }
  ],
  "business_rules": {
    "rules": [
      {
        "id": "BR-001",
        "description": "项目名称不能为空，且长度在1-100字符之间",
        "type": "validation",
        "enforcement": "前端表单验证"
      },
      {
        "id": "BR-002",
        "description": "环境名称在同一项目内必须唯一",
        "type": "validation",
        "enforcement": "前端检查 + 后端保证"
      },
      {
        "id": "BR-003",
        "description": "部署前必须选择目标环境",
        "type": "precondition",
        "enforcement": "前端表单验证"
      }
    ]
  },
  "state_design": {
    "global_state": {
      "currentUser": "null",
      "projects": "Project[]",
      "selectedProjectId": "string | null"
    },
    "component_state": {
      "ProjectList": {
        "loading": "boolean",
        "error": "string | null",
        "formVisible": "boolean",
        "editingProject": "Project | null"
      },
      "EnvironmentList": {
        "loading": "boolean",
        "error": "string | null",
        "formVisible": "boolean",
        "editingEnvironment": "Environment | null"
      },
      "DeploymentPage": {
        "deploymentId": "string | null",
        "deploymentStatus": "string | null",
        "logs": "string[]"
      }
    }
  },
  "route_design": [
    {
      "path": "/",
      "component": "Layout",
      "children": [
        {
          "path": "projects",
          "component": "ProjectListPage"
        },
        {
          "path": "projects/:projectId",
          "component": "ProjectDetailPage"
        },
        {
          "path": "projects/:projectId/deploy",
          "component": "DeploymentPage"
        },
        {
          "path": "",
          "redirect": "/projects"
        }
      ]
    }
  ],
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "项目管理流程",
      "description": "用户创建/编辑/删除项目的完整交互",
      "steps": [
        "1. 用户填写项目表单（名称、描述等）并提交",
        "2. 系统调用 POST /projects 或 PUT /projects/:id",
        "3. 用户查看更新后的项目列表"
      ],
      "trigger": "用户点击创建/编辑按钮",
      "alternative_flows": []
    },
    {
      "id": "FLOW-002",
      "name": "环境管理流程",
      "description": "用户管理项目环境的完整交互",
      "steps": [
        "1. 用户填写环境信息（类型、主机、认证方式等）",
        "2. 用户点击“测试连接”按钮，系统调用 API 测试 SSH 连接并显示结果",
        "3. 用户确认环境信息并保存，系统调用 API 创建或更新环境"
      ],
      "trigger": "用户在项目详情页点击添加/编辑环境",
      "alternative_flows": []
    },
    {
      "id": "FLOW-003",
      "name": "部署触发与监控流程",
      "description": "用户触发部署并监控进度的完整交互",
      "steps": [
        "1. 用户在部署表单中选择目标环境和可选提交 SHA",
        "2. 用户确认部署，系统调用 POST /projects/:id/deployments 创建部署任务",
        "3. 系统返回部署任务信息，前端开始轮询状态",
        "4. 用户查看部署结果"
      ],
      "trigger": "用户进入部署页面并点击部署按钮",
      "alternative_flows": []
    }
  ],
  "api_integration": [
    {
      "id": "API-001",
      "description": "获取项目列表",
      "method": "GET",
      "endpoint": "/projects",
      "request": {},
      "response": "Project[]",
      "error_handling": "显示错误提示，支持重试"
    },
    {
      "id": "API-002",
      "description": "获取单个项目",
      "method": "GET",
      "endpoint": "/projects/:id",
      "request": {},
      "response": "Project",
      "error_handling": "显示错误提示"
    },
    {
      "id": "API-003",
      "description": "创建项目",
      "method": "POST",
      "endpoint": "/projects",
      "request": "ProjectFormData",
      "response": "Project",
      "error_handling": "显示验证错误或服务器错误"
    },
    {
      "id": "API-004",
      "description": "更新项目",
      "method": "PUT",
      "endpoint": "/projects/:id",
      "request": "ProjectFormData",
      "response": "Project",
      "error_handling": "显示验证错误或服务器错误"
    },
    {
      "id": "API-005",
      "description": "删除项目",
      "method": "DELETE",
      "endpoint": "/projects/:id",
      "request": {},
      "response": "void",
      "error_handling": "显示错误提示"
    },
    {
      "id": "API-006",
      "description": "获取环境列表",
      "method": "GET",
      "endpoint": "/projects/:projectId/environments",
      "request": {},
      "response": "Environment[]",
      "error_handling": "显示错误提示"
    },
    {
      "id": "API-007",
      "description": "创建环境",
      "method": "POST",
      "endpoint": "/projects/:projectId/environments",
      "request": "EnvironmentFormData",
      "response": "Environment",
      "error_handling": "显示验证错误或服务器错误"
    },
    {
      "id": "API-008",
      "description": "更新环境",
      "method": "PUT",
      "endpoint": "/projects/:projectId/environments/:id",
      "request": "EnvironmentFormData",
      "response": "Environment",
      "error_handling": "显示验证错误或服务器错误"
    },
    {
      "id": "API-009",
      "description": "删除环境",
      "method": "DELETE",
      "endpoint": "/projects/:projectId/environments/:id",
      "request": {},
      "response": "void",
      "error_handling": "显示错误提示"
    },
    {
      "id": "API-010",
      "description": "测试 SSH 连接",
      "method": "POST",
      "endpoint": "/projects/:projectId/environments/:id/test-ssh",
      "request": {},
      "response": "{ success: boolean, message: string }",
      "error_handling": "显示连接失败信息"
    },
    {
      "id": "API-011",
      "description": "验证密钥",
      "method": "POST",
      "endpoint": "/projects/:projectId/environments/:id/validate-key",
      "request": "{ private_key?: string, password?: string }",
      "response": "{ valid: boolean }",
      "error_handling": "显示错误提示"
    },
    {
      "id": "API-012",
      "description": "触发部署",
      "method": "POST",
      "endpoint": "/projects/:projectId/deployments",
      "request": "DeploymentFormData",
      "response": "Deployment",
      "error_handling": "显示错误提示"
    },
    {
      "id": "API-013",
      "description": "获取部署状态",
      "method": "GET",
      "endpoint": "/projects/:projectId/deployments/:id",
      "request": {},
      "response": "Deployment",
      "error_handling": "显示错误提示"
    },
    {
      "id": "API-014",
      "description": "获取部署日志",
      "method": "GET",
      "endpoint": "/projects/:projectId/deployments/:id/logs",
      "request": {},
      "response": "{ logs: string[] }",
      "error_handling": "显示错误提示"
    }
  ],
  "error_handling": {
    "strategy": "统一错误处理",
    "rules": [
      {
        "id": "ERR-001",
        "description": "网络错误：显示通用错误消息并提供重试按钮",
        "type": "network"
      },
      {
        "id": "ERR-002",
        "description": "API 错误：根据 HTTP 状态码显示具体错误信息（如 400 显示验证错误，500 显示服务器错误）",
        "type": "api"
      },
      {
        "id": "ERR-003",
        "description": "表单验证错误：字段级别显示错误提示",
        "type": "validation"
      }
    ]
  }
}