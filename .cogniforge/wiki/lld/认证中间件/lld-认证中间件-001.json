{
  "meta": {
    "doc_id": "lld-认证中间件-001",
    "type": "lld",
    "module_type": "gateway",
    "module": "认证中间件",
    "title": "认证中间件详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "JWT认证过滤器，嵌入API网关的请求处理链中，负责用户身份认证、Token签发和验证、会话管理、权限角色校验和Token刷新。所有发往后端业务服务的请求必须经过本中间件认证后才能路由到上游。提供统一的登录/登出/Token刷新入口，管理用户会话生命周期，基于RBAC模型对每个API端点进行角色级权限控制。",
    "dependencies": [
      "API网关",
      "Redis缓存",
      "PostgreSQL主数据库"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "JWT (JSON Web Token)",
      "Redis 7+",
      "PostgreSQL 15+"
    ]
  },
  "data_models": [
    {
      "name": "users",
      "type": "table",
      "ownership": "owned",
      "description": "用户账户信息表，存储用户基本信息和角色分配。本中间件在登录认证时读取该表验证密码，从JWT中提取角色信息进行权限校验。用户数据通过管理接口维护。",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "用户唯一标识"},
        {"name": "username", "type": "VARCHAR(64)", "required": true, "description": "用户名，用于登录"},
        {"name": "password_hash", "type": "VARCHAR(256)", "required": true, "description": "密码的bcrypt哈希值"},
        {"name": "display_name", "type": "VARCHAR(128)", "required": false, "description": "用户显示名称"},
        {"name": "email", "type": "VARCHAR(256)", "required": false, "description": "用户邮箱"},
        {"name": "role", "type": "VARCHAR(32)", "required": true, "description": "用户角色: admin/manager/operator/developer/tester"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "用户状态: active/disabled/locked"},
        {"name": "login_fail_count", "type": "INTEGER", "required": true, "description": "连续登录失败次数，超过阈值锁定账户"},
        {"name": "locked_until", "type": "TIMESTAMPTZ", "required": false, "description": "账户锁定到期时间"},
        {"name": "last_login_at", "type": "TIMESTAMPTZ", "required": false, "description": "最后登录时间"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录更新时间"}
      ],
      "indexes": [
        {"name": "idx_users_username", "unique": true, "columns": ["username"]},
        {"name": "idx_users_email", "unique": true, "columns": ["email"]},
        {"name": "idx_users_role", "unique": false, "columns": ["role"]}
      ]
    },
    {
      "name": "auth_sessions",
      "type": "store",
      "ownership": "owned",
      "description": "用户会话存储在Redis中，以refresh_token的SHA256哈希值作为Key。用于Token刷新轮换、登出撤销会话、以及并发登录数控制。",
      "fields": [
        {"name": "refresh_token_hash", "type": "string (Redis Key)", "required": true, "description": "刷新令牌的SHA256哈希值，作为Redis Key"},
        {"name": "user_id", "type": "UUID", "required": true, "description": "用户ID"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色快照（签发Token时的角色值）"},
        {"name": "current_project_id", "type": "UUID", "required": false, "description": "当前上下文项目ID，项目切换后更新"},
        {"name": "ip_address", "type": "string", "required": true, "description": "登录时的客户端IP"},
        {"name": "user_agent", "type": "string", "required": false, "description": "登录时User-Agent"},
        {"name": "issued_at", "type": "string (ISO8601)", "required": true, "description": "会话创建时间"},
        {"name": "expires_at", "type": "string (ISO8601)", "required": true, "description": "会话过期时间"},
        {"name": "ttl_seconds", "type": "integer", "required": true, "description": "Redis Key生存时间（秒），等于refresh_token有效期"}
      ]
    },
    {
      "name": "token_blacklist",
      "type": "store",
      "ownership": "owned",
      "description": "登出时将被撤销的Access Token加入Redis黑名单，黑名单Key为token的SHA256哈希值，TTL为Token剩余有效期。防止已登出的Token被恶意重放。",
      "fields": [
        {"name": "token_hash", "type": "string (Redis Key)", "required": true, "description": "已撤销Access Token的SHA256哈希值"},
        {"name": "user_id", "type": "UUID", "required": true, "description": "用户ID"},
        {"name": "expires_at", "type": "string (ISO8601)", "required": true, "description": "Token原始过期时间，用于计算剩余TTL"}
      ]
    },
    {
      "name": "auth_config",
      "type": "config",
      "ownership": "owned",
      "description": "认证中间件的运行时配置，通过环境变量加载，控制Token策略、密码安全策略和速率限制参数。",
      "fields": [
        {"name": "jwt_signing_key", "type": "string", "required": true, "description": "JWT签名密钥，不低于256位，通过环境变量 JWT_SIGNING_KEY 注入"},
        {"name": "access_token_ttl_minutes", "type": "integer", "required": true, "description": "Access Token过期时间（分钟），默认120"},
        {"name": "refresh_token_ttl_days", "type": "integer", "required": true, "description": "Refresh Token过期时间（天），默认7"},
        {"name": "bcrypt_cost", "type": "integer", "required": true, "description": "bcrypt哈希成本因子，默认10"},
        {"name": "max_login_attempts", "type": "integer", "required": true, "description": "连续登录失败最大次数，超过后账户锁定，默认5"},
        {"name": "lockout_minutes", "type": "integer", "required": true, "description": "账户锁定持续时间（分钟），默认30"},
        {"name": "rate_limit_global_per_sec", "type": "integer", "required": true, "description": "全局每IP每秒请求数限制，默认100"},
        {"name": "rate_limit_user_per_min", "type": "integer", "required": true, "description": "每用户每分钟请求数限制，默认1000"},
        {"name": "login_rate_limit_per_ip", "type": "integer", "required": true, "description": "登录接口每IP每分钟限制，默认10"},
        {"name": "login_rate_limit_per_user", "type": "integer", "required": true, "description": "同一用户名每分钟登录尝试限制，默认5"},
        {"name": "token_blacklist_enabled", "type": "boolean", "required": true, "description": "是否启用Token黑名单，默认true"},
        {"name": "redis_session_prefix", "type": "string", "required": true, "description": "Redis会话Key前缀，默认 auth:session:"},
        {"name": "redis_blacklist_prefix", "type": "string", "required": true, "description": "Redis黑名单Key前缀，默认 auth:blacklist:"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "LoginAPI",
      "method": "POST",
      "endpoint": "/api/v1/auth/login",
      "description": "用户登录接口。校验用户名和密码，验证通过后签发Access Token和Refresh Token。首次登录或项目切换时会话中的current_project_id将被更新。登录成功后清除连续失败计数，失败时递增计数并在超过阈值后锁定账户。",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码（明文，传输使用HTTPS加密）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string (JWT Access Token)",
          "refresh_token": "string (JWT Refresh Token)",
          "token_type": "string (固定值 Bearer)",
          "expires_in": "integer (Access Token过期秒数)",
          "user": {
            "id": "string (UUID)",
            "username": "string",
            "display_name": "string",
            "role": "string",
            "permissions": ["string (权限标识列表)"]
          }
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数缺失：username或password为空"},
        {"code": 401, "message": "用户名或密码错误"},
        {"code": 403, "message": "账户已被禁用或锁定，请联系管理员"},
        {"code": 429, "message": "登录尝试过于频繁，请稍后再试"}
      ]
    },
    {
      "name": "RefreshTokenAPI",
      "method": "POST",
      "endpoint": "/api/v1/auth/refresh",
      "description": "刷新Access Token。使用Refresh Token轮换签发新的Access Token和Refresh Token，旧Refresh Token立即失效。Token轮换策略确保每次刷新都生成全新凭据，降低泄漏风险。",
      "parameters": [
        {"name": "refresh_token", "type": "string", "description": "Refresh Token，通过LoginAPI获取"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string (新的Access Token)",
          "refresh_token": "string (新的Refresh Token)",
          "token_type": "string (固定值 Bearer)",
          "expires_in": "integer (新Access Token过期秒数)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "refresh_token参数缺失"},
        {"code": 401, "message": "Refresh Token无效或已过期"},
        {"code": 403, "message": "Refresh Token已被撤销，需要重新登录"}
      ]
    },
    {
      "name": "LogoutAPI",
      "method": "POST",
      "endpoint": "/api/v1/auth/logout",
      "description": "用户登出。将当前Access Token加入黑名单（后续请求携带此Token将被拒绝），删除Redis会话记录使Refresh Token立即失效。前端应清除本地存储的Token并跳转到登录页面。",
      "parameters": [
        {"name": "Authorization", "type": "string (Header)", "description": "Bearer {access_token}"},
        {"name": "refresh_token", "type": "string", "description": "需要失效的Refresh Token"}
      ],
      "response": {
        "status": 200,
        "body": {
          "message": "string (登出成功提示)"
        }
      },
      "error_codes": [
        {"code": 401, "message": "Access Token无效或已过期"},
        {"code": 400, "message": "refresh_token参数缺失"}
      ]
    },
    {
      "name": "GetCurrentUserAPI",
      "method": "GET",
      "endpoint": "/api/v1/auth/me",
      "description": "获取当前登录用户的信息，包括基本资料、角色和权限列表、当前上下文项目。前端用于展示用户信息、控制界面元素显隐和权限判断。",
      "parameters": [
        {"name": "Authorization", "type": "string (Header)", "description": "Bearer {access_token}"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "username": "string",
          "display_name": "string",
          "email": "string",
          "role": "string",
          "permissions": ["string (权限标识列表)"],
          "current_project": {
            "id": "string (UUID, 当前项目ID)",
            "name": "string (当前项目名称)"
          }
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Access Token已过期"},
        {"code": 500, "message": "用户信息查询失败"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "认证中间件的错误分三层处理。第一层：Token级错误（缺失/无效/过期/黑名单）在中间件层面直接拦截返回401，不转发到上游服务，响应中不暴露内部细节。第二层：权限级错误（角色不足）在JWT验证通过后的权限校验层返回403，附带缺失的权限标识。第三层：基础设施错误（Redis连接失败、数据库查询异常）返回500并触发告警，但采取降级保护策略：Redis不可用时仅验证JWT签名跳过会话黑名单检查，确保已签发的有效Token仍能通过认证。",
    "response_format": {
      "body": {
        "code": "integer (HTTP状态码)",
        "error": "string (错误类型)",
        "detail": "string (详细错误信息)",
        "request_id": "string (请求追踪ID)"
      }
    },
    "categories": [
      {
        "code": 400,
        "name": "请求参数错误",
        "description": "登录/刷新/登出接口的请求参数缺失或格式错误。触发条件：username为空、password为空、refresh_token格式不正确、请求体JSON解析失败。"
      },
      {
        "code": 401,
        "name": "认证失败",
        "description": "Token无效、已过期、在黑名单中，或用户名密码错误。不携带有效Token的请求将被中间件拦截，不会路由到上游服务。响应中不区分具体失败原因，防止攻击者枚举。"
      },
      {
        "code": 403,
        "name": "权限不足",
        "description": "用户JWT验证通过但其角色不满足接口的权限要求。例如：开发工程师（developer）尝试调用密钥管理接口或审计日志查询接口。响应detail字段会说明需要的最低角色。"
      },
      {
        "code": 429,
        "name": "请求频率限制",
        "description": "触发速率限制。全局每IP超过100 req/s、每用户超过1000 req/min、登录接口每IP超过10 req/min或同一用户名超过5 req/min时返回。响应头包含Retry-After字段（秒）。"
      },
      {
        "code": 500,
        "name": "内部服务错误",
        "description": "认证中间件内部异常：JWT密钥加载失败（启动时检测）、Redis连接异常（降级通过但记录告警）、用户数据查询失败。触发监控告警，运维人员需检查服务健康状态。"
      }
    ]
  },
  "route_table": [
    {
      "path_pattern": "/api/v1/auth/login",
      "upstream": "认证中间件自身处理",
      "description": "公开端点，无需认证。由认证中间件直接处理登录逻辑，不转发到上游服务。"
    },
    {
      "path_pattern": "/api/v1/auth/refresh",
      "upstream": "认证中间件自身处理",
      "description": "公开端点（需携带有效Refresh Token）。由认证中间件直接处理Token轮换，不转发到上游服务。"
    },
    {
      "path_pattern": "/api/v1/auth/logout",
      "upstream": "认证中间件自身处理",
      "description": "需认证端点。由认证中间件直接处理Token撤销和会话清除，不转发到上游服务。"
    },
    {
      "path_pattern": "/api/v1/auth/me",
      "upstream": "认证中间件自身处理",
      "description": "需认证端点。由认证中间件从JWT和缓存中提取用户信息返回，不转发到上游服务。"
    },
    {
      "path_pattern": "/api/v1/health",
      "upstream": "认证中间件自身处理",
      "description": "公开端点，健康检查。由中间件直接返回200 OK，无需认证。"
    },
    {
      "path_pattern": "/api/v1/deploy/**",
      "upstream": "部署编排服务",
      "description": "部署相关API，包括创建部署、查询状态、回滚操作和WebSocket进度推送。需认证，按HTTP方法和端点区分角色权限。Routes to: 部署编排服务"
    },
    {
      "path_pattern": "/api/v1/projects/**",
      "upstream": "项目管理服务",
      "description": "项目CRUD和列表查询。需认证，GET方法所有已认证角色可用，POST/PUT仅admin/manager，DELETE仅admin。Routes to: 项目管理服务"
    },
    {
      "path_pattern": "/api/v1/session/current-project",
      "upstream": "项目管理服务",
      "description": "项目切换接口。需认证，所有已认证角色可用。认证中间件在响应拦截阶段更新JWT中的current_project_id。Routes to: 项目管理服务"
    },
    {
      "path_pattern": "/api/v1/environments/**",
      "upstream": "环境管理服务",
      "description": "环境配置CRUD和状态检查。需认证，GET方法所有已认证角色可用，POST/PUT/DELETE仅admin/manager。Routes to: 环境管理服务"
    },
    {
      "path_pattern": "/api/v1/keys/**",
      "upstream": "密钥管理服务",
      "description": "SSH密钥管理和验证。需认证，仅admin/manager角色可用（密钥内容敏感需最高权限保护）。Routes to: 密钥管理服务"
    },
    {
      "path_pattern": "/api/v1/projects/:projectId/versions",
      "upstream": "版本管理服务",
      "description": "部署版本历史查询。需认证，所有已认证角色可用。Routes to: 版本管理服务"
    },
    {
      "path_pattern": "/api/v1/audit-logs",
      "upstream": "审计日志服务",
      "description": "审计日志查询。需认证，仅admin角色可用（审计数据敏感需最高权限）。Routes to: 审计日志服务"
    }
  ],
  "middleware_chain": [
    "1. Request → CORS Handler（跨域请求处理：允许指定Origin、Methods、Headers，处理OPTIONS预检请求直接返回204）",
    "2. → Request Logger（记录请求方法、路径、来源IP、User-Agent、请求ID，结构化输出到日志系统）",
    "3. → Rate Limiter（基于令牌桶算法：全局每IP 100 req/s 和 每用户 1000 req/min 双层限流，特殊端点另有独立配额）",
    "4. → Auth Middleware（JWT认证和权限校验：提取Authorization Header → 验证JWT签名和有效期 → 检查Token黑名单 → 解析角色信息 → 校验路径权限 → 注入UserContext到Gin Context）",
    "5. → Router（根据path_pattern匹配上游服务，路由请求到对应的后端业务服务或中间件自身管理的端点）",
    "6. → Upstream Service（上游业务服务：部署编排/项目管理/环境管理/密钥管理/版本管理/审计日志）"
  ],
  "auth_policy": {
    "public_endpoints": [
      "/api/v1/auth/login",
      "/api/v1/auth/refresh",
      "/api/v1/health"
    ],
    "auth_method": "JWT Bearer Token",
    "role_path_map": [
      {"path": "GET /api/v1/auth/me", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "POST /api/v1/auth/logout", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "POST /api/v1/deploy", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "GET /api/v1/deploy/:taskId", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "POST /api/v1/deploy/:taskId/rollback", "roles": ["admin", "manager", "operator", "tester"]},
      {"path": "WS /api/v1/ws/deploy/:taskId", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "GET /api/v1/projects", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "GET /api/v1/projects/:projectId", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "POST /api/v1/projects", "roles": ["admin", "manager"]},
      {"path": "PUT /api/v1/projects/:projectId", "roles": ["admin", "manager"]},
      {"path": "DELETE /api/v1/projects/:projectId", "roles": ["admin"]},
      {"path": "POST /api/v1/session/current-project", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "GET /api/v1/environments", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "GET /api/v1/environments/:envId", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "POST /api/v1/environments", "roles": ["admin", "manager"]},
      {"path": "PUT /api/v1/environments/:envId", "roles": ["admin", "manager"]},
      {"path": "DELETE /api/v1/environments/:envId", "roles": ["admin", "manager"]},
      {"path": "GET /api/v1/keys", "roles": ["admin", "manager"]},
      {"path": "GET /api/v1/keys/:keyId", "roles": ["admin", "manager"]},
      {"path": "POST /api/v1/keys", "roles": ["admin", "manager"]},
      {"path": "PUT /api/v1/keys/:keyId", "roles": ["admin", "manager"]},
      {"path": "DELETE /api/v1/keys/:keyId", "roles": ["admin", "manager"]},
      {"path": "POST /api/v1/keys/:keyId/verify", "roles": ["admin", "manager"]},
      {"path": "GET /api/v1/projects/:projectId/versions", "roles": ["admin", "manager", "operator", "developer", "tester"]},
      {"path": "GET /api/v1/audit-logs", "roles": ["admin"]}
    ],
    "token_expiry": "access 2h, refresh 7d",
    "jwt_payload_claims": [
      {"claim": "sub", "value": "user_id (UUID)", "description": "用户标识"},
      {"claim": "role", "value": "string", "description": "用户角色"},
      {"claim": "username", "value": "string", "description": "用户名"},
      {"claim": "display_name", "value": "string", "description": "用户显示名称"},
