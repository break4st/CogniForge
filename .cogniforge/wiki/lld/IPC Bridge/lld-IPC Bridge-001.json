{
  "meta": {
    "doc_id": "lld-IPC Bridge-001",
    "type": "lld",
    "module": "IPC Bridge",
    "module_type": "service",
    "title": "IPC Bridge (service)",
    "author": "CogniForge Design Agent",
    "version": 1,
    "created": "2025-03-25",
    "status": "draft"
  },
  "source": {
    "prd": {
      "doc_id": "PRD-001",
      "version": 1
    },
    "sad": {
      "doc_id": "SAD-001",
      "version": 1
    }
  },
  "module_boundary": {
    "in_scope": [
      "定义并注册 IPC 通道（如 project:list, env:list, deploy:start, version:rollback 等）",
      "在 preload 脚本中使用 contextBridge.exposeInMainWorld 暴露安全 API 到渲染进程",
      "将渲染进程调用映射到主进程服务方法，并处理 Promise 返回",
      "管理 IPC 调用的生命周期和错误传递",
      "暴露事件监听接口用于实时日志推送（如部署日志）"
    ],
    "out_of_scope": [
      "具体业务逻辑实现（由主进程服务层负责）",
      "UI 组件和页面渲染",
      "数据加密/解密算法实现",
      "本地文件存储操作",
      "SSH 连接管理"
    ]
  },
  "overview": {
    "description": "渲染进程与主进程之间的通信桥梁，通过 contextBridge 暴露安全 API。定义可用的 IPC 通道（如 project:list, env:list 等），转发渲染进程调用到主进程服务，并返回 Promise 结果。同时支持主进程向渲染进程推送事件（如部署实时日志）。",
    "dependencies": [
      "Electron ipcMain",
      "Electron ipcRenderer",
      "主进程各服务模块（ProjectService, EnvironmentService, DeploymentService, VersionHistoryService, MasterPasswordService）"
    ],
    "tech_stack": [
      "TypeScript",
      "Electron 28+",
      "React 18"
    ]
  },
  "domain_objects": [],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "invoke",
      "description": "通用调用方法，根据传入的通道执行对应的处理函数并返回 Promise。",
      "precondition": "channel 必须为非空字符串，且已在主进程中注册对应的处理函数。",
      "postcondition": "返回与通道处理函数对应的 Promise 结果。如果通道未注册，则 Promise 被拒绝并返回错误。",
      "methods": [
        {
          "name": "handleChannel",
          "description": "内部方法，根据通道名称路由到对应的处理函数。",
          "signature": "handleChannel(channel: string, args?: any): Promise<any>",
          "precondition": "channel 必须在注册的通道列表中存在；否则抛出异常。",
          "postcondition": "执行并返回对应处理函数的 Promise 结果，或抛出错误。"
        }
      ]
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "ownership": "owned",
      "name": "DeployRequest",
      "description": "部署请求参数",
      "required": ["projectId", "environment"],
      "fields": [
        {
          "name": "projectId",
          "type": "string",
          "description": "要部署的项目 ID"
        },
        {
          "name": "environment",
          "type": "string",
          "description": "部署目标环境"
        },
        {
          "name": "version",
          "type": "string",
          "description": "部署版本标签，可选"
        }
      ]
    },
    {
      "id": "DM-002",
      "ownership": "owned",
      "name": "DeployResult",
      "description": "部署结果",
      "required": ["deployId", "status"],
      "fields": [
        {
          "name": "deployId",
          "type": "string",
          "description": "分配的部署任务 ID"
        },
        {
          "name": "status",
          "type": "string",
          "description": "初始部署状态"
        }
      ]
    },
    {
      "id": "DM-003",
      "ownership": "owned",
      "name": "RollbackRequest",
      "description": "回滚请求参数",
      "required": ["version", "projectId"],
      "fields": [
        {
          "name": "version",
          "type": "string",
          "description": "要回滚到的版本号"
        },
        {
          "name": "projectId",
          "type": "string",
          "description": "项目 ID"
        }
      ]
    },
    {
      "id": "DM-004",
      "ownership": "owned",
      "name": "RollbackResult",
      "description": "回滚结果",
      "required": ["success", "message"],
      "fields": [
        {
          "name": "success",
          "type": "boolean",
          "description": "回滚是否成功"
        },
        {
          "name": "message",
          "type": "string",
          "description": "结果消息"
        }
      ]
    },
    {
      "id": "DM-005",
      "ownership": "owned",
      "name": "MasterPasswordSetupRequest",
      "description": "主密码设置请求参数",
      "required": ["password"],
      "fields": [
        {
          "name": "password",
          "type": "string",
          "description": "主密码"
        }
      ]
    },
    {
      "id": "DM-006",
      "ownership": "owned",
      "name": "MasterPasswordVerifyRequest",
      "description": "主密码验证请求参数",
      "required": ["password"],
      "fields": [
        {
          "name": "password",
          "type": "string",
          "description": "待验证的密码"
        }
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "所有 IPC 通道必须在 preload 脚本中注册并通过 contextBridge 暴露",
      "主进程处理函数必须始终返回 Promise 或可等待的值",
      "渲染进程不应直接访问 Node.js API，所有操作通过暴露的 API 完成"
    ]
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "preload_api",
      "description": "渲染进程可访问的 API 对象，通过 contextBridge 暴露",
      "method": "POST",
      "endpoint": "/api/ipc",
      "response": {
        "body": "Promise<any>"
      }
    },
    {
      "id": "IF-002",
      "name": "main_process_registration",
      "description": "主进程通道注册接口，用于注册 IPC 处理函数",
      "method": "POST",
      "endpoint": "/api/register",
      "response": {
        "body": "void"
      }
    }
  ],
  "error_handling": {
    "strategy": "集中错误处理与通道未找到统一异常抛出"
  }
}