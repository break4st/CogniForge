{
  "meta": {
    "doc_id": "lld-frontend-ProjectManager-001",
    "type": "lld",
    "module_type": "frontend",
    "module": "ProjectManager",
    "title": "项目管理前端详细设计文档",
    "author": "design_agent",
    "created": "2025-04-15T10:30:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-001"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": [
        "CMP-010"
      ],
      "contracts": [
        "CTR-002",
        "CTR-003",
        "CTR-004"
      ],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "项目列表 UI 及交互逻辑",
      "新建、编辑、删除的前端流程与校验",
      "搜索与排序 UI 及参数传递",
      "根据全局 currentProjectId 高亮当前项目"
    ],
    "out_of_scope": [
      "项目内部的资源管理（环境、密钥、部署等）",
      "后端项目数据的持久化与校验",
      "用户认证与授权（由网关或全局上下文处理）"
    ],
    "owned_components": [
      "CMP-010"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "CTR-002",
      "CTR-003",
      "CTR-004"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "项目管理界面，支持项目的增删改查、搜索排序和项目切换。基于 React 18 和 Ant Design，通过调用后端 ProjectService 接口实现 CRUD，结合全局状态实现项目高亮。",
    "dependencies": [
      "ProjectService"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-011"
      ],
      "sad_contract_ids": [
        "CTR-002",
        "CTR-003",
        "CTR-004"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003"
        ],
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "覆盖项目管理全部 CRUD 及搜索排序功能"
    }
  ],
  "component_tree": {
    "root": "ProjectManagerPage",
    "description": "项目管理页面组件树",
    "components": [
      {
        "id": "C001",
        "name": "ProjectManagerPage",
        "type": "page",
        "description": "项目管理主页面，负责管理所有子组件和状态",
        "children": [
          {
            "id": "C002",
            "name": "ProjectSearchBar",
            "type": "widget",
            "description": "搜索输入框和排序选择器"
          },
          {
            "id": "C003",
            "name": "ProjectList",
            "type": "widget",
            "description": "项目列表展示"
          },
          {
            "id": "C004",
            "name": "ProjectFormModal",
            "type": "widget",
            "description": "新建/编辑项目表单模态框"
          }
        ]
      }
    ]
  },
  "state_design": {
    "state_items": [
      {
        "id": "ST-001",
        "name": "projects",
        "data_model": "DM-001",
        "type": "array",
        "description": "项目列表数据",
        "initial_value": "[ ]",
        "owner_component": "ProjectManagerPage",
        "persistence": "none",
        "triggers": [
          "页面初次加载",
          "搜索/排序条件变化",
          "新建/编辑/删除成功后刷新"
        ]
      },
      {
        "id": "ST-002",
        "name": "loading",
        "type": "boolean",
        "description": "列表请求加载状态",
        "initial_value": "false",
        "owner_component": "ProjectManagerPage",
        "persistence": "none",
        "triggers": [
          "开始/结束 API 调用"
        ]
      },
      {
        "id": "ST-003",
        "name": "searchQuery",
        "data_model": "DM-003",
        "type": "object",
        "description": "当前搜索与排序参数",
        "initial_value": "{ search: '', sort_by: 'created_at', order: 'desc' }",
        "owner_component": "ProjectManagerPage",
        "persistence": "url_query",
        "triggers": [
          "用户输入搜索词",
          "用户改变排序方式"
        ]
      },
      {
        "id": "ST-004",
        "name": "modalVisible",
        "type": "boolean",
        "description": "控制项目表单模态框可见性",
        "initial_value": "false",
        "owner_component": "ProjectManagerPage",
        "persistence": "none",
        "triggers": [
          "点击新建/编辑按钮",
          "表单提交成功或取消"
        ]
      },
      {
        "id": "ST-005",
        "name": "editingProject",
        "data_model": "DM-001",
        "type": "object|null",
        "description": "当前正在编辑的项目数据，null 表示新建",
        "initial_value": "null",
        "owner_component": "ProjectManagerPage",
        "persistence": "none",
        "triggers": [
          "点击编辑按钮",
          "关闭模态框"
        ]
      },
      {
        "id": "ST-006",
        "name": "currentProjectId",
        "type": "integer|null",
        "description": "全局当前项目 ID，用于高亮，可能从全局 store 获取",
        "initial_value": "null",
        "owner_component": "GlobalStore",
        "persistence": "local_storage",
        "triggers": [
          "用户在列表中选择项目",
          "其他模块切换项目"
        ]
      }
    ]
  },
  "route_design": {
    "route_path": "/projects",
    "exact": true,
    "params": {},
    "query_params": ["search", "sort_by", "order"],
    "description": "项目管理页面路由，支持搜索和排序参数通过查询字符串传递"
  },
  "api_integration": {
    "api_calls": [
      {
        "id": "API-001",
        "contract_id": "CTR-002",
        "method": "GET",
        "endpoint": "/api/projects",
        "description": "获取项目列表，支持查询参数 search, sort_by, order",
        "request_mapping": "state.searchQuery → query params",
        "response_mapping": "response.data → state.projects",
        "error_handling": {
          "strategy": "retry_with_backoff",
          "user_notification": "message.error('获取项目列表失败，请稍后重试')"
        }
      },
      {
        "id": "API-002",
        "contract_id": "CTR-003",
        "method": "POST",
        "endpoint": "/api/projects",
        "description": "创建新项目",
        "request_mapping": "formData → request body",
        "response_mapping": "response.data → 添加到 state.projects",
        "error_handling": {
          "strategy": "show_error_message",
          "user_notification": "message.error('创建项目失败，请检查输入')"
        }
      },
      {
        "id": "API-003",
        "contract_id": "CTR-004",
        "method": "PUT",
        "endpoint": "/api/projects/{id}",
        "description": "更新项目信息",
        "request_mapping": "formData + id → request body + url param",
        "response_mapping": "response.data → 替换 state.projects 中对应项",
        "error_handling": {
          "strategy": "show_error_message",
          "user_notification": "message.error('更新项目失败，请重试')"
        }
      },
      {
        "id": "API-004",
        "contract_id": "CTR-005",
        "method": "DELETE",
        "endpoint": "/api/projects/{id}",
        "description": "删除项目",
        "request_mapping": "project.id → url param",
        "response_mapping": "成功 → 从 state.projects 中移除该项目",
        "error_handling": {
          "strategy": "show_error_message",
          "user_notification": "message.error('删除项目失败，请重试')"
        }
      }
    ]
  },
  "interaction_flows": {
    "flows": [
      {
        "id": "FLW-001",
        "name": "项目列表加载流程",
        "trigger": "页面初始化 / 搜索条件变化 / 排序变化",
        "steps": [
          "设置 loading 为 true",
          "调用 API-001 获取项目列表",
          "更新 state.projects",
          "设置 loading 为 false",
          "根据 currentProjectId 高亮当前项目行"
        ]
      },
      {
        "id": "FLW-002",
        "name": "新建项目流程",
        "trigger": "点击新建按钮",
        "steps": [
          "设置 modalVisible 为 true，editingProject 为 null",
          "用户填写表单并提交",
          "调用 API-002 创建项目",
          "成功后关闭模态框，刷新项目列表 (触发 FLW-001)",
          "失败则显示错误信息"
        ]
      },
      {
        "id": "FLW-003",
        "name": "编辑项目流程",
        "trigger": "点击编辑按钮",
        "steps": [
          "设置 editingProject 为当前项目，modalVisible 为 true",
          "用户修改表单并提交",
          "调用 API-003 更新项目",
          "成功后关闭模态框，刷新项目列表",
          "失败则显示错误信息"
        ]
      },
      {
        "id": "FLW-004",
        "name": "删除项目流程",
        "trigger": "点击删除按钮",
        "steps": [
          "弹出确认对话框",
          "如果用户确认，调用 API-004 删除项目",
          "成功后刷新项目列表",
          "如果删除的是当前高亮项目，重置 currentProjectId",
          "失败则显示错误信息"
        ]
      }
    ]
  },
  "data_models": [
    {
      "id": "DM-001",
      "name": "Project",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "前端展示用的项目模型，来源于后端接口返回",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "项目唯一标识"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "string",
          "required": false,
          "description": "创建时间 (ISO8601)，用于排序显示"
        },
        {
          "name": "updated_at",
          "type": "string",
          "required": false,
          "description": "更新时间"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "列表请求成功后创建实例数组",
        "update": "列表刷新或编辑成功时更新实例",
        "delete": "项目删除时移除对应实例",
        "retention": "页面卸载时可保留，但每次挂载重新请求"
      }
    },
    {
      "id": "DM-002",
      "name": "ProjectFormData",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "创建/编辑项目时使用的表单数据模型",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "项目描述"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": [
        "CTR-002",
        "CTR-003"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "打开新建模态框时初始化空实例",
        "update": "编辑模式下回填数据",
        "delete": "模态框关闭或提交后销毁",
        "retention": "暂不保留草稿"
      }
    },
    {
      "id": "DM-003",
      "name": "ProjectQuery",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "搜索与排序参数模型",
      "fields": [
        {
          "name": "search",
          "type": "string",
          "required": false,
          "description": "搜索关键词"
        },
        {
          "name": "sort_by",
          "type": "string",
          "required": false,
          "description": "排序字段，可选 'name', 'created_at'"
        },
        {
          "name": "order",
          "type": "string",
          "required": false,
          "description": "排序方向，可选 'asc', 'desc'"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-010"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "页面初始化及用户操作时创建/更新",
        "update": "搜索条件或排序变化时更新",
        "delete": "组件卸载时可销毁",
        "retention": "可能通过 URL 查询参数持久化"
      }
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "ProjectManagerPage",
      "method": "GET",
      "endpoint": "/projects",
      "type": "component_interface",
      "status": "active",
      "version": 1,
      "description": "项目管理页面的组件接口，定义组件的 props 和向外暴露的方法",
      "inputs": {
        "currentProjectId": {
          "type": "integer|null",
          "required": false,
          "description": "全局当前项目 ID"
        }
      },
      "outputs": {
        "onProjectSwitch": {
          "type": "function",
          "description": "切换项目时回调，传递新项目 ID"
        }
      },
      "lifecycle": {
        "mount": "获取项目列表",
        "update": "根据查询参数重新获取",
        "unmount": "清理定时器等资源"
      },
      "source_contracts": [
        "CTR-002"
      ]
    },
    {
      "id": "IF-002",
      "name": "ProjectServiceAPI",
      "method": "POST",
      "endpoint": "/api/projects",
      "type": "api_interface",
      "status": "active",
      "version": 1,
      "description": "项目服务 API 接口，供组件调用",
      "inputs": {
        "payload": {
          "type": "ProjectFormData",
          "required": true,
          "description": "创建项目的请求体"
        }
      },
      "outputs": {
        "project": {
          "type": "Project",
          "description": "创建成功返回的项目对象"
        }
      },
      "lifecycle": {},
      "source_contracts": [
        "CTR-003"
      ]
    },
    {
      "id": "IF-003",
      "name": "ProjectFormModal",
      "method": "POST",
      "endpoint": "/api/projects",
      "type": "component_interface",
      "status": "active",
      "version": 1,
      "description": "项目表单模态框的组件接口",
      "inputs": {
        "visible": {
          "type": "boolean",
          "required": true,
          "description": "控制模态框可见性"
        },
        "editingProject": {
          "type": "Project|null",
          "required": false,
          "description": "编辑模式下的项目数据"
        }
      },
      "outputs": {
        "onSubmit": {
          "type": "function",
          "description": "表单提交回调，传递 ProjectFormData"
        },
        "onCancel": {
          "type": "function",
          "description": "取消回调"
        }
      },
      "lifecycle": {},
      "source_contracts": [
        "CTR-003",
        "CTR-004"
      ]
    }
  ]
}