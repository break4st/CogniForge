  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeployHistoryService",
      "description": "部署历史领域服务接口",
      "methods": [
        {
          "name": "create_history",
          "description": "创建部署历史",
          "signature": "create_history(command: CreateDeployHistoryCommand) -> DeployHistory",
          "parameters": [
            {
              "name": "command",
              "type": "CreateDeployHistoryCommand",
              "description": "创建命令"
            }
          ],
          "returns": {
            "type": "DeployHistory",
            "description": "新创建的部署历史聚合"
          },
          "precondition": "command 参数校验通过；项目和环境存在",
          "postcondition": "返回新创建的 DeployHistory，状态为 pending；持久化至数据库",
          "errors": [
            "ValidationError",
            "EntityNotFoundError"
          ]
        },
        {
          "name": "list_histories",
          "description": "分页查询部署历史",
          "signature": "list_histories(query: DeployHistoryQuery) -> PaginatedResult<DeployHistory>",
          "parameters": [
            {
              "name": "query",
              "type": "DeployHistoryQuery",
              "description": "查询条件"
            }
          ],
          "returns": {
            "type": "PaginatedResult<DeployHistory>",
            "description": "分页结果"
          },
          "precondition": "query 参数合法",
          "postcondition": "返回符合条件的分页部署历史列表",
          "errors": [
            "ValidationError"
          ]
        },
        {
          "name": "get_history",
          "description": "获取单个部署历史",
          "signature": "get_history(history_id: int) -> DeployHistory",
          "parameters": [
            {
              "name": "history_id",
              "type": "int",
              "description": "部署历史ID"
            }
          ],
          "returns": {
            "type": "DeployHistory",
            "description": "部署历史聚合"
          },
          "precondition": "history_id 存在",
          "postcondition": "返回对应的部署历史",
          "errors": [
            "EntityNotFoundError"
          ]
        },
        {
          "name": "update_status",
          "description": "更新部署历史状态",
          "signature": "update_status(history_id: int, event: str) -> DeployHistory",
          "parameters": [
            {
              "name": "history_id",
              "type": "int",
              "description": "部署历史ID"
            },
            {
              "name": "event",
              "type": "str",
              "description": "触发事件名"
            }
          ],
          "returns": {
            "type": "DeployHistory",
            "description": "更新后的部署历史"
          },
          "precondition": "history_id 存在；事件合法；状态转换有效",
          "postcondition": "状态按状态机推进，返回更新后的部署历史",
          "errors": [
            "EntityNotFoundError",
            "InvalidTransitionError"
          ]
        },
        {
          "name": "add_log",
          "description": "向部署历史追加日志",
          "signature": "add_log(history_id: int, log: DeployLog) -> DeployLog",
          "parameters": [
            {
              "name": "history_id",
              "type": "int",
              "description": "部署历史ID"
            },
            {
              "name": "log",
              "type": "DeployLog",
              "description": "日志值对象"
            }
          ],
          "returns": {
            "type": "DeployLog",
            "description": "持久化后的日志记录"
          },
          "precondition": "history_id 存在",
          "postcondition": "将日志关联到部署历史并持久化，返回带ID的日志",
          "errors": [
            "EntityNotFoundError"
          ]
        },
        {
          "name": "get_logs",
          "description": "获取指定部署历史的所有日志",
          "signature": "get_logs(history_id: int) -> List[DeployLog]",
          "parameters": [
            {
              "name": "history_id",
              "type": "int",
              "description": "部署历史ID"
            }
          ],
          "returns": {
            "type": "List[DeployLog]",
            "description": "日志列表"
          },
          "precondition": "history_id 存在",
          "postcondition": "返回按时间排序的日志列表",
          "errors": [
            "EntityNotFoundError"
          ]
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "每次部署历史创建时状态必须为 pending",
      "enforcement": "hard",
      "scope": "create_history"
    },
    {
      "id": "BR-002",
      "description": "状态转换必须遵循状态机定义，不允许非法跳转",
      "enforcement": "hard",
      "scope": "update_status"
    },
    {
      "id": "BR-003",
      "description": "只能为自己管辖的部署历史添加日志",
      "enforcement": "hard",
      "scope": "add_log"
    },
    {
      "id": "BR-004",
      "description": "回滚时必须提供 rollback_from_id，且该记录状态为 success 或 failed",
      "enforcement": "hard",
      "scope": "rollback"
    }
  ],
  "error_handling": {
    "strategy": "统一错误码与异常层次化处理",
    "error_codes": [
      {
        "code": "NOT_FOUND",
        "http_status": 404,
        "message_template": "{resource} not found"
      },
      {
        "code": "VALIDATION_ERROR",
        "http_status": 400,
        "message_template": "Invalid {field}: {reason}"
      },
      {
        "code": "INVALID_STATE_TRANSITION",
        "http_status": 422,
        "message_template": "Cannot transition from {current} to {target} via {event}"
      },
      {
        "code": "INTERNAL_ERROR",
        "http_status": 500,
        "message_template": "Internal server error"
      }
    ],
    "exceptions": [
      {
        "name": "EntityNotFoundError",
        "parent": "NOT_FOUND"
      },
      {
        "name": "ValidationError",
        "parent": "VALIDATION_ERROR"
      },
      {
        "name": "InvalidTransitionError",
        "parent": "INVALID_STATE_TRANSITION"
      }
    ]
  }
}