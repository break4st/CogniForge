  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeployHistory",
      "object_type": "entity",
      "description": "部署历史聚合根，维护部署状态机及关联日志",
      "attributes": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "唯一标识"
        },
        {
          "name": "project_id",
          "type": "Integer",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "environment_id",
          "type": "Integer",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "version",
          "type": "String",
          "required": true,
          "description": "版本号"
        },
        {
          "name": "status",
          "type": "DeployStatus",
          "required": true,
          "description": "当前状态"
        },
        {
          "name": "started_at",
          "type": "DateTime",
          "required": true,
          "description": "开始时间"
        },
        {
          "name": "finished_at",
          "type": "DateTime",
          "required": false,
          "description": "完成时间"
        },
        {
          "name": "operator",
          "type": "String",
          "required": true,
          "description": "操作人"
        },
        {
          "name": "commit_sha",
          "type": "String",
          "required": false,
          "description": "提交哈希"
        },
        {
          "name": "rollback_from_id",
          "type": "Integer",
          "required": false,
          "description": "回滚来源ID"
        }
      ],
      "behaviors": [
        {
          "name": "create",
          "description": "新增一条部署历史"
        },
        {
          "name": "update_status",
          "description": "根据事件推进状态"
        },
        {
          "name": "add_log",
          "description": "关联部署日志"
        }
      ],
      "state_machine": {
        "states": [
          "pending",
          "running",
          "success",
          "failed",
          "cancelled",
          "rollback"
        ],
        "transitions": [
          {
            "from": "pending",
            "to": "running",
            "event": "start"
          },
          {
            "from": "running",
            "to": "success",
            "event": "finish_success"
          },
          {
            "from": "running",
            "to": "failed",
            "event": "finish_failure"
          },
          {
            "from": "running",
            "to": "cancelled",
            "event": "cancel"
          },
          {
            "from": "success",
            "to": "rollback",
            "event": "rollback"
          },
          {
            "from": "failed",
            "to": "rollback",
            "event": "rollback"
          }
        ]
      },
      "invariants": [
        "状态必须为预定义枚举之一",
        "终态不可逆（除回滚外）",
        "操作人不可为空"
      ]
    },
    {
      "id": "DO-002",
      "name": "DeployLog",
      "object_type": "value_object",
      "description": "单条部署日志值对象，不可变",
