        },
        {
          "name": "size",
          "type": "Integer",
          "required": false,
          "description": "每页大小"
        }
      ]
    },
    {
      "id": "DO-005",
      "name": "DeployStatus",
      "object_type": "enumeration",
      "description": "部署状态枚举",
      "attributes": [
        {
          "name": "values",
          "type": "set",
          "required": true,
          "description": "['pending', 'running', 'success', 'failed', 'cancelled', 'rollback']"
        }
      ]
    }
  ],
