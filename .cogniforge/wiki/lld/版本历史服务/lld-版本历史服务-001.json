      "attributes": [
        {
          "name": "project_id",
          "type": "Integer",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "environment_id",
          "type": "Integer",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "version",
          "type": "String",
          "required": true,
          "description": "版本号"
        },
        {
          "name": "operator",
          "type": "String",
          "required": true,
          "description": "操作人"
        },
        {
          "name": "commit_sha",
          "type": "String",
          "required": false,
          "description": "提交哈希"
        }
      ]
    },
    {
      "id": "DO-004",
      "name": "DeployHistoryQuery",
      "object_type": "query",
      "description": "部署历史查询对象",
      "attributes": [
        {
          "name": "project_id",
          "type": "Integer",
          "required": false,
          "description": "按项目过滤"
        },
        {
          "name": "environment_id",
          "type": "Integer",
          "required": false,
          "description": "按环境过滤"
        },
        {
          "name": "status",
          "type": "DeployStatus",
          "required": false,
          "description": "按状态过滤"
        },
        {
          "name": "page",
          "type": "Integer",
