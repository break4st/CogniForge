        },
        {
          "name": "stdout",
          "type": "string",
          "required": true,
          "description": "标准输出内容"
        },
        {
          "name": "stderr",
          "type": "string",
          "required": true,
          "description": "标准错误输出内容"
        },
        {
          "name": "execution_time_ms",
          "type": "integer",
          "required": true,
          "description": "执行耗时（毫秒）"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "execute_command 调用返回时生成",
        "update": "不可变",
        "delete": "调用方处理完毕后释放",
        "retention": "临时对象，不存储"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "FileTransferResult",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "source": {},
      "description": "SFTP 文件传输操作的返回值",
      "fields": [
        {
          "name": "success",
          "type": "boolean",
          "required": true,
          "description": "是否成功"
        },
        {
          "name": "bytes_transferred",
          "type": "integer",
          "required": true,
          "description": "实际传输字节数"
        },
        {
          "name": "remote_path",
          "type": "string",
          "required": true,
          "description": "目标文件在远程主机上的绝对路径"
        },
        {
          "name": "error_message",
          "type": "string",
          "required": false,
          "description": "失败时的错误信息"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "upload_file/download_file 调用返回时生成",
        "update": "不可变",
        "delete": "调用方处理完毕后释放",
