  "module_boundary": {
    "in_scope": [
      "SSH 连接的建立（密码/密钥认证）",
      "连接保活与状态查询",
      "远程命令执行（阻塞式，返回标准输出、错误输出和退出码）",
      "SFTP 文件上传和下载",
      "连接的主动断开与资源回收",
      "连接参数的安全存储（内存中）和生命周期管理",
      "常见网络/认证异常的捕获与转换"
    ],
    "out_of_scope": [
      "部署流程的编排和重试策略",
      "用户权限验证与访问控制",
      "目标主机密钥分发与管理",
      "命令执行结果的业务解析"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001",
      "DM-002",
      "DM-003",
      "DM-004"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "SSHService 是一个基础设施层服务，封装 paramiko 库，提供统一的 SSH 连接、远程命令执行和 SFTP 文件传输能力。不关心业务逻辑，只负责底层通信的建立、维护与销毁，以及操作的原子性调用。",
    "dependencies": [],
    "tech_stack": [
      "Python 3.11",
      "paramiko"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002",
          "DM-003",
          "DM-004"
        ],
        "interfaces": [
          "IF-001",
          "IF-002",
          "IF-003",
          "IF-004",
          "IF-005",
          "IF-006"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "核心需求：系统必须能够通过 SSH 协议远程连接到目标主机，并执行单条命令或上传/下载文件"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "SSHConnectionConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "source": {},
      "description": "封装建立 SSH 连接所需的全部参数，由调用方传入",
      "fields": [
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "目标主机 IP 或域名"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "SSH 端口，默认 22"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "登录用户名"
        },
        {
          "name": "password",
          "type": "string",
          "required": false,
          "description": "密码认证时使用"
        },
        {
          "name": "private_key",
          "type": "string",
          "required": false,
          "description": "私钥认证时使用，格式为 PEM 字符串"
        },
        {
          "name": "timeout",
          "type": "integer",
          "required": false,
          "description": "连接超时秒数，默认 10"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [
        "password 和 private_key 至少提供一个"
      ],
      "lifecycle": {
        "create": "调用 connect 时由调用方构造",
        "update": "不可变",
        "delete": "连接建立后销毁副本",
        "retention": "内存中短期保存，不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "CommandResult",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "source": {},
      "description": "远程命令执行后的返回结果",
      "fields": [
        {
          "name": "exit_code",
          "type": "integer",
          "required": true,
