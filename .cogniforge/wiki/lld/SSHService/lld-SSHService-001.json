{
  "meta": {
    "doc_id": "lld-SSHService-001",
    "type": "lld",
    "module_type": "service",
    "module": "SSHService",
    "title": "SSHService 详细设计文档",
    "author": "design_agent",
    "created": "2025-04-09T10:00:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": ["REQ-002", "REQ-003", "REQ-004"]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": ["CMP-105"],
      "contracts": ["CTR-010"],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "建立和管理 SSH 连接，维护连接复用池",
      "在已建立的连接上执行远程命令",
      "提供 SFTP 文件上传与下载、远程文件校验、远程路径存在性检查",
      "连接生命周期的管理：创建、心跳保持、空闲超时回收、异常销毁"
    ],
    "out_of_scope": [
      "业务部署流程的编排（由 DeploymentService、RollbackService 负责）",
      "凭据加解密与主密码管理（由 SecurityService 负责，SSHService 仅接收已解密的连接参数）",
      "日志的持久化或前端推送（由 LoggerService 负责）",
      "数据库操作（SSHService 不直接读写数据库）"
    ],
    "owned_components": ["CMP-105"],
    "owned_contracts": ["CTR-010"],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "封装基于 Node.js ssh2 库的远程服务器访问能力，向上层服务提供透明的命令执行和文件传输功能。内部采用连接池复用机制，按「主机:端口:用户名」维度缓存连接，减少重复握手开销。",
    "dependencies": [],
    "tech_stack": ["TypeScript", "Node.js (Electron 主进程环境)", "ssh2"]
  },
  "traceability": [
    {
      "requirement_id": "REQ-002",
      "sad_component_ids": ["CMP-105"],
      "sad_contract_ids": ["CTR-010"],
      "lld_objects": {
        "data_models": [],
        "interfaces": ["IF-001"],
        "domain_objects": ["DO-001", "DO-002", "DO-003", "DO-004", "DO-005"],
        "service_contracts": ["SC-001"]
      },
      "coverage": "full",
      "notes": "SSHService 主要服务于一键部署、回滚及环境验证中的远程操作需求 (REQ-002/003/004)。SAD 原有 CTR-010 仅定义 execute 接口，LLD 根据实际需求补充了 upload/download 等服务层方法。"
    },
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": ["CMP-105"],
      "sad_contract_ids": ["CTR-010"],
      "lld_objects": {
        "data_models": [],
        "interfaces": ["IF-001"],
        "domain_objects": ["DO-001", "DO-002"],
        "service_contracts": ["SC-002", "SC-003"]
      },
      "coverage": "full",
      "notes": "回滚操作需执行远程命令并验证路径存在性，SSHService 提供 execute 和 checkPath 能力。"
    },
    {
      "requirement_id": "REQ-004",
      "sad_component_ids": ["CMP-105"],
      "sad_contract_ids": ["CTR-010"],
      "lld_objects": {
        "data_models": [],
        "interfaces": ["IF-001"],
        "domain_objects": ["DO-001"],
        "service_contracts": ["SC-004"]
      },
      "coverage": "full",
      "notes": "环境验证需要建立连接并检查远程信息，SSHService 提供连接管理和执行能力。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "ConnectionConfig",
      "type": "struct",
      "description": "SSH 连接配置参数",
      "ownership": "owned",
      "fields": [
        { "name": "host", "type": "string", "description": "主机地址", "required": true },
        { "name": "port", "type": "number", "description": "SSH 端口", "required": true },
        { "name": "username", "type": "string", "description": "登录用户名", "required": true },
        { "name": "authType", "type": "string", "description": "认证类型: password 或 privateKey", "required": true },
        { "name": "password", "type": "string", "description": "密码，authType为password时必填", "required": false },
        { "name": "privateKey", "type": "string", "description": "私钥内容，authType为privateKey时必填", "required": false },
        { "name": "passphrase", "type": "string", "description": "私钥密码短语", "required": false },
        { "name": "readyTimeout", "type": "number", "description": "连接超时时间(ms)", "required": false },
        { "name": "keepaliveInterval", "type": "number", "description": "心跳间隔(ms)", "required": false }
      ]
    },
    {
      "id": "DM-002",
      "name": "CommandResult",
      "type": "struct",
      "description": "远程命令执行结果",
      "ownership": "owned",
      "fields": [
        { "name": "stdout", "type": "string", "description": "标准输出", "required": true },
        { "name": "stderr", "type": "string", "description": "标准错误", "required": true }
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "SSHConnection",
      "object_type": "entity",
      "description": "SSH 连接实例封装，生命周期由连接池管理",
      "attributes": [
        { "name": "client", "type": "ssh2.Client", "description": "ssh2客户端实例", "required": true, "source": "db" },
        { "name": "config", "type": "ConnectionConfig", "description": "连接配置", "required": true, "source": "db" },
        { "name": "status", "type": "ConnectionStatus", "description": "当前连接状态", "required": true, "source": "db" },
        { "name": "createdAt", "type": "Date", "description": "创建时间", "required": true, "source": "db" },
        { "name": "lastUsedAt", "type": "Date", "description": "最后使用时间", "required": true, "source": "db" }
      ]
    },
    {
      "id": "DO-002",
      "name": "ConnectionStatus",
      "object_type": "enum",
      "description": "连接状态枚举",
      "values": ["CONNECTING", "READY", "CLOSED", "ERROR"]
    },
    {
      "id": "DO-003",
      "name": "SFTPStream",
      "object_type": "entity",
      "description": "SFTP 流封装，用于文件传输操作",
      "attributes": [
        { "name": "stream", "type": "ssh2.SFTPWrapper", "description": "SFTP流实例", "required": true, "source": "db" },
        { "name": "connectionId", "type": "string", "description": "关联的连接ID", "required": true, "source": "db" }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "ISSHService",
      "description": "SSH服务公开接口定义，包含远程命令执行和文件传输方法",
      "methods": [
        {
          "name": "execute",
          "description": "在远程服务器上执行命令",
          "parameters": [
            { "name": "config", "type": "ConnectionConfig", "description": "连接配置" },
            { "name": "command", "type": "string", "description": "要执行的命令" }
          ],
          "return_type": "Promise<CommandResult>"
        },
        {
          "name": "upload",
          "description": "上传本地文件到远程服务器",
          "parameters": [
            { "name": "config", "type": "ConnectionConfig", "description": "连接配置" },
            { "name": "localPath", "type": "string", "description": "本地文件路径" },
            { "name": "remotePath", "type": "string", "description": "远程目标路径" }
          ],
          "return_type": "Promise<void>"
        },
        {
          "name": "download",
          "description": "从远程服务器下载文件到本地",
          "parameters": [
            { "name": "config", "type": "ConnectionConfig", "description": "连接配置" },
            { "name": "remotePath", "type": "string", "description": "远程文件路径" },
            { "name": "localPath", "type": "string", "description": "本地目标路径" }
          ],
          "return_type": "Promise<void>"
        },
        {
          "name": "checkPath",
          "description": "检查远程路径是否存在",
          "parameters": [
            { "name": "config", "type": "ConnectionConfig", "description": "连接配置" },
            { "name": "path", "type": "string", "description": "要检查的远程路径" }
          ],
          "return_type": "Promise<boolean>"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "SSHService.execute",
      "methods": [
        {
          "name": "execute",
          "description": "执行远程命令",
          "precondition": "config 参数必须包含有效的主机、端口、用户名和认证信息",
          "postcondition": "返回包含 stdout 和 stderr 的 CommandResult 对象",
          "signature": "execute(config: ConnectionConfig, command: string): Promise<CommandResult>"
        }
      ]
    },
    {
      "id": "SC-002",
      "name": "SSHService.upload",
      "methods": [
        {
          "name": "upload",
          "description": "上传文件到远程服务器",
          "precondition": "本地文件必须存在且可读，远程路径的父目录必须存在",
          "postcondition": "远程路径包含上传的文件内容",
          "signature": "upload(config: ConnectionConfig, localPath: string, remotePath: string): Promise<void>"
        }
      ]
    },
    {
      "id": "SC-003",
      "name": "SSHService.download",
      "methods": [
        {
          "name": "download",
          "description": "从远程服务器下载文件",
          "precondition": "远程文件必须存在且可读",
          "postcondition": "本地路径包含下载的文件内容",
          "signature": "download(config: ConnectionConfig, remotePath: string, localPath: string): Promise<void>"
        }
      ]
    },
    {
      "id": "SC-004",
      "name": "SSHService.checkPath",
      "methods": [
        {
          "name": "checkPath",
          "description": "检查远程路径是否存在",
          "precondition": "无",
          "postcondition": "返回布尔值表示路径是否存在",
          "signature": "checkPath(config: ConnectionConfig, path: string): Promise<boolean>"
        }
      ]
    }
  ],
  "error_handling": {
    "errors": [
      {
        "code": "CONNECTION_TIMEOUT",
        "message": "SSH 连接超时",
        "description": "在指定超时时间内未能建立 SSH 连接",
        "http_status": 504,
        "handling": "重试 3 次，间隔指数退避；最终向上层抛出 ConnectionError"
      },
      {
        "code": "AUTHENTICATION_FAILED",
        "message": "SSH 认证失败",
        "description": "提供的凭据无法通过远程服务器认证",
        "http_status": 401,
        "handling": "检查凭据有效性，抛出 AuthenticationError，由 SecurityService 提示用户重新输入"
      },
      {
        "code": "COMMAND_EXECUTION_FAILED",
        "message": "远程命令执行失败",
        "description": "远程命令执行过程中发生错误，可能为非零退出码",
        "http_status": 500,
        "handling": "捕获 stderr 并封装进 CommandResult，由调用方根据退出码判断并处理"
      },
      {
        "code": "FILE_TRANSFER_ERROR",
        "message": "文件传输失败",
        "description": "SFTP 文件上传或下载过程中发生错误",
        "http_status": 500,
        "handling": "记录错误详情，抛出 FileTransferError，由调用方决定重试或取消"
      },
      {
        "code": "PATH_NOT_FOUND",
        "message": "远程路径不存在",
        "description": "尝试访问的远程路径不存在",
        "http_status": 404,
        "handling": "返回 false，由调用方按业务逻辑处理"
      }
    ]
  },
  "business_rules": {
    "rules": [
      {
        "id": "BR-001",
        "rule": "连接复用",
        "description": "同一 host:port:username 的连接被复用，避免重复建立连接",
        "invariants": "连接池大小上限为 10，超出时关闭最旧空闲连接"
      },
      {
        "id": "BR-002",
        "rule": "心跳保持",
        "description": "对空闲连接定期发送心跳包以保持连接活跃",
        "invariants": "心跳间隔默认 30 秒，可在 ConnectionConfig.keepaliveInterval 中覆盖"
      },
      {
        "id": "BR-003",
        "rule": "空闲超时回收",
        "description": "连接在空闲超过阈值后自动关闭并从池中移除",
        "invariants": "空闲超时默认 300 秒，池中至少保留一个连接"
      },
      {
        "id": "BR-004",
        "rule": "重试策略",
        "description": "连接建立失败时实施重试，避免瞬间故障导致操作失败",
        "invariants": "最多重试 3 次，指数退避，初始间隔 1 秒"
      }
    ]
  },
  "workflow": {
    "id": "WF-001",
    "name": "SSH命令执行流程",
    "steps": [
      {
        "id": "step1",
        "description": "验证连接配置参数",
        "next": "step2"
      },
      {
        "id": "step2",
        "description": "从连接池获取或创建连接",
        "next": "step3"
      },
      {
        "id": "step3",
        "description": "建立SSH会话并执行命令",
        "next": "step4"
      },
      {
        "id": "step4",
        "description": "收集stdout和stderr输出",
        "next": "step5"
      },
      {
        "id": "step5",
        "description": "返回CommandResult"
      }
    ]
  }
}