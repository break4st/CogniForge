      ]
    },
    {
      "id": "DM-004",
      "name": "ConnectionStatus",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "source": {},
      "description": "描述当前 SSH 连接的状态",
      "fields": [
        {
          "name": "is_connected",
          "type": "boolean",
          "required": true,
          "description": "是否处于连接状态"
        },
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "已连接的主机地址"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "已连接的端口"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "当前登录的用户名"
        },
        {
          "name": "connected_since",
          "type": "string",
          "required": false,
          "description": "连接建立的时间戳（ISO 8601）"
        }
      ],
      "indexes": [],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "在连接建立后由内部状态产生",
        "update": "连接状态变化时更新",
        "delete": "连接断开后清理",
        "retention": "内存常驻，连接存活期间有效"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "connect",
      "type": "function",
      "description": "建立到目标主机的 SSH 连接，认证并打开 SFTP 通道",
      "method": "POST",
      "endpoint": "/ssh/connect",
      "inputs": [
        {
          "name": "config",
          "type": "SSHConnectionConfig",
          "required": true,
          "description": "连接参数对象"
        }
      ],
      "outputs": [
        {
          "name": "status",
          "type": "ConnectionStatus",
          "description": "连接建立后的状态信息"
        }
      ],
      "exceptions": [
        "AuthenticationException",
        "ConnectionTimeoutException",
        "SSHException"
      ]
    },
    {
      "id": "IF-002",
      "name": "disconnect",
      "type": "function",
      "description": "主动关闭 SSH 连接并释放所有关联资源",
      "method": "POST",
      "endpoint": "/ssh/disconnect",
      "inputs": [],
      "outputs": [
        {
          "name": "status",
          "type": "ConnectionStatus",
          "description": "断开后的状态信息（通常是 is_connected=false）"
        }
      ],
      "exceptions": [
        "SSHException"
      ]
    },
    {
      "id": "IF-003",
      "name": "execute_command",
      "type": "function",
      "description": "在已连接的主机上执行单条命令（阻塞模式）",
      "method": "POST",
      "endpoint": "/ssh/execute",
      "inputs": [
        {
          "name": "command",
          "type": "string",
          "required": true,
          "description": "要执行的命令行字符串"
        },
        {
          "name": "timeout",
          "type": "integer",
          "required": false,
          "description": "命令执行超时秒数，默认 0（无限等待）"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "CommandResult",
          "description": "命令执行结果"
        }
      ],
      "exceptions": [
        "NotConnectedException",
        "CommandTimeoutException",
        "SSHException"
      ]
    },
    {
      "id": "IF-004",
      "name": "upload_file",
      "type": "function",
      "description": "通过 SFTP 上传本地文件到远程主机",
      "method": "POST",
      "endpoint": "/ssh/upload",
      "inputs": [
        {
          "name": "local_path",
          "type": "string",
          "required": true,
          "description": "本地文件路径"
        },
        {
          "name": "remote_path",
          "type": "string",
          "required": true,
          "description": "远程目标路径（含文件名）"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "FileTransferResult",
          "description": "上传结果"
        }
      ],
      "exceptions": [
        "NotConnectedException",
        "FileNotFoundException",
        "PermissionException",
        "SSHException"
      ]
    },
    {
      "id": "IF-005",
      "name": "download_file",
      "type": "function",
      "description": "通过 SFTP 从远程主机下载文件到本地",
      "method": "POST",
      "endpoint": "/ssh/download",
      "inputs": [
        {
          "name": "remote_path",
          "type": "string",
          "required": true,
          "description": "远程文件路径"
        },
        {
          "name": "local_path",
          "type": "string",
          "required": true,
          "description": "本地保存路径（含文件名）"
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type": "FileTransferResult",
          "description": "下载结果"
        }
      ],
      "exceptions": [
        "NotConnectedException",
        "FileNotFoundException",
        "PermissionException",
        "SSHException"
      ]
    },
    {
      "id": "IF-006",
      "name": "get_status",
      "type": "function",
      "description": "查询当前连接的实时状态",
      "method": "GET",
      "endpoint": "/ssh/status",
      "inputs": [],
      "outputs": [
        {
          "name": "status",
          "type": "ConnectionStatus",
          "description": "连接状态对象"
        }
      ],
      "exceptions": []
    }
  ],
  "topology": {
    "exchanges": [],
    "namespaces": [],
    "buckets": [
      {
        "name": "ssh_connections",
        "description": "虚拟机级别的单例 SSH 连接持有者，确保同一实例内连接唯一性"
      }
    ],
    "structure": "monolith"
  },
  "error_handling": {
    "strategy": "将所有 paramiko 异常转换为自定义异常子类 (SSHException)，并区分认证、网络、操作错误。在 connect 阶段捕获并抛出 AuthenticationException 和 ConnectionTimeoutException；在命令执行阶段抛出 NotConnectedException 和 CommandTimeoutException；在文件传输阶段抛出 FileNotFoundException 和 PermissionException；其余所有底层异常包装为通用 SSHException。",
    "rules": [
      {
        "exception": "AuthenticationException",
        "trigger": "connect 时提供的凭证无效或认证失败",
        "action": "抛出 AuthenticationException，记录警告日志，由上层决策重试或终止"
      },
      {
        "exception": "ConnectionTimeoutException",
        "trigger": "connect 时在 timeout 秒内未完成 TCP 连接或 SSH 握手",
        "action": "抛出 ConnectionTimeoutException，提示网络可达性或端口错误"
      },
      {
        "exception": "NotConnectedException",
        "trigger": "在未建立连接时调用 execute_command / upload_file / download_file",
        "action": "抛出 NotConnectedException，要求调用方先调用 connect"
      },
      {
        "exception": "CommandTimeoutException",
        "trigger": "命令执行超过给定的 timeout 秒",
        "action": "抛出 CommandTimeoutException，可能保留部分输出"
      },
      {
        "exception": "SSHException",
        "trigger": "其他所有与 SSH 协议相关的底层错误",
        "action": "包装原始异常，记录错误日志，向上传递"
      }
    ]
  }
}