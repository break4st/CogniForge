  "interfaces": [
    {
      "id": "IF-001",
      "name": "createDeployment",
      "method": "POST",
      "endpoint": "/api/deployments",
      "description": "创建一次新的部署，异步执行",
      "parameters": [
        {
          "name": "body",
          "type": "CreateDeploymentRequest",
          "description": "部署请求体"
        }
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "Integer",
          "project_id": "Integer",
          "environment_name": "String",
          "script_name": "String",
          "status": "String",
          "requested_by": "String",
          "started_at": "DateTime",
          "finished_at": "DateTime",
          "result_summary": "String",
          "steps": "List[StepResponse]"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "参数校验失败"
        },
        {
          "code": 409,
          "message": "相同环境已有进行中的部署"
        },
        {
          "code": 422,
          "message": "模板或环境不存在"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "getDeployment",
      "method": "GET",
      "endpoint": "/api/deployments/{id}",
      "description": "查询单次部署的详情",
      "parameters": [
        {
          "name": "id",
          "type": "Integer",
          "description": "部署ID",
          "required": true
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "Integer",
          "project_id": "Integer",
          "environment_name": "String",
          "script_name": "String",
          "status": "String",
          "requested_by": "String",
          "started_at": "DateTime",
          "finished_at": "DateTime",
          "result_summary": "String",
          "steps": "List[StepResponse]"
        }
      },
      "error_codes": [
        {
          "code": 404,
          "message": "部署不存在"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "getDeploymentLog",
      "method": "GET",
      "endpoint": "/api/deployments/{id}/log",
      "description": "获取部署的完整日志文本",
      "parameters": [
        {
          "name": "id",
          "type": "Integer",
          "description": "部署ID"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "log": "String"
        }
      },
      "error_codes": [
        {
          "code": 404,
          "message": "部署不存在"
        }
      ]
    },
    {
      "id": "IF-004",
      "name": "listDeployments",
      "method": "GET",
      "endpoint": "/api/deployments",
      "description": "列出项目的部署历史",
      "parameters": [
        {
          "name": "project_id",
          "type": "Integer",
          "description": "项目ID",
          "required": true
        },
        {
          "name": "page",
          "type": "Integer",
          "description": "页码",
          "required": false
        },
        {
          "name": "size",
          "type": "Integer",
          "description": "每页大小",
          "required": false
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "List[DeploymentResponse]",
          "total": "Integer"
        }
      },
      "error_codes": [
        {
          "code": 404,
          "message": "项目不存在"
        }
      ]
    },
    {
      "id": "IF-005",
      "name": "cancelDeployment",
      "method": "POST",
      "endpoint": "/api/deployments/{id}/cancel",
      "description": "取消一个正在运行的部署",
      "parameters": [
        {
          "name": "id",
          "type": "Integer",
          "description": "部署ID"
        }
      ],
      "response": {
        "status": 202,
        "body": {
          "id": "Integer",
          "project_id": "Integer",
          "environment_name": "String",
          "script_name": "String",
          "status": "String",
          "requested_by": "String",
          "started_at": "DateTime",
          "finished_at": "DateTime",
          "result_summary": "String",
          "steps": "List[StepResponse]"
        }
      },
      "error_codes": [
        {
          "code": 404,
          "message": "部署不存在"
        },
        {
          "code": 409,
          "message": "部署状态不允许取消"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "所有异常返回统一的 JSON 格式 {\"code\": <http_status>, \"error\": \"<错误类型>\", \"detail\": \"<具体描述>\"}，业务异常映射到合适的 HTTP 状态码。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "包括 400 参数校验失败、404 资源未找到、409 业务规则冲突等，由请求方修正后重试。"
      },
      {
        "code": "5xx",
        "name": "服务端错误",
        "description": "包括 500 内部未知异常、502 SSH连接失败、503 依赖服务不可用等，需运维介入。"
      }
    ]
  },
