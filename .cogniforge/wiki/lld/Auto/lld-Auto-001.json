{
  "meta": {
    "doc_id": "lld-Auto-001",
    "type": "lld",
    "module_type": "service",
    "module": "Auto",
    "title": "自动化部署执行服务详细设计",
    "author": "design_agent",
    "created": "2025-03-20T10:00:00Z"
  },
  "overview": {
    "description": "自动化部署执行服务，作为部署流程的中央协调者，接收部署请求，通过异步任务调用 SSH 执行脚本，并记录状态与日志。",
    "dependencies": [
      "环境配置服务",
      "密钥管理服务",
      "脚本模板服务",
      "版本历史服务"
    ],
    "tech_stack": [
      "Python 3.10+",
      "FastAPI",
      "SQLAlchemy",
      "asyncssh",
      "SQLite",
      "Uvicorn"
    ]
  },
  "data_models": [
    {
