          "name": "output",
          "type": "String",
          "required": false,
          "source": "db",
          "description": "输出"
        },
        {
          "name": "started_at",
          "type": "DateTime",
          "required": false,
          "source": "db",
          "description": "开始时间"
        },
        {
          "name": "finished_at",
          "type": "DateTime",
          "required": false,
          "source": "db",
          "description": "结束时间"
        }
      ]
    },
    {
      "name": "DeploymentStatus",
      "object_type": "enum",
      "description": "部署状态枚举",
      "values": [
        "PENDING",
        "RUNNING",
        "SUCCESS",
        "FAILED",
        "CANCELLED"
      ]
    },
    {
      "name": "StepStatus",
      "object_type": "enum",
      "description": "步骤状态枚举",
      "values": [
        "PENDING",
        "RUNNING",
        "SUCCESS",
        "FAILED",
        "SKIPPED"
      ]
    }
  ],
  "service_contracts": [
    {
      "name": "DeploymentService",
      "description": "核心部署业务服务，负责创建、查询、取消部署并协调 SSH 执行",
      "methods": [
        {
          "name": "createDeployment",
          "signature": "(dto: CreateDeploymentRequest) -> DeploymentResponse",
          "precondition": "dto 所有必填字段非空；environment_id 对应的环境存在且属于 project_id；script_template_id 对应的模板存在；该 project_id 和 environment_id 组合下没有状态为 PENDING 或 RUNNING 的部署。",
          "postcondition": "数据库新增一条 Deployment 记录，状态为 PENDING，并启动异步执行任务；返回包含新 ID 和初始状态的 DeploymentResponse。",
          "description": "验证请求参数，检查业务规则，创建部署记录并触发异步执行。",
          "exceptions": [
            {
              "name": "EnvironmentNotFound",
              "trigger": "环境不存在或不属于该项目",
              "http_status": 422
            },
            {
              "name": "TemplateNotFound",
              "trigger": "脚本模板不存在",
              "http_status": 422
            },
            {
              "name": "DuplicateActiveDeployment",
              "trigger": "同一环境已有进行中的部署",
              "http_status": 409
            }
          ]
        },
        {
          "name": "getDeployment",
          "signature": "(deployment_id: int) -> DeploymentResponse",
          "precondition": "deployment_id 对应的部署记录存在。",
          "postcondition": "返回部署及其最新步骤状态的 DTO。",
          "description": "根据 ID 查询部署详情，加载关联步骤并组装响应。",
          "exceptions": [
            {
              "name": "DeploymentNotFound",
              "trigger": "部署记录不存在",
              "http_status": 404
            }
          ]
        },
        {
          "name": "listDeployments",
          "signature": "(project_id: int, page: int, size: int) -> Page<DeploymentResponse>",
          "precondition": "project_id 对应的项目存在。",
          "postcondition": "返回该项目下按创建时间倒序的分页部署摘要列表。",
          "description": "获取项目下的部署历史列表。",
          "exceptions": [
            {
              "name": "ProjectNotFound",
              "trigger": "项目不存在",
              "http_status": 404
            }
          ]
        },
        {
          "name": "cancelDeployment",
          "signature": "(deployment_id: int) -> DeploymentResponse",
          "precondition": "部署存在且状态为 RUNNING。",
          "postcondition": "部署状态变为 CANCELLED，关联的 SSH 任务被终止，完成时间被记录。",
          "description": "取消正在进行的部署，更新状态并释放资源。",
          "exceptions": [
            {
              "name": "DeploymentNotFound",
              "trigger": "部署不存在",
              "http_status": 404
            },
            {
              "name": "InvalidStateTransition",
              "trigger": "部署状态不是 RUNNING",
              "http_status": 409
            }
          ]
        },
        {
          "name": "getDeploymentLog",
          "signature": "(deployment_id: int) -> str",
          "precondition": "部署记录存在。",
          "postcondition": "返回所有步骤输出拼接后的纯文本。",
          "description": "获取部署的完整日志文件。",
          "exceptions": [
            {
              "name": "DeploymentNotFound",
              "trigger": "部署不存在",
              "http_status": 404
            }
          ]
        }
      ],
      "repository_dependencies": [
        "find_by_project_and_env_active(project_id: int, environment_id: int) -> Deployment?",
        "create_deployment(dto: CreateDeploymentRequest) -> Deployment",
        "find_deployment_by_id(id: int) -> Deployment?",
        "list_deployments_by_project(project_id: int, page: int, size: int) -> (List[Deployment], total: int)",
        "add_step(deployment_id: int, step_data: dict) -> DeploymentStep",
        "update_step_status(step_id: int, status: str, output: str, finished_at: datetime) -> None",
        "update_deployment_status(id: int, status: str, result_summary: str, finished_at: datetime) -> None"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "部署状态一旦进入 SUCCESS、FAILED 或 CANCELLED 之后不可再变更为其他状态。",
      "同一个项目+环境组合上，同一时刻最多只能有一个 PENDING 或 RUNNING 状态的部署。",
      "每个 Deployment 至少包含一个 DeploymentStep。",
      "步骤必须按 step_order 顺序执行，不可跳过中间步骤直接执行后续未开始步骤。"
    ],
    "state_machines": [
      {
        "entity": "Deployment",
        "states": [
          "PENDING",
          "RUNNING",
          "SUCCESS",
          "FAILED",
          "CANCELLED"
        ],
        "transitions": [
          {
            "from": "PENDING",
            "to": "RUNNING",
            "trigger": "异步任务启动",
            "actor": "系统"
          },
          {
            "from": "RUNNING",
            "to": "SUCCESS",
            "trigger": "所有步骤执行成功",
            "actor": "系统"
          },
          {
            "from": "RUNNING",
            "to": "FAILED",
            "trigger": "某步骤执行失败",
            "actor": "系统"
          },
          {
            "from": "RUNNING",
            "to": "CANCELLED",
            "trigger": "用户取消操作或超时",
            "actor": "用户或系统"
          }
        ],
        "irreversible_rules": [
          "SUCCESS、FAILED、CANCELLED 不可再转变为其他状态，任何尝试都会抛出 InvalidStateTransition。"
        ],
        "concurrency": "在创建部署时，通过数据库唯一约束（project_id + environment_id + status IN ('PENDING','RUNNING')）或应用层乐观锁检查，防止并发创建多个活跃部署。"
      },
      {
        "entity": "DeploymentStep",
        "states": [
          "PENDING",
          "RUNNING",
          "SUCCESS",
          "FAILED",
          "SKIPPED"
        ],
        "transitions": [
          {
            "from": "PENDING",
            "to": "RUNNING",
            "trigger": "当前步骤开始执行",
            "actor": "系统"
          },
          {
            "from": "RUNNING",
            "to": "SUCCESS",
            "trigger": "脚本执行成功",
            "actor": "系统"
          },
          {
            "from": "RUNNING",
            "to": "FAILED",
            "trigger": "脚本执行失败或超时",
            "actor": "系统"
          },
          {
            "from": "RUNNING",
            "to": "SKIPPED",
            "trigger": "用户手动标记跳过（仅限失败后）",
            "actor": "用户"
          }
        ],
        "irreversible_rules": [
          "SUCCESS、FAILED、SKIPPED 不可再变更为 RUNNING 或 PENDING。"
        ],
        "concurrency": "步骤按顺序线性执行，无需额外并发控制，由异步任务单线程推动。"
      }
    ],
    "cross_service_rules": [
      "创建部署时，需调用环境配置服务验证环境归属并获取完整信息；调用密钥管理服务解密私钥（仅在 SSH 连接时使用）；调用脚本模板服务进行变量替换生成最终脚本。",
      "部署成功后（状态变为 SUCCESS），异步调用版本历史服务的记录接口，传递脚本版本、环境快照等信息。",
      "取消部署时，需确保 SSH 连接被终止，并在可能的情况下调用环境或密钥服务的资源释放逻辑（如关闭会话）。"
    ]
  }
}