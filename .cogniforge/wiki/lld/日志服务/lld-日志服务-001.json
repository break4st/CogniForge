  "module_boundary": {
    "in_scope": [
      "接收部署引擎产生的步骤日志并结构化存储",
      "管理WebSocket连接，按部署ID分组实时推送日志至客户端",
      "部署结束时推送最终状态消息并主动关闭WebSocket连接",
      "提供历史日志查询接口，支持按部署ID、项目、环境、时间范围等过滤"
    ],
    "out_of_scope": [
      "部署流程的编排与执行",
      "环境配置管理及SSH连接",
      "用户认证与鉴权（由网关层统一处理）",
      "日志的聚合分析与告警"
    ],
    "owned_components": ["CMP-007"],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "日志服务负责接收部署引擎在执行每一步操作时产生的结构化日志条目，将其持久化到数据库，并通过WebSocket即时推送给发起部署的桌面客户端。同时提供历史日志检索能力。",
    "dependencies": [
      "部署引擎 (CMP-006)",
      "数据持久层 (CMP-011)",
      "API网关 (CMP-002)"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "SQLite (via SQLAlchemy)",
      "asyncio"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-004",
