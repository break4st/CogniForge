  "service_contracts": [
    {
      "id": "SC-001",
      "name": "LogService",
      "description": "日志服务契约：提供实时日志流和历史查询功能。",
      "methods": [
        {
          "name": "connect_log_stream",
          "description": "客户端通过WebSocket连接到指定部署的日志流，服务端持续推送日志条目。",
          "signature": "async connect_log_stream(websocket: WebSocket, deployment_id: int) -> None",
          "precondition": "deployment_id 必须存在且部署正在进行中",
          "postcondition": "WebSocket连接建立，并持续推送日志直到部署结束或客户端断开",
          "parameters": [
            {
              "name": "websocket",
              "type": "WebSocket",
              "description": "WebSocket连接对象"
            },
            {
              "name": "deployment_id",
              "type": "int",
              "description": "部署ID"
            }
          ],
          "return_type": "None",
          "exceptions": [
            {
              "name": "WebSocketDisconnect",
              "description": "客户端连接中断",
              "status": "error",
              "trigger": "当客户端网络断开或关闭连接时"
            },
            {
              "name": "DeploymentNotFound",
              "description": "部署ID不存在",
              "status": "error",
              "trigger": "当提供的deployment_id无效时"
            }
          ]
        },
        {
          "name": "receive_log_entry",
          "description": "接收部署引擎发送的结构化日志条目并持久化，同时广播到相关WebSocket客户端。",
          "signature": "async receive_log_entry(entry: LogEntry) -> None",
          "precondition": "entry.deployment_id 必须有效，且部署正在进行",
          "postcondition": "日志条目被保存到数据库，并广播至所有监听的WebSocket客户端",
          "parameters": [
            {
              "name": "entry",
              "type": "LogEntry",
              "description": "日志条目对象"
            }
          ],
          "return_type": "None",
          "exceptions": [
            {
              "name": "DeploymentNotFound",
              "description": "部署不存在",
              "status": "error",
              "trigger": "当deployment_id在部署表中不存在时"
            },
            {
              "name": "DatabaseWriteError",
              "description": "数据库写入失败",
              "status": "error",
              "trigger": "当数据库操作异常时"
            }
          ]
        },
        {
          "name": "send_deployment_status",
          "description": "部署引擎通知日志服务部署已结束，日志服务生成最终状态消息并通过WebSocket推送。",
          "signature": "async send_deployment_status(deployment_id: int, final_status: str) -> None",
          "precondition": "deployment_id 必须存在，final_status 为 'success' 或 'failed'",
          "postcondition": "最终状态消息被推送至所有相关WebSocket连接，并关闭这些连接",
          "parameters": [
            {
              "name": "deployment_id",
              "type": "int",
              "description": "部署ID"
            },
            {
              "name": "final_status",
              "type": "str",
              "description": "最终状态: 'success' 或 'failed'"
            }
          ],
          "return_type": "None",
          "exceptions": [
            {
              "name": "InvalidStatus",
              "description": "状态值无效",
              "status": "error",
              "trigger": "当final_status不是'success'或'failed'时"
            }
          ]
        },
        {
          "name": "query_log_entries",
          "description": "根据过滤条件查询历史日志条目，支持分页。",
          "signature": "async query_log_entries(filters: LogQueryFilter) -> PaginatedLogEntries",
          "precondition": "过滤器对象必须有效（至少提供一个查询条件）",
          "postcondition": "返回符合条件的分页日志条目列表",
          "parameters": [
            {
              "name": "filters",
              "type": "LogQueryFilter",
              "description": "查询过滤器对象"
            }
          ],
          "return_type": "PaginatedLogEntries",
          "exceptions": [
            {
              "name": "InvalidFilter",
              "description": "过滤器参数无效",
              "status": "error",
              "trigger": "当时间格式错误或page/per_page非正整数时"
            },
            {
              "name": "DatabaseQueryError",
              "description": "数据库查询失败",
              "status": "error",
              "trigger": "当数据库操作异常时"
            }
          ]
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "日志条目一旦创建便不可修改或删除，确保审计完整性",
      "type": "invariant",
      "expression": "对于任意 LogEntry，其状态字段在创建后不可更改"
    },
    {
      "id": "BR-002",
      "description": "每个部署任务只能有一个活跃的最终状态推送",
      "type": "constraint",
      "expression": "对于任意 deployment_id，send_deployment_status 最多被调用一次"
    },
    {
      "id": "BR-003",
      "description": "WebSocket连接必须与一个有效的、正在进行的部署相关联",
      "type": "precondition",
      "expression": "connect_log_stream 的 deployment_id 必须引用一个状态为 'running' 的部署"
    },
    {
      "id": "BR-004",
      "description": "只有正在进行的部署才能接收新的日志条目",
      "type": "precondition",
      "expression": "receive_log_entry 的 entry.deployment_id 必须引用一个状态为 'running' 的部署"
    }
  ],
  "error_handling": {
    "strategy": "统一错误处理策略：所有接口异常均返回标准化的错误对象，包含错误码、描述和解决方案。业务异常通过预定义的异常类型捕获，数据库异常重试一次后返回500错误，WebSocket异常记录日志并清理连接。",
    "error_codes": [
      {
        "code": "400",
