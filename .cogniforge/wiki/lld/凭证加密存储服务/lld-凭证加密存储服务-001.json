  "data_models": [
    {
      "id": "DM-001",
      "name": "credentials",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "credentials"
      },
      "description": "存储加密后的凭证信息，包括密文、盐、随机数和认证标签",
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "name",
          "type": "String",
          "required": true,
          "description": "凭证标识名称"
        },
        {
          "name": "encrypted_data",
          "type": "LargeBinary",
          "required": true,
          "description": "AES-GCM加密后的密文（base64编码存储为文本）"
        },
        {
          "name": "salt",
          "type": "LargeBinary",
          "required": true,
          "description": "PBKDF2派生密钥使用的盐值"
        },
        {
          "name": "nonce",
          "type": "LargeBinary",
          "required": true,
          "description": "AES-GCM加密使用的随机数"
        },
        {
          "name": "tag",
          "type": "LargeBinary",
          "required": true,
          "description": "AES-GCM认证标签"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": false,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": false,
          "description": "更新时间"
        }
      ],
      "indexes": [
