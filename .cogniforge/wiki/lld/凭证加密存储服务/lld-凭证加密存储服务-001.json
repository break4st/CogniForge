  "domain_objects": [
    {
      "id": "DO-001",
      "name": "MasterPasswordManager",
      "object_type": "class",
      "description": "负责主密码的验证、派生密钥生成与缓存管理",
      "responsibilities": [
        "存储主密码哈希和派生参数于KeyDerivationParams",
        "提供set_master_password方法：接收主密码，生成随机盐，派生密钥，缓存并返回成功",
        "提供verify_master_password方法：验证哈希并刷新派生密钥",
        "提供clear_master_key方法：清空缓存的派生密钥",
        "管理超时机制：使用后台线程监控空闲时间，超时后自动清空密钥"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-005"
      ],
      "collaborations": [
        "使用KeyDerivationParams作为内部状态"
      ],
      "states": [
        {
          "state_name": "Uninitialized",
          "description": "主密码未设置，任何加密解密请求将被拒绝",
          "transitions": [
            {
              "trigger": "set_master_password成功",
              "target": "Active"
            }
          ]
        },
        {
          "state_name": "Active",
          "description": "派生密钥已缓存，可正常处理加密解密",
          "transitions": [
            {
              "trigger": "超时或clear_master_key",
              "target": "Uninitialized"
            },
            {
              "trigger": "verify_master_password成功",
              "target": "Active"
            }
          ]
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "CredentialEncryptor",
      "object_type": "class",
      "description": "执行AES-GCM加密逻辑",
      "responsibilities": [
        "从MasterPasswordManager获取当前派生密钥",
        "生成随机nonce（12字节）",
        "使用AES-256-GCM加密明文数据",
        "返回EncryptionResult（密文、盐、nonce、tag）",
        "不负责持久化"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-005"
      ],
      "collaborations": [
        "依赖MasterPasswordManager获取派生密钥",
        "生成EncryptionResult对象"
      ],
      "states": []
    },
    {
      "id": "DO-003",
      "name": "CredentialDecryptor",
      "object_type": "class",
      "description": "执行AES-GCM解密逻辑",
      "responsibilities": [
        "从MasterPasswordManager获取当前派生密钥",
        "接收密文、nonce、tag，执行解密和认证",
        "解密失败时抛出特定异常（如InvalidTag）",
        "返回原始明文数据"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-005"
      ],
      "collaborations": [
        "依赖MasterPasswordManager获取派生密钥"
      ],
      "states": []
    },
    {
      "id": "DO-004",
      "name": "CredentialRepository",
      "object_type": "class",
      "description": "负责credentials表的CRUD操作",
      "responsibilities": [
        "根据名称查询加密凭证记录",
        "保存加密结果到credentials表",
        "提供高级封装：save_encrypted_credential(EncryptionResult)"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-005"
      ],
      "collaborations": [
        "使用DM-001（credentials表映射）"
      ],
      "states": []
    },
    {
      "id": "DO-005",
      "name": "CredentialService",
      "object_type": "class",
      "description": "凭证加密存储服务的主门面，协调上述对象，提供业务方法",
      "responsibilities": [
        "init_master_password(master_password): void，调用MasterPasswordManager.set_master_password",
        "verify_master_password(master_password): bool，调用MasterPasswordManager.verify_master_password",
        "encrypt(name, plaintext): bool，调用CredentialEncryptor加密后通过CredentialRepository保存",
        "decrypt(name): plaintext，通过CredentialRepository查询，调用CredentialDecryptor解密返回明文",
        "clear_master_key(): void，调用MasterPasswordManager.clear_master_key"
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-005"
      ],
      "collaborations": [
        "持有MasterPasswordManager、CredentialEncryptor、CredentialDecryptor、CredentialRepository实例"
      ],
      "states": []
    },
    {
      "id": "DO-006",
      "name": "SetMasterPasswordRequest",
