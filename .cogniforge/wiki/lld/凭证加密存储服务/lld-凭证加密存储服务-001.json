  "module_boundary": {
    "in_scope": [
      "主密码的验证与派生密钥生成（PBKDF2）",
      "使用派生密钥对私钥/密码进行AES-GCM加密与解密",
      "加密凭证的持久化（存入数据库）",
      "内存中密钥的安全管理（超时清除、手动清除）",
      "对外提供加密/解密/主密码操作的REST API"
    ],
    "out_of_scope": [
      "SSH连接执行（由SSH/SFTP连接管理器负责）",
      "私钥的使用逻辑（由调用方自行处理解密后的明文）",
      "SQLite数据库本身的schema设计（仅引用'credentials'表）",
      "客户端主密码输入界面前端交互"
    ],
    "owned_components": [
      "CMP-005"
    ],
    "owned_contracts": [
      "CTR-001",
