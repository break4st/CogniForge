  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ProjectService",
      "description": "项目服务契约，定义项目管理的方法签名和行为。",
      "methods": [
        {
          "name": "create_project",
          "signature": "create_project(name: str, description: str, user_id: int) -> Project",
          "description": "创建新项目",
          "params": [
            {
              "name": "name",
              "type": "str",
              "description": "项目名称"
            },
            {
              "name": "description",
              "type": "str",
              "description": "项目描述"
            },
            {
              "name": "user_id",
              "type": "int",
              "description": "用户ID"
            }
          ],
          "return_type": "Project",
          "exceptions": [
            {
              "id": "DO-004",
              "condition": "项目名重复",
              "code": "PROJECT_NAME_DUPLICATE",
              "message": "项目名已存在"
            }
          ],
          "precondition": "用户已认证，项目名非空，同用户下项目名唯一",
          "postcondition": "新项目记录保存到数据库并返回",
          "side_effects": "数据库插入操作",
          "complexity": "O(1)",
          "idempotent": false,
          "transaction": "必需"
        },
        {
          "name": "update_project",
          "signature": "update_project(project_id: int, name: str, description: str, user_id: int) -> Project",
          "description": "更新项目信息",
          "params": [
            {
              "name": "project_id",
              "type": "int",
              "description": "项目ID"
            },
            {
              "name": "name",
              "type": "str",
              "description": "新项目名称"
            },
            {
              "name": "description",
              "type": "str",
              "description": "新项目描述"
            },
            {
              "name": "user_id",
              "type": "int",
              "description": "用户ID"
            }
          ],
          "return_type": "Project",
          "exceptions": [
            {
              "id": "DO-004",
              "condition": "项目不存在",
              "code": "PROJECT_NOT_FOUND",
              "message": "项目不存在"
            },
            {
              "id": "DO-004",
              "condition": "项目名变更且已存在",
              "code": "PROJECT_NAME_DUPLICATE",
              "message": "项目名已存在"
            }
          ],
          "precondition": "用户是项目所有者，项目存在",
          "postcondition": "项目信息更新到数据库并返回",
          "side_effects": "数据库更新操作",
          "complexity": "O(1)",
          "idempotent": true,
          "transaction": "必需"
        },
        {
          "name": "delete_project",
          "signature": "delete_project(project_id: int, user_id: int) -> None",
          "description": "删除项目",
          "params": [
            {
              "name": "project_id",
              "type": "int",
              "description": "项目ID"
            },
            {
              "name": "user_id",
              "type": "int",
              "description": "用户ID"
            }
          ],
          "return_type": "None",
          "exceptions": [
            {
              "id": "DO-004",
              "condition": "项目不存在",
              "code": "PROJECT_NOT_FOUND",
              "message": "项目不存在"
            },
            {
              "id": "DO-004",
              "condition": "项目有关联环境",
              "code": "PROJECT_HAS_ENVIRONMENTS",
              "message": "项目下尚有环境，无法删除"
            }
          ],
          "precondition": "用户是项目所有者，项目存在且无关联环境",
          "postcondition": "项目记录从数据库中删除",
          "side_effects": "数据库删除操作，可能级联删除关联记录",
          "complexity": "O(1)",
          "idempotent": true,
          "transaction": "必需"
        },
        {
          "name": "list_projects",
          "signature": "list_projects(user_id: int) -> list[Project]",
          "description": "列出用户的所有项目",
          "params": [
            {
              "name": "user_id",
              "type": "int",
              "description": "用户ID"
            }
          ],
          "return_type": "list[Project]",
          "exceptions": [],
          "precondition": "用户已认证",
          "postcondition": "返回该用户所有项目列表",
          "side_effects": "无",
          "complexity": "O(n)",
          "idempotent": true,
          "transaction": false
        },
        {
          "name": "project_exists",
          "signature": "project_exists(project_id: int) -> bool",
          "description": "检查项目是否存在",
          "params": [
            {
              "name": "project_id",
              "type": "int",
              "description": "项目ID"
            }
          ],
          "return_type": "bool",
          "exceptions": [
            {
              "id": "DO-004",
              "condition": "内部服务调用认证失败",
              "code": "FORBIDDEN",
              "message": "内部调用禁止"
            }
