  "module_boundary": {
    "in_scope": [
      "接收上传文件（支持 .zip, .tar.gz, .tgz）",
      "文件大小限制与进度反馈",
      "计算文件校验和（SHA256）",
      "生成版本标识（自定义或自动）",
      "文件元数据管理（存储到 PostgreSQL）",
      "文件存储到 MinIO"
    ],
    "out_of_scope": [
      "文件下载接口",
      "部署执行",
      "日志推送",
      "用户权限管理（认证依赖网关）",
      "项目/环境管理"
    ],
    "owned_components": [
      "CMP-004"
    ],
    "owned_contracts": [
      "CTR-005"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "文件管理服务负责接收部署包文件，进行安全校验后存放到对象存储 MinIO，同时在 PostgreSQL 中记录文件元信息（如文件 ID、校验和、大小、版本标识等），为下游部署执行服务提供可靠的文件引用依据。",
    "dependencies": [
      "API 网关（认证转发）",
      "PostgreSQL",
      "MinIO"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "PostgreSQL",
      "MinIO"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": [
        "CMP-004"
      ],
      "sad_contract_ids": [
        "CTR-005"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001"
        ],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [
          "DO-001",
          "DO-002",
          "DO-003",
          "DO-004",
          "DO-005"
        ],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": "REQ-003 的上传文件、校验和计算、版本标识生成等需求被完全覆盖"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "files",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "files"
      },
      "description": "记录上传部署文件的元信息，是部署任务引用的核心数据。主数据源在 Primary Database LLD 中定义，此处列出本服务关心的字段视图。",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "required": true,
          "description": "内部主键，与 MinIO 对象名关联"
        },
        {
          "name": "file_id",
          "type": "string",
          "required": true,
          "description": "对外的文件唯一标识，等同于 id"
        },
        {
          "name": "original_name",
          "type": "string",
          "required": true,
          "description": "用户上传时的原始文件名"
        },
        {
          "name": "storage_path",
          "type": "string",
          "required": true,
          "description": "MinIO 中的对象路径，格式为 {file_id}.{ext}"
        },
        {
          "name": "size",
          "type": "bigint",
          "required": true,
          "description": "文件字节数"
        },
        {
          "name": "checksum",
          "type": "string",
          "required": true,
          "description": "SHA256 校验和（64位十六进制字符串）"
        },
        {
          "name": "version_tag",
          "type": "string",
          "required": true,
          "description": "版本标签，自定义或自动生成"
        },
        {
          "name": "notes",
          "type": "text",
          "required": false,
          "description": "备注信息"
        },
        {
          "name": "created_at",
          "type": "timestamp",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "timestamp",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_files_file_id",
          "unique": true,
          "columns": [
            "file_id"
          ]
        },
        {
          "name": "idx_files_version_tag",
          "unique": false,
          "columns": [
            "version_tag"
          ]
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "source_components": [
        "CMP-004"
      ],
      "source_contracts": [
        "CTR-005"
      ],
      "constraints": [
        "file_id 必须唯一",
        "size 必须大于 0",
        "checksum 不能为空"
      ],
      "lifecycle": {
        "create": "文件上传成功后写入",
        "update": "通常不更新",
        "delete": "不应直接物理删除，需检查部署历史引用",
        "retention": "永久保留，或根据业务策略归档清理"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建，源自 CTR-005 响应字段映射",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
