                },
                "original_name": {
                  "type": "string",
                  "description": "原始文件名"
                },
                "size": {
                  "type": "integer",
                  "format": "int64",
                  "description": "文件大小"
                },
                "checksum": {
                  "type": "string",
                  "description": "SHA256校验和"
                },
                "version_tag": {
                  "type": "string",
                  "description": "版本标识"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "创建时间"
                }
              }
            }
          }
        },
        {
          "id": "listFiles",
          "name": "查询文件列表",
          "method": "GET",
          "path": "/api/v1/files",
          "request": {
            "params": [
              {
                "name": "file_id",
                "type": "string",
                "required": false,
                "description": "文件ID精确匹配"
              },
              {
                "name": "version_tag",
                "type": "string",
                "required": false,
                "description": "版本标识精确匹配"
              },
              {
                "name": "start_date",
                "type": "string",
                "format": "date-time",
                "required": false,
                "description": "开始时间"
              },
              {
                "name": "end_date",
                "type": "string",
                "format": "date-time",
                "required": false,
                "description": "结束时间"
              },
              {
                "name": "limit",
                "type": "integer",
                "required": false,
                "description": "分页限制"
              },
              {
                "name": "offset",
                "type": "integer",
                "required": false,
                "description": "分页偏移"
              }
            ]
          },
          "response": {
            "200": {
              "type": "object",
              "properties": {
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file_id": {
                        "type": "string"
                      },
                      "original_name": {
                        "type": "string"
                      },
                      "size": {
                        "type": "integer"
                      },
                      "checksum": {
                        "type": "string"
                      },
                      "version_tag": {
                        "type": "string"
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                },
                "total": {
                  "type": "integer"
                }
              }
            }
          }
        }
      ]
    }
  ]
