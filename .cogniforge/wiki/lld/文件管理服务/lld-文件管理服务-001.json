  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "FileManagementServiceAPI",
      "description": "文件管理服务对外提供的 HTTP API",
      "type": "api",
      "protocol": "HTTP/REST",
      "endpoints": [
        {
          "method": "POST",
          "path": "/api/v1/files/upload",
          "operation_id": "uploadFile",
          "summary": "上传部署文件",
          "request_schema": {
            "content_type": "multipart/form-data",
            "params": {
              "file": {
                "type": "file",
                "required": true,
                "description": "部署包文件"
              },
              "version_tag": {
                "type": "string",
                "required": false,
                "description": "自定义版本标签"
              },
              "notes": {
                "type": "string",
                "required": false,
                "description": "备注"
              }
            }
          },
          "response_schema": {
            "200": {
              "description": "上传成功",
              "content": {
                "application/json": {
                  "schema_ref": "#/domain_objects/DO-003"
                }
              }
            },
            "400": {
              "description": "请求无效"
            },
            "413": {
              "description": "文件大小超出限制"
            },
            "500": {
              "description": "服务器内部错误"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/files",
          "operation_id": "listFiles",
          "summary": "查询文件列表",
          "request_schema": {
            "params": {
              "file_id": {
                "type": "string",
                "required": false
              },
              "version_tag": {
                "type": "string",
                "required": false
              },
              "start_date": {
                "type": "string",
                "format": "date-time",
                "required": false
              },
              "end_date": {
                "type": "string",
                "format": "date-time",
                "required": false
              },
              "limit": {
                "type": "integer",
                "required": false
              },
              "offset": {
                "type": "integer",
                "required": false
              }
            }
          },
          "response_schema": {
            "200": {
              "description": "查询成功",
              "content": {
                "application/json": {
                  "schema_ref": "#/domain_objects/DO-005"
                }
              }
            },
            "400": {
              "description": "请求无效"
            },
            "500": {
              "description": "服务器内部错误"
            }
          }
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
