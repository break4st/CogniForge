      "description": "文件管理服务的契约定义，与 SAD 中的 CTR-005 对齐",
      "operations": [
        {
          "id": "uploadFile",
          "name": "上传文件",
          "method": "POST",
          "path": "/api/v1/files/upload",
          "request": {
            "params": [
              {
                "name": "file",
                "type": "file",
                "required": true,
                "description": "部署包文件"
              },
              {
                "name": "version_tag",
                "type": "string",
                "required": false,
                "description": "自定义版本标签"
              },
              {
                "name": "notes",
