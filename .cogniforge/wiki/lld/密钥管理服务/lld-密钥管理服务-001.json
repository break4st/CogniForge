  "module_boundary": {
    "in_scope": [
      "接收并校验用户上传的私钥",
      "使用AES-256-GCM对私钥加密后持久化存储",
      "提供gRPC接口，在内存中解密私钥并仅返回给内部服务调用",
      "对密钥信息进行脱敏处理（如只显示指纹）",
      "管理密钥吊销和更新",
      "审计日志记录所有密钥操作"
    ],
    "out_of_scope": [
      "用户认证与授权（依赖API网关）",
      "密钥的使用方（环境管理服务、部署编排服务）的具体业务逻辑",
      "审计日志的存储与查询（由日志与审计服务负责）",
      "物理硬件安全模块（HSM）集成"
    ],
    "owned_components": ["CMP-005"],
    "owned_contracts": ["CTR-003"],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "密钥管理服务负责SSH私钥的全生命周期安全管控，包括上传加密、安全存储、内存解密、脱敏展示和吊销管理，并通过gRPC为内部服务提供解密接口。",
    "dependencies": [
      "PostgreSQL（存储加密密钥元数据）",
      "日志与审计服务（通过AMQP发送审计事件）",
      "API网关（接收前端上传请求，已完成认证）"
    ],
    "tech_stack": [
      "Python",
      "FastAPI",
      "gRPC",
      "PostgreSQL",
      "RabbitMQ"
    ]
  },
