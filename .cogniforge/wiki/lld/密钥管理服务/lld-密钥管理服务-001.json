  "service_contracts": [
    {
      "name": "SC-001",
      "description": "密钥管理服务接口，提供私钥安全上传、加密存储、解密分发、吊销及生命周期管理。",
      "methods": [
        {
          "name": "uploadKey",
          "signature": "(request: KeyUploadRequestDTO) -> KeyUploadResponseDTO",
          "precondition": "API网关已完成用户认证，请求中包含未加密的私钥材料。",
          "postcondition": "私钥被加密存储到数据库，返回脱敏的密钥指纹和ID。审计事件已发送。",
          "description": "接收用户上传的私钥，加密后持久化存储，并返回脱敏信息。",
          "exceptions": [
            {
              "name": "InvalidKeyException",
              "trigger": "上传的私钥格式无效或内容损坏",
              "http_status": 400
            },
            {
              "name": "KeyAlreadyExistsException",
              "trigger": "同名密钥已存在且为活跃状态",
              "http_status": 409
            }
          ]
        },
        {
          "name": "getDecryptedKeyMaterial",
          "signature": "(request: GetDecryptedKeyMaterialRequestDTO) -> GetDecryptedKeyMaterialResponseDTO",
          "precondition": "调用方为内部授权服务，且密钥状态为active。",
          "postcondition": "返回内存中解密的临时密钥材料，响应后立即销毁。审计事件已发送。",
          "description": "为内部服务获取解密的私钥材料，仅在内存中短暂存在。",
          "exceptions": [
            {
              "name": "KeyNotFoundException",
              "trigger": "指定密钥ID不存在",
              "http_status": 404
            },
            {
              "name": "KeyNotActiveException",
              "trigger": "密钥状态非active",
              "http_status": 403
            }
          ]
        },
        {
          "name": "revokeKey",
          "signature": "(keyId: str, reason: str) -> None",
          "precondition": "密钥存在且状态为active。",
          "postcondition": "密钥状态更新为revoked。审计事件已发送。",
          "description": "吊销指定密钥，使其不可再使用。",
          "exceptions": [
            {
              "name": "KeyNotFoundException",
              "trigger": "密钥ID不存在",
              "http_status": 404
            },
            {
              "name": "KeyAlreadyRevokedException",
              "trigger": "密钥已处于revoked状态",
              "http_status": 409
            }
          ]
        },
        {
          "name": "listKeys",
          "signature": "(page: int, size: int) -> List[KeySummaryDTO]",
          "precondition": "API网关已完成用户认证。",
          "postcondition": "返回当前用户可见的密钥摘要列表（含指纹和状态）。",
          "description": "分页查询当前用户上传的密钥列表。",
          "exceptions": []
        }
      ],
      "repository_dependencies": [
        "save(KeyRecordEntity) -> KeyRecordEntity",
        "findById(keyId: str) -> KeyRecordEntity?",
        "findByNameAndUploadedBy(name: str, uploadedBy: str) -> KeyRecordEntity?",
        "findByUploadedByPaginated(uploadedBy: str, page: int, size: int) -> List[KeyRecordEntity]",
        "updateStatus(keyId: str, status: KeyStatus) -> None"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "私钥材料在落盘前必须完成AES-256-GCM加密",
      "每次解密操作必须生成唯一的临时解密结果，且用后立即从内存中抹除",
      "密钥指纹必须唯一且由SHA256派生，一旦生成不可更改",
      "吊销后的密钥不得用于任何新的解密操作",
      "所有密钥操作必须产生一条不可变审计事件，包含操作者、操作类型、时间戳和目标密钥ID"
    ],
    "state_machines": [
      {
        "entity": "KeyRecordEntity",
        "states": ["active", "revoked", "expired"],
        "transitions": [
          {
            "from": "active",
            "to": "revoked",
            "trigger": "管理员执行吊销操作",
            "actor": "管理员"
          },
          {
            "from": "active",
            "to": "expired",
            "trigger": "系统检测到密钥已超过有效期",
            "actor": "系统定时任务"
          },
          {
            "from": "revoked",
            "to": "expired",
            "trigger": "系统检测到吊销密钥已超过有效期",
            "actor": "系统定时任务"
          }
        ],
        "irreversible_rules": [
          "一旦密钥状态变为revoked或expired，不可再回退到active",
          "密钥一旦删除，从数据库物理删除后不可恢复"
        ],
        "concurrency": "使用乐观锁版本号控制状态变更，防止并发更新冲突"
      }
    ],
    "cross_service_rules": [
      "API网关必须在所有密钥管理请求中注入经过认证的用户ID和角色，密钥管理服务不自行认证",
      "审计事件必须通过AMQP异步发送到日志与审计服务，且至少一次投递",
      "gRPC解密接口仅允许内部受信服务调用，调用方身份由mTLS证书验证"
    ]
  },
  "workflow": {
    "name": "密钥上传与吊销流程",
    "description": "处理用户上传私钥并加密存储，以及管理员吊销密钥的完整流程。",
    "steps": [
      {
        "order": 1,
        "name": "接收上传请求",
        "action": "API网关验证用户身份后转发上传请求至密钥管理服务",
        "timeout_seconds": 30,
        "on_failure": "返回 401 未授权错误"
      },
      {
        "order": 2,
        "name": "校验私钥格式",
        "action": "检查私钥是否为有效的PEM格式，并提取公钥生成指纹",
        "timeout_seconds": 10,
        "on_failure": "返回 400 无效密钥格式错误"
      },
      {
        "order": 3,
        "name": "加密私钥",
        "action": "使用AES-256-GCM对称加密算法加密私钥材料",
        "timeout_seconds": 10,
        "on_failure": "返回 500 内部加密错误"
      },
      {
        "order": 4,
        "name": "持久化存储",
        "action": "将加密的密钥记录插入数据库，并返回脱敏信息",
        "timeout_seconds": 10,
        "on_failure": "返回 500 数据库错误"
      },
      {
        "order": 5,
        "name": "发送审计事件",
        "action": "异步发送密钥上传审计事件到AMQP",
        "timeout_seconds": 5,
        "on_failure": "记录本地日志，后续重试"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": ["NETWORK_ERROR", "TIMEOUT"],
      "non_retryable_errors": ["AUTH_ERROR", "CONFIG_ERROR"]
    }
  }
}