  "data_models": [
    {
      "id": "DM-001",
      "name": "KeyRecord",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "KeyRecord"
      },
      "description": "主数据库中的加密密钥记录表，存储密钥元数据和密文，由 Primary Database LLD 定义。",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "required": true,
          "description": "主键，唯一标识密钥记录"
        },
        {
          "name": "name",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "密钥名称，用于识别"
        },
        {
          "name": "fingerprint",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "密钥指纹（SHA256），用于脱敏展示和快速查找"
        },
        {
          "name": "encrypted_key_material",
          "type": "TEXT",
          "required": true,
          "description": "AES-256-GCM加密后的私钥材料（Base64编码）"
        },
        {
          "name": "status",
          "type": "VARCHAR(50)",
          "required": true,
          "description": "密钥状态：active（活跃）、revoked（吊销）、expired（过期）"
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP WITH TIME ZONE",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMP WITH TIME ZONE",
          "required": true,
          "description": "更新时间"
        },
        {
          "name": "created_by",
          "type": "VARCHAR(255)",
          "required": false,
          "description": "创建者标识（来自API网关的用户ID）"
        }
      ],
      "indexes": [
        {
          "name": "idx_fingerprint",
          "unique": true,
          "columns": ["fingerprint"]
        },
        {
          "name": "idx_status",
          "unique": false,
          "columns": ["status"]
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "插入新的密钥记录，encrypted_key_material由加密服务生成",
        "update": "更新记录（如状态变更、密钥轮换更新密文），需更新updated_at",
        "delete": "不支持物理删除；状态变为revoked或expired保留记录",
        "retention": "根据合规要求长期保存，过期吊销密钥保留至少7年"
      },
      "source_requirements": ["REQ-004"],
      "source_components": ["CMP-005"],
      "source_contracts": ["CTR-003"],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "KeyManagementService",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-005",
      "method": "INTERNAL",
      "endpoint": "keymanagement.KeyManagementService/GetDecryptedKeyMaterial",
      "description": "gRPC服务接口，供内部服务（如部署编排服务）调用，在内存中解密指定密钥并返回明文密钥材料。调用方需提供密钥ID和审计上下文。",
      "parameters": [],
      "request_body": {
        "key_id": "string (UUID)",
        "requester_service": "string",
        "request_id": "string (UUID)"
      },
      "response": {
        "status": 200,
        "body": {
          "key_material": "string",
          "fingerprint": "string"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "指定密钥ID不存在"
        },
        {
          "status": 403,
          "code": "PERMISSION_DENIED",
          "message": "调用方无权限访问此密钥"
        },
        {
          "status": 403,
          "code": "KEY_REVOKED",
          "message": "密钥已被吊销，无法解密"
        },
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "解密过程发生内部错误"
        }
      ],
      "auth": {
        "required": true,
        "policy": "mTLS + 服务间令牌验证（由服务网格注入）"
      },
      "validation_rules": [
        "key_id 必须为有效的UUID v4格式",
        "requester_service 不能为空且在服务注册表中存在",
        "request_id 必须为有效的UUID v4格式，用于审计追踪"
      ],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": ["REQ-004"],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建gRPC接口定义",
          "reason": "首次生成LLD，满足内部服务对密钥解密的访问需求"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "统一错误码格式返回，结合服务器端异常日志记录和客户端友好错误提示。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "无效请求",
        "description": "当请求参数校验失败、密钥格式不正确、密钥长度超限等客户端错误时返回。"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "当请求的密钥ID不存在或已被吊销/删除时返回。"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "当尝试上传已存在的密钥指纹、或对已吊销密钥进行非法操作时返回。"
      },
      {
        "code": "500",
        "name": "内部服务器错误",
        "description": "当数据库连接失败、加密/解密操作异常、消息队列发送失败等不可恢复的内部错误时返回，需记录详细错误日志。"
      },
      {
        "code": "503",
        "name": "服务不可用",
        "description": "当依赖的下游服务（如数据库、消息队列）不可用时返回，可能包含自动重试策略。"
      }
    ]
  },
