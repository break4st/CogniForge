  "data_models": [
    {
      "id": "DM-001",
      "name": "keys",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "keys"
      },
      "description": "存储SSH密钥对的元数据与加密后的私钥。",
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键，自增"
        },
        {
          "name": "name",
          "type": "String(128)",
          "required": true,
          "description": "密钥别名"
        },
        {
          "name": "fingerprint",
          "type": "String(64)",
          "required": true,
          "description": "SSH公钥指纹，例如 SHA256:..."
        },
        {
          "name": "encrypted_private_key",
          "type": "Text",
          "required": true,
          "description": "经密钥安全模块加密后的私钥密文"
        },
        {
          "name": "is_default",
          "type": "Boolean",
          "required": true,
          "description": "是否为默认密钥，全局最多一条记录为True"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_keys_fingerprint",
          "unique": true,
          "columns": [
            "fingerprint"
          ]
        },
        {
          "name": "idx_keys_is_default",
          "unique": false,
          "columns": [
            "is_default"
          ]
        }
      ],
