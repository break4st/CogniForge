        "REQ-002"
      ],
      "implementation": {
        "method": "KeyService.update_key",
        "logic": "在更新is_default为true时，先调用KeyRepository.clear_default()，再设置新默认"
      }
    },
    {
      "id": "BR-002",
      "type": "invariant",
      "description": "私钥指纹必须唯一",
      "rule": "不能导入或生成具有相同指纹的密钥",
      "source_requirements": [
        "REQ-002"
      ],
      "implementation": {
        "method": "KeyService.import_key 和 KeyService.generate_key_pair",
