  "domain_objects": [
    {
      "id": "DO-001",
      "name": "Key",
      "description": "密钥实体，包含密钥元数据和加密后的私钥",
      "attributes": [
        {
          "name": "id",
          "type": "Integer",
          "description": "唯一标识"
        },
        {
          "name": "name",
          "type": "String",
          "description": "密钥别名"
        },
        {
          "name": "fingerprint",
          "type": "String",
          "description": "SSH公钥指纹"
        },
        {
          "name": "encrypted_private_key",
          "type": "String",
          "description": "加密后的私钥"
        },
        {
          "name": "is_default",
          "type": "Boolean",
          "description": "默认密钥标记"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "description": "创建时间"
        }
      ],
      "methods": [
        {
          "name": "validate_private_key",
          "description": "验证私钥格式并提取指纹",
          "parameters": [
            {
              "name": "private_key_text",
              "type": "String"
            }
          ],
          "return": {
            "type": "Boolean",
            "description": "是否有效"
          }
        },
        {
          "name": "encrypt_private_key",
          "description": "调用密钥安全模块加密私钥",
          "parameters": [
            {
              "name": "plain_text",
              "type": "String"
            }
          ],
          "return": {
            "type": "String",
            "description": "加密后的密文"
          }
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "KeyRepository",
      "description": "密钥仓储，负责数据库操作",
      "methods": [
        {
          "name": "save",
          "description": "保存密钥实体到数据库",
          "parameters": [
            {
              "name": "key",
              "type": "Key"
            }
          ],
          "return": {
            "type": "Key",
            "description": "保存后的密钥"
          }
        },
        {
          "name": "find_by_id",
          "description": "按ID查找密钥",
          "parameters": [
            {
              "name": "key_id",
              "type": "Integer"
            }
          ],
          "return": {
            "type": "Key",
            "nullable": true
          }
        },
        {
          "name": "find_all",
          "description": "获取所有密钥列表",
          "return": {
            "type": "List<Key>"
          }
        },
        {
          "name": "update",
          "description": "更新密钥名称和默认标记",
          "parameters": [
            {
              "name": "key",
              "type": "Key"
            }
          ]
        },
        {
          "name": "delete",
          "description": "删除密钥",
          "parameters": [
            {
              "name": "key_id",
              "type": "Integer"
            }
          ]
        },
        {
          "name": "find_default",
          "description": "查找当前默认密钥",
          "return": {
            "type": "Key",
            "nullable": true
          }
        },
        {
          "name": "clear_default",
          "description": "清除所有默认标记"
        },
        {
          "name": "is_referenced_by_environment",
          "description": "检查密钥是否被任何环境引用",
          "parameters": [
            {
              "name": "key_id",
              "type": "Integer"
            }
          ],
          "return": {
            "type": "Boolean"
          }
        }
      ]
    },
    {
      "id": "DO-003",
      "name": "KeyService",
      "description": "密钥管理应用服务，处理业务逻辑",
      "methods": [
        {
          "name": "import_key",
          "description": "导入私钥并保存",
          "parameters": [
            {
              "name": "name",
              "type": "String"
            },
            {
              "name": "private_key_text",
              "type": "String"
            },
            {
              "name": "is_default",
              "type": "Boolean"
            }
          ],
          "return": {
            "type": "Key"
          }
        },
        {
          "name": "generate_key_pair",
          "description": "生成新的SSH密钥对并保存",
          "parameters": [
            {
              "name": "name",
              "type": "String"
            },
            {
              "name": "is_default",
              "type": "Boolean"
            }
          ],
          "return": {
            "type": "Key"
          }
        },
        {
          "name": "list_keys",
          "description": "获取所有密钥列表（不含私钥）",
          "return": {
            "type": "List<KeyDTO>"
          }
        },
        {
          "name": "get_key_detail",
          "description": "获取密钥详情（不含私钥）",
          "parameters": [
            {
              "name": "key_id",
              "type": "Integer"
            }
          ],
          "return": {
            "type": "KeyDTO"
          }
        },
        {
          "name": "update_key",
          "description": "更新密钥名称和默认标记",
          "parameters": [
            {
              "name": "key_id",
              "type": "Integer"
            },
            {
              "name": "name",
              "type": "String"
            },
            {
              "name": "is_default",
              "type": "Boolean"
            }
          ],
          "return": {
            "type": "KeyDTO"
          }
        },
        {
          "name": "delete_key",
          "description": "删除密钥（检查引用）",
          "parameters": [
            {
              "name": "key_id",
              "type": "Integer"
            }
          ],
          "return": {
            "type": "void"
          }
        }
      ]
    },
    {
      "id": "DO-004",
      "name": "KeyDTO",
      "description": "数据传输对象，不包含加密的私钥",
      "attributes": [
        {
          "name": "id",
          "type": "Integer"
        },
        {
          "name": "name",
          "type": "String"
        },
        {
          "name": "fingerprint",
          "type": "String"
        },
        {
          "name": "is_default",
          "type": "Boolean"
        },
        {
          "name": "created_at",
          "type": "DateTime"
        }
      ]
    },
    {
      "id": "DO-005",
      "name": "CryptoProvider",
      "description": "密钥安全模块的抽象接口（防腐层）",
      "methods": [
        {
          "name": "encrypt",
          "description": "加密明文字符串",
          "parameters": [
            {
              "name": "plain_text",
              "type": "String"
            }
          ],
          "return": {
            "type": "String"
          }
        },
        {
          "name": "decrypt",
          "description": "解密密文（仅内部使用）",
          "parameters": [
            {
              "name": "cipher_text",
              "type": "String"
            }
          ],
          "return": {
            "type": "String",
            "description": "明文私钥"
          }
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "导入密钥",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-005",
      "method": "POST",
      "endpoint": "/api/keys",
      "description": "接收私钥文本及元数据，验证格式，加密存储，提取指纹，返回密钥元数据（不含私钥）。",
      "parameters": [
        {
          "name": "body",
          "type": "application/json",
          "required": true,
          "description": "导入密钥的请求体",
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "密钥别名"
              },
              "private_key": {
                "type": "string",
                "description": "SSH私钥文本"
              },
              "is_default": {
                "type": "boolean",
                "description": "是否设为默认密钥"
              }
            },
            "required": [
              "name",
              "private_key"
            ]
          }
        }
      ],
      "responses": [
        {
          "status_code": 201,
          "description": "成功创建密钥",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "DO-004"
              },
              "example": {
                "id": 1,
                "name": "MyKey",
                "fingerprint": "SHA256:xxxxxxxx",
                "is_default": false,
                "created_at": "2025-03-19T14:30:00Z"
              }
            }
          }
        },
        {
          "status_code": 400,
          "description": "请求格式错误或私钥无效",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "detail": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "detail": "Invalid private key format"
              }
            }
          }
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "生成密钥",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-005",
      "method": "POST",
      "endpoint": "/api/keys/generate",
      "description": "生成新的SSH密钥对，加密私钥并存储，返回元数据（不含私钥）。",
      "parameters": [
        {
          "name": "body",
          "type": "application/json",
          "required": true,
          "description": "生成密钥的请求体",
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "密钥别名"
              },
              "is_default": {
                "type": "boolean",
                "description": "是否设为默认密钥"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ],
      "responses": [
        {
          "status_code": 201,
          "description": "成功生成密钥",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "DO-004"
              },
              "example": {
                "id": 2,
                "name": "GeneratedKey",
                "fingerprint": "SHA256:yyyyyyyy",
                "is_default": false,
                "created_at": "2025-03-19T14:30:00Z"
              }
            }
          }
        },
        {
          "status_code": 400,
          "description": "请求格式错误"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "获取密钥列表",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-005",
      "method": "GET",
      "endpoint": "/api/keys",
      "description": "获取所有密钥的列表，不包含私钥。",
      "parameters": [],
      "responses": [
        {
          "status_code": 200,
          "description": "成功返回密钥列表",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "DO-004"
                }
              },
              "example": [
                {
                  "id": 1,
                  "name": "MyKey",
                  "fingerprint": "SHA256:xxxxxxxx",
                  "is_default": false,
                  "created_at": "2025-03-19T14:30:00Z"
                },
                {
                  "id": 2,
                  "name": "GeneratedKey",
                  "fingerprint": "SHA256:yyyyyyyy",
                  "is_default": false,
                  "created_at": "2025-03-19T14:30:00Z"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "IF-004",
      "name": "获取密钥详情",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-005",
      "method": "GET",
      "endpoint": "/api/keys/{key_id}",
      "description": "获取单个密钥的详情，不包含私钥。",
      "parameters": [
        {
          "name": "key_id",
          "type": "integer",
          "required": true,
          "in": "path",
          "description": "密钥ID"
        }
      ],
      "responses": [
        {
          "status_code": 200,
          "description": "成功返回密钥详情",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "DO-004"
              },
              "example": {
                "id": 1,
                "name": "MyKey",
                "fingerprint": "SHA256:xxxxxxxx",
                "is_default": false,
                "created_at": "2025-03-19T14:30:00Z"
              }
            }
          }
        },
        {
          "status_code": 404,
          "description": "密钥不存在"
        }
      ]
    },
    {
      "id": "IF-005",
      "name": "更新密钥",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-005",
      "method": "PUT",
      "endpoint": "/api/keys/{key_id}",
      "description": "更新密钥的名称和默认标记。",
      "parameters": [
        {
          "name": "key_id",
          "type": "integer",
          "required": true,
          "in": "path"
        },
        {
          "name": "body",
          "type": "application/json",
          "required": true,
          "description": "更新密钥的请求体",
          "schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "新的密钥别名"
              },
              "is_default": {
                "type": "boolean",
                "description": "新的默认标记"
              }
            }
          }
        }
      ],
      "responses": [
        {
          "status_code": 200,
          "description": "更新成功，返回更新后的密钥元数据",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "DO-004"
              },
              "example": {
                "id": 1,
                "name": "UpdatedKey",
                "fingerprint": "SHA256:xxxxxxxx",
                "is_default": true,
                "created_at": "2025-03-19T14:30:00Z"
              }
            }
          }
        },
        {
          "status_code": 400,
          "description": "请求格式错误"
        },
        {
          "status_code": 404,
          "description": "密钥不存在"
        }
      ]
    },
    {
      "id": "IF-006",
      "name": "删除密钥",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-003",
      "provider_component_id": "CMP-005",
      "method": "DELETE",
      "endpoint": "/api/keys/{key_id}",
      "description": "删除指定密钥，若被环境引用则拒绝删除。",
      "parameters": [
        {
          "name": "key_id",
          "type": "integer",
          "required": true,
          "in": "path"
        }
      ],
      "responses": [
        {
          "status_code": 204,
          "description": "删除成功，无响应体"
        },
        {
          "status_code": 409,
          "description": "密钥被环境引用，无法删除",
