  "module_boundary": {
    "in_scope": [
      "接收并验证SSH私钥格式，提取指纹，调用密钥安全模块加密后存储",
      "生成新的SSH密钥对，加密私钥并存储",
      "提供密钥列表及详情查询，响应不含私钥明文",
      "允许更新密钥名称和默认标记，保证全局最多一个默认密钥",
      "删除密钥前检查是否被任何环境引用，有引用则拒绝删除"
    ],
    "out_of_scope": [
      "私钥加密算法实现与密钥生命周期管理（由密钥安全模块提供）",
      "环境与密钥关联关系存储（由环境管理服务负责）",
      "部署时使用私钥建立SSH连接（由部署引擎协调）",
      "前端界面展示逻辑（由桌面客户端负责）"
    ],
    "owned_components": [
      "CMP-005"
    ],
    "owned_contracts": [
      "CTR-003"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001",
      "DM-002"
    ]
  },
  "overview": {
    "description": "密钥管理服务负责私钥导入、生成、指纹提取、默认标记及删除前引用检查，并依赖密钥安全模块进行加解密。提供REST API供桌面客户端使用。",
    "dependencies": [
      "密钥安全模块 (CMP-010)",
      "环境管理服务 (CMP-004) - 仅数据引用检查"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "SQLite (via SQLAlchemy)",
      "Paramiko",
      "cryptography 库 (通过密钥安全模块间接使用)"
    ]
  },
