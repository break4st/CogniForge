  "state_design": {
    "local_state": [
      {
        "id": "ST-001",
        "name": "ProjectListState",
        "component": "ProjectListView",
        "fields": [
          {
            "name": "projects",
            "type": "Project[]",
            "description": "项目列表"
          },
          {
            "name": "loading",
            "type": "boolean",
