  "module_boundary": {
    "in_scope": [
      "项目列表组件渲染（含加载状态、空状态、错误状态）",
      "新建项目（通过UI表单收集信息，调用IPC创建）",
      "编辑项目名称/描述（内联编辑或弹窗编辑）",
      "删除项目（确认提示后删除）",
      "切换当前激活项目（更新全局状态，联动右侧视图）",
      "本地状态管理（项目列表、加载状态、错误信息）",
      "与ProjectService的IPC通信（list, create, update, delete）",
      "与全局项目选中状态交互（通过Context/Store）"
    ],
    "out_of_scope": [
      "项目内部环境管理、部署、版本历史等",
      "主密码验证流程",
      "数据持久化逻辑（由ProjectService处理）",
      "路由导航逻辑（本模块仅负责项目列表视图）",
      "企业级权限控制（当前无用户体系）"
    ]
  },
  "overview": {
    "description": "展示所有项目的列表，支持用户通过界面创建、编辑、删除项目，并切换当前激活的项目。该组件是左侧导航面板的一部分，负责渲染项目列表UI，响应用户操作，通过Electron IPC与ProjectService通信以执行CRUD操作，并通过全局状态管理当前选中的项目ID，以驱动右侧视图的切换。",
    "tech_stack": ["React 18", "Ant Design 5.x", "TypeScript", "Electron IPC"]
  },
