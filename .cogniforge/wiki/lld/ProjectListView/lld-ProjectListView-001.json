  "interaction_flows": [
    {
      "id": "FLW-001",
      "name": "项目列表加载流程",
      "description": "组件挂载时加载项目列表",
      "steps": [
        "组件挂载，useEffect 触发",
        "设置 loading 状态：setLoading(true)",
        "调用 IPC project:list：ipcRenderer.invoke('project:list')",
        "成功回调：更新 projects 状态，setLoading(false)",
        "失败回调：设置 error 状态，setLoading(false)"
      ]
    },
    {
      "id": "FLW-002",
      "name": "创建项目流程",
      "description": "用户通过模态框创建新项目",
      "steps": [
        "用户点击新建按钮，打开 CreateProjectModal",
        "填写项目名称和描述，用户在表单中输入",
        "提交表单，调用 IPC project:create",
        "成功回调：关闭模态框，重新加载项目列表",
        "失败回调：显示错误消息"
      ]
    },
    {
      "id": "FLW-003",
      "name": "编辑项目流程",
      "description": "用户通过模态框编辑项目",
      "steps": [
        "用户点击编辑按钮，打开 EditProjectModal，传入当前项目数据",
        "修改项目信息，用户在表单中编辑",
        "提交表单，调用 IPC project:update",
        "成功回调：关闭模态框，重新加载项目列表",
        "失败回调：显示错误消息"
      ]
    },
    {
      "id": "FLW-004",
      "name": "删除项目流程",
      "description": "用户确认删除项目",
      "steps": [
        "用户点击删除按钮，显示确认对话框",
        "用户确认删除，调用 IPC project:delete",
        "成功回调：重新加载项目列表",
        "失败回调：显示错误消息"
      ]
    }
  ],
