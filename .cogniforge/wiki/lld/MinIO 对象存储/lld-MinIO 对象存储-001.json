  "module_boundary": {
    "in_scope": [
      "提供高可用的分布式对象存储能力，用于存放部署文件包",
      "管理存储桶的创建、策略配置（如版本控制、生命周期规则）",
      "暴露标准的S3兼容API（内部通过SDK访问，不直接对外提供接口）",
      "保障存储层的扩展性和数据持久性"
    ],
    "out_of_scope": [
      "不处理文件上传的业务逻辑（如文件校验、元数据提取），这些由上层「文件管理服务」负责",
      "不直接进行用户鉴权与授权（鉴权由API网关/安全服务完成）",
      "不维护业务数据关联关系（如文件与项目、环境的关系）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [
      "DM-001"
    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "MinIO对象存储模块是系统数据层的组成部分，专门负责部署制品（部署文件包）的可靠存储。它基于MinIO分布式集群部署，支持横向扩展，提供高吞吐量和高可用性。技术栈仅包含MinIO，不依赖其他模块，但被文件管理服务依赖。",
    "dependencies": [],
    "tech_stack": [
      "MinIO"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [],
      "lld_objects": {
        "data_models": [
          "DM-001"
        ],
        "interfaces": [],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": "MinIO模块作为底层存储支撑，满足文件存储需求，不对应直接的接口契约。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "桶配置",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "定义部署制品存储桶的元数据，包括桶名、区域、版本控制开关、生命周期规则。路径约定采用{project_uuid}/{environment_uuid}/{version_label}/{original_filename}层次结构。",
      "fields": [
        {
          "name": "bucket_name",
          "type": "string",
          "required": true,
          "description": "存储桶名称，如deploy-artifacts"
        },
        {
          "name": "region",
          "type": "string",
          "required": false,
          "description": "区域标识，默认us-east-1"
        },
        {
          "name": "versioning_enabled",
          "type": "boolean",
          "required": true,
          "description": "是否开启对象版本控制"
        },
        {
          "name": "lifecycle_rules",
          "type": "object",
          "required": false,
          "description": "生命周期规则配置，用于自动清理旧版本或过期文件"
        },
        {
          "name": "public_access",
          "type": "boolean",
          "required": false,
          "description": "是否允许公开访问，固定为false"
        },
        {
          "name": "path_style",
          "type": "string",
          "required": false,
          "description": "路径风格，固定为namespace"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "由初始化脚本或运维手动创建",
        "update": "仅更新生命周期策略和版本控制设置",
        "delete": "仅在销毁集群时删除",
        "retention": "依托版本控制和生命周期规则管理"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "interfaces": [],
  "error_handling": {
    "strategy": "封装MinIO原生SDK错误，转换为统一内部错误格式，区分客户端错误(4xx)与服务端/网络错误(5xx)，对可恢复错误进行有限重试。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端请求错误",
        "description": "桶不存在、对象不存在、签名无效、权限不足等，立即向上层返回错误，不重试。"
      },
      {
        "code": "5xx",
        "name": "服务端内部错误",
        "description": "MinIO集群内部故障、存储后端异常、磁盘满等，内部重试最多3次，重试失败返回服务不可用并告警。"
      },
      {
        "code": "NETWORK",
        "name": "网络/超时错误",
        "description": "连接超时、DNS解析失败、连接被拒绝，按指数退避重试3次，超时后降级为Service Unavailable。"
      }
    ]
  },
  "topology": {
    "buckets": [
      {
        "name": "deploy-artifacts",
        "description": "主存储桶，用于存放所有项目部署文件包",
        "access_policy": "private"
      }
    ],
    "path_conventions": "{project_uuid}/{environment_uuid}/{version_label}/{original_filename}"
  },
  "connection_contracts": {
    "endpoint": "minio.intra.svc.cluster.local:9000",
    "auth": "AccessKeyID/SecretAccessKey（通过安全服务获取）",
    "ssl": false,
    "connection_pool": {
      "max_idle_connections": 100,
      "max_connections_per_host": 20,
      "connection_timeout_seconds": 5,
      "request_timeout_seconds": 30,
      "keep_alive": true,
      "idle_timeout_seconds": 60
    },
    "retry_strategy": {
      "max_retries": 3,
      "backoff": "exponential",
      "retryable_errors": [
        "CONNECTION_RESET",
        "TIMEOUT",
        "DNS_ERROR"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "BUCKET_NOT_FOUND",
        "OBJECT_NOT_FOUND"
      ]
    }
  }
}