  "interfaces": [
    {
      "id": "IF-001",
      "name": "加密接口",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-009",
      "provider_component_id": "CMP-009",
      "method": "INTERNAL",
      "endpoint": "N/A",
      "description": "提供主密码设置与验证、密钥派生以及基于 AES-256-GCM 的内容加解密功能。所有密钥仅存于内存，不落盘。",
      "parameters": [],
      "request_body": {
        "setMasterPassword": {
          "password": "string，用户设置的主密码"
        },
        "verifyMasterPassword": {
          "password": "string，待验证的主密码"
        },
        "encrypt": {
          "plaintext": "string，待加密的明文数据"
        },
        "decrypt": {
          "ciphertext": "string，待解密的密文数据（含认证标签）",
          "iv": "string，初始化向量"
        }
      },
      "response": {
        "status": 0,
        "body": {
          "setMasterPassword": "void，成功无返回",
          "verifyMasterPassword": "boolean，验证结果",
          "encrypt": "object，{ ciphertext: string, iv: string }",
          "decrypt": "string，解密后的明文"
        }
      },
      "error_codes": [
        {
          "status": 1,
          "code": "MASTER_PASSWORD_NOT_SET",
          "message": "主密码尚未设置，请先调用 setMasterPassword"
        },
        {
          "status": 2,
          "code": "INVALID_PASSWORD",
          "message": "密码验证失败"
        },
        {
          "status": 3,
          "code": "ENCRYPTION_FAILED",
          "message": "加密过程发生错误"
        },
        {
          "status": 4,
          "code": "DECRYPTION_FAILED",
          "message": "解密过程发生错误，可能密文损坏或密钥不匹配"
        },
        {
          "status": 5,
          "code": "KEY_DERIVATION_FAILED",
          "message": "密钥派生失败"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [
        "主密码设置规则：SetMasterPassword 要求密码长度至少8位，包含大小写字母和数字",
        "主密码验证规则：VerifyMasterPassword 比较输入密码与已存储的哈希值",
        "加密规则：Encrypt 使用 AES-256-GCM 加密，生成随机 IV 和认证标签",
        "解密规则：Decrypt 使用对应 IV 和密钥解密，验证认证标签"
