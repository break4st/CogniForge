  },
  "workflow": {
    "name": "加密操作流程",
    "description": "主密码设置、验证、加密、解密流程",
    "steps": [
      {
        "order": 1,
        "name": "设置主密码",
        "action": "验证密码强度，派生密钥并保存在内存",
        "timeout_seconds": 30,
        "on_failure": "返回错误码 MASTER_PASSWORD_NOT_SET"
      },
      {
        "order": 2,
        "name": "验证主密码",
        "action": "比较输入密码派生密钥与内存密钥",
        "timeout_seconds": 10,
        "on_failure": "返回错误码 INVALID_PASSWORD，并记录尝试次数"
      },
      {
        "order": 3,
        "name": "加密数据",
        "action": "使用 AES-256-GCM 加密明文",
        "timeout_seconds": 60,
        "on_failure": "返回错误码 ENCRYPTION_FAILED"
      },
      {
        "order": 4,
        "name": "解密数据",
        "action": "使用 AES-256-GCM 解密密文",
        "timeout_seconds": 60,
        "on_failure": "返回错误码 DECRYPTION_FAILED"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": ["NETWORK_ERROR", "TIMEOUT"],
      "non_retryable_errors": ["AUTH_ERROR", "CONFIG_ERROR"]
    }
  }
