  "module_boundary": {
    "in_scope": [
      "环境的 CRUD 操作（增删改查）",
      "环境连通性测试调度",
      "调用 Security Module 对私钥加解密",
      "调用 SSH Service 进行连接测试",
      "环境列表查询及连通状态展示",
      "环境配置的输入校验与业务规则"
    ],
    "out_of_scope": [
      "UI 渲染逻辑",
      "SSH 协议实现",
      "加密算法实现",
      "审计日志存储",
      "部署执行流程",
      "历史记录与回滚",
      "文件上传逻辑"
    ],
    "owned_components": [
      "CMP-003"
    ],
    "owned_contracts": [],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "管理某个项目下的部署环境配置，负责环境的增删改查、密钥加密存储与连通性测试调度。调用 Security Module 处理密钥，通过 SSH Service 进行连接测试。",
    "dependencies": [
      "Security Module",
      "SSH Service",
      "Primary Database"
    ],
    "tech_stack": [
      "TypeScript",
      "Electron 主进程",
      "Electron ipcMain / contextBridge",
      "SQLite (via better-sqlite3)",
      "Node.js crypto (AES-256-GCM) (间接依赖)",
      "主密码派生密钥 (间接依赖)"
    ]
  },
