  "data_models": [
    {
      "id": "DM-001",
      "name": "EnvironmentRecord",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environments"
      },
      "description": "数据库 environments 表视图，包含环境的完整配置信息。每个环境隶属于一个项目，存储主机、端口、认证方式及加密后的私钥等。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "环境记录的唯一标识"
        },
        {
          "name": "project_id",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "所属项目的唯一标识，关联 Project 领域"
        },
        {
          "name": "name",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "环境名称，在所属项目内唯一"
        },
        {
          "name": "host",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "目标主机的 IP 地址或域名"
        },
        {
          "name": "port",
          "type": "INTEGER NOT NULL DEFAULT 22",
          "required": true,
          "description": "SSH 端口号，默认 22"
        },
        {
          "name": "auth_type",
          "type": "TEXT NOT NULL DEFAULT 'key'",
          "required": true,
          "description": "认证方式，取值为 'key' 或 'password'"
        },
        {
          "name": "username",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "SSH 用户名"
        },
        {
          "name": "encrypted_private_key",
          "type": "TEXT",
          "required": false,
          "description": "加密后的私钥内容（auth_type 为 'key' 时使用），空字符串表示未设置"
        },
        {
          "name": "key_fingerprint",
          "type": "TEXT",
          "required": false,
          "description": "私钥的 SHA256 指纹，用于完整性校验和避免重复加密存储"
        },
        {
          "name": "encrypted_passphrase",
          "type": "TEXT",
          "required": false,
          "description": "加密后的私钥口令，空或 NULL 表示未设置"
        },
        {
          "name": "password",
          "type": "TEXT",
          "required": false,
          "description": "密码（auth_type 为 'password' 时使用），加密存储，建议通过 Keychain 等服务管理，此处为占位"
        },
        {
          "name": "label",
          "type": "TEXT NOT NULL DEFAULT 'test'",
          "required": true,
          "description": "环境标签，取值限于 'test'、'gray'、'production'"
        },
        {
          "name": "last_test_status",
          "type": "TEXT NOT NULL DEFAULT 'unknown'",
          "required": true,
          "description": "最近一次连通测试的状态，取值 'unknown'、'success'、'failed'"
        },
        {
          "name": "last_test_at",
          "type": "TEXT",
          "required": false,
          "description": "最近一次连通测试的时间，ISO 8601 格式"
        },
        {
          "name": "created_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "记录创建时间，ISO 8601 格式"
        },
        {
          "name": "updated_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "记录最近更新时间，ISO 8601 格式"
        }
      ],
      "indexes": [
        {
          "name": "idx_environments_project_id",
          "unique": false,
          "columns": [
            "project_id"
          ]
        },
        {
          "name": "uq_environments_project_name",
          "unique": true,
          "columns": [
            "project_id",
            "name"
          ]
        }
      ],
      "constraints": [],
      "lifecycle": {
        "create": "INSERT INTO environments (...) VALUES (...); 由 addEnvironment 服务契约使用",
        "update": "UPDATE environments SET ... WHERE id = ? AND project_id = ?; 由 editEnvironment 使用",
        "delete": "DELETE FROM environments WHERE id = ? AND project_id = ?; 由 deleteEnvironment 使用",
        "retention": "无自动清除策略，由用户主动删除"
      },
      "source_requirements": [
        "REQ-002",
        "REQ-005"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-003"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
