  "error_handling": {
    "strategy": "所有 API 调用均返回统一错误响应体，包含数字错误码、简短错误消息和详细错误说明。客户端应根据错误码进行分类处理，敏感信息不应在 detail 中暴露。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "由无效输入、缺失字段、违反业务规则或资源不存在等客户端侧问题触发。返回详细校验错误信息，帮助用户纠正请求。"
      },
      {
        "code": "5xx",
        "name": "服务端错误",
        "description": "由数据库操作失败、加密解密异常、SSH 连接测试失败或外部服务调用失败等服务器内部问题触发。返回通用错误消息，避免暴露内部实现细节。"
      }
    ]
  },
