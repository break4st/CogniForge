  "service_contracts": [
    {
      "name": "EnvironmentService",
      "description": "负责环境配置的增删改查、密钥安全处理及连通性测试调度",
      "methods": [
        {
          "name": "addEnvironment",
          "signature": "(dto: AddEnvironmentDTO, userId: string) -> EnvironmentResponseDTO",
          "precondition": "userId 非空，dto 通过输入校验（名称必填、主机必填、端口范围 1-65535、标签必为 test/gray/production 之一），同一用户下环境名称唯一",
          "postcondition": "环境配置被持久化，若提供私钥则加密存储，返回新创建环境的完整信息（不含解密私钥）",
          "description": "校验并添加新环境，加密私钥后存储，返回环境信息",
          "exceptions": [
            {
              "name": "ValidationException",
              "trigger": "输入校验失败",
              "http_status": 400
            },
            {
              "name": "BusinessRuleViolationException",
              "trigger": "同一用户下环境名称已存在",
              "http_status": 409
            }
          ]
        },
        {
          "name": "editEnvironment",
          "signature": "(dto: EditEnvironmentDTO, userId: string) -> EnvironmentResponseDTO",
          "precondition": "userId 非空，dto 包含环境 ID 且存在，至少修改一个字段，若有端口则范围 1-65535，若有标签则必为合法值，新名称不得与同一用户下其他环境冲突",
          "postcondition": "数据库中的环境记录被更新，若提供新私钥则重新加密存储并擦除旧私钥，返回更新后的环境信息（不含解密私钥）",
          "description": "校验并更新已有环境配置，处理密钥轮转，返回更新后的环境信息",
          "exceptions": [
            {
              "name": "ValidationException",
              "trigger": "输入校验失败或缺少环境 ID",
              "http_status": 400
            },
            {
              "name": "NotFoundException",
              "trigger": "环境 ID 不存在",
              "http_status": 404
            },
            {
              "name": "BusinessRuleViolationException",
              "trigger": "修改后的名称与同一用户下其他环境冲突",
              "http_status": 409
            }
          ]
        },
        {
          "name": "deleteEnvironment",
          "signature": "(dto: DeleteEnvironmentDTO, userId: string) -> void",
          "precondition": "userId 非空，dto 包含环境 ID 且存在，该环境下没有活跃的部署",
          "postcondition": "对应的环境记录连同加密私钥一同从数据库删除",
          "description": "校验并删除环境配置，确保无活跃部署后移除记录",
          "exceptions": [
            {
              "name": "ValidationException",
              "trigger": "缺少环境 ID",
              "http_status": 400
            },
            {
              "name": "NotFoundException",
              "trigger": "环境 ID 不存在",
              "http_status": 404
            },
            {
              "name": "BusinessRuleViolationException",
              "trigger": "该环境存在活跃的部署",
              "http_status": 409
            }
          ]
        },
        {
          "name": "listEnvironments",
          "signature": "(projectId: string, userId: string) -> EnvironmentResponseDTO[]",
          "precondition": "projectId 和 userId 非空",
          "postcondition": "返回指定项目下所有环境的列表，每个环境包含基本信息及最新的连通状态，私钥字段置空或脱敏",
          "description": "查询项目下所有环境并组装响应，最新连通状态来自缓存或默认 unknown",
          "exceptions": []
        },
        {
          "name": "testConnection",
          "signature": "(dto: TestConnectionDTO, userId: string) -> TestConnectionResultDTO",
          "precondition": "userId 非空，dto 包含环境 ID 且环境存在",
          "postcondition": "调用 Security Module 解密私钥（若有），通过 SSH Service 执行连接测试，得到成功或失败的结果，更新缓存中的连通状态，返回测试结果，使用后立即从内存擦除私钥",
          "description": "解密私钥并调度 SSH 连接测试，更新状态，返回测试结果",
          "exceptions": [
            {
              "name": "NotFoundException",
              "trigger": "环境 ID 不存在",
              "http_status": 404
            },
            {
              "name": "CryptoOperationException",
              "trigger": "私钥解密失败",
              "http_status": 500
            },
            {
              "name": "SSHConnectionException",
              "trigger": "SSH 连接测试过程异常",
              "http_status": 502
            }
          ]
        }
      ],
      "repository_dependencies": [
        "findByNameAndCreatedBy(userId: string, name: string) -> EnvironmentRecord?",
        "existsActiveDeployment(environmentId: string) -> boolean",
        "save(record: EnvironmentRecord) -> EnvironmentRecord",
        "findByProjectId(projectId: string) -> EnvironmentRecord[]",
        "findById(id: string) -> EnvironmentRecord?",
        "deleteById(id: string) -> void"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "同一项目下，环境名称必须唯一（不区分大小写）",
      "主机地址必须是有效的IPv4地址或域名",
      "端口号必须在1~65535之间",
      "私钥内容不能为空，且由Security Module加密后才能存入数据库",
      "环境标签只能是test、gray或production之一",
      "每个项目至少保留一个生产环境，不可删除最后一个标记为production的环境"
    ],
    "state_machines": [
      {
        "entity": "EnvironmentEntity",
        "states": [
          "正常使用",
          "连通性测试中",
          "已删除"
        ],
        "transitions": [
          {
            "from": "正常使用",
            "to": "连通性测试中",
            "trigger": "用户发起连通性测试",
            "actor": "用户"
          },
          {
            "from": "连通性测试中",
            "to": "正常使用",
            "trigger": "测试完成",
            "actor": "系统"
          }
        ],
        "irreversible_rules": [
          "状态一旦变为'已删除'，不可逆转到其他状态"
        ],
        "concurrency": "同一个环境只能有一个活跃的连通性测试，测试期间不能删除或编辑"
      }
    ],
    "cross_service_rules": [
      "调用Security Module加密私钥时，必须传递明文私钥和环境ID；解密时需传递加密后的私钥和环境ID，解密后私钥仅用于SSH连接测试，使用后立即从内存中安全擦除",
      "SSH连接测试完成后，必须断开连接并清除所有会话密钥",
      "删除环境时，需先调用Security Module清除相关加密密钥和审计日志引用"
    ]
  },
  "workflow": {
    "name": "环境连通性测试流程",
    "description": "用户发起连通性测试，系统解密私钥并通过SSH Service测试连通性，更新状态并返回结果",
    "steps": [
      {
        "order": 1,
        "name": "接收测试请求",
        "action": "接收TestConnectionDTO，校验环境ID",
        "timeout_seconds": 30,
        "on_failure": "返回400错误"
      },
      {
        "order": 2,
        "name": "获取环境配置",
        "action": "从数据库加载EnvironmentRecord",
        "timeout_seconds": 10,
        "on_failure": "返回404错误"
      },
      {
        "order": 3,
        "name": "解密私钥",
        "action": "调用Security Module解密encrypted_private_key",
        "timeout_seconds": 30,
        "on_failure": "返回500错误"
      }