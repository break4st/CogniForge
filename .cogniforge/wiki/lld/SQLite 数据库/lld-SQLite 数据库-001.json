  "interfaces": [],
  "error_handling": {
    "strategy": "所有数据库操作错误统一捕获并转换为标准错误对象，包含错误码、通用信息和详细描述，向上层抛出以便转换为友好提示。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "500",
        "name": "数据库错误",
        "description": "SQLite 执行出错（如 SQLITE_BUSY、表不存在等），记录详细日志并返回通用内部错误，不再重试。"
      },
      {
        "code": "400",
        "name": "数据校验错误",
        "description": "插入或更新时数据不符合约束（如唯一键冲突、外键缺失），返回具体字段错误，由应用层校正后重试。"
      }
    ]
  },
  "workflow": {
    "name": "数据库初始化与迁移流程",
    "description": "在应用启动时自动检查并执行数据库迁移，确保表结构与预期版本一致。",
    "steps": [
      {
        "order": 1,
        "name": "检查数据库文件",
        "action": "检测 SQLite 数据库文件是否存在，不存在则自动创建。",
        "timeout_seconds": 5,
        "on_failure": "输出错误日志并终止启动"
      },
      {
        "order": 2,
        "name": "运行迁移脚本",
        "action": "按版本顺序执行未应用的迁移脚本，记录迁移状态。",
        "timeout_seconds": 30,
        "on_failure": "回滚当前批次迁移（若支持），打印详情并终止启动"
      },
      {
        "order": 3,
        "name": "验证表结构",
        "action": "检查关键表及索引是否存在，确保迁移成功。",
        "timeout_seconds": 10,
        "on_failure": "抛出验证失败错误，阻止应用继续"
      }
    ],
    "retry_strategy": {
      "max_retries": 0,
      "retry_interval_seconds": 0,
      "retryable_errors": [],
      "non_retryable_errors": [
        "MIGRATION_ERROR",
        "SCHEMA_VERIFICATION_ERROR"
      ]
    }
  },
  "index_strategy": [
    {
      "table": "projects",
      "indexes": [
        {
          "name": "idx_projects_name",
          "columns": [
            "name"
          ],
          "unique": true,
          "type": "B-tree",
          "purpose": "确保项目名称唯一，加速按名称查询"
        }
      ]
    },
    {
      "table": "environments",
      "indexes": [
        {
          "name": "idx_environments_project_id",
          "columns": [
            "project_id"
          ],
          "unique": false,
          "type": "B-tree",
          "purpose": "加速根据项目 ID 查询其所有环境"
        },
        {
          "name": "idx_environments_name_project",
          "columns": [
            "name",
            "project_id"
          ],
          "unique": true,
          "type": "B-tree",
          "purpose": "同一项目内环境名称唯一，防止重复"
        }
      ]
    },
    {
      "table": "deployments",
      "indexes": [
        {
          "name": "idx_deployments_environment_id",
          "columns": [
            "environment_id"
          ],
          "unique": false,
          "type": "B-tree",
          "purpose": "加速按环境查询部署记录"
        },
        {
          "name": "idx_deployments_status",
          "columns": [
            "status"
          ],
          "unique": false,
          "type": "B-tree",
          "purpose": "加速按状态过滤（进行中、失败等）"
        },
        {
          "name": "idx_deployments_start_time",
          "columns": [
            "start_time"
          ],
          "unique": false,
          "type": "B-tree",
          "purpose": "支持按时间范围查询部署记录"
        }
      ]
    },
    {
      "table": "script_templates",
      "indexes": [
        {
          "name": "idx_script_templates_name",
          "columns": [
            "name"
          ],
          "unique": true,
          "type": "B-tree",
          "purpose": "确保模板名称唯一，便于检索"
        }
      ]
    }
  ],
  "migration_strategy": {
    "tool": "node-db-migrate",
    "naming": "V{YYYYMMDDHHMMSS}__{description}.sql",
    "rollback": "每个迁移脚本提供对应的 down.sql 实现回滚，迁移工具记录已执行版本，失败时可按需回滚至稳定版本。"
  },
  "capacity_estimation": {
    "estimated_rows_1y": "项目表 < 100 行，环境表 < 500 行，部署历史表约 5,000 ~ 10,000 行，脚本模板表 < 50 行",
    "estimated_rows_3y": "项目表 < 300 行，环境表 < 1,500 行，部署历史表约 30,000 行，脚本模板表 < 100 行",
    "hot_tables": [
      "deployments",
      "environments"
    ],
    "partition_strategy": "SQLite 不支持表分区，通过定期归档历史部署记录到另一个数据库文件来管理数据增长。"
  },
  "connection_contracts": {
    "pool_size": "1 (SQLite 写操作串行化，读操作可并发，但连接池大小设为 1 以避免锁竞争)",
    "timeout": "5000ms",
    "service_accounts": [
      {
        "service": "数据访问层（所有后端服务共用）",
        "db_user": "app_user",
        "privileges": [
          "SELECT",
          "INSERT",
          "UPDATE",
          "DELETE"
        ]
      }
    ]
  }
}