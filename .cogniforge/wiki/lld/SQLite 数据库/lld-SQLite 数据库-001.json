          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "项目唯一标识"
        },
        {
          "name": "name",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "description",
          "type": "TEXT",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_projects_name",
          "unique": true,
          "columns": [
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "用户创建项目时插入新记录",
        "update": "项目信息编辑时更新记录",
        "delete": "项目删除时删除记录（级联删除关联环境？）",
        "retention": "永久保留，除非用户主动删除"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "environments",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "存储项目下的部署环境",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "环境唯一标识"
        },
        {
          "name": "project_id",
          "type": "INTEGER NOT NULL",
          "required": true,
          "description": "所属项目 ID，外键关联 projects(id)"
        },
        {
          "name": "name",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "环境名称（如 dev, staging, prod）"
        },
        {
          "name": "env_type",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "环境类型：development, testing, staging, production"
        },
        {
          "name": "config_json",
          "type": "TEXT",
          "required": false,
          "description": "环境配置 JSON 字符串"
        },
        {
          "name": "created_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_environments_project_id",
          "unique": false,
          "columns": [
            "project_id"
          ]
        },
        {
          "name": "idx_environments_name_project",
          "unique": true,
          "columns": [
            "name",
            "project_id"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE"
      ],
      "lifecycle": {
        "create": "在项目下添加环境时插入",
        "update": "环境配置修改时更新",
        "delete": "移除环境时删除",
        "retention": "与项目生命周期相同"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "deployments",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "存储部署执行历史记录",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "部署记录唯一标识"
        },
        {
          "name": "environment_id",
          "type": "INTEGER NOT NULL",
          "required": true,
          "description": "目标环境 ID，外键关联 environments(id)"
        },
        {
          "name": "script_template_id",
          "type": "INTEGER",
          "required": false,
          "description": "使用的脚本模板 ID，外键关联 script_templates(id)"
        },
        {
          "name": "status",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "部署状态：pending, running, success, failed, cancelled"
        },
        {
          "name": "start_time",
          "type": "TEXT",
          "required": false,
          "description": "开始时间"
        },
        {
          "name": "end_time",
          "type": "TEXT",
          "required": false,
          "description": "结束时间"
        },
        {
          "name": "log",
          "type": "TEXT",
          "required": false,
          "description": "部署日志输出"
        },
        {
          "name": "created_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "记录创建时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_deployments_environment_id",
          "unique": false,
          "columns": [
            "environment_id"
          ]
        },
        {
          "name": "idx_deployments_status",
          "unique": false,
          "columns": [
            "status"
          ]
        },
        {
          "name": "idx_deployments_start_time",
          "unique": false,
          "columns": [
            "start_time"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "FOREIGN KEY (environment_id) REFERENCES environments(id) ON DELETE CASCADE",
        "FOREIGN KEY (script_template_id) REFERENCES script_templates(id) ON DELETE SET NULL"
      ],
      "lifecycle": {
        "create": "部署开始时创建记录",
        "update": "部署过程中更新状态和日志",
        "delete": "历史清理时可能删除过期记录",
        "retention": "保留至少 1 年，可由管理员配置自动清理策略"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
