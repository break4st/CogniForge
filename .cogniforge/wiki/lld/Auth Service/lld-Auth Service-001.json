          "DO-005",
          "DO-006",
          "DO-007",
          "DO-008",
          "DO-009",
          "DO-010"
        ],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "User",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "user"
      },
      "description": "用户主体数据库表引用,本服务仅关注认证相关字段。",
      "fields": [
        {
          "name": "id",
          "type": "Long",
          "required": true,
          "description": "用户主键,自增"
        },
        {
          "name": "username",
          "type": "String",
          "required": true,
          "description": "用户名,唯一索引"
        },
        {
          "name": "password_hash",
          "type": "String",
          "required": true,
          "description": "加密后的密码Hash"
        },
        {
          "name": "email",
          "type": "String",
          "required": false,
          "description": "邮箱,选填"
        },
        {
          "name": "role",
          "type": "String",
          "required": true,
          "description": "角色枚举,USER或ADMIN"
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "description": "账户状态:ACTIVE,DISABLED,LOCKED"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_username",
          "unique": true,
          "columns": [
            "username"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "username必须全局唯一",
        "password_hash不可为空"
      ],
      "lifecycle": {
        "create": "用户注册时插入记录",
        "update": "账户状态变更或密码修改时更新",
        "delete": "一般不物理删除,通过status标记",
        "retention": "永久保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "RefreshToken",
      "type": "store",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "Redis中存储的刷新令牌信息,用于校验和轮换。",
      "fields": [
        {
          "name": "token_id",
          "type": "String",
          "required": true,
          "description": "令牌唯一ID(UUID)"
        },
        {
          "name": "user_id",
          "type": "Long",
          "required": true,
          "description": "关联用户ID"
        },
        {
          "name": "username",
          "type": "String",
          "required": true,
          "description": "关联用户名(冗余加速)"
        },
        {
          "name": "issued_at",
          "type": "DateTime",
          "required": true,
          "description": "签发时间"
        },
        {
          "name": "expires_at",
          "type": "DateTime",
          "required": true,
          "description": "绝对过期时间"
        },
        {
          "name": "is_revoked",
          "type": "Boolean",
          "required": true,
          "description": "是否已被撤销"
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "每个token_id全局唯一",
        "expires_at必须晚于issued_at"
      ],
      "lifecycle": {
        "create": "登录或刷新时生成,TTL设置",
        "update": "刷新时标记旧令牌撤销,插入新记录",
        "delete": "撤销或过期后删除",
        "retention": "最长7天(可配置)"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "domain_objects": [
    {
      "name": "UserVO",
      "object_type": "value_object",
      "description": "用户值对象,封装用户核心标识属性",
      "fields": [
        {
          "name": "id",
          "type": "Long"
        },
        {
          "name": "username",
          "type": "String"
        },
        {
          "name": "role",
          "type": "String"
        },
        {
          "name": "status",
          "type": "String"
        }
      ]
    },
    {
      "name": "RegistrationCommand",
      "object_type": "command",
      "description": "注册命令对象,封装注册所需数据",
      "fields": [
        {
          "name": "username",
          "type": "String"
        },
        {
          "name": "password",
          "type": "String"
        },
        {
          "name": "email",
          "type": "String"
        }
      ]
    },
    {
      "name": "LoginCommand",
      "object_type": "command",
      "description": "登录命令对象",
      "fields": [
        {
          "name": "username",
          "type": "String"
        },
        {
          "name": "password",
          "type": "String"
        }
      ]
    },
    {
      "name": "RefreshTokenCommand",
      "object_type": "command",
      "description": "刷新令牌命令对象",
      "fields": [
        {
          "name": "refresh_token",
          "type": "String"
        }
      ]
    },
    {
      "name": "TokenPair",
      "object_type": "value_object",
      "description": "令牌对值对象,包含访问令牌和刷新令牌",
      "fields": [
        {
          "name": "access_token",
          "type": "String"
        },
        {
          "name": "refresh_token",
          "type": "String"
        },
        {
          "name": "expires_in",
          "type": "Integer"
        }
      ]
    },
    {
      "name": "JwtPayload",
      "object_type": "value_object",
      "description": "JWT载荷标准字段",
      "fields": [
        {
          "name": "sub",
          "type": "String"
        },
        {
          "name": "iat",
          "type": "Long"
        },
        {
          "name": "exp",
          "type": "Long"
        },
        {
          "name": "jti",
          "type": "String"
        },
        {
          "name": "role",
          "type": "String"
        }
      ]
    },
    {
      "name": "UserCredentials",
      "object_type": "entity",
      "description": "用户凭证实体,用于内部密码校验逻辑",
      "fields": [
        {
          "name": "username",
          "type": "String"
        },
        {
          "name": "passwordHash",
          "type": "String"
        }
      ]
    },
    {
      "name": "TokenValidationResult",
      "object_type": "domain_event",
      "description": "令牌验证结果领域事件",
      "fields": [
        {
          "name": "valid",
          "type": "Boolean"
        },
        {
          "name": "claims",
          "type": "Map"
        },
        {
          "name": "error",
          "type": "String"
        }
      ]
    },
    {
      "name": "AuthService",
      "object_type": "service",
      "description": "认证领域服务接口,定义核心业务方法契约"
    },
    {
      "name": "AuthServiceImpl",
      "object_type": "service",
      "description": "认证领域服务实现"
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "Register",
      "type": "http",
      "endpoint": "POST /auth/register",
      "description": "用户注册接口",
      "request": {
        "body": {
          "username": "string",
          "password": "string",
          "email": "string"
        }
      },
      "responses": {
        "201": {
          "description": "注册成功",
          "body": {
            "id": "integer",
            "username": "string",
            "role": "string",
            "status": "string"
          }
        },
        "409": {
          "description": "用户名已存在",
          "body": {
            "code": "string",
            "message": "string"
          }
        }
      },
      "auth_required": false,
      "logic": "注册新用户,校验唯一性,存储哈希密码,返回用户信息",
      "performance": "响应时间<200ms",
      "error_codes": [
        {
          "code": "reg-001",
          "message": "用户名已存在"
        },
        {
          "code": "reg-002",
          "message": "输入验证失败"
        },
        {
          "code": "reg-003",
          "message": "内部错误"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "Login",
      "type": "http",
      "endpoint": "POST /auth/login",
      "description": "用户登录接口",
      "request": {
        "body": {
          "username": "string",
          "password": "string"
        }
      },
      "responses": {
        "200": {
          "description": "登录成功",
          "body": {
            "access_token": "string",
            "refresh_token": "string",
            "expires_in": "integer"
          }
        },
        "401": {
          "description": "凭证无效",
          "body": {
            "code": "string",
            "message": "string"
          }
        },
        "403": {
          "description": "账户被禁用或锁定",
          "body": {
            "code": "string",
            "message": "string"
          }
        }
      },
      "auth_required": false,
      "logic": "验证凭证,生成JWT访问令牌和刷新令牌,返回令牌对",
      "performance": "响应时间<300ms",
      "error_codes": [
        {
          "code": "auth-001",
          "message": "用户名或密码错误"
        },
        {
          "code": "auth-002",
          "message": "账户状态异常"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "RefreshToken",
      "type": "http",
      "endpoint": "POST /auth/refresh",
      "description": "刷新访问令牌接口",
      "request": {
        "body": {
          "refresh_token": "string"
        }
      },
      "responses": {
        "200": {
          "description": "令牌刷新成功",
          "body": {
            "access_token": "string",
            "refresh_token": "string",
            "expires_in": "integer"
          }
        },
        "401": {
          "description": "刷新令牌无效或过期",
          "body": {
            "code": "string",
            "message": "string"
          }
        }
      },
      "auth_required": false,
      "logic": "验证刷新令牌,撤销旧令牌,颁发新令牌对",
      "performance": "响应时间<200ms",
      "error_codes": [
        {
          "code": "token-001",
          "message": "刷新令牌无效"
        },
        {
          "code": "token-002",
          "message": "刷新令牌已过期"
        }
      ]
    },
    {
      "id": "IF-004",
      "name": "VerifyToken",
      "type": "http",
      "endpoint": "GET /auth/verify",
      "description": "验证访问令牌有效性(内部API)",
      "request": {
        "headers": {
          "Authorization": "Bearer <access_token>"
        }
      },
      "responses": {
        "200": {
          "description": "令牌有效",
          "body": {
            "valid": "boolean",
            "user_id": "integer",
            "username": "string",
            "role": "string"
          }
        },
        "401": {
          "description": "令牌无效或过期",
          "body": {
            "code": "string",
            "message": "string"
          }
        }
      },
      "auth_required": true,
      "logic": "解析并校验JWT签名和有效期,返回用户信息",
      "performance": "响应时间<50ms",
      "error_codes": [
        {
          "code": "token-003",
          "message": "令牌验证失败"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "AuthServiceContract",
      "description": "认证服务契约,定义内部可调用接口",
      "interfaces": [
        {
          "id": "CTR-001",
          "name": "verify_token",
          "type": "internal",
          "endpoint": "rpc auth.verify_token",
          "description": "内部RPC验证令牌,供其他服务使用"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "rule": "密码强度必须至少8位字符,包含大小写字母和数字",
      "type": "invariant",
      "enforcement": "注册和修改密码时校验"
    },
    {
      "id": "BR-002",
      "rule": "用户名必须唯一且长度在3到20个字符之间",
      "type": "invariant",
      "enforcement": "注册时校验"
    },
    {
      "id": "BR-003",
      "rule": "访问令牌有效期为15分钟",
      "type": "invariant",
      "enforcement": "创建令牌时设置"
    },
    {
      "id": "BR-004",
      "rule": "刷新令牌有效期为7天",
      "type": "invariant",
      "enforcement": "创建令牌时设置"
    },
    {
      "id": "BR-005",
      "rule": "刷新令牌一次使用后即撤销,同时颁发新令牌对",
      "type": "invariant",
      "enforcement": "刷新令牌操作中执行"
    },
    {
      "id": "BR-006",
      "rule": "账户状态为DISABLED或LOCKED时禁止登录",
      "type": "invariant",
      "enforcement": "登录时检查用户状态"
    }
  ],
  "error_handling": {
    "strategy": "统一错误码,HTTP状态码映射,全局异常处理器",
    "error_codes": [
      {
        "code": "reg-001",
        "http_status": 409,
        "message": "用户名已存在"
      },
      {
        "code": "reg-002",
        "http_status": 422,
        "message": "输入验证失败"
      },
      {
        "code": "reg-003",
        "http_status": 500,
        "message": "内部错误"
      },
      {
        "code": "auth-001",
        "http_status": 401,
        "message": "用户名或密码错误"
      },
      {
        "code": "auth-002",
        "http_status": 403,
        "message": "账户状态异常"
      },
      {
        "code": "token-001",
        "http_status": 401,
        "message": "刷新令牌无效"
      },
      {
        "code": "token-002",
        "http_status": 401,
        "message": "刷新令牌已过期"
      },
      {
        "code": "token-003",
        "http_status": 401,
        "message": "令牌验证失败"
      }
    ]
  },
  "testing": {
    "unit_tests": [],
    "integration_tests": [],
    "pending": "待后续细化"
  },
  "change_history": [
    {
      "version": 1,
