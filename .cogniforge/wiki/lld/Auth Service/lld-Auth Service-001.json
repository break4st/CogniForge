      "DM-002",
      "DM-003"
    ],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "负责用户认证与授权，签发和验证JWT，管理用户信息。提供注册、登录及令牌刷新接口。",
    "dependencies": [
      "Primary Database",
      "Redis"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "MySQL 8.0",
      "Redis 7",
      "Docker"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
