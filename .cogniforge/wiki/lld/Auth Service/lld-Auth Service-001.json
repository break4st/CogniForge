  "module_boundary": {
    "in_scope": [
      "用户注册、登录、JWT签发与验证",
      "令牌刷新",
      "用户账户状态管理",
      "角色与权限的简单管理",
      "提供内部JWT验证能力"
    ],
    "out_of_scope": [
      "不处理前端UI或路由",
      "不涉及OAuth2/SSO等外部认证协议",
      "不直接管理业务资源(项目、部署等)",
      "不负责密码重置(默认预留)"
    ],
    "owned_components": [
      "CMP-003"
    ],
    "owned_contracts": [
      "CTR-001",
      "CTR-002",
      "CTR-003"
    ],
