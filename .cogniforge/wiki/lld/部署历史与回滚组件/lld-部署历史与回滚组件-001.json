        "service_contracts": []
      },
      "coverage": "full",
      "notes": "组件负责前端展示与交互，调用后端版本历史和部署执行服务"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "DeployHistoryItem",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "单条部署历史记录，用于前端列表渲染",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "部署记录唯一标识"
        },
        {
          "name": "project_name",
          "type": "string",
          "required": true,
          "description": "项目名称"
        },
        {
          "name": "environment",
          "type": "string",
          "required": true,
          "description": "部署环境（如 production, staging）"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "description": "部署版本号"
        },
        {
          "name": "status",
          "type": "enum",
          "required": true,
          "description": "部署状态：success, failure, running, rollbacking"
        },
        {
          "name": "deployed_at",
          "type": "datetime",
          "required": true,
          "description": "部署时间"
        },
        {
          "name": "duration",
          "type": "number",
          "required": false,
          "description": "部署耗时（秒）"
        },
        {
          "name": "rollback_available",
          "type": "boolean",
          "required": true,
          "description": "是否允许回滚"
        }
      ],
