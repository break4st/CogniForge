      ],
      "constraints": [],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "路由导航",
      "method": "GET",
