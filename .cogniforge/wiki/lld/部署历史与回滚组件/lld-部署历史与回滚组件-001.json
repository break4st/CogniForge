    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "name": "回滚可用性规则",
      "description": "只有状态为 'success' 且距离部署完成时间不超过24小时的记录才显示回滚按钮",
      "trigger": "渲染操作列时",
      "condition": "status === 'success' && (Date.now() - new Date(deployed_at).getTime()) < 86400000",
      "action": "显示回滚按钮，否则禁用或隐藏",
      "source_requirements": [
        "REQ-001"
      ]
    },
    {
      "id": "BR-002",
      "name": "自动刷新规则",
      "description": "当列表中存在状态为 'running' 或 'rollbacking' 的记录时，每10秒自动轮询刷新列表",
      "trigger": "组件挂载和列表数据更新时",
      "condition": "列表中存在 status 为 'running' 或 'rollbacking' 的记录",
      "action": "设置定时器，每10秒调用获取部署历史列表接口",
      "source_requirements": [
        "REQ-001"
      ]
    }
  ],
  "component_tree": {
    "description": "部署历史与回滚组件的React组件层次结构",
    "root": "DeploymentHistoryPage",
    "children": [
      {
        "component": "DeploymentTable",
        "description": "展示部署历史表格",
        "children": [
          {
            "component": "StatusBadge",
            "description": "渲染部署状态徽标"
          },
          {
            "component": "OperationColumn",
            "description": "操作列，包含查看日志和回滚按钮",
            "children": [
              {
                "component": "RollbackButton",
                "description": "回滚按钮，点击弹出确认弹窗"
              }
            ]
          }
        ]
      },
      {
        "component": "FilterBar",
        "description": "筛选条件区域，包含环境、状态、时间范围筛选"
      },
      {
        "component": "Pagination",
        "description": "分页器"
      }
    ]
  },
  "state_design": {
    "description": "组件内部状态管理设计",
    "states": [
      {
        "name": "deploymentHistory",
        "type": "DeployHistoryItem[]",
        "initial_value": [],
        "description": "部署历史数据列表"
      },
      {
        "name": "pagination",
        "type": "PaginationState",
        "initial_value": "{ current: 1, page_size: 10, total: 0 }",
        "description": "分页状态"
      },
      {
        "name": "filters",
        "type": "FilterState",
        "initial_value": "{}",
        "description": "筛选条件"
      },
      {
        "name": "loading",
        "type": "boolean",
        "initial_value": false,
        "description": "列表加载状态"
      },
      {
        "name": "rollbackModalVisible",
        "type": "boolean",
        "initial_value": false,
        "description": "回滚确认弹窗可见性"
      },
      {
        "name": "selectedDeployment",
        "type": "DeployHistoryItem | null",
        "initial_value": null,
        "description": "当前选中的部署记录（用于回滚确认）"
      }
    ]
  },
  "route_design": {
    "description": "路由配置",
    "routes": [
      {
        "path": "/deployments/history",
        "component": "DeploymentHistoryPage",
        "meta": {
          "title": "部署历史",
          "auth_required": true
        }
      }
    ]
  },
  "interaction_flows": [
    {
      "id": "FLOW-001",
      "name": "回滚操作流程",
      "description": "用户点击回滚按钮，确认后调用回滚接口并处理结果",
      "steps": [
        {
          "step": 1,
          "actor": "用户",
          "action": "点击回滚按钮",
          "next": "显示确认弹窗"
        },
        {
          "step": 2,
          "actor": "系统",
          "action": "显示确认弹窗，提示用户确认回滚",
          "next": "用户确认或取消"
        },
        {
          "step": 3,
          "actor": "用户",
          "action": "点击确认",
          "next": "调用回滚接口"
        },
        {
          "step": 4,
          "actor": "系统",
          "action": "发送POST请求到 /api/deployments/{id}/rollback",
          "next": "处理响应"
        },
        {
          "step": 5,
          "actor": "系统",
          "action": "根据响应显示成功或失败消息，并刷新列表",
          "next": "结束"
        }
      ],
      "error_handling": {
        "strategy": "如果接口返回错误，显示错误消息并停止加载状态；如果是409状态码，提示无法回滚；网络错误提示重试。"
      }
    }
  ],
  "api_integration": {
    "description": "与后端API的集成细节",
    "contracts": [
      {
        "contract_id": "CTR-001",
        "endpoint": "GET /api/deployments/history",
        "mapping_to_state": "更新 deploymentHistory 和 pagination"
      },
      {
        "contract_id": "CTR-010",
        "endpoint": "POST /api/deployments/{deployment_id}/rollback",
        "mapping_to_state": "调用后刷新列表"
      }
    ],
    "error_handling": {
      "strategy": "统一使用try-catch捕获异步错误，根据error.response.status显示对应错误信息，并设置错误边界提示用户。"
    }
  }
}