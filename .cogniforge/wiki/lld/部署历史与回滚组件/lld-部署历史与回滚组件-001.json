  "interfaces": [
    {
      "id": "IF-001",
      "name": "获取部署历史列表",
      "method": "GET",
      "endpoint": "/api/deployments/history",
      "source_contract_id": "CTR-001",
      "http_method": "GET",
      "path": "/api/deployments/history",
      "request_body_schema": null,
      "response_body_schema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "DM-001"
            }
          },
          "pagination": {
            "$ref": "DM-002"
          }
        }
      },
      "error_codes": [
        {
          "code": "400",
          "message": "请求参数错误"
        },
        {
          "code": "500",
          "message": "服务器内部错误"
        }
      ],
      "consumer_component_ids": [
        "CMP-001"
      ],
      "type": "HTTP",
      "description": "获取分页的部署历史列表，支持筛选和排序",
      "source_requirements": [
        "REQ-001"
      ],
      "constraints": [],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "回滚部署",
      "method": "POST",
      "endpoint": "/api/deployments/{deployment_id}/rollback",
      "source_contract_id": "CTR-010",
      "http_method": "POST",
      "path": "/api/deployments/{deployment_id}/rollback",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "deployment_id": {
            "type": "string"
          }
        }
      },
      "response_body_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "new_deployment_id": {
            "type": "string"
          }
        }
      },
      "error_codes": [
        {
          "code": "400",
          "message": "请求参数错误"
        },
        {
          "code": "404",
          "message": "部署记录不存在"
        },
        {
          "code": "409",
          "message": "当前状态不允许回滚"
        },
        {
          "code": "500",
          "message": "服务器内部错误"
        }
      ],
      "consumer_component_ids": [
        "CMP-001"
