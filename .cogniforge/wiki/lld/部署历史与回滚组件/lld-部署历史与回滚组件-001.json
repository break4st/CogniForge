  "module_boundary": {
    "in_scope": [
      "部署历史数据的分页查询与展示",
      "回滚操作的前端交互（确认弹窗、API调用、状态反馈）",
      "跳转至日志详情页面的导航逻辑",
      "列表的排序、筛选（按环境、状态、时间）",
      "针对进行中部署的状态轮询或手动刷新"
    ],
    "out_of_scope": [
      "实际执行部署或回滚的业务逻辑（由后端服务处理）",
      "日志内容的实时流式展示（由实时日志与控制台组件负责）",
      "项目/环境配置管理（由项目列表、环境列表等组件负责）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [],
