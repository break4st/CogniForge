      "CTR-001",
      "CTR-002"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "前端部署历史与回滚组件，以表格形式展示每次部署的版本、环境、时间、状态等信息，支持查看日志和发起回滚操作。",
    "dependencies": [
      "实时日志与控制台组件",
      "API路由代理"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design (Table, Button, Modal, message, Badge, Pagination)",
      "React Router",
      "Axios",
      "React Hooks"
    ]
  },
