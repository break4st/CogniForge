    ],
    "consumed_data_models": []
  },
  "overview": {
    "description": "前端组件，展示当前项目下的所有环境，支持新增、编辑、克隆、删除环境配置。",
    "dependencies": [
      "环境配置服务"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design"
    ]
  },
  "business_rules": {
    "invariants": [
      "环境列表始终反映当前项目的最新状态",
      "私钥字段在界面上始终遮蔽显示",
      "表单提交前必须通过客户端校验",
      "删除操作需要二次确认"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-002",
      "sad_component_ids": [
        "CMP-301"
      ],
      "sad_contract_ids": [
        "CTR-004",
        "CTR-005",
        "CTR-006",
        "CTR-007"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001"
        ],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [],
        "service_contracts": []
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "Environment",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "前端视图与表单模型，表示一个环境配置的完整信息",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "环境唯一标识"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "环境名称"
        },
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "远程主机地址"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "SSH 端口，默认 22"
        },
        {
          "name": "auth_type",
          "type": "string",
          "required": true,
          "description": "认证方式：password 或 private_key"
        },
        {
          "name": "private_key",
          "type": "string",
          "required": false,
          "description": "私钥内容（仅当 auth_type=private_key 时有效，前端始终遮蔽）"
        },
        {
          "name": "deploy_root_path",
          "type": "string",
          "required": true,
          "description": "部署根目录"
        },
        {
          "name": "max_releases",
          "type": "integer",
          "required": true,
          "description": "保留的最大发行版数量，大于 0"
        },
        {
          "name": "post_deploy_script",
          "type": "string",
          "required": false,
          "description": "部署后执行脚本"
        }
      ],
      "source_requirements": [
        "REQ-002"
      ],
      "source_components": [
        "CMP-301"
      ],
      "source_contracts": [
        "CTR-004"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "用户通过表单新建环境时创建",
        "update": "编辑或克隆环境时更新字段",
        "delete": "删除环境后从列表中移除",
        "retention": ""
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "环境管理页",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-004",
      "provider_component_id": "CMP-301",
      "method": "frontend",
      "endpoint": "/environments",
      "description": "环境列表与增删改克隆操作的界面",
      "parameters": [
        {
          "name": "projectId",
          "type": "string",
          "in": "query",
          "required": true,
          "description": "当前项目 ID"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "description": "状态码，200 表示成功"
            },
            "data": {
              "type": "array",
              "description": "环境列表",
              "items": {
                "$ref": "DM-001"
              }
            },
            "error": {
              "type": "string",
              "description": "错误信息，成功时为空"
            }
          }
        }
      },
      "error_codes": [
        {
          "code": "400",
          "message": "请求参数错误"
        },
        {
          "code": "401",
          "message": "未授权"
        },
        {
          "code": "404",
          "message": "项目不存在"
        },
        {
          "code": "500",
          "message": "服务器内部错误"
        }
      ],
      "auth": {
        "required": true,
        "policy": "admin,operator"
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-002"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "workflow": {
    "steps": [
      {
        "id": "2",
        "name": "获取环境列表",
        "description": "页面加载时，调用后端接口获取当前项目的环境列表",
        "action": "fetchEnvironments"
      },
      {
        "id": "1",
        "name": "加载页面框架",
        "description": "渲染页面基本布局，包含按钮和表格容器",
        "action": "renderPageShell"
      },
      {
        "id": "3",
        "name": "展示操作按钮",
        "description": "在表格上方或行内展示新增、编辑、克隆、删除等操作按钮",
        "action": "renderActionButtons"
      },
      {
        "id": "4",
        "name": "渲染环境表格",
        "description": "将环境列表数据渲染到 Ant Design Table 组件中",
        "action": "renderEnvironmentTable"
      }
    ]
  },
  "component_tree": {
    "root": "EnvironmentManagementPage",
    "description": "页面级组件，环境列表与配置的根组件",
    "children": [
      {
        "name": "EnvironmentTable",
        "description": "展示环境列表的表格组件",
        "children": [
          {
            "name": "TableActions",
            "description": "表格操作列，包含编辑、克隆、删除按钮"
          }
        ]
      },
      {
        "name": "EnvironmentFormModal",
        "description": "新增或编辑环境的模态框表单",
        "children": [
          {
            "name": "PrivateKeyInput",
            "description": "私钥输入组件，支持遮蔽显示和上传文件"
          }
        ]
      }
    ]
  },
  "state_design": {
    "state_variables": [
      {
        "name": "environments",
        "type": "Environment[]",
        "initial": "[]",
        "description": "当前项目下的环境列表"
      },
      {
        "name": "loading",
        "type": "boolean",
        "initial": "false",
        "description": "列表加载状态"
      },
      {
        "name": "modalVisible",
        "type": "boolean",
        "initial": "false",
        "description": "环境表单模态框是否可见"
      },
      {
        "name": "formMode",
        "type": "'create' | 'edit' | 'clone'",
        "initial": "'create'",
        "description": "当前表单模式"
      },
      {
        "name": "selectedEnvironment",
        "type": "Environment | null",
        "initial": "null",
        "description": "当前编辑或克隆的环境对象"
      },
      {
        "name": "showPrivateKey",
        "type": "boolean",
        "initial": "false",
        "description": "是否明文显示私钥"
      }
    ],
    "state_management": "React useState / useReducer within page, or global store if cross-component"
  },
  "route_design": {
    "base_path": "/projects/:projectId/environments",
    "routes": [
      {
        "path": "/",
        "component": "EnvironmentManagementPage",
        "exact": true,
        "description": "环境列表主页面"
      }
    ]
  },
  "interaction_flows": [
    {
      "name": "新增环境",
      "trigger": "用户点击'新增环境'按钮",
      "steps": [
        "打开模态框，表单模式设为 create，清空表单字段",
        "用户填写表单并提交",
        "前端校验表单，通过后调用 POST /api/projects/{projectId}/environments",
        "成功后关闭模态框，刷新环境列表",
        "失败则显示后端错误信息"
      ]
    },
    {
      "name": "编辑环境",
      "trigger": "用户点击表格行中的'编辑'按钮",
      "steps": [
        "打开模态框，表单模式设为 edit，填充选中环境的当前值",
        "用户修改表单并提交",
        "前端校验，通过后调用 PUT /api/projects/{projectId}/environments/{envId}",
        "成功后关闭模态框，刷新列表",
        "失败则显示错误信息"
      ]
    }
  ],
  "api_integration": {
    "base_url": "/api",
    "endpoints": [
      {
        "method": "GET",
        "path": "/projects/{projectId}/environments",
        "description": "获取环境列表",
        "request": {},
        "response": {
          "success": {
            "status": 200,
            "body": {
              "code": 200,
              "data": "Environment[]",
              "error": ""
            }
          }
        },
        "error_handling": "显示全局错误提示或列表加载失败状态"
      },
      {
        "method": "POST",
        "path": "/projects/{projectId}/environments",
        "description": "创建新环境",
        "request": {
          "body": "Environment (omit id)"
        },
        "response": {
          "success": {
            "status": 201,
            "body": {
              "code": 200,
              "data": "Environment",
              "error": ""
            }
          }
        },
        "error_handling": "在表单下方显示字段级或全局错误信息"
      },
      {
        "method": "PUT",
        "path": "/projects/{projectId}/environments/{envId}",
        "description": "更新环境",
        "request": {
          "body": "Environment"
        },
        "response": {
          "success": {
            "status": 200,
            "body": {
              "code": 200,
              "data": "Environment",
              "error": ""
            }
          }
        },
        "error_handling": "在表单下方显示错误信息"
      },
      {
        "method": "DELETE",
        "path": "/projects/{projectId}/environments/{envId}",
        "description": "删除环境",
        "request": {},
        "response": {
          "success": {
            "status": 200,
            "body": {
              "code": 200,
              "data": null,
              "error": ""
            }
          }
        },
        "error_handling": "显示错误提示，不刷新列表"
      }
    ]
  }
}