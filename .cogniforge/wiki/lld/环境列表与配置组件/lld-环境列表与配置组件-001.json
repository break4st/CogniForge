  "module_boundary": {
    "in_scope": [
      "展示当前项目下所有环境列表",
      "环境新增、编辑、克隆、删除操作的用户界面",
      "私钥等敏感字段的遮蔽输入与展示",
      "表单校验与后端错误提示"
    ],
    "out_of_scope": [
      "后端环境 CRUD 接口的实现",
      "环境连接测试执行逻辑",
      "部署流程触发",
      "数据持久化",
      "环境配置服务以外的后端逻辑"
    ],
    "owned_components": [],
