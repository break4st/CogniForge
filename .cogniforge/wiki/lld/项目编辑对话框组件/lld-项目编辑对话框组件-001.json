  "error_handling": {
    "strategy": "前端先通过 Ant Design Form 验证规则拦截无效输入；API 调用错误统一显示在对话框顶部的 Alert 中，并根据错误码归类提示，网络异常给出通用重试提示。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "VALIDATION_ERROR",
        "description": "请求参数不合法，前端提示用户检查输入。"
      },
      {
        "code": "404",
        "name": "NOT_FOUND",
        "description": "编辑的项目不存在，提示用户刷新列表后重试。"
      },
      {
        "code": "0",
        "name": "NETWORK_ERROR",
        "description": "网络异常或超时，提示「网络连接失败，请稍后重试」。"
      }
    ]
  },
  "workflow": {
    "name": "项目编辑提交流程",
    "description": "用户在对话框内填写/修改信息并提交，组件完成验证与API调用的内部编排。",
    "steps": [
      {
        "order": 1,
        "name": "表单验证",
        "action": "执行 Ant Design Form 校验规则，不通过则中止。",
        "timeout_seconds": 0,
        "on_failure": "停止提交，高亮错误字段。"
      },
      {
        "order": 2,
        "name": "调用API",
        "action": "根据 mode 选择 POST /api/projects 或 PUT /api/projects/{projectId}，携带表单数据。",
        "timeout_seconds": 30,
        "on_failure": "显示错误 Alert，恢复按钮可点击。"
      },
      {
        "order": 3,
        "name": "成功回调",
        "action": "调用 props.onSuccess()，由父组件关闭对话框并刷新列表。",
        "timeout_seconds": 0,
        "on_failure": "不适用，仅成功时执行。"
      }
    ],
    "retry_strategy": {
      "max_retries": 0,
      "retry_interval_seconds": 0,
      "retryable_errors": [],
      "non_retryable_errors": []
    }
  },
  "component_tree": [
    {
      "name": "ProjectEditDialog",
      "path": "/projects (父页面)",
      "description": "项目新建或编辑的模态对话框",
      "props": [
        {
          "name": "visible",
          "type": "boolean",
          "required": true,
          "description": "控制对话框的显隐"
        },
        {
          "name": "mode",
          "type": "string",
          "required": true,
          "description": "操作模式：'create' 或 'edit'"
        },
        {
          "name": "project",
          "type": "object|null",
          "required": false,
          "description": "编辑模式下传入的项目数据 {id, name, description}"
        },
        {
          "name": "onClose",
          "type": "function",
          "required": true,
          "description": "关闭对话框的回调"
        },
        {
          "name": "onSuccess",
          "type": "function",
          "required": true,
          "description": "操作成功后的回调，父组件刷新列表"
        }
      ],
      "events": [
        {
          "name": "onClose",
          "payload_type": "void"
        },
        {
          "name": "onSuccess",
          "payload_type": "void"
        }
      ],
      "state": [
        {
          "name": "loading",
          "type": "boolean",
          "description": "是否正在提交"
        },
        {
          "name": "error",
          "type": "string|null",
          "description": "错误信息，无错误时为null"
        }
      ],
      "behavior": [
        "visible 变为 true 时：若 mode='edit' 且 project 存在，用 form.setFieldsValue 设置初始值；create 模式则重置表单。",
        "点击确定按钮：先表单验证，通过后置 loading=true，调用对应 API。",
        "API 成功：调用 onSuccess，父组件关闭对话框。",
        "API 失败：设置 error 状态，显示 Alert，loading 置 false。",
        "visible 变为 false 或点击取消：重置表单和 error 状态。"
      ],
      "edge_cases": [
        "编辑模式下 project 为 null 或缺少 id：设置 error 为「项目数据错误」并直接关闭对话框。",
        "loading 状态下重复点击确定：不做任何操作。",
        "网络异常或 API 返回错误：解析统一错误体 {code, error, detail} 并在 Alert 中展示。",
        "对话框关闭（取消/遮罩）：立即重置表单和错误，不保留未提交修改。"
      ],
      "children": []
    }
  ],
  "state_design": {
    "global": [],
    "caching_strategy": "无缓存，每次打开对话框均使用最新传入的 props 数据。"
  },
  "route_design": [
    {
      "path": "/projects",
      "page": "ProjectListPage",
      "title": "项目管理",
      "auth": "all",
      "layout": "default"
    }
  ],
  "interaction_flows": [
    {
      "name": "新建项目流程",
      "description": "用户从项目列表页面触发新建操作，填写表单并提交。",
      "steps": [
        "步骤1: 用户在项目列表页点击「新建项目」按钮。",
        "步骤2: 父组件设置 visible=true, mode='create'，打开对话框。",
        "步骤3: 对话框显示空表单，用户填写项目名称（必填）和描述（可选）。",
        "步骤4: 用户点击「确定」，组件执行表单验证。",
        "步骤5: 验证通过后调用 POST /api/projects，传递 name 和 description。",
        "步骤6: 成功：触发 onSuccess，父组件关闭对话框并刷新项目列表。",
        "步骤6a: 失败：从响应中提取错误信息，对话框顶部显示 Alert，用户可修改后重试。"
      ]
    },
    {
      "name": "编辑项目流程",
      "description": "用户从项目列表中选择一个项目进行编辑。",
      "steps": [
        "步骤1: 用户在项目列表中找到目标项目，点击其「编辑」按钮。",
        "步骤2: 父组件设置 visible=true, mode='edit', project=所选项目数据。",
        "步骤3: 对话框表单自动填充当前项目的名称和描述。",
        "步骤4: 用户修改信息后点击「确定」。",
        "步骤5: 验证通过后调用 PUT /api/projects/{projectId}。",
        "步骤6: 成功：触发 onSuccess，父组件关闭对话框并刷新列表。",
        "步骤6a: 失败：处理错误（如 404 提示项目不存在），对话框保持打开。"
      ]
    }
  ],
  "api_integration": [
    {
      "page": "ProjectEditDialog",
      "endpoint": "POST /api/projects",
      "maps_to": "创建模式下的 handleSubmit 调用，将表单数据映射到请求体 {name, description}"
    },
    {
      "page": "ProjectEditDialog",
      "endpoint": "PUT /api/projects/{projectId}",
      "maps_to": "编辑模式下的 handleSubmit 调用，projectId 取自 props.project.id，请求体 {name, description}"
    }
  ]
}