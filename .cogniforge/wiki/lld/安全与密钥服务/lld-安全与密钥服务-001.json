  "service_contracts": [
    {
      "id": "SC-001",
      "name": "KeyService",
      "type": "service",
      "description": "安全与密钥服务契约",
      "methods": [
        {
          "name": "CreateKey",
          "description": "创建并加密存储SSH私钥",
          "parameters": [
            {
              "name": "ctx",
              "type": "context.Context"
            },
            {
              "name": "req",
              "type": "CreateKeyRequest"
            }
          ],
          "return_type": {
            "type": "KeyResponse",
            "error": "error"
          },
          "signature": "CreateKey(ctx context.Context, req CreateKeyRequest) (KeyResponse, error)",
          "precondition": "req.Name 非空，req.KeyContent 为有效SSH私钥格式，且名称未被占用",
          "postcondition": "成功创建密钥，返回密钥元数据（不包含明文私钥），私钥密文已持久化",
          "invariants": [
            "密钥状态必须为ACTIVE",
            "masked_key 必须为前4字符+****格式"
          ],
          "error_handling": {
            "400": "参数无效或私钥格式错误",
            "409": "密钥名称已存在",
            "500": "加密或存储失败"
          },
          "source_requirements": [
            "REQ-006"
          ],
          "source_components": [
            "CMP-006"
          ],
          "source_contracts": [
            "CTR-009"
          ],
          "change_history": [
            {
              "version": 1,
              "change_type": "created",
              "summary": "初始创建",
              "reason": "首次生成 LLD"
            }
          ]
        },
        {
          "name": "DecryptKey",
          "description": "解密私钥（内部服务调用）",
          "parameters": [
            {
              "name": "ctx",
              "type": "context.Context"
            },
            {
              "name": "req",
              "type": "DecryptKeyRequest"
            }
          ],
          "return_type": {
            "type": "string",
            "error": "error"
          },
          "signature": "DecryptKey(ctx context.Context, req DecryptKeyRequest) (string, error)",
          "precondition": "req.KeyID 对应的密钥存在且状态为ACTIVE",
          "postcondition": "返回解密后的私钥明文",
          "invariants": [
            "解密操作只能由内部可信服务调用"
          ],
          "error_handling": {
            "404": "密钥不存在或已吊销",
            "500": "解密失败"
          },
          "source_requirements": [
            "REQ-006"
          ],
          "source_components": [
            "CMP-006"
          ],
          "source_contracts": [
            "CTR-009"
          ],
          "change_history": [
            {
              "version": 1,
              "change_type": "created",
              "summary": "初始创建",
              "reason": "首次生成 LLD"
            }
          ]
        },
        {
          "name": "RevokeKey",
          "description": "吊销密钥",
          "parameters": [
            {
              "name": "ctx",
              "type": "context.Context"
            },
            {
              "name": "keyID",
              "type": "string"
            }
          ],
          "return_type": {
            "type": "void",
            "error": "error"
          },
          "signature": "RevokeKey(ctx context.Context, keyID string) error",
          "precondition": "keyID 对应的密钥存在",
          "postcondition": "密钥状态变为REVOKED",
          "invariants": [
            "不能吊销已吊销的密钥"
          ],
          "error_handling": {
            "404": "密钥不存在",
            "409": "密钥状态不允许吊销",
            "500": "更新状态失败"
          },
          "source_requirements": [
            "REQ-006"
          ],
          "source_components": [
            "CMP-006"
          ],
          "source_contracts": [
            "CTR-009"
          ],
          "change_history": [
            {
              "version": 1,
              "change_type": "created",
              "summary": "初始创建",
              "reason": "首次生成 LLD"
            }
          ]
        },
        {
          "name": "TestConnection",
          "description": "测试密钥对环境的连通性",
          "parameters": [
            {
              "name": "ctx",
              "type": "context.Context"
            },
            {
              "name": "req",
              "type": "TestConnectionRequest"
            }
          ],
          "return_type": {
            "type": "bool",
            "error": "error"
          },
          "signature": "TestConnection(ctx context.Context, req TestConnectionRequest) (bool, error)",
          "precondition": "req.KeyID 对应的密钥存在且状态为ACTIVE，req.EnvironmentID 对应的环境存在",
          "postcondition": "返回连通性测试结果",
          "invariants": [
            "测试过程不持久化任何状态"
          ],
          "error_handling": {
            "400": "参数无效",
            "404": "密钥或环境不存在",
            "502": "调用环境服务测试连接失败",
            "500": "其他内部错误"
          },
          "source_requirements": [
            "REQ-006"
          ],
          "source_components": [
            "CMP-006"
          ],
          "source_contracts": [
            "CTR-009"
          ],
