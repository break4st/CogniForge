  "module_boundary": {
    "in_scope": [
      "SSH 私钥的加密存储与元数据管理（名称、脱敏显示、状态）",
      "对外提供 REST 接口上传私钥（加密保存）",
      "为内部可信服务提供私钥解密接口",
      "密钥状态生命周期管理：激活（active）、吊销（revoked）",
      "代理调用项目与环境服务的测试连接 api，以验证私钥对目标环境的连通性",
      "私钥有效性校验（解析 SSH 私钥格式）"
    ],
    "out_of_scope": [
      "用户认证与授权（由 API 网关和用户权限服务处理）",
      "具体的 SSH 连接执行（由部署执行服务完成）",
      "环境、项目、文件等业务实体的管理",
      "前端页面渲染"
    ],
    "owned_components": [
      "CMP-006"
    ],
    "owned_contracts": [
      "CTR-009"
    ],
    "consumed_contracts": [
      "CTR-004"
    ],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "管理 SSH 私钥的加密存储与解密使用。对外提供接口进行私钥加密存储、解密（内部调用）、测试连接。",
    "dependencies": [
      "项目与环境服务",
      "API 网关",
      "主数据库"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "PostgreSQL",
      "crypto/aes",
      "crypto/cipher",
      "golang.org/x/crypto/ssh"
    ]
  },
