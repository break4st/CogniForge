              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "masked_key": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              }
            }
          }
        },
        {
