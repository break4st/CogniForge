  "interfaces": [
    {
      "id": "IF-001",
      "name": "POST /api/v1/keys",
      "type": "REST",
      "description": "上传并加密存储SSH私钥",
      "parameters": [
        {
          "name": "request",
          "in": "body",
          "type": "CreateKeyRequest",
          "required": true,
          "description": "包含密钥名称和内容的请求体"
        }
      ],
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "key_content": {
              "type": "string"
            }
