  "business_rules": [
    {
      "id": "BR-001",
      "description": "私钥必须加密存储，禁止明文落盘",
      "category": "security",
      "invariants": [
        "所有存储的私钥均为AES-256-GCM加密后的密文",
        "加密密钥不得硬编码，必须从安全配置中心获取"
      ]
    },
