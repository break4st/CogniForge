      "values": [
        "active",
        "inactive",
        "deleted"
      ]
    }
  ],
  "service_contracts": [
    {
      "name": "SC-001",
      "description": "提供私钥导入、删除和列表查询的核心业务逻辑",
      "methods": [
        {
          "name": "importKey",
          "signature": "(request: ImportKeyRequest) -> KeyEntity",
          "precondition": "私钥文件存在且可读，别名在该用户下唯一",
          "postcondition": "私钥内容经加密后与别名等元数据一起持久化到数据库",
          "description": "读取私钥文件内容，调用加密模块加密，存储密文和元数据",
          "exceptions": [
            {
              "name": "DuplicateAliasError",
              "trigger": "同一用户下已存在相同别名",
              "http_status": "409"
            },
            {
              "name": "FileReadError",
              "trigger": "私钥文件不存在或无法读取",
              "http_status": "400"
            },
            {
              "name": "EncryptionFailedError",
              "trigger": "加密过程失败",
              "http_status": "500"
            }
          ]
        },
        {
          "name": "deleteKey",
          "signature": "(request: DeleteKeyRequest) -> void",
          "precondition": "密钥存在且未被任何环境使用",
          "postcondition": "该密钥的所有数据库记录被删除",
          "description": "检查密钥是否被环境关联，若未使用则从数据库删除",
          "exceptions": [
            {
              "name": "KeyNotFoundError",
              "trigger": "指定ID的密钥不存在",
              "http_status": "404"
            },
            {
              "name": "KeyInUseError",
              "trigger": "密钥正被一个或多个环境使用",
              "http_status": "409"
            }
          ]
        },
        {
          "name": "listKeys",
          "signature": "() -> ListKeysResponse",
          "precondition": "无",
          "postcondition": "返回当前用户的所有密钥列表（不含私钥明文）",
          "description": "查询当前用户的所有密钥记录，返回别名、指纹等摘要信息",
          "exceptions": []
        }
      ],
      "repository_dependencies": [
        "findByCreatedBy(userId: string): KeyRecord[]",
        "findByIdAndCreatedBy(keyId: string, userId: string): KeyRecord | null",
        "existsActiveDeployment(keyId: string): boolean",
        "deleteByIdAndCreatedBy(keyId: string, userId: string): void",
        "save(keyRecord: KeyRecord): KeyRecord"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "私钥内容在导入后必须以加密形式存储，任何时候不得以明文形式持久化。",
      "每个密钥别名在系统中必须唯一，不允许重名。",
      "删除密钥前必须检查是否被环境使用，若被使用则拒绝删除。",
      "导入私钥时必须提供私钥文件和别名，若别名已存在则拒绝导入。",
      "私钥的加密版本号必须与加密算法保持一致，升级加密时需迁移旧数据。",
      "已标记为删除的密钥在物理删除前仍占用的别名不可被新密钥重用。"
    ],
    "state_machines": [
      {
        "entity": "KeyEntity",
        "states": [
          "ACTIVE",
          "TO_BE_DELETED",
          "DELETED"
        ],
        "transitions": [
          {
            "from": "ACTIVE",
            "to": "TO_BE_DELETED",
            "trigger": "用户发起删除请求",
            "actor": "用户"
          },
          {
            "from": "TO_BE_DELETED",
            "to": "DELETED",
            "trigger": "物理删除完成并移除别名占用",
            "actor": "系统"
          },
          {
            "from": "TO_BE_DELETED",
            "to": "ACTIVE",
            "trigger": "删除前环境检查发现有绑定",
            "actor": "系统"
          }
        ],
        "irreversible_rules": [
          "从ACTIVE到TO_BE_DELETED的转换是不可逆的，除非环境检查发现绑定",
          "从TO_BE_DELETED到DELETED的转换是不可逆的"
        ],
        "concurrency": "在删除流程中，需要对KeyEntity加写锁，防止并发删除或更新冲突。"
      }
    ],
    "cross_service_rules": [
      "导入密钥时，必须调用加密模块（CTR-009）进行AES-256-GCM加密，并传入用户主密码派生的密钥。",
      "删除密钥前，必须查询环境管理模块（CTR-007）确认该密钥未被任何环境引用。",
      "密钥列表查询可返回部分字段（如别名、创建时间），但不得暴露加密后的密文内容。",
      "加密模块升级时，密钥管理模块需配合处理已有密钥的重新加密，并更新版本号。"
    ]
  },
  "workflow": {
    "name": "密钥管理模块流程",
    "description": "密钥导入、删除和列表查询的整体工作流",
    "steps": [
      {
        "order": 1,
        "name": "导入密钥",
        "action": "接收导入请求，读取私钥文件，调用加密模块加密，持久化到数据库",
        "timeout_seconds": 60,
        "on_failure": "返回相应错误码，记录日志"
      },
      {
        "order": 2,
        "name": "删除密钥",
        "action": "接收删除请求，检查是否被环境使用，若未使用则从数据库删除",
        "timeout_seconds": 30,
        "on_failure": "返回冲突或错误信息"
      },
      {
        "order": 3,
        "name": "查询密钥列表",
        "action": "从数据库查询当前用户的所有密钥记录，返回摘要信息",
        "timeout_seconds": 10,
        "on_failure": "返回数据库错误"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": ["NETWORK_ERROR", "TIMEOUT"],
      "non_retryable_errors": ["AUTH_ERROR", "CONFIG_ERROR"]
    }
  }
}