          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "所有服务方法通过 try-catch 捕获异常，根据错误类型转换为统一响应格式，未知错误一律返回 500。数据库操作和加密操作需区分可重试与不可重试错误。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "参数验证错误",
        "description": "导入、删除、列表请求中的参数缺失或格式错误，由 IPC 入口层校验并立即返回错误信息。"
      },
      {
        "code": "404",
        "name": "资源未找到",
        "description": "按别名或指纹查询密钥时数据库中无匹配记录，返回明确错误标识。"
      },
      {
        "code": "409",
        "name": "业务冲突",
        "description": "导入时别名或指纹已存在（唯一约束冲突），或删除时密钥被环境引用（由环境管理服务检查后返回），触发 409。"
      },
      {
        "code": "500",
        "name": "内部服务错误",
        "description": "数据库查询失败（CTR-007 返回异常）、加密操作失败（CTR-009 返回异常，如密钥派生错误、加解密引擎故障）或未预期的运行时异常，统一返回 500，并记录详细日志。"
      }
    ]
  },
  "domain_objects": [
