      "CTR-009"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "密钥管理模块负责私钥的导入、加密存储、别名设置、列表查询以及删除。导入时读取私钥文件内容，调用加密模块进行AES-256-GCM加密后，将密文和元数据存入本地数据库；删除时需检查密钥是否被环境使用。模块运行在主进程中，通过IPC向GUI前端暴露接口。",
    "dependencies": [
      "加密模块 (CTR-009): 用于私钥的加密和解密",
      "本地数据库 (CTR-007): 持久化密钥元数据和密文"
    ],
    "tech_stack": [
      "Node.js (主进程)",
      "Electron",
      "Node.js crypto (AES-256-GCM, PBKDF2)"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-002",
      "sad_component_ids": ["CMP-001"],
      "sad_contract_ids": ["CTR-001"],
      "lld_objects": {
        "data_models": ["DM-001"],
        "interfaces": ["IF-001"],
        "domain_objects": ["DO-001", "DO-002", "DO-003", "DO-004", "DO-005", "DO-006"],
        "service_contracts": ["SC-001"]
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "KeyRecord",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "keys"
      },
      "description": "密钥存储表，记录导入的私钥密文及元数据。遵循Primary Database LLD定义。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "required": true,
          "description": "自增主键"
        },
        {
          "name": "alias",
          "type": "TEXT NOT NULL UNIQUE",
          "required": true,
          "description": "密钥别名，唯一标识"
        },
        {
          "name": "encrypted_private_key",
          "type": "TEXT NOT NULL",
          "required": true,
          "description": "AES-256-GCM加密后的私钥密文，Base64编码"
        },
        {
          "name": "status",
          "type": "TEXT NOT NULL DEFAULT 'active'",
          "required": true,
          "description": "密钥状态，取值：'active', 'deleted'，默认'active'"
        },
        {
          "name": "created_at",
          "type": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "required": true,
          "description": "创建时间戳"
        }
      ],
      "indexes": [
        {
          "name": "idx_keyrecord_alias",
          "unique": true,
          "columns": [
            "alias"
          ]
        }
      ],
      "source_requirements": [
        "REQ-002"
      ],
      "source_components": [
        "CMP-004"
      ],
      "source_contracts": [
        "CTR-004"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "导入密钥时插入记录",
        "update": "不支持直接更新，删除后重新导入",
        "delete": "软删除，status改为'deleted'",
        "retention": "永久保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "基于密钥管理模块需求生成LLD数据模型"
        }
      ]
    }
  ],
