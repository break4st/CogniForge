    "in_scope": [
      "私钥导入与加密存储",
      "密钥别名管理",
      "密钥列表查询",
      "密钥删除及关联检查",
      "与加密模块交互进行加解密",
      "与本地数据库交互进行密钥元数据持久化"
    ],
    "out_of_scope": [
      "主密码管理",
      "SSH连接建立",
      "环境与密钥关联的维护（由环境管理模块负责）",
      "GUI界面展示",
      "部署流程"
