  "module_boundary": {
    "in_scope": [
      "SSH 连接建立与认证",
      "SFTP 文件上传与目录创建",
      "远程命令执行并获取输出",
      "创建软链接",
      "列出远程目录内容",
      "连接生命周期管理（连接、断开、重连）"
    ],
    "out_of_scope": [
      "业务数据库表定义",
      "消息队列拓扑及消息契约",
      "缓存键模式或连接池配置",
      "UI 表现层逻辑",
      "部署业务流程编排（由上层服务负责）"
    ]
  },
  "overview": {
    "description": "SshClient 基础设施模块，封装基于 SSH 协议的远程连接、文件传输和命令执行功能，为部署流程提供底层操作支持。",
    "dependencies": [
      "node-ssh"
    ],
    "tech_stack": [
      "node-ssh (基于 ssh2)"
    ]
  },
  "data_models": [
    {
      "id": "DM-001",
      "name": "SshConnectionConfig",
      "description": "SSH 连接配置数据结构，包含主机、端口、认证信息等。",
      "type": "struct",
      "ownership": "canonical",
      "fields": [
        {
          "name": "host",
          "type": "string",
          "description": "SSH 服务器主机名或 IP 地址",
          "required": true
        },
        {
          "name": "port",
          "type": "number",
          "description": "SSH 服务器端口，默认 22",
          "required": false
        },
        {
          "name": "username",
          "type": "string",
          "description": "SSH 登录用户名",
          "required": true
        },
        {
          "name": "password",
          "type": "string",
          "description": "SSH 密码认证，与 privateKey 二选一",
          "required": false
        },
        {
          "name": "privateKey",
          "type": "string",
          "description": "SSH 私钥认证，与 password 二选一",
          "required": false
        }
      ]
    }
  ],
