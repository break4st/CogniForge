  "business_rules": [
    {
      "id": "BR-001",
      "name": "SSH 认证策略",
      "description": "支持密码和私钥两种认证方式，二者至少提供一种，优先使用私钥认证。"
    },
    {
      "id": "BR-002",
      "name": "连接复用与超时",
      "description": "在多次操作期间复用已建立的 SSH 连接，设置空闲超时时间为 30 分钟，超时后自动断开。"
    },
    {
      "id": "BR-003",
      "name": "文件上传前校验",
      "description": "上传文件前必须校验本地文件是否存在，远程目录是否存在，不存在则自动创建。"
    },
    {
      "id": "BR-004",
      "name": "命令输出限制",
      "description": "单次命令执行输出上限为 10MB，超过则截断并记录警告。"
    },
    {
      "id": "BR-005",
      "name": "符号链接冲突处理",
      "description": "创建符号链接时，如果目标已存在且为目录，则报错；如果为文件，则先删除后创建。"
    }
  ],
  "invariants": [
    {
      "id": "INV-001",
      "name": "连接状态一致性",
      "description": "确保在任何时刻，SshClient 实例的连接状态（已连接/已断开）与实际网络连接状态一致，避免操作在无效连接上执行。"
    },
    {
      "id": "INV-002",
      "name": "并发连接安全",
      "description": "SSH 连接操作是线程安全的，不会因并发调用导致连接状态混乱。"
    },
    {
      "id": "INV-003",
      "name": "文件传输完整性",
      "description": "上传的文件在传输过程中必须保持完整性，通过校验机制（如大小对比）确保无截断或损坏。"
    }
  ],
