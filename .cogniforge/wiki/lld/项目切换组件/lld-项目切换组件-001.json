  "error_handling": {
    "strategy": "IPC 调用失败时，组件进入错误状态，展示错误提示并允许手动重试；空列表不视为错误，展示占位引导。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "网络/连接类错误",
        "description": "IPC 超时、断开连接，提示用户检查主进程状态，提供重试按钮。"
      },
      {
        "code": "5xx",
        "name": "服务端内部错误",
        "description": "主进程抛出未预期异常，显示通用错误信息，记录日志。"
      },
      {
        "code": "401",
        "name": "认证错误",
        "description": "若项目服务要求鉴权且失效，则清空项目列表并引导重新登录。"
      },
      {
        "code": "EMPTY_LIST",
        "name": "空列表",
        "description": "成功返回但 projects 为空，展示「暂无项目」引导。"
      }
    ]
  },
  "workflow": {
    "name": "项目切换与列表加载流程",
    "description": "组件挂载时请求项目列表，用户选择后触发上下文更新，并处理异常与重试。",
    "steps": [
      {
        "order": 1,
        "name": "组件挂载与初始化",
        "action": "useEffect 调用 IPC: project:list，设置 loading=true，error=null。",
        "timeout_seconds": 10,
        "on_failure": "设置 error 状态，结束 loading"
      },
      {
        "order": 2,
        "name": "接收项目列表",
        "action": "将返回的 projects 存入 state，loading=false；若无数据则展示空状态。",
        "timeout_seconds": 0,
        "on_failure": "无单独失败处理，依赖前一步错误捕获"
      },
      {
        "order": 3,
        "name": "默认选中当前项目",
        "action": "从全局上下文读取 currentProjectId，若存在且列表中包含，则设为选中。",
        "timeout_seconds": 0,
        "on_failure": "若不存在则无需选中"
      },
      {
        "order": 4,
        "name": "用户切换项目",
        "action": "用户点击 Select 的 Option，检查 value 是否变化。若变化，调用上下文 setCurrentProjectId。",
        "timeout_seconds": 0,
        "on_failure": "静默失败，上下文方法可能同步更新，记录警告"
      },
      {
        "order": 5,
        "name": "错误重试",
        "action": "当 error 不为空时，用户点击 Retry 按钮，重置 error 并重新执行步骤 1。",
        "timeout_seconds": 10,
        "on_failure": "再次进入错误状态"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 5,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT",
        "INTERNAL_ERROR"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR"
      ]
    }
  },
  "component_tree": [
    {
      "name": "ProjectSwitcher",
      "path": "/ (嵌入 MainLayout 顶部栏)",
      "description": "全局项目选择器，展示项目列表，支持切换并同步全局上下文。",
      "props": [],
      "events": [
        {
          "name": "onProjectChange",
          "payload_type": "string (projectId)"
        }
      ],
      "state": [
        {
          "name": "projectList",
          "type": "Project[]",
          "description": "全部项目列表"
        },
        {
          "name": "loading",
          "type": "boolean",
          "description": "是否正在加载项目列表"
        },
        {
          "name": "error",
          "type": "string | null",
          "description": "错误信息字符串，存在时显示错误状态"
        }
      ],
      "behavior": [
        "mount 时自动请求 IPC: project:list",
        "loading 为 true 时，Select 禁用并显示加载图标",
        "error 存在时，Select 旁显示错误提示和重试按钮",
        "选中值变化时，若与当前上下文 projectId 不同，则调用上下文 setCurrentProjectId"
      ],
      "edge_cases": [
        "项目列表为空：展示 Ant Empty 组件，提示「暂无项目，请先创建」",
        "请求失败：展示重试按钮，点击后重新加载",
        "当前选中的项目从列表中消失（被删除）：自动清空选中项，提示用户重选",
        "快速连续切换：使用 useEffect 依赖 currentProjectId 进行防抖，避免冗余请求"
      ],
      "children": [
        {
          "name": "Select",
          "path": "Ant Design Select",
          "description": "展示项目下拉列表的 UI 组件",
          "props": [
            {
              "name": "options",
              "type": "{ label: string; value: string }[]",
              "required": true,
              "description": "由 projectList 映射而成"
            },
            {
              "name": "value",
              "type": "string | undefined",
              "required": false,
              "description": "当前选中项目 ID"
            },
            {
              "name": "loading",
              "type": "boolean",
              "required": true,
              "description": "控制加载状态"
            },
            {
              "name": "disabled",
              "type": "boolean",
              "required": true,
              "description": "loading 时禁用"
            }
          ],
          "events": [
            {
              "name": "onChange",
              "payload_type": "string (新选择的 value)"
            }
          ],
          "state": [],
          "behavior": [
            "用户点击时展示下拉列表",
            "选中项高亮，其余项正常"
          ],
          "edge_cases": [
            "选项文本过长时使用 ellipsis + Tooltip 展示"
          ],
          "children": []
        },
        {
          "name": "ErrorDisplay",
          "path": "内联错误展示",
          "description": "当 error 不为空时，在 Select 右侧显示错误信息与重试按钮",
          "props": [
            {
              "name": "errorMessage",
              "type": "string",
              "required": true,
              "description": "具体错误描述"
            },
            {
              "name": "onRetry",
              "type": "() => void",
              "required": true,
              "description": "点击重试的回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "展示红色错误图标 + 文字，旁边有「重试」按钮"
          ],
          "edge_cases": [
            "错误文字过长时折叠并显示 Tooltip"
          ],
          "children": []
        }
      ]
    }
  ],
  "state_design": {
    "global": [
      {
        "name": "currentProjectId",
        "type": "string | null",
        "description": "全局当前选中的项目 ID，由 AppContext 提供，多个页面和组件依赖此值",
        "consumers": [
          "ProjectSwitcher",
          "environmentPage",
          "deploymentPage",
          "deploymentHistoryPage"
        ]
      }
    ],
    "caching_strategy": "项目列表数据在组件挂载时获取，缓存在组件内部 state。当外部增删项目时，通过全局事件总线发送 'refreshProjects' 事件，组件监听该事件重新请求列表。不设置自动轮询或过期策略。"
  },
  "route_design": [],
  "interaction_flows": [
    {
      "name": "正常切换项目",
      "description": "用户选择另一个项目，全局上下文更新，相关页面刷新数据",
      "steps": [
        "步骤1: 用户点击项目选择器下拉",
        "步骤2: 列表展示所有已有项目（从 IPC 获取）",
        "步骤3: 用户点击「生产环境项目」",
        "步骤4: 组件高亮选中项，调用 context.setCurrentProjectId('prod-id')",
        "步骤5: 环境配置页面监听到 projectId 变化，重新请求环境列表"
      ]
    },
    {
      "name": "无项目时的创建引导",
      "description": "列表为空时提供创建项目的引导入口",
      "steps": [
        "步骤1: 页面加载，IPC 返回空数组",
        "步骤2: Select 显示占位文本「暂无项目，请先创建」",
        "步骤3: 用户点击占位文本旁的「创建项目」链接（或按钮）",
        "步骤4: 跳转到项目管理页面（由外部路由处理）",
        "步骤5: 创建成功后，项目管理页发送 'refreshProjects' 事件",
        "步骤6: ProjectSwitcher 监听到事件，重新请求列表，新项目自动高亮"
      ]
    },
    {
      "name": "加载失败后重试",
      "description": "IPC 调用失败，用户手动重试并成功",
      "steps": [
        "步骤1: 组件挂载，IPC 调用返回错误",
        "步骤2: 组件显示错误信息及「重试」按钮",
        "步骤3: 用户点击「重试」",
        "步骤4: 重新发起 IPC 请求，成功后加载列表"
      ]
    }
  ],
  "api_integration": [
    {
      "page": "ProjectSwitcher",
      "endpoint": "IPC: project:list",
      "maps_to": "本地状态 projectList，填充 Select 的 options"
    }
  ]
}