      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-101",
      "method": "frontend",
      "endpoint": "IPC: project:list",
      "description": "通过 Electron IPC 获取所有项目列表，封装为内部调用，匹配契约 CTR-001",
      "parameters": [],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "projects": "Project[]"
        }
      },
      "error_codes": [
