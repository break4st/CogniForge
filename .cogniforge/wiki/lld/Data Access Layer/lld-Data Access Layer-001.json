  "module_boundary": {
    "in_scope": [
      "定义并维护数据库表结构（Project, Environment, DeploymentRecord, AuditLog 等）",
      "提供异步安全的读写接口",
      "处理数据关联（如项目下环境级联删除）",
      "管理数据库文件隔离（每个安装实例独立）",
      "事务管理"
    ],
    "out_of_scope": [
      "业务逻辑（由上层服务负责）",
      "加密/解密（由 Security Module 负责）",
      "SSH 连接（由 SSH Service 负责）",
      "UI 渲染"
    ],
    "owned_components": ["CMP-008"],
    "owned_contracts": ["CTR-002"],
    "consumed_contracts": ["CTR-003"],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "封装 SQLite 数据库操作，提供模型对象的 CRUD 接口，确保事务一致性。负责数据库初始化、迁移。向上层服务屏蔽 SQL 实现。",
    "dependencies": ["better-sqlite3"],
    "tech_stack": ["TypeScript / Node.js", "SQLite (via better-sqlite3)"]
  },
