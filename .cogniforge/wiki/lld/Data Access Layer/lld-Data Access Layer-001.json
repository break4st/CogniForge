          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "name": "ProjectService",
      "description": "处理项目相关的业务逻辑",
      "methods": [
        {
          "name": "createProject",
          "signature": "(data: CreateProjectDTO) -> Project",
          "precondition": "项目名称唯一",
          "postcondition": "项目记录已创建",
          "description": "创建新项目",
          "exceptions": [
            {
              "name": "ProjectNameExistsException",
              "trigger": "项目名称已存在",
              "http_status": 409
            }
          ]
        },
        {
          "name": "deleteProject",
          "signature": "(id: string) -> void",
          "precondition": "项目存在且没有活跃部署",
          "postcondition": "项目及其关联环境已删除",
          "description": "删除项目",
          "exceptions": [
            {
              "name": "ProjectHasActiveDeploymentsException",
              "trigger": "项目有关联的活跃部署",
              "http_status": 409
            }
          ]
        }
      ],
      "repository_dependencies": [
        "findByName(name: string) -> Project?",
        "existsActiveDeployment(projectId: string) -> boolean"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "项目名称必须全局唯一",
      "环境名称在同一项目下必须唯一",
      "部署记录必须关联有效的环境",
      "审计日志一旦创建不可修改或删除"
    ],
    "state_machines": [
      {
        "entity": "Deployment",
        "states": ["pending", "running", "success", "failed", "cancelled"],
        "transitions": [
          {
            "from": "pending",
            "to": "running",
            "trigger": "开始部署",
            "actor": "部署引擎"
          },
          {
            "from": "running",
            "to": "success",
            "trigger": "部署成功",
            "actor": "部署引擎"
          },
          {
            "from": "running",
            "to": "failed",
            "trigger": "部署失败",
            "actor": "部署引擎"
          },
          {
            "from": "pending",
            "to": "cancelled",
            "trigger": "取消部署",
            "actor": "用户"
          },
          {
            "from": "running",
            "to": "cancelled",
            "trigger": "强制取消",
            "actor": "管理员"
          }
        ],
        "irreversible_rules": ["从 success 或 cancelled 状态不可回退"],
        "concurrency": "通过状态字段乐观锁控制"
      }
    ],
    "cross_service_rules": [
      "当项目被删除时，SSH Service 应清理相关密钥",
      "部署记录变更时，通知 Monitoring Service 更新仪表盘"
    ]
  },
  "workflow": {
    "name": "数据库初始化流程",
    "description": "应用启动时确保数据库文件存在、Schema 最新、初始数据就位",
    "steps": [
      {
        "order": 1,
        "name": "检查数据库文件",
        "action": "检查用户数据目录下数据库文件是否存在",
        "timeout_seconds": 10,
        "on_failure": "创建新数据库文件"
      },
      {
        "order": 2,
        "name": "执行迁移",
        "action": "运行未应用的迁移脚本",
        "timeout_seconds": 30,
        "on_failure": "回滚当前迁移并抛出异常"
      },
      {
        "order": 3,
        "name": "填充初始数据",
        "action": "插入系统默认配置和种子数据",
        "timeout_seconds": 10,
        "on_failure": "记录警告并继续"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 5,
      "retryable_errors": ["DATABASE_LOCKED", "IO_ERROR"],
      "non_retryable_errors": ["SCHEMA_ERROR", "AUTH_ERROR"]
    }
  }
}