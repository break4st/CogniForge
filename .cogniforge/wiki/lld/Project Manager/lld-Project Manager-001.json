  "overview": {
    "description": "Manages project lifecycle within the Electron main process. Provides CRUD operations for projects via IPC, ensuring each project has an isolated configuration space. Collaborates with the Data Access Layer for persistence and exposes typed interfaces to the UI Shell.",
    "dependencies": [
      "Data Access Layer",
      "UI Shell"
    ],
    "tech_stack": [
      "TypeScript / Node.js",
      "Electron ipcMain / contextBridge",
      "SQLite (via better-sqlite3)"
    ]
  },
