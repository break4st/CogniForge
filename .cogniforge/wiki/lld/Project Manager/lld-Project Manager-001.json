        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "4xx",
        "name": "客户端错误",
        "description": "请求参数非法或操作违反业务规则，例如必填字段缺失、项目名称重复、状态不允许删除等。返回具体错误码和描述，前端可据此提示用户修正。"
      },
      {
        "code": "5xx",
        "name": "服务器错误",
        "description": "内部未预期异常，如数据库写入失败、文件系统错误等。记录详细日志，返回通用内部错误提示，不暴露堆栈信息。"
      }
    ]
