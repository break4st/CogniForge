  "service_contracts": [
    {
      "name": "ProjectService",
      "description": "提供项目的创建、查询、列表和删除等核心业务逻辑服务",
      "methods": [
        {
          "name": "createProject",
          "signature": "(request: CreateProjectRequest) -> ProjectResponse",
          "precondition": "请求体包含有效的项目名称（非空且唯一），用户已通过身份验证",
          "postcondition": "新项目记录已持久化到数据库，返回包含项目ID和状态的ProjectResponse",
          "description": "接收创建项目请求，验证输入并调用Repository保存新项目",
          "exceptions": [
            {
              "name": "ValidationError",
              "trigger": "项目名称为空或格式无效",
              "http_status": 400
            },
            {
              "name": "DuplicateProjectError",
              "trigger": "同名项目已存在",
              "http_status": 409
            }
          ]
        },
        {
          "name": "listProjects",
          "signature": "(search?: string, sort?: string) -> ProjectListResponse",
          "precondition": "用户已通过身份验证，可选搜索参数为字符串，可选排序参数为有效字段名",
          "postcondition": "返回符合搜索条件且按指定排序的项目列表",
          "description": "获取项目列表，支持按名称搜索和排序",
          "exceptions": [
            {
              "name": "InvalidSortFieldError",
              "trigger": "排序字段不存在",
              "http_status": 400
            }
          ]
        },
        {
          "name": "getProject",
          "signature": "(projectId: string) -> ProjectResponse",
          "precondition": "提供的projectId非空",
          "postcondition": "若存在则返回对应项目的详细信息，否则抛出NotFound异常",
          "description": "根据项目ID获取单个项目详情",
          "exceptions": [
            {
              "name": "NotFoundError",
              "trigger": "指定ID的项目不存在",
              "http_status": 404
            }
          ]
        },
        {
          "name": "deleteProject",
          "signature": "(projectId: string) -> void",
          "precondition": "项目存在且无活动部署（可由外部约束），用户有权删除",
          "postcondition": "项目及其所有关联数据被移除",
          "description": "删除指定项目及其关联的所有数据",
          "exceptions": [
            {
              "name": "NotFoundError",
              "trigger": "指定ID的项目不存在",
              "http_status": 404
            },
            {
              "name": "ProjectHasActiveDeploymentsError",
              "trigger": "项目关联有未停止的部署",
              "http_status": 409
            }
          ]
        }
      ],
      "repository_dependencies": [
        "create(project: Project) -> Project",
        "findAll(search?: string, sort?: string) -> Project[]",
        "findById(id: string) -> Project?",
        "delete(id: string) -> void",
        "findByName(name: string) -> Project?",
        "existsActiveDeployment(projectId: string) -> boolean"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "项目名称在系统中必须唯一",
      "项目ID必须全局唯一且不可变",
      "删除项目时必须同时删除其所有关联数据（环境、配置等）",
      "项目创建时必须初始化一个空的配置空间",
      "项目状态只能按预定义状态机进行转换"
    ],
    "state_machines": [
      {
        "entity": "Project",
        "states": [
          "ACTIVE",
          "ARCHIVED",
          "DELETED"
        ],
        "transitions": [
          {
            "from": "ACTIVE",
            "to": "ARCHIVED",
            "trigger": "archiveProject",
            "actor": "UI用户"
          },
          {
            "from": "ARCHIVED",
            "to": "ACTIVE",
            "trigger": "restoreProject",
            "actor": "UI用户"
          },
          {
            "from": "ACTIVE",
            "to": "DELETED",
            "trigger": "deleteProject",
            "actor": "UI用户"
          },
          {
            "from": "ARCHIVED",
            "to": "DELETED",
            "trigger": "deleteProject",
            "actor": "UI用户"
          }
        ],
        "irreversible_rules": [
          "状态一旦变为DELETED，不可逆转为其他任何状态",
          "已删除的项目数据不可恢复"
        ],
        "concurrency": "通过数据库行锁或乐观锁保证同一项目状态变更的原子性，仅允许单次操作成功"
      }
    ],
    "cross_service_rules": [
      "UI Shell创建项目时，Project Manager必须通过Data Access Layer持久化项目记录，并确保事务性一致",
      "删除项目时，Project Manager应通知Data Access Layer级联删除相关环境数据",
      "项目列表查询必须从Data Access Layer获取最新数据，不得使用过期缓存"
    ]
  },
  "workflow": {
    "name": "项目创建流程",
    "description": "项目创建的完整流程，包括输入验证、持久化和配置空间初始化。",
    "steps": [
      {
        "order": 1,
        "name": "验证输入",
        "action": "校验请求参数完整性，确保项目名称非空且唯一",
        "timeout_seconds": 10,
        "on_failure": "返回400错误及具体验证失败信息"
      },
      {
        "order": 2,
        "name": "持久化项目",
        "action": "调用Data Access Layer创建项目记录",
        "timeout_seconds": 30,
        "on_failure": "返回500内部错误，记录日志并通知前端"
      },
      {
        "order": 3,
        "name": "初始化配置空间",
        "action": "为项目创建独立的配置目录和初始文件",
        "timeout_seconds": 30,
        "on_failure": "尝试回滚已创建的项目记录，返回500内部错误"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  }
}