  "module_boundary": {
    "in_scope": [
      "项目的创建、查询、更新、删除（CRUD）逻辑",
      "获取所有项目列表，支持按名称模糊搜索和按字段排序",
      "切换当前项目时，提供项目状态查询依据"
    ],
    "out_of_scope": [
      "环境、部署、密钥、脚本等关联实体的具体管理",
      "基于项目的用户权限控制逻辑",
      "项目间的资源隔离或配额管理"
    ],
    "owned_components": [
      "CMP-011"
    ],
    "owned_contracts": [
      "CTR-001",
      "CTR-002",
      "CTR-003",
      "CTR-004"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "处理项目的增删改查逻辑，包括项目列表的模糊搜索与排序，以及切换当前项目时的数据刷新支持。采用 FastAPI 提供 REST 接口，通过 SQLAlchemy ORM 与 SQLite 数据库交互。",
    "dependencies": [
      "SQLiteDatabase"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "SQLite",
      "SQLAlchemy"
    ]
  },
