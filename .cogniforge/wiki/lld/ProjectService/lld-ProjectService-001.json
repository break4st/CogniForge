  "business_rules": {
    "invariants": [
      "项目名称在活动项目中唯一",
      "软删除的项目不显示在查询结果中",
      "每个操作必须更新 updated_at 时间戳"
    ],
    "validation": [
      "项目名称不能为空，长度不超过100字符",
      "项目描述长度不超过500字符"
    ],
    "transactions": [],
    "error_handling": []
  },
  "error_handling": {
    "strategy": "使用统一的错误响应格式，包含错误码和消息。业务异常返回 HTTP 4xx，内部错误返回 HTTP 500。",
    "errors": {
      "validation_error": {
        "code": 400,
        "message": "输入参数验证失败",
        "http_status": 400
      },
      "duplicate_project_name": {
        "code": 409,
        "message": "项目名称已存在",
        "http_status": 409
      },
      "project_not_found": {
        "code": 404,
        "message": "项目不存在",
        "http_status": 404
      },
      "internal_error": {
        "code": 500,
        "message": "服务器内部错误",
        "http_status": 500
      }
    }
  },
  "data_models": [
    {
      "id": "DM-001",
      "name": "projects_view",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "projects"
      },
      "description": "ProjectService 对物理 projects 表的引用视图，仅列出本服务关心的字段。last_deploy_status 和 last_deploy_time 通过聚合查询获得。",
      "fields": [
        {
          "name": "id",
          "type": "Integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "name",
          "type": "String",
          "required": true,
          "description": "项目名称，唯一"
        },
        {
          "name": "description",
          "type": "String",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "is_deleted",
          "type": "Boolean",
          "required": true,
          "description": "软删除标记，默认 False"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_projects_name",
          "unique": true,
          "columns": [
            "name",
            "is_deleted"
          ]
        },
        {
          "name": "idx_projects_created_at",
          "unique": false,
          "columns": [
            "created_at"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001",
        "REQ-007"
      ],
      "source_components": [
        "CMP-011"
      ],
      "source_contracts": [
        "CTR-001",
        "CTR-002",
        "CTR-003",
        "CTR-004"
      ],
      "constraints": [],
      "lifecycle": {
        "create": "通过 create_project 服务创建新记录，is_deleted 初始为 False",
        "update": "通过 update_project 服务更新 name/description，自动更新 updated_at",
        "delete": "通过 delete_project 服务将 is_deleted 标记为 True（软删除）",
        "retention": "软删除数据永久保留"
      },
      "change_history": [
