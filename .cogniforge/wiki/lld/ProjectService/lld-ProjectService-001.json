  "module_boundary": {
    "in_scope": [
      "项目实体的完整生命周期管理（创建、查询、更新、删除）",
      "活动项目记忆与切换",
      "最后使用时间维护",
      "提供 IPC 接口供 UI 调用"
    ],
    "out_of_scope": [
      "前端页面交互逻辑",
      "与部署/环境/SSH 等服务的跨模块协调"
    ],
