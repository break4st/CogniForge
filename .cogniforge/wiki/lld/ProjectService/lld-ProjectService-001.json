{
  "meta": {
    "doc_id": "lld-ProjectService-001",
    "module": "ProjectService",
    "module_type": "service",
    "title": "ProjectService 详细设计",
    "type": "lld",
    "author": "CogniForge",
    "created": "2025-03-26T00:00:00Z",
    "version": 1
  },
  "source": {
    "prd": {
      "doc_id": "PRD-整体"
    },
    "sad": {
      "doc_id": "SAD-整体"
    }
  },
  "module_boundary": {
    "in_scope": [
      "项目(Project)的创建、查询、更新、删除业务逻辑",
      "当前激活项目的上下文管理（存储/切换/获取激活项目ID）",
      "项目数据的JSON文件存储与读取（通过ConfigStore基础设施）",
      "项目相关的领域实体、DTO、值对象、枚举定义",
      "API接口层（IPC/REST）与业务逻辑之间的服务层契约"
    ],
    "out_of_scope": [
      "UI表现层（ProjectListView等）",
      "前端组件的状态管理或路由",
      "环境、部署、版本历史等其他业务领域",
      "数据持久化的底层文件I/O操作（由ConfigStore负责）",
      "加密、主密码验证等安全基础设施",
      "SSH连接与远程命令执行"
    ]
  },
  "overview": {
    "description": "ProjectService 负责项目管理的核心业务逻辑，包括项目的创建、查询、更新、删除，以及激活项目的上下文管理。",
    "dependencies": [
      "ConfigStore"
    ],
    "tech_stack": [
      "Node.js 18+",
      "TypeScript",
      "本地JSON文件（通过ConfigStore管理）"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CMP-001"
      ],
      "lld_objects": {},
      "coverage": "full"
    },
    {
      "requirement_id": "REQ-007",
      "sad_component_ids": [
        "CMP-002",
        "CMP-003",
        "CMP-004"
      ],
      "sad_contract_ids": [
        "CMP-002",
        "CMP-003",
        "CMP-004"
      ],
      "lld_objects": {},
      "coverage": "full"
    }
  ],
  "data_models": [],
  "interfaces": [],
  "domain_objects": [],
  "service_contracts": [
    {
      "id": "CMP-001",
      "name": "createProject",
      "description": "创建新项目",
      "methods": [
        {
          "name": "createProject",
          "description": "创建项目并持久化",
          "precondition": "项目名称唯一且参数有效",
          "postcondition": "项目被持久化到存储中",
          "signature": "createProject(name: string, description?: string): Project"
        }
      ]
    },
    {
      "id": "CMP-002",
      "name": "getAllProjects",
      "description": "获取所有项目列表",
      "methods": [
        {
          "name": "getAllProjects",
          "description": "返回所有项目的数组",
          "precondition": "无",
          "postcondition": "返回项目数组",
          "signature": "getAllProjects(): Project[]"
        }
      ]
    },
    {
      "id": "CMP-003",
      "name": "updateProject",
      "description": "更新指定项目",
      "methods": [
        {
          "name": "updateProject",
          "description": "更新项目名称和/或描述",
          "precondition": "项目存在且参数有效",
          "postcondition": "项目信息被更新并持久化",
          "signature": "updateProject(id: string, name?: string, description?: string): Project"
        }
      ]
    },
    {
      "id": "CMP-004",
      "name": "deleteProject",
      "description": "删除指定项目",
      "methods": [
        {
          "name": "deleteProject",
          "description": "删除项目并清理激活状态",
          "precondition": "项目存在",
          "postcondition": "项目从存储中移除，若为激活项目则清除激活状态",
          "signature": "deleteProject(id: string): void"
        }
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "项目名称必须唯一。",
      "项目ID格式为UUID v4，不可变。",
      "项目名称不能为空，长度1-100字符。",
      "项目描述可选，最大长度500字符。"
    ]
  },
  "error_handling": {
    "strategy": "服务层统一捕获并分类处理业务异常和底层基础设施错误，通过标准response_format返回给调用方。对于非预期错误记录错误日志并屏蔽内部细节。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "参数校验失败",
        "description": "当创建/更新项目时，必要参数缺失（如创建项目缺少name）或格式不正确（如id非有效UUID），返回具体校验错误信息。"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "当更新/删除项目时，指定的项目ID在存储中不存在，返回‘项目未找到’错误信息。"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "当创建项目时，项目名称已存在（业务要求唯一性），返回‘项目名已存在’错误信息。"
      },
      {
        "code": "500",
        "name": "内部服务错误",
        "description": "底层ConfigStore读取或写入JSON文件失败、数据序列化/反序列化异常、或未预期的运行时错误，记录详细错误日志，返回通用‘内部服务错误’信息。"
      }
    ]
  }
}