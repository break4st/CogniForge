  "overview": {
    "description": "ProjectService 是 Electron 主进程中的应用服务，封装项目管理核心逻辑，向上通过 IPC 通道与 React 前端通信，向下通过 DataBaseService 访问 SQLite 数据库。它负责维护项目记录，确保项目名唯一，并实现活动项目的唯一性约束，自动更新最后使用时间。",
    "dependencies": [
      "DatabaseService"
    ],
    "tech_stack": [
      "TypeScript",
      "Node.js (Electron runtime)",
      "better-sqlite3"
    ]
  },
