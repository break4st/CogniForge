      "description": "项目实体引用，映射主数据库中的 projects 表，包含项目元数据及活动状态",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "主键，自增 ID"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "description": "项目名称，全局唯一，1-100 字符"
        },
        {
          "name": "description",
          "type": "string",
          "required": false,
          "description": "项目描述，允许为空"
        },
        {
          "name": "created_at",
