      "name": "IProjectService",
      "type": "service",
      "description": "项目服务接口，供前端通过 IPC 调用",
      "methods": [
        {
          "name": "createProject",
          "signature": "createProject(name: string, description?: string): Promise<Project>",
          "description": "创建新项目",
          "parameters": [
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "项目名称"
            },
            {
              "name": "description",
