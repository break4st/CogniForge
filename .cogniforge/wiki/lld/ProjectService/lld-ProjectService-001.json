          "required": true,
          "description": "最后更新时间戳"
        },
        {
          "name": "last_used_at",
          "type": "datetime",
          "required": false,
          "description": "最近一次被设为活动项目的时间"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "required": true,
          "description": "是否为当前活动项目，全局最多一个为 true"
        }
      ],
      "indexes": [
        {
          "name": "idx_project_name",
          "unique": true,
          "columns": [
            "name"
          ]
