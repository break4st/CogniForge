  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ProjectServiceContracts",
      "description": "ProjectService 的服务契约，定义所有业务方法的前置/后置条件和业务规则",
      "applies_to": "IF-001",
      "methods": [
        {
          "name": "createProject",
          "signature": "createProject(name: string, description?: string): Promise<Project>",
          "preconditions": [
            "name 非空且长度在1-100字符之间"
          ],
          "postconditions": [
            "返回的 Project 对象含有有效的 id 和创建时间",
            "数据库中存在唯一 name 的新记录"
          ],
          "business_rules": [
            "项目名称全局唯一，若重复抛出 DuplicateNameError"
          ],
          "parameters": [
            {
              "name": "name",
              "type": "string",
              "required": true,
              "description": "项目名称"
            },
            {
              "name": "description",
              "type": "string",
              "required": false,
              "description": "项目描述"
            }
          ],
          "return_type": "Promise<Project>",
          "errors": [
            "DuplicateNameError"
          ]
        },
        {
          "name": "getAllProjects",
          "signature": "getAllProjects(): Promise<Project[]>",
          "preconditions": [],
          "postconditions": [
            "返回所有项目的数组，可能为空"
          ],
          "business_rules": [],
          "parameters": [],
          "return_type": "Promise<Project[]>",
          "errors": []
        },
        {
          "name": "getProjectById",
          "signature": "getProjectById(id: number): Promise<Project>",
          "preconditions": [
            "id 必须为正整数"
          ],
          "postconditions": [
            "若存在返回 Project，否则抛出 NotFoundError"
          ],
          "business_rules": [],
          "parameters": [
            {
              "name": "id",
              "type": "number",
              "required": true,
              "description": "项目ID"
            }
          ],
          "return_type": "Promise<Project>",
          "errors": [
            "NotFoundError"
          ]
        },
        {
          "name": "updateProject",
          "signature": "updateProject(id: number, updates: Partial<Pick<Project, 'name' | 'description'>>): Promise<Project>",
          "preconditions": [
            "id 必须为正整数",
            "updates 至少包含一个字段"
          ],
          "postconditions": [
            "返回更新后的 Project",
            "若更新 name，确保新名称全局唯一"
          ],
          "business_rules": [
            "若更新名称，检查重复，若重复抛出 DuplicateNameError"
          ],
          "parameters": [
            {
              "name": "id",
              "type": "number",
              "required": true,
              "description": "项目ID"
            },
            {
              "name": "updates",
              "type": "Partial<Pick<Project, 'name' | 'description'>>",
              "required": true,
              "description": "更新字段"
            }
          ],
          "return_type": "Promise<Project>",
          "errors": [
            "NotFoundError",
            "DuplicateNameError"
          ]
        },
        {
          "name": "deleteProject",
          "signature": "deleteProject(id: number): Promise<void>",
          "preconditions": [
            "id 必须为正整数"
          ],
          "postconditions": [
            "项目已从数据库移除"
          ],
          "business_rules": [
            "若项目不存在，抛出 NotFoundError"
          ],
          "parameters": [
            {
              "name": "id",
              "type": "number",
              "required": true,
              "description": "项目ID"
            }
          ],
          "return_type": "Promise<void>",
          "errors": [
            "NotFoundError"
          ]
        },
        {
          "name": "setActiveProject",
          "signature": "setActiveProject(id: number): Promise<Project>",
          "preconditions": [
            "id 必须为正整数"
          ],
          "postconditions": [
            "指定项目成为活动项目，其 last_used_at 更新为当前时间",
            "前一个活动项目的 is_active 设为 false"
          ],
          "business_rules": [
            "项目必须存在，否则抛出 NotFoundError",
            "自动切换活动项目状态"
          ],
          "parameters": [
            {
              "name": "id",
              "type": "number",
              "required": true,
              "description": "项目ID"
            }
          ],
          "return_type": "Promise<Project>",
          "errors": [
            "NotFoundError"
          ]
        },
        {
          "name": "getActiveProject",
          "signature": "getActiveProject(): Promise<Project | null>",
          "preconditions": [],
          "postconditions": [
            "返回当前活动项目，若不存在则返回 null"
          ],
          "business_rules": [],
          "parameters": [],
          "return_type": "Promise<Project | null>",
          "errors": []
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "项目名称唯一性",
      "rule": "创建或更新项目时，名称在系统中全局唯一，不区分大小写"
    },
    {
      "id": "BR-002",
      "description": "活动项目唯一性",
      "rule": "全局最多只能有一个活动项目，设置新活动项目时自动取消旧活动项目"
    },
    {
      "id": "BR-003",
      "description": "最后使用时间",
      "rule": "当项目被设为活动时，自动更新其 last_used_at 为当前时间"
    }
  ],
  "error_handling": {
    "errors": [
      {
        "name": "DuplicateNameError",
        "description": "项目名称重复时抛出",
        "handling": "前端提示名称已存在"
      },
      {
        "name": "NotFoundError",
        "description": "项目不存在时抛出",
        "handling": "前端提示项目不存在"
      }
    ]
  },
  "workflow": {
    "steps": []
  }
