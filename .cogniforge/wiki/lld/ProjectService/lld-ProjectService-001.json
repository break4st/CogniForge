        {
          "name": "idx_project_active",
          "unique": false,
          "columns": [
            "is_active"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-101"
      ],
      "source_contracts": [
        "CTR-001",
        "CTR-002"
      ],
      "constraints": [
        "name 唯一性",
        "is_active 全局最多一个为 true（业务逻辑保证）"
      ],
      "lifecycle": {
        "create": "插入新记录",
        "update": "更新字段",
        "delete": "硬删除",
        "retention": "永久保留，直到显式删除"
      }
    }
