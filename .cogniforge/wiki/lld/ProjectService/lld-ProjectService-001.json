            },
            {
              "name": "updates",
              "type": "Partial<Pick<Project, 'name' | 'description'>>",
              "required": true,
              "description": "要更新的字段"
            }
          ],
          "return_type": "Promise<Project>",
          "errors": [
            "NotFoundError",
            "DuplicateNameError"
          ]
        },
        {
