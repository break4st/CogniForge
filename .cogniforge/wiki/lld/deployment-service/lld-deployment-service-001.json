      "attributes": [
        {
          "name": "id",
          "type": "UUID",
          "required": true,
          "description": "记录标识"
        },
        {
          "name": "project_id",
          "type": "UUID",
          "required": true,
          "description": "项目标识"
        },
        {
          "name": "environment_id",
          "type": "UUID",
          "required": true,
          "description": "环境标识"
        },
        {
          "name": "version",
          "type": "String",
          "required": false,
          "description": "版本号"
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "description": "状态"
        },
        {
          "name": "file_path",
          "type": "String",
          "required": true,
          "description": "文件路径"
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "required": true,
          "description": "更新时间"
        }
      ],
      "behavior": [],
      "source_requirements": [
        "REQ-004"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentService",
      "description": "部署服务契约，定义部署请求的发起、校验、记录创建和消息分发。",
      "methods": [
        {
          "name": "initiateDeployment",
          "description": "发起部署请求，执行校验，创建记录，发送消息",
          "parameters": {
            "request": "DeploymentRequest"
          },
          "return_type": "DeploymentRecord",
          "preconditions": [
            "请求参数格式正确",
            "外部服务 project-service,environment-service,ssh-key-service 可用"
          ],
          "postconditions": [
            "部署记录创建成功，状态为PENDING",
            "部署消息已发送到队列"
          ],
          "invariants": [
            "部署请求通过所有校验",
            "文件路径有效"
          ],
          "errors": [
            {
              "code": 400,
              "message": "Bad Request: Invalid parameters"
            },
            {
              "code": 404,
              "message": "Not Found: Project or Environment not found"
            },
            {
              "code": 502,
              "message": "Bad Gateway: Dependency service unavailable"
            },
            {
              "code": 500,
              "message": "Internal Server Error: Unexpected failure"
            }
          ]
        }
      ],
      "source_requirements": [
        "REQ-004"
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "部署请求必须经过项目和环境的有效性校验",
      "invariants": [
        "项目必须存在且处于活动状态",
        "环境必须存在且属于该项目",
        "文件路径必须指向有效的共享存储文件"
      ],
      "source_requirements": [
        "REQ-004"
      ]
    },
    {
      "id": "BR-002",
      "description": "部署记录创建前必须进行远程连接预检查",
      "invariants": [
        "SSH密钥有效且具有目标环境访问权限",
        "目标路径可写"
      ],
      "source_requirements": [
        "REQ-004"
      ]
    },
    {
      "id": "BR-003",
      "description": "部署消息必须包含完整的部署上下文",
      "invariants": [
        "部署ID、项目ID、环境ID、文件路径不能为空",
        "消息体符合schema"
      ],
      "source_requirements": [
        "REQ-004"
      ]
    }
  ],
  "error_handling": [
    {
      "id": "ERR-001",
      "strategy": "输入参数校验失败时，返回400错误及具体错误信息",
      "source_requirements": [
        "REQ-004"
      ]
    },
    {
      "id": "ERR-002",
      "strategy": "依赖服务不可用或返回404时，向上层返回502或404并记录错误日志",
      "source_requirements": [
        "REQ-004"
      ]
    },
    {
      "id": "ERR-003",
      "strategy": "数据库或消息队列操作失败时，回滚事务并返回500错误",
      "source_requirements": [
        "REQ-004"
      ]
    },
    {
      "id": "ERR-004",
      "strategy": "所有异常需包装为统一错误响应格式 {'error': {'code': string, 'message': string}}",
      "source_requirements": []
    }
  ],
  "dependencies_management": {
    "internal_dependencies": [],
    "external_dependencies": [
      {
        "name": "project-service",
        "type": "REST",
        "endpoint": "/api/projects/{project_id}",
        "method": "GET",
        "timeout": 5,
        "retry": 1
      },
      {
        "name": "environment-service",
        "type": "REST",
        "endpoint": "/api/environments/{environment_id}",
        "method": "GET",
        "timeout": 5,
        "retry": 1
      },
      {
        "name": "ssh-key-service",
        "type": "REST",
        "endpoint": "/api/ssh-keys/{environment_id}",
        "method": "GET",
        "timeout": 5,
        "retry": 1
      },
      {
        "name": "message-queue",
        "type": "AMQP",
        "exchange": "deployment",
        "routing_key": "deploy.initiate",
        "timeout": 2,
        "retry": 0
      }
    ]
  },
  "configurations": {
    "deployment_version_prefix": "auto-",
    "max_retry_attempts": 3,
    "default_timeout_seconds": 30
  },
