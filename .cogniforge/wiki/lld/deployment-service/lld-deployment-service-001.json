  "module_boundary": {
    "in_scope": [
      "接收前端部署请求",
      "校验项目、环境、文件有效性",
      "预检查远程连接和写入权限",
      "创建部署记录（状态：PENDING）",
      "将部署任务消息推送到消息队列"
    ],
    "out_of_scope": [
      "实际SSH连接与文件上传执行",
      "项目/环境/SSH密钥的基础数据管理",
      "部署历史与日志查询"
    ],
