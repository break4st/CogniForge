      "description": "表示校验结果的值对象",
      "attributes": [
        {
          "name": "is_valid",
          "type": "Boolean",
          "required": true,
          "description": "是否通过校验"
        },
        {
          "name": "errors",
          "type": "Array<String>",
          "required": true,
          "description": "错误信息列表"
        },
        {
          "name": "checked_at",
          "type": "DateTime",
          "required": true,
          "description": "校验时间"
        },
        {
          "name": "checker",
          "type": "String",
          "required": false,
          "description": "执行校验的组件名"
        },
        {
          "name": "details",
          "type": "JSON",
          "required": false,
          "description": "附加详情"
        },
        {
          "name": "duration_ms",
          "type": "Integer",
          "required": false,
          "description": "校验耗时"
        },
        {
          "name": "resource_id",
          "type": "UUID",
          "required": false,
          "description": "被校验的资源ID"
        },
        {
          "name": "context",
          "type": "JSON",
          "required": false,
          "description": "校验上下文"
        }
      ],
      "behavior": [],
      "source_requirements": []
    },
