  "interfaces": [
    {
      "id": "IF-001",
      "name": "DeploymentService",
      "type": "REST API",
      "method": "POST",
      "endpoint": "/api/deployments",
      "description": "发起新的部署请求",
      "request": {
        "body": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "project_id": { "type": "string", "format": "uuid" },
              "environment_id": { "type": "string", "format": "uuid" },
              "file_path": { "type": "string" },
              "version": { "type": "string" }
            },
            "required": ["project_id", "environment_id", "file_path"]
          }
        }
      },
      "response": {
        "status": 201,
        "body": {
          "deployment_id": "uuid",
          "status": "PENDING"
        }
      },
      "errors": [
        {
          "status": 400,
          "description": "请求参数无效"
        },
        {
          "status": 404,
          "description": "项目或环境不存在"
        },
        {
          "status": 502,
          "description": "依赖服务不可用"
        }
      ],
      "security": {
        "authentication": "JWT",
        "authorization": "基于角色的访问控制"
      },
      "source_requirements": [
        "REQ-004"
      ]
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeploymentRequest",
      "type": "entity",
      "object_type": "entity",
      "description": "表示一个部署请求的领域实体，包含验证后的部署参数",
      "attributes": [
        {
          "name": "project_id",
          "type": "UUID",
          "required": true,
          "description": "项目标识"
        },
        {
          "name": "environment_id",
          "type": "UUID",
          "required": true,
          "description": "环境标识"
        },
        {
          "name": "file_path",
          "type": "String",
          "required": true,
          "description": "文件路径"
        },
        {
          "name": "version",
          "type": "String",
          "required": false,
          "description": "部署版本号"
        }
      ],
      "behavior": [],
      "source_requirements": [
        "REQ-004"
      ]
    },
    {
      "id": "DO-002",
      "name": "ValidationResult",
      "type": "value_object",
