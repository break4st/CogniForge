    "consumed_data_models": []
  },
  "overview": {
    "description": "部署发起与校验服务，作为一键部署流程的入口，负责验证部署请求的合法性，创建PENDING状态的部署记录，并通过消息队列通知下游执行器开始工作。",
    "dependencies": [
      "project-service",
      "environment-service",
      "ssh-key-service",
      "message-queue"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "PostgreSQL 15",
      "RabbitMQ",
      "paramiko",
      "httpx"
    ]
  },
