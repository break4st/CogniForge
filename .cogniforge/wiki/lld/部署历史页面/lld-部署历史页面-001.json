    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "加载部署历史",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-007",
      "provider_component_id": "CMP-104",
      "method": "frontend",
      "endpoint": "/deployments/history",
      "description": "获取当前项目的部署历史记录列表",
      "parameters": [
        {
          "name": "projectId",
          "type": "string",
          "in": "query",
          "required": true,
          "description": "项目 ID"
        },
        {
          "name": "page",
          "type": "number",
          "in": "query",
          "required": false,
          "description": "当前页码"
        },
        {
          "name": "pageSize",
          "type": "number",
          "in": "query",
          "required": false,
          "description": "每页记录数"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "records": "DeploymentRecord[]"
        }
      },
      "error_codes": [],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-004"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "执行回滚",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-008",
      "provider_component_id": "CMP-104",
      "method": "frontend",
      "endpoint": "/deployments/history/rollback/:deploymentId",
      "description": "将指定部署记录的环境回滚到该版本",
      "parameters": [
        {
          "name": "deploymentId",
          "type": "string",
          "in": "path",
          "required": true,
          "description": "部署记录 ID"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {
          "status": 500,
          "code": "ROLLBACK_FAILED",
          "message": "回滚失败"
        }
      ],
      "auth": {
        "required": false,
        "policy": ""
      },
      "validation_rules": [],
      "idempotency": "not_applicable",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-004"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "前端对 IPC 调用失败采取统一处理，使用 Ant Design message 提示用户，回滚错误在对话框中显示详情。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "NETWORK_ERROR",
        "name": "网络错误",
        "description": "IPC 通信超时或中断，提示「网络连接异常，请重试」"
      },
      {
        "code": "ROLLBACK_FAILED",
        "name": "回滚失败",
        "description": "后端回滚操作失败，展示后端返回的 message 并建议联系管理员"
      },
      {
        "code": "AUTHORIZATION_ERROR",
        "name": "授权错误",
        "description": "用户无权限执行操作，提示「无操作权限」"
      }
    ]
  },
  "workflow": {
    "name": "页面加载编排",
    "description": "部署历史页面进入时的数据加载流程",
    "steps": [
      {
        "order": 1,
        "name": "获取项目上下文",
        "action": "从全局状态 ProjectContext 获取 currentProjectId",
        "timeout_seconds": 30,
        "on_failure": "显示「请先选择项目」占位提示"
      },
      {
        "order": 2,
        "name": "调用 IPC 加载历史记录",
        "action": "调用 deployment:history，参数 projectId 和分页信息",
        "timeout_seconds": 60,
        "on_failure": "消息提示错误，保留上一次成功数据"
      },
      {
        "order": 3,
        "name": "渲染结果",
        "action": "更新 records 和 total 状态，渲染表格和分页器",
        "timeout_seconds": 0,
        "on_failure": "无需操作"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  },
  "component_tree": [
    {
      "name": "DeploymentHistoryPage",
      "path": "/deployments/history",
      "description": "页面容器，负责协调子组件并管理页面级状态和 IPC 调用",
      "props": [],
      "events": [],
      "state": [
        {
          "name": "records",
          "type": "DeploymentRecord[]",
          "description": "部署记录列表"
        },
        {
          "name": "loading",
          "type": "boolean",
          "description": "是否加载中"
        },
        {
          "name": "currentPage",
          "type": "number",
          "description": "当前页码"
        },
        {
          "name": "total",
          "type": "number",
          "description": "总记录数"
        },
        {
          "name": "selectedRecord",
          "type": "DeploymentRecord | null",
          "description": "选中的记录"
        },
        {
          "name": "logVisible",
          "type": "boolean",
          "description": "日志抽屉可见性"
        },
        {
          "name": "rollbackModalVisible",
          "type": "boolean",
          "description": "回滚确认框可见性"
        }
      ],
      "behavior": [
        "mount 时从 ProjectContext 获取 projectId，若有效则调用 IPC 加载第一页",
        "projectId 变化时清空列表并重新加载",
        "提供 onSearch、onPageChange、onViewLog、onRollback 等回调"
      ],
      "edge_cases": [
        "projectId 为空时显示「请先选择项目」",
        "数据请求失败时消息提示，保留旧数据",
        "回滚操作进行中禁用相应按钮"
      ],
      "children": [
        {
          "name": "DeploymentSearchBar",
          "path": "/deployments/history",
          "description": "筛选条件输入组件",
          "props": [
            {
              "name": "onSearch",
              "type": "(filters: Filters) => void",
              "required": true,
              "description": "触发搜索的回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "用户输入筛选条件后点击搜索或清除，调用 onSearch"
          ],
          "edge_cases": [
            "防抖处理，避免频繁触发搜索"
          ],
          "children": []
        },
        {
          "name": "DeploymentTable",
          "path": "/deployments/history",
          "description": "部署记录表格组件",
          "props": [
            {
              "name": "records",
              "type": "DeploymentRecord[]",
              "required": true,
              "description": "记录列表"
            },
            {
              "name": "loading",
              "type": "boolean",
              "required": true,
              "description": "加载中状态"
            },
            {
              "name": "onViewLog",
              "type": "(record: DeploymentRecord) => void",
              "required": true,
              "description": "查看日志回调"
            },
            {
              "name": "onRollback",
              "type": "(record: DeploymentRecord) => void",
              "required": true,
              "description": "回滚回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "渲染表格列（部署时间、版本、环境、状态、操作）",
            "点击「查看日志」调用 onViewLog",
            "点击「回滚」调用 onRollback"
          ],
          "edge_cases": [
            "空列表时显示「暂无部署记录」",
            "对 running 或 rolled_back 状态记录禁用回滚按钮"
          ],
          "children": []
        },
        {
          "name": "Pagination",
          "path": "/deployments/history",
          "description": "分页器组件",
          "props": [
            {
              "name": "current",
              "type": "number",
              "required": true,
              "description": "当前页码"
            },
            {
              "name": "total",
              "type": "number",
              "required": true,
              "description": "总记录数"
            },
            {
              "name": "onChange",
              "type": "(page: number, pageSize?: number) => void",
              "required": true,
              "description": "页码变化回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "翻页时调用父容器的 onChange"
          ],
          "edge_cases": [
            "总数为 0 时自动隐藏"
          ],
          "children": []
        },
        {
          "name": "LogDrawer",
          "path": "/deployments/history",
          "description": "日志详情抽屉组件",
          "props": [
            {
              "name": "visible",
              "type": "boolean",
              "required": true,
              "description": "是否可见"
            },
            {
              "name": "record",
              "type": "DeploymentRecord | null",
              "required": false,
              "description": "选中的记录"
            },
            {
              "name": "onClose",
              "type": "() => void",
              "required": true,
              "description": "关闭回调"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "打开时显示选中记录的日志内容，自动滚动到底部"
          ],
          "edge_cases": [
            "日志内容为空时显示「暂无日志」"
          ],
          "children": []
        },
        {
          "name": "RollbackConfirmModal",
          "path": "/deployments/history",
          "description": "回滚确认对话框",
          "props": [
            {
              "name": "visible",
              "type": "boolean",
              "required": true,
              "description": "是否可见"
            },
            {
              "name": "record",
              "type": "DeploymentRecord | null",
              "required": false,
              "description": "要回滚的记录"
            },
            {
              "name": "onConfirm",
              "type": "() => void",
              "required": true,
              "description": "确认回调"
            },
            {
              "name": "onCancel",
              "type": "() => void",
              "required": true,
              "description": "取消回调"
            },
            {
              "name": "confirmLoading",
              "type": "boolean",
              "required": true,
              "description": "确认按钮加载状态"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "展示回滚版本信息",
            "点击确认后调用 onConfirm，显示加载中状态",
            "失败时在对话框内显示错误信息"
          ],
          "edge_cases": [
            "回滚进行中禁用确认按钮，防止重复提交",
            "错误时显示具体原因"
          ],
          "children": []
        }
      ]
    }
  ],
  "state_design": {
    "global": [
      {
        "name": "currentProjectId",
        "type": "string",
        "description": "来自 ProjectContext 的当前选中项目 ID",
        "consumers": [
          "DeploymentHistoryPage"
        ]
      }
    ],
    "caching_strategy": "部署历史数据具有强时效性，不做长时间缓存。但在同一项目 ID 未变时保留当前页数据以减少重复请求。切换项目时清空缓存。"
  },
  "route_design": [
    {
      "path": "/deployments/history",
      "page": "DeploymentHistoryPage",
      "title": "部署历史",
      "auth": "all",
      "layout": "default"
    }
  ],
  "interaction_flows": [
    {
      "name": "部署历史查看流程",
      "description": "用户进入页面查看当前项目的部署历史记录",
      "steps": [
        "步骤1: 进入 /deployments/history 路由",
        "步骤2: 页面从 ProjectContext 获取 currentProjectId",
        "步骤3: 若 projectId 为空，显示「请先选择项目」",
        "步骤4: 若有效，显示 loading，调用 deployment:history IPC",
        "步骤5: 取得数据后更新 records 和 total，渲染表格",
        "步骤6: 用户可通过搜索栏筛选，或点击分页翻页"
      ]
    },
    {
      "name": "查看日志详情流程",
      "description": "用户查看某次部署的详细日志",
      "steps": [
        "步骤1: 在表格中点击某条记录的「查看日志」按钮",
        "步骤2: 页面设置 selectedRecord，打开 LogDrawer",
        "步骤3: LogDrawer 展示选中记录的日志内容（如果数据已包含）",
        "步骤4: 自动滚动到日志底部",
        "步骤5: 用户点击关闭按钮或抽屉外部，关闭抽屉"
      ]
    },
    {
      "name": "执行回滚流程",
      "description": "用户对某个历史版本进行回滚",
      "steps": [
        "步骤1: 在表格中点击某条记录的「回滚」按钮",
        "步骤2: 打开 RollbackConfirmModal，展示回滚详情",
        "步骤3: 用户确认，触发 onConfirm",
        "步骤4: 页面设置 confirmLoading，调用 deployment:rollback IPC",
        "步骤5: 若成功，关闭对话框，消息提示「回滚成功」，刷新列表",
        "步骤6: 若失败，对话框中显示错误消息，允许重试或关闭"
      ]
    }
  ],
  "api_integration": [
    {
      "page": "DeploymentHistoryPage",
      "endpoint": "INTERNAL deployment:history",
      "maps_to": "加载部署历史列表的状态更新"
    },
