{
  "meta": {
    "doc_id": "lld-Redis缓存-001",
    "type": "lld",
    "module_type": "database",
    "module": "Redis缓存",
    "title": "Redis缓存 - 详细设计文档",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "高性能缓存服务，用于SSH连接池状态管理、WebSocket会话管理和高频读取数据缓存加速，以及部署进度的临时存储。基于Redis 7实现，提供高可用的键值存储能力，支持数据过期策略和持久化。",
    "dependencies": [],
    "tech_stack": [
      "Redis 7",
      "Python 3.11"
    ]
  },
  "data_models": [
    {
      "name": "ssh_connection_pool_state",
      "type": "table",
      "ownership": "canonical",
      "description": "SSH连接池运行时状态，记录每个连接池的活跃连接数、健康状态和心跳信息。Key结构: ssh:pool:{pool_id}，使用Redis Hash存储，不设TTL，由SSH连接池服务手动管理生命周期。",
      "fields": [
        {
          "name": "pool_id",
          "type": "string",
          "required": true,
          "description": "连接池唯一标识"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "连接池状态: active/idle/closed/error"
        },
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "目标服务器地址"
        },
        {
          "name": "port",
          "type": "integer",
          "required": true,
          "description": "SSH端口号"
        },
        {
          "name": "login_user",
          "type": "string",
          "required": true,
          "description": "登录用户名"
        },
        {
          "name": "active_connections",
          "type": "integer",
          "required": true,
          "description": "当前活跃连接数"
        },
        {
          "name": "max_connections",
          "type": "integer",
          "required": true,
          "description": "最大连接数"
        },
        {
          "name": "idle_connections",
          "type": "integer",
          "required": true,
          "description": "空闲连接数"
        },
        {
          "name": "last_heartbeat",
          "type": "datetime(ISO8601)",
          "required": true,
          "description": "最近心跳时间戳"
        },
        {
          "name": "error_message",
          "type": "string",
          "required": false,
          "description": "错误信息（status=error时）"
        },
        {
          "name": "created_at",
          "type": "datetime(ISO8601)",
          "required": true,
          "description": "连接池创建时间"
        },
        {
          "name": "updated_at",
          "type": "datetime(ISO8601)",
          "required": true,
          "description": "连接池最近更新时间"
        }
      ]
    },
    {
      "name": "websocket_session",
      "type": "store",
      "ownership": "canonical",
      "description": "WebSocket长连接会话管理，记录前端与部署引擎之间的实时通信会话。Key结构: ws:session:{session_id}，使用Redis Hash存储，默认TTL=1800秒（30分钟无活动自动过期）。",
      "fields": [
        {
          "name": "session_id",
          "type": "string",
          "required": true,
          "description": "WebSocket会话唯一标识"
        },
        {
          "name": "user_id",
          "type": "string",
          "required": true,
          "description": "用户标识"
        },
        {
          "name": "deployment_id",
          "type": "string",
          "required": false,
          "description": "关联的部署任务ID"
        },
        {
          "name": "connection_status",
          "type": "string",
          "required": true,
          "description": "连接状态: connected/disconnected"
        },
        {
          "name": "client_ip",
          "type": "string",
          "required": false,
          "description": "客户端IP地址"
        },
        {
          "name": "connected_at",
          "type": "datetime(ISO8601)",
          "required": true,
          "description": "建立连接时间"
        },
        {
          "name": "last_active",
          "type": "datetime(ISO8601)",
          "required": true,
          "description": "最近活动时间"
        },
        {
          "name": "ttl",
          "type": "integer",
          "required": true,
          "description": "剩余过期时间（秒），默认1800"
        }
      ]
    },
    {
      "name": "cache_entry",
      "type": "store",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-PostgreSQL主数据库-001",
        "model_name": "projects, environments, deployments"
      },
      "description": "高频读取数据的缓存条目，以KV结构缓存PostgreSQL中的热点数据。Key结构: cache:{namespace}:{key}，支持自定义TTL。数据源为PostgreSQL主数据库，缓存仅为加速读取。",
      "fields": [
        {
          "name": "namespace",
          "type": "string",
          "required": true,
          "description": "缓存命名空间，如project/environment/deployment"
        },
        {
          "name": "cache_key",
          "type": "string",
          "required": true,
          "description": "缓存键，在namespace内唯一"
        },
        {
          "name": "cache_value",
          "type": "string(JSON)",
          "required": true,
          "description": "缓存值，JSON序列化后存储"
        },
        {
          "name": "ttl",
          "type": "integer",
          "required": true,
          "description": "过期时间（秒），默认300（5分钟）"
        }
      ]
    },
    {
      "name": "deployment_progress",
      "type": "store",
      "ownership": "canonical",
      "description": "部署任务实时进度数据，记录每个进行中部署任务的执行状态、进度百分比和当前步骤。Key结构: deploy:progress:{deployment_id}，使用Redis Hash存储，部署完成后保留1小时（TTL=3600）自动清理。",
      "fields": [
        {
          "name": "deployment_id",
          "type": "string",
          "required": true,
          "description": "部署任务唯一标识"
        },
        {
          "name": "project_id",
          "type": "string",
          "required": true,
          "description": "所属项目ID"
        },
        {
          "name": "environment_id",
          "type": "string",
          "required": true,
          "description": "目标环境ID"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "部署状态: pending/running/success/failed"
        },
        {
          "name": "progress_percentage",
          "type": "integer",
          "required": true,
          "description": "进度百分比 0-100"
        },
        {
          "name": "current_step",
          "type": "string",
          "required": false,
          "description": "当前执行步骤描述"
        },
        {
          "name": "log_preview",
          "type": "string",
          "required": false,
          "description": "最近日志摘要（最近500字符）"
        },
        {
          "name": "start_time",
          "type": "datetime(ISO8601)",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "estimated_end_time",
          "type": "datetime(ISO8601)",
          "required": false,
          "description": "预计完成时间"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "description": "部署版本号 vYYYYMMDD-HHmmss"
        }
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "缓存键命名空间前缀（ssh:/ws:/cache:/deploy:）不可变更，新接入的数据域必须新增前缀且与其他域前缀不重叠",
      "所有TTL值必须为正整数（>0），cache_entry默认300秒，websocket_session默认1800秒，deployment_progress默认3600秒",
      "ssh:pool:前缀的数据不设TTL，由SSH连接池服务通过心跳机制管理生命周期，心跳超时30秒视为连接池失活",
      "缓存数据源（cache_entry）与PostgreSQL主数据库之间的数据一致性由业务层保证，缓存层不承担一致性校验责任",
      "WebSocket会话TTL刷新间隔不得超过TTL值的1/3，防止会话在活跃状态下被误过期",
      "部署进度写入后必须在5秒内可在同一Redis实例中读取到（强一致性约束于单实例内）"
    ]
  },
  "interfaces": [
    {
      "name": "SSH连接池状态读写",
      "method": "INTERNAL",
      "endpoint": "redis://*/ssh:pool:{pool_id}",
      "description": "通过Redis协议读写SSH连接池运行时状态，支持Hash结构的HSET/HGET/HDEL/HGETALL操作。SSH连接池服务写入状态，部署引擎服务等消费服务读取。",
      "parameters": [
        {
          "name": "pool_id",
          "type": "string",
          "description": "连接池ID"
        },
        {
          "name": "operation",
          "type": "string",
          "description": "操作类型: set_state/get_state/get_all/delete/heartbeat"
        },
        {
          "name": "fields",
          "type": "object",
          "description": "状态字段键值对（写入时）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "pool_id": "string",
          "status": "string",
          "active_connections": "int",
          "last_heartbeat": "datetime"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "连接池ID为空或格式错误"
        },
        {
          "code": 404,
          "message": "指定pool_id的状态不存在"
        },
        {
          "code": 500,
          "message": "Redis连接或操作异常"
        }
      ]
    },
    {
      "name": "WebSocket会话管理",
      "method": "INTERNAL",
      "endpoint": "redis://*/ws:session:{session_id}",
      "description": "通过Redis协议管理WebSocket会话数据，支持Hash操作和TTL设置。部署引擎服务写入和更新会话状态，WebSocket路由层验证会话有效性。TTL自动过期清理断开会话。",
      "parameters": [
        {
          "name": "session_id",
          "type": "string",
          "description": "会话ID"
        },
        {
          "name": "operation",
          "type": "string",
          "description": "操作类型: create/update/get/delete/refresh_ttl"
        },
        {
          "name": "fields",
          "type": "object",
          "description": "会话字段键值对"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "session_id": "string",
          "user_id": "string",
          "connection_status": "string",
          "last_active": "datetime"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "会话参数不完整"
        },
        {
          "code": 404,
          "message": "会话不存在或已过期"
        },
        {
          "code": 500,
          "message": "Redis操作异常"
        }
      ]
    },
    {
      "name": "高频缓存数据读写",
      "method": "INTERNAL",
      "endpoint": "redis://*/cache:{namespace}:{key}",
      "description": "通用缓存接口，支持SET/GET/DELETE/EXPIRE等标准Redis String操作。各业务服务按namespace隔离缓存数据，避免键冲突。缓存数据自动过期，业务层需处理缓存穿透。",
      "parameters": [
        {
          "name": "namespace",
          "type": "string",
          "description": "缓存命名空间，如project/environment/deployment"
        },
        {
          "name": "key",
          "type": "string",
          "description": "缓存键"
        },
        {
          "name": "value",
          "type": "string(JSON)",
          "description": "缓存值（写入时）"
        },
        {
          "name": "ttl",
          "type": "integer",
          "description": "过期时间秒（写入时）"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "key": "string",
          "value": "string",
          "ttl": "int"
        }
      },
      "error_codes": [
        {
          "code": 404,
          "message": "缓存键不存在或已过期"
        },
        {
          "code": 500,
          "message": "Redis连接异常"
        }
      ]
    },
    {
      "name": "部署进度管理",
      "method": "INTERNAL",
      "endpoint": "redis://*/deploy:progress:{deployment_id}",
      "description": "部署任务实时进度管理，部署引擎服务通过Hash操作实时更新进度，WebSocket推送模块读取进度并广播给前端。部署完成后保留1小时（TTL=3600）后自动清理。",
      "parameters": [
        {
          "name": "deployment_id",
          "type": "string",
          "description": "部署任务ID"
        },
        {
          "name": "operation",
          "type": "string",
          "description": "操作类型: update_progress/get_progress/complete/fail/delete"
        },
        {
          "name": "fields",
          "type": "object",
          "description": "进度字段键值对"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "string",
          "status": "string",
          "progress_percentage": "int",
          "current_step": "string"
        }
      },
      "error_codes": [
        {
          "code": 400,
          "message": "部署任务ID格式错误"
        },
        {
          "code": 404,
          "message": "指定部署任务的进度数据不存在"
        },
        {
          "code": 500,
          "message": "Redis操作异常"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "Redis操作异常采用熔断+重试机制，连接失败时自动重试3次（间隔指数退避），写入失败时业务层回退到直接查询PostgreSQL。缓存穿透场景由业务层自行处理（空值缓存或布隆过滤器）。当Redis内存达到maxmemory上限时，采用allkeys-lru淘汰策略释放空间。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": 500,
        "name": "连接异常",
        "description": "Redis服务不可达或连接池耗尽，业务层熔断并回退到数据库读取，同时记录告警日志通知运维"
      },
      {
        "code": 500,
        "name": "操作超时",
        "description": "Redis命令执行超时（默认3s），操作失败后由调用方决定是否重试"
      },
      {
        "code": 404,
        "name": "键不存在",
        "description": "查询的Key不存在或TTL已过期，业务层按缓存未命中处理，主动回源查询PostgreSQL"
      },
      {
        "code": 400,
        "name": "数据序列化异常",
        "description": "写入的Value序列化或读取的反序列化失败，校验数据格式后重试"
      },
      {
        "code": 500,
        "name": "内存超限",
        "description": "Redis内存达到maxmemory上限，触发allkeys-lru淘汰策略导致数据丢失，需监控内存使用并及时扩容"
      }
    ]
  },
  "index_strategy": [
    {
      "table": "ssh_connection_pool_state",
      "indexes": [
        {
          "name": "idx_key_pool_id",
          "columns": [
            "ssh:pool:{pool_id}"
          ],
          "unique": true,
          "type": "Redis-Hash",
          "purpose": "按pool_id唯一标识连接池，HSET/HGET/HGETALL操作基于Hash主键"
        }
      ]
    },
    {
      "table": "websocket_session",
      "indexes": [
        {
          "name": "idx_key_session_id",
          "columns": [
            "ws:session:{session_id}"
          ],
          "unique": true,
          "type": "Redis-Hash+TTL",
          "purpose": "按session_id唯一标识WebSocket会话，配合TTL实现自动过期清理断开连接"
        }
      ]
    },
    {
      "table": "cache_entry",
      "indexes": [
        {
          "name": "idx_key_namespace_key",
          "columns": [
            "cache:{namespace}:{key}"
          ],
          "unique": true,
          "type": "Redis-String+TTL",
          "purpose": "按namespace+key唯一标识缓存条目，SET/GET/DELETE操作"
        }
      ]
    },
    {
      "table": "deployment_progress",
      "indexes": [
        {
          "name": "idx_key_deployment_id",
          "columns": [
            "deploy:progress:{deployment_id}"
          ],
          "unique": true,
          "type": "Redis-Hash+TTL",
          "purpose": "按deployment_id唯一标识部署进度，部署完成后TTL过期自动清理"
        }
      ]
    }
  ],
  "migration_strategy": {
    "tool": "原生Redis迁移（redis-cli + Redis Replication）",
    "naming": "V{序号}__{描述}.redis",
    "rollback": "RDB快照恢复：迁移前手动执行SAVE生成RDB快照，迁移失败时通过redis-cli --rdb恢复。键结构变更采用双写过渡期，旧键自然过期后清理。"
  },
  "capacity_estimation": {
    "estimated_rows_1y": "SSH连接池状态≤50条; WebSocket会话≤200条（并发）; 缓存条目≤50,000条; 部署进度≤10,000条/年（每个部署一条）",
    "estimated_rows_3y": "SSH连接池状态≤100条; WebSocket会话≤500条（并发）; 缓存条目≤100,000条; 部署进度≤30,000条/3年",
    "hot_tables": [
      "deployment_progress（部署期间高频读写）",
      "websocket_session（实时通信持续访问）",
      "cache_entry（项目列表/环境列表等高频率查询）"
    ],
    "partition_strategy": "Redis内置的key分区（16384个hash slot），通过集群模式自动分片。单实例模式无需手动分区。存储的键按数据域前缀（ssh:/ws:/cache:/deploy:）自然分类，Resp3协议支持自动路由。"
  },
  "connection_contracts": {
    "pool_size": "10-50（按服务实例数动态调整，每个服务默认创建20个连接的连接池）",
    "timeout": "连接超时5秒，命令超时3秒",
    "service_accounts": [
      {
        "service": "SSH连接池服务",
        "db_user": "redis_ssh",
        "privileges": [
          "ssh:pool:*的所有Hash操作（HSET/HGET/HDEL/HGETALL）"
        ]
      },
      {
        "service": "部署引擎服务",
        "db_user": "redis_deploy",
        "privileges": [
          "deploy:progress:*的所有Hash操作",
          "ws:session:*的所有Hash操作"
        ]
      },
      {
        "service": "项目管理服务",
        "db_user": "redis_cache",
        "privileges": [
          "cache:project:*的SET/GET/DELETE/EXPIRE"
        ]
      },
      {
        "service": "环境配置服务",
        "db_user": "redis_cache",
        "privileges": [
          "cache:environment:*的SET/GET/DELETE/EXPIRE"
        ]
      },
      {
        "service": "审计日志服务",
        "db_user": "redis_cache",
        "privileges": [
          "cache:audit:*的GET（只读缓存）"
        ]
      }
    ]
  }
}
