    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "projects",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "项目基本信息表",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "required": true,
          "description": "主键"
        },
        {
          "name": "name",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "项目名称，全局唯一"
        },
        {
          "name": "description",
          "type": "TEXT",
          "required": false,
          "description": "项目描述"
        },
        {
          "name": "created_by",
          "type": "UUID",
          "required": true,
          "description": "创建者用户 ID"
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_projects_name",
          "unique": true,
          "columns": [
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [],
      "lifecycle": {
        "create": "项目服务 INSERT",
        "update": "项目服务 UPDATE",
        "delete": "项目服务 DELETE (级联检查是否有关联环境)",
        "retention": "永久保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "environments",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "description": "部署环境配置表",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "required": true,
          "description": "主键"
        },
        {
          "name": "project_id",
          "type": "UUID",
          "required": true,
          "description": "所属项目 ID，外键 → projects.id"
        },
        {
          "name": "name",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "环境名称"
        },
        {
          "name": "host",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "目标主机地址"
        },
        {
          "name": "port",
          "type": "INTEGER",
          "required": true,
          "description": "SSH 端口"
        },
        {
          "name": "username",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "SSH 用户名"
        },
        {
          "name": "ssh_key_id",
          "type": "UUID",
          "required": true,
          "description": "引用 SSH 密钥 ID，外键 → ssh_keys.id"
        },
        {
          "name": "deploy_dir",
          "type": "VARCHAR(512)",
          "required": true,
          "description": "部署目标目录"
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "description": "更新时间"
        }
      ],
      "indexes": [
        {
          "name": "uq_env_project_name",
          "unique": true,
          "columns": [
            "project_id",
            "name"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [],
      "constraints": [
        {
          "type": "foreign_key",
          "name": "fk_environments_project",
          "columns": ["project_id"],
          "references": {
            "table": "projects",
            "columns": ["id"]
          },
          "on_delete": "CASCADE"
        },
        {
          "type": "foreign_key",
          "name": "fk_environments_ssh_key",
          "columns": ["ssh_key_id"],
          "references": {
            "table": "ssh_keys",
            "columns": ["id"]
          },
          "on_delete": "RESTRICT"
        }
      ],
      "lifecycle": {
        "create": "环境服务 INSERT",
        "update": "环境服务 UPDATE",
        "delete": "环境服务 DELETE (检查是否有关联部署记录)",
        "retention": "永久保留"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "index_strategy": {
    "description": "PostgreSQL 数据库的索引策略，旨在优化查询性能同时控制写入开销。",
    "b_tree": {
      "purpose": "主键、外键、等值查询、范围查询、排序",
      "selected_tables": [
        "projects.name",
        "environments.project_id",
        "environments.ssh_key_id",
        "deployments.environment_id",
        "deployments.project_id",
        "deployment_files.deployment_id",
        "deployment_files.file_id",
        "files.project_id",
        "ssh_keys.user_id",
        "role_permissions.role_id"
      ]
    },
    "hash": {
      "purpose": "低基数列等值查询，如状态字段；当前未启用",
      "selected_tables": []
    },
    "gin": {
      "purpose": "全文搜索、数组、JSONB 查询；当前未启用",
      "selected_tables": []
    },
    "gist": {
      "purpose": "地理空间、范围类型；当前未启用",
      "selected_tables": []
    },
    "brin": {
      "purpose": "大表顺序扫描优化，如日志表的 created_at；当前未启用",
      "selected_tables": []
    },
    "partial_indexes": {
      "purpose": "仅索引满足特定条件的行，减少索引大小",
      "selected_tables": [
        "deployments WHERE status != 'completed'"
      ]
    },
    "cover_indexes": {
      "purpose": "覆盖索引减少回表，提升查询性能",
      "selected_tables": [
        "deployments (id, status, started_at)"
      ]
    },
    "maintenance_notes": "定期使用 pg_stat_user_indexes 监控索引使用情况，移除未使用的索引；根据查询模式，可能需要在 environments.host 或 files.file_path 上添加索引以支持搜索功能。"
  },
  "migration_strategy": {
    "description": "数据库迁移策略，使用 Flyway 进行版本化管理，确保所有环境下的数据库架构一致且可重现。",
    "tool": "Flyway",
    "migration_locations": [
      "classpath:db/migration"
    ],
    "naming_convention": "V<version>__<description>.sql",
    "baseline_version": "1.0.0",
    "current_version": "1.0.0",
    "versioning_approach": "线性递增版本号，每个 SQL 文件只做向前兼容的变更。",
    "rollback_strategy": "提供对应的撤销脚本 U<version>__<description>.sql，仅在必要时手动执行。",
    "seed_data": "种子数据通过 Flyway 的 R__ 重复脚本管理，用于预填用户、角色等初始数据。",
    "validation": "在 CI/CD 流水线中运行 flyway validate 确保迁移一致性。"
  },
  "capacity_estimation": {
    "description": "基于业务预期的容量估算，用于硬件规划和索引优化。",
    "row_estimates": {
      "projects": 1000,
      "environments": 5000,
      "deployments": 100000,
      "deployment_files": 500000,
      "files": 10000,
      "users": 500,
      "roles": 10,
      "ssh_keys": 2000,
      "role_permissions": 50
    },
    "growth_rate": "每年 30% 增长",
    "storage_estimation": {
      "initial_size_gb": 5,
      "year_1_projected_gb": 10,
      "year_3_projected_gb": 20
    },
    "connection_pool_sizing": {
      "max_connections": 100,
      "min_connections": 10
    },
    "vacuum_strategy": "对于频繁更新的表（如 deployments），设置 autovacuum 更激进；定期监控死元组比例。"
  },
  "interfaces": {
    "description": "数据库与外部服务之间的接口定义，包括连接协议、认证方式及服务访问矩阵。",
    "connection": {
      "protocol": "PostgreSQL wire protocol",
      "host": "env:DB_HOST",
      "port": 5432,
      "credentials": {
        "username": "env:DB_USER",
        "password": "env:DB_PASSWORD"
      },
      "ssl_mode": "require"
    },
    "auth_mechanism": "SCRAM-SHA-256",
    "access_control": {
      "services": [
        {
          "service_name": "project-service",
          "granted_roles": ["app_user"],
          "permissions": ["SELECT", "INSERT", "UPDATE", "DELETE"],
          "tables": ["projects", "environments"]
        },
        {
          "service_name": "deployment-service",
          "granted_roles": ["app_user"],
          "permissions": ["SELECT", "INSERT", "UPDATE", "DELETE"],
          "tables": ["deployments", "deployment_files"]
        },
        {
          "service_name": "file-service",
          "granted_roles": ["app_user"],
          "permissions": ["SELECT", "INSERT", "UPDATE", "DELETE"],
          "tables": ["files"]
        },
        {
          "service_name": "auth-service",
          "granted_roles": ["app_user"],
          "permissions": ["SELECT", "INSERT", "UPDATE", "DELETE"],
          "tables": ["users", "roles", "role_permissions"]
        },
        {
          "service_name": "ssh-service",
          "granted_roles": ["app_user"],
          "permissions": ["SELECT", "INSERT", "UPDATE", "DELETE"],
          "tables": ["ssh_keys"]
        }
      ]
    },
    "audit": "通过 PostgreSQL 审计扩展（pgaudit）记录所有 DDL 和 DML 操作。"
  },
  "error_handling": {
    "strategy": "数据库层错误处理策略，确保服务端能够捕获并处理常见数据库异常，避免数据不一致。",
    "constraint_violations": "捕获 UNIQUE 和 FOREIGN KEY 违反异常，返回明确的业务错误码（如 409 Conflict 或 422 Unprocessable Entity）。",
    "connection_error": "使用连接池（如 PgBouncer）预处理连接超时和断开，实施指数退避重试机制。",
    "deadlock_detection": "启用 log_lock_waits 和 deadlock_timeout，由应用层捕获 deadlock 异常并选择性重试事务。",
    "replication_lag": "对于读写分离的场景，应用层可容忍一定程度的复制延迟，读取关键数据时优先主库。",
    "data_validation": "在应用层进行严格的数据验证，确保进入数据库的数据符合表约束，减少数据库层的逻辑错误。",
    "logging": "所有数据库错误均记录日志，包含时间戳、SQL 语句指纹和事务 ID，便于追溯。"
  }
}