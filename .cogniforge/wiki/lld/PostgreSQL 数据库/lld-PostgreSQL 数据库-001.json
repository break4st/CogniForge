          "required": false
        },
        {
          "name": "status",
          "type": "VARCHAR(50)",
          "required": true
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "required": false
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "required": false
        }
