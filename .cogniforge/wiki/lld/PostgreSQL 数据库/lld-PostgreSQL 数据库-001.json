  "overview": {
    "description": "持久化存储项目、环境、部署历史、文件元数据、用户、角色等结构化数据。是系统唯一的结构化数据权威来源，保障 ACID 事务和数据一致性。",
    "dependencies": [
      "项目与环境服务",
      "文件管理服务",
      "部署执行服务",
      "安全与密钥服务",
      "部署历史与日志服务",
      "用户与权限服务"
    ],
    "tech_stack": [
      "PostgreSQL"
    ]
  },
  "business_rules": {
    "invariants": [
      "projects.name 全局唯一",
      "environments 中 (project_id, name) 联合唯一",
      "deployments.status 只能为预定义枚举值之一",
      "deployment_files.deployment_id 和 deployment_files.file_id 分别外键引用 deployments.id 和 files.id",
      "files.file_path 在同一个 project_id 下唯一",
      "ssh_keys.user_id 外键引用 users.id",
      "role_permissions 中 (role_id, permission) 联合唯一"
    ]
  },
