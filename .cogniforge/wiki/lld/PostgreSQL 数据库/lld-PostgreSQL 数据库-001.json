          "type": "VARCHAR(255)",
          "required": true
        },
        {
          "name": "project_id",
          "type": "INTEGER",
          "required": true
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "required": false
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "required": false
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "ssh_keys",
      "type": "table",
      "ownership": "canonical",
      "description": "存储 SSH 密钥对信息，包括加密后的私钥",
      "fields": [
        {
          "name": "id",
          "type": "SERIAL",
          "required": true
        },
        {
          "name": "name",
          "type": "VARCHAR(255)",
          "required": true
        },
        {
          "name": "public_key",
          "type": "TEXT",
          "required": true
        },
        {
          "name": "private_key_encrypted",
          "type": "TEXT",
          "required": true
        },
        {
          "name": "project_id",
          "type": "INTEGER",
