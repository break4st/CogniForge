  "module_boundary": {
    "in_scope": [
      "主密码设置（首次）",
      "主密码验证（每次启动/敏感操作前）",
      "主密码修改（用户主动发起）",
      "基于主密码的 AES-256-GCM 加密/解密",
      "PBKDF2 密钥派生",
      "修改主密码时触发所有凭据的重新加密"
    ],
    "out_of_scope": [
      "凭据的存储与检索（由 DatabaseService/EnvironmentService 负责）",
      "SSH 连接或部署执行",
      "用户界面交互（前端负责）"
    ],
