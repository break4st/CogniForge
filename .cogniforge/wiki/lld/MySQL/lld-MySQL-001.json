  "index_strategy": {
    "description": "索引策略旨在优化查询性能，针对常见查询模式创建适当的索引。",
    "principles": [
      "主键自动创建聚簇索引",
      "外键列创建非唯一索引以加速 JOIN",
      "频繁作为查询条件且区分度高的列创建索引",
      "唯一约束列创建唯一索引",
      "定期分析慢查询日志，添加缺失索引或调整现有索引",
      "避免过多索引，以免影响写入性能"
    ],
    "index_details": [
      {
        "table": "users",
        "indexes": [
          {
            "name": "PRIMARY KEY (id)",
            "justification": "聚簇索引，加速主键查找"
          },
          {
            "name": "UNIQUE INDEX idx_users_username",
            "justification": "用户名用于登录查询，唯一约束"
          },
          {
            "name": "UNIQUE INDEX idx_users_email",
            "justification": "邮箱用于登录和唯一性检查"
          }
        ]
      },
      {
        "table": "projects",
        "indexes": [
          {
            "name": "PRIMARY KEY (id)",
            "justification": "聚簇索引"
          },
          {
            "name": "UNIQUE INDEX idx_projects_name",
            "justification": "项目名称唯一，常用作查询条件"
          },
          {
            "name": "INDEX idx_projects_owner",
            "justification": "外键索引，加速项目按所有者查询"
          }
        ]
      },
      {
        "table": "environments",
        "indexes": [
          {
            "name": "PRIMARY KEY (id)",
            "justification": "聚簇索引"
          },
          {
            "name": "INDEX idx_env_project",
            "justification": "外键索引，加速按项目查询环境"
          },
          {
            "name": "UNIQUE INDEX idx_env_name_project",
            "justification": "同一项目下环境名唯一，加速特定环境查找"
          }
        ]
      },
      {
        "table": "deployments",
        "indexes": [
          {
            "name": "PRIMARY KEY (id)",
            "justification": "聚簇索引"
          },
          {
            "name": "INDEX idx_deploy_env",
            "justification": "外键索引，加速按环境查询部署"
          },
          {
            "name": "INDEX idx_deploy_status",
            "justification": "按状态筛选部署记录"
          },
          {
            "name": "INDEX idx_deploy_created",
            "justification": "按时间范围查询部署历史"
          }
        ]
      },
      {
        "table": "artifacts",
        "indexes": [
          {
            "name": "PRIMARY KEY (id)",
            "justification": "聚簇索引"
          },
          {
            "name": "INDEX idx_artifact_project",
            "justification": "外键索引，加速按项目查询制品"
          },
          {
            "name": "UNIQUE INDEX idx_artifact_version",
            "justification": "同一项目下版本号唯一，加速版本查询"
          }
        ]
      }
    ]
  },
  "migration_strategy": {
    "description": "数据库迁移策略采用版本化迁移，确保 schema 变更可追溯、可重复、可回滚。",
    "tooling": "建议使用 Flyway 或 Liquibase 等迁移工具，将迁移脚本作为代码管理。",
    "versioning": "语义化版本命名迁移脚本，如 V1.0.0__initial_schema.sql",
    "rollback": "每个迁移脚本需提供对应的回滚脚本（U 前缀），例如 U1.0.0__initial_schema_rollback.sql。在非生产环境测试回滚。",
    "zero_downtime": "对于生产环境重大变更，采用在线 DDL 策略，如 pt-online-schema-change 或支持 Online DDL 的语句。避免锁表。",
    "data_migration": "如有数据迁移需求，编写独立的数据迁移脚本，与结构迁移分离。"
  },
