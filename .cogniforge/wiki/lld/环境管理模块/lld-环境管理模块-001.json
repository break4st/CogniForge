  "error_handling": {
    "strategy": "统一通过标准API响应格式返回错误，区分客户端错误(4xx)与服务端错误(5xx)，并在日志中记录详细异常信息以便排查。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "当传入的 DTO 校验失败时返回，如必填字段缺失、格式不符合要求、IP地址非法等。detail 中包含具体的校验失败信息。"
      },
      {
        "code": "404",
        "name": "环境不存在",
        "description": "根据 ID 查询、更新或删除环境时，若数据库中不存在对应记录则返回。detail 中包含不存在的环境ID。"
      },
      {
        "code": "409",
        "name": "环境名称冲突",
        "description": "创建或更新环境时，若名称在系统中已存在则返回。detail 中包含冲突的名称。"
      },
      {
        "code": "422",
        "name": "SSH连接测试失败",
        "description": "测试连接时，SSH 客户端返回连接错误（如认证失败、超时、拒绝连接等），错误信息从底层 ssh2 库获取并包装在 detail 中。"
      },
      {
        "code": "500",
        "name": "内部服务错误",
        "description": "数据库操作异常、SSH 客户端不可用或其他未预期的运行时错误。detail 中提供通用错误提示，具体异常记录到日志。"
      }
    ]
  },
  "domain_objects": [
    {
      "name": "EnvironmentEntity",
      "object_type": "entity",
      "description": "环境实体，映射数据库表字段，包含所有业务属性。对应数据库中的环境配置记录，是业务操作的核心对象。",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "环境配置的唯一标识符，UUID 格式"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "环境配置的名称，用于显示和识别"
        },
        {
          "name": "ip",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "目标主机的 IP 地址"
        },
        {
          "name": "port",
          "type": "number",
          "required": true,
          "source": "input",
          "description": "SSH 服务的端口号，默认为 22"
        },
        {
          "name": "remotePath",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "远程主机上的默认路径"
        },
        {
          "name": "keyId",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "关联的密钥 ID（来自密钥管理模块），用于 SSH 认证"
        },
        {
          "name": "createdAt",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "创建时间戳，ISO 8601 格式"
        },
        {
          "name": "updatedAt",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "最后更新时间戳，ISO 8601 格式"
        }
      ]
    },
    {
      "name": "CreateEnvironmentDto",
      "object_type": "dto",
      "description": "创建环境请求的数据传输对象，包含新增环境所需的所有字段，并附带校验约束。",
      "attributes": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "环境名称，长度 1-100 字符"
        },
        {
          "name": "ip",
          "type": "string",
          "required": true,
          "source": "input",
          "description": "IP 地址，需符合 IPv4 或 IPv6 格式"
        },
        {
          "name": "port",
          "type": "number",
          "required": false,
          "source": "input",
          "description": "端口号，范围 1-65535，默认为 22"
        },
        {
          "name": "remotePath",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "远程路径，可选"
        },
        {
          "name": "keyId",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "关联的密钥 ID，可选"
        }
      ],
      "maps_to_entity": "EnvironmentEntity"
    },
    {
      "name": "UpdateEnvironmentDto",
      "object_type": "dto",
      "description": "更新环境请求的数据传输对象，所有字段可选，仅更新提供的字段。",
      "attributes": [
        {
          "name": "name",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "环境名称"
        },
        {
          "name": "ip",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "IP 地址"
        },
        {
          "name": "port",
          "type": "number",
          "required": false,
          "source": "input",
          "description": "端口号"
        },
        {
          "name": "remotePath",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "远程路径"
        },
        {
          "name": "keyId",
          "type": "string",
          "required": false,
          "source": "input",
          "description": "关联的密钥 ID"
        }
      ],
      "maps_to_entity": "EnvironmentEntity"
    },
    {
      "name": "EnvironmentDto",
      "object_type": "dto",
      "description": "环境信息响应 DTO，用于列表和详情展示，包含只读时间戳。",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "环境 ID"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "环境名称"
        },
        {
          "name": "ip",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "IP 地址"
        },
        {
          "name": "port",
          "type": "number",
          "required": true,
          "source": "db",
          "description": "端口号"
        },
        {
          "name": "remotePath",
          "type": "string",
          "required": false,
          "source": "db",
          "description": "远程路径"
        },
        {
          "name": "keyId",
          "type": "string",
          "required": false,
          "source": "db",
          "description": "关联的密钥 ID"
        },
        {
          "name": "createdAt",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "创建时间"
        },
        {
          "name": "updatedAt",
          "type": "string",
          "required": true,
          "source": "db",
          "description": "更新时间"
        }
      ],
      "maps_to_entity": "EnvironmentEntity"
    },
    {
      "name": "TestConnectionResultDto",
      "object_type": "dto",
      "description": "测试连接结果的响应 DTO，表示一次连接测试的成功或失败，以及附加消息。",
      "attributes": [
        {
          "name": "success",
          "type": "boolean",
          "required": true,
          "source": "computed",
          "description": "连接是否成功"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "source": "computed",
          "description": "测试结果的描述信息，成功时为空或成功提示，失败时包含错误原因"
        }
      ]
    },
    {
      "name": "ConnectionConfig",
      "object_type": "value_object",
      "description": "SSH 连接配置值对象，由环境实体派生，用于传递给 SSH 客户端模块进行连接。不可变，仅传输连接参数。",
      "attributes": [
        {
          "name": "host",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "主机 IP，来自 EnvironmentEntity.ip"
        },
        {
          "name": "port",
          "type": "number",
          "required": true,
          "source": "derived",
          "description": "端口，来自 EnvironmentEntity.port"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "SSH 用户名（需根据关联的密钥或默认配置获取，此处暂定为派生）"
        },
        {
          "name": "key",
          "type": "string",
          "required": true,
          "source": "derived",
          "description": "私钥内容（由密钥管理模块根据 keyId 提供，此处暂定为派生）"
        }
      ]
    },
    {
      "name": "EnvironmentStatus",
      "object_type": "enum",
      "description": "环境连接状态枚举，用于表示测试连接的结果状态。",
      "values": [
        "success",
        "failed"
      ]
    }
  ],
  "service_contracts": [
    {
      "name": "EnvironmentService",
      "description": "环境管理服务，实现环境配置的增删改查和连接测试",
      "methods": [
        {
          "name": "createEnvironment",
          "signature": "(dto: CreateEnvironmentDto) -> Promise<EnvironmentDto>",
          "precondition": "dto 字段有效，名称在同用户下唯一",
          "postcondition": "数据库中新增环境记录，返回环境信息",
          "description": "创建一个新的环境配置",
          "exceptions": [
            {
              "name": "DuplicateNameException",
              "trigger": "同用户下已存在同名环境",
              "http_status": 409
            },
            {
              "name": "ValidationException",
              "trigger": "dto 校验失败（如端口范围、IP格式）",
              "http_status": 400
            }
          ]
        },
        {
          "name": "updateEnvironment",
          "signature": "(id: number, dto: UpdateEnvironmentDto) -> Promise<EnvironmentDto>",
          "precondition": "id 对应的环境存在",
          "postcondition": "数据库中的环境信息更新，返回更新后的环境信息",
          "description": "更新指定环境的信息",
          "exceptions": [
            {
              "name": "NotFoundException",
              "trigger": "环境不存在",
              "http_status": 404
            },
            {
              "name": "DuplicateNameException",
              "trigger": "同用户下已存在同名环境",
              "http_status": 409
            },
            {
              "name": "ValidationException",
              "trigger": "dto 校验失败",
              "http_status": 400
            }
          ]
        },
        {
          "name": "deleteEnvironment",
          "signature": "(id: number) -> Promise<void>",
          "precondition": "id 对应的环境存在",
          "postcondition": "数据库中删除该环境记录",
          "description": "删除指定的环境",
          "exceptions": [
            {
              "name": "NotFoundException",
              "trigger": "环境不存在",
              "http_status": 404
            },
            {
              "name": "ActiveDeploymentExistsException",
              "trigger": "存在正在运行的部署时不允许删除",
              "http_status": 409
            }
          ]
        },
        {
          "name": "listEnvironments",
          "signature": "() -> Promise<EnvironmentDto[]>",
          "precondition": "无",
          "postcondition": "返回当前用户的所有环境列表",
          "description": "列出当前用户的所有环境",
          "exceptions": []
        },
        {
          "name": "getEnvironment",
          "signature": "(id: number) -> Promise<EnvironmentDto>",
          "precondition": "id 对应的环境存在",
          "postcondition": "返回指定环境的详细信息",
          "description": "获取单个环境的详细信息",
          "exceptions": [
            {
              "name": "NotFoundException",
              "trigger": "环境不存在",
              "http_status": 404
            }
          ]
        },
        {
          "name": "testConnection",
          "signature": "(id: number) -> Promise<TestConnectionResultDto>",
          "precondition": "id 对应的环境存在",
          "postcondition": "返回连接测试结果（成功或失败，含错误信息）",
          "description": "测试指定环境的 SSH 连接",
          "exceptions": [
            {
              "name": "NotFoundException",
              "trigger": "环境不存在",
              "http_status": 404
            },
            {
              "name": "ConnectionTimeoutException",
              "trigger": "SSH 连接超时",
              "http_status": 408
            },
            {
              "name": "AuthenticationFailedException",
              "trigger": "SSH 认证失败",
              "http_status": 401
            },
            {
              "name": "UnknownHostException",
              "trigger": "主机不可达",
              "http_status": 502
            }
          ]
        }
      ],
      "repository_dependencies": [
        "findById(id: number) -> EnvironmentEntity?",
        "findAllByUserId(userId: number) -> EnvironmentEntity[]",
        "create(entity: EnvironmentEntity) -> EnvironmentEntity",
        "update(entity: EnvironmentEntity) -> EnvironmentEntity",
        "delete(id: number) -> void",
        "existsByNameAndUserId(name: string, userId: number) -> boolean"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "环境名称不可为空，且在系统中唯一（不区分大小写）。",
      "IP 地址格式必须符合 IPv4 或 IPv6 规范，端口范围为 1-65535。",
      "远程路径必须为有效的绝对路径格式，且不能为空。",
      "每个环境必须关联一个已存在的密钥，不可悬空。",
      "删除环境前，必须确保没有正在进行的部署或自动化任务使用该环境。"
    ],
    "state_machines": [
      {
        "entity": "EnvironmentEntity",
        "states": [
          "Active",
          "Deleted"
        ],
        "transitions": [
          {
            "from": "Active",
            "to": "Deleted",
            "trigger": "用户发起删除操作",
            "actor": "用户"
          }
        ],
        "irreversible_rules": [
          "从 Active 到 Deleted 不可逆，删除后记录不再恢复。"
        ],
        "concurrency": "删除操作需检查关联任务状态，若无则立即执行逻辑删除；采用乐观锁防止并发删除冲突。"
      }
    ],
    "cross_service_rules": [
      "创建或更新环境时，必须通过密钥管理模块验证密钥 ID 的有效性，若密钥不存在则操作失败。",
      "测试连接时，必须将解密后的密钥传递给 SSH 客户端模块，不得直接传递密钥密文。",
      "删除环境时，若密钥删除模块通知密钥已被删除，则本模块应允许环境记录存在但标记密钥为无效，以便后续清理。",
      "环境列表查询时，可联合密钥管理模块获取密钥的显示名称或指纹，但不允许直接暴露密钥内容。"
    ]
