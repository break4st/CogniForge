  "data_models": [
    {
      "id": "DM-001",
      "name": "EnvironmentTable",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environments"
      },
      "description": "本地数据库中的环境配置表，存储部署环境的连接信息，包括名称、IP、端口、远程路径和关联的密钥ID。该表引用自Primary Database LLD。",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER",
          "required": true,
          "description": "主键，自增ID"
        },
        {
          "name": "name",
          "type": "TEXT",
          "required": true,
          "description": "环境名称，唯一标识一个环境"
        },
        {
          "name": "ip",
          "type": "TEXT",
          "required": true,
          "description": "目标服务器的IP地址或主机名"
        },
        {
          "name": "port",
          "type": "INTEGER",
          "required": true,
          "description": "SSH端口号，默认22"
        },
        {
          "name": "remotePath",
          "type": "TEXT",
          "required": true,
          "description": "远程服务器上的默认工作路径"
        },
        {
          "name": "keyId",
          "type": "INTEGER",
          "required": false,
          "description": "关联的SSH密钥ID，外键引用密钥管理表的id字段"
        },
        {
          "name": "createdAt",
          "type": "TEXT",
          "required": true,
          "description": "创建时间戳，ISO 8601格式"
        },
        {
          "name": "updatedAt",
          "type": "TEXT",
          "required": true,
          "description": "最后更新时间戳，ISO 8601格式"
        }
      ],
      "indexes": [
        {
          "name": "idx_environment_name",
          "unique": true,
          "columns": [
            "name"
          ]
        },
        {
          "name": "idx_environment_keyId",
          "unique": false,
          "columns": [
            "keyId"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-003"
      ],
      "source_contracts": [
        "CTR-003",
        "CTR-007"
      ],
      "constraints": [],
