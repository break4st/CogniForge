{
  "meta": {
    "doc_id": "lld-RollbackService-001",
    "type": "lld",
    "module_type": "service",
    "module": "RollbackService",
    "title": "RollbackService 详细设计文档",
    "author": "design_agent",
    "created": "2025-04-08T12:00:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-004"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": [
        "CMP-104"
      ],
      "contracts": [
        "CTR-007",
        "CTR-008"
      ],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "接收部署历史页面通过Electron IPC发起的请求：根据项目ID查询部署历史记录；根据部署记录ID执行回滚操作",
      "回滚流程的完整编排：查询原部署记录并验证有效性，获取目标环境SSH连接凭据，验证远程版本目录存在，更新远程current软链接指向目标版本，尝试执行start.sh启动脚本，记录回滚操作并更新原记录状态",
      "处理回滚过程中的各类异常，返回统一错误格式"
    ],
    "out_of_scope": [
      "SSH连接建立与命令执行的底层细节（由SSHService负责）",
      "环境凭据加解密和存储（由EnvironmentService和SecurityService负责）",
      "部署记录的物理存储管理（表结构由Primary Database模块管理，本模块仅引用）",
      "UI交互界面（仅作为后端IPC响应方）"
    ],
    "owned_components": [
      "CMP-104"
    ],
    "owned_contracts": [
      "CTR-007",
      "CTR-008"
    ],
    "consumed_contracts": [
      "CTR-010"
    ],
    "owned_data_models": [
      "DM-002"
    ],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "RollbackService是部署回滚业务流程的协调服务，运行于Electron主进程。它响应前端发起的查询部署历史和回滚指令，协调DatabaseService、EnvironmentService、SSHService共同完成回滚操作，保证远程环境的当前版本能够安全快速地切换至指定历史版本。",
    "dependencies": [
      "EnvironmentService",
      "SSHService",
      "DatabaseService",
      "LoggerService"
    ],
    "tech_stack": [
      "TypeScript",
      "Electron (Node.js runtime)",
      "better-sqlite3",
      "ssh2"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-004",
      "sad_component_ids": [
        "CMP-104"
      ],
      "sad_contract_ids": [
        "CTR-007",
        "CTR-008"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002"
        ],
        "interfaces": [
          "IF-001",
          "IF-002"
        ],
        "domain_objects": [],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": "完全覆盖回滚历史查看与执行需求"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "DeploymentRecord",
      "type": "table",
      "ownership": "canonical",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "project_id",
          "type": "integer",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "environment_id",
          "type": "integer",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "description": "部署版本号"
        },
        {
          "name": "status",
          "type": "enum:DeploymentStatus",
          "required": true,
          "description": "部署状态"
        },
        {
          "name": "remote_release_path",
          "type": "string",
          "required": true,
          "description": "远程发布目录路径"
        },
        {
          "name": "start_script_path",
          "type": "string",
          "required": false,
          "description": "启动脚本路径"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "rolled_back_from",
          "type": "integer",
          "required": false,
          "description": "回滚来源的部署记录ID，可为空"
        }
      ],
      "description": "部署记录数据模型"
    },
    {
      "id": "DM-002",
      "name": "RollbackAuditLog",
      "type": "table",
      "ownership": "owned",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "主键"
        },
        {
          "name": "original_deployment_id",
          "type": "integer",
          "required": true,
          "description": "原部署记录ID"
        },
        {
          "name": "new_deployment_id",
          "type": "integer",
          "required": true,
          "description": "新回滚部署记录ID"
        },
        {
          "name": "rollback_timestamp",
          "type": "datetime",
          "required": true,
          "description": "回滚执行时间"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "回滚操作状态(SUCCESS/FAILED)"
        },
        {
          "name": "error_message",
          "type": "string",
          "required": false,
          "description": "错误信息，失败时记录"
        }
      ],
      "description": "回滚审计日志数据模型"
    }
  ],
  "domain_objects": [],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "IRollbackService",
      "description": "回滚服务接口",
      "methods": [
        {
          "name": "rollback",
          "description": "执行回滚操作",
          "params": [
            {
              "name": "deployment_id",
              "type": "integer",
              "required": true,
              "description": "部署记录ID"
            }
          ],
          "returns": {
            "type": "object",
            "properties": {
              "success": {
                "type": "boolean"
              },
              "new_deployment_id": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "errors": [
            "DeploymentRecordNotFoundError",
            "EnvironmentNotFoundError",
            "RollbackFailedError"
          ]
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "IDeploymentHistoryService",
      "description": "部署历史查询接口",
      "methods": [
        {
          "name": "getDeploymentHistory",
          "description": "获取项目部署历史",
          "params": [
            {
              "name": "project_id",
              "type": "integer",
              "required": true,
              "description": "项目ID"
            }
          ],
          "returns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "version": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                }
              }
            }
          },
          "errors": [
            "ProjectNotFoundError"
          ]
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "context": "同步服务契约",
      "methods": [
        {
          "name": "executeRollback",
          "description": "完整的回滚流程",
          "params": [
            {
              "name": "deployment_id",
              "type": "integer",
              "required": true
            }
          ],
          "returns": {
            "type": "boolean",
            "description": "操作是否成功"
          }
        },
        {
          "name": "queryHistory",
          "description": "查询部署历史",
          "params": [
            {
              "name": "project_id",
              "type": "integer",
              "required": true
            }
          ],
          "returns": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "部署记录列表"
          }
        }
      ],
      "dependencies": [
        "DatabaseService",
        "EnvironmentService",
        "SSHService"
      ]
    }
  ],
  "error_handling": {
    "strategy": "统一错误处理策略",
    "errors": {
      "DeploymentRecordNotFoundError": {
        "code": 404,
        "message": "部署记录未找到"
      },
      "EnvironmentNotFoundError": {
        "code": 404,
        "message": "环境信息未找到"
      },
      "ProjectNotFoundError": {
        "code": 404,
        "message": "项目未找到"
      },
      "RollbackFailedError": {
        "code": 500,
        "message": "回滚操作失败"
      }
    }
  },
  "business_rules": {
    "invariants": [
      "每个环境只能有一个活动部署",
      "回滚记录必须包含原部署ID"
    ],
    "rules": [
      {
        "id": "BR-001",
        "description": "只有成功状态的部署才能被回滚"
      }
    ]
  },
  "workflow": {
    "steps": [
      {
        "id": 1,
        "description": "接收回滚请求",
        "actor": "RollbackService",
        "input": "deployment_id",
        "output": "验证请求有效性"
      },
      {
        "id": 2,
        "description": "查询原部署记录",
        "actor": "DatabaseService",
        "input": "deployment_id",
        "output": "部署记录"
      },
      {
        "id": 3,
        "description": "获取环境连接凭据",
        "actor": "EnvironmentService",
        "input": "environment_id",
        "output": "SSH连接凭据"
      },
      {
        "id": 4,
        "description": "执行远程回滚操作",
        "actor": "SSHService",
        "input": "凭据和版本路径",
        "output": "操作结果"
      },
      {
        "id": 5,
        "description": "更新部署记录状态",
        "actor": "DatabaseService",
        "input": "部署记录ID和状态",
        "output": "更新确认"
      },
      {
        "id": 6,
        "description": "返回回滚结果",
        "actor": "RollbackService",
        "input": "操作结果",
        "output": "最终响应"
      }
    ]
  }
}