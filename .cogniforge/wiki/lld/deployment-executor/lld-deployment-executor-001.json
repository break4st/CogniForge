  "module_boundary": {
    "in_scope": [
      "从 RabbitMQ 消费部署任务消息",
      "调用 environment-service 获取环境连接信息",
      "调用 ssh-key-service 获取解密后的 SSH 私钥",
      "使用 paramiko 建立 SSH 连接并上传文件",
      "在目标服务器创建版本文件夹并解压（如需）",
      "生成启动脚本并赋予执行权限",
      "通过 WebSocket 实时推送部署进度",
      "更新部署记录状态和日志"
    ],
    "out_of_scope": [
      "SSH 密钥的加密存储与管理",
      "项目与环境的 CRUD、连接测试",
      "部署记录的创建、查询、历史列表和重试编排",
      "WebSocket 连接管理、心跳与重连（由前端负责）",
      "用户认证与授权"
    ],
    "owned_components": [
      "CMP-005"
    ],
    "owned_contracts": [
      "CTR-005"
    ],
    "consumed_contracts": [
      "CTR-003"
    ],
    "owned_data_models": [
      "DM-004"
    ],
    "consumed_data_models": [
      "DM-001",
      "DM-002",
      "DM-003"
    ]
  },
  "overview": {
    "description": "部署执行器服务，作为 RabbitMQ 消费者异步处理部署任务，通过 SSH 将应用包上传至目标服务器，完成版本隔离与启动脚本生成，并通过 WebSocket 向前端实时推送部署进度。",
    "dependencies": [
      "ssh-key-service",
      "environment-service",
      "deployment-service"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "aio-pika",
      "paramiko",
      "asyncio",
      "Docker"
    ]
  },
