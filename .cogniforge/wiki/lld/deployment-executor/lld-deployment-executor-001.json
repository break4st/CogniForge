  "interfaces": [
    {
      "id": "IF-001",
      "name": "DeployProgressWebSocket",
      "description": "WebSocket 接口，用于向前端实时推送部署进度",
      "type": "websocket",
      "direction": "output",
      "message_format": "json",
      "method": "WS_CONNECT",
      "source_components": [
        "CMP-005"
      ],
      "source_contracts": [
        "CTR-005"
      ],
      "fields": [
        {
          "name": "deployment_id",
          "type": "UUID",
          "description": "部署记录 ID"
        },
        {
          "name": "status",
          "type": "String",
          "description": "当前状态: PENDING, RUNNING, SUCCESS, FAILED"
        },
        {
          "name": "progress",
          "type": "Integer",
          "description": "进度百分比 0-100"
        },
        {
          "name": "message",
          "type": "String",
          "description": "进度描述信息"
        },
        {
          "name": "timestamp",
          "type": "String",
          "description": "时间戳 ISO 8601 格式"
        }
      ],
      "connect": {
        "path": "/ws/deployments/{deployment_id}/progress",
        "description": "建立 WebSocket 连接以订阅部署进度"
      },
      "send": {
        "description": "服务端推送部署进度消息",
        "body": {
          "type": "object",
          "properties": {
            "status": {"type": "string"},
            "progress": {"type": "integer", "minimum": 0, "maximum": 100},
            "message": {"type": "string"},
            "timestamp": {"type": "string", "format": "date-time"}
          },
          "example": {
            "status": "RUNNING",
            "progress": 45,
            "message": "Uploading files...",
            "timestamp": "2025-03-29T10:00:00Z"
          }
        },
        "schema": {}
      },
      "close": {
        "description": "当部署完成或失败时，服务端关闭连接"
      }
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentExecutorService",
      "description": "部署执行服务契约，定义异步部署执行方法",
      "status": "active",
      "version": 1,
      "source_interface": "CTR-005",
      "methods": [
        {
          "name": "execute_deployment",
          "description": "执行部署任务的主方法，从 RabbitMQ 消息触发，完成整个部署流程",
          "signature": "async execute_deployment(message: DeployTaskMessage) -> None",
          "parameters": [
            {
              "name": "message",
              "type": "DeployTaskMessage",
              "required": true,
              "description": "部署任务消息"
            }
          ],
          "return_type": "None",
          "precondition": "RabbitMQ 消息有效且包含所有必需字段；deployment-service 记录状态为 PENDING",
          "postcondition": "部署状态变更为 SUCCESS 或 FAILED；日志已更新；WebSocket 推送完成通知",
          "exceptions": [
            {
              "type": "DeploymentException",
              "description": "部署过程中的任何失败",
              "code": "DEPLOY_FAILED",
              "status": 500
            }
          ],
          "http": {
            "method": "N/A",
            "path": "N/A"
          },
          "side_effects": {
            "state_change": "更新部署记录状态为 SUCCESS 或 FAILED",
            "notifications": ["WebSocket 推送进度和最终状态"],
            "external_calls": [
              "调用 environment-service 获取环境信息",
              "调用 ssh-key-service 获取私钥",
              "调用 deployment-service 更新状态"
            ]
          },
          "schema": {}
        }
      ],
      "configuration": {
        "retry": {
          "max_attempts": 0,
          "backoff": "none"
        },
        "timeout": 600,
        "circuit_breaker": {
          "enabled": true,
          "threshold": 5,
          "recovery_time": 60
        }
      },
      "change_history": []
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "部署任务必须原子执行：要么全部成功，要么全部失败并记录日志",
      "type": "invariant",
      "scope": "execute_deployment",
      "rule": "在部署过程中任何步骤失败时，必须停止后续步骤，将部署状态置为 FAILED，并记录详细错误日志",
      "source": "REQ-001"
    },
    {
      "id": "BR-002",
      "description": "版本隔离：每个部署版本必须在目标服务器上创建独立的版本目录",
      "type": "invariant",
      "scope": "execute_deployment",
      "rule": "远程部署路径必须包含版本标签目录，例如 /opt/app/versions/{version_label}/，部署文件解压到此目录下",
      "source": "REQ-001"
    },
    {
      "id": "BR-003",
      "description": "启动脚本生成规则",
      "type": "derivation",
      "scope": "execute_deployment",
      "rule": "根据项目配置生成启动脚本，脚本名称固定为 start.sh，放置在版本目录根下，并给予执行权限 chmod +x",
      "source": "REQ-001"
    }
  ],
  "error_handling": {
    "strategy": "fail-fast with comprehensive logging and status updates",
    "retry_policy": {
      "enabled": false,
      "max_retries": 0,
      "description": "部署任务不自动重试，由用户手动触发重试"
    },
    "fallback_actions": [
      "记录详细错误日志到部署记录中",
      "更新部署状态为 FAILED",
      "通过 WebSocket 推送失败消息和错误详情"
    ],
    "error_categories": [
      {
        "name": "ConnectionError",
        "description": "SSH 连接失败、远程服务不可达",
        "handling": "记录错误并标记为 FAILED，可能原因包括网络问题或凭证错误"
      },
      {
        "name": "FileTransferError",
        "description": "文件上传或解压失败",
        "handling": "记录错误并标记为 FAILED，可能原因包括磁盘空间不足或权限问题"
      },
      {
        "name": "ScriptExecutionError",
        "description": "启动脚本生成或执行失败",
        "handling": "记录错误并标记为 FAILED，可能原因包括命令不存在或权限不足"
