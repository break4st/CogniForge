          ],
          "behavior": [
            "挂载后建立 SSE 连接至 /api/deployments/{deploymentId}/progress",
            "监听 progress/step/log/complete/error 事件并更新相应 state",
            "完成后调用 onComplete",
            "卸载时关闭 EventSource"
          ],
          "edge_cases": [
            "SSE 连接异常断开且任务未完成：自动重连3次，间隔2s，失败后置 status='failed'",
            "收到非法格式事件：忽略并 console.warn"
          ],
          "children": [
