      ]
    }
  ],
  "state_design": {
    "global": [
      {
        "name": "currentProject",
        "type": "{ id: number, name: string, environments: Array<{ id: number, name: string }> }",
        "description": "当前选中的项目信息及其绑定环境列表，由项目管理模块维护。部署面板消费此状态。",
        "consumers": [
          "DeployPage"
        ]
      }
    ],
    "caching_strategy": "环境列表缓存于全局 store，切换项目时由项目管理模块负责更新。部署进度数据不持久化，页面刷新后状态丢失（后端任务继续运行，但前端需重新触发进度监听或通过部署ID从历史日志恢复，本次设计暂不处理刷新恢复场景）。"
  },
  "route_design": [
    {
      "path": "/projects/:projectId/deploy",
      "page": "DeployPage",
      "title": "部署",
      "auth": "all",
      "layout": "default"
    }
  ],
  "interaction_flows": [
    {
      "name": "部署准备与触发流程",
      "description": "用户从项目详情进入部署页面，选择环境、指定文件，点击开始部署，页面展示进度。",
      "steps": [
        "步骤1: 用户从项目详情页点击「部署」跳转至 /projects/:id/deploy",
        "步骤2: DeployPage 挂载，获取 projectId，从全局 store 读取环境列表；若无环境，显示提示并禁用开始按钮",
        "步骤3: 用户在 EnvironmentSelector 中选择一个环境",
        "步骤4: 用户在 FileSelector 输入或浏览选择本地可执行文件路径",
        "步骤5: 用户可选填写版本命名，勾选自动执行",
        "步骤6: DeploymentSummary 实时显示用户选择",
        "步骤7: 用户点击「开始部署」按钮，前端验证必填字段",
        "步骤8: 发送 POST /api/projects/:id/deploy，请求体携带表单数据",
        "步骤9: 成功返回 deployment_id，页面切换至 in_progress 阶段，渲染 DeployProgressPanel",
        "步骤10: DeployProgressPanel 建立 SSE 连接，实时更新进度条、步骤和日志",
        "步骤11: 收到 complete 或 error 事件后展示最终结果，关闭 SSE 连接",
        "步骤12: 用户可查看日志或返回重新部署"
      ]
    }
  ],
  "api_integration": [
    {
      "page": "DeployPage",
      "endpoint": "POST /api/projects/:id/deploy",
      "maps_to": "DeployButton 点击触发，请求体基于表单状态，响应 deployment_id 存入 state"
    },
    {
      "page": "DeployPage",
      "endpoint": "GET /api/deployments/:id/progress (SSE)",
      "maps_to": "DeployProgressPanel 挂载时建立连接，事件数据更新 progressData 状态"
    }
  ]
