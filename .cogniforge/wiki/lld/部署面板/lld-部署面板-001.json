  "error_handling": {
    "strategy": "前端统一使用 try-catch 捕获请求错误，并根据后端返回的标准错误码映射为用户友好的提示信息。网络异常或超时全局拦截，显示通用「网络错误，请稍后重试」消息。SSE 连接断线且任务未完成时自动重连，最多3次。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "如 FILE_NOT_FOUND，前端展示具体错误信息，并允许用户重新选择文件。"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "如 PROJECT_NOT_FOUND，跳转到错误页面或返回项目列表。"
      },
      {
        "code": "422",
        "name": "业务规则错误",
        "description": "如 ENVIRONMENT_NOT_BOUND，提示用户该项目未绑定该环境，可选择其他环境或先去绑定。"
      },
      {
        "code": "5xx",
        "name": "服务器错误",
        "description": "显示通用服务器错误提示，建议稍后重试。"
      }
    ]
  },
  "workflow": {
    "name": "部署执行主流程",
    "description": "用户输入部署参数、触发部署、实时监控进度至完成的端到端流程。",
    "steps": [
      {
        "order": 1,
        "name": "渲染部署表单",
        "action": "DeployPage 挂载，读取路由 projectId，从全局 store 获取项目绑定的环境列表，初始化表单组件。",
        "timeout_seconds": 0,
        "on_failure": "展示错误界面或重定向到项目列表。"
      },
      {
        "order": 2,
        "name": "用户填写部署信息",
        "action": "用户选择环境、指定文件路径（可手动或通过文件选择器）、可选填写版本名和自动执行选项。",
        "timeout_seconds": 0,
        "on_failure": "表单验证未通过时，DeployButton 保持禁用状态。"
      },
      {
        "order": 3,
        "name": "触发部署",
        "action": "用户点击‘开始部署’按钮，前端发送 POST /api/projects/{projectId}/deploy，携带 selectedEnvironmentId, localFilePath, versionNaming, autoExecute。",
        "timeout_seconds": 60,
        "on_failure": "显示错误提示（如文件不存在、环境未绑定），不进入进度监听。"
      },
      {
        "order": 4,
        "name": "启动进度监听",
        "action": "成功响应返回 deployment_id 后，页面进入 in_progress 状态，渲染 DeployProgressPanel，并建立 SSE 连接至 /api/deployments/{deployment_id}/progress。",
        "timeout_seconds": 10,
        "on_failure": "SSE 连接失败则显示错误，可手动重试。"
      },
      {
        "order": 5,
        "name": "实时更新进度",
        "action": "监听 progress/step/error 事件，更新进度条百分比、当前步骤文字和日志列表。遇到 error 事件时标记任务失败。",
        "timeout_seconds": 0,
        "on_failure": "SSE 断开且未收到 complete/error 时自动重连（最多3次），全部失败则标记 failed。"
      },
      {
        "order": 6,
        "name": "部署完成",
        "action": "收到 complete 事件或 error 事件后，展示最终结果（成功/失败）、日志，关闭 SSE 连接。用户可查看详细日志或发起新的部署。",
        "timeout_seconds": 0,
        "on_failure": "最终状态处理完成后流程结束。"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 2,
      "retryable_errors": [
        "SSE_CONNECTION_LOST"
      ],
      "non_retryable_errors": [
        "FILE_NOT_FOUND",
        "PROJECT_NOT_FOUND",
        "ENVIRONMENT_NOT_BOUND",
        "AUTH_ERROR"
      ]
    }
  },
  "component_tree": [
    {
      "name": "DeployPage",
      "path": "/projects/:projectId/deploy",
      "description": "部署页面容器，管理整体部署流程状态，组合所有子组件",
      "props": [
        {
          "name": "projectId",
          "type": "number",
          "required": true,
          "description": "来自路由参数的项目ID"
        }
      ],
      "events": [],
      "state": [
        {
          "name": "deploymentPhase",
          "type": "'form' | 'triggering' | 'in_progress' | 'completed'",
          "description": "当前部署阶段"
        },
        {
          "name": "deploymentId",
          "type": "string | null",
          "description": "部署任务ID"
        },
        {
          "name": "formData",
          "type": "DeploymentForm",
          "description": "用户输入的表单数据"
        },
        {
          "name": "progressData",
          "type": "DeploymentProgress | null",
          "description": "部署进度数据"
        },
        {
          "name": "environments",
          "type": "Array<{id: number, name: string}>",
          "description": "当前项目绑定的环境列表（从全局store获取）"
        }
      ],
      "behavior": [
        "挂载时从全局 useProjectStore 读取当前项目信息和环境列表",
        "若环境列表为空，显示「该项目未绑定任何环境，请先绑定环境」",
        "部署触发后更新 phase 并传递 deploymentId 给 DeployProgressPanel",
        "组件卸载时关闭任何活跃的 SSE 连接"
      ],
      "edge_cases": [
        "路由参数 projectId 非数字或项目不存在时展示错误页面或重定向",
        "环境列表为空时禁用开始部署按钮"
      ],
      "children": [
        {
          "name": "EnvironmentSelector",
          "path": "",
          "description": "从项目绑定环境列表中选取一个环境",
          "props": [
            {
              "name": "environments",
              "type": "Array<{id: number, name: string}>",
              "required": true,
              "description": "可选环境列表"
            },
            {
              "name": "value",
              "type": "number | undefined",
              "required": false,
              "description": "当前选中的环境ID"
            },
            {
              "name": "onChange",
              "type": "(id: number) => void",
              "required": true,
              "description": "选中环境时回调"
            }
          ],
          "events": [
            {
              "name": "onChange",
              "payload_type": "number"
            }
          ],
          "state": [],
          "behavior": [
            "使用 Ant Design Select 组件渲染下拉列表",
            "默认占位提示「请选择环境」"
          ],
          "edge_cases": [
            "列表为空时 Select 禁用并显示「无可用环境」"
          ],
          "children": []
        },
        {
          "name": "FileSelector",
          "path": "",
          "description": "通过文本输入或本地文件对话框指定可执行文件路径",
          "props": [
            {
              "name": "value",
              "type": "string",
              "required": true,
              "description": "当前输入的文件路径"
            },
            {
              "name": "onChange",
              "type": "(path: string) => void",
              "required": true,
              "description": "路径变更回调"
            }
          ],
          "events": [
            {
              "name": "onChange",
              "payload_type": "string"
            }
          ],
          "state": [],
          "behavior": [
            "包含一个 Input 和一个 Button（浏览）",
            "点击浏览时，若在 Electron 环境使用 dialog.showOpenDialog，否则提示用户手动输入",
            "输入框支持直接编辑"
          ],
          "edge_cases": [
            "路径为空或格式非法时显示错误提示",
            "Web 环境受限时明确告知用户手动输入"
          ],
          "children": []
        },
        {
          "name": "VersionNamingInput",
          "path": "",
          "description": "可选的版本命名输入框",
          "props": [
            {
              "name": "value",
              "type": "string",
              "required": false,
              "description": "版本名称"
            },
            {
              "name": "onChange",
              "type": "(name: string) => void",
              "required": true,
              "description": "变更回调"
            }
          ],
          "events": [
            {
              "name": "onChange",
              "payload_type": "string"
            }
          ],
          "state": [],
          "behavior": [
            "一个普通 Input 组件",
            "允许为空"
          ],
          "edge_cases": [
            "空值表示使用默认命名"
          ],
          "children": []
        },
        {
          "name": "AutoExecuteCheckbox",
          "path": "",
          "description": "决定部署后是否自动执行远程脚本",
          "props": [
            {
              "name": "checked",
              "type": "boolean",
              "required": true,
              "description": "是否勾选"
            },
            {
              "name": "onChange",
              "type": "(checked: boolean) => void",
              "required": true,
              "description": "变更回调"
            }
          ],
          "events": [
            {
              "name": "onChange",
              "payload_type": "boolean"
            }
          ],
          "state": [],
          "behavior": [
            "使用 Ant Design Checkbox"
          ],
          "edge_cases": [
            "默认不勾选"
          ],
          "children": []
        },
        {
          "name": "DeploymentSummary",
          "path": "",
          "description": "实时展示用户选择的部署摘要",
          "props": [
            {
              "name": "environmentName",
              "type": "string",
              "required": false,
              "description": "环境名称"
            },
            {
              "name": "fileName",
              "type": "string",
              "required": false,
              "description": "文件名（从路径提取）"
            },
            {
              "name": "versionNaming",
              "type": "string",
              "required": false,
              "description": "版本命名"
            },
            {
              "name": "autoExecute",
              "type": "boolean",
              "required": false,
              "description": "是否自动执行"
            }
          ],
          "events": [],
          "state": [],
          "behavior": [
            "纯展示组件，格式化显示所选环境、文件名、版本名、自动执行"
          ],
          "edge_cases": [
            "必填字段缺失时占位符显示「—」"
          ],
          "children": []
        },
        {
          "name": "DeployButton",
          "path": "",
          "description": "触发部署操作的主按钮",
          "props": [
            {
              "name": "disabled",
              "type": "boolean",
              "required": true,
              "description": "是否禁用"
            },
            {
              "name": "loading",
              "type": "boolean",
              "required": true,
              "description": "是否加载中"
            },
            {
              "name": "onClick",
              "type": "() => void",
              "required": true,
              "description": "点击回调"
            }
          ],
          "events": [
            {
              "name": "onClick",
              "payload_type": "void"
            }
          ],
          "state": [],
          "behavior": [
            "点击后触发父组件 deploy 方法",
            "进入加载状态时展示 spinner"
          ],
          "edge_cases": [
            "防重复点击：disabled 或 loading 时 onClick 无效"
          ],
          "children": []
        },
        {
          "name": "DeployProgressPanel",
          "path": "",
          "description": "条件渲染的进度面板，包含进度条、步骤提示和日志查看器",
          "props": [
            {
              "name": "deploymentId",
