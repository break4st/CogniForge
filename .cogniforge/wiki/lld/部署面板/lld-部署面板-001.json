              "type": "(success: boolean, logs: string[], error?: string) => void",
              "required": true,
              "description": "完成回调"
            }
          ],
          "events": [
            {
              "name": "onComplete",
              "payload_type": "{success: boolean, logs: string[], error?: string}"
            }
          ],
          "state": [
