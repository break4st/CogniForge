  "workflow": {
    "name": "前端部署交互主流程",
    "description": "前端用户登录后，进行项目/环境管理并触发部署的交互流程。",
    "steps": [
      {
        "order": 1,
        "name": "用户登录",
        "action": "用户在LoginPage提交凭证，调用登录API获取JWT",
        "timeout_seconds": 30,
        "on_failure": "显示错误提示，允许重试"
      },
      {
        "order": 2,
        "name": "获取项目列表",
        "action": "ProjectListPage加载项目列表",
        "timeout_seconds": 30,
        "on_failure": "显示重试按钮"
      },
      {
        "order": 3,
        "name": "管理环境",
        "action": "在EnvironmentListPage增/改/测试环境",
        "timeout_seconds": 60,
        "on_failure": "显示具体错误原因"
      },
      {
        "order": 4,
        "name": "提交部署",
        "action": "DeployPage选择环境和文件并提交",
        "timeout_seconds": 120,
        "on_failure": "返回错误码，保留表单数据供重试"
      },
      {
        "order": 5,
        "name": "查看实时日志",
        "action": "建立WebSocket连接，LiveLogDrawer展示日志",
        "timeout_seconds": 0,
        "on_failure": "断线后尝试自动重连，最多3次"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  }
}