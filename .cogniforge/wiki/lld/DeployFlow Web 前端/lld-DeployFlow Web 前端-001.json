  "overview": {
    "description": "基于 React 和 Ant Design 构建的单页应用，提供项目、环境、部署管理和实时日志查看交互界面。通过 Axios 调用 REST API，通过 WebSocket 获取实时部署日志。使用 Zustand 管理全局状态，React Router 管理路由。",
    "dependencies": [
      "react",
      "react-dom",
      "react-router-dom",
      "antd",
      "@ant-design/icons",
      "axios",
      "zustand",
      "dayjs"
    ],
    "tech_stack": [
      "React",
      "Ant Design",
      "Zustand",
      "React Router",
      "Axios",
      "JWT (JSON Web Tokens)"
    ]
  },
