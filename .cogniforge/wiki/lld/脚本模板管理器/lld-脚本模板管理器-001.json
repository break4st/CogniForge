  "module_boundary": {
    "in_scope": [
      "提供内置默认启动脚本（start.sh）与停止脚本（stop.sh）模板",
      "允许用户根据项目或环境维度自定义脚本内容并持久化存储",
      "支持脚本模板的创建、读取、更新、删除，并维护继承关系（自定义优先，否则回退至默认）",
      "根据部署时的环境变量对模板进行占位符替换，生成最终可执行脚本",
      "在保存自定义脚本时执行基本语法校验（如 shebang 检查、非法字符过滤）"
    ],
    "out_of_scope": [
      "实际的部署执行、文件上传、SSH 连接等（由部署执行引擎和 SSH 模块负责）",
      "环境变量值的获取与维护（假设由环境/项目模块提供底层数据，本模块仅读取）",
      "前端界面渲染与交互逻辑（由 React 表现层处理）"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "脚本模板管理器是部署系统的支撑服务，负责管理启动/停止脚本模板的生命周期。它提供默认模板，并允许用户针对特定环境或项目进行自定义。在部署时，根据上下文进行变量替换，生成最终脚本。同时内置轻量级语法校验。",
    "dependencies": [
      "Primary Database",
      "部署执行引擎"
    ],
    "tech_stack": [
      "Python 3.10+",
      "SQLAlchemy",
      "Flask",
      "SQLite 3"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
