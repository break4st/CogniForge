  "business_rules": [
    {
      "id": "BR-001",
      "description": "当查询脚本模板列表时，应合并默认模板和指定上下文的自定义模板，自定义模板优先覆盖同类型默认模板",
      "type": "invariant"
    },
    {
      "id": "BR-002",
      "description": "删除模板时，只能删除scope非DEFAULT的模板，否则拒绝操作",
      "type": "constraint"
    },
    {
      "id": "BR-003",
      "description": "生成脚本时，必须提供模板中所有占位符对应的变量值，否则拒绝生成并提示缺失变量",
      "type": "precondition"
    },
    {
      "id": "BR-004",
      "description": "自定义模板在保存时必须进行语法校验：至少包含合法的 shebang 行，且不包含危险字符",
      "type": "invariant"
    }
  ],
  "error_handling": {
    "strategy": "每个接口方法内部捕获异常并转换为统一的错误响应格式 { error_code: string, message: string }，对外不暴露内部异常细节。对于数据库操作异常重试一次，仍失败则向上抛出服务不可用错误。",
    "definitions": [
      {
        "code": "INVALID_PARAMETER",
        "message": "请求参数不符合规范",
        "http_status": 400
      },
      {
        "code": "TEMPLATE_NOT_FOUND",
        "message": "请求的模板不存在",
        "http_status": 404
      },
      {
        "code": "DEFAULT_TEMPLATE_DELETE_FORBIDDEN",
        "message": "不允许删除默认模板",
        "http_status": 403
      },
      {
        "code": "MISSING_VARIABLE",
        "message": "生成脚本时缺少必要的变量",
        "http_status": 400
      },
      {
        "code": "SYNTAX_ERROR",
        "message": "模板内容语法校验失败",
        "http_status": 400
      },
      {
        "code": "DATABASE_ERROR",
        "message": "数据库操作失败",
        "http_status": 500
      }
    ]
  },
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "ScriptTemplateService",
      "provider_component_id": "CMP-001",
      "methods": [
        {
          "name": "list_script_templates",
          "signature": "list_script_templates(project_id: int, environment_id: int) -> TemplateListResponse",
          "precondition": "project_id 和 environment_id 要么同时提供，要么同时为 None",
          "postcondition": "返回合并后的模板摘要列表，自定义模板覆盖同类型默认模板",
          "description": "根据项目和环境（可选）获取合并后的脚本模板列表",
          "parameters": [
            {
              "name": "project_id",
              "type": "integer",
              "required": false,
              "description": "项目ID"
            },
            {
              "name": "environment_id",
              "type": "integer",
              "required": false,
              "description": "环境ID"
            }
          ],
          "returns": {
            "type": "TemplateListResponse",
            "description": "包含模板摘要列表的响应对象"
          }
        },
        {
          "name": "get_script_template",
          "signature": "get_script_template(template_id: int) -> TemplateDetailResponse",
          "precondition": "template_id 对应的模板必须存在",
          "postcondition": "返回该模板的完整信息",
          "description": "获取单个模板的详细信息",
          "parameters": [
            {
              "name": "template_id",
              "type": "integer",
              "required": true,
              "description": "模板ID"
            }
          ],
          "returns": {
            "type": "TemplateDetailResponse",
            "description": "模板详情响应对象"
          }
        },
        {
          "name": "delete_custom_template",
          "signature": "delete_custom_template(template_id: int) -> DeleteResponse",
          "precondition": "模板存在且 scope != DEFAULT",
          "postcondition": "模板被成功删除，返回成功标志",
          "description": "删除指定的自定义模板",
          "parameters": [
            {
              "name": "template_id",
              "type": "integer",
              "required": true,
              "description": "模板ID"
            }
          ],
          "returns": {
            "type": "DeleteResponse",
            "description": "成功标志"
          }
        },
        {
          "name": "generate_script",
          "signature": "generate_script(request: GenerateScriptRequest) -> GenerateScriptResponse",
          "precondition": "模板存在且所有占位符变量均在 request.variables 中提供",
          "postcondition": "返回替换变量后的最终脚本内容",
          "description": "根据模板和变量映射生成最终脚本",
          "parameters": [
            {
              "name": "request",
              "type": "GenerateScriptRequest",
              "required": true,
              "description": "包含 template_id 和 variables 的请求对象"
            }
          ],
          "returns": {
            "type": "GenerateScriptResponse",
            "description": "包含生成脚本内容的响应对象"
          }
        }
      ]
    }
  ]
}