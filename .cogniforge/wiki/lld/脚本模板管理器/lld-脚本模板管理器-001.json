        ]
      },
      "coverage": "full",
      "notes": "默认模板内容可由配置文件或代码常量定义，不在数据库持久化，但可通过查询接口统一返回"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "ScriptTemplate",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "script_template"
      },
      "description": "存储用户自定义的脚本模板（按环境和项目维度），同时包含默认模板可通过 scope 为 DEFAULT 的行进行逻辑区分",
      "fields": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "主键，自增唯一标识"
        },
        {
          "name": "name",
          "type": "string(128)",
          "required": true,
          "description": "模板名称"
        },
        {
          "name": "content",
          "type": "text",
          "required": true,
          "description": "脚本内容（包含占位符）"
        },
        {
          "name": "script_type",
          "type": "string(16)",
          "required": true,
          "description": "脚本类型（START 或 STOP）"
        },
        {
          "name": "scope",
          "type": "string(16)",
          "required": true,
          "description": "作用域（DEFAULT, PROJECT, ENVIRONMENT）"
        },
        {
          "name": "project_id",
          "type": "integer",
          "required": false,
          "description": "当 scope=PROJECT 时关联的项目ID"
        },
        {
          "name": "environment_id",
          "type": "integer",
          "required": false,
          "description": "当 scope=ENVIRONMENT 时关联的环境ID"
        },
        {
          "name": "created_at",
          "type": "datetime",
          "required": true,
          "description": "创建时间"
        },
        {
          "name": "updated_at",
          "type": "datetime",
          "required": true,
          "description": "最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_scope_project_env_type",
          "unique": true,
          "columns": [
            "scope",
            "project_id",
            "environment_id",
            "script_type"
          ]
        }
      ],
      "source_requirements": [
        "REQ-001"
      ],
      "source_components": [
        "CMP-001"
      ],
      "source_contracts": [
        "CTR-001"
      ],
      "constraints": [
        "scope 为 PROJECT 时 project_id 不为空，environment_id 为空；scope 为 ENVIRONMENT 时 environment_id 不为空；scope 为 DEFAULT 时两关联字段均为空"
      ],
      "lifecycle": {
        "create": "用户保存自定义模板时插入",
        "update": "再次编辑时更新内容",
        "delete": "显式删除自定义模板",
        "retention": "默认模板永不删除"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "list_script_templates",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "list_script_templates(project_id, environment_id)",
      "description": "根据项目ID和环境ID，返回该上下文中可用的脚本模板列表（包括默认模板和覆盖的自定义模板）",
      "parameters": [
        {
          "name": "project_id",
          "type": "integer",
          "in": "body",
          "required": false,
          "description": "项目ID"
        },
        {
          "name": "environment_id",
          "type": "integer",
          "in": "body",
          "required": false,
          "description": "环境ID"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "templates": [
            {
              "id": "integer",
              "name": "string",
              "script_type": "string",
              "scope": "string",
              "content": "string"
            }
          ]
        }
      },
      "errors": [
        {
          "code": "INVALID_PARAMETER",
          "message": "project_id 和 environment_id 必须同时提供或同时不提供"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "get_script_template",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "get_script_template(template_id)",
      "description": "根据模板ID获取单个模板的详细信息",
      "parameters": [
        {
          "name": "template_id",
          "type": "integer",
          "in": "body",
          "required": true,
          "description": "模板ID"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "script_type": "string",
          "scope": "string",
          "content": "string",
          "project_id": "integer|null",
          "environment_id": "integer|null"
        }
      },
      "errors": [
        {
          "code": "TEMPLATE_NOT_FOUND",
          "message": "指定ID的模板不存在"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "delete_custom_template",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "delete_custom_template(template_id)",
      "description": "删除用户自定义模板（不允许删除默认模板）",
      "parameters": [
        {
          "name": "template_id",
          "type": "integer",
          "in": "body",
          "required": true,
          "description": "要删除的模板ID"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "success": "boolean"
        }
      },
      "errors": [
        {
          "code": "TEMPLATE_NOT_FOUND",
          "message": "指定ID的模板不存在"
        },
        {
          "code": "DEFAULT_TEMPLATE_DELETE_FORBIDDEN",
          "message": "不允许删除默认模板"
        }
      ]
    },
    {
      "id": "IF-004",
      "name": "generate_script",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "generate_script(template_id, variables)",
      "description": "根据模板ID和变量映射，执行占位符替换并返回生成的脚本内容",
      "parameters": [
        {
          "name": "template_id",
          "type": "integer",
          "in": "body",
          "required": true,
          "description": "模板ID"
        },
        {
          "name": "variables",
          "type": "object",
          "in": "body",
          "required": true,
          "description": "变量键值对映射"
        }
      ],
      "request_body": {
        "template_id": "integer",
        "variables": "object"
      },
      "response": {
        "status": 200,
        "body": {
          "generated_script": "string"
        }
      },
      "errors": [
        {
          "code": "TEMPLATE_NOT_FOUND",
          "message": "指定ID的模板不存在"
        },
        {
          "code": "MISSING_VARIABLE",
          "message": "模板中存在未提供值的占位符"
        }
      ]
    }
  ],
