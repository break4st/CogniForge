  "interfaces": [
    {
      "id": "IF-001",
      "name": "用户登录接口",
      "description": "提交登录表单，获取访问令牌和刷新令牌。",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "consumed_contract": "CTR-001",
      "request": {
        "body": {
          "username": "string",
          "password": "string"
        }
      },
      "response": {
        "accessToken": "string",
        "refreshToken": "string",
        "user": {
          "username": "string"
        }
      },
      "source_components": [
        "CMP-001"
      ],
      "source_metrics": null
    },
    {
      "id": "IF-002",
      "name": "获取项目列表接口",
      "description": "获取当前用户的所有项目。",
      "method": "GET",
      "endpoint": "/api/projects",
      "consumed_contract": "CTR-002",
      "request": {},
      "response": {
        "projects": [
          {
            "id": "string",
            "name": "string",
            "description": "string",
            "createdAt": "datetime"
          }
        ]
      },
      "source_components": [
        "CMP-001"
      ],
      "source_metrics": null
    },
    {
      "id": "IF-003",
      "name": "获取环境列表接口",
      "description": "获取指定项目下的所有环境。",
      "method": "GET",
      "endpoint": "/api/projects/{projectId}/environments",
      "consumed_contract": "CTR-003",
      "request": {
        "path": {
          "projectId": "string (project id)"
        }
      },
      "response": {
        "environments": [
          {
            "id": "string",
            "name": "string",
            "type": "string",
            "status": "string"
          }
        ]
      },
      "source_components": [
        "CMP-001"
      ],
      "source_metrics": null
    },
    {
      "id": "IF-004",
      "name": "触发部署接口",
      "description": "上传文件并触发部署。",
      "method": "POST",
      "endpoint": "/api/deploy",
      "consumed_contract": "CTR-004",
      "request": {
        "body": {
          "projectId": "string",
          "environmentId": "string",
          "file": "multipart/form-data (file)"
        }
      },
      "response": {
        "deploymentId": "string",
        "status": "string"
      },
      "source_components": [
        "CMP-001"
      ],
      "source_metrics": null
    },
    {
      "id": "IF-005",
      "name": "部署日志推送",
      "description": "通过 WebSocket 接收部署日志。",
      "method": "WSS",
      "endpoint": "wss://api.example.com/ws/logs",
      "consumed_contract": "CTR-005",
      "protocol": "WebSocket",
      "request": {
        "query": {
          "deploymentId": "string"
        }
      },
      "response": {
        "message": {
          "log": "string",
          "level": "string",
          "timestamp": "datetime"
        }
      },
      "source_components": [
        "CMP-001"
      ],
      "source_metrics": null
    },
    {
      "id": "IF-006",
      "name": "获取部署历史接口",
      "description": "获取部署历史记录，支持筛选。",
      "method": "GET",
      "endpoint": "/api/deployments",
      "consumed_contract": "CTR-006",
      "request": {
        "query": {
          "projectId": "string (optional)",
          "environmentId": "string (optional)",
          "status": "string (optional)"
        }
      },
      "response": {
        "deployments": [
          {
            "id": "string",
            "projectId": "string",
            "environmentId": "string",
            "status": "string",
            "createdAt": "datetime"
          }
        ]
      },
      "source_components": [
        "CMP-001"
      ],
      "source_metrics": null
    },
    {
      "id": "IF-007",
      "name": "全局项目切换器",
      "description": "一个 UI 组件，用于全局切换当前选中的项目。它没有直接的 API 调用，但影响其他所有接口的 projectId 上下文。",
      "method": "UI",
      "endpoint": "N/A (UI component)",
      "consumed_contract": "N/A",
      "source_components": [
        "CMP-001"
      ],
      "state_management": "全局状态 ProjectContextModel (DM-002)",
      "source_metrics": null
    }
  ],
  "business_rules": {
    "BR-001": {
      "rule_id": "BR-001",
      "description": "用户必须先登录才能访问除登录页外的任何页面",
      "type": "access_control",
      "invariants": [
        "未登录用户访问受保护页面时，必须重定向到登录页",
        "已登录用户访问登录页时，应重定向到主页"
      ],
      "related_interfaces": ["IF-001"],
      "enforcement": "前端路由守卫"
    },
    "BR-002": {
      "rule_id": "BR-002",
      "description": "创建一个项目后，项目列表必须立即更新",
      "type": "data_consistency",
      "invariants": [
        "新增项目成功后，本地项目状态必须刷新",
        "删除项目成功后，本地项目状态必须刷新"
      ],
      "related_interfaces": ["IF-002"],
      "enforcement": "操作后重新获取列表"
    },
    "BR-003": {
      "rule_id": "BR-003",
      "description": "部署操作需要选择项目和文件，且文件大小不能超过限制",
      "type": "validation",
      "invariants": [
        "未选择项目时，部署按钮不可用",
        "文件大小超过 50MB 时，必须显示错误提示"
      ],
      "related_interfaces": ["IF-004"],
      "enforcement": "前端表单验证"
    },
    "BR-004": {
      "rule_id": "BR-004",
      "description": "实时日志窗口必须滚动到最新条目",
      "type": "usability",
      "invariants": [
        "新日志条目到达时，自动滚动到底部",
        "用户手动上滑后，停止自动滚动，直到用户滑回底部"
      ],
      "related_interfaces": ["IF-005"],
      "enforcement": "前端组件行为"
    }
  },
  "component_tree": {
    "App": {
      "description": "根组件，包含路由和全局提供者。",
      "children": [
        "AuthProvider",
        "ProjectProvider",
        "Router",
        {
          "Routes": [
            "/login: LoginPage",
            "/projects: ProjectListPage",
            "/environments: EnvironmentListPage",
            "/deploy: DeploymentPage",
            "/logs: LogPage",
            "/history: HistoryPage",
            "/: Redirect to /projects"
          ]
        }
      ]
    },
    "LoginPage": {
      "description": "用户登录表单页面。",
      "children": [
        "LoginForm (Ant Design Form)"
      ]
    },
    "ProjectListPage": {
      "description": "项目列表展示页面，包含增删改查功能。",
      "children": [
        "ProjectTable (Ant Design Table)",
        "AddProjectModal",
        "EditProjectModal",
        "DeleteProjectConfirm"
      ]
    },
    "EnvironmentListPage": {
      "description": "环境列表页面，依赖全局当前项目。",
      "children": [
        "EnvironmentTable (Ant Design Table)",
        "AddEnvironmentModal",
        "EditEnvironmentModal",
        "DeleteEnvironmentConfirm"
      ]
    },
    "DeploymentPage": {
      "description": "部署触发页面，包含文件上传。",
      "children": [
        "DeploymentForm (Ant Design Form)",
        "FileUpload (Ant Design Upload)",
        "DeployProgress (Ant Design Progress)"
      ]
    },
    "LogPage": {
      "description": "实时日志展示页面。",
      "children": [
        "LogList (Virtualized List)",
        "ConnectionStatus (Badge)"
      ]
    },
    "HistoryPage": {
      "description": "部署历史记录页面，带筛选。",
      "children": [
        "HistoryFilters (Ant Design Select, DatePicker)",
        "HistoryTable (Ant Design Table)"
      ]
    },
    "GlobalHeader": {
      "description": "包含全局项目切换器和用户信息。",
      "children": [
        "ProjectSwitcher (Ant Design Select)",
        "UserMenu (Ant Design Dropdown)"
      ]
    }
  },
  "route_design": {
    "router": "react-router-dom v6",
    "mode": "browser",
    "routes": [
      {
        "path": "/login",
        "component": "LoginPage",
        "auth_required": false
      },
      {
        "path": "/projects",
        "component": "ProjectListPage",
        "auth_required": true
      },
      {
        "path": "/environments",
        "component": "EnvironmentListPage",
        "auth_required": true
      },
      {
        "path": "/deploy",
        "component": "DeploymentPage",
        "auth_required": true
      },
      {
        "path": "/logs",
        "component": "LogPage",
        "auth_required": true
      },
      {
        "path": "/history",
        "component": "HistoryPage",
        "auth_required": true
      },
      {
        "path": "/",
        "redirect": "/projects"
      },
      {
        "path": "*",
        "component": "NotFoundPage"
      }
    ],
    "guards": [
      {
        "type": "auth",
        "description": "登录状态检查，未登录重定向到 /login"
      }
    ],
    "lazy_loading": true
  },
  "state_design": {
    "global_state": [
      {
        "model": "DM-001",
        "provider": "AuthProvider",
        "persistence": "localStorage (tokens only)"
      },
      {
        "model": "DM-002",
        "provider": "ProjectProvider",
        "persistence": "none (session only)"
      }
    ],
    "local_state": [
      {
        "page": "ProjectListPage",
        "model": "DM-003",
        "hook": "useState + useEffect"
      },
      {
        "page": "EnvironmentListPage",
        "model": "DM-004",
        "hook": "useState + useEffect"
      },
      {
        "page": "DeploymentPage",
        "model": "DM-005",
        "hook": "useState"
      },
      {
        "page": "LogPage",
        "model": "DM-006",
        "hook": "useState + useEffect (WebSocket)"
      },
      {
        "page": "HistoryPage",
        "model": "DM-007",
        "hook": "useState + useEffect"
      }
    ],
    "state_management_library": "React Context + useReducer for global; local useState"
  },
  "interaction_flows": {
    "login_flow": {
      "trigger": "用户在登录页提交表单",
      "steps": [
        "前端验证输入非空",
        "调用 IF-001 (POST /api/auth/login)",
        "成功后存储 token 到 DM-001，设置 isAuthenticated=true",
        "路由跳转到 /projects"
      ],
      "error_handling": {
        "401": "显示 '用户名或密码错误'",
        "network_error": "显示 '网络错误，请稍后重试'"
      }
    },
    "project_management_flow": {
      "trigger": "用户在项目页点击创建/编辑/删除",
      "steps": [
        "创建：打开模态框，填写信息，调用 POST /api/projects，成功后重新获取列表 (IF-002)",
        "编辑：打开预填充模态框，修改后调用 PUT /api/projects/:id，成功后刷新列表",
        "删除：弹出确认框，确认后调用 DELETE /api/projects/:id，成功后刷新列表"
      ],
      "error_handling": {
        "409": "显示 '项目名已存在'",
        "default": "显示后端返回的错误消息"
      }
    },
    "deployment_flow": {
      "trigger": "用户在部署页选择项目和文件并提交",
      "steps": [
        "前端验证文件大小 < 50MB",
        "调用 IF-004 (POST /api/deploy) 上传文件",
        "显示上传进度（Ant Design Upload 的 onChange）",
        "获取返回的 deploymentId，跳转到 /logs 并通过 WebSocket (IF-005) 订阅日志",
        "页面展示实时日志（自动滚动）",
        "部署完成后 WebSocket 发送完成事件，页面显示状态"
      ],
      "error_handling": {
        "413": "文件过大",
        "400": "表单验证错误"
      }
    },
    "history_flow": {
      "trigger": "用户访问部署历史页或更改筛选条件",
      "steps": [
        "调用 IF-006 (GET /api/deployments) 带 query 参数",
        "渲染表格，支持分页",
        "筛选条件变化时重新请求"
      ],
      "error_handling": {
        "default": "显示错误提示，允许重试"
      }
    }
  },
  "api_integration": {
    "http_client": {
      "library": "axios",
      "base_url": "https://api.example.com",
      "interceptors": {
        "request": "自动添加 Authorization 头从 DM-001 获取 accessToken",
        "response": "处理 401 刷新 token 或跳转登录"
      }
    },
    "websocket_client": {
      "library": "native WebSocket",
      "url": "wss://api.example.com/ws/logs",
      "reconnection": {
        "enabled": true,
        "max_attempts": 5,
        "interval": 3000
      }
    },
    "error_handling": {
      "global": {
        "strategy": "统一错误拦截器，对于非 401 错误使用 Ant Design message.error 显示后端消息，对于 401 自动刷新 token 或跳转登录",
        "fallback": "未知错误显示 '系统错误，请联系管理员'"
      },
      "local": "各页面根据业务需要处理特定状态码，如 404 显示空状态"
    }
  }
}