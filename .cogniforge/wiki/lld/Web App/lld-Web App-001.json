    "in_scope": [
      "用户登录/注册界面",
      "项目增删改查界面",
      "环境配置与密钥管理界面",
      "部署触发、文件上传与进度监控界面",
      "实时部署日志展示界面",
      "部署历史记录查看与筛选界面",
      "全局项目切换器"
    ],
    "out_of_scope": [
