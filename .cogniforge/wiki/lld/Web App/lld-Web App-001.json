  "overview": {
    "description": "基于 React 18 和 Ant Design 5 构建的单页面应用 (SPA)，作为整个系统的交互中枢，允许用户管理项目、配置环境、触发部署并实时监控部署进度与日志。",
    "dependencies": [
      "API Gateway"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design 5",
      "react-router-dom v6",
      "axios",
      "WebSocket"
    ]
  },
