  "module_boundary": {
    "in_scope": [
      "密钥派生 (PBKDF2)",
      "对称加密 (AES-256-CBC)",
      "对称解密 (AES-256-CBC)",
      "密码哈希生成与验证",
      "主密码的缓存管理",
      "内部解密接口 (env:decrypt)"
    ],
    "out_of_scope": [
      "主密码的 UI 输入与交互流程（属于 MasterPasswordService）",
      "持久化存储密钥或密码（安全性要求内存缓存）",
      "网络通信加密（属于 SSH 或其他层）",
      "非对称加密",
      "密钥轮换策略"
    ]
  },
  "overview": {
    "description": "CryptoService 提供底层的密码学操作，包括基于 PBKDF2 的密钥派生、AES-256-CBC 对称加解密、密码哈希生成与验证。所有操作均在内存中进行，不涉及持久化存储，确保主密码和派生密钥的安全。该服务作为基础设施模块，被上层业务逻辑调用。",
    "dependencies": [],
    "tech_stack": [
      "Node.js crypto 模块 (PBKDF2, AES-256-CBC)"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": [
        "CMP-014"
      ],
      "sad_contract_ids": [
        "CTR-006"
      ]
    }
  ],
  "topology": {
    "exchanges": [],
    "namespaces": [],
    "buckets": [
      {
        "name": "encryption",
        "description": "Bucket for encryption related resources"
      }
    ]
  },
  "data_models": [
    {
      "id": "DM-001",
      "name": "CipherPayload",
      "type": "struct",
      "description": "加密后的载荷结构体，包含密文、初始化向量和算法标识。",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "fields": [
        {
          "name": "cipherText",
          "type": "string",
          "required": true,
          "description": "Base64 编码的密文字符串"
        },
        {
          "name": "iv",
          "type": "string",
          "required": true,
          "description": "Base64 编码的初始化向量 (IV)"
        },
        {
          "name": "algorithm",
          "type": "string",
          "required": false,
          "description": "使用的加密算法标识，例如 'aes-256-cbc'，用于后续兼容性"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "lifecycle": {
        "create": "加密操作时创建",
        "update": "不可更新",
        "delete": "使用后即丢弃",
        "retention": "仅在内存中，不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-002",
      "name": "PBKDF2Params",
      "type": "struct",
      "description": "PBKDF2 密钥派生参数结构体，包含盐值、迭代次数、密钥长度和摘要算法。",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "fields": [
        {
          "name": "salt",
          "type": "string",
          "required": true,
          "description": "Base64 编码的盐值"
        },
        {
          "name": "iterations",
          "type": "number",
          "required": true,
          "description": "PBKDF2 迭代次数，例如 100000"
        },
        {
          "name": "keyLength",
          "type": "number",
          "required": true,
          "description": "派生密钥的字节长度，例如 32 (对应 256 位)"
        },
        {
          "name": "digest",
          "type": "string",
          "required": true,
          "description": "哈希算法，例如 'sha512'"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "lifecycle": {
        "create": "密钥派生时创建",
        "update": "不可更新",
        "delete": "使用后即丢弃",
        "retention": "仅在内存中，不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "DM-003",
      "name": "HashWithSalt",
      "type": "struct",
      "description": "密码哈希结果结构体，包含哈希值和盐值。",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "fields": [
        {
          "name": "hash",
          "type": "string",
          "required": true,
          "description": "Base64 编码的密码哈希值"
        },
        {
          "name": "salt",
          "type": "string",
          "required": true,
          "description": "Base64 编码的盐值"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "lifecycle": {
        "create": "密码哈希生成时创建",
        "update": "不可更新",
        "delete": "验证后即丢弃",
        "retention": "仅在内存中，不持久化"
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "IKeyDerivation",
      "type": "interface",
      "description": "密钥派生接口，根据密码和 PBKDF2 参数生成密钥。",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-006",
      "provider_component_id": "CMP-014",
      "method": "INTERNAL",
      "endpoint": "内部函数调用",
      "parameters": [
        {
          "name": "password",
          "type": "string",
          "required": true,
          "description": "用户提供的密码"
        },
        {
          "name": "params",
          "type": "PBKDF2Params",
          "required": true,
          "description": "密钥派生参数"
        }
      ],
      "response": {
        "body": {
          "type": "Buffer",
          "description": "派生的密钥"
        }
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-002",
      "name": "IEncryption",
      "type": "interface",
      "description": "对称加密接口，使用 AES-256-CBC 加密明文。",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-006",
      "provider_component_id": "CMP-014",
      "method": "INTERNAL",
      "endpoint": "内部函数调用",
      "parameters": [
        {
          "name": "key",
          "type": "Buffer",
          "required": true,
          "description": "加密密钥"
        },
        {
          "name": "plainText",
          "type": "string",
          "required": true,
          "description": "明文字符串"
        }
      ],
      "response": {
        "body": {
          "type": "CipherPayload",
          "description": "加密后的载荷"
        }
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-003",
      "name": "IDecryption",
      "type": "interface",
      "description": "对称解密接口，使用 AES-256-CBC 解密CipherPayload。",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-006",
      "provider_component_id": "CMP-014",
      "method": "INTERNAL",
      "endpoint": "内部函数调用",
      "parameters": [
        {
          "name": "key",
          "type": "Buffer",
          "required": true,
          "description": "解密密钥"
        },
        {
          "name": "payload",
          "type": "CipherPayload",
          "required": true,
          "description": "加密载荷"
        }
      ],
      "response": {
        "body": {
          "type": "string",
          "description": "解密后的明文字符串"
        }
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-004",
      "name": "IPasswordHash",
      "type": "interface",
      "description": "密码哈希接口，生成带盐值的哈希值。",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-006",
      "provider_component_id": "CMP-014",
      "method": "INTERNAL",
      "endpoint": "内部函数调用",
      "parameters": [
        {
          "name": "password",
          "type": "string",
          "required": true,
          "description": "明文密码"
        }
      ],
      "response": {
        "body": {
          "type": "HashWithSalt",
          "description": "哈希值与盐值"
        }
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    },
    {
      "id": "IF-005",
      "name": "IPasswordVerify",
      "type": "interface",
      "description": "密码验证接口，验证明文密码是否与哈希值匹配。",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-006",
      "provider_component_id": "CMP-014",
      "method": "INTERNAL",
      "endpoint": "内部函数调用",
      "parameters": [
        {
          "name": "password",
          "type": "string",
          "required": true,
          "description": "待验证的明文密码"
        },
        {
          "name": "hashWithSalt",
          "type": "HashWithSalt",
          "required": true,
          "description": "已存储的哈希值及盐值"
        }
      ],
      "response": {
        "body": {
          "type": "boolean",
          "description": "是否匹配"
        }
      },
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成 LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "集中式错误处理，所有加密操作错误均抛出异常，由上层捕获并转换为用户友好提示。",
    "errors": [
      {
        "code": "ERR_CRYPTO_INVALID_KEY",
        "message": "Invalid key provided."
      },
      {
        "code": "ERR_CRYPTO_DECRYPT_FAILED",
        "message": "Decryption failed due to invalid key or corrupted data."
      }
    ]
  },
  "lld_objects": [
    {
      "id": "OBJ-001",
      "name": "CryptoService",
      "type": "service",
      "description": "核心加密服务",
      "methods": [
        {
          "name": "deriveKey",
          "description": "根据密码和参数派生密钥",
          "signature": "deriveKey(password: string, params: PBKDF2Params): Buffer",
          "returns": {
            "type": "Buffer"
          },
          "errors": [
            "ERR_CRYPTO_INVALID_PARAMS"
          ]
        },
        {
          "name": "encrypt",
          "description": "使用 AES-256-CBC 加密明文",
          "signature": "encrypt(key: Buffer, plainText: string): CipherPayload",
          "returns": {
            "type": "CipherPayload"
          },
          "errors": [
            "ERR_CRYPTO_ENCRYPT_FAILED"
          ]
        },
        {
          "name": "decrypt",
          "description": "使用 AES-256-CBC 解密 CipherPayload",
          "signature": "decrypt(key: Buffer, payload: CipherPayload): string",
          "returns": {
            "type": "string"
          },
          "errors": [
            "ERR_CRYPTO_DECRYPT_FAILED",
            "ERR_CRYPTO_INVALID_KEY"
          ]
        },
        {
          "name": "hashPassword",
          "description": "生成密码的哈希值",
          "signature": "hashPassword(password: string): HashWithSalt",
          "returns": {
            "type": "HashWithSalt"
          },
          "errors": [
            "ERR_CRYPTO_HASH_FAILED"
          ]
        },
        {
          "name": "verifyPassword",
          "description": "验证密码与哈希值是否匹配",
          "signature": "verifyPassword(password: string, hashWithSalt: HashWithSalt): boolean",
          "returns": {
            "type": "boolean"
          },
          "errors": [
            "ERR_CRYPTO_VERIFY_FAILED"
          ]
        }
      ],
      "dependencies": []
    }
  ],
