  "error_handling": {
    "strategy": "网关采用GlobalFilter拦截所有请求异常，统一按错误类型分类处理。认证/授权错误由JwtAuthFilter在网关层直接拦截返回；下游服务返回的错误由网关透传并统一封装为标准响应格式；限流触发时由RequestRateLimiter过滤器直接返回429状态码；熔断器触发时返回503状态码。所有错误响应统一使用三层结构: code（业务码）、error（简短错误名）、detail（详细描述，生产环境可脱敏）。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "请求参数校验失败。网关对必需参数缺失、格式错误等直接返回400，不转发到下游服务。detail字段中说明具体哪个参数不合法。"
      },
      {
        "code": "401",
        "name": "认证失败",
        "description": "JWT令牌缺失、过期或无效。JwtAuthFilter在网关层直接拦截并返回401，响应头设置 WWW-Authenticate: Bearer。前端应捕获401并跳转至登录页或触发令牌刷新流程。"
      },
      {
        "code": "403",
        "name": "权限不足",
        "description": "JWT令牌有效但当前用户无权限访问目标资源或执行操作。网关层通过RBAC过滤器校验用户角色权限，校验失败时直接返回403，detail字段说明所需权限。"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "请求的目标资源不存在。网关本身的路由表找不到匹配路径时返回404；路由到下游服务后，下游服务返回的资源不存在错误由网关透传返回404。"
      },
      {
        "code": "409",
        "name": "资源冲突",
        "description": "创建或更新资源时发生唯一键冲突（如项目名称重复、密钥名称重复）。网关透传下游服务返回的409响应。"
      },
      {
        "code": "429",
        "name": "请求限流",
        "description": "请求频率超过接口限流阈值。由RequestRateLimiter过滤器在网关层直接返回429，响应头设置 Retry-After 建议重试时间（秒）。限流key按接口配置使用IP或用户ID维度。"
      },
      {
        "code": "500",
        "name": "下游服务内部错误",
        "description": "下游业务服务返回5xx错误时的统一透传。网关捕获下游服务HTTP 500响应后封装为标准错误格式返回，detail字段下游服务错误信息在生产环境脱敏为 「服务内部错误，请稍后重试」。"
      },
      {
        "code": "502",
        "name": "网关代理错误",
        "description": "网关无法连接到下游服务（服务未注册或网络不可达）。网关直接返回502，detail为「目标服务不可达」，同时触发告警通知运维。"
      },
      {
        "code": "503",
        "name": "服务不可用（熔断）",
        "description": "下游服务连续超时或错误率超过阈值，熔断器（Spring Cloud Circuit Breaker）开启后直接返回503，detail为「服务暂不可用，请稍后重试」。熔断器进入半开状态后定期探测下游服务健康状态。"
      },
      {
        "code": "504",
        "name": "网关超时",
        "description": "请求转发到下游服务超过路由配置的超时时间（默认5000ms）。网关返回504，detail中注明超时的目标服务名和超时时间。"
      }
    ]
  }
}
