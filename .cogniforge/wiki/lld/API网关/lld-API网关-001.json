          "description": "string",
          "created_by": "string",
          "created_at": "datetime",
          "updated_at": "datetime",
          "environments": "array"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 404, "message": "项目不存在或已被删除"},
        {"code": 502, "message": "项目管理服务不可用或请求超时"}
      ]
    },
    {
