      "parameters": [
        {"name": "page", "type": "integer", "description": "页码，从1开始，默认1"},
        {"name": "page_size", "type": "integer", "description": "每页条数，默认20，最大100"},
        {"name": "name", "type": "string", "description": "项目名称模糊搜索关键字（可选）"},
        {"name": "created_by", "type": "string", "description": "创建人用户名精确筛选（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "total": "integer",
          "page": "integer",
          "page_size": "integer",
          "items": "array"
        }
      },
      "error_codes": [
        {"code": 400, "message": "参数校验失败"},
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 502, "message": "项目管理服务不可用或请求超时"}
      ]
    },
