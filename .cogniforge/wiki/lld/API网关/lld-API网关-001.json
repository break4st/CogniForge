    {
      "name": "健康检查",
      "method": "GET",
      "endpoint": "/api/v1/health",
      "description": "网关健康检查接口，返回网关自身运行状态。无需认证，可用于负载均衡器的健康探测",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "status": "string",
          "version": "string",
          "uptime_seconds": "integer"
        }
      },
      "error_codes": [
        {"code": 503, "message": "网关服务不可用（如 Redis 连接异常）"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "网关层统一捕获所有请求处理过程中的异常，按照标准化 JSON 格式返回错误响应。认证失败返回 401，权限不足返回 403，资源不存在返回 404，参数校验失败返回 400，资源冲突返回 409，频率限制返回 429，服务器内部错误返回 500。网关不泄露内部调用链路的细节错误信息，上游服务返回的 5xx 错误统一转换为网关层 502 或 500",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {"code": 400, "name": "参数校验错误", "description": "请求体缺少必要字段、字段格式不符合要求或路径参数类型错误时触发。detail 字段指明具体错误字段和原因"},
      {"code": 401, "name": "认证失败", "description": "未提供 Authorization 请求头、Token 格式无效、Token 已过期或被加入黑名单时触发。detail 指明具体原因"},
      {"code": 403, "name": "权限不足", "description": "当前用户角色不满足接口所需的角色权限时触发。由认证中间件在角色鉴权阶段拦截"},
      {"code": 404, "name": "资源不存在", "description": "请求的资源（项目、环境、密钥、部署任务）不存在时触发。网关透传上游服务的 404 响应"},
      {"code": 409, "name": "资源冲突", "description": "创建资源时唯一约束冲突、状态冲突导致操作无法执行时触发。detail 指明冲突原因"},
      {"code": 429, "name": "请求频率限制", "description": "超出限流策略允许的请求速率时触发。响应头携带 Retry-After 字段告知客户端等待时间"},
      {"code": 500, "name": "网关内部错误", "description": "网关自身逻辑异常、Redis 连接失败等不可预知的内部错误。记录详细错误日志后返回泛化信息"},
      {"code": 502, "name": "上游服务错误", "description": "上游业务服务返回非预期响应或连接超时。网关记录上游错误日志后统一转换为 502 返回客户端"}
    ]
  },
  "route_table": [
    {
      "path_pattern": "/api/v1/health",
      "upstream": "API网关（自处理）",
      "description": "健康检查，网关自行处理，不转发到上游"
    },
    {
      "path_pattern": "/api/v1/auth/login",
      "upstream": "API网关（自处理）",
      "description": "用户登录，网关自行完成密码校验和 Token 签发"
    },
    {
      "path_pattern": "/api/v1/auth/refresh",
      "upstream": "API网关（自处理）",
      "description": "Token 刷新，网关自行校验 refresh_token 并签发新 token"
    },
    {
      "path_pattern": "/api/v1/auth/logout",
      "upstream": "API网关（自处理）",
      "description": "用户登出，网关自行将 Token 加入黑名单"
    },
    {
      "path_pattern": "/api/v1/auth/me",
      "upstream": "API网关（自处理）",
      "description": "获取当前用户信息，网关从 Token 中提取返回"
    },
    {
      "path_pattern": "/api/v1/projects",
      "upstream": "项目管理服务",
      "description": "项目列表查询与创建，路由到项目管理服务"
    },
    {
      "path_pattern": "/api/v1/projects/:pid",
      "upstream": "项目管理服务",
      "description": "单个项目的查询、更新和删除，路由到项目管理服务"
    },
    {
      "path_pattern": "/api/v1/projects/:pid/environments",
      "upstream": "环境管理服务",
      "description": "环境下级资源的列表查询与创建，路由到环境管理服务"
    },
    {
      "path_pattern": "/api/v1/projects/:pid/environments/:eid",
      "upstream": "环境管理服务",
      "description": "单个环境的查询、更新和删除，路由到环境管理服务"
    },
    {
      "path_pattern": "/api/v1/environments/:eid/keys",
      "upstream": "密钥管理服务",
      "description": "SSH 密钥的绑定、列表查询，路由到密钥管理服务"
    },
    {
      "path_pattern": "/api/v1/environments/:eid/keys/:kid",
      "upstream": "密钥管理服务",
      "description": "单个 SSH 密钥的删除，路由到密钥管理服务"
    },
    {
      "path_pattern": "/api/v1/environments/:eid/test",
      "upstream": "环境管理服务",
      "description": "环境连通性测试，路由到环境管理服务"
    },
    {
      "path_pattern": "/api/v1/deploy",
      "upstream": "部署引擎服务",
      "description": "发起部署任务，路由到部署引擎服务"
    },
    {
      "path_pattern": "/api/v1/deploy/:taskId",
      "upstream": "部署引擎服务",
      "description": "部署任务详情查询，路由到部署引擎服务"
    },
    {
      "path_pattern": "/api/v1/deploy/:taskId/status",
      "upstream": "部署引擎服务",
      "description": "部署任务状态轮询，路由到部署引擎服务"
    },
    {
      "path_pattern": "/api/v1/deploy/:taskId/logs",
      "upstream": "部署引擎服务",
      "description": "部署日志查询，路由到部署引擎服务"
    },
    {
      "path_pattern": "/api/v1/deploy/:taskId/cancel",
      "upstream": "部署引擎服务",
      "description": "取消部署任务，路由到部署引擎服务"
    },
    {
      "path_pattern": "/api/v1/audit-logs",
      "upstream": "审计日志服务",
      "description": "审计日志列表查询，路由到审计日志服务"
    }
  ],
  "middleware_chain": [
    "Request → CORS → RequestLogger → Auth → RateLimiter → Router → Upstream → ResponseWrapper"
  ],
  "auth_policy": {
    "public_endpoints": ["/api/v1/auth/login", "POST /api/v1/auth/refresh", "GET /api/v1/health"],
    "auth_method": "JWT Bearer Token，Token 通过 Authorization 请求头传递，格式为 Bearer {access_token}。认证中间件自动校验 Token 有效性、过期时间和黑名单状态，校验通过后将用户身份注入请求上下文",
    "role_path_map": [
      {"path": "GET /api/v1/auth/me", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "POST /api/v1/auth/logout", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "GET /api/v1/projects", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "POST /api/v1/projects", "roles": ["admin", "pm"]},
      {"path": "GET /api/v1/projects/:pid", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "PUT /api/v1/projects/:pid", "roles": ["admin", "pm"]},
      {"path": "DELETE /api/v1/projects/:pid", "roles": ["admin", "pm"]},
      {"path": "GET /api/v1/projects/:pid/environments", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "POST /api/v1/projects/:pid/environments", "roles": ["admin", "ops"]},
      {"path": "GET /api/v1/projects/:pid/environments/:eid", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "PUT /api/v1/projects/:pid/environments/:eid", "roles": ["admin", "ops"]},
      {"path": "DELETE /api/v1/projects/:pid/environments/:eid", "roles": ["admin", "ops"]},
      {"path": "GET /api/v1/environments/:eid/keys", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "POST /api/v1/environments/:eid/keys", "roles": ["admin", "ops"]},
      {"path": "DELETE /api/v1/environments/:eid/keys/:kid", "roles": ["admin", "ops"]},
      {"path": "GET /api/v1/environments/:eid/test", "roles": ["admin", "ops"]},
      {"path": "POST /api/v1/deploy", "roles": ["admin", "ops", "dev"]},
      {"path": "GET /api/v1/deploy/:taskId", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "GET /api/v1/deploy/:taskId/status", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "GET /api/v1/deploy/:taskId/logs", "roles": ["admin", "pm", "ops", "dev"]},
      {"path": "POST /api/v1/deploy/:taskId/cancel", "roles": ["admin", "pm", "ops"]},
      {"path": "GET /api/v1/audit-logs", "roles": ["admin", "pm"]}
    ],
    "token_expiry": "access_token 2 小时，refresh_token 7 天。access_token 过期后可使用 refresh_token 通过 /api/v1/auth/refresh 接口刷新，refresh_token 过期后需要重新登录。Token 可通过登出操作即时加入 Redis 黑名单撤销"
  },
  "rate_limiting": {
    "global": "每 IP 100 req/s，超出返回 429。全局限流在 CORS 中间件之后、Auth 中间件之前执行，对所有请求（包括公开端点）生效",
    "per_user": "每用户 1000 req/min，基于用户 ID 维度统计。超出返回 429 并在响应头携带 Retry-After 字段。用户维度限流在 Auth 中间件解析身份后执行，仅对已认证请求生效",
    "special_endpoints": [
      {"endpoint": "POST /api/v1/auth/login", "limit": "每 IP 5 req/min，防止暴力破解"},
      {"endpoint": "POST /api/v1/deploy", "limit": "每用户 10 req/min，防止重复提交部署请求"},
      {"endpoint": "GET /api/v1/deploy/:taskId/status", "limit": "每用户 60 req/min，轮询场景允许更高频率"},
      {"endpoint": "GET /api/v1/audit-logs", "limit": "每用户 30 req/min"}
    ]
  }
}
