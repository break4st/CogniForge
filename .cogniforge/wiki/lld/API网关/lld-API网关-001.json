{
  "meta": {
    "doc_id": "lld-API网关-001",
    "type": "lld",
    "module_type": "ModuleType.GATEWAY",
    "module": "API网关",
    "title": "LLD - API网关",
    "author": "design_agent",
    "created": "2026-05-21 11:00"
  },
  "overview": {
    "description": "基于Spring Cloud Gateway构建的统一API入口，作为系统所有外部请求的唯一接入点。负责将前端HTTP/WebSocket请求按路由规则转发至对应的业务服务，并在转发前完成JWT令牌校验、RBAC权限校验、接口级限流与熔断保护、全量请求日志记录。对外暴露统一REST API契约和WebSocket端点，对下游服务通过服务发现进行负载均衡路由。",
    "dependencies": [
      "项目管理服务",
      "环境管理服务",
      "密钥管理服务",
      "部署编排服务",
      "审计服务",
      "Redis"
    ],
    "tech_stack": [
      "Java 17",
      "Spring Boot 3.x + Spring Cloud",
      "Spring Cloud Gateway",
      "Redis 7.x"
    ]
  },
  "data_models": [
    {
      "name": "RouteRule",
      "type": "config",
      "ownership": "owned",
      "description": "网关路由规则表，定义外部请求到下游服务的映射关系，每条规则包含路由ID、目标服务名、路径断言、过滤器链和熔断配置。配置存储在网关自身配置文件中（application.yml / Nacos），运行时由Spring Cloud Gateway路由表加载。",
      "fields": [
        {"name": "id", "type": "string", "required": true, "description": "路由规则唯一标识，格式为 route_{service}_{serial}"},
        {"name": "target_service", "type": "string", "required": true, "description": "下游目标服务名（如 project-service, environment-service, key-service, deployment-service, audit-service）"},
        {"name": "path_pattern", "type": "string", "required": true, "description": "路径匹配表达式（如 /api/projects/**）"},
        {"name": "methods", "type": "Array<string>", "required": false, "description": "允许的HTTP方法列表，为空表示允许所有方法"},
        {"name": "filters", "type": "Array<string>", "required": false, "description": "应用到此路由的过滤器链（如 JwtAuthFilter, RateLimitFilter, RequestLogFilter）"},
        {"name": "circuit_breaker_enabled", "type": "boolean", "required": true, "description": "是否启用熔断保护"},
        {"name": "timeout_ms", "type": "integer", "required": false, "description": "转发超时时间（毫秒），默认5000"}
      ]
    },
    {
      "name": "RateLimitConfig",
      "type": "config",
      "ownership": "owned",
      "description": "接口级限流配置，基于Redis + RequestRateLimiter过滤器实现令牌桶算法。每条配置针对一个路由或一组API定义QPS上限和突发流量容量，运行时从Redis加载或通过配置中心动态更新。",
      "fields": [
        {"name": "route_id", "type": "string", "required": true, "description": "关联的路由规则ID"},
        {"name": "replenish_rate", "type": "integer", "required": true, "description": "令牌桶补充速率（每秒补充的令牌数），对应稳定QPS上限"},
        {"name": "burst_capacity", "type": "integer", "required": true, "description": "令牌桶容量，对应突发流量的最大QPS"},
        {"name": "key_resolver", "type": "string", "required": true, "description": "限流key解析策略（IP / USER / URL），用于区分不同的限流维度"},
        {"name": "enabled", "type": "boolean", "required": true, "description": "是否启用限流"}
      ]
    },
    {
      "name": "AuthWhitelist",
      "type": "config",
      "ownership": "owned",
      "description": "认证白名单配置，定义无需JWT令牌校验即可公开访问的路径列表（如登录接口、静态资源等）。配置存储在网关配置文件中，启动时加载到JwtAuthFilter的跳过列表。",
      "fields": [
        {"name": "path_pattern", "type": "string", "required": true, "description": "无需认证的路径匹配表达式（如 /api/auth/login, /api/auth/refresh, /actuator/health）"},
        {"name": "description", "type": "string", "required": false, "description": "白名单条目说明"}
      ]
    },
    {
      "name": "AccessLog",
      "type": "store",
      "ownership": "owned",
      "description": "网关请求访问日志记录，每次经过网关的请求将被结构化记录。日志通过Spring Cloud Gateway的GlobalFilter采集，异步写入日志文件或发送到审计服务持久化。",
      "fields": [
        {"name": "trace_id", "type": "string", "required": true, "description": "全链路追踪ID（UUID），跨服务传递用于日志关联"},
        {"name": "method", "type": "string", "required": true, "description": "HTTP请求方法"},
        {"name": "path", "type": "string", "required": true, "description": "请求路径"},
        {"name": "query_params", "type": "string", "required": false, "description": "URL查询参数（JSON格式）"},
        {"name": "user_id", "type": "integer", "required": false, "description": "经过认证的用户ID，未认证请求为空"},
        {"name": "username", "type": "string", "required": false, "description": "经过认证的用户名"},
        {"name": "source_ip", "type": "string", "required": true, "description": "客户端IP地址"},
        {"name": "user_agent", "type": "string", "required": false, "description": "客户端User-Agent"},
        {"name": "target_service", "type": "string", "required": true, "description": "路由目标服务名称"},
        {"name": "request_body", "type": "text", "required": false, "description": "请求体内容（可截断，最大4KB）"},
        {"name": "response_status", "type": "integer", "required": true, "description": "响应HTTP状态码"},
        {"name": "response_body", "type": "text", "required": false, "description": "响应体内容（可截断，最大4KB）"},
        {"name": "duration_ms", "type": "integer", "required": true, "description": "请求处理耗时（毫秒）"},
        {"name": "timestamp", "type": "datetime", "required": true, "description": "请求时间"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "用户登录",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "description": "用户登录认证接口（白名单路径，无需JWT令牌）。网关直接处理登录请求，校验用户名密码后签发JWT访问令牌（access_token）和刷新令牌（refresh_token）。登录成功后返回令牌和用户基本信息。",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码（明文传输，建议后续启用HTTPS加密）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "message": "string",
          "data.access_token": "string",
          "data.refresh_token": "string",
          "data.token_type": "string",
          "data.expires_in": "integer",
          "data.user.id": "integer",
          "data.user.username": "string",
          "data.user.role": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数缺失（username 或 password 为空）"},
        {"code": 401, "message": "用户名或密码错误"}
      ]
    },
    {
      "name": "令牌刷新",
      "method": "POST",
      "endpoint": "/api/auth/refresh",
      "description": "刷新JWT访问令牌（白名单路径，无需JWT令牌）。使用refresh_token换取新的access_token，原refresh_token同时失效。",
      "parameters": [
        {"name": "refresh_token", "type": "string", "description": "登录时下发的刷新令牌"}
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "message": "string",
          "data.access_token": "string",
          "data.refresh_token": "string",
          "data.token_type": "string",
          "data.expires_in": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "refresh_token 参数缺失"},
        {"code": 401, "message": "刷新令牌无效或已过期"}
      ]
    },
    {
      "name": "获取当前用户",
      "method": "GET",
      "endpoint": "/api/auth/current-user",
      "description": "获取当前登录用户的基本信息和权限。网关从JWT令牌中解析用户信息并返回，不向下游服务转发。",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "message": "string",
          "data.id": "integer",
          "data.username": "string",
          "data.role": "string",
          "data.permissions": "Array<string>"
        }
      },
      "error_codes": [
        {"code": 401, "message": "JWT令牌缺失或已过期"}
      ]
    },
    {
      "name": "用户退出登录",
      "method": "POST",
      "endpoint": "/api/auth/logout",
      "description": "用户退出登录，将当前JWT令牌加入黑名单（Redis），使令牌立即失效。",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "JWT令牌缺失或已过期"}
      ]
    },
    {
      "name": "项目列表查询",
      "method": "GET",
      "endpoint": "/api/projects",
      "description": "分页查询当前用户可见的项目列表。网关校验JWT和权限后路由到项目管理服务（routes_to: 项目管理服务）。支持按关键字模糊搜索和分页参数。",
      "parameters": [
        {"name": "keyword", "type": "string", "description": "搜索关键字（匹配项目名称），可选"},
        {"name": "page", "type": "integer", "description": "页码，从1开始，默认1"},
        {"name": "size", "type": "integer", "description": "每页条数，默认20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "message": "string",
          "data.items": "Array<object>",
          "data.total": "integer",
          "data.page": "integer",
          "data.size": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "参数校验失败（page/size 格式错误）"},
        {"code": 401, "message": "JWT令牌缺失或已过期"},
        {"code": 403, "message": "无权限访问项目列表"}
      ]
    },
    {
