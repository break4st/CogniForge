{
  "meta": {
    "doc_id": "lld-API网关-001",
    "type": "lld",
    "module_type": "gateway",
    "module": "API网关",
    "title": "API网关详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "REST API 统一入口，负责请求路由、认证鉴权、请求校验和响应封装。作为系统接入层核心组件，所有客户端请求必须经过网关转发到对应业务服务",
    "dependencies": ["Redis 7"],
    "tech_stack": ["Go", "Gin", "Go 1.22+", "Redis 7", "RESTful JSON API"]
  },
  "data_models": [
    {
      "name": "RouteRule",
      "type": "config",
      "ownership": "owned",
      "description": "路由规则定义，描述请求路径到上游服务的映射关系。由网关启动时加载，支持热更新",
      "fields": [
        {"name": "id", "type": "string", "required": true, "description": "路由规则唯一标识"},
        {"name": "path_pattern", "type": "string", "required": true, "description": "请求路径匹配模式，支持 :param 和 * 通配符"},
        {"name": "methods", "type": "[]string", "required": true, "description": "允许的 HTTP 方法列表，空数组表示匹配所有方法"},
        {"name": "upstream_service", "type": "string", "required": true, "description": "目标上游服务名称"},
        {"name": "strip_prefix", "type": "string", "required": false, "description": "转发时移除的路径前缀"},
        {"name": "auth_required", "type": "boolean", "required": true, "description": "是否需要认证"},
        {"name": "rate_limit_profile", "type": "string", "required": false, "description": "限流策略配置名称"}
      ]
    },
    {
      "name": "RateLimitProfile",
      "type": "config",
      "ownership": "owned",
      "description": "限流策略配置，定义接口级别的请求频率限制规则，底层基于 Redis + 滑动窗口算法实现",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "限流策略唯一名称"},
        {"name": "global_req_per_sec", "type": "integer", "required": true, "description": "全局每秒最大请求数"},
        {"name": "per_user_req_per_min", "type": "integer", "required": true, "description": "每用户每分钟最大请求数"},
        {"name": "per_ip_req_per_sec", "type": "integer", "required": true, "description": "每 IP 每秒最大请求数"},
        {"name": "burst_size", "type": "integer", "required": true, "description": "突发流量允许的额外请求数"},
        {"name": "window_seconds", "type": "integer", "required": true, "description": "滑动窗口时间窗口大小（秒）"}
      ]
    },
    {
      "name": "AuthTokenPayload",
      "type": "struct",
      "ownership": "owned",
      "description": "JWT Token 载荷结构，编码在 access_token 和 refresh_token 中",
      "fields": [
        {"name": "user_id", "type": "integer", "required": true, "description": "用户唯一标识"},
        {"name": "username", "type": "string", "required": true, "description": "用户登录名"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色（ops/dev/pm）"},
        {"name": "token_id", "type": "string", "required": true, "description": "Token 唯一标识，用于黑名单撤销"},
        {"name": "issued_at", "type": "integer", "required": true, "description": "Token 签发时间（Unix 时间戳）"},
        {"name": "expires_at", "type": "integer", "required": true, "description": "Token 过期时间（Unix 时间戳）"}
      ]
    },
    {
      "name": "UserContext",
      "type": "struct",
      "ownership": "owned",
      "description": "认证通过后注入请求上下文中的用户信息，供下游中间件和路由处理器使用",
      "fields": [
        {"name": "user_id", "type": "integer", "required": true, "description": "用户 ID"},
        {"name": "username", "type": "string", "required": true, "description": "用户名"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色"},
        {"name": "token_id", "type": "string", "required": true, "description": "当前会话的 Token ID"}
      ]
    },
    {
      "name": "ApiResponse",
      "type": "struct",
      "ownership": "owned",
      "description": "统一 API 响应包装结构，所有成功响应以此格式返回。data 字段承载业务数据",
      "fields": [
        {"name": "code", "type": "integer", "required": true, "description": "业务状态码，200 表示成功"},
        {"name": "message", "type": "string", "required": true, "description": "响应消息"},
        {"name": "data", "type": "object", "required": false, "description": "业务数据负载"},
        {"name": "request_id", "type": "string", "required": true, "description": "请求追踪 ID，用于问题排查"},
        {"name": "timestamp", "type": "integer", "required": true, "description": "响应时间戳（Unix 毫秒）"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "用户登录",
      "method": "POST",
      "endpoint": "/api/v1/auth/login",
      "description": "用户登录认证。网关自行处理，验证用户名密码后签发 JWT access_token 和 refresh_token，并将会话缓存至 Redis",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码（明文传输，由 HTTPS 保证传输安全）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string",
          "refresh_token": "string",
          "token_type": "string",
          "expires_in": "integer",
          "user": {
            "id": "integer",
            "username": "string",
            "role": "string"
          }
        }
      },
      "error_codes": [
        {"code": 401, "message": "用户名或密码错误"},
        {"code": 429, "message": "登录请求过于频繁，请稍后重试"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "刷新 Token",
      "method": "POST",
      "endpoint": "/api/v1/auth/refresh",
      "description": "使用 refresh_token 换取新的 access_token。网关自行处理，校验 refresh_token 有效性后签发新 token",
      "parameters": [
        {"name": "refresh_token", "type": "string", "description": "登录时下发的 refresh_token"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string",
          "refresh_token": "string",
          "token_type": "string",
          "expires_in": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "refresh_token 无效或已过期"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "用户登出",
      "method": "POST",
      "endpoint": "/api/v1/auth/logout",
      "description": "用户登出，将当前 access_token 加入 Redis 黑名单，使其立即失效。需要 Bearer Token 认证",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取当前用户信息",
      "method": "GET",
      "endpoint": "/api/v1/auth/me",
      "description": "获取当前登录用户的基本信息和角色。网关自行处理，从 Token 中提取用户信息返回",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "user_id": "integer",
          "username": "string",
          "role": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token 或 Token 已过期"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "创建项目",
      "method": "POST",
      "endpoint": "/api/v1/projects",
      "description": "创建新项目。路由到上游服务：项目管理服务（routes_to: 项目管理服务）",
      "parameters": [
        {"name": "name", "type": "string", "description": "项目名称，1-255 字符"},
        {"name": "identifier", "type": "string", "description": "项目标识符，全局唯一，仅允许字母数字下划线连字符"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "name": "string",
          "identifier": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数无效（name 或 identifier 为空或格式错误）"},
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 409, "message": "identifier 已存在，项目标识符必须全局唯一"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取项目列表",
      "method": "GET",
      "endpoint": "/api/v1/projects",
      "description": "获取当前用户可访问的所有项目列表。路由到上游服务：项目管理服务（routes_to: 项目管理服务）",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "projects": "array<object>",
          "total": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取项目详情",
      "method": "GET",
      "endpoint": "/api/v1/projects/:pid",
      "description": "获取指定项目的详细信息。路由到上游服务：项目管理服务（routes_to: 项目管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "identifier": "string",
          "description": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 404, "message": "项目不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "更新项目信息",
      "method": "PUT",
      "endpoint": "/api/v1/projects/:pid",
      "description": "更新指定项目的信息。路由到上游服务：项目管理服务（routes_to: 项目管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"},
        {"name": "name", "type": "string", "description": "项目名称（可选，为空表示不更新）"},
        {"name": "identifier", "type": "string", "description": "项目标识符（可选，为空表示不更新）"},
        {"name": "description", "type": "string", "description": "项目描述（可选，为空表示不更新）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "name": "string",
          "identifier": "string",
          "description": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数无效"},
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 403, "message": "权限不足，仅项目经理可执行此操作"},
        {"code": 404, "message": "项目不存在"},
        {"code": 409, "message": "identifier 与已有项目冲突"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "删除项目",
      "method": "DELETE",
      "endpoint": "/api/v1/projects/:pid",
      "description": "删除指定项目。路由到上游服务：项目管理服务（routes_to: 项目管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 403, "message": "权限不足，仅项目经理可执行此操作"},
        {"code": 404, "message": "项目不存在"},
        {"code": 409, "message": "项目下存在关联的环境或运行中的部署任务，无法删除"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "创建环境",
      "method": "POST",
      "endpoint": "/api/v1/projects/:pid/environments",
      "description": "为指定项目创建新的部署环境。路由到上游服务：环境管理服务（routes_to: 环境管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"},
        {"name": "name", "type": "string", "description": "环境名称（如：测试线、灰度线、正式线）"},
        {"name": "server_host", "type": "string", "description": "目标服务器 IP 地址或域名"},
        {"name": "server_port", "type": "integer", "description": "SSH 端口号，默认 22"},
        {"name": "description", "type": "string", "description": "环境描述（可选）"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数无效（name、server_host 为空或格式错误）"},
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 403, "message": "权限不足，仅运维人员可执行此操作"},
        {"code": 404, "message": "项目不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取环境列表",
      "method": "GET",
      "endpoint": "/api/v1/projects/:pid/environments",
      "description": "获取指定项目的所有环境列表。路由到上游服务：环境管理服务（routes_to: 环境管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "environments": "array<object>",
          "total": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 404, "message": "项目不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取环境详情",
      "method": "GET",
      "endpoint": "/api/v1/projects/:pid/environments/:eid",
      "description": "获取指定环境的详细信息，包括连接参数和状态。路由到上游服务：环境管理服务（routes_to: 环境管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"},
        {"name": "eid", "type": "integer", "description": "环境 ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "status": "string",
          "key_bound": "boolean",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 404, "message": "环境不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "更新环境",
      "method": "PUT",
      "endpoint": "/api/v1/projects/:pid/environments/:eid",
      "description": "更新指定环境的配置信息。路由到上游服务：环境管理服务（routes_to: 环境管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"},
        {"name": "eid", "type": "integer", "description": "环境 ID，路径参数"},
        {"name": "name", "type": "string", "description": "环境名称（可选）"},
        {"name": "server_host", "type": "string", "description": "服务器地址（可选）"},
        {"name": "server_port", "type": "integer", "description": "SSH 端口（可选）"},
        {"name": "description", "type": "string", "description": "环境描述（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "status": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数无效"},
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 403, "message": "权限不足，仅运维人员可执行此操作"},
        {"code": 404, "message": "环境不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "删除环境",
      "method": "DELETE",
      "endpoint": "/api/v1/projects/:pid/environments/:eid",
      "description": "删除指定环境及其关联配置。路由到上游服务：环境管理服务（routes_to: 环境管理服务）",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目 ID，路径参数"},
        {"name": "eid", "type": "integer", "description": "环境 ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 403, "message": "权限不足，仅运维人员可执行此操作"},
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "环境下存在活跃的部署任务，无法删除"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "绑定 SSH 密钥",
      "method": "POST",
      "endpoint": "/api/v1/environments/:eid/keys",
      "description": "上传 SSH 密钥并与指定环境绑定。路由到上游服务：密钥管理服务（routes_to: 密钥管理服务）",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境 ID，路径参数"},
        {"name": "key_name", "type": "string", "description": "密钥名称，用于标识"},
        {"name": "private_key", "type": "string", "description": "SSH 私钥内容（PEM 格式）"},
        {"name": "passphrase", "type": "string", "description": "私钥加密口令，无私钥加密则传空字符串"}
      ],
      "response": {
        "status": 200,
        "body": {
          "key_id": "integer",
          "environment_id": "integer",
          "fingerprint": "string",
          "bound_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数无效（私钥格式错误或密钥名为空）"},
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 403, "message": "权限不足，仅运维人员可执行此操作"},
        {"code": 404, "message": "环境不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取密钥列表",
      "method": "GET",
      "endpoint": "/api/v1/environments/:eid/keys",
      "description": "获取指定环境已绑定的所有 SSH 密钥列表。路由到上游服务：密钥管理服务（routes_to: 密钥管理服务）",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境 ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "keys": "array<object>",
          "total": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 404, "message": "环境不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "删除 SSH 密钥",
      "method": "DELETE",
      "endpoint": "/api/v1/environments/:eid/keys/:kid",
      "description": "删除指定环境下绑定的 SSH 密钥。路由到上游服务：密钥管理服务（routes_to: 密钥管理服务）",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境 ID，路径参数"},
        {"name": "kid", "type": "integer", "description": "密钥 ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 403, "message": "权限不足，仅运维人员可执行此操作"},
        {"code": 404, "message": "密钥不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "测试环境连接",
      "method": "GET",
      "endpoint": "/api/v1/environments/:eid/test",
