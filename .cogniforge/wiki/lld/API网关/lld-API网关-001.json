{
  "meta": {
    "doc_id": "lld-API网关-001",
    "type": "lld",
    "module": "API网关",
    "title": "LLD - API网关",
    "author": "design_agent",
    "created": "2026-05-20 16:28"
  },
  "overview": {
    "description": "API网关是CogniForge系统的统一入口层，部署于Web管理控制台与后端业务服务之间，负责处理所有外部HTTP请求。核心功能包括：用户身份认证（JWT令牌颁发与校验）、接口级权限校验、请求路由和负载均衡、流量控制（滑动窗口限流）、操作日志记录。作为系统边界守卫，API网关对前端屏蔽后端服务拓扑细节，提供统一的认证鉴权和请求入口。",
    "dependencies": ["项目管理服务", "环境管理服务", "部署编排服务"],
    "tech_stack": ["Go", "Gin/Go HTTP Router", "JWT", "Redis（令牌黑名单/限流计数器）", "MySQL（用户/日志）", "Prometheus（请求指标）"]
  },
  "data_models": [
    {
      "name": "sys_user",
      "type": "table",
      "description": "系统用户账号表，存储用户认证信息和角色",
      "fields": [
        {"name": "id", "type": "int", "required": true, "description": "主键，自增用户ID"},
        {"name": "username", "type": "string", "required": true, "description": "用户名，唯一索引"},
        {"name": "password_hash", "type": "string", "required": true, "description": "密码哈希值（bcrypt）"},
        {"name": "role", "type": "string", "required": true, "description": "用户角色：admin/developer/viewer"},
        {"name": "status", "type": "string", "required": true, "description": "用户状态：active/disabled"},
        {"name": "created_at", "type": "datetime", "required": true, "description": "创建时间"},
        {"name": "updated_at", "type": "datetime", "required": true, "description": "更新时间"}
      ]
    },
    {
      "name": "api_route_config",
      "type": "config",
      "description": "API路由配置表，定义请求到后端服务的映射规则",
      "fields": [
        {"name": "route_id", "type": "int", "required": true, "description": "路由规则ID"},
        {"name": "path", "type": "string", "required": true, "description": "请求路径模式（支持{param}占位符）"},
        {"name": "method", "type": "string", "required": true, "description": "HTTP方法：GET/POST/PUT/DELETE"},
        {"name": "target_service", "type": "string", "required": true, "description": "目标后端服务名称"},
        {"name": "target_path", "type": "string", "required": true, "description": "目标后端服务路径"},
        {"name": "auth_required", "type": "bool", "required": true, "description": "是否需要认证"},
        {"name": "rate_limit", "type": "int", "required": true, "description": "限流阈值（次/分钟）"}
      ]
    },
    {
      "name": "rate_limit_config",
      "type": "config",
      "description": "流量控制规则配置，基于Redis滑动窗口计数器实现限流",
      "fields": [
        {"name": "rule_id", "type": "int", "required": true, "description": "限流规则ID"},
        {"name": "route_pattern", "type": "string", "required": true, "description": "匹配的路由路径模式"},
        {"name": "max_requests", "type": "int", "required": true, "description": "时间窗口内最大请求数"},
        {"name": "window_seconds", "type": "int", "required": true, "description": "时间窗口大小（秒）"},
        {"name": "enabled", "type": "bool", "required": true, "description": "规则是否启用"}
      ]
    },
    {
      "name": "access_log",
      "type": "table",
      "description": "API访问日志表，记录所有经过网关的请求信息",
      "fields": [
        {"name": "id", "type": "int", "required": true, "description": "主键，自增日志ID"},
        {"name": "user_id", "type": "int", "required": false, "description": "操作用户ID（未认证请求为null）"},
        {"name": "path", "type": "string", "required": true, "description": "请求路径"},
        {"name": "method", "type": "string", "required": true, "description": "HTTP方法"},
        {"name": "ip", "type": "string", "required": true, "description": "客户端IP地址"},
        {"name": "status_code", "type": "int", "required": true, "description": "响应状态码"},
        {"name": "latency_ms", "type": "int", "required": true, "description": "请求处理耗时（毫秒）"},
        {"name": "request_time", "type": "datetime", "required": true, "description": "请求时间"},
        {"name": "user_agent", "type": "string", "required": false, "description": "客户端User-Agent"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "用户登录",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "description": "用户登录认证，验证用户名和密码，认证成功返回JWT访问令牌",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"}
      ],
      "response": {
        "status": 200,
        "body": {
          "token": "string（JWT令牌）",
          "user": "object（{id:int, username:string, role:string}）"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数缺失（用户名或密码为空）"},
        {"code": 401, "message": "用户名或密码错误"},
        {"code": 429, "message": "登录频率过高，请稍后重试"}
      ]
    },
    {
      "name": "用户登出",
      "method": "POST",
      "endpoint": "/api/auth/logout",
      "description": "用户登出，将当前JWT令牌加入Redis黑名单使其立即失效",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌，格式：Bearer <token>"}
      ],
      "response": {
        "status": 200,
        "body": {
          "message": "string（登出成功提示）"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证令牌"}
      ]
    },
    {
      "name": "获取当前用户信息",
      "method": "GET",
      "endpoint": "/api/auth/current-user",
      "description": "获取当前登录用户的基本信息和角色",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "int",
          "username": "string",
          "role": "string",
          "status": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或令牌已过期"}
      ]
    },
    {
      "name": "健康检查",
      "method": "GET",
      "endpoint": "/api/health",
      "description": "网关及后端服务健康状态检查，返回各依赖服务的连通性",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "status": "string（ok/degraded/down）",
          "services": "object（{service_name: status}）"
        }
      },
      "error_codes": [
        {"code": 503, "message": "网关或后端服务不可用"}
      ]
    },
    {
      "name": "创建项目",
      "method": "POST",
      "endpoint": "/api/projects",
      "description": "创建新项目（路由至项目管理服务），需认证且具有developer及以上权限",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌"},
        {"name": "name", "type": "string", "description": "项目名称"},
        {"name": "description", "type": "string", "description": "项目描述"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 403, "message": "权限不足，需要developer及以上角色"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "查询项目列表",
      "method": "GET",
      "endpoint": "/api/projects",
      "description": "分页查询项目列表（路由至项目管理服务），需认证",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌"},
        {"name": "page", "type": "int", "description": "页码，从1开始"},
        {"name": "page_size", "type": "int", "description": "每页条数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array<object>",
          "total": "int",
          "page": "int"
        }
      },
      "error_codes": [
        {"code": 400, "message": "分页参数不合法"},
        {"code": 401, "message": "未认证"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "创建部署环境",
      "method": "POST",
      "endpoint": "/api/environments",
      "description": "创建部署环境并配置SSH连接信息（路由至环境管理服务），需认证且具有developer及以上权限",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌"},
        {"name": "project_id", "type": "int", "description": "所属项目ID"},
        {"name": "name", "type": "string", "description": "环境名称"},
        {"name": "type", "type": "string（test/staging/production）", "description": "环境类型"},
        {"name": "host", "type": "string", "description": "服务器主机地址"},
        {"name": "port", "type": "int", "description": "SSH端口号"},
        {"name": "ssh_key", "type": "string（加密传输）", "description": "SSH私钥内容"},
        {"name": "username", "type": "string", "description": "SSH登录用户名"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "int",
          "name": "string",
          "type": "string",
          "host": "string",
          "port": "int",
          "status": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败或环境类型不合法"},
        {"code": 401, "message": "未认证"},
        {"code": 403, "message": "权限不足"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "触发部署",
      "method": "POST",
      "endpoint": "/api/deployments",
      "description": "触发一键部署任务（路由至部署编排服务），需认证且具有developer及以上权限",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌"},
        {"name": "project_id", "type": "int", "description": "项目ID"},
        {"name": "environment_id", "type": "int", "description": "目标环境ID"},
        {"name": "version", "type": "string", "description": "部署版本号"},
        {"name": "file_url", "type": "string", "description": "部署文件下载地址"},
        {"name": "deploy_script", "type": "string", "description": "部署执行脚本内容"}
      ],
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "int",
          "status": "string（pending）",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证"},
        {"code": 403, "message": "权限不足"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "查询部署状态",
      "method": "GET",
      "endpoint": "/api/deployments/{id}/status",
      "description": "查询指定部署任务的当前状态和进度（路由至部署编排服务），需认证",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌"},
        {"name": "id", "type": "int（路径参数）", "description": "部署任务ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "int",
          "status": "string（running/success/failed）",
          "progress": "int（0-100）",
          "current_step": "string",
          "logs": "array<string>"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证"},
        {"code": 404, "message": "部署任务不存在"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    },
    {
      "name": "查询部署历史",
      "method": "GET",
      "endpoint": "/api/deployments/history",
      "description": "按项目分页查询部署历史记录列表（路由至部署编排服务），需认证",
      "parameters": [
        {"name": "Authorization", "type": "string（Header）", "description": "Bearer令牌"},
        {"name": "project_id", "type": "int", "description": "项目ID"},
        {"name": "environment_id", "type": "int（可选）", "description": "环境ID过滤条件"},
        {"name": "page", "type": "int", "description": "页码"},
        {"name": "page_size", "type": "int", "description": "每页条数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array<object>",
          "total": "int",
          "page": "int",
          "page_size": "int"
        }
      },
      "error_codes": [
        {"code": 400, "message": "分页参数不合法"},
        {"code": 401, "message": "未认证"},
        {"code": 502, "message": "后端服务不可达"}
      ]
    }
  ],
  "error_handling": "API网关采用分层错误处理策略：1）请求校验层——校验请求参数合法性、HTTP方法匹配和Content-Type，校验失败返回400 Bad Request，响应体包含error_code和message字段；2）认证鉴权层——JWT令牌校验（签名验证+过期检查+Redis黑名单检查）失败返回401 Unauthorized，权限不足返回403 Forbidden；3）限流层——基于Redis滑动窗口计数器实现，超过阈值返回429 Too Many Requests，响应头携带Retry-After字段指示重试时间；4）路由转发层——后端服务连接超时（5秒）或连接拒绝时返回502 Bad Gateway，响应体携带后端服务名称便于排查；5）全局异常捕获——所有未捕获异常统一返回500 Internal Server Error，日志记录完整堆栈但不将内部细节暴露给客户端。所有错误响应统一格式：{\"error\": {\"code\": \"string错误码\", \"message\": \"string错误描述\", \"request_id\": \"string请求追踪ID\"}}，其中request_id与access_log中的日志ID对应，便于问题追溯。"
}
