{
  "meta": {
    "doc_id": "lld-API网关-001",
    "type": "lld",
    "module_type": "gateway",
    "module": "API网关",
    "title": "LLD - API网关",
    "author": "design_agent",
    "created": "2026-05-22T00:00:00Z"
  },
  "overview": {
    "description": "统一API入口，负责请求路由、认证鉴权和限流。作为系统的接入层，所有外部请求首先到达API网关，经身份认证、请求校验和速率限制后，按路由规则转发至对应的后端业务服务。网关不处理业务逻辑，仅负责协议转换、请求转发和横切关注点（认证、限流、审计日志记录）。",
    "dependencies": ["项目管理服务", "环境管理服务", "部署编排服务", "密钥管理服务", "版本管理服务", "审计日志服务"],
    "tech_stack": ["Go", "Gin", "JWT", "Redis 7+", "gorilla/websocket"]
  },
  "data_models": [
    {
      "name": "route_rules",
      "type": "config",
      "ownership": "owned",
      "description": "网关路由规则配置，定义路径模式与上游服务的映射关系。存储在本地配置文件中，启动时加载到内存。",
      "fields": [
        {"name": "id", "type": "string (UUID)", "required": true, "description": "路由规则唯一标识"},
        {"name": "path_pattern", "type": "string", "required": true, "description": "路径匹配模式，支持:param和**通配符"},
        {"name": "methods", "type": "[]string", "required": false, "description": "允许的HTTP方法列表，为空则匹配所有"},
        {"name": "upstream", "type": "string", "required": true, "description": "上游服务名称，与服务发现注册名一致"},
        {"name": "auth_required", "type": "boolean", "required": true, "description": "是否要求身份认证"},
        {"name": "rate_limit_profile", "type": "string", "required": false, "description": "引用的限流策略名称"},
        {"name": "enabled", "type": "boolean", "required": true, "description": "是否启用该路由"},
        {"name": "description", "type": "string", "required": false, "description": "路由规则说明"}
      ]
    },
    {
      "name": "rate_limit_profiles",
      "type": "config",
      "ownership": "owned",
      "description": "限流策略配置，基于Redis滑动窗口实现速率限制。存储在本地配置文件中。",
      "fields": [
        {"name": "name", "type": "string", "required": true, "description": "策略唯一名称"},
        {"name": "type", "type": "string", "required": true, "description": "限流维度: global / per_user / per_ip"},
        {"name": "requests", "type": "integer", "required": true, "description": "时间窗口内允许的最大请求数"},
        {"name": "window", "type": "string", "required": true, "description": "时间窗口长度，如 1s / 1m / 1h"},
        {"name": "burst", "type": "integer", "required": false, "description": "突发流量允许值，超出窗口速率时的短期上限"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "DeployAPI",
      "method": "POST",
      "endpoint": "/api/v1/deploy",
      "description": "触发一键部署任务，返回任务ID供后续轮询进度。routes_to: 部署编排服务",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "请求体 - 项目标识"},
        {"name": "environment_id", "type": "string (UUID)", "description": "请求体 - 目标环境标识"},
        {"name": "file_path", "type": "string", "description": "请求体 - 上传文件路径或已上传的文件标识"},
        {"name": "version", "type": "string", "description": "请求体 - 可选，指定版本号，为空则自动生成"},
        {"name": "description", "type": "string", "description": "请求体 - 可选，本次部署说明"}
      ],
      "response": {
        "status": 202,
        "body": {
          "task_id": "string (UUID, 部署任务ID)",
          "status": "string (部署状态: pending/running/success/failed)",
          "created_at": "string (ISO8601 时间戳)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败，必填字段缺失或格式错误"},
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 403, "message": "无权限执行部署操作"},
        {"code": 404, "message": "项目或环境不存在"},
        {"code": 429, "message": "请求频率超过限流阈值，请稍后重试"},
        {"code": 500, "message": "上游服务处理异常，部署任务创建失败"}
      ]
    },
    {
      "name": "DeployStatusAPI",
      "method": "GET",
      "endpoint": "/api/v1/deploy/:taskId",
      "description": "查询部署任务的当前状态和进度详情。routes_to: 部署编排服务",
      "parameters": [
        {"name": "taskId", "type": "string (UUID)", "description": "路径参数 - 部署任务ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "task_id": "string (UUID)",
          "status": "string (任务状态)",
          "progress": "integer (0-100 进度百分比)",
          "current_step": "string (当前执行步骤描述)",
          "logs": ["string (日志行)"],
          "error": "string (可选，错误信息)",
          "version": "string (部署版本号)",
          "started_at": "string (ISO8601)",
          "completed_at": "string (可选，ISO8601)"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 403, "message": "无权限访问该部署任务"},
        {"code": 404, "message": "部署任务不存在"},
        {"code": 500, "message": "上游服务处理异常"}
      ]
    },
    {
      "name": "DeployProgressWS",
      "method": "WS",
      "endpoint": "/api/v1/ws/deploy/:taskId",
      "description": "通过WebSocket实时推送部署进度、日志和状态变更事件。routes_to: 部署编排服务",
      "parameters": [
        {"name": "taskId", "type": "string (UUID)", "description": "路径参数 - 部署任务ID"}
      ],
      "response": {
        "status": 101,
        "body": {
          "type": "string (事件类型: progress/log/error/complete)",
          "data": "object (事件负载，按type不同结构不同: progress时含progress/current_step字段, log时含log行字符串, error时含error信息, complete时含最终状态)"
        }
      },
      "error_codes": [
        {"code": 401, "message": "WebSocket握手时认证失败"},
        {"code": 404, "message": "部署任务ID不存在"},
        {"code": 429, "message": "连接频率超限"}
      ]
    },
    {
      "name": "RollbackAPI",
      "method": "POST",
      "endpoint": "/api/v1/deploy/:taskId/rollback",
      "description": "发起版本回滚操作，恢复到指定历史版本。routes_to: 部署编排服务",
      "parameters": [
        {"name": "taskId", "type": "string (UUID)", "description": "路径参数 - 原部署任务ID"},
        {"name": "target_version", "type": "string", "description": "请求体 - 可选，目标回滚版本号，不指定则由系统确定"}
      ],
      "response": {
        "status": 202,
        "body": {
          "rollback_task_id": "string (UUID, 回滚任务ID)",
          "status": "string (回滚状态)",
          "created_at": "string (ISO8601)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证或Token已过期"},
        {"code": 403, "message": "无权限执行回滚操作"},
        {"code": 404, "message": "部署任务或目标版本不存在"},
        {"code": 409, "message": "当前有正在执行的部署任务，无法回滚"},
        {"code": 429, "message": "请求频率超过限流阈值"},
        {"code": 500, "message": "上游服务处理异常"}
      ]
    },
