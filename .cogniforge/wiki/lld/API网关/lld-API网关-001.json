      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "name": "string",
          "public_key": "string",
          "fingerprint": "string",
          "status": "string",
          "created_by": "string",
          "created_at": "datetime",
          "revoked_at": "string",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 404, "message": "指定的 key_id 不存在"},
        {"code": 502, "message": "密钥管理服务不可用或请求超时"}
      ]
    },
    {
      "name": "吊销密钥",
      "method": "POST",
      "endpoint": "/api/keys/{key_id}/revoke",
      "description": "吊销指定密钥，吊销后不可再用于解密。routes_to: 密钥管理服务",
      "parameters": [
        {"name": "key_id", "type": "string", "description": "密钥唯一标识（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "status": "string",
          "revoked_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 403, "message": "权限不足，需要 admin 角色"},
        {"code": 404, "message": "指定的 key_id 不存在"},
        {"code": 409, "message": "密钥已处于 revoked 状态，不可重复吊销"},
        {"code": 502, "message": "密钥管理服务不可用或请求超时"}
      ]
    },
    {
      "name": "创建部署任务",
      "method": "POST",
      "endpoint": "/api/deployments",
      "description": "接收一键部署请求，网关认证后转发到部署执行服务创建部署任务。routes_to: 部署执行服务",
      "parameters": [
        {"name": "project_id", "type": "string", "description": "目标项目ID"},
        {"name": "environment_id", "type": "string", "description": "目标环境ID"},
        {"name": "version", "type": "string", "description": "部署版本号"},
        {"name": "artifact_path", "type": "string", "description": "可执行文件路径或上传文件"}
      ],
      "response": {
        "status": 201,
        "body": {
          "deployment_id": "string",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败，字段缺失或格式错误"},
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 403, "message": "权限不足，需要 admin 或 operator 角色"},
        {"code": 404, "message": "项目或环境不存在"},
        {"code": 409, "message": "该环境已有正在执行的部署任务，并发超限"},
        {"code": 502, "message": "部署执行服务不可用或请求超时"}
      ]
    },
    {
      "name": "查询部署状态",
      "method": "GET",
      "endpoint": "/api/deployments/{deployment_id}",
      "description": "查询单个部署任务的完整状态、步骤详情和执行日志。routes_to: 部署执行服务",
      "parameters": [
        {"name": "deployment_id", "type": "string", "description": "部署任务ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "status": "string",
          "project_id": "string",
          "environment_id": "string",
          "version": "string",
          "steps": "array",
          "logs": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 404, "message": "未找到指定 deployment_id 的部署任务"},
        {"code": 502, "message": "部署执行服务不可用或请求超时"}
      ]
    },
    {
      "name": "查询部署列表",
      "method": "GET",
      "endpoint": "/api/deployments",
      "description": "按项目/环境/状态筛选部署任务列表，支持分页。routes_to: 部署执行服务",
      "parameters": [
        {"name": "project_id", "type": "string", "description": "项目ID（查询参数，必填）"},
        {"name": "environment_id", "type": "string", "description": "环境ID（查询参数，可选）"},
        {"name": "status", "type": "string", "description": "按状态筛选 pending/running/success/failed（可选）"},
        {"name": "page", "type": "integer", "description": "页码，默认 1"},
        {"name": "size", "type": "integer", "description": "每页条数，默认 20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array",
          "total": "integer",
          "page": "integer",
          "size": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "参数校验失败"},
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 404, "message": "项目不存在"},
        {"code": 502, "message": "部署执行服务不可用或请求超时"}
      ]
    },
    {
      "name": "取消部署任务",
      "method": "POST",
      "endpoint": "/api/deployments/{deployment_id}/cancel",
      "description": "取消处于 pending 或 running 状态的部署任务。routes_to: 部署执行服务",
      "parameters": [
        {"name": "deployment_id", "type": "string", "description": "部署任务ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "status": "string",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 403, "message": "权限不足，需要 admin 或 operator 角色"},
        {"code": 404, "message": "未找到指定 deployment_id 的部署任务"},
        {"code": 409, "message": "部署任务状态不允许取消（已完成或已失败）"},
        {"code": 502, "message": "部署执行服务不可用或请求超时"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "API网关采用统一错误处理策略：请求校验失败返回 4xx 错误码及具体校验信息；认证失败返回 401 并提示登录；权限不足返回 403 并注明所需角色；限流触发时返回 429 及 Retry-After 头部；上游服务调用失败返回 502/503 并附带错误详情。所有错误统一封装为标准化 JSON 响应格式，确保前端消费一致性。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {"code": 400, "name": "参数校验失败", "description": "请求体字段缺失、类型不匹配、格式错误或约束校验不通过，如 name 超长、UUID 格式无效、枚举值不合法"},
      {"code": 401, "name": "未认证", "description": "请求未携带 JWT Token、Token 已过期或 Token 签名验证失败。响应包含 WWW-Authenticate 头部指示认证方式"},
      {"code": 403, "name": "权限不足", "description": "用户已认证但角色不满足接口所需权限等级（如非 admin 尝试删除项目），detail 中注明所需最低角色"},
      {"code": 404, "name": "资源不存在", "description": "上游服务返回资源不存在错误，网关原样透传 404 及错误详情"},
      {"code": 409, "name": "业务冲突", "description": "资源状态不允许当前操作，如部署任务状态冲突、项目名重复、密钥已吊销等业务层面冲突"},
      {"code": 429, "name": "请求限流", "description": "触发限流规则时返回此状态码，同时设置 Retry-After 头部指示客户端等待时间（秒）"},
      {"code": 502, "name": "上游服务故障", "description": "下游微服务返回错误响应或请求超时（超过 upstream_read_timeout_ms）"},
      {"code": 503, "name": "服务暂不可用", "description": "网关自身过载（如连接池耗尽）或关键依赖（Redis）不可用"}
    ]
  },
  "route_table": [
    {
      "path_pattern": "/api/auth/**",
      "upstream": "API网关（本地处理）",
      "description": "认证相关接口由网关自身处理，不转发到下游服务"
    },
    {
      "path_pattern": "/api/health",
      "upstream": "API网关（本地处理）",
      "description": "健康检查接口由网关自身处理，聚合各下游服务状态"
    },
    {
      "path_pattern": "/api/projects/**",
      "upstream": "项目管理服务",
      "description": "项目相关的CRUD接口，转发到项目管理服务处理"
    },
    {
      "path_pattern": "/api/environments/**",
      "upstream": "环境管理服务",
      "description": "环境相关的CRUD和连接测试接口，转发到环境管理服务处理"
    },
    {
      "path_pattern": "/api/environment-types",
      "upstream": "环境管理服务",
      "description": "环境类型枚举查询，转发到环境管理服务"
    },
    {
      "path_pattern": "/api/keys/**",
      "upstream": "密钥管理服务",
      "description": "SSH密钥的上传、查询、吊销接口，转发到密钥管理服务处理"
    },
    {
      "path_pattern": "/api/deployments/**",
      "upstream": "部署执行服务",
      "description": "部署任务的创建、查询、取消接口，转发到部署执行服务处理"
    },
    {
      "path_pattern": "/api/internal/**",
      "upstream": "内部服务调用（禁止外部访问）",
      "description": "内部服务间通信接口，从外部路由表中排除，仅允许内部网络访问"
    }
  ],
  "middleware_chain": [
    "Request → CORS → RequestLogging → Auth → RateLimiter → Router → CircuitBreaker → UpstreamProxy → Response"
  ],
  "auth_policy": {
    "public_endpoints": [
      "POST /api/auth/login",
      "POST /api/auth/refresh",
      "GET /api/health"
    ],
    "auth_method": "JWT Bearer Token（RS256 签名）",
    "role_path_map": [
      {"path": "GET /api/projects", "roles": ["admin", "operator", "viewer"]},
      {"path": "GET /api/projects/{project_id}", "roles": ["admin", "operator", "viewer"]},
      {"path": "GET /api/projects/{project_id}/environments", "roles": ["admin", "operator", "viewer"]},
      {"path": "POST /api/projects", "roles": ["admin", "operator"]},
      {"path": "PUT /api/projects/{project_id}", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/projects/{project_id}", "roles": ["admin"]},
      {"path": "GET /api/environments", "roles": ["admin", "operator", "viewer"]},
      {"path": "GET /api/environments/{environment_id}", "roles": ["admin", "operator", "viewer"]},
      {"path": "GET /api/environment-types", "roles": ["admin", "operator", "viewer"]},
      {"path": "POST /api/environments", "roles": ["admin", "operator"]},
      {"path": "PUT /api/environments/{environment_id}", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/environments/{environment_id}", "roles": ["admin"]},
      {"path": "POST /api/environments/{environment_id}/test", "roles": ["admin", "operator"]},
      {"path": "GET /api/keys", "roles": ["admin", "operator", "viewer"]},
      {"path": "GET /api/keys/{key_id}", "roles": ["admin", "operator", "viewer"]},
      {"path": "POST /api/keys", "roles": ["admin", "operator"]},
      {"path": "POST /api/keys/{key_id}/revoke", "roles": ["admin"]},
      {"path": "GET /api/deployments", "roles": ["admin", "operator", "viewer"]},
      {"path": "GET /api/deployments/{deployment_id}", "roles": ["admin", "operator", "viewer"]},
      {"path": "POST /api/deployments", "roles": ["admin", "operator"]},
      {"path": "POST /api/deployments/{deployment_id}/cancel", "roles": ["admin", "operator"]}
    ],
    "token_expiry": "access 2h, refresh 7d"
  },
  "rate_limiting": {
    "global": "每 IP 100 req/s",
    "per_user": "每 user 1000 req/min",
    "special_endpoints": [
      {"endpoint": "POST /api/auth/login", "limit": "每 IP 5 req/min（防止暴力破解）"},
      {"endpoint": "POST /api/deployments", "limit": "每 user 10 req/min"},
      {"endpoint": "POST /api/environments/{environment_id}/test", "limit": "每 user 30 req/min"},
      {"endpoint": "GET /api/health", "limit": "每 IP 60 req/min（宽松限制）"}
    ]
  }
}
