  "error_handling": {
    "strategy": "网关层统一捕获所有上游服务的错误响应，转换为标准JSON错误格式后返回给客户端。认证错误、限流触发、请求校验由网关中间件直接拦截，不转发到上游。上游服务返回的业务错误通过网关透传，不修改状态码和错误消息。",
    "response_format": {
      "body": {
        "code": "integer (HTTP状态码)",
        "error": "string (错误类型名称)",
        "detail": "string (详细错误描述，非敏感信息)"
      }
    },
    "categories": [
      {"code": 400, "name": "BadRequest", "description": "请求参数校验失败：必填参数缺失、参数格式错误、UUID格式不合法、JSON解析失败等"},
      {"code": 401, "name": "Unauthorized", "description": "认证失败：Authorization头缺失、Token格式错误、Token已过期、Token签名无效"},
      {"code": 403, "name": "Forbidden", "description": "权限不足：用户角色不满足路径要求、资源不属于用户上下文"},
      {"code": 404, "name": "NotFound", "description": "资源不存在：路由匹配不到、请求的资源ID在数据库中不存在"},
      {"code": 409, "name": "Conflict", "description": "资源冲突：名称重复、有关联资源阻止操作、有正在执行的冲突任务"},
      {"code": 429, "name": "TooManyRequests", "description": "速率限制触发：全局IP限流、用户级限流或特殊端点限流，响应头包含Retry-After"},
      {"code": 500, "name": "InternalServerError", "description": "上游服务不可达或响应异常：上游HTTP调用失败、上游响应超时、网关与上游连接断开"},
      {"code": 502, "name": "BadGateway", "description": "网关转发失败：上游服务地址不可达、DNS解析失败、连接被拒绝"},
      {"code": 503, "name": "ServiceUnavailable", "description": "网关过载或上游服务熔断：全部上游健康检查失败、连接池耗尽"}
    ]
  },
  "route_table": [
    {"path_pattern": "/api/health", "upstream": "网关自身", "description": "健康检查端点，由网关本身直接处理，不转发"},
    {"path_pattern": "/api/v1/deploy", "upstream": "部署编排服务", "description": "部署操作：创建部署任务、WebSocket推送进度"},
    {"path_pattern": "/api/v1/deploy/:taskId", "upstream": "部署编排服务", "description": "部署任务状态查询"},
    {"path_pattern": "/api/v1/deploy/:taskId/rollback", "upstream": "部署编排服务", "description": "版本回滚操作"},
    {"path_pattern": "/api/v1/ws/deploy/:taskId", "upstream": "部署编排服务", "description": "部署进度WebSocket推送"},
    {"path_pattern": "/api/v1/projects", "upstream": "项目管理服务", "description": "项目列表和创建"},
    {"path_pattern": "/api/v1/projects/:projectId", "upstream": "项目管理服务", "description": "单个项目详情、更新、删除"},
    {"path_pattern": "/api/v1/projects/:projectId/versions", "upstream": "版本管理服务", "description": "项目版本历史查询"},
    {"path_pattern": "/api/v1/environments", "upstream": "环境管理服务", "description": "环境列表和创建"},
    {"path_pattern": "/api/v1/environments/:envId", "upstream": "环境管理服务", "description": "单个环境详情、更新、删除"},
    {"path_pattern": "/api/v1/keys", "upstream": "密钥管理服务", "description": "密钥列表和创建"},
    {"path_pattern": "/api/v1/keys/:keyId", "upstream": "密钥管理服务", "description": "单个密钥详情、更新、删除"},
    {"path_pattern": "/api/v1/keys/:keyId/verify", "upstream": "密钥管理服务", "description": "密钥连接验证"},
    {"path_pattern": "/api/v1/audit-logs", "upstream": "审计日志服务", "description": "审计日志查询"},
    {"path_pattern": "/api/v1/session/current-project", "upstream": "项目管理服务", "description": "用户当前项目切换"}
  ],
  "middleware_chain": [
    "Request → CORS (跨域处理) → RequestLogger (请求日志) → Auth (JWT认证) → RateLimiter (速率限制) → Router (路由分发) → UpstreamCall (上游调用) → ResponseLogger (响应日志) → Response"
  ],
  "auth_policy": {
    "public_endpoints": ["/api/health"],
    "auth_method": "JWT Bearer Token，通过Authorization头传递。Token包含用户ID、用户名、角色列表、当前项目上下文。",
    "role_path_map": [
      {"path": "GET /api/v1/projects", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "POST /api/v1/projects", "roles": ["admin", "operator"]},
      {"path": "PUT /api/v1/projects/:projectId", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/v1/projects/:projectId", "roles": ["admin"]},
      {"path": "GET /api/v1/environments", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "POST /api/v1/environments", "roles": ["admin", "operator"]},
      {"path": "PUT /api/v1/environments/:envId", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/v1/environments/:envId", "roles": ["admin"]},
      {"path": "GET /api/v1/keys", "roles": ["admin", "operator"]},
      {"path": "POST /api/v1/keys", "roles": ["admin", "operator"]},
      {"path": "PUT /api/v1/keys/:keyId", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/v1/keys/:keyId", "roles": ["admin"]},
      {"path": "POST /api/v1/keys/:keyId/verify", "roles": ["admin", "operator"]},
      {"path": "POST /api/v1/deploy", "roles": ["admin", "operator"]},
      {"path": "GET /api/v1/deploy/:taskId", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "POST /api/v1/deploy/:taskId/rollback", "roles": ["admin"]},
      {"path": "WS /api/v1/ws/deploy/:taskId", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "GET /api/v1/projects/:projectId/versions", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "GET /api/v1/audit-logs", "roles": ["admin"]},
      {"path": "POST /api/v1/session/current-project", "roles": ["admin", "operator", "developer", "viewer"]}
    ],
    "token_expiry": "access 2h, refresh 7d"
  },
  "rate_limiting": {
    "global": "每IP 100 req/s，基于Redis滑动窗口计数器",
    "per_user": "每user 1000 req/min，基于JWT中的用户身份标识",
    "special_endpoints": [
      {"endpoint": "POST /api/v1/deploy", "limit": "每user 10 req/min"},
      {"endpoint": "POST /api/v1/deploy/:taskId/rollback", "limit": "每user 5 req/min"},
      {"endpoint": "POST /api/v1/keys", "limit": "每user 30 req/min"},
      {"endpoint": "GET /api/health", "limit": "不限流"}
    ]
  }
}
