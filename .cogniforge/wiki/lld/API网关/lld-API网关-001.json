{
  "meta": {
    "doc_id": "lld-API网关-001",
    "type": "lld",
    "module_type": "gateway",
    "module": "API网关",
    "title": "API网关详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "系统的统一入口网关，负责前端请求的路由分发、用户身份认证与会话管理（JWT）、基于角色的接口访问控制（RBAC）、请求速率限制和防滥用，以及WebSocket连接管理。所有前端请求首先到达API网关，经过认证→鉴权→限流→路由后转发到对应业务服务。",
    "dependencies": ["Web控制台", "项目管理服务", "环境管理服务", "部署编排服务", "密钥管理服务", "文件存储"],
    "tech_stack": ["Python", "FastAPI", "Redis", "JWT + RBAC"]
  },
  "data_models": [
    {
      "name": "jwt_payload",
      "type": "struct",
      "ownership": "owned",
      "description": "JWT令牌负载结构，由网关在登录时签发，认证时解析校验。access_token有效期2小时，refresh_token有效期7天",
      "fields": [
        {"name": "sub", "type": "string (UUID)", "required": true, "description": "用户唯一标识（subject claim）"},
        {"name": "username", "type": "string", "required": true, "description": "用户名"},
        {"name": "roles", "type": "string[]", "required": true, "description": "用户角色列表，用于RBAC权限判断"},
        {"name": "exp", "type": "integer (Unix timestamp)", "required": true, "description": "令牌过期时间"},
        {"name": "iat", "type": "integer (Unix timestamp)", "required": true, "description": "令牌签发时间"},
        {"name": "token_type", "type": "string (access/refresh)", "required": true, "description": "令牌类型，access或refresh"}
      ]
    },
    {
      "name": "route_rule",
      "type": "config",
      "ownership": "owned",
      "description": "路由规则配置，定义路径匹配模式到上游服务的转发映射，支持路径参数提取和前缀重写",
      "fields": [
        {"name": "path_pattern", "type": "string", "required": true, "description": "路径匹配模式，如 /api/v1/projects/**"},
        {"name": "upstream", "type": "string", "required": true, "description": "上游服务名，如 project-service"},
        {"name": "strip_prefix", "type": "boolean", "required": true, "description": "是否在转发前去除匹配前缀"},
        {"name": "methods", "type": "string[]", "required": false, "description": "允许的HTTP方法列表，不指定则允许所有方法"},
        {"name": "rate_limit_profile", "type": "string", "required": false, "description": "关联的限流配置模板名"}
      ]
    },
    {
      "name": "rate_limit_config",
      "type": "config",
      "ownership": "owned",
      "description": "限流策略配置，支持全局、每用户、每端点三级限流。基于Redis + 滑动窗口算法实现",
      "fields": [
        {"name": "profile_name", "type": "string", "required": true, "description": "限流配置模板名，route_rule通过此名称引用"},
        {"name": "global_rps", "type": "integer", "required": true, "description": "全局每秒最大请求数，超过时返回429"},
        {"name": "user_rpm", "type": "integer", "required": true, "description": "每用户每分钟最大请求数，按JWT sub区分"},
        {"name": "ip_rps", "type": "integer", "required": true, "description": "每IP每秒最大请求数，用于防滥用"},
        {"name": "burst_size", "type": "integer", "required": false, "description": "突发流量允许的额外请求数，应对瞬时峰值"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "Login",
      "method": "POST",
      "endpoint": "/api/v1/auth/login",
      "description": "用户登录认证，校验用户名密码后签发JWT access_token和refresh_token。routes_to: 网关自身（结合用户存储认证）",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码（明文传输，HTTPS加密）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string (JWT)",
          "refresh_token": "string (JWT，长有效期)",
          "token_type": "string (Bearer)",
          "expires_in": "integer (过期秒数，7200)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：username或password缺失"},
        {"code": 401, "message": "用户名或密码错误"},
        {"code": 429, "message": "登录请求过于频繁，请稍后重试"}
      ]
    },
    {
      "name": "RefreshToken",
      "method": "POST",
      "endpoint": "/api/v1/auth/refresh",
      "description": "使用refresh_token换取新的access_token。refresh_token过期后需用户重新登录。routes_to: 网关自身",
      "parameters": [
        {"name": "refresh_token", "type": "string (JWT)", "description": "登录时获取的refresh_token"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string (新签发的JWT)",
          "expires_in": "integer (过期秒数，7200)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "refresh_token缺失"},
        {"code": 401, "message": "refresh_token无效或已过期，请重新登录"}
      ]
    },
    {
      "name": "HealthCheck",
      "method": "GET",
      "endpoint": "/api/v1/health",
      "description": "网关健康检查端点，返回服务状态和版本号，用于负载均衡器健康探测。routes_to: 网关自身",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "status": "string (OK)",
          "version": "string (当前版本号)"
        }
      },
      "error_codes": [
        {"code": 503, "message": "网关服务异常或依赖的下游服务不可达"}
      ]
    },
    {
      "name": "ListProjects",
      "method": "GET",
      "endpoint": "/api/v1/projects",
      "description": "查询用户有权限访问的项目列表，支持分页。routes_to: 项目管理服务",
      "parameters": [
        {"name": "page", "type": "integer", "description": "分页页码，从1开始"},
        {"name": "page_size", "type": "integer", "description": "每页数量，默认20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array (Project对象列表，每个对象包含id/name/description/environments/created_at/updated_at)",
          "total": "integer (总记录数)",
          "page": "integer (当前页码)",
          "page_size": "integer (每页数量)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "分页参数格式错误"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限访问项目列表"}
      ]
    },
    {
      "name": "CreateProject",
      "method": "POST",
      "endpoint": "/api/v1/projects",
      "description": "创建新项目，请求体含项目名称、描述和关联环境。routes_to: 项目管理服务",
      "parameters": [
        {"name": "name", "type": "string", "description": "项目名称（必填）"},
        {"name": "description", "type": "string", "description": "项目描述（可选）"},
        {"name": "environments", "type": "string[]", "description": "关联的环境ID列表（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "description": "string",
          "environments": "array",
          "created_at": "string (ISO datetime)",
          "updated_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：name为必填"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限创建项目"},
        {"code": 409, "message": "项目名称已存在"}
      ]
    },
    {
      "name": "UpdateProject",
      "method": "PUT",
      "endpoint": "/api/v1/projects/{project_id}",
      "description": "更新指定项目的信息。routes_to: 项目管理服务",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "项目ID（路径参数）"},
        {"name": "name", "type": "string", "description": "项目名称（可选）"},
        {"name": "description", "type": "string", "description": "项目描述（可选）"},
        {"name": "environments", "type": "string[]", "description": "关联的环境ID列表（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "description": "string",
          "environments": "array",
          "created_at": "string (ISO datetime)",
          "updated_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限修改该项目"},
        {"code": 404, "message": "项目不存在"}
      ]
    },
    {
      "name": "DeleteProject",
      "method": "DELETE",
      "endpoint": "/api/v1/projects/{project_id}",
      "description": "删除指定项目（软删除或级联删除由下游服务定义）。routes_to: 项目管理服务",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "项目ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限删除该项目"},
        {"code": 404, "message": "项目不存在"},
        {"code": 409, "message": "项目下存在活跃环境或部署记录，无法删除"}
      ]
    },
    {
      "name": "ListEnvironments",
      "method": "GET",
      "endpoint": "/api/v1/environments",
      "description": "查询环境列表，可按项目ID过滤。routes_to: 环境管理服务",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "按项目过滤（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array (Environment对象列表)",
          "total": "integer (总记录数)",
          "page": "integer (当前页码)",
          "page_size": "integer (每页数量)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "查询参数格式错误"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限查看环境列表"}
      ]
    },
    {
      "name": "CreateEnvironment",
      "method": "POST",
      "endpoint": "/api/v1/environments",
      "description": "创建新部署环境，需指定远程服务器连接参数和关联的SSH密钥。routes_to: 环境管理服务",
      "parameters": [
        {"name": "name", "type": "string", "description": "环境名称，如 测试线/灰度线/正式线"},
        {"name": "host", "type": "string", "description": "远程服务器主机名或IP"},
        {"name": "port", "type": "integer", "description": "SSH端口，默认22"},
        {"name": "username", "type": "string", "description": "SSH登录用户名"},
        {"name": "key_id", "type": "string (UUID)", "description": "关联的SSH密钥ID"},
        {"name": "project_id", "type": "string (UUID)", "description": "所属项目ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_id": "string (UUID)",
          "project_id": "string (UUID)",
          "status": "string (ONLINE/OFFLINE/UNKNOWN)",
          "created_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：必填字段缺失或格式错误"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限创建环境"},
        {"code": 404, "message": "引用的项目或SSH密钥不存在"}
      ]
    },
    {
      "name": "UpdateEnvironment",
      "method": "PUT",
      "endpoint": "/api/v1/environments/{environment_id}",
      "description": "更新指定环境的配置参数。routes_to: 环境管理服务",
      "parameters": [
        {"name": "environment_id", "type": "string (UUID)", "description": "环境ID（路径参数）"},
        {"name": "name", "type": "string", "description": "环境名称（可选）"},
        {"name": "host", "type": "string", "description": "远程服务器主机名或IP（可选）"},
        {"name": "port", "type": "integer", "description": "SSH端口（可选）"},
        {"name": "username", "type": "string", "description": "SSH登录用户名（可选）"},
        {"name": "key_id", "type": "string (UUID)", "description": "关联的SSH密钥ID（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "username": "string",
          "key_id": "string (UUID)",
          "project_id": "string (UUID)",
          "status": "string (ONLINE/OFFLINE/UNKNOWN)",
          "created_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限修改该环境"},
        {"code": 404, "message": "环境不存在"}
      ]
    },
    {
      "name": "DeleteEnvironment",
      "method": "DELETE",
      "endpoint": "/api/v1/environments/{environment_id}",
      "description": "删除指定部署环境。routes_to: 环境管理服务",
      "parameters": [
        {"name": "environment_id", "type": "string (UUID)", "description": "环境ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限删除该环境"},
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "该环境有关联的部署记录，无法删除"}
      ]
    },
    {
      "name": "TestEnvironmentConnection",
      "method": "POST",
      "endpoint": "/api/v1/environments/{environment_id}/test",
      "description": "测试目标环境的SSH连接连通性，返回是否可达和延迟。routes_to: 环境管理服务",
      "parameters": [
        {"name": "environment_id", "type": "string (UUID)", "description": "待测试的环境ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "reachable": "boolean",
          "latency_ms": "integer",
          "error": "string (连接失败时的错误信息，可选)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "environment_id格式无效"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限测试该环境"},
        {"code": 404, "message": "环境不存在"}
      ]
    },
    {
      "name": "ListKeys",
      "method": "GET",
      "endpoint": "/api/v1/keys",
      "description": "查询SSH密钥列表，返回密钥元数据（不返回私钥内容）。routes_to: 密钥管理服务",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "items": "array (Key对象列表)",
          "total": "integer (总记录数)",
          "page": "integer (当前页码)",
          "page_size": "integer (每页数量)"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限查看密钥列表"}
      ]
    },
    {
      "name": "CreateKey",
      "method": "POST",
      "endpoint": "/api/v1/keys",
      "description": "上传SSH密钥（公钥或私钥），网关透传请求体到密钥管理服务，由下游进行格式校验和加密存储。routes_to: 密钥管理服务",
      "parameters": [
        {"name": "name", "type": "string", "description": "密钥名称"},
        {"name": "public_key", "type": "string", "description": "公钥内容（可选）"},
        {"name": "private_key", "type": "string", "description": "私钥内容"},
        {"name": "passphrase", "type": "string", "description": "私钥密码（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "fingerprint": "string (SHA256指纹)",
          "algorithm": "string (RSA/ECDSA/ED25519)",
          "bound_environments": "string[] (已绑定的环境ID列表)",
          "created_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：密钥格式错误或必填字段缺失"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限上传密钥"}
      ]
    },
    {
      "name": "UpdateKey",
      "method": "PUT",
      "endpoint": "/api/v1/keys/{key_id}",
      "description": "更新指定SSH密钥的名称或内容。routes_to: 密钥管理服务",
      "parameters": [
        {"name": "key_id", "type": "string (UUID)", "description": "密钥ID（路径参数）"},
        {"name": "name", "type": "string", "description": "密钥名称（可选）"},
        {"name": "public_key", "type": "string", "description": "公钥内容（可选）"},
        {"name": "private_key", "type": "string", "description": "私钥内容（可选）"},
        {"name": "passphrase", "type": "string", "description": "私钥密码（可选）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "name": "string",
          "fingerprint": "string (SHA256指纹)",
          "algorithm": "string (RSA/ECDSA/ED25519)",
          "bound_environments": "string[] (已绑定的环境ID列表)",
          "created_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限修改该密钥"},
        {"code": 404, "message": "密钥不存在"}
      ]
    },
    {
      "name": "DeleteKey",
      "method": "DELETE",
      "endpoint": "/api/v1/keys/{key_id}",
      "description": "删除（吊销）指定SSH密钥。routes_to: 密钥管理服务",
      "parameters": [
        {"name": "key_id", "type": "string (UUID)", "description": "密钥ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限删除该密钥"},
        {"code": 404, "message": "密钥不存在"},
        {"code": 409, "message": "该密钥已绑定到环境，无法删除"}
      ]
    },
    {
      "name": "ExecuteDeploy",
      "method": "POST",
      "endpoint": "/api/v1/deploys",
      "description": "发起一键部署任务，网关透传部署参数到部署编排服务，返回任务ID后前端通过WebSocket轮询状态。routes_to: 部署编排服务",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "目标项目ID"},
        {"name": "environment_id", "type": "string (UUID)", "description": "目标环境ID"},
        {"name": "version", "type": "string", "description": "部署版本号"},
        {"name": "file_id", "type": "string (UUID)", "description": "可执行文件ID"}
      ],
      "response": {
        "status": 202,
        "body": {
          "deploy_id": "string (UUID，部署任务ID)",
          "status": "string (PENDING/RUNNING/SUCCESS/FAILED)",
          "created_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：必填字段缺失或格式错误"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限发起部署"},
        {"code": 404, "message": "项目/环境/文件不存在"},
        {"code": 409, "message": "该项目下该环境已有PENDING或RUNNING状态的部署任务，禁止并发"}
      ]
    },
    {
      "name": "GetDeployStatus",
      "method": "WS",
      "endpoint": "/api/v1/deploys/{deploy_id}/status",
      "description": "通过WebSocket实时推送部署任务的各步骤状态和日志流。网关在认证后建立WS连接，将消息透传至部署编排服务。routes_to: 部署编排服务",
      "parameters": [
        {"name": "deploy_id", "type": "string (UUID)", "description": "部署任务ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "step": "string (当前步骤名)",
          "status": "string (RUNNING/SUCCESS/FAILED)",
          "progress": "number (0-100)",
          "log": "string (当前日志片段)",
          "timestamp": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "deploy_id格式无效"},
        {"code": 401, "message": "WebSocket握手时token认证失败"},
        {"code": 404, "message": "部署任务不存在"}
      ]
    },
    {
      "name": "GetDeployHistory",
      "method": "GET",
      "endpoint": "/api/v1/deploys/history",
      "description": "查询指定项目的部署历史记录，支持按环境过滤和分页，用于版本追溯和回滚操作。routes_to: 部署编排服务",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "按项目过滤（必填）"},
        {"name": "environment_id", "type": "string (UUID)", "description": "按环境过滤（可选）"},
        {"name": "page", "type": "integer", "description": "分页页码，从1开始"},
        {"name": "page_size", "type": "integer", "description": "每页数量，默认20"}
      ],
      "response": {
        "status": 200,
        "body": {
          "items": "array",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "查询参数校验失败（如project_id格式错误）"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限查看部署历史"},
        {"code": 404, "message": "项目不存在"}
      ]
    },
    {
      "name": "UploadFile",
      "method": "POST",
      "endpoint": "/api/v1/files/upload",
      "description": "上传可执行文件并关联到指定项目。网关使用multipart/form-data接收文件，透传到文件存储服务进行完整性校验和版本化管理。routes_to: 文件存储",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "所属项目ID"},
        {"name": "file", "type": "binary (multipart/form-data)", "description": "可执行文件内容"},
        {"name": "version", "type": "string", "description": "版本号（可选，不指定则自动生成）"}
      ],
      "response": {
        "status": 201,
        "body": {
          "file_id": "string (UUID)",
          "file_name": "string",
          "version": "string",
          "checksum": "string (SHA256)",
          "size_bytes": "integer",
          "created_at": "string (ISO datetime)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：文件内容为空或project_id格式错误"},
        {"code": 401, "message": "未认证或token已过期"},
        {"code": 403, "message": "无权限上传文件"},
        {"code": 404, "message": "项目不存在"},
        {"code": 409, "message": "版本号已存在（手动指定已存在的版本时）"},
        {"code": 413, "message": "文件大小超过限制（默认100MB）"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "API网关作为系统入口，错误处理按层次递进：1）接入层——请求格式错误、JSON解析失败返回400；2）认证层——token缺失/无效/过期返回401，token被吊销返回401且记录审计日志；3）鉴权层——用户无目标接口权限返回403；4）限流层——请求速率超限返回429，并在响应头附加Retry-After；5）路由层——路径不匹配返回404；6）转发层——上游服务返回的错误码透传给前端，上游服务不可达（连接超时/拒绝）返回502，网关自身转发超时（默认30秒）返回504。所有错误统一使用JSON格式响应，错误详情中不泄露服务内部实现细节。",
    "response_format": {
      "body": {"code": "integer", "error": "string", "detail": "string"}
    },
    "categories": [
      {"code": "400", "name": "请求参数错误", "description": "请求体JSON解析失败、必填字段缺失、字段类型或格式不符合约束；multipart边界格式错误"},
      {"code": "401", "name": "认证失败", "description": "Authorization头缺失、token格式无效、签名校验失败、token已过期、token已被吊销"},
      {"code": "403", "name": "权限不足", "description": "认证通过但用户角色不满足接口要求的角色矩阵（role_path_map中未匹配到对应角色）"},
      {"code": "404", "name": "路由未匹配", "description": "请求路径在route_table中无匹配的path_pattern；或上游服务返回404时透传"},
      {"code": "429", "name": "请求限流", "description": "全局/每用户/每IP的请求速率超过配置阈值，响应头附加X-RateLimit-Remaining和Retry-After"},
      {"code": "500", "name": "网关内部错误", "description": "网关自身异常（如内存溢出、未捕获的运行时异常），不暴露堆栈信息"},
      {"code": "502", "name": "上游服务不可达", "description": "转发请求到上游服务时连接失败、DNS解析失败、TLS握手失败"},
      {"code": "504", "name": "上游服务超时", "description": "转发请求到上游服务后30秒内未收到响应"}
    ]
  },
  "route_table": [
    {
      "path_pattern": "/api/v1/auth/login",
      "upstream": "API网关（自身）",
      "description": "用户登录认证，不转发到下游，由网关自身处理"
    },
    {
      "path_pattern": "/api/v1/auth/refresh",
      "upstream": "API网关（自身）",
      "description": "令牌刷新，由网关自身处理JWT重签"
    },
    {
      "path_pattern": "/api/v1/health",
      "upstream": "API网关（自身）",
      "description": "健康检查端点，由网关自身直接返回"
    },
    {
      "path_pattern": "/api/v1/projects/**",
      "upstream": "项目管理服务",
      "description": "项目CRUD操作：创建、查询、更新、删除项目"
    },
    {
      "path_pattern": "/api/v1/environments/**",
      "upstream": "环境管理服务",
      "description": "环境CRUD操作及连接测试：创建、查询、更新、删除环境，以及SSH连通性测试"
    },
    {
      "path_pattern": "/api/v1/keys/**",
      "upstream": "密钥管理服务",
      "description": "SSH密钥管理操作：上传、查询、更新、吊销密钥"
    },
    {
      "path_pattern": "/api/v1/deploys/**",
      "upstream": "部署编排服务",
      "description": "部署相关操作：发起部署、查询部署历史、WebSocket推送部署状态"
    },
    {
      "path_pattern": "/api/v1/files/**",
      "upstream": "文件存储",
      "description": "文件上传操作：上传可执行文件并关联到项目"
    }
  ],
  "middleware_chain": [
    "Request → AccessLog（请求日志记录） → Auth（JWT校验与解析） → RateLimiter（三级限流） → Router（路径匹配与路由） → 转发 Upstream（HTTP/gRPC） → 汇聚 Response → PostLog（响应日志记录） → Response"
  ],
  "auth_policy": {
    "public_endpoints": ["POST /api/v1/auth/login", "POST /api/v1/auth/refresh", "GET /api/v1/health"],
    "auth_method": "JWT Bearer Token，签发算法RS256，access_token有效期2小时，refresh_token有效期7天。令牌负载包含sub（用户ID）、username、roles（角色列表）、token_type。网关验证签名后从roles字段提取角色进行RBAC鉴权",
    "role_path_map": [
      {"path": "GET /api/v1/projects", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "POST /api/v1/projects", "roles": ["admin", "operator"]},
      {"path": "PUT /api/v1/projects/*", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/v1/projects/*", "roles": ["admin"]},
      {"path": "GET /api/v1/environments", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "POST /api/v1/environments", "roles": ["admin", "operator"]},
      {"path": "PUT /api/v1/environments/*", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/v1/environments/*", "roles": ["admin"]},
      {"path": "POST /api/v1/environments/*/test", "roles": ["admin", "operator"]},
      {"path": "GET /api/v1/keys", "roles": ["admin", "operator", "developer"]},
      {"path": "POST /api/v1/keys", "roles": ["admin", "operator"]},
      {"path": "PUT /api/v1/keys/*", "roles": ["admin", "operator"]},
      {"path": "DELETE /api/v1/keys/*", "roles": ["admin"]},
      {"path": "POST /api/v1/deploys", "roles": ["admin", "operator"]},
      {"path": "WS /api/v1/deploys/*/status", "roles": ["admin", "operator", "developer"]},
      {"path": "GET /api/v1/deploys/history", "roles": ["admin", "operator", "developer", "viewer"]},
      {"path": "POST /api/v1/files/upload", "roles": ["admin", "operator", "developer"]}
    ],
    "token_expiry": "access_token 2小时，refresh_token 7天"
  },
  "rate_limiting": {
    "global": "每IP 100 req/s（基于客户端IP的全局限流，超过返回429）",
    "per_user": "每user 1000 req/min（基于JWT sub字段的每用户限流，未认证请求按IP计入全局限流）",
    "special_endpoints": [
      {"endpoint": "POST /api/v1/auth/login", "limit": "每IP 5 req/min，防止暴力破解"},
      {"endpoint": "POST /api/v1/deploys", "limit": "每user 10 req/min，防止频繁发起部署"},
      {"endpoint": "POST /api/v1/files/upload", "limit": "每user 30 req/min，每文件最大100MB"},
      {"endpoint": "WS /api/v1/deploys/*/status", "limit": "每user 10并发连接数"}
    ]
  }
}
