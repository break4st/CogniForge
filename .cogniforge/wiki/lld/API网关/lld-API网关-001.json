          "version": "string",
          "status": "string",
          "progress": "integer",
          "current_step": "string",
          "created_at": "datetime",
          "started_at": "datetime",
          "completed_at": "datetime",
          "error": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "未提供有效的认证 Token"},
        {"code": 404, "message": "部署任务不存在"},
        {"code": 500, "message": "服务器内部错误"}
