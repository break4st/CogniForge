      "parameters": [
        {"name": "projectId", "type": "integer", "description": "项目ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 401, "message": "JWT令牌缺失或已过期"},
