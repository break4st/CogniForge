{
  "meta": {
    "doc_id": "lld-API网关-001",
    "type": "lld",
    "module_type": "gateway",
    "module": "API网关",
    "title": "API网关详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "统一API入口，负责请求路由、认证鉴权、流量控制。作为系统的唯一外部访问点，所有客户端请求必须经过API网关转发到对应的下游微服务。核心职责包括：请求路由转发到对应微服务、用户身份认证和权限校验、请求日志记录、限流和熔断保护。",
    "dependencies": ["项目管理服务", "环境管理服务", "部署执行服务", "密钥管理服务", "审计日志服务"],
    "tech_stack": ["Python", "FastAPI", "Redis 7", "RabbitMQ"]
  },
  "data_models": [
    {
      "name": "GatewayRoute",
      "type": "config",
      "ownership": "owned",
      "description": "路由规则配置，定义路径模式与上游服务的映射关系，支持路径变量提取和转发",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "路由规则唯一标识"},
        {"name": "path_pattern", "type": "string", "required": true, "description": "路径匹配模式，如 /api/projects/**"},
        {"name": "upstream", "type": "string", "required": true, "description": "上游服务名称，如 project-service"},
        {"name": "methods", "type": "array[string]", "required": true, "description": "允许的 HTTP 方法列表，如 [GET, POST]"},
        {"name": "auth_required", "type": "boolean", "required": true, "description": "该路由是否需要认证"},
        {"name": "rate_limit_profile", "type": "string", "required": false, "description": "限流策略引用名，如 default / strict / relaxed"},
        {"name": "timeout_ms", "type": "integer", "required": true, "description": "上游请求超时时间（毫秒），默认 30000"},
        {"name": "enabled", "type": "boolean", "required": true, "description": "路由是否启用"}
      ]
    },
    {
      "name": "RateLimitPolicy",
      "type": "config",
      "ownership": "owned",
      "description": "限流策略配置，定义不同维度的速率限制规则，存储于网关本地配置，运行时计数器存于 Redis",
      "fields": [
        {"name": "profile_name", "type": "string", "required": true, "description": "策略引用名，如 default / strict / relaxed"},
        {"name": "global_rps", "type": "integer", "required": true, "description": "全局每秒请求数上限"},
        {"name": "per_ip_rps", "type": "integer", "required": true, "description": "每 IP 每秒请求数上限"},
        {"name": "per_user_rpm", "type": "integer", "required": true, "description": "每用户每分钟请求数上限"},
        {"name": "burst_size", "type": "integer", "required": true, "description": "突发请求允许的额外容量"}
      ]
    },
    {
      "name": "GatewayConfig",
      "type": "config",
      "ownership": "owned",
      "description": "API网关全局配置参数",
      "fields": [
        {"name": "jwt_secret", "type": "string", "required": true, "description": "JWT签名密钥（环境变量注入，不落盘）"},
        {"name": "access_token_expiry_minutes", "type": "integer", "required": true, "description": "Access Token 过期时间（分钟），默认 120"},
        {"name": "refresh_token_expiry_days", "type": "integer", "required": true, "description": "Refresh Token 过期时间（天），默认 7"},
        {"name": "max_request_body_size_mb", "type": "integer", "required": true, "description": "最大请求体大小（MB），默认 10"},
        {"name": "upstream_connect_timeout_ms", "type": "integer", "required": true, "description": "上游服务连接超时（毫秒），默认 5000"},
        {"name": "upstream_read_timeout_ms", "type": "integer", "required": true, "description": "上游服务读取超时（毫秒），默认 30000"},
        {"name": "log_all_requests", "type": "boolean", "required": true, "description": "是否记录所有请求日志，默认 true"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "登录认证",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "description": "用户登录认证，验证用户名密码后签发 JWT Access Token 和 Refresh Token。网关自身处理的公共接口，不转发到下游服务",
      "parameters": [
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "password", "type": "string", "description": "密码"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string",
          "refresh_token": "string",
          "token_type": "string",
          "expires_in": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "用户名或密码错误"},
        {"code": 429, "message": "登录尝试过于频繁，请稍后再试"}
      ]
    },
    {
      "name": "刷新令牌",
      "method": "POST",
      "endpoint": "/api/auth/refresh",
      "description": "使用 Refresh Token 获取新的 Access Token。网关自身处理的公共接口",
      "parameters": [
        {"name": "refresh_token", "type": "string", "description": "刷新令牌"}
      ],
      "response": {
        "status": 200,
        "body": {
          "access_token": "string",
          "token_type": "string",
          "expires_in": "integer"
        }
      },
      "error_codes": [
        {"code": 401, "message": "Refresh Token 无效或已过期"}
      ]
    },
    {
      "name": "健康检查",
      "method": "GET",
      "endpoint": "/api/health",
      "description": "API网关及下游服务健康检查，返回各依赖服务的连通状态。公共接口无需认证",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "status": "string",
          "version": "string",
          "dependencies": "object"
        }
      },
      "error_codes": [
        {"code": 503, "message": "网关自身或关键依赖服务不可用"}
      ]
    },
    {
      "name": "创建项目",
      "method": "POST",
      "endpoint": "/api/projects",
      "description": "创建新项目。routes_to: 项目管理服务。认证用户身份后转发请求，name和description由网关校验非空后透传",
      "parameters": [
        {"name": "name", "type": "string", "description": "项目名称"},
        {"name": "description", "type": "string", "description": "项目描述"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "string",
          "name": "string",
          "description": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败，字段缺失或格式错误"},
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 403, "message": "权限不足，需要 admin 或 operator 角色"},
        {"code": 409, "message": "项目名称已存在"},
        {"code": 502, "message": "项目管理服务不可用或请求超时"}
      ]
    },
    {
