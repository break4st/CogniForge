      ],
      "response": {
        "status": 200,
        "body": {
          "code": "integer",
          "message": "string",
          "data.id": "integer",
          "data.name": "string",
          "data.description": "string",
          "data.created_at": "string"
        }
      },
      "error_codes": [
        {"code": 400, "message": "参数校验失败（name 为必填项）"},
        {"code": 401, "message": "JWT令牌缺失或已过期"},
        {"code": 403, "message": "无权限创建项目"},
        {"code": 409, "message": "项目名称已存在"}
      ]
    },
