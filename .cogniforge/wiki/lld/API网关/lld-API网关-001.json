      "parameters": [
        {"name": "status", "type": "string", "description": "筛选条件：active/revoked（可选）"},
        {"name": "created_by", "type": "string", "description": "筛选条件：创建人用户名（可选）"},
        {"name": "page", "type": "integer", "description": "页码，从1开始，默认1"},
        {"name": "size", "type": "integer", "description": "每页条数，默认20，最大100"}
      ],
      "response": {
        "status": 200,
        "body": {
          "keys": "array",
          "total": "integer",
          "page": "integer",
          "size": "integer"
        }
      },
      "error_codes": [
        {"code": 400, "message": "分页参数超出范围"},
        {"code": 401, "message": "未认证或令牌已过期"},
        {"code": 502, "message": "密钥管理服务不可用或请求超时"}
      ]
    },
    {
      "name": "查询密钥详情",
      "method": "GET",
      "endpoint": "/api/keys/{key_id}",
      "description": "根据密钥ID查询单个密钥的完整元信息。routes_to: 密钥管理服务",
