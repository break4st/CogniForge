{
  "meta": {
    "doc_id": "lld-Cache-001",
    "type": "lld",
    "module_type": "ModuleType.SERVICE",
    "module": "Cache",
    "title": "LLD - Cache",
    "author": "design_agent",
    "created": "2026-05-21 09:52"
  },
  "overview": {
    "description": "Cache模块基于Redis 7.x提供分布式缓存能力，为用户会话管理、部署任务实时状态缓存、项目列表与环境配置热点数据加速，以及SSH连接测试临时结果缓存提供统一的高速数据访问层。各业务服务通过内部接口读写缓存，降低Primary Database的读压力，提升系统响应速度。",
    "dependencies": [],
    "tech_stack": ["Python 3.11+", "FastAPI", "Redis 7.x"]
  },
  "data_models": [
    {
      "name": "jwt_session",
      "type": "store",
      "ownership": "owned",
      "description": "用户JWT会话缓存。Redis Key格式: session:{user_id}:{jwt_id}，Value为JSON序列化会话数据，TTL等于JWT剩余有效期。用于API Gateway鉴权时快速验证用户会话有效性，减少数据库查询。",
      "fields": [
        {"name": "key", "type": "string", "required": true, "description": "Redis key，格式 session:{user_id}:{jwt_id}"},
        {"name": "user_id", "type": "bigint", "required": true, "description": "用户ID"},
        {"name": "username", "type": "string", "required": true, "description": "用户名"},
        {"name": "token", "type": "string", "required": true, "description": "JWT token值"},
        {"name": "expires_at", "type": "datetime", "required": true, "description": "会话过期时间"}
      ]
    },
    {
      "name": "deployment_status",
      "type": "store",
      "ownership": "owned",
      "description": "部署任务实时状态缓存。Redis Key格式: deployment:{deployment_id}:status，Value为JSON序列化状态数据，TTL为部署完成时间+1小时。用于Deployment Orchestrator在各部署阶段快速读写和WebSocket推送实时进度。",
      "fields": [
        {"name": "key", "type": "string", "required": true, "description": "Redis key，格式 deployment:{deployment_id}:status"},
        {"name": "deployment_id", "type": "bigint", "required": true, "description": "部署任务ID"},
        {"name": "status", "type": "enum('pending','running','success','failed')", "required": true, "description": "部署状态"},
        {"name": "progress", "type": "int", "required": true, "description": "进度百分比0-100"},
        {"name": "message", "type": "string", "required": false, "description": "当前状态描述信息"}
      ]
    },
    {
      "name": "config_cache",
      "type": "store",
      "ownership": "owned",
      "description": "项目列表与环境配置热点数据缓存。Redis Key格式: config:{resource_type}:{resource_id}，Value为JSON序列化配置数据，基础TTL=300秒。用于Project Management Service和Environment Management Service加速读取热点数据。",
      "fields": [
        {"name": "key", "type": "string", "required": true, "description": "Redis key，格式 config:{resource_type}:{resource_id}"},
        {"name": "resource_type", "type": "enum('project_list','environment','key')", "required": true, "description": "资源类型"},
        {"name": "resource_id", "type": "bigint", "required": false, "description": "资源ID，项目列表场景为空"},
        {"name": "data", "type": "json", "required": true, "description": "缓存的配置数据JSON"}
      ]
    },
    {
      "name": "ssh_test_result",
      "type": "store",
      "ownership": "owned",
      "description": "SSH连接测试临时结果缓存。Redis Key格式: ssh_test:{env_id}:{key_id}，Value为JSON序列化测试结果，TTL=600秒。用于Key Management Service连通性测试后暂存结果供Web Console查询。",
      "fields": [
        {"name": "key", "type": "string", "required": true, "description": "Redis key，格式 ssh_test:{env_id}:{key_id}"},
        {"name": "env_id", "type": "bigint", "required": true, "description": "环境ID"},
        {"name": "key_id", "type": "bigint", "required": true, "description": "密钥ID"},
        {"name": "success", "type": "boolean", "required": true, "description": "连接测试是否成功"},
        {"name": "latency_ms", "type": "int", "required": false, "description": "连接延迟毫秒数"},
        {"name": "server_info", "type": "string", "required": false, "description": "服务器信息"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "Set Session",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/session/set",
      "description": "存储用户JWT会话到Redis缓存。由API Gateway在用户登录认证成功后调用，写入会话信息并设置TTL等于JWT剩余有效期。",
      "parameters": [
        {"name": "user_id", "type": "bigint", "description": "用户ID"},
        {"name": "username", "type": "string", "description": "用户名"},
        {"name": "token", "type": "string", "description": "JWT token值"},
        {"name": "ttl", "type": "int", "description": "缓存过期时间，单位秒，与JWT过期时间一致"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis操作失败，写入缓存异常"}
      ]
    },
    {
      "name": "Get Session",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/session/get",
      "description": "获取用户JWT会话信息。由API Gateway在请求鉴权时调用，根据user_id和jwt_id从Redis读取会话。",
      "parameters": [
        {"name": "user_id", "type": "bigint", "description": "用户ID"},
        {"name": "jwt_id", "type": "string", "description": "JWT token的唯一标识"}
      ],
      "response": {
        "status": 200,
        "body": {
          "user_id": "bigint",
          "username": "string",
          "token": "string",
          "expires_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "会话不存在或已过期"},
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Delete Session",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/session/delete",
      "description": "删除用户JWT会话缓存。由API Gateway在用户登出或JWT失效（如刷新token）时调用，从Redis中移除对应会话。",
      "parameters": [
        {"name": "user_id", "type": "bigint", "description": "用户ID"},
        {"name": "jwt_id", "type": "string", "description": "JWT token的唯一标识"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Set Deployment Status",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/deployment/status/set",
      "description": "更新部署任务实时状态到Redis缓存。由Deployment Orchestrator在各部署阶段转换时调用（pending→running→success/failed），WebSocket推送依赖此缓存的实时数据。",
      "parameters": [
        {"name": "deployment_id", "type": "bigint", "description": "部署任务ID"},
        {"name": "status", "type": "string", "description": "部署状态"},
        {"name": "progress", "type": "int", "description": "进度百分比"},
        {"name": "message", "type": "string", "description": "状态描述信息"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Get Deployment Status",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/deployment/status/get",
      "description": "获取部署任务实时状态。由Deployment Orchestrator在WebSocket推送和前端查询时调用，返回当前进度和状态。",
      "parameters": [
        {"name": "deployment_id", "type": "bigint", "description": "部署任务ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "deployment_id": "bigint",
          "status": "string",
          "progress": "int",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 404, "message": "部署状态不存在或已过期"},
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Set Config Cache",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/config/set",
      "description": "缓存热点配置数据。由Project Management Service和Environment Management Service在读取数据库后主动写入，后续请求优先读取缓存。",
      "parameters": [
        {"name": "resource_type", "type": "string", "description": "资源类型：project_list|environment|key"},
        {"name": "resource_id", "type": "bigint", "description": "资源ID，project_list时传0"},
        {"name": "data", "type": "json", "description": "配置数据JSON"},
        {"name": "ttl", "type": "int", "description": "缓存过期时间，单位秒，默认300"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Get Config Cache",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/config/get",
      "description": "读取热点配置缓存。由各业务服务在查询数据库前调用，命中缓存则直接返回，减少数据库查询。",
      "parameters": [
        {"name": "resource_type", "type": "string", "description": "资源类型：project_list|environment|key"},
        {"name": "resource_id", "type": "bigint", "description": "资源ID，project_list时传0"}
      ],
      "response": {
        "status": 200,
        "body": {
          "resource_type": "string",
          "resource_id": "bigint",
          "data": "json",
          "cached_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "缓存不存在或已过期"},
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Delete Config Cache",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/config/delete",
      "description": "删除指定热点配置缓存。由业务服务在数据发生变更时调用，使对应的缓存失效，确保后续读取回源数据库。",
      "parameters": [
        {"name": "resource_type", "type": "string", "description": "资源类型：project_list|environment|key"},
        {"name": "resource_id", "type": "bigint", "description": "资源ID，project_list时传0"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Set SSH Test Result",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/ssh/test/set",
      "description": "存储SSH连接测试结果到Redis缓存。由Key Management Service在连通性测试完成后调用，结果临时缓存供Web Console查询。",
      "parameters": [
        {"name": "env_id", "type": "bigint", "description": "环境ID"},
        {"name": "key_id", "type": "bigint", "description": "密钥ID"},
        {"name": "success", "type": "boolean", "description": "测试是否成功"},
        {"name": "latency_ms", "type": "int", "description": "连接延迟，单位毫秒"},
        {"name": "server_info", "type": "string", "description": "服务器信息，如OS版本和主机名"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string"
        }
      },
      "error_codes": [
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Get SSH Test Result",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/ssh/test/get",
      "description": "读取SSH连接测试结果缓存。由API Gateway转发Web Console轮询请求时调用，获取之前的连通性测试结果。",
      "parameters": [
        {"name": "env_id", "type": "bigint", "description": "环境ID"},
        {"name": "key_id", "type": "bigint", "description": "密钥ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "env_id": "bigint",
          "key_id": "bigint",
          "success": "boolean",
          "latency_ms": "int",
          "server_info": "string"
        }
      },
      "error_codes": [
        {"code": 404, "message": "测试结果不存在或已过期"},
        {"code": 500, "message": "Redis操作失败"}
      ]
    },
    {
      "name": "Health Check",
      "method": "INTERNAL",
      "endpoint": "/internal/cache/health",
      "description": "Redis健康检查接口。用于服务治理和监控告警，执行Redis PING命令检测连接状态和延迟。",
      "parameters": [],
      "response": {
        "status": 200,
        "body": {
          "status": "string",
          "ping_ms": "int"
        }
      },
      "error_codes": [
        {"code": 503, "message": "Redis服务不可用或响应超时"}
      ]
    }
  ],
  "error_handling": "Cache模块的错误处理策略：\n(1) Redis操作异常 — 所有Redis读写操作失败时返回HTTP 500，响应体包含success=false和具体错误message。调用方需实现降级策略：对于session和config缓存，降级到直接查询Primary Database；对于deployment_status缓存，降级为轮询数据库部署记录；对于ssh_test_result缓存，降级为前端提示重新测试。\n(2) 缓存未命中（404） — Get类接口在key不存在或已过期时返回404，调用方视为缓存缺失，回源数据库查询并重新填充缓存。\n(3) 缓存穿透防护 — 对于热点key（如项目列表），采用SETNX互斥锁机制防止并发缓存重建，未获取到锁的请求回源数据库。\n(4) 缓存雪崩防护 — key的TTL采用基础值+随机偏移（±30%）的策略，避免大量key同时过期导致数据库压力骤增。\n(5) 连接管理 — Redis连接池配置最小连接数5、最大连接数20，连接空闲超过300秒自动回收。连接异常时健康检查接口返回503，触发监控告警。\n(6) 内存管理 — 配置Redis maxmemory和volatile-lru淘汰策略，避免缓存数据无限制增长。对大value（>10KB）进行压缩存储。"
}
