  "module_boundary": {
    "in_scope": [
      "接收部署请求，解析参数（项目、环境、版本）",
      "前置检查：验证项目与环境存在性，远程主机可达性",
      "编排部署流程：通过 SFTP 上传文件 → 创建远程版本目录 → 调用脚本引擎生成启动脚本 → 远程执行脚本 → 原子替换软链接",
      "全程状态更新与日志记录（progress、current_step、log）",
      "失败处理：保留原有版本，不更新软链接，仅标记部署失败",
      "生产环境二次确认预留（状态机停留点）"
    ],
    "out_of_scope": [
      "用户的认证与授权（由网关或 OAuth 处理）",
      "项目管理（增删改查项目）—— 属于项目管理服务",
      "环境信息的维护（增删改环境配置）—— 属于环境管理服务",
      "脚本模板语法解析与生成具体命令—— 属于脚本引擎",
      "历史日志的持久化与查询聚合—— 属于历史日志服务"
    ],
    "owned_components": [
      "CMP-005"
    ],
    "owned_contracts": [
      "CTR-012",
      "CTR-013"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "负责一键部署流程的编排，包括前置检查、文件上传、远程目录创建、脚本生成与执行、软链接更新，并记录部署结果。",
    "dependencies": [
      "项目管理服务",
      "环境管理服务",
      "脚本引擎",
      "历史与日志服务",
      "SSH/SFTP 基础设施"
    ],
    "tech_stack": [
      "TypeScript",
      "Node.js",
      "Express",
      "SQLite 3",
      "ssh2 + ssh2-sftp-client",
      "winston"
    ]
  },
