{
  "meta": {
    "doc_id": "lld-部署执行器-001",
    "type": "lld",
    "module": "部署执行器",
    "module_type": "service",
    "version": 1,
    "status": "draft",
    "title": "部署执行器 LLD",
    "author": "System",
    "created": "2025-01-01T00:00:00Z"
  },
  "source": {
    "prd": {
      "doc_id": "prd-deployment-001",
      "version": 1
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1
    }
  },
  "module_boundary": {
    "in_scope": [
      "异步接收部署任务（环境 ID、临时文件路径、部署记录 ID）",
      "通过 SSH 客户端模块连接远程服务器",
      "生成版本标识，创建远程版本目录",
      "上传部署文件（SFTP）",
      "根据模板生成启动脚本并赋予执行权限",
      "更新或创建 current 符号链接",
      "逐行推送部署日志到 WebSocket 通道",
      "更新部署记录状态（成功/失败）",
      "处理回滚操作：切换 current 符号链接到指定版本目录"
    ],
    "out_of_scope": [
      "部署 API 接口的 HTTP 请求处理（由后端 API 服务负责）",
      "WebSocket 连接的建立与管理（由后端 API 服务负责）",
      "SSH 连接的底层实现（由 SSH 客户端模块提供）",
      "密钥的加密存储与解密（由密钥加密服务负责）",
      "部署记录数据表的定义与直接管理（归属 Primary Database）",
      "部署记录状态的变更通知给前端（由 WebSocket 推送负责，本模块仅推送日志）"
    ],
    "owned_components": [
      "CMP-008"
    ],
    "owned_contracts": [],
    "consumed_contracts": [
      "SC-001",
      "SC-002",
      "SC-003",
      "SC-004"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "部署执行器服务负责异步执行部署和回滚任务，包括通过SSH连接远程服务器、文件上传、脚本生成、符号链接管理以及实时日志推送。",
    "dependencies": [
      "SSH 客户端模块（内部模块，提供 SSH 连接和操作接口）",
      "密钥加密服务（内部服务，提供私钥解密能力）",
      "PostgreSQL 数据库（存储部署记录）",
      "WebSocket 通道（由后端 API 服务管理，本模块推送日志消息）"
    ],
    "tech_stack": [
      "Python",
      "FastAPI",
      "Python asyncio 配合后台任务（FastAPI BackgroundTasks）或 Celery（可选）",
      "Paramiko"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-001",
      "coverage": "full",
      "sad_component_ids": [
        "CMP-008"
      ],
      "sad_contract_ids": []
    },
    {
      "requirement_id": "REQ-002",
      "coverage": "full",
      "sad_component_ids": [],
      "sad_contract_ids": [
        "SC-001"
      ]
    },
    {
      "requirement_id": "REQ-003",
      "coverage": "full",
      "sad_component_ids": [],
      "sad_contract_ids": [
        "SC-002"
      ]
    },
    {
      "requirement_id": "REQ-004",
      "coverage": "full",
      "sad_component_ids": [
        "CMP-008"
      ],
      "sad_contract_ids": []
    }
  ],
  "domain_objects": [
    {
      "type": "dto",
      "id": "DO-001",
      "name": "DeploymentTask",
      "description": "代表一个部署任务，包含任务输入和状态",
      "fields": [
        {
          "name": "task_id",
          "type": "string",
          "required": true,
          "description": "唯一标识"
        },
        {
          "name": "input",
          "type": "DeploymentTaskInput",
          "required": true,
          "description": "部署输入"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "任务状态：pending, running, succeeded, failed"
        },
        {
          "name": "log_stream",
          "type": "WebSocket",
          "required": true,
          "description": "日志推送通道"
        }
      ],
      "methods": [
        {
          "name": "start",
          "description": "开始执行部署任务",
          "parameters": [],
          "return_type": "void"
        }
      ]
    }
  ],
  "data_models": [
    {
      "type": "dto",
      "id": "DM-001",
      "name": "DeploymentTaskInput",
      "description": "部署任务输入参数",
      "fields": [
        {
          "name": "environment_id",
          "type": "string",
          "required": true,
          "description": "部署目标环境 ID"
        },
        {
          "name": "temp_file_path",
          "type": "string",
          "required": true,
          "description": "待部署文件的临时路径"
        },
        {
          "name": "deployment_record_id",
          "type": "string",
          "required": true,
          "description": "部署记录 ID"
        }
      ]
    },
    {
      "type": "dto",
      "id": "DM-002",
      "name": "RollbackTaskInput",
      "description": "回滚任务输入参数",
      "fields": [
        {
          "name": "deployment_record_id",
          "type": "string",
          "required": true,
          "description": "要回滚的部署记录 ID"
        },
        {
          "name": "target_version_directory",
          "type": "string",
          "required": true,
          "description": "目标版本目录名称"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "type": "service_interface",
      "id": "IF-001",
      "name": "DeploymentExecutor",
      "description": "部署执行器内部接口",
      "methods": [
        {
          "method": "execute_deployment",
          "description": "执行部署任务",
          "parameters": [
            {
              "name": "deployment_input",
              "type": "DeploymentTaskInput",
              "required": true,
              "description": "部署任务输入参数"
            }
          ],
          "return_type": "object"
        },
        {
          "method": "execute_rollback",
          "description": "执行回滚任务",
          "parameters": [
            {
              "name": "rollback_input",
              "type": "RollbackTaskInput",
              "required": true,
              "description": "回滚任务输入参数"
            }
          ],
          "return_type": "object"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "SSH 客户端模块接口",
      "description": "SSH 客户端模块接口，提供远程连接和文件传输能力",
      "methods": [
        {
          "name": "connect",
          "description": "建立 SSH 连接",
          "parameters": {
            "host": "string",
            "port": "integer",
            "username": "string",
            "private_key": "string"
          },
          "returns": "SSHClient"
        },
        {
          "name": "upload_file",
          "description": "上传文件到远程服务器",
          "parameters": {
            "local_path": "string",
            "remote_path": "string"
          },
          "returns": "void"
        },
        {
          "name": "execute_command",
          "description": "在远程服务器执行命令",
          "parameters": {
            "command": "string"
          },
          "returns": "CommandResult"
        },
        {
          "name": "close",
          "description": "关闭 SSH 连接",
          "parameters": {},
          "returns": "void"
        }
      ]
    },
    {
      "id": "SC-002",
      "name": "密钥加密服务接口",
      "description": "密钥加密服务接口，提供私钥解密能力",
      "methods": [
        {
          "name": "decrypt_private_key",
          "description": "解密私钥",
          "parameters": {
            "encrypted_key": "string"
          },
          "returns": "string"
        }
      ]
    },
    {
      "id": "SC-003",
      "name": "部署记录数据访问接口",
      "description": "部署记录数据访问接口，用于更新部署记录状态",
      "methods": [
        {
          "name": "update_deployment_record",
          "description": "更新部署记录",
          "parameters": {
            "record_id": "string",
            "status": "string",
            "message": "string"
          },
          "returns": "void"
        }
      ]
    },
    {
      "id": "SC-004",
      "name": "WebSocket 推送接口",
      "description": "WebSocket 推送接口，用于实时日志推送",
      "methods": [
        {
          "name": "send_log",
          "description": "向 WebSocket 通道发送日志",
          "parameters": {
            "channel": "WebSocket",
            "message": "string"
          },
          "returns": "void"
        }
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "SSH 连接必须先建立才能执行上传或命令操作",
      "部署任务必须在后台异步执行，不阻塞 API 响应",
      "部署或回滚完成后必须更新部署记录的状态"
    ],
    "validations": [
      {
        "type": "precondition",
        "description": "部署任务必须包含有效的环境 ID、临时文件路径和部署记录 ID",
        "expression": "environment_id != null && temp_file_path != null && deployment_record_id != null"
      }
    ]
  },
  "error_handling": {
    "strategy": "捕获并记录所有异常，通过日志通道推送错误信息，并更新部署记录为失败状态。",
    "error_codes": [
      {
        "code": "ERR_SSH_CONNECTION_FAILED",
        "description": "SSH 连接失败"
      },
      {
        "code": "ERR_FILE_UPLOAD_FAILED",
        "description": "文件上传失败"
      },
      {
        "code": "ERR_COMMAND_EXECUTION_FAILED",
        "description": "远程命令执行失败"
      }
    ]
  },
  "lld_objects": [
    {
      "type": "service",
      "id": "LLD-OBJ-001",
      "ownership": "owned",
      "name": "DeploymentService",
      "description": "部署服务实现类",
      "dependencies": [
        "SSHClient",
        "DeploymentRepository",
        "WebSocketChannel"
      ],
      "methods": [
        {
          "name": "execute_deployment",
          "description": "执行部署逻辑",
          "parameters": {
            "deployment_input": "DeploymentTaskInput"
          },
          "return_type": "void",
          "visibility": "public"
        },
        {
          "name": "execute_rollback",
          "description": "执行回滚逻辑",
          "parameters": {
            "rollback_input": "RollbackTaskInput"
          },
          "return_type": "void",
          "visibility": "public"
        }
      ]
    }
  ]
}