  "interfaces": [
    {
      "id": "IF-001",
      "name": "发起部署",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-012",
      "provider_component_id": "CMP-005",
      "method": "POST",
      "endpoint": "/api/deployments",
      "description": "开始一键部署流程，返回部署 ID 用于跟踪状态和日志",
      "parameters": [],
      "request_body": {
        "project_id": "string",
        "environment_id": "string",
        "version": "string"
      },
      "response": {
        "status": 202,
        "body": {
          "deployment_id": "string",
          "message": "部署已启动"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "VALIDATION_ERROR",
          "message": "参数错误"
        },
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "项目或环境不存在"
        },
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "服务器内部错误"
        }
      ],
      "auth": {
        "required": true,
        "type": "bearer"
      },
      "rate_limit": {
        "max_requests": 10,
        "window": "1m"
      }
    },
    {
      "id": "IF-002",
      "name": "查询部署状态",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-013",
      "provider_component_id": "CMP-005",
      "method": "GET",
      "endpoint": "/api/deployments/{deployment_id}",
      "description": "获取指定部署的详细状态、进度和日志",
      "parameters": [
        {
          "name": "deployment_id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "部署ID"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "id": "string",
          "project_id": "string",
          "environment_id": "string",
          "version": "string",
          "status": "string",
          "progress": "number",
          "current_step": "string",
          "log": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "NOT_FOUND",
          "message": "部署记录不存在"
        },
        {
          "status": 500,
          "code": "INTERNAL_ERROR",
          "message": "服务器内部错误"
        }
      ],
      "auth": {
        "required": true,
        "type": "bearer"
      },
      "rate_limit": {
        "max_requests": 100,
        "window": "1m"
      }
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentOrchestratorService",
      "description": "部署执行器对外提供的服务契约",
      "status": "active",
      "version": 1,
      "methods": [
        {
          "name": "initiateDeployment",
          "description": "启动一次部署流程",
          "signature": "initiateDeployment(projectId: string, environmentId: string, version: string): DeploymentResult",
          "parameters": [
            {
              "name": "projectId",
              "type": "string",
              "required": true,
              "description": "项目唯一标识"
            },
            {
              "name": "environmentId",
              "type": "string",
              "required": true,
              "description": "环境唯一标识"
            },
            {
              "name": "version",
              "type": "string",
              "required": true,
              "description": "部署版本号"
            }
          ],
          "return": {
            "type": "DeploymentResult",
            "description": "包含 deploymentId 和初始状态"
          },
          "preconditions": [
            "projectId 对应的项目存在且状态为 active",
            "environmentId 对应的环境存在且属于该项目，且处于可部署状态",
            "version 格式有效",
            "SSH 主机可达"
          ],
          "postconditions": [
            "创建了一条状态为 pending 的部署记录",
            "返回唯一的 deploymentId",
            "若任何前置条件不满足，返回明确的错误信息，不创建部署记录"
          ]
        },
        {
          "name": "getDeploymentStatus",
          "description": "查询部署的当前状态和日志",
          "signature": "getDeploymentStatus(deploymentId: string): DeploymentStatus",
          "parameters": [
            {
              "name": "deploymentId",
              "type": "string",
              "required": true,
              "description": "部署唯一标识"
            }
          ],
          "return": {
            "type": "DeploymentStatus",
            "description": "部署的完整状态信息，包括进度、当前步骤和日志"
          },
          "preconditions": [
            "deploymentId 对应的部署记录存在"
          ],
          "postconditions": [
            "返回部署记录的状态快照",
            "若部署记录不存在，返回 404 错误"
          ]
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "只有在项目和环境均存在且状态为 active 时，才能发起部署",
      "type": "precondition",
      "related_methods": [
        "initiateDeployment"
      ]
    },
    {
      "id": "BR-002",
      "description": "部署状态流转必须遵循: pending -> in_progress -> (awaiting_confirmation ->) success/failed",
      "type": "invariant",
      "related_methods": [
        "initiateDeployment",
        "getDeploymentStatus"
      ]
    },
    {
      "id": "BR-003",
      "description": "生产环境部署时，必须在版本文件上传与脚本生成后、软链接更新前，进入 awaiting_confirmation 状态，等待人工确认",
      "type": "workflow",
      "related_methods": [
        "initiateDeployment"
      ]
    },
    {
      "id": "BR-004",
      "description": "部署失败时，不得更新软链接，保持原有版本运行，只记录失败状态",
      "type": "error_handling",
      "related_methods": [
        "initiateDeployment"
      ]
    },
    {
      "id": "BR-005",
      "description": "同项目同环境下，同时只允许一个部署进行中（in_progress 或 awaiting_confirmation），新部署请求需等待或拒绝",
      "type": "concurrency",
      "related_methods": [
        "initiateDeployment"
      ]
    }
  ],
  "error_handling": {
    "strategy": "分层错误处理，对外统一错误格式，对内细化错误类型并记录日志",
    "error_codes": [
      {
        "code": "PROJECT_NOT_FOUND",
        "message": "指定的项目不存在",
        "http_status": 404
      },
      {
        "code": "ENVIRONMENT_NOT_FOUND",
        "message": "指定的环境不存在或不属于该项目",
        "http_status": 404
      },
      {
        "code": "HOST_UNREACHABLE",
        "message": "远程主机不可达",
        "http_status": 502
      },
      {
        "code": "AWAITING_CONFIRMATION_REQUIRED",
        "message": "生产环境部署需要人工确认",
        "http_status": 202
      },
      {
        "code": "DEPLOYMENT_IN_PROGRESS",
        "message": "同环境下已有部署正在进行",
        "http_status": 409
      }
    ],
    "logging_policy": "所有错误均需记录到日志系统，包含错误码、消息、堆栈信息（开发环境）、请求上下文"
  }
}