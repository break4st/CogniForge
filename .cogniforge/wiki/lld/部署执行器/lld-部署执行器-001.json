  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeploymentOrchestrator",
      "object_type": "domain_service",
      "description": "核心部署编排服务，负责整个部署生命周期管理",
      "responsibilities": [
        "接收部署请求",
        "执行前置检查（项目、环境、主机可达性）",
        "编排部署步骤，调用 SSH/SFTP 与脚本引擎",
        "管理部署状态与进度",
        "处理失败逻辑与回滚",
        "生产环境二次确认"
      ],
      "dependencies": [
        "ProjectRepository",
        "EnvironmentRepository",
        "SSHService",
        "ScriptEngine",
        "DeploymentRepository",
        "HistoryLogger"
      ],
      "attributes": [],
      "operations": [
        {
          "name": "initiateDeployment",
          "parameters": [
            {
              "name": "projectId",
              "type": "string"
            },
            {
              "name": "environmentId",
              "type": "string"
            },
            {
              "name": "version",
              "type": "string"
            }
          ],
          "return_type": "DeploymentResult",
          "description": "发起部署流程，返回部署标识与初始状态"
        },
        {
          "name": "getDeploymentStatus",
          "parameters": [
            {
              "name": "deploymentId",
              "type": "string"
            }
          ],
          "return_type": "DeploymentStatus",
          "description": "查询部署状态与日志"
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "Deployment",
      "object_type": "entity",
      "description": "部署实体，记录一次部署的所有信息",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "description": "唯一标识"
        },
        {
          "name": "projectId",
          "type": "string",
          "description": "关联项目ID"
        },
        {
          "name": "environmentId",
          "type": "string",
          "description": "关联环境ID"
        },
        {
          "name": "version",
          "type": "string",
          "description": "部署版本号"
        },
        {
          "name": "status",
          "type": "DeploymentStatus",
          "description": "部署状态枚举：pending, in_progress, awaiting_confirmation, success, failed"
        },
        {
          "name": "progress",
          "type": "integer",
          "description": "进度百分比 0-100"
        },
        {
          "name": "currentStep",
          "type": "string",
          "description": "当前执行的步骤描述"
        },
        {
          "name": "log",
          "type": "string",
          "description": "累积的日志文本"
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "description": "创建时间"
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "description": "最后更新时间"
        }
      ],
      "operations": [
        {
          "name": "updateStatus",
          "parameters": [
            {
              "name": "newStatus",
              "type": "DeploymentStatus"
            }
          ],
          "return_type": "void",
          "description": "更新部署状态"
        },
        {
          "name": "appendLog",
          "parameters": [
            {
              "name": "logEntry",
              "type": "string"
            }
          ],
          "return_type": "void",
          "description": "追加日志信息"
        }
      ]
    },
    {
      "id": "DO-003",
      "name": "DeploymentStateMachine",
      "object_type": "domain_service",
      "description": "管理部署状态转换逻辑，确保状态流转符合业务规则",
      "responsibilities": [
        "验证状态转换合法性",
        "控制生产环境二次确认状态",
        "触发状态变更的副作用（如记录日志）"
      ],
      "dependencies": [],
      "attributes": [],
      "operations": [
        {
          "name": "transition",
          "parameters": [
            {
              "name": "deployment",
              "type": "Deployment"
            },
            {
              "name": "targetStatus",
              "type": "DeploymentStatus"
            }
          ],
          "return_type": "void",
          "description": "执行状态转换，若不合法则抛出异常",
          "preconditions": [
            "当前状态允许转换至 targetStatus"
          ],
          "postconditions": [
            "deployment.status 变更为 targetStatus",
            "若转换失败记录错误日志"
          ]
        }
      ]
    },
    {
      "id": "DO-004",
      "name": "SSHExecutor",
      "object_type": "domain_service",
      "description": "封装 SSH 和 SFTP 操作，提供远程命令执行、文件上传、目录管理等能力",
      "responsibilities": [
        "建立 SSH 连接",
        "执行远程命令",
        "通过 SFTP 上传文件",
        "管理远程目录（创建、删除）",
        "执行原子化软链接替换"
      ],
      "dependencies": [],
      "attributes": [],
      "operations": [
        {
          "name": "executeCommand",
          "parameters": [
            {
              "name": "command",
              "type": "string"
            }
          ],
          "return_type": "CommandResult",
          "description": "在远程主机执行 shell 命令",
          "preconditions": [
            "SSH 连接已建立"
          ],
          "postconditions": [
            "命令执行完毕，返回标准输出与错误输出"
          ]
        },
        {
          "name": "uploadFile",
          "parameters": [
            {
              "name": "localPath",
              "type": "string"
            },
            {
              "name": "remotePath",
              "type": "string"
            }
          ],
          "return_type": "void",
          "description": "通过 SFTP 上传文件",
          "preconditions": [
            "SFTP 连接已建立"
          ],
          "postconditions": [
            "远程路径上存在上传的文件"
          ]
        }
      ]
    },
    {
      "id": "DO-005",
      "name": "ScriptGenerator",
      "object_type": "domain_service",
      "description": "调用脚本引擎生成部署所需的启动脚本，屏蔽模板与语法细节",
      "responsibilities": [
        "根据项目、环境参数生成脚本内容",
        "将脚本保存为远程可执行文件"
      ],
      "dependencies": [
        "脚本引擎外部服务"
      ],
      "attributes": [],
      "operations": [
        {
          "name": "generate",
          "parameters": [
            {
              "name": "project",
              "type": "Project"
            },
            {
              "name": "environment",
              "type": "Environment"
            },
            {
              "name": "versionDir",
              "type": "string"
            }
          ],
          "return_type": "string",
          "description": "生成脚本内容并返回脚本在远程主机上的路径",
          "preconditions": [
            "脚本引擎服务可用"
          ],
          "postconditions": [
            "远程主机上存在生成的脚本文件"
          ]
        }
      ]
    }
  ],
