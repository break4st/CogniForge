{
  "meta": {
    "doc_id": "lld-DeploymentService-001",
    "title": "DeploymentService 低层设计文档",
    "author": "System",
    "created": "2025-04-07",
    "type": "lld",
    "module": "DeploymentService",
    "module_type": "service",
    "version": 1
  },
  "source": {
    "prd": {
      "doc_id": "prd-EasyDeploy-001",
      "version": 1
    },
    "sad": {
      "doc_id": "sad-EasyDeploy-001",
      "version": 1
    }
  },
  "overview": {
    "description": "DeploymentService 负责编排部署流程，包括创建版本目录、上传文件、执行脚本和更新软链接，并通过 IPC 推送实时日志。"
  },
  "lld_objects": {
    "deployment_executor": {
      "type": "deployment_executor",
      "functions": [
        {
          "name": "executeDeploy",
          "description": "执行部署流程：创建目录、上传文件、生成脚本、执行前后脚本、更新软链接",
          "parameters": {
            "request": "DeployExecuteRequest"
          },
          "returns": "DeployExecuteResponse",
          "implementation": "依次调用内部步骤，捕获异常并转换为统一错误响应",
          "errors": [
            "SSH_CONNECTION_FAILED",
            "SFTP_TRANSFER_FAILED",
            "SCRIPT_EXECUTION_FAILED",
            "DIRECTORY_OPERATION_FAILED",
            "INVALID_REQUEST",
            "ENV_CONFIG_UNAVAILABLE"
          ]
        }
      ],
      "dependencies": [
        "CryptoService",
        "EnvironmentService",
        "SshClient"
      ],
      "methods": {
        "createVersionDir": {
          "name": "createVersionDir",
          "description": "在目标服务器创建带时间戳的版本目录",
          "parameters": {
            "path": "string",
            "timestamp": "string"
          },
          "returns": "string"
        },
        "uploadPackage": {
          "name": "uploadPackage",
          "description": "将部署包上传到目标目录",
          "parameters": {
            "localPath": "string",
            "remotePath": "string"
          },
          "returns": "void"
        },
        "executeScript": {
          "name": "executeScript",
          "description": "执行指定脚本",
          "parameters": {
            "script": "string",
            "cwd": "string"
          },
          "returns": "ScriptExecutionResult"
        },
        "updateSymlink": {
          "name": "updateSymlink",
          "description": "更新符号链接指向新版本目录",
          "parameters": {
            "target": "string",
            "link": "string"
          },
          "returns": "void"
        }
      },
      "events": [
        {
          "name": "deploy:log",
          "description": "推送实时部署日志",
          "payload": {
            "message": "string",
            "level": "string"
          }
        }
      ]
    }
  },
  "data_models": {
    "DeploymentConfigView": {
      "type": "object",
      "description": "部署配置视图，包含脚本内容和密钥引用",
      "fields": {
        "preScript": {
          "type": "string",
          "description": "前置脚本内容"
        },
        "postScript": {
          "type": "string",
          "description": "后置脚本内容"
        },
        "secretRefs": {
          "type": "array",
          "description": "敏感信息引用列表",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ScriptExecutionResult": {
      "type": "object",
      "description": "脚本执行结果",
      "fields": {
        "exitCode": {
          "type": "integer",
          "description": "退出码"
        },
        "stdout": {
          "type": "string",
          "description": "标准输出"
        },
        "stderr": {
          "type": "string",
          "description": "标准错误"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "description": "统一错误响应格式",
      "fields": {
        "code": {
          "type": "integer",
          "description": "错误码"
        },
        "error": {
          "type": "string",
          "description": "错误类型"
        },
        "detail": {
          "type": "string",
          "description": "错误详情"
        }
      }
    }
  },
  "domain_objects": {
    "Deployment": {
      "description": "部署领域对象，封装单次部署的上下文",
      "attributes": {
        "environmentId": "string",
        "packageId": "string",
        "config": "DeploymentConfigView",
        "versionDir": "string"
      }
    },
    "DeployLog": {
      "description": "部署日志事件对象",
      "attributes": {
        "message": "string",
        "level": "string",
        "timestamp": "string"
      }
    }
  },
  "service_contracts": {
    "DeploymentExecutorContract": {
      "interface_id": "IF-001",
      "description": "部署执行契约，定义同步请求/响应",
      "preconditions": [
        "环境ID有效且已配置SSH凭据",
        "项目包路径可访问且校验和正确"
      ],
      "postconditions": [
        "版本目录已创建",
        "文件已上传",
        "脚本已执行",
        "软链接已更新或回滚"
      ]
    },
    "DeployLogContract": {
      "interface_id": "IF-002",
      "description": "部署日志事件契约，定义异步事件推送",
      "preconditions": [],
      "postconditions": [
        "日志事件已成功推送到订阅者"
      ]
    }
  },
  "interfaces": [
    {
      "id": "IF-001",
      "name": "DeployExecuteRequest",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-001",
      "provider_component_id": "CMP-001",
      "method": "INTERNAL",
      "endpoint": "ipc://deploy:execute",
      "description": "接收来自 UI 的部署请求，包含目标环境ID、项目包路径及部署配置。",
      "parameters": [],
      "request_body": {
        "environmentId": "string",
        "packageId": "string",
        "config": "DeploymentConfigView"
      },
      "response": {
        "success": "boolean",
        "versionDir": "string",
        "message": "string",
        "body": {
          "versionDir": "string",
          "message": "string"
        }
      },
      "error_codes": [
        "4001",
        "4002",
        "5001",
        "5002",
        "5003",
        "5004"
      ]
    },
    {
      "id": "IF-002",
      "name": "DeployLogEvent",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-002",
      "provider_component_id": "CMP-001",
      "method": "EVENT",
      "endpoint": "ipc://deploy:log",
      "description": "推送实时部署日志到渲染进程。",
      "parameters": [],
      "request_body": {},
      "response": {
        "message": "string",
        "level": "string",
        "timestamp": "string",
        "body": {
          "message": "string",
          "level": "string",
          "timestamp": "string"
        }
      },
      "error_codes": []
    }
  ],
  "business_rules": {
    "invariants": [
      "部署流程必须按顺序执行：创建版本目录 -> 上传文件 -> 执行前置脚本 -> 更新软链接 -> 执行后置脚本",
      "版本目录名称格式为：项目名_版本_时间戳",
      "部署包上传前必须校验MD5或SHA256值与前端传入值一致",
      "脚本执行失败（非零返回码）必须立即终止部署并回滚（可选）",
      "软链接更新必须原子操作（先创建临时链接，再原子替换）",
      "所有远程操作必须通过SSH连接，且连接超时设为10秒"
    ]
  },
  "module_boundary": {
    "in_scope": [
      "编排部署步骤：目录创建、文件上传、脚本生成、前后脚本执行、软链更新",
      "生成时间戳版本目录名",
      "通过 node-ssh 与远程服务器交互（SFTP/SSH）",
      "从 EnvironmentService 获取解密后的环境配置",
      "根据模板生成 start.sh 并赋予执行权限",
      "调用 CryptoService 解密敏感信息",
      "推送实时部署日志（通过 IPC 事件）",
      "返回部署结果（成功/失败、版本目录名）"
    ],
    "out_of_scope": [
      "UI 渲染与用户交互（由 DeployPanel 负责）",
      "环境配置的增删改查（由 EnvironmentService 负责）",
      "版本历史持久化（由 VersionHistoryService 负责）",
      "SSH 连接池管理（由 SshClient 基础设施提供）",
      "日志存储或历史查询（由 DeploymentLogService 负责）"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-004",
      "description": "用户应能通过 UI 触发部署流程，系统自动完成文件上传、脚本执行和软链更新，并实时显示日志。",
      "coverage": "full",
      "notes": "DeploymentService 的 deploy:execute 接口实现整个部署流水线，并通过 IPC 事件推送日志。",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001"
      ]
    },
    {
      "requirement_id": "REQ-005",
      "description": "部署应支持自定义前后脚本，脚本执行输出应实时反馈给用户。",
      "coverage": "full",
      "notes": "deploy 方法在执行前/后脚本时，通过 SshClient 流式获取输出，并转换为 IPC 日志事件。",
      "sad_component_ids": [
        "CMP-001"
      ],
      "sad_contract_ids": [
        "CTR-001"
      ]
    }
  ],
  "error_handling": {
    "strategy": "采用分层错误处理：部署步骤失败时捕获底层异常并转换为统一错误响应，同时通过 IPC 推送错误日志后终止流水线，确保错误信息可追溯且不泄露敏感细节。",
    "response_format": {
      "code": "integer",
      "error": "string",
      "detail": "string"
    }
  }
}