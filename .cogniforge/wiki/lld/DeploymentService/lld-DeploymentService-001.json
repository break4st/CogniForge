  "module_boundary": {
    "in_scope": [
      "接收部署请求，校验前置条件（环境在线、磁盘充足）",
      "创建部署任务记录，立即返回 202 与 deploy_id，异步执行部署流程",
      "异步流程管理：远程磁盘检查、上传构建产物、解压、创建带时间戳的版本目录、原子性切换软链接、生成启动脚本、清理临时文件",
      "任何步骤失败时自动触发回滚机制：删除半成品目录、恢复原有软链接、清理临时文件、记录失败状态",
      "通过 WebSocket 向前端实时推送部署进度",
      "使用 VersionService 记录部署历史与版本快照"
    ],
    "out_of_scope": [
      "前端 UI 交互逻辑（由 DeployUI 负责）",
      "服务器基础环境初始化（由 EnvironmentManager 负责）",
      "SSH 连接管理与命令执行细节（由 SSHService 提供）",
      "构建产物的生成（由 CI/CD 或用户提供）",
      "数据库表结构的直接定义（表归属 Primary Database）"
    ],
    "owned_components": [
      "CMP-014"
    ],
    "owned_contracts": [
      "CTR-009"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": [
      "DM-001",
      "DM-002"
    ]
  },
  "overview": {
    "description": "DeploymentService 是部署流程的编排中枢，负责串联磁盘检查、文件上传、解压、版本目录创建、软链接切换、脚本生成及失败回滚等全链路操作。它作为后端服务，对前端 DeployUI 暴露 REST 接口，对内依赖 SSHService 执行远程命令、依赖 FileManager 管理本地临时文件、依赖 VersionService 维护版本记录。",
    "dependencies": [
      "SSHService",
      "FileManager",
      "VersionService",
      "APIGateway",
      "KeyManagementService"
    ],
    "tech_stack": [
      "Python 3.11",
      "FastAPI",
      "paramiko",
      "cryptography (AES-256)",
      "FastAPI WebSocket"
    ]
  },
