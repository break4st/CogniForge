  "interfaces": [
    {
      "id": "IF-001",
      "name": "REST POST /deployments",
      "endpoint": "/deployments",
      "method": "POST",
      "summary": "启动部署流程",
      "description": "接收部署请求，校验前置条件后创建部署任务并返回 deploy_id。",
      "auth": {
        "type": "token",
        "scopes": [
          "deploy:write"
        ]
      },
      "request": {
        "body": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "environment_id": {
                    "type": "integer",
                    "description": "目标环境 ID"
                  },
                  "version": {
                    "type": "string",
                    "description": "部署版本号（可选，不提供则自动生成）"
                  },
                  "file_path": {
                    "type": "string",
                    "description": "构建产物本地路径（可选，不提供则后续上传）"
                  }
                },
                "required": [
                  "environment_id"
                ]
              }
            }
          }
        }
      },
      "responses": {
        "202": {
          "description": "部署任务已创建",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deploy_id": {
                    "type": "integer",
                    "description": "部署任务 ID"
                  },
                  "status": {
                    "type": "string",
                    "description": "初始状态，如 'queued'"
                  },
                  "message": {
                    "type": "string",
                    "description": "提示信息"
                  }
                },
                "required": [
                  "deploy_id",
                  "status"
                ]
              }
            }
          }
        },
        "400": {
          "description": "请求参数错误"
        },
        "409": {
          "description": "环境已有进行中部署"
        },
        "422": {
          "description": "前置条件不满足（环境离线或磁盘不足）"
        }
      }
    },
    {
      "id": "IF-002",
      "name": "WebSocket /ws/deployments/{deploy_id}",
      "endpoint": "/ws/deployments/{deploy_id}",
      "method": "GET",
      "summary": "订阅部署进度",
      "description": "建立 WebSocket 连接，推送指定部署任务的实时进度。",
      "auth": {
        "type": "token",
        "scopes": [
          "deploy:read"
        ]
      },
      "request": {
        "parameters": [
          {
            "name": "deploy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "部署任务 ID"
          }
        ]
      },
      "responses": {
        "101": {
          "description": "协议切换成功"
        },
        "400": {
          "description": "无效的 deploy_id"
        },
        "404": {
          "description": "部署任务不存在"
        }
      },
      "ws_messages": {
        "subscribe": {
          "type": "object",
          "properties": {
            "type": {
              "const": "subscribe",
              "description": "消息类型"
            },
            "deploy_id": {
              "type": "integer",
              "description": "部署任务 ID"
            }
          },
          "required": [
            "type",
            "deploy_id"
          ]
        },
        "progress": {
          "type": "object",
          "properties": {
            "type": {
              "const": "progress",
              "description": "消息类型"
            },
            "status": {
              "type": "string",
              "description": "当前状态"
            },
            "message": {
              "type": "string",
              "description": "描述信息"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "时间戳"
            }
          },
          "required": [
            "type",
            "status"
          ]
        }
      }
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeployRequest",
      "object_type": "struct",
      "description": "部署请求的数据结构，包含启动部署所需的最小信息。",
      "fields": [
        {
          "name": "environment_id",
          "type": "Integer",
          "description": "目标环境 ID"
        },
        {
          "name": "version",
          "type": "String",
          "description": "指定版本号（可选）"
        },
        {
          "name": "file_path",
          "type": "String",
          "description": "构建产物路径（可选）"
        }
      ],
      "constraints": [
        "environment_id 必须存在且对应在线环境",
        "如果 file_path 提供，则文件必须存在"
      ],
      "source_data_model": "DM-001",
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-014"
      ]
    },
    {
      "id": "DO-002",
      "name": "DeployStep",
      "object_type": "struct",
      "description": "部署流程中的一个步骤，用于跟踪进度。",
      "fields": [
        {
          "name": "name",
          "type": "String",
          "description": "步骤名称，如 'upload'"
        },
        {
          "name": "status",
          "type": "String",
          "description": "步骤状态: pending/running/success/failed"
        },
        {
          "name": "message",
          "type": "String",
          "description": "附加信息"
        },
        {
          "name": "timestamp",
          "type": "DateTime",
          "description": "状态更新时间"
        }
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-014"
      ]
    },
    {
      "id": "DO-003",
      "name": "DeployConfig",
      "object_type": "config",
      "description": "部署全局配置，如超时时间、重试次数等。",
      "fields": [
        {
          "name": "upload_timeout",
          "type": "Integer",
          "description": "上传超时时间（秒）"
        },
        {
          "name": "max_retries",
          "type": "Integer",
          "description": "最大重试次数"
        },
        {
          "name": "temp_dir",
          "type": "String",
          "description": "临时文件目录"
        },
        {
          "name": "version_pattern",
          "type": "String",
          "description": "版本号格式"
        }
      ],
      "constraints": [
        "upload_timeout 必须大于 0",
        "max_retries 必须在 0-5 之间"
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-014"
      ]
    },
    {
      "id": "DO-004",
      "name": "RollbackAction",
      "object_type": "struct",
      "description": "回滚动作定义，记录回滚时执行的操作。",
      "fields": [
        {
          "name": "action_type",
          "type": "String",
          "description": "操作类型，如 'delete_dir', 'restore_link'"
        },
        {
          "name": "target",
          "type": "String",
          "description": "操作目标路径"
        },
        {
          "name": "success",
          "type": "Boolean",
          "description": "回滚操作是否成功"
        }
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-014"
      ]
    },
    {
      "id": "DO-005",
      "name": "DeployStatus",
      "object_type": "enum",
      "description": "部署状态枚举，覆盖全生命周期。",
      "enum_values": [
        "queued",
        "uploading",
        "extracting",
        "deploying",
        "success",
        "failed",
        "rolling_back"
      ],
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-014"
      ]
    },
    {
      "id": "DO-006",
      "name": "DeployResult",
      "object_type": "struct",
      "description": "部署最终结果，包含成功或失败的详细信息。",
      "fields": [
        {
          "name": "deploy_id",
          "type": "Integer",
          "description": "部署任务 ID"
        },
        {
          "name": "status",
          "type": "DeployStatus",
          "description": "最终状态"
        },
        {
          "name": "version",
          "type": "String",
          "description": "部署的版本号"
        },
        {
          "name": "error_log",
          "type": "String",
          "description": "错误日志（如果有）"
        }
      ],
      "source_data_model": "DM-001",
      "source_requirements": [
        "REQ-004"
      ],
      "source_components": [
        "CMP-014"
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentService",
      "description": "DeploymentService 对外提供的契约，定义可调用的方法。",
      "methods": [
        {
          "name": "start_deployment",
          "description": "启动一个新的部署流程。",
          "parameters": [
            {
              "name": "request",
              "type": "DeployRequest",
              "description": "部署请求数据"
            }
          ],
          "returns": {
            "type": "DeployResult",
            "description": "部署结果"
          },
          "exceptions": [
            {
              "type": "ValueError",
              "description": "参数无效"
            },
            {
              "type": "DeployConflict",
              "description": "已有进行中部署"
            },
            {
              "type": "PreconditionFailed",
              "description": "前置条件不满足"
            }
          ],
          "is_async": true
        },
        {
          "name": "get_deploy_status",
          "description": "查询指定部署任务的状态。",
          "parameters": [
            {
              "name": "deploy_id",
              "type": "Integer",
              "description": "部署任务 ID"
            }
          ],
          "returns": {
            "type": "DeployResult",
            "description": "当前部署状态"
          },
          "exceptions": [
            {
              "type": "NotFound",
              "description": "部署任务不存在"
            }
          ],
          "is_async": false
        },
        {
          "name": "upload_file",
          "description": "上传构建产物到临时目录。",
          "parameters": [
            {
              "name": "deploy_id",
              "type": "Integer",
              "description": "部署任务 ID"
            },
            {
              "name": "file",
              "type": "File",
              "description": "上传文件对象"
            }
          ],
          "returns": {
            "type": "bool",
            "description": "上传是否成功"
          },
          "exceptions": [
            {
              "type": "NotFound",
              "description": "部署任务不存在"
            },
            {
              "type": "IOError",
              "description": "文件操作失败"
            }
          ],
          "is_async": true
        }
      ],
      "implemented_interfaces": [
        "IF-001",
        "IF-002"
      ],
      "consumed_interfaces": []
    }
  ],
  "business_rules": {
    "invariants": [
      "同一环境同一时间最多只能有一个进行中的部署（状态为非终态）",
      "部署版本号必须唯一",
      "回滚操作必须保证原子性，即要么全部成功，要么记录失败并告警",
      "环境在线状态必须实时校验，离线环境不可部署",
      "磁盘空间检查在部署前和上传前各执行一次",
      "部署过程中任一关键步骤失败，必须立即触发回滚并终止流程"
    ],
    "validations": [
      {
        "rule": "部署前环境在线校验",
        "description": "SSHService 验证主机可达性",
        "error": "Environment not reachable"
      },
      {
        "rule": "磁盘空间校验",
        "description": "远程磁盘可用空间必须大于配置的最小值",
        "error": "Insufficient disk space"
      },
      {
        "rule": "文件存在性校验",
        "description": "如果提供 file_path，则文件必须存在于指定路径",
        "error": "File not found"
      }
    ],
    "decisions": [
      {
        "name": "版本号生成策略",
        "description": "如果请求未提供版本号，则按 time_commit 格式自动生成；否则使用提供的版本号并校验唯一性。"
      },
      {
        "name": "回滚粒度",
        "description": "一旦失败，立即执行回滚，包括删除新创建的版本目录、恢复软链接、清理临时文件。"
      }
    ]
  },
  "error_handling": {
    "strategy": {
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "retryable_conditions": [
          "网络超时",
          "临时 I/O 错误"
        ]
      },
      "fallback": {
        "description": "非可重试错误直接触发回滚流程",
        "rollback_procedure": [
          "删除新创建的版本目录",
          "恢复原有软链接（如果存在）",
          "清理所有临时文件",
