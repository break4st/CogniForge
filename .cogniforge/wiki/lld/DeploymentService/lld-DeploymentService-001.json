{
  "meta": {
    "doc_id": "lld-DeploymentService-001",
    "type": "lld",
    "module_type": "service",
    "module": "DeploymentService",
    "title": "DeploymentService 详细设计文档",
    "author": "design_agent",
    "created": "2025-03-27T08:00:00Z",
    "version": 1,
    "status": "active"
  },
  "source": {
    "prd": {
      "doc_id": "prd-current",
      "version": 1,
      "requirements": [
        "REQ-003"
      ]
    },
    "sad": {
      "doc_id": "sad-001",
      "version": 1,
      "components": [
        "CMP-103"
      ],
      "contracts": [
        "CTR-005"
      ],
      "data_models": []
    },
    "pm_turn_id": "",
    "se_turn_id": ""
  },
  "module_boundary": {
    "in_scope": [
      "全生命周期部署流程编排：解析请求 → 获取环境凭据 → 建立 SSH 连接 → 创建远程版本目录 → 上传文件并校验 → 生成启停脚本 → 执行前置脚本 → 更新 current 软链 → 执行后置脚本 → 记录结果",
      "部署失败时的远程资源清理与错误状态持久化",
      "部署记录的创建与状态更新"
    ],
    "out_of_scope": [
      "SSH 连接的底层实现",
      "环境配置的存储与解密",
      "具体日志推送机制管理",
      "部署历史页面的回滚逻辑"
    ],
    "owned_components": [
      "CMP-103"
    ],
    "owned_contracts": [
      "CTR-005"
    ],
    "consumed_contracts": [
      "CTR-010"
    ],
    "owned_data_models": [
      "DM-002"
    ],
    "consumed_data_models": [
      "DM-001"
    ]
  },
  "overview": {
    "description": "处理一键部署流程：连接服务器、创建目录、上传文件、生成脚本、执行前后置脚本、更新软链接，并在失败时清理。",
    "dependencies": [
      "SSHService",
      "EnvironmentService",
      "LoggerService",
      "DatabaseService"
    ],
    "tech_stack": [
      "TypeScript (Node.js Electron main process, libraries: ssh2, node-crypto)",
      "SQLite (via DatabaseService)"
    ]
  },
  "traceability": [
    {
      "requirement_id": "REQ-003",
      "sad_component_ids": [
        "CMP-103"
      ],
      "sad_contract_ids": [
        "CTR-005"
      ],
      "lld_objects": {
        "data_models": [
          "DM-001",
          "DM-002"
        ],
        "interfaces": [
          "IF-001"
        ],
        "domain_objects": [
          "DO-001",
          "DO-002",
          "DO-003",
          "DO-004",
          "DO-005"
        ],
        "service_contracts": [
          "SC-001"
        ]
      },
      "coverage": "full",
      "notes": ""
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "DeploymentRecord",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "deployment"
      },
      "description": "部署记录持久化实体，对应主数据库 deployment 表",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "部署记录唯一标识"
        },
        {
          "name": "projectId",
          "type": "string",
          "required": true,
          "description": "关联项目ID"
        },
        {
          "name": "environmentId",
          "type": "string",
          "required": true,
          "description": "关联环境ID"
        },
        {
          "name": "filePath",
          "type": "string",
          "required": true,
          "description": "上传的本地文件路径"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "description": "部署版本标签"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "部署状态，可选值: PENDING, IN_PROGRESS, SUCCESS, FAILED, ROLLING_BACK, ROLLED_BACK"
        },
        {
          "name": "startTime",
          "type": "datetime",
          "required": true,
          "description": "部署开始时间"
        },
        {
          "name": "endTime",
          "type": "datetime",
          "required": false,
          "description": "部署结束时间，允许为空"
        },
        {
          "name": "errorMessage",
          "type": "string",
          "required": false,
          "description": "失败时的错误详情"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "constraints": [
        "status 必须属于预定义枚举值: PENDING, IN_PROGRESS, SUCCESS, FAILED, ROLLING_BACK, ROLLED_BACK",
        "projectId 和 environmentId 组合必须存在",
        "同一项目同一环境不能有多个 IN_PROGRESS 状态的记录"
      ],
      "lifecycle": {
        "create": "INSERT 新部署记录，初始状态 PENDING",
        "update": "UPDATE status、endTime、errorMessage",
        "delete": "不直接删除，仅状态标记为 FAILED",
        "retention": "持久保留所有记录"
      }
    },
    {
      "id": "DM-002",
      "name": "DeploymentConfig",
      "type": "config",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "部署流程内部配置，不可持久化",
      "fields": [
        {
          "name": "maxRetries",
          "type": "int",
          "required": true,
          "description": "SSH命令最大重试次数"
        },
        {
          "name": "retryIntervalMs",
          "type": "int",
          "required": true,
          "description": "重试间隔毫秒"
        },
        {
          "name": "md5CheckEnabled",
          "type": "boolean",
          "required": true,
          "description": "是否启用MD5校验"
        },
        {
          "name": "scriptTemplates",
          "type": "object",
          "required": true,
          "description": "管理脚本模板，包含start.sh等键值对"
        }
      ],
      "source_requirements": [
        "REQ-003"
      ],
      "constraints": [
        "maxRetries 默认3",
        "retryIntervalMs 默认5000",
        "md5CheckEnabled 默认true"
      ],
      "lifecycle": {
        "create": "在服务初始化时加载默认配置",
        "update": "可通过管理接口动态调整",
        "delete": "不可删除"
      }
    }
  ],
  "domain_objects": [
    {
      "id": "DO-001",
      "name": "DeploymentRequest",
      "object_type": "dto",
      "description": "部署请求输入值对象",
      "fields": [
        {
          "name": "projectId",
          "type": "string",
          "required": true,
          "description": "项目ID"
        },
        {
          "name": "environmentId",
          "type": "string",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "filePath",
          "type": "string",
          "required": true,
          "description": "要部署的本地文件路径"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "description": "版本标签"
        }
      ]
    },
    {
      "id": "DO-002",
      "name": "DeploymentResult",
      "object_type": "dto",
      "description": "部署结果输出值对象",
      "fields": [
        {
          "name": "deploymentId",
          "type": "string",
          "required": true,
          "description": "部署记录ID"
        },
        {
          "name": "status",
          "type": "string",
          "required": true,
          "description": "最终状态"
        },
        {
          "name": "errorMessage",
          "type": "string",
          "required": false,
          "description": "错误信息"
        }
      ]
    },
    {
      "id": "DO-003",
      "name": "SshConnection",
      "object_type": "entity",
      "description": "SSH连接封装对象",
      "fields": [
        {
          "name": "host",
          "type": "string",
          "required": true,
          "description": "主机地址"
        },
        {
          "name": "port",
          "type": "number",
          "required": true,
          "description": "端口"
        },
        {
          "name": "username",
          "type": "string",
          "required": true,
          "description": "用户名"
        },
        {
          "name": "client",
          "type": "Client",
          "required": true,
          "description": "SSH2客户端实例"
        }
      ]
    },
    {
      "id": "DO-004",
      "name": "RemoteDirectory",
      "object_type": "value_object",
      "description": "远程目录信息",
      "fields": [
        {
          "name": "basePath",
          "type": "string",
          "required": true,
          "description": "部署根路径"
        },
        {
          "name": "versionDir",
          "type": "string",
          "required": true,
          "description": "版本目录名称，格式 versions/{version}_{timestamp}"
        },
        {
          "name": "currentLink",
          "type": "string",
          "required": true,
          "description": "current 软链接名称"
        }
      ]
    },
    {
      "id": "DO-005",
      "name": "DeploymentScript",
      "object_type": "value_object",
      "description": "部署脚本模板",
      "fields": [
        {
          "name": "startScript",
          "type": "string",
          "required": true,
          "description": "启动脚本内容"
        },
        {
          "name": "stopScript",
          "type": "string",
          "required": false,
          "description": "停止脚本内容"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "IDeploymentService",
      "description": "部署服务接口",
      "method": "startDeployment",
      "endpoint": "/deploy/start",
      "request": {
        "content_type": "application/json",
        "body": "DeploymentRequest"
      },
      "response": {
        "content_type": "application/json",
        "body": "DeploymentResult"
      },
      "errors": [
        {
          "status_code": "400",
          "condition": "请求参数无效"
        },
        {
          "status_code": "409",
          "condition": "已有正在进行的部署"
        },
        {
          "status_code": "500",
          "condition": "部署过程异常"
        }
      ]
    }
  ],
  "service_contracts": [
    {
      "id": "SC-001",
      "name": "DeploymentServiceContract",
      "description": "部署服务规约",
      "methods": [
        {
          "name": "startDeployment",
          "description": "启动部署流程",
          "signature": "startDeployment(request: DeploymentRequest): Promise<DeploymentResult>",
          "preconditions": "请求参数有效，且相同项目环境无进行中的部署",
          "postconditions": "记录状态为 SUCCESS 或 FAILED，远程环境状态确定",
          "parameters": [
            {
              "name": "request",
              "type": "DeploymentRequest",
              "required": true,
              "description": "部署请求参数"
            }
          ],
          "return_type": "Promise<DeploymentResult>",
          "exceptions": [
            {
              "name": "InvalidRequestError",
              "trigger": "参数校验失败时",
              "description": "请求参数非法",
              "type": "validation"
            },
            {
              "name": "DeploymentConflictError",
              "trigger": "存在进行中的部署时",
              "description": "部署冲突",
              "type": "conflict"
            },
            {
              "name": "DeploymentFailedError",
              "trigger": "任一步骤失败时",
              "description": "部署执行失败",
              "type": "runtime"
            }
          ]
        }
      ]
    }
  ],
  "business_rules": {
    "BR-001": {
      "id": "BR-001",
      "description": "同一项目同一环境不能同时进行部署",
      "enforcement": "在 startDeployment 入口检查 DeploymentRecord 是否已有 IN_PROGRESS 记录"
    },
    "BR-002": {
      "id": "BR-002",
      "description": "部署版本目录命名规则为 versions/{version}_{timestamp}",
      "enforcement": "在创建远程目录时使用此规则生成目录名称"
    }
  },
  "error_handling": {
    "strategy": "捕获并封装为 DeploymentFailedError，记录日志，清理远程资源，更新部署记录状态",
    "rules": [
      {
        "error_type": "InvalidRequestError",
        "scenario": "参数校验失败",
        "action": "返回 400 错误"
      },
      {
        "error_type": "DeploymentConflictError",
        "scenario": "存在进行中的部署",
        "action": "返回 409 错误"
      },
      {
        "error_type": "DeploymentFailedError",
        "scenario": "SSH连接或命令执行失败",
        "action": "远程清理，记录日志，更新状态为 FAILED，返回 500"
      }
    ]
  },
  "workflow": {
    "name": "deployment_workflow",
    "description": "一键部署主流程",
    "steps": [
      {
        "name": "validate_request",
        "action": "校验请求参数和业务规则"
      },
      {
        "name": "create_deployment_record",
        "action": "创建初始部署记录"
      },
      {
        "name": "fetch_environment_credentials",
        "action": "获取目标环境凭据"
      },
      {
        "name": "establish_ssh_connection",
        "action": "建立 SSH 连接"
      },
      {
        "name": "create_remote_directory",
        "action": "创建远程版本目录"
      },
      {
        "name": "upload_file",
        "action": "上传文件并校验"
      },
      {
        "name": "generate_scripts",
        "action": "生成启停脚本"
      },
      {
        "name": "execute_pre_script",
        "action": "执行前置脚本"
      },
      {
        "name": "update_symlink",
        "action": "更新 current 软链"
      },
      {
        "name": "execute_post_script",
        "action": "执行后置脚本"
      }
    ]
  }
}