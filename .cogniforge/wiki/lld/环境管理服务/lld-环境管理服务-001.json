  "service_contracts": [
    {
      "id": "SC-001",
      "name": "EnvironmentService",
      "description": "环境管理服务契约",
      "source_contract": "CTR-002",
      "methods": [
        {
          "name": "create_environment",
          "signature": "create_environment(data: EnvironmentCreateRequest) -> EnvironmentResponse",
          "description": "创建新环境",
          "parameters": [
            {
              "name": "data",
              "type": "EnvironmentCreateRequest",
              "required": true,
              "description": "创建环境请求数据"
            }
          ],
          "returns": {
            "type": "EnvironmentResponse",
            "description": "创建的环境信息"
          },
          "exceptions": [
            {
              "type": "DuplicateEnvironmentException",
              "description": "环境名称重复"
            },
            {
              "type": "KeyNotFoundException",
              "description": "关联的密钥ID不存在"
            }
          ],
          "precondition": "项目ID必须存在，环境名称在项目中唯一，如提供keyId则密钥必须存在",
          "postcondition": "环境记录创建成功，返回环境详情",
          "source_requirements": ["REQ-001"]
        },
        {
          "name": "list_environments",
          "signature": "list_environments(projectId: int) -> EnvironmentListResponse",
          "description": "查询环境列表",
          "parameters": [
            {
              "name": "projectId",
              "type": "Integer",
              "required": true,
              "description": "项目ID"
            }
          ],
          "returns": {
            "type": "EnvironmentListResponse",
            "description": "指定项目的环境列表"
          },
          "exceptions": [],
          "precondition": "项目ID必须存在",
          "postcondition": "返回该项目的所有环境列表",
          "source_requirements": ["REQ-001"]
        },
        {
          "name": "get_environment",
          "signature": "get_environment(environmentId: int) -> EnvironmentResponse",
          "description": "获取单个环境详情",
          "parameters": [
            {
              "name": "environmentId",
              "type": "Integer",
              "required": true,
              "description": "环境ID"
            }
          ],
          "returns": {
            "type": "EnvironmentResponse",
            "description": "环境详情"
          },
          "exceptions": [
            {
              "type": "EnvironmentNotFoundException",
              "description": "环境ID不存在"
            }
          ],
          "precondition": "环境ID必须存在",
          "postcondition": "返回指定环境的详细信息",
          "source_requirements": ["REQ-001"]
        },
        {
          "name": "update_environment",
          "signature": "update_environment(environmentId: int, data: EnvironmentUpdateRequest) -> EnvironmentResponse",
          "description": "更新环境配置",
          "parameters": [
            {
              "name": "environmentId",
              "type": "Integer",
              "required": true,
              "description": "环境ID"
            },
            {
              "name": "data",
              "type": "EnvironmentUpdateRequest",
              "required": true,
              "description": "更新环境请求数据"
            }
          ],
          "returns": {
            "type": "EnvironmentResponse",
            "description": "更新后的环境信息"
          },
          "exceptions": [
            {
              "type": "EnvironmentNotFoundException",
              "description": "环境ID不存在"
            },
            {
              "type": "DuplicateEnvironmentException",
              "description": "环境名称已在项目中存在"
            },
            {
              "type": "KeyNotFoundException",
              "description": "关联的密钥ID不存在"
            }
          ],
          "precondition": "环境ID必须存在，如果更新名称则必须在项目中唯一，如果更新keyId则密钥必须存在",
          "postcondition": "环境信息更新成功，返回更新后的环境详情",
          "source_requirements": ["REQ-001"]
        },
        {
          "name": "delete_environment",
          "signature": "delete_environment(environmentId: int) -> void",
          "description": "删除环境",
          "parameters": [
            {
              "name": "environmentId",
              "type": "Integer",
              "required": true,
              "description": "环境ID"
            }
          ],
          "returns": {
            "type": "void",
            "description": "无返回值"
          },
          "exceptions": [
            {
              "type": "EnvironmentNotFoundException",
              "description": "环境ID不存在"
            },
            {
              "type": "EnvironmentInUseException",
              "description": "环境被部署引用，无法删除"
            }
          ],
          "precondition": "环境ID必须存在，且没有活跃的部署引用该环境",
          "postcondition": "环境记录被删除",
          "source_requirements": ["REQ-001"]
        },
        {
          "name": "test_connection",
          "signature": "test_connection(environmentId: int) -> TestConnectionResponse",
          "description": "测试SSH连接",
          "parameters": [
            {
              "name": "environmentId",
              "type": "Integer",
              "required": true,
              "description": "环境ID"
            }
          ],
          "returns": {
            "type": "TestConnectionResponse",
            "description": "连接测试结果"
          },
          "exceptions": [
            {
              "type": "EnvironmentNotFoundException",
              "description": "环境ID不存在"
            }
          ],
          "precondition": "环境ID必须存在",
          "postcondition": "返回连接测试结果，不会修改环境状态",
          "source_requirements": ["REQ-001"]
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "name": "环境名称唯一性检查",
      "description": "同一项目下环境名称必须唯一",
      "scope": ["create_environment", "update_environment"],
      "invariants": [
        "创建或更新环境时，检查项目内是否已存在同名环境"
      ],
      "validation_logic": "在数据库层通过唯一约束保证，或者在服务层查询检查"
    },
    {
      "id": "BR-002",
      "name": "密钥有效性检查",
      "description": "如果环境配置了密钥ID，则必须确保该密钥存在",
      "scope": ["create_environment", "update_environment"],
      "invariants": [
        "当authType为key时，必须提供keyId，并且keyId必须存在于密钥管理服务中"
      ],
      "validation_logic": "调用密钥管理服务的接口验证密钥是否存在"
    },
    {
      "id": "BR-003",
      "name": "环境删除前置检查",
      "description": "删除环境前，必须检查是否存在活跃的部署引用该环境",
      "scope": ["delete_environment"],
      "invariants": [
        "环境不能有状态为'deploying'或'assigned'的部署记录"
      ],
      "validation_logic": "查询部署记录表，检查是否有引用该环境ID的活跃记录"
    }
  ],
  "error_handling": [
    {
      "id": "ERR-001",
      "name": "DuplicateEnvironmentException",
      "strategy": "返回409状态码，提示环境名称重复",
      "trigger": "创建或更新环境时，项目内已存在同名环境",
      "http_status": 409,
      "message": "环境名 '{name}' 在项目中已存在"
    },
    {
      "id": "ERR-002",
      "name": "KeyNotFoundException",
      "strategy": "返回404状态码，提示密钥ID不存在",
      "trigger": "创建或更新环境时，提供的keyId在密钥服务中不存在",
      "http_status": 404,
      "message": "密钥ID {keyId} 不存在"
    },
    {
      "id": "ERR-003",
      "name": "EnvironmentNotFoundException",
      "strategy": "返回404状态码，提示环境ID不存在",
      "trigger": "查询、更新、删除或测试连接时，环境ID不存在",
      "http_status": 404,
      "message": "环境ID {environmentId} 不存在"
    },
    {
      "id": "ERR-004",
      "name": "EnvironmentInUseException",
      "strategy": "返回409状态码，提示环境被引用无法删除",
      "trigger": "删除环境时，存在活跃的部署记录引用该环境",
      "http_status": 409,
      "message": "环境无法删除，因为仍有部署引用"
    }
  ]
}