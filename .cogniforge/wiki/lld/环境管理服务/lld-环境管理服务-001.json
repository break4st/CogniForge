  "overview": {
    "description": "环境管理服务负责维护项目相关的部署环境配置，包括服务器连接信息、密钥路径、操作系统类型和保护标记。提供环境的 CRUD 操作、密钥文件检查和 SSH 连通性测试。",
    "dependencies": [
      "项目管理服务"
    ],
    "tech_stack": [
      "Node.js",
      "TypeScript",
      "Express",
      "SQLite 3",
      "ssh2",
      "winston"
    ]
  },
