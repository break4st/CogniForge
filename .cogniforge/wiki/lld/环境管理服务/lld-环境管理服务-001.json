        {"name": "actor", "type": "String", "required": true, "source": "input", "description": "操作人用户名"},
        {"name": "resource_type", "type": "String", "required": true, "source": "input", "description": "资源类型，固定为 environment"},
        {"name": "resource_id", "type": "Long", "required": true, "source": "input", "description": "环境ID"},
        {"name": "detail", "type": "Map<String,Any>", "required": false, "source": "input", "description": "操作详情JSON"},
