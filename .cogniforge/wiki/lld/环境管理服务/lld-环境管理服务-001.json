  "service_contracts": [
    {
      "id": "SC-001",
      "name": "EnvironmentService",
      "description": "环境管理核心业务逻辑",
      "methods": {
        "create_environment": {
          "signature": "create_environment(request: EnvironmentCreateRequest) -> EnvironmentResponse",
          "precondition": "request.name全局唯一且参数校验通过，连通性测试通过，加密成功",
          "postcondition": "数据库中新增一条环境记录，状态为PENDING，返回EnvironmentResponse",
          "parameters": [
            {
              "name": "request",
              "type": "EnvironmentCreateRequest",
              "required": true,
              "description": "创建环境请求参数"
            }
          ],
          "returns": {
            "type": "EnvironmentResponse",
            "description": "新创建的环境信息"
          },
          "exceptions": [
            {
              "name": "ValidationError",
              "description": "参数校验失败"
            },
            {
              "name": "DuplicateNameError",
              "description": "环境名称已存在"
            },
            {
              "name": "ConnectivityError",
              "description": "连通性测试失败"
            },
            {
              "name": "EncryptionError",
              "description": "加密失败"
            }
          ]
        },
        "get_environments": {
          "signature": "get_environments() -> List[EnvironmentResponse]",
          "precondition": "无",
          "postcondition": "返回所有环境列表",
          "parameters": [],
          "returns": {
            "type": "List[EnvironmentResponse]",
            "description": "环境列表"
          },
          "exceptions": []
        },
        "get_environment": {
          "signature": "get_environment(environment_id: int) -> EnvironmentResponse",
          "precondition": "environment_id对应的环境存在",
          "postcondition": "返回环境信息",
          "parameters": [
            {
              "name": "environment_id",
              "type": "int",
              "required": true,
              "description": "环境ID"
            }
          ],
          "returns": {
            "type": "EnvironmentResponse",
            "description": "环境信息"
          },
          "exceptions": [
            {
              "name": "NotFoundError",
              "description": "环境不存在"
            }
          ]
        },
        "update_environment": {
          "signature": "update_environment(environment_id: int, request: EnvironmentUpdateRequest) -> EnvironmentResponse",
          "precondition": "环境存在，若更新名称则名称唯一，若更新连接参数则连通性测试通过",
          "postcondition": "环境信息已更新，若连接参数变更则状态可能变为PENDING或ACTIVE",
          "parameters": [
            {
              "name": "environment_id",
              "type": "int",
              "required": true,
              "description": "环境ID"
            },
            {
              "name": "request",
              "type": "EnvironmentUpdateRequest",
              "required": true,
              "description": "更新内容"
            }
          ],
          "returns": {
            "type": "EnvironmentResponse",
            "description": "更新后的环境信息"
          },
          "exceptions": [
            {
              "name": "NotFoundError",
              "description": "环境不存在"
            },
            {
              "name": "ValidationError",
              "description": "参数校验失败"
            },
            {
              "name": "DuplicateNameError",
              "description": "名称重复"
            },
            {
              "name": "ConnectivityError",
              "description": "连通性测试失败"
            },
            {
              "name": "EncryptionError",
              "description": "加密失败"
            }
          ]
        },
        "delete_environment": {
          "signature": "delete_environment(environment_id: int) -> None",
          "precondition": "环境存在且未被任何项目引用",
          "postcondition": "环境记录被删除",
          "parameters": [
            {
              "name": "environment_id",
              "type": "int",
              "required": true,
              "description": "环境ID"
            }
          ],
          "returns": {
            "type": "None"
          },
          "exceptions": [
            {
              "name": "NotFoundError",
              "description": "环境不存在"
            },
            {
              "name": "EnvironmentInUseError",
              "description": "环境被项目引用，无法删除"
            }
          ]
        }
      }
    }
  ],
  "error_handling": {
    "strategy": "使用结构化异常，每个异常包含错误码、消息和HTTP状态码，通过FastAPI异常处理器统一捕获并返回JSON响应",
    "error_codes": {
      "ValidationError": {
        "http_status": 400,
        "code": "VALIDATION_ERROR",
        "message": "请求参数校验失败：{detail}"
      },
      "DuplicateNameError": {
        "http_status": 409,
        "code": "DUPLICATE_NAME",
        "message": "环境名称已存在"
      },
      "ConnectivityError": {
        "http_status": 502,
        "code": "CONNECTIVITY_FAILED",
        "message": "连通性测试失败：{detail}"
      },
      "EncryptionError": {
        "http_status": 500,
        "code": "ENCRYPTION_FAILED",
        "message": "加密失败：{detail}"
      },
      "NotFoundError": {
        "http_status": 404,
