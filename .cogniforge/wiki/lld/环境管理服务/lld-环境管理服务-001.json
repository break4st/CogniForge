  "module_boundary": {
    "in_scope": [
      "环境的完整CRUD操作",
      "环境连接参数的校验",
      "调用KeyManager加密私钥并存储",
      "保存前触发连通性测试，测试不通过拒绝保存或更新连接参数",
      "删除环境时检查项目引用，有引用则拒绝删除",
      "环境名称全局唯一性检查"
    ],
    "out_of_scope": [
      "实际的SSH/TCP连通性测试逻辑",
      "私钥加密算法的实现细节",
      "项目与环境绑定的管理",
      "部署流程、进度通知、日志等"
    ],
    "owned_components": [
      "CMP-001"
    ],
    "owned_contracts": [
      "CTR-001",
      "CTR-002",
      "CTR-003",
      "CTR-004"
    ],
    "consumed_contracts": [
      "CTR-005"
    ],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "提供环境的CRUD操作，保存时校验连接参数并调用密钥管理组件加密私钥，环境连通性测试委托ConnectivityTester处理，删除时检查是否有项目引用。",
    "dependencies": [
      "连通性测试服务",
      "密钥管理组件",
      "项目管理服务（查询引用关系）",
      "PostgreSQL数据库"
    ],
    "tech_stack": [
      "Python 3.11+",
      "FastAPI",
      "PostgreSQL 15",
      "httpx",
      "cryptography (AES‑256‑GCM)"
    ]
  },
  "business_rules": {
    "invariants": [
      "环境名称全局唯一",
      "auth_type只能为ssh_key",
      "port范围1~65535",
      "status只能为PENDING或ACTIVE"
    ],
    "rules": [
      "创建环境时状态为PENDING，连通性测试通过后方可变为ACTIVE",
      "更新连接参数时状态回退到PENDING，测试通过再置回ACTIVE",
      "删除环境前必须检查是否有项目引用，有引用则拒绝删除",
      "保存环境时必须先加密私钥"
    ]
  },
