  "interfaces": [
    {
      "id": "IF-001",
      "name": "创建环境",
      "endpoint": "POST /environments",
      "method": "POST",
      "path": "/environments",
      "description": "创建新环境配置",
      "request": {
        "type": "application/json",
        "schema": "EnvironmentCreateRequest"
      },
      "response": {
        "type": "application/json",
