  "data_models": [
    {
      "id": "DM-001",
      "name": "Environment",
      "type": "table",
      "status": "active",
      "version": 1,
      "ownership": "canonical",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "Environment"
      },
      "description": "环境配置信息表，存储各项目部署环境的连接参数与部署路径，引用自Primary Database LLD。",
      "fields": [
        {
          "name": "id",
          "type": "UUID",
          "required": true,
          "description": "环境唯一标识"
        },
        {
          "name": "project_id",
          "type": "UUID",
          "required": true,
          "description": "关联的项目ID"
        },
        {
          "name": "name",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "环境名称"
        },
        {
          "name": "host",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "服务器主机名或IP地址"
        },
        {
          "name": "port",
          "type": "INTEGER",
          "required": false,
          "description": "SSH端口号，默认22"
        },
        {
          "name": "username",
          "type": "VARCHAR(255)",
          "required": true,
          "description": "SSH登录用户名"
        },
        {
          "name": "deploy_path",
          "type": "TEXT",
          "required": true,
          "description": "部署到目标服务器的路径"
        },
        {
          "name": "key_material_id",
          "type": "UUID",
          "required": false,
          "description": "关联的密钥材料ID，外键引用密钥管理服务的密钥表"
        },
        {
          "name": "connection_status",
          "type": "VARCHAR(50)",
          "required": false,
          "description": "最近一次连接测试的状态，如 'success', 'failed', 'unknown'"
        },
        {
          "name": "last_tested_at",
          "type": "TIMESTAMPTZ",
          "required": false,
          "description": "最近一次连接测试的时间戳"
        },
        {
          "name": "created_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "description": "记录创建时间"
        },
        {
          "name": "updated_at",
          "type": "TIMESTAMPTZ",
          "required": true,
          "description": "记录最后更新时间"
        }
      ],
      "indexes": [
        {
          "name": "idx_environment_project_id",
          "unique": false,
          "columns": [
            "project_id"
          ]
        },
        {
          "name": "idx_environment_key_material_id",
          "unique": false,
          "columns": [
            "key_material_id"
          ]
        }
      ],
      "constraints": [
        "fk_environment_project: FOREIGN KEY (project_id) REFERENCES projects(id)"
      ],
      "lifecycle": {
        "create": "创建环境时插入记录",
        "update": "更新环境配置或连接测试结果时更新字段",
        "delete": "删除环境时软删除或硬删除，依项目需求",
        "retention": "永久保存，除非项目被删除则级联删除"
      },
      "source_requirements": [
        "REQ-002",
