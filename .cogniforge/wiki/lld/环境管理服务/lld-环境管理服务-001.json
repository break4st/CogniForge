{
  "meta": {
    "doc_id": "lld-环境管理服务-001",
    "type": "lld",
    "module_type": "service",
    "module": "环境管理服务",
    "title": "环境管理服务详细设计",
    "author": "design_agent",
    "created": "2026-05-22"
  },
  "overview": {
    "description": "管理每套部署环境（测试/灰度/正式）的配置信息，提供环境的创建、编辑、删除、健康检查以及与项目和SSH密钥的关联管理能力。作为部署编排服务的上游依赖，为部署流程提供目标服务器的连接信息和状态查询。",
    "dependencies": [
      "项目管理服务",
      "PostgreSQL主数据库",
      "Redis缓存",
      "密钥管理服务"
    ],
    "tech_stack": [
      "Go",
      "Gin",
      "PostgreSQL 15+",
      "Redis 7+",
      "golang.org/x/crypto/ssh"
    ]
  },
  "data_models": [
    {
      "name": "environments",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-PostgreSQL主数据库-001",
        "model_name": "environments"
      },
      "description": "部署环境配置信息，关联项目和SSH密钥，定义目标服务器的连接参数。环境管理服务核心数据模型。",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "环境标识，主键"},
        {"name": "project_id", "type": "UUID", "required": true, "description": "所属项目ID，外键关联projects"},
        {"name": "name", "type": "VARCHAR(64)", "required": true, "description": "环境名称，如「测试线」「灰度线」「正式线」"},
        {"name": "host", "type": "VARCHAR(256)", "required": true, "description": "目标服务器地址（IP或域名）"},
        {"name": "port", "type": "INTEGER", "required": true, "description": "SSH端口号，默认22"},
        {"name": "key_id", "type": "UUID", "required": false, "description": "绑定的SSH密钥ID，外键关联ssh_keys"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "连接健康状态：online/offline/unknown"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录更新时间"}
      ],
      "indexes": [
        {"name": "idx_environments_project_id", "unique": false, "columns": ["project_id"]},
        {"name": "idx_environments_key_id", "unique": false, "columns": ["key_id"]}
      ]
    },
    {
      "name": "projects",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-PostgreSQL主数据库-001",
        "model_name": "projects"
      },
      "description": "项目定义信息，用于验证环境关联的项目是否存在以及环境归属查询。环境管理服务关心项目的ID和名称字段。",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "项目标识，主键"},
        {"name": "name", "type": "VARCHAR(256)", "required": true, "description": "项目名称"},
        {"name": "status", "type": "VARCHAR(16)", "required": true, "description": "项目状态：active/archived"}
      ],
      "indexes": [
        {"name": "idx_projects_name", "unique": false, "columns": ["name"]}
      ]
    },
    {
      "name": "ssh_keys",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-PostgreSQL主数据库-001",
        "model_name": "ssh_keys"
      },
      "description": "SSH密钥信息，用于验证环境绑定的密钥是否存在以及获取密钥名称展示。环境管理服务只关心密钥的ID和名称字段。",
      "fields": [
        {"name": "id", "type": "UUID", "required": true, "description": "密钥标识，主键"},
        {"name": "name", "type": "VARCHAR(256)", "required": true, "description": "密钥名称"},
        {"name": "fingerprint", "type": "VARCHAR(128)", "required": true, "description": "密钥指纹（SHA256摘要）"}
      ],
      "indexes": [
        {"name": "idx_ssh_keys_fingerprint", "unique": true, "columns": ["fingerprint"]}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "ListEnvironmentsByProject",
      "method": "GET",
      "endpoint": "/api/v1/projects/:projectId/environments",
      "description": "查询指定项目的所有部署环境列表，返回环境的概要信息，按创建时间降序排列",
      "parameters": [
        {"name": "projectId", "type": "string (UUID)", "description": "项目ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "environments": "array（环境对象数组，每个元素包含id/project_id/name/host/port/key_id/status/created_at）"
        }
      },
      "error_codes": [
        {"code": 400, "message": "projectId格式无效"},
        {"code": 404, "message": "项目不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "GetEnvironment",
      "method": "GET",
      "endpoint": "/api/v1/environments/:envId",
      "description": "获取指定环境的完整配置详情",
      "parameters": [
        {"name": "envId", "type": "string (UUID)", "description": "环境ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "project_id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "key_id": "string (UUID)",
          "status": "string（健康状态：online/offline/unknown）",
          "created_at": "string (ISO8601)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "envId格式无效"},
        {"code": 404, "message": "环境不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "CreateEnvironment",
      "method": "POST",
      "endpoint": "/api/v1/environments",
      "description": "为指定项目创建一个新的部署环境，初始健康状态为unknown",
      "parameters": [
        {"name": "project_id", "type": "string (UUID)", "description": "所属项目ID（请求体）"},
        {"name": "name", "type": "string", "description": "环境名称，如「测试线」「灰度线」「正式线」"},
        {"name": "host", "type": "string", "description": "目标服务器地址（IP或域名）"},
        {"name": "port", "type": "integer", "description": "SSH端口号，默认22"},
        {"name": "key_id", "type": "string (UUID)", "description": "绑定的SSH密钥ID（可选）"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "string (UUID)",
          "project_id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "key_id": "string (UUID)",
          "status": "string（健康状态：online/offline/unknown）",
          "created_at": "string (ISO8601)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败：环境名称缺失、host格式无效、port超出范围"},
        {"code": 404, "message": "关联的项目不存在"},
        {"code": 409, "message": "同一项目下环境名称重复"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "UpdateEnvironment",
      "method": "PUT",
      "endpoint": "/api/v1/environments/:envId",
      "description": "更新指定环境的配置信息（名称、地址、端口、密钥），支持部分字段更新。变更host或port后自动触发健康检查重设状态为unknown。",
      "parameters": [
        {"name": "envId", "type": "string (UUID)", "description": "环境ID（路径参数）"},
        {"name": "name", "type": "string", "description": "环境名称（可选）"},
        {"name": "host", "type": "string", "description": "目标服务器地址（可选）"},
        {"name": "port", "type": "integer", "description": "SSH端口号（可选）"},
        {"name": "key_id", "type": "string (UUID)", "description": "绑定的SSH密钥ID（可选，传空字符串解绑）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "project_id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "key_id": "string (UUID)",
          "status": "string（健康状态：online/offline/unknown）",
          "created_at": "string (ISO8601)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "更新的环境名称在所属项目下已存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "DeleteEnvironment",
      "method": "DELETE",
      "endpoint": "/api/v1/environments/:envId",
      "description": "删除指定环境。如果该环境存在关联的部署版本或正在执行的部署任务，则禁止删除。",
      "parameters": [
        {"name": "envId", "type": "string (UUID)", "description": "环境ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean"
        }
      },
      "error_codes": [
        {"code": 400, "message": "envId格式无效"},
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "环境存在关联的部署版本或正在执行的部署任务，禁止删除"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "CheckHealth",
      "method": "POST",
      "endpoint": "/api/v1/environments/:envId/health-check",
      "description": "触发指定环境的健康检查。服务尝试TCP连接到目标host:port，根据连接结果更新环境状态（online/offline）。",
      "parameters": [
        {"name": "envId", "type": "string (UUID)", "description": "环境ID（路径参数）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "environment_id": "string (UUID)",
          "status": "string（检查结果：online/offline）",
          "latency_ms": "integer（连接延迟，毫秒）",
          "checked_at": "string (ISO8601)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "envId格式无效"},
        {"code": 404, "message": "环境不存在"},
        {"code": 409, "message": "该环境正在进行健康检查，请稍后重试"},
        {"code": 500, "message": "健康检查执行过程中发生内部错误"}
      ]
    },
    {
      "name": "BindKey",
      "method": "POST",
      "endpoint": "/api/v1/environments/:envId/bind-key",
      "description": "为指定环境绑定SSH密钥。绑定前会调用密钥管理服务的KeyVerifyAPI验证密钥与服务器的连接有效性，验证通过后方可绑定。",
      "parameters": [
        {"name": "envId", "type": "string (UUID)", "description": "环境ID（路径参数）"},
        {"name": "key_id", "type": "string (UUID)", "description": "要绑定的SSH密钥ID（请求体）"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "string (UUID)",
          "project_id": "string (UUID)",
          "name": "string",
          "host": "string",
          "port": "integer",
          "key_id": "string (UUID)",
          "status": "string（健康状态：online/offline/unknown）",
          "created_at": "string (ISO8601)"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 404, "message": "环境或密钥不存在"},
        {"code": 422, "message": "密钥验证失败，无法连接到目标服务器"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "GetEnvironmentConnection",
      "method": "INTERNAL",
      "endpoint": "EnvironmentService.GetConnectionInfo(envId)",
      "description": "供部署编排服务等内部模块调用，获取目标环境的服务器连接信息（host、port、key_id、project_id）。不经过API网关，服务间直连调用。",
      "parameters": [
        {"name": "envId", "type": "string (UUID)", "description": "环境ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "environment_id": "string (UUID)",
          "host": "string",
          "port": "integer",
          "key_id": "string (UUID)",
          "project_id": "string (UUID)"
        }
      },
      "error_codes": [
        {"code": 404, "message": "环境不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "采用统一错误响应格式，请求参数校验错误返回400，资源不存在返回404，业务逻辑冲突（名称重复、有关联引用）返回409，第三方依赖失败（密钥验证）返回422，服务器内部错误统一返回500。健康检查的业务状态（online/offline）与HTTP状态码分离，即使连接失败也返回200，业务状态体现在响应body中。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": 400,
        "name": "请求参数错误",
        "description": "请求参数校验失败。触发条件：必填字段缺失、字段格式无效（如UUID格式错误、端口超出1-65535范围）、host为空或格式非法。处理方式：返回detail字段说明具体哪个字段校验失败及原因。"
      },
      {
        "code": 404,
        "name": "资源不存在",
        "description": "请求的资源（环境、项目、密钥）不存在。触发条件：环境ID/项目ID/密钥ID在数据库中未找到记录。处理方式：返回detail字段说明不存在的资源类型和ID。"
      },
      {
        "code": 409,
        "name": "业务冲突",
        "description": "操作违反业务约束。触发条件包括：同一项目下环境名称重复、环境存在关联的部署版本或正在执行的部署任务、环境绑定密钥时密钥已绑定到其他环境。处理方式：返回detail字段描述具体冲突原因和当前冲突值。"
      },
      {
        "code": 422,
        "name": "外部依赖验证失败",
        "description": "依赖外部服务的验证操作失败。触发条件：绑定密钥时密钥管理服务返回密钥验证失败（无法SSH连接到目标服务器）。处理方式：透传密钥管理服务返回的错误详情到detail字段。"
      },
      {
        "code": 500,
        "name": "服务器内部错误",
        "description": "未预期的系统错误。触发条件：数据库连接异常、TCP健康检查执行异常、Redis缓存操作失败。处理方式：记录完整错误栈到服务器日志，返回通用错误信息，不泄露内部细节。"
      }
    ]
  },
