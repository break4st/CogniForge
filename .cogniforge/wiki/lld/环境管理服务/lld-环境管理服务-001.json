  "service_contracts": [
    {
      "id": "SC-001",
      "name": "EnvironmentService",
      "description": "环境管理服务契约",
      "methods": [
        {
          "name": "createEnvironment",
          "description": "创建新环境",
          "signature": "createEnvironment(cmd: CreateEnvironmentCommand): Promise<Environment>",
          "parameters": [
            {
              "name": "cmd",
              "type": "CreateEnvironmentCommand",
              "description": "创建命令"
            }
          ],
          "return": {
            "type": "Promise<Environment>",
            "description": "创建后的环境对象"
          },
          "throws": [
            {
              "type": "ValidationError",
              "description": "参数验证失败"
            },
            {
              "type": "NotFoundError",
              "description": "项目不存在"
            },
            {
              "type": "DuplicateError",
              "description": "环境名称重复"
            },
            {
              "type": "FileNotFoundError",
              "description": "密钥文件不存在"
            }
          ],
          "precondition": "项目必须存在，环境名称在项目内唯一，密钥文件存在且格式正确",
          "postcondition": "环境记录被创建并持久化，返回包含 ID 和时间的完整环境对象"
        },
        {
          "name": "listEnvironments",
          "description": "列出项目下的环境",
          "signature": "listEnvironments(projectId: string): Promise<Environment[]>",
          "parameters": [
            {
              "name": "projectId",
              "type": "string",
              "description": "项目 ID"
            }
          ],
          "return": {
            "type": "Promise<Environment[]>",
            "description": "环境数组"
          },
          "throws": [
            {
              "type": "NotFoundError",
              "description": "项目不存在"
            }
          ],
          "precondition": "项目必须存在",
          "postcondition": "返回该项目的所有环境列表（可能为空数组）"
        },
        {
          "name": "getEnvironment",
          "description": "获取单个环境详情",
          "signature": "getEnvironment(projectId: string, environmentId: string): Promise<Environment>",
          "parameters": [
            {
              "name": "projectId",
              "type": "string"
            },
            {
              "name": "environmentId",
              "type": "string"
            }
          ],
          "return": {
            "type": "Promise<Environment>",
            "description": "环境对象"
          },
          "throws": [
            {
              "type": "NotFoundError",
              "description": "项目或环境不存在"
            }
          ],
          "precondition": "项目和环境都必须存在",
          "postcondition": "返回完整环境信息"
        },
        {
          "name": "updateEnvironment",
          "description": "更新环境配置",
          "signature": "updateEnvironment(cmd: UpdateEnvironmentCommand): Promise<Environment>",
          "parameters": [
            {
              "name": "cmd",
              "type": "UpdateEnvironmentCommand"
            }
          ],
          "return": {
            "type": "Promise<Environment>",
            "description": "更新后的环境对象"
          },
          "throws": [
            {
              "type": "NotFoundError",
              "description": "项目或环境不存在"
            },
            {
              "type": "ValidationError",
              "description": "参数验证失败"
            },
            {
              "type": "ForbiddenError",
              "description": "环境受保护不允许修改"
            },
            {
              "type": "DuplicateError",
              "description": "环境名称重复"
            },
            {
              "type": "FileNotFoundError",
              "description": "密钥文件路径变更且文件不存在"
            }
          ],
          "precondition": "环境和项目必须存在，环境未受保护，若更新名称则需在项目内唯一，若更新密钥路径则文件必须存在",
          "postcondition": "环境记录更新，updated_at 时间戳更新，返回更新后的环境对象"
        },
        {
          "name": "deleteEnvironment",
          "description": "删除环境",
          "signature": "deleteEnvironment(projectId: string, environmentId: string): Promise<void>",
          "parameters": [
            {
              "name": "projectId",
              "type": "string"
            },
            {
              "name": "environmentId",
              "type": "string"
            }
          ],
          "return": {
            "type": "Promise<void>",
            "description": "无返回值"
          },
          "throws": [
            {
              "type": "NotFoundError",
              "description": "项目或环境不存在"
            },
            {
              "type": "ForbiddenError",
              "description": "环境受保护不允许删除"
            }
          ],
          "precondition": "环境和项目必须存在，环境未受保护",
          "postcondition": "环境记录被删除，不可恢复"
        },
        {
          "name": "testConnection",
          "description": "测试环境 SSH 连接",
          "signature": "testConnection(projectId: string, environmentId: string): Promise<TestResult>",
          "parameters": [
            {
              "name": "projectId",
              "type": "string"
            },
            {
              "name": "environmentId",
              "type": "string"
            }
          ],
          "return": {
            "type": "Promise<TestResult>",
            "description": "连接测试结果对象"
          },
          "throws": [
            {
              "type": "NotFoundError",
              "description": "项目或环境不存在"
            },
            {
              "type": "FileNotFoundError",
              "description": "密钥文件不存在"
            }
          ],
          "precondition": "环境和项目存在，密钥文件存在",
          "postcondition": "尝试连接并执行 echo 命令，返回连接结果和命令输出"
        }
      ]
    }
  ],
  "business_rules": [
    {
      "id": "BR-001",
      "description": "环境名称在同一个项目下必须唯一",
      "type": "invariant",
      "enforcement": "数据库唯一索引 + 应用层检查",
      "related_objects": ["EnvironmentRepository", "CreateEnvironmentCommand", "UpdateEnvironmentCommand"]
    },
    {
      "id": "BR-002",
      "description": "受保护的环境不能删除或修改",
      "type": "invariant",
      "enforcement": "领域对象 canModify/canDelete 方法 + 服务层判断",
      "related_objects": ["Environment", "EnvironmentService"]
    },
    {
      "id": "BR-003",
      "description": "创建或更新环境时若指定了密钥文件路径，必须确保文件存在且可读",
      "type": "invariant",
      "enforcement": "EnvironmentValidator.validateKeyFile",
      "related_objects": ["EnvironmentValidator"]
    }
  ],
  "error_handling": [
    {
      "error_type": "ValidationError",
      "http_status": 400,
      "strategy": "返回明确的字段错误信息，不暴露内部结构",
      "logging": "warn 级别"
    },
    {
      "error_type": "NotFoundError",
      "http_status": 404,
      "strategy": "返回标准 NotFound 消息，区分项目与环境",
      "logging": "info 级别"
    },
    {
      "error_type": "DuplicateError",
      "http_status": 409,
      "strategy": "返回环境名称重复提示",
      "logging": "warn 级别"
    },
    {
      "error_type": "ForbiddenError",
      "http_status": 403,
      "strategy": "返回受保护资源不可操作提示",
      "logging": "warn 级别"
    },
    {
      "error_type": "FileNotFoundError",
      "http_status": 400,
      "strategy": "返回密钥文件路径无效提示",
      "logging": "warn 级别"
    },
    {
      "error_type": "UnexpectedError",
      "http_status": 500,
      "strategy": "返回通用内部错误，记录详细错误栈",
      "logging": "error 级别"
    }
  ],
  "algorithms": [],
  "execution_order": [],
  "extensions": [],
  "state_models": []
}