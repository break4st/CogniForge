  "data_models": [
    {
      "id": "DM-001",
      "name": "environments",
      "type": "reference",
      "status": "active",
      "version": 1,
      "ownership": "derived",
      "source": {
        "doc_id": "lld-Primary Database-001",
        "model_name": "environments"
      },
      "description": "部署环境表，存储每个项目下的环境配置信息",
      "fields": [
        {
          "name": "id",
          "type": "TEXT",
          "required": true,
          "description": "环境唯一标识，UUID"
        },
        {
          "name": "project_id",
          "type": "TEXT",
          "required": true,
          "description": "所属项目 ID，外键引用 projects 表"
        },
        {
          "name": "name",
          "type": "TEXT",
          "required": true,
          "description": "环境名称，在同一项目下唯一"
        },
        {
          "name": "host",
          "type": "TEXT",
          "required": true,
          "description": "服务器主机名或 IP 地址"
        },
        {
          "name": "port",
          "type": "INTEGER",
          "required": true,
          "description": "SSH 端口，默认 22"
        },
        {
          "name": "auth_key_path",
          "type": "TEXT",
          "required": true,
          "description": "SSH 私钥文件本地绝对路径"
        },
        {
          "name": "deploy_root",
          "type": "TEXT",
          "required": true,
          "description": "部署工作根目录"
        },
        {
          "name": "os_type",
          "type": "TEXT",
          "required": true,
          "description": "操作系统类型，取值 'linux' 或 'windows'"
        },
        {
          "name": "is_protected",
          "type": "INTEGER",
          "required": true,
          "description": "是否保护标记，1 为保护，0 为未保护"
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "required": true,
          "description": "创建时间，ISO 8601 格式"
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "required": true,
          "description": "最后更新时间，ISO 8601 格式"
        }
      ],
      "indexes": [
