      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建，引用自Primary Database LLD，根据模块需求扩展了连接状态字段",
          "reason": "首次生成环境管理服务LLD"
        }
      ]
    }
  ],
  "interfaces": [
    {
      "id": "IF-001",
      "name": "TestConnection REST API",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-002",
      "provider_component_id": "CMP-004",
      "method": "POST",
      "endpoint": "/api/v1/environments/{env_id}/test-connection",
      "description": "对指定环境进行SSH连接测试，验证当前配置和关联密钥是否可达。",
      "parameters": [
        {
          "name": "env_id",
          "type": "string (UUID)",
          "in": "path",
          "required": true,
          "description": "要测试的环境的唯一标识"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "success": "boolean",
          "message": "string",
          "timestamp": "string (ISO 8601)"
        }
      },
      "error_codes": [
        {
          "status": 404,
          "code": "ENVIRONMENT_NOT_FOUND",
          "message": "指定的环境不存在"
        },
        {
          "status": 400,
          "code": "KEY_MATERIAL_MISSING",
          "message": "环境关联的密钥材料不存在或已失效"
        },
        {
          "status": 502,
          "code": "KEY_SERVICE_UNAVAILABLE",
          "message": "无法连接到密钥管理服务以获取解密密钥"
        },
        {
          "status": 500,
          "code": "TEST_CONNECTION_FAILED",
          "message": "执行测试连接时发生内部错误"
        }
      ],
      "auth": {
        "required": true,
        "policy": "Bearer Token, 需要具备环境管理相关权限"
      },
      "validation_rules": [
        "env_id must be a valid UUID v4"
      ],
      "idempotency": "idempotent",
      "pagination": "not_applicable",
      "source_requirements": [
        "REQ-002"
      ],
      "change_history": [
        {
          "version": 1,
          "change_type": "created",
          "summary": "初始创建",
          "reason": "首次生成LLD"
        }
      ]
    }
  ],
  "error_handling": {
    "strategy": "统一在FastAPI全局异常处理层捕获异常，返回标准JSON错误响应；业务异常映射为HTTP状态码，敏感信息（如密钥内容）绝不暴露给客户端。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "请求参数缺失、格式错误或值非法，如环境ID非整数、请求体缺少必填字段。返回清晰错误提示，不重试。"
      },
      {
        "code": "404",
        "name": "资源不存在",
        "description": "指定的环境ID在数据库中不存在，或关联的密钥材料记录缺失。返回明确资源未找到信息。"
      },
      {
        "code": "422",
        "name": "环境配置不可连接",
        "description": "测试连接时SSH连接失败、认证失败（密钥错误、权限不足）或超时。返回失败原因，提示用户检查配置。"
      },
      {
        "code": "502",
        "name": "密钥服务调用失败",
        "description": "调用密钥管理服务gRPC接口获取解密密钥失败（网络不可达、超时、服务内部错误）。返回上层服务不可用错误，建议稍后重试。"
      },
      {
        "code": "500",
        "name": "服务器内部错误",
        "description": "未预期的系统异常，如数据库连接失败、消息队列异常。返回通用错误信息，记录详细日志并触发告警。"
      }
    ]
  },
