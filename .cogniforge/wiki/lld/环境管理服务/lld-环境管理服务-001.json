  "interfaces": [
    {
      "id": "IF-001",
      "name": "创建环境",
      "endpoint": {
        "method": "POST",
        "path": "/environments",
        "summary": "创建新环境",
        "description": "接收环境参数，校验后加密私钥，触发连通性测试，成功则保存并返回环境"
      },
      "request_body": {
        "content_type": "application/json",
        "schema_ref": "DO-001",
        "required": true
      },
      "responses": {
        "201": {
          "description": "创建成功",
          "schema_ref": "DO-003"
        },
        "400": {
          "description": "请求参数校验失败",
          "schema_ref": "ValidationError"
        },
        "409": {
          "description": "环境名称重复",
          "schema_ref": "DuplicateNameError"
        },
        "502": {
          "description": "连通性测试失败",
          "schema_ref": "ConnectivityError"
        },
        "500": {
          "description": "加密失败或内部错误",
          "schema_ref": "EncryptionError"
        }
      },
      "authentication": true,
      "rate_limit": {
        "max_requests": 30,
        "window_seconds": 60
      },
