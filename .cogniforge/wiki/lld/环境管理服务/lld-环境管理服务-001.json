  "service_contracts": [
    {
      "name": "TestEnvironmentConnection",
      "description": "测试指定环境配置的SSH连接是否可达，使用关联的密钥材料进行认证",
      "methods": [
        {
          "name": "testConnection",
          "signature": "(env_id: int) -> TestConnectionResult",
          "precondition": "环境ID存在且关联有效的密钥材料",
          "postcondition": "返回测试连接结果，如果成功则记录成功状态到环境实体",
          "description": "异步执行SSH连接测试，调用密钥服务获取解密密钥，进行连接验证，并将结果更新到环境实体",
          "exceptions": [
            {
              "name": "EnvironmentNotFoundException",
              "trigger": "环境ID不存在",
              "http_status": 404
            },
            {
              "name": "KeyMaterialNotFoundException",
              "trigger": "关联的密钥材料不存在",
              "http_status": 404
            },
            {
              "name": "KeyDecryptionFailedException",
              "trigger": "密钥解密失败",
              "http_status": 502
            }
          ]
        }
      ],
      "repository_dependencies": [
        "findById(env_id: int) -> Environment?",
        "updateConnectionStatus(env_id: int, status: ConnectionStatus) -> void"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "环境配置中的密钥材料ID必须指向有效的、未过期的密钥材料记录",
      "测试连接操作不会修改环境配置的任何持久化数据",
      "每次测试连接都必须使用最新的密钥材料进行解密和连接",
      "解密后的密钥材料在使用后必须立即从内存中清除，不可缓存或持久化"
    ],
    "state_machines": [
      {
        "entity": "EnvironmentEntity",
        "states": [
          "未验证",
          "连接成功",
          "连接失败"
        ],
        "transitions": [
          {
            "from": "未验证",
            "to": "连接成功",
            "trigger": "测试连接成功",
            "actor": "用户"
          },
          {
            "from": "未验证",
            "to": "连接失败",
            "trigger": "测试连接失败",
            "actor": "用户"
          },
          {
            "from": "连接成功",
            "to": "连接成功",
            "trigger": "测试连接成功",
            "actor": "用户"
          },
          {
            "from": "连接成功",
            "to": "连接失败",
            "trigger": "测试连接失败",
            "actor": "用户"
          },
          {
            "from": "连接失败",
            "to": "连接成功",
            "trigger": "测试连接成功",
            "actor": "用户"
          },
          {
            "from": "连接失败",
            "to": "连接失败",
            "trigger": "测试连接失败",
            "actor": "用户"
          }
        ],
        "irreversible_rules": [
          "不存在不可逆的状态转换"
        ],
        "concurrency": "每次测试连接请求都会更新该环境实体的连接状态字段，若多个请求并发执行，以最后完成的测试结果为准，不提供分布式锁保障状态一致性，仅作为最终状态参考"
      }
    ],
    "cross_service_rules": [
      "调用密钥管理服务获取解密密钥时，必须传递环境配置中记录的密钥材料ID，且仅请求解密所需密钥，不可请求额外密钥",
      "密钥管理服务返回的解密密钥必须通过安全传输（如gRPC over TLS）获取，不可明文记录到日志",
      "SSH连接测试所使用的连接参数（主机、端口、用户名等）必须与环境配置中的值完全一致，不可进行任何自动修正",
      "测试连接的结果仅反映当前环境配置和密钥材料的状态，不应对目标服务器产生任何副作用"
    ]
  },
  "workflow": {
    "name": "环境连接测试流程",
    "description": "当用户触发测试连接时，系统获取环境配置及关联密钥，解密后执行SSH连接测试，更新环境状态并返回结果。",
    "steps": [
      {
        "order": 1,
        "name": "获取环境配置",
        "action": "根据env_id从数据库加载Environment实体，若不存在则抛出EnvironmentNotFoundException",
        "timeout_seconds": 5,
        "on_failure": "返回404错误给客户端"
      },
      {
        "order": 2,
        "name": "获取并解密密钥",
        "action": "调用密钥管理服务gRPC接口，传入key_material_id获取解密密钥，若失败则抛出KeyDecryptionFailedException",
        "timeout_seconds": 10,
        "on_failure": "返回502错误给客户端"
      },
      {
        "order": 3,
        "name": "执行SSH连接测试",
        "action": "使用环境配置中的host, port, username和解密后的密钥进行SSH连接尝试，超时时间设为5秒",
        "timeout_seconds": 5,
