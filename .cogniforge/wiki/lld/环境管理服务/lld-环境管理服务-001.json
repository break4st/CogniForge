        {"name": "status", "type": "String", "required": true, "source": "computed", "description": "检查结果：online（连接成功）/offline（连接失败）"},
        {"name": "latency_ms", "type": "Integer", "required": true, "source": "computed", "description": "TCP连接延迟，单位毫秒"},
        {"name": "checked_at", "type": "String (ISO8601)", "required": true, "source": "computed", "description": "检查完成时间"}
      ]
    }
  ],
  "service_contracts": [
    {
      "name": "EnvironmentService",
      "description": "环境管理核心服务，负责部署环境的CRUD操作、健康检查和密钥绑定管理",
      "methods": [
        {
          "name": "CreateEnvironment",
          "signature": "(req: CreateEnvironmentRequest) -> EnvironmentResponse",
          "precondition": "请求参数校验通过；project_id对应的项目存在且状态为active；同一项目下不存在同名环境",
          "postcondition": "环境记录成功写入environments表，返回包含新环境ID和初始状态unknown的完整信息",
          "description": "创建新的部署环境，初始健康状态为unknown",
          "exceptions": [
            {"name": "ValidationException", "trigger": "请求参数缺失或格式无效", "http_status": 400},
            {"name": "ProjectNotFoundException", "trigger": "project_id对应的项目不存在或已归档", "http_status": 404},
            {"name": "DuplicateNameException", "trigger": "同一项目下已存在同名环境", "http_status": 409},
            {"name": "InternalException", "trigger": "数据库写入失败", "http_status": 500}
          ]
        },
        {
          "name": "UpdateEnvironment",
          "signature": "(envId: UUID, req: UpdateEnvironmentRequest) -> EnvironmentResponse",
          "precondition": "envId对应的环境存在；若更新name，同一项目下无同名环境；若更新host或port，业务允许变更",
          "postcondition": "environments表中对应记录的指定字段已更新；若host或port变更，环境状态被重置为unknown",
          "description": "更新指定环境的配置信息，支持部分字段更新",
          "exceptions": [
            {"name": "ValidationException", "trigger": "请求参数格式无效", "http_status": 400},
            {"name": "EnvironmentNotFoundException", "trigger": "envId对应的环境不存在", "http_status": 404},
            {"name": "DuplicateNameException", "trigger": "更新的环境名称在所属项目下已存在", "http_status": 409},
            {"name": "InternalException", "trigger": "数据库更新失败", "http_status": 500}
          ]
        },
        {
          "name": "DeleteEnvironment",
          "signature": "(envId: UUID) -> void",
          "precondition": "envId对应的环境存在；该环境不存在任何关联的部署版本记录；该环境没有正在执行的部署任务",
          "postcondition": "environments表中对应记录被物理删除；关联的缓存被失效",
          "description": "删除指定环境，有关联部署版本时禁止删除",
          "exceptions": [
            {"name": "EnvironmentNotFoundException", "trigger": "envId对应的环境不存在", "http_status": 404},
            {"name": "ReferentialIntegrityException", "trigger": "环境存在关联的部署版本或正在执行的部署任务", "http_status": 409},
            {"name": "InternalException", "trigger": "数据库删除失败", "http_status": 500}
          ]
        },
        {
          "name": "GetEnvironment",
          "signature": "(envId: UUID) -> EnvironmentResponse",
          "precondition": "envId格式合法",
          "postcondition": "返回环境的完整配置信息，包含所属项目ID、连接参数、健康状态和创建时间",
          "description": "根据环境ID获取环境完整信息",
          "exceptions": [
            {"name": "EnvironmentNotFoundException", "trigger": "envId对应的环境不存在", "http_status": 404},
            {"name": "InternalException", "trigger": "数据库查询失败", "http_status": 500}
          ]
        },
        {
          "name": "ListEnvironmentsByProject",
          "signature": "(projectId: UUID) -> []EnvironmentResponse",
          "precondition": "projectId对应的项目存在",
          "postcondition": "返回指定项目的所有环境列表，按创建时间降序排列；如项目无环境则返回空列表",
          "description": "查询指定项目的所有部署环境",
          "exceptions": [
            {"name": "ProjectNotFoundException", "trigger": "projectId对应的项目不存在", "http_status": 404},
            {"name": "InternalException", "trigger": "数据库查询失败", "http_status": 500}
          ]
        },
        {
          "name": "CheckHealth",
          "signature": "(envId: UUID) -> HealthCheckResult",
          "precondition": "envId对应的环境存在且host和port有效；同一时间同一环境排他执行（通过分布式锁控制）",
          "postcondition": "environments表中对应环境的状态更新为online或offline；检查结果包含状态、延迟和时间戳",
          "description": "对目标环境执行TCP连接健康检查，更新环境状态并返回检查结果",
          "exceptions": [
            {"name": "EnvironmentNotFoundException", "trigger": "envId对应的环境不存在", "http_status": 404},
            {"name": "ConcurrentCheckException", "trigger": "该环境正在进行健康检查", "http_status": 409},
            {"name": "InternalException", "trigger": "健康检查执行异常（如DNS解析失败）", "http_status": 500}
          ]
        },
        {
          "name": "BindKey",
          "signature": "(envId: UUID, keyId: UUID) -> EnvironmentResponse",
          "precondition": "envId对应的环境存在；keyId对应的密钥存在；密钥管理服务返回该密钥可成功连接到目标服务器",
          "postcondition": "environments表中对应记录的key_id更新为指定值；环境状态重新评估",
          "description": "为环境绑定SSH密钥，绑定前调用密钥管理服务验证密钥有效性",
          "exceptions": [
            {"name": "EnvironmentNotFoundException", "trigger": "环境不存在", "http_status": 404},
            {"name": "KeyNotFoundException", "trigger": "密钥不存在", "http_status": 404},
            {"name": "KeyVerificationFailedException", "trigger": "密钥验证失败，无法连接目标服务器", "http_status": 422},
            {"name": "InternalException", "trigger": "数据库更新或调用密钥管理服务失败", "http_status": 500}
          ]
        },
        {
          "name": "GetConnectionInfo",
          "signature": "(envId: UUID) -> EnvironmentConnection",
          "precondition": "envId对应的环境存在",
          "postcondition": "返回环境的连接信息值对象（host、port、key_id、project_id），不含业务无关字段",
          "description": "供部署编排服务等内部模块调用的连接信息查询接口",
          "exceptions": [
            {"name": "EnvironmentNotFoundException", "trigger": "envId对应的环境不存在", "http_status": 404},
            {"name": "InternalException", "trigger": "数据库查询失败", "http_status": 500}
          ]
        }
      ],
      "repository_dependencies": [
        "FindById(envId UUID) -> Environment?",
        "FindByProjectId(projectId UUID) -> []Environment",
        "Save(env Environment) -> Environment",
        "Update(env Environment) -> Environment",
        "Delete(envId UUID) -> void",
        "ExistsByProjectIdAndName(projectId UUID, name String) -> boolean",
        "ExistsActiveDeploymentByEnvId(envId UUID) -> boolean",
        "FindProjectById(projectId UUID) -> Project?",
        "FindKeyById(keyId UUID) -> SshKey?"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "同一项目下，环境名称（name）必须唯一",
      "环境必须关联到一个已存在的项目（project_id引用约束）",
      "环境绑定的SSH密钥（key_id）必须对应ssh_keys表中存在的记录",
      "环境端口（port）必须在1-65535的有效范围内",
      "环境名称（name）长度1-64字符，不允许为空字符串",
      "环境状态（status）只能是「online」「offline」「unknown」三者之一",
      "存在关联部署版本（deployment_versions）的环境不可被删除",
      "正在执行部署任务的环境不可被删除"
    ],
    "state_machines": [
      {
        "entity": "Environment",
        "states": ["unknown", "online", "offline"],
        "transitions": [
          {"from": null, "to": "unknown", "trigger": "环境创建（CreateEnvironment）", "actor": "用户"},
          {"from": "unknown", "to": "online", "trigger": "健康检查成功（CheckHealth）", "actor": "系统（定时/手动触发）"},
          {"from": "unknown", "to": "offline", "trigger": "健康检查失败（CheckHealth）", "actor": "系统（定时/手动触发）"},
          {"from": "online", "to": "offline", "trigger": "健康检查失败或连接超时（CheckHealth）", "actor": "系统（定时/手动触发）"},
          {"from": "offline", "to": "online", "trigger": "健康检查成功（CheckHealth）", "actor": "系统（定时/手动触发）"},
          {"from": "online", "to": "unknown", "trigger": "变更host或port（UpdateEnvironment）", "actor": "用户"},
          {"from": "offline", "to": "unknown", "trigger": "变更host或port（UpdateEnvironment）", "actor": "用户"}
        ],
        "irreversible_rules": [
          "所有状态转换都是可逆的，不存在不可逆的状态转换",
          "环境一旦被删除（DeleteEnvironment），状态记录从数据库移除，不可恢复"
        ],
        "concurrency": "健康检查操作通过Redis分布式锁实现每环境的排他执行。锁key模式：lock:healthcheck:{envId}，TTL 30秒。健康检查执行中时返回409阻止重复触发。"
      }
    ],
    "cross_service_rules": [
      "绑定SSH密钥（BindKey）时，必须调用密钥管理服务的密钥验证能力（KeyVerifyAPI）确认该密钥能成功连接目标服务器的host:port，验证失败则绑定操作不执行并返回422",
      "环境删除（DeleteEnvironment）前，需检查部署编排服务的部署版本表（deployment_versions）是否存在关联该环境的记录，以及是否存在状态为pending/running的部署任务引用了该环境。存在引用时返回409，引导用户先处理关联部署",
      "环境信息（host/port/status）变更后，应通过Redis缓存失效机制同步通知部署编排服务下次获取时重新加载",
      "创建或更新环境后，需通知项目管理服务的缓存层失效该项目的环境列表缓存，确保跨项目切换时显示最新数据"
    ]
  }
}
