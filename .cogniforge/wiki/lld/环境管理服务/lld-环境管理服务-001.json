  "module_boundary": {
    "in_scope": [
      "环境的创建、查询列表、按ID查询、更新、删除",
      "创建/更新时对关联密钥的校验",
      "删除前检查环境是否被部署引用",
      "提供测试SSH连接端点"
    ],
    "out_of_scope": [
      "密钥本身的增删改查",
      "部署记录的创建与状态流转",
      "实际SSH握手指令执行",
      "项目本身的CRUD"
    ],
    "owned_components": ["CMP-004"],
    "owned_contracts": ["CTR-002"],
    "consumed_contracts": ["CTR-011", "CTR-012"],
    "owned_data_models": ["DM-002", "DM-003"],
    "consumed_data_models": []
  },
  "overview": {
    "description": "环境管理服务负责目标服务器连接信息的CRUD，协调密钥服务与部署引擎，保证环境配置的唯一性与安全性。",
    "dependencies": ["密钥管理服务", "SSH连接管理器", "部署引擎"],
    "tech_stack": ["Python 3.11+", "FastAPI", "SQLAlchemy", "SQLite", "asyncio"]
  },
