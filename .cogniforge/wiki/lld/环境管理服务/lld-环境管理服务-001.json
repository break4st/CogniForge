{
  "meta": {
    "doc_id": "lld-环境管理服务-001",
    "type": "lld",
    "module_type": "service",
    "module": "环境管理服务",
    "title": "环境管理服务详细设计",
    "author": "design_agent",
    "created": "2026-05-22 14:32"
  },
  "overview": {
    "description": "管理部署环境的配置，包括服务器地址、端口、认证方式等。提供环境的创建、编辑、删除、连通性测试等核心功能。",
    "dependencies": ["数据库", "SSH连接池", "审计日志服务", "密钥管理服务"],
    "tech_stack": ["Go", "Gin", "Go 1.22+", "PostgreSQL 15", "golang.org/x/crypto/ssh"]
  },
  "data_models": [
    {
      "name": "environments",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-数据库-001",
        "model_name": "environments"
      },
      "description": "部署环境表。本服务关心的字段视图，完整定义见 Primary Database LLD",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "环境唯一标识"},
        {"name": "project_id", "type": "BIGINT", "required": true, "description": "所属项目ID，外键关联 projects.id"},
        {"name": "name", "type": "VARCHAR(255)", "required": true, "description": "环境名称"},
        {"name": "server_host", "type": "VARCHAR(255)", "required": true, "description": "远程服务器地址（IP或域名）"},
        {"name": "server_port", "type": "INTEGER", "required": true, "description": "SSH端口号，默认22"},
        {"name": "description", "type": "TEXT", "required": false, "description": "环境描述"},
        {"name": "status", "type": "VARCHAR(32)", "required": true, "description": "环境状态：active / inactive / error"},
        {"name": "created_at", "type": "TIMESTAMPTZ", "required": true, "description": "记录创建时间"},
        {"name": "updated_at", "type": "TIMESTAMPTZ", "required": true, "description": "最后更新时间"}
      ]
    },
    {
      "name": "ssh_keys",
      "type": "reference",
      "ownership": "derived",
      "source": {
        "doc_id": "lld-数据库-001",
        "model_name": "ssh_keys"
      },
      "description": "SSH密钥表。本服务关心环境与密钥的绑定关系视图，完整定义见 Primary Database LLD",
      "fields": [
        {"name": "id", "type": "BIGSERIAL", "required": true, "description": "密钥唯一标识"},
        {"name": "environment_id", "type": "BIGINT", "required": true, "description": "绑定环境ID，外键关联 environments.id"},
        {"name": "key_name", "type": "VARCHAR(255)", "required": true, "description": "密钥名称"},
        {"name": "fingerprint", "type": "VARCHAR(64)", "required": true, "description": "公钥指纹（SHA256）"}
      ]
    }
  ],
  "interfaces": [
    {
      "name": "创建环境",
      "method": "POST",
      "endpoint": "/api/v1/projects/:pid/environments",
      "description": "为指定项目创建新的部署环境",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目ID，路径参数"},
        {"name": "name", "type": "string", "description": "环境名称，1~255字符，同一项目内唯一"},
        {"name": "server_host", "type": "string", "description": "远程服务器地址（IP或域名）"},
        {"name": "server_port", "type": "integer", "description": "SSH端口号，1~65535"},
        {"name": "description", "type": "string", "description": "环境描述（可选）"}
      ],
      "response": {
        "status": 201,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "status": "string",
          "created_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败，如缺少必填字段或格式错误"},
        {"code": 404, "message": "指定的项目（pid）不存在"},
        {"code": 409, "message": "该项目下已存在同名环境"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "测试连接",
      "method": "GET",
      "endpoint": "/api/v1/environments/:eid/test",
      "description": "测试指定环境的SSH连通性",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "reachable": "boolean",
          "latency_ms": "integer",
          "server_info": "string",
          "error": "string"
        }
      },
      "error_codes": [
        {"code": 404, "message": "指定的环境（eid）不存在"},
        {"code": 412, "message": "环境未绑定SSH密钥，无法执行连通性测试"},
        {"code": 502, "message": "SSH连接池调用失败"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取环境详情",
      "method": "GET",
      "endpoint": "/api/v1/environments/:eid",
      "description": "获取单个环境的详细信息，包括绑定的密钥信息",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "description": "string",
          "status": "string",
          "key_id": "integer",
          "key_name": "string",
          "created_at": "datetime",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 404, "message": "指定的环境（eid）不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "获取环境列表",
      "method": "GET",
      "endpoint": "/api/v1/projects/:pid/environments",
      "description": "获取指定项目下的所有环境列表，按创建时间降序排列",
      "parameters": [
        {"name": "pid", "type": "integer", "description": "项目ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "environments": "array",
          "total": "integer"
        }
      },
      "error_codes": [
        {"code": 404, "message": "指定的项目（pid）不存在"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "更新环境配置",
      "method": "PUT",
      "endpoint": "/api/v1/environments/:eid",
      "description": "更新指定环境的配置信息（名称、地址、端口、描述）",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境ID，路径参数"},
        {"name": "name", "type": "string", "description": "环境名称"},
        {"name": "server_host", "type": "string", "description": "服务器地址"},
        {"name": "server_port", "type": "integer", "description": "SSH端口号"},
        {"name": "description", "type": "string", "description": "环境描述"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "project_id": "integer",
          "name": "string",
          "server_host": "string",
          "server_port": "integer",
          "status": "string",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "请求参数校验失败"},
        {"code": 404, "message": "指定的环境（eid）不存在"},
        {"code": 409, "message": "更新后的环境名与项目内已有环境冲突"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "删除环境",
      "method": "DELETE",
      "endpoint": "/api/v1/environments/:eid",
      "description": "删除指定环境及相关配置。关联的SSH密钥需先解绑，有关联部署任务的环境不可删除",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境ID，路径参数"}
      ],
      "response": {
        "status": 200,
        "body": {
          "success": "boolean"
        }
      },
      "error_codes": [
        {"code": 404, "message": "指定的环境（eid）不存在"},
        {"code": 409, "message": "环境存在关联的部署任务或未解绑密钥，无法删除"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "切换环境状态",
      "method": "PATCH",
      "endpoint": "/api/v1/environments/:eid/status",
      "description": "启用或停用指定环境",
      "parameters": [
        {"name": "eid", "type": "integer", "description": "环境ID，路径参数"},
        {"name": "status", "type": "string", "description": "目标状态值：active 或 inactive"}
      ],
      "response": {
        "status": 200,
        "body": {
          "id": "integer",
          "status": "string",
          "updated_at": "datetime"
        }
      },
      "error_codes": [
        {"code": 400, "message": "状态值不合法（仅允许 active / inactive）"},
        {"code": 404, "message": "指定的环境（eid）不存在"},
        {"code": 409, "message": "状态转换不允许（如 error 状态需先恢复才能停用）"},
        {"code": 500, "message": "服务器内部错误"}
      ]
    },
    {
      "name": "远程连接测试（调用SSH连接池）",
      "method": "RPC",
      "endpoint": "internal",
      "description": "内部调用，通过SSH连接池测试目标服务器连通性",
      "parameters": [
        {"name": "host", "type": "string", "description": "服务器地址"},
        {"name": "port", "type": "integer", "description": "SSH端口"},
        {"name": "key_id", "type": "integer", "description": "密钥ID"}
      ],
      "response": {
        "status": 200,
        "body": {
          "connected": "boolean",
          "latency_ms": "integer"
        }
      },
      "error_codes": [
        {"code": 5001, "message": "SSH连接建立失败"},
        {"code": 5002, "message": "SSH认证失败（密钥不匹配或被拒绝）"},
        {"code": 5003, "message": "连接超时（超过预设超时阈值）"}
      ]
    },
    {
      "name": "记录审计日志（调用审计日志服务）",
      "method": "RPC",
      "endpoint": "internal",
      "description": "内部调用，将环境管理的CRUD操作记录到审计日志",
      "parameters": [
        {"name": "action", "type": "string", "description": "操作名称，如 environment.create / environment.update / environment.delete"},
        {"name": "actor", "type": "string", "description": "操作人用户名"},
        {"name": "resource_type", "type": "string", "description": "资源类型，固定为 environment"},
        {"name": "resource_id", "type": "integer", "description": "环境ID"},
        {"name": "detail", "type": "object", "description": "操作详情，记录变更前后的字段"},
        {"name": "timestamp", "type": "datetime", "description": "操作发生时间"}
      ],
      "response": {
        "status": 200,
        "body": {
          "log_id": "integer",
          "recorded": "boolean"
        }
      },
      "error_codes": [
        {"code": 6001, "message": "审计日志写入失败"}
      ]
    }
  ],
  "error_handling": {
    "strategy": "所有外部接口统一返回标准JSON格式错误体，业务异常通过HTTP状态码区分语义。参数校验在API层前置拦截，数据库约束异常（唯一冲突、外键冲突）由Repository层捕获并转为业务错误码返回。跨服务调用（SSH连接池、审计日志）失败时，环境管理服务仅透传错误信息，不重试。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {"code": 400, "name": "请求参数错误", "description": "必填字段缺失、字段格式错误（如端口超出1~65535）、字段长度超限等，由Gin的binding校验器前置拦截"},
      {"code": 404, "name": "资源不存在", "description": "按ID查询项目/环境时记录不存在，或关联的外键资源不存在"},
      {"code": 409, "name": "资源冲突", "description": "唯一约束违反（同一项目下环境名重复）、依赖约束违反（环境存在部署任务无法删除）"},
      {"code": 412, "name": "前置条件不满足", "description": "测试连接时环境未绑定SSH密钥、解绑密钥时环境未绑定任何密钥"},
      {"code": 502, "name": "上游服务错误", "description": "调用SSH连接池返回错误时透传502 Bad Gateway"},
      {"code": 500, "name": "服务器内部错误", "description": "数据库写入失败、未预期的运行时异常等，返回通用错误信息"}
    ]
  },
  "domain_objects": [
    {
      "name": "Environment",
      "object_type": "entity",
      "description": "部署环境实体，代表一个可部署目标服务器的配置信息",
      "attributes": [
        {"name": "id", "type": "Long", "required": true, "source": "db", "description": "环境唯一标识"},
        {"name": "project_id", "type": "Long", "required": true, "source": "db", "description": "所属项目ID"},
        {"name": "name", "type": "String", "required": true, "source": "db", "description": "环境名称，同一项目内唯一"},
        {"name": "server_host", "type": "String", "required": true, "source": "db", "description": "远程服务器地址"},
        {"name": "server_port", "type": "Integer", "required": true, "source": "db", "description": "SSH端口号"},
        {"name": "description", "type": "String", "required": false, "source": "db", "description": "环境描述"},
        {"name": "status", "type": "EnvironmentStatus", "required": true, "source": "db", "description": "当前状态：active / inactive / error"},
        {"name": "key_id", "type": "Long", "required": false, "source": "derived", "description": "绑定的SSH密钥ID，从ssh_keys表关联查询"},
        {"name": "key_name", "type": "String", "required": false, "source": "derived", "description": "绑定的SSH密钥名称，从ssh_keys表关联查询"},
        {"name": "created_at", "type": "DateTime", "required": true, "source": "db", "description": "创建时间"},
        {"name": "updated_at", "type": "DateTime", "required": true, "source": "db", "description": "最后更新时间"}
      ]
    },
    {
      "name": "EnvironmentStatus",
      "object_type": "enum",
      "description": "环境状态枚举",
      "values": ["active", "inactive", "error"]
    },
    {
      "name": "CreateEnvironmentRequest",
      "object_type": "dto",
      "description": "创建环境请求DTO",
      "maps_to_entity": "Environment",
      "attributes": [
        {"name": "name", "type": "String", "required": true, "source": "input", "description": "环境名称，1~255字符，同一项目内唯一"},
        {"name": "server_host", "type": "String", "required": true, "source": "input", "description": "服务器地址，合法IP或域名格式"},
        {"name": "server_port", "type": "Integer", "required": true, "source": "input", "description": "SSH端口号，范围1~65535"},
        {"name": "description", "type": "String", "required": false, "source": "input", "description": "环境描述，最长1024字符"}
      ]
    },
    {
      "name": "UpdateEnvironmentRequest",
      "object_type": "dto",
      "description": "更新环境请求DTO",
      "maps_to_entity": "Environment",
      "attributes": [
        {"name": "name", "type": "String", "required": false, "source": "input", "description": "环境名称"},
        {"name": "server_host", "type": "String", "required": false, "source": "input", "description": "服务器地址"},
        {"name": "server_port", "type": "Integer", "required": false, "source": "input", "description": "SSH端口号"},
        {"name": "description", "type": "String", "required": false, "source": "input", "description": "环境描述"}
      ]
    },
    {
      "name": "EnvironmentResponse",
      "object_type": "dto",
      "description": "环境信息响应DTO，完整返回环境的所有字段",
      "maps_to_entity": "Environment",
      "attributes": [
        {"name": "id", "type": "Long", "required": true, "source": "db", "description": "环境唯一标识"},
        {"name": "project_id", "type": "Long", "required": true, "source": "db", "description": "所属项目ID"},
        {"name": "name", "type": "String", "required": true, "source": "db", "description": "环境名称"},
        {"name": "server_host", "type": "String", "required": true, "source": "db", "description": "服务器地址"},
        {"name": "server_port", "type": "Integer", "required": true, "source": "db", "description": "SSH端口号"},
        {"name": "description", "type": "String", "required": false, "source": "db", "description": "环境描述"},
        {"name": "status", "type": "String", "required": true, "source": "db", "description": "环境状态"},
        {"name": "key_id", "type": "Long", "required": false, "source": "derived", "description": "绑定的SSH密钥ID"},
        {"name": "key_name", "type": "String", "required": false, "source": "derived", "description": "绑定的SSH密钥名称"},
        {"name": "created_at", "type": "DateTime", "required": true, "source": "db", "description": "创建时间"},
        {"name": "updated_at", "type": "DateTime", "required": true, "source": "db", "description": "最后更新时间"}
      ]
    },
