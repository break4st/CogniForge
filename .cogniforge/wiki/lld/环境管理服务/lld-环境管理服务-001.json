      "id": "DO-001",
      "name": "EnvironmentCreateRequest",
      "object_type": "value_object",
      "description": "创建环境请求参数",
      "fields": [
        {
          "name": "name",
          "type": "str",
          "required": true,
          "description": "环境名称"
        },
        {
          "name": "server_address",
          "type": "str",
          "required": true,
          "description": "服务器地址"
        },
        {
          "name": "port",
          "type": "int",
          "required": false,
          "description": "SSH端口，默认22"
        },
        {
          "name": "auth_type",
          "type": "str",
          "required": true,
          "description": "认证类型，固定ssh_key"
        },
        {
          "name": "private_key",
          "type": "str",
          "required": true,
          "description": "PEM格式私钥原文"
        }
      ],
      "validations": [
        "name非空且长度不超过100",
        "server_address非空且为有效域名或IP",
        "port范围1~65535",
        "auth_type必须为ssh_key",
        "private_key非空且为有效PEM格式"
