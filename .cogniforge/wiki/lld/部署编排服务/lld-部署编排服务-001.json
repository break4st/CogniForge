  "module_boundary": {
    "in_scope": [
      "接收并校验部署请求（目标环境ID、待部署文件）",
      "协调环境管理服务和密钥管理服务获取部署所需配置和认证",
      "执行部署流水线：文件暂存对象存储、SSH远程连接、创建版本目录、传输文件、生成并授权启动脚本",
      "部署过程实时日志推送到RabbitMQ",
      "处理部署失败时的清理回滚操作（删除远程已创建目录）",
      "通过WebSocket向前端推送实时进展"
    ],
    "out_of_scope": [
      "环境配置管理（由环境管理服务负责）",
      "密钥生成、加密存储与解密（由密钥管理服务负责）",
      "日志持久化存储（由日志与审计服务负责）",
      "用户认证与授权（由API网关和认证服务负责）",
      "文件分片上传与对象存储管理（由前端和MinIO服务负责）"
    ],
    "owned_components": ["CMP-006"],
    "owned_contracts": ["CTR-004"],
    "consumed_contracts": ["CTR-003"],
    "owned_data_models": [],
    "consumed_data_models": ["DM-002", "DM-004"]
  },
  "overview": {
    "description": "系统核心执行引擎。接收用户部署请求，协调其他服务获取环境和密钥，执行完整部署流水线，并推送实时日志。",
    "dependencies": [
      "环境管理服务（gRPC）",
      "密钥管理服务（gRPC）",
      "RabbitMQ（消息队列）",
      "MinIO（对象存储）",
      "日志与审计服务（消费日志）"
    ],
    "tech_stack": [
      "Python",
      "FastAPI",
      "Paramiko (SSH)",
      "asyncssh (可选异步支持)",
      "RabbitMQ",
      "MinIO",
      "gRPC",
      "JWT"
    ]
  },
