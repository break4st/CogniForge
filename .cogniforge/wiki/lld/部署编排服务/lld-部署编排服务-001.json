  "service_contracts": [
    {
      "name": "DeploymentService",
      "description": "部署编排服务，负责协调环境与密钥，执行部署流水线并推送日志",
      "methods": [
        {
          "name": "executeDeployment",
          "signature": "(request: DeploymentRequest, user: User) -> DeploymentResponse",
          "precondition": "DeploymentRequest 包含有效的目标环境ID和文件信息，且用户已认证",
          "postcondition": "部署任务已异步启动，返回部署ID和WebSocket端点；或返回错误信息",
          "description": "接收部署请求，异步执行部署流水线，返回任务状态与监控入口",
          "exceptions": [
            {
              "name": "EnvironmentNotFoundException",
              "trigger": "环境管理服务中无匹配的环境ID",
              "http_status": 404
            },
            {
              "name": "KeyRetrievalException",
              "trigger": "从密钥管理服务获取密钥失败",
              "http_status": 502
            },
            {
              "name": "SSHConnectionException",
              "trigger": "SSH连接目标服务器失败（认证、网络等原因）",
              "http_status": 502
            },
            {
              "name": "FileUploadException",
              "trigger": "上传文件到MinIO失败",
              "http_status": 502
            },
            {
              "name": "DeploymentStartException",
              "trigger": "启动部署任务时内部错误",
              "http_status": 500
            }
          ]
        },
        {
          "name": "getDeploymentStatus",
          "signature": "(deploymentId: str) -> DeploymentJob",
          "precondition": "deploymentId 存在且用户有权访问",
          "postcondition": "返回部署作业的当前状态和详细信息",
          "description": "查询指定部署作业的状态",
          "exceptions": [
            {
              "name": "DeploymentNotFoundException",
              "trigger": "未找到指定部署ID",
              "http_status": 404
            }
          ]
        },
        {
          "name": "cancelDeployment",
          "signature": "(deploymentId: str) -> bool",
          "precondition": "deploymentId 存在且用户有权操作，部署尚未完成",
          "postcondition": "部署作业被标记为取消，如果可能则执行清理回滚",
          "description": "取消正在进行的部署，触发回滚并更新状态",
          "exceptions": [
            {
              "name": "DeploymentNotFoundException",
              "trigger": "未找到指定部署ID",
              "http_status": 404
            },
            {
              "name": "DeploymentNotCancellableException",
              "trigger": "部署状态不允许取消（如已完成）",
              "http_status": 409
            }
          ]
        }
      ],
      "repository_dependencies": [
        "getEnvironmentConfig(envId: str) -> EnvironmentConfig",
        "getDecryptedKeyMaterial(keyId: str) -> DecryptedKeyMaterial",
        "saveDeploymentJob(job: DeploymentJob) -> None",
        "getDeploymentJob(jobId: str) -> DeploymentJob"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "部署任务一旦创建，其deployment_id全局唯一且不可变",
      "部署任务的状态转换必须遵循预定义状态机",
      "任何部署操作不得在未成功获取解密密钥的情况下进行远程连接",
      "远程服务器上的部署目录必须唯一对应于部署任务ID，不得冲突",
      "部署失败时，必须执行清理操作删除远程已创建的版本目录",
      "实时日志推送必须按时间顺序且不可丢失"
    ],
    "state_machines": [
      {
        "entity": "DeploymentJob",
        "states": [
          "PENDING",
          "VALIDATING",
          "FETCHING_CONFIG",
          "FETCHING_KEYS",
          "TRANSFERRING",
          "STARTING",
          "SUCCESS",
          "FAILED",
          "CANCELLED"
        ],
        "transitions": [
          {
            "from": "PENDING",
            "to": "VALIDATING",
            "trigger": "开始验证部署请求",
            "actor": "部署编排服务"
          },
          {
            "from": "VALIDATING",
            "to": "FETCHING_CONFIG",
            "trigger": "请求验证通过",
            "actor": "部署编排服务"
          },
          {
            "from": "VALIDATING",
            "to": "FAILED",
            "trigger": "请求验证失败",
            "actor": "部署编排服务"
          },
          {
            "from": "FETCHING_CONFIG",
            "to": "FETCHING_KEYS",
            "trigger": "成功获取环境配置",
            "actor": "部署编排服务"
          },
          {
            "from": "FETCHING_CONFIG",
            "to": "FAILED",
            "trigger": "获取环境配置失败",
            "actor": "部署编排服务"
          },
          {
            "from": "FETCHING_KEYS",
            "to": "TRANSFERRING",
            "trigger": "成功获取解密密钥",
            "actor": "部署编排服务"
          },
          {
            "from": "FETCHING_KEYS",
            "to": "FAILED",
            "trigger": "获取密钥失败",
            "actor": "部署编排服务"
          },
          {
            "from": "TRANSFERRING",
            "to": "STARTING",
            "trigger": "文件传输完成",
            "actor": "部署编排服务"
          },
          {
            "from": "TRANSFERRING",
            "to": "FAILED",
            "trigger": "文件传输失败",
            "actor": "部署编排服务"
          },
          {
            "from": "STARTING",
            "to": "SUCCESS",
            "trigger": "启动脚本执行成功",
            "actor": "远程服务器"
          },
          {
            "from": "STARTING",
            "to": "FAILED",
            "trigger": "启动脚本执行失败",
            "actor": "远程服务器"
          },
          {
            "from": "PENDING",
            "to": "CANCELLED",
            "trigger": "用户取消部署",
            "actor": "用户"
          },
          {
            "from": "VALIDATING",
            "to": "CANCELLED",
            "trigger": "用户取消部署",
            "actor": "用户"
          },
          {
            "from": "FETCHING_CONFIG",
            "to": "CANCELLED",
            "trigger": "用户取消部署",
            "actor": "用户"
          },
          {
            "from": "FETCHING_KEYS",
            "to": "CANCELLED",
            "trigger": "用户取消部署",
            "actor": "用户"
          },
          {
            "from": "TRANSFERRING",
            "to": "CANCELLED",
            "trigger": "用户取消部署",
            "actor": "用户"
          }
        ],
        "irreversible_rules": [
          "SUCCESS和FAILED为终态，不可再转换",
          "一旦进入SUCCESS状态，不可回滚或重试",
          "CANCELLED状态不可逆转，必须清理远程资源"
        ],
        "concurrency": "同一部署任务ID在任意时刻只有一个实例处于活跃状态（PENDING到STARTING），使用数据库乐观锁或分布式锁防止并发操作"
      }
    ],
    "cross_service_rules": [
      "环境管理服务返回的环境配置必须包含有效的SSH连接信息，否则部署失败",
      "密钥管理服务必须在验证调用方身份后提供解密密钥，密钥只能用于本次部署",
      "部署日志必须发送到RabbitMQ指定交换机，日志与审计服务需正确消费并持久化",
      "文件传输前必须确保MinIO中的文件可访问，且部署完成后可根据策略清理临时文件",
      "WebSocket推送仅在部署任务活跃期间有效，前端需在收到完成或失败信号后关闭连接"
    ]
  },
  "workflow": {
    "name": "部署执行主流程",
    "description": "接收部署请求后顺序执行验证、配置获取、密钥获取、文件传输和服务启动，任何步骤失败即回滚。",
    "steps": [
      {
        "order": 1,
        "name": "验证请求",
        "action": "校验 request 参数格式与必填项",
        "timeout_seconds": 30,
        "on_failure": "返回 400 错误并终止流程"
      },
      {
        "order": 2,
        "name": "获取环境配置",
        "action": "调用环境管理服务获取目标环境的SSH连接信息",
        "timeout_seconds": 60,
        "on_failure": "返回 502 错误，回滚已创建的资源"
      },
      {
        "order": 3,
        "name": "获取解密密钥",
        "action": "调用密钥管理服务获取解密后的SSH私钥或签名密钥",
        "timeout_seconds": 60,
        "on_failure": "返回 502 错误，回滚已创建的远程目录"
      },
      {
        "order": 4,
        "name": "暂存文件到对象存储",
        "action": "将待部署文件上传到 MinIO 临时桶",
        "timeout_seconds": 120,
        "on_failure": "返回 502 错误，删除已上传的部分文件"
      },
      {
        "order": 5,
        "name": "SSH 远程连接",
        "action": "使用获取的密钥和配置通过 Paramiko 建立 SSH 连接",
        "timeout_seconds": 30,
        "on_failure": "返回 502 错误，清理 MinIO 暂存文件"
      },
      {
        "order": 6,
        "name": "创建版本目录",
        "action": "在远程服务器上创建以 deploymentId 命名的版本目录",
        "timeout_seconds": 30,
        "on_failure": "关闭 SSH 连接，清理 MinIO 文件"
      },
      {
        "order": 7,
        "name": "传输文件",
        "action": "从 MinIO 下载文件并通过 SFTP 传输到远程版本目录",
        "timeout_seconds": 300,
        "on_failure": "删除远程已创建的目录，清理 MinIO 文件"
      },
      {
        "order": 8,
        "name": "生成启动脚本",
        "action": "在远程服务器上创建启动脚本并设置执行权限",
        "timeout_seconds": 30,
        "on_failure": "清理远程目录和文件"
      },
      {
        "order": 9,
        "name": "执行启动脚本",
        "action": "通过 SSH exec 启动远程服务脚本",
        "timeout_seconds": 180,
        "on_failure": "停止可能已启动的进程，清理远程目录"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": ["NETWORK_ERROR", "TIMEOUT"],
      "non_retryable_errors": ["AUTH_ERROR", "CONFIG_ERROR"]
    }
  }
}