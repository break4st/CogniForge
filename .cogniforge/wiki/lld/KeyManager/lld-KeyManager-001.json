      },
      "coverage": "full",
      "notes": "覆盖了密钥上传、格式验证及指纹展示的核心需求。"
    }
  ],
  "data_models": [
    {
      "id": "DM-001",
      "name": "KeyUploadState",
      "type": "struct",
      "status": "active",
      "version": 1,
      "ownership": "owned",
      "description": "组件内部状态，管理上传流程中的数据",
      "fields": [
        {
          "name": "environmentId",
          "type": "number",
          "required": true,
          "description": "环境ID"
        },
        {
          "name": "file",
          "type": "File | null",
          "required": false,
          "description": "当前选中的文件对象"
        },
        {
          "name": "fingerprint",
          "type": "string | null",
          "required": false,
          "description": "上传成功后返回的指纹"
        },
        {
          "name": "uploading",
          "type": "boolean",
          "required": true,
          "description": "是否正在上传"
        },
        {
          "name": "error",
          "type": "string | null",
          "required": false,
          "description": "错误信息"
        },
        {
          "name": "dragOver",
          "type": "boolean",
          "required": true,
          "description": "拖拽悬停状态"
        }
      ],
      "source_requirements": [
