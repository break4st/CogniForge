  "overview": {
    "description": "KeyManager是一个React+Ant Design前端模块，提供密钥文件上传、拖拽、前端格式预校验及指纹掩码显示功能。通常嵌入环境管理页面。",
    "dependencies": [
      "EnvironmentManager（父组件）",
      "KeyManagementService（后端服务）"
    ],
    "tech_stack": [
      "React 18",
      "Ant Design",
      "HTTP fetch/axios"
    ]
  },
