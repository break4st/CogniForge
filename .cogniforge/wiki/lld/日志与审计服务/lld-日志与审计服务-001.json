  "module_boundary": {
    "in_scope": [
      "消费 RabbitMQ 消息队列中的部署日志，存储为结构化的部署记录",
      "提供按项目、时间范围、状态等条件查询部署记录的 REST API",
      "记录密钥创建、吊销等安全审计事件",
      "管理 DeploymentRecord 实体的生命周期和状态转换",
      "确保日志持久化存储的可靠性和一致性"
    ],
    "out_of_scope": [
      "部署流程的编排与执行（归属部署编排服务）",
      "项目、环境、密钥等数据的管理（归属对应服务）",
      "前端页面渲染",
      "消息队列的运维管理"
    ],
    "owned_components": [
      "CMP-007"
    ],
    "owned_contracts": [
      "CTR-005"
    ],
    "consumed_contracts": [],
    "owned_data_models": [],
    "consumed_data_models": []
  },
  "overview": {
    "description": "日志与审计服务是从消息队列中消费部署日志，将其持久化存储，并提供部署历史与详情查询 API 的后端服务。它维护部署记录的完整生命周期，并为前端和审计需求提供数据。",
    "dependencies": [
      "RabbitMQ（消息队列，消费部署日志）",
      "PostgreSQL（持久化存储）",
      "API 网关（请求入口）"
    ],
    "tech_stack": [
      "Python",
      "FastAPI",
      "PostgreSQL",
      "RabbitMQ",
      "JWT (JSON Web Tokens)"
    ]
  },
