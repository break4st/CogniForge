  "error_handling": {
    "strategy": "所有 API 异常通过全局异常过滤器捕获，统一返回标准 JSON 错误体；消息消费异常单独记录并依赖重试机制。",
    "response_format": {
      "body": {
        "code": "integer",
        "error": "string",
        "detail": "string"
      }
    },
    "categories": [
      {
        "code": "400",
        "name": "请求参数错误",
        "description": "当查询参数不符合预期的类型或范围（如 project_id 非 UUID、status 不在枚举值中）时返回 400，detail 中说明具体参数问题。"
      },
      {
        "code": "401",
        "name": "认证失败",
        "description": "当请求缺少有效 JWT 或令牌已过期时返回 401，detail 提示认证失败原因。"
      },
      {
        "code": "403",
        "name": "权限不足",
        "description": "当调用方无权访问指定项目的部署记录时返回 403，detail 说明权限不足。"
      },
      {
        "code": "404",
        "name": "记录不存在",
        "description": "当查询单条部署记录（如 GET /api/v1/deployments/{id}）但记录 ID 不存在时返回 404，detail 包含未找到的 ID。"
      },
      {
        "code": "422",
        "name": "请求体验证失败",
        "description": "当请求体 JSON 格式错误或字段不满足约束（如缺少必填字段）时返回 422，detail 列出验证失败的具体字段和原因。"
      },
      {
        "code": "500",
        "name": "内部服务错误",
        "description": "当数据库连接失败、消息队列异常、未知运行时错误发生时返回 500，detail 为通用错误描述，原始异常记录在服务器日志中。"
      },
      {
        "code": "503",
        "name": "服务不可用",
        "description": "当依赖服务（如 RabbitMQ）不可达、数据库连接池耗尽时返回 503，detail 提示服务暂时不可用，请稍后重试。"
      }
    ]
  },
