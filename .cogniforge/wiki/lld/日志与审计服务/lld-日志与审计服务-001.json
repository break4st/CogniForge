  "service_contracts": [
    {
      "name": "DeploymentLogService",
      "description": "消费消息队列中的部署日志，持久化存储为部署记录，并管理其生命周期。",
      "methods": [
        {
          "name": "consumeDeploymentLog",
          "signature": "(message: dict) -> None",
          "precondition": "消息格式有效，包含部署事件必要字段",
          "postcondition": "部署日志被持久化为DeploymentRecord，状态为in_progress或根据消息确定",
          "description": "从RabbitMQ消费部署日志，解析并存储为DeploymentRecord实体，触发状态转换。",
          "exceptions": [
            {
              "name": "InvalidMessageException",
              "trigger": "消息格式无效或缺少必要字段",
              "http_status": 400
            }
          ]
        }
      ],
      "repository_dependencies": [
        "save(record: DeploymentRecordEntity) -> DeploymentRecordEntity"
      ]
    },
    {
      "name": "DeploymentQueryService",
      "description": "提供部署记录的查询功能，支持按项目、时间范围、状态等条件筛选。",
      "methods": [
        {
          "name": "getDeployments",
          "signature": "(filter: DeploymentQueryFilterDTO, page: int, page_size: int) -> PaginatedResult<DeploymentRecordResponseDTO>",
          "precondition": "分页参数合法，认证令牌有效且具有查询权限",
          "postcondition": "返回符合条件的部署记录分页列表，按创建时间倒序排列",
          "description": "查询部署记录列表，支持多条件筛选和分页，返回扁平化的响应DTO。",
          "exceptions": [
            {
              "name": "InvalidPaginationException",
              "trigger": "分页参数非法（如page<=0或page_size<=0）",
              "http_status": 400
            },
            {
              "name": "UnauthorizedException",
              "trigger": "认证令牌无效或过期",
              "http_status": 401
            },
            {
              "name": "ForbiddenException",
              "trigger": "用户无权限查询指定项目的部署记录",
              "http_status": 403
            }
          ]
        }
      ],
      "repository_dependencies": [
        "findByFilter(filter: DeploymentQueryFilterDTO, page: int, page_size: int) -> PaginatedResult<DeploymentRecordEntity>"
      ]
    }
  ],
  "business_rules": {
    "invariants": [
      "每条部署记录必须关联一个有效的项目ID（project_id）",
      "部署状态必须是预定义枚举值之一（success, failed, in_progress）",
      "部署记录的时间戳字段（如 created_at, updated_at）必须由系统自动生成，不可由外部输入直接设置",
      "所有部署记录不可物理删除，只能通过状态标记为已归档或已失效（软删除）",
      "审计日志中的操作人员信息必须通过 JWT 提取，不可由请求参数指定"
    ],
    "state_machines": [
      {
        "entity": "DeploymentRecordEntity",
        "states": [
          "pending",
          "in_progress",
          "success",
          "failed",
          "archived"
        ],
        "transitions": [
          {
            "from": "pending",
            "to": "in_progress",
            "trigger": "开始部署",
            "actor": "部署编排服务"
          },
          {
            "from": "in_progress",
            "to": "success",
            "trigger": "部署成功",
            "actor": "部署编排服务"
          },
          {
            "from": "in_progress",
            "to": "failed",
            "trigger": "部署失败",
            "actor": "部署编排服务"
          },
          {
            "from": "failed",
            "to": "archived",
            "trigger": "管理员归档",
            "actor": "管理员"
          },
          {
            "from": "success",
            "to": "archived",
            "trigger": "管理员归档",
            "actor": "管理员"
          }
        ],
        "irreversible_rules": [
          "一旦进入 success 或 failed 状态，不能回退到 in_progress 或 pending",
          "归档操作不可逆"
        ],
        "concurrency": "使用乐观锁（版本号）处理并发状态更新，基于 updated_at 字段"
      }
    ],
    "cross_service_rules": [
      "部署事件必须通过 RabbitMQ 消息触发 DeploymentRecord 状态变更，消息包含事务ID以保证幂等性",
      "API 网关需验证请求中的 JWT 令牌，并提取用户ID和角色传递给本服务",
      "前端查询部署记录时，只能查看其所属项目的记录，通过 API 网关传递的项目范围进行过滤"
    ]
  },
  "workflow": {
    "name": "部署日志消费主流程",
    "description": "从消息队列消费部署日志，解析并持久化存储的流程",
    "steps": [
      {
        "order": 1,
        "name": "消费消息",
        "action": "从 RabbitMQ 队列中取出部署日志消息",
        "timeout_seconds": 30,
        "on_failure": "记录消费失败日志，消息重新入队"
      },
      {
        "order": 2,
        "name": "解析消息",
        "action": "验证消息格式和必要字段，提取部署事件数据",
        "timeout_seconds": 10,
        "on_failure": "丢弃消息并记录错误日志，发送告警"
      },
      {
        "order": 3,
        "name": "持久化存储",
        "action": "将部署记录写入数据库，初始状态为 in_progress 或根据消息确定",
        "timeout_seconds": 10,
        "on_failure": "重试写入，最多 3 次；仍失败则记录错误并丢弃消息"
      }
    ],
    "retry_strategy": {
      "max_retries": 3,
      "retry_interval_seconds": 30,
      "retryable_errors": [
        "NETWORK_ERROR",
        "TIMEOUT"
      ],
      "non_retryable_errors": [
        "AUTH_ERROR",
        "CONFIG_ERROR"
      ]
    }
  }
}