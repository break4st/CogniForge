      "name": "查询部署记录接口",
      "status": "active",
      "version": 1,
      "source_contract_id": "CTR-005",
      "provider_component_id": "CMP-007",
      "method": "GET",
      "endpoint": "/api/v1/deployments",
      "description": "按项目、时间范围、状态等条件查询部署记录列表，支持分页和排序",
      "parameters": [
        {
          "name": "project_id",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "项目ID，可选"
        },
        {
          "name": "project_name",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "项目名称，可选"
        },
        {
          "name": "env",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "环境名称，可选"
        },
        {
          "name": "status",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "部署状态，可选值：success, failed, in_progress"
        },
        {
          "name": "triggered_by",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "触发者，可选"
        },
        {
          "name": "from_time",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "起始时间（ISO 8601格式），可选"
        },
        {
          "name": "to_time",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "结束时间（ISO 8601格式），可选"
        },
        {
          "name": "page",
          "type": "integer",
          "in": "query",
          "required": false,
          "description": "页码，从1开始，默认1"
        },
        {
          "name": "page_size",
          "type": "integer",
          "in": "query",
          "required": false,
          "description": "每页记录数，默认20，最大100"
        },
        {
          "name": "sort_by",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "排序字段，可选 created_at, status"
        },
        {
          "name": "sort_order",
          "type": "string",
          "in": "query",
          "required": false,
          "description": "排序顺序，asc 或 desc，默认 desc"
        }
      ],
      "request_body": {},
      "response": {
        "status": 200,
        "body": {
          "items": "array of DeploymentRecordResponseDTO",
          "total": "integer",
          "page": "integer",
          "page_size": "integer"
        }
      },
      "error_codes": [
        {
          "status": 400,
          "code": "INVALID_QUERY_PARAM",
          "message": "无效的查询参数"
        },
        {
          "status": 401,
          "code": "UNAUTHORIZED",
          "message": "未授权访问"
        },
        {
          "status": 500,
          "code": "INTERNAL_SERVER_ERROR",
          "message": "内部服务器错误"
        }
      ],
      "auth": {
        "required": true,
        "policy": "JWT"
      },
      "validation_rules": [
        "status 只能是 success, failed, in_progress",
        "from_time 和 to_time 需符合 ISO 8601 格式",
        "page_size 最大为 100"
      ],
      "idempotency": "not_applicable",
      "pagination": "offset_page",
      "source_requirements": [
        "REQ-005"
      ],
      "change_history": [
